__pycache__/
*.pyc
libexec/fleet-console-pi/data.json
libexec/fleet-console-pi/.pushed-*.sha

# Report output; never committed.
out/

# Per-job operational caches that workers sometimes leave behind.
.cache/
.pytest_cache/

# fleet-ops#8341: .bak-* config siblings are sprawl — versioned file + PR is the record.
config/**/*.bak-*

# infra/cloudflare-tokens/: provider cache and crash logs. The state itself lives
# outside the repo (~/.local/state/fleet-ops/cloudflare-tokens/) because it holds
# token values; these patterns are the second lock if one is ever copied in.
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfplan

# Pi extension test dependencies, installed by `npm ci`; the lockfile is the record.
pi-extensions/*/node_modules/

# Control-plane test dependencies, likewise; the lockfile is the record.
control-plane/node_modules/
