__pycache__/
*.pyc
libexec/fleet-console-pi/data.json
libexec/fleet-console-pi/.pushed-*.sha

# Drift-report output from .github/scripts/repo-standards-apply.mjs +
# .github/scripts/enqueue-green-prs.mjs. Always uploaded as a workflow
# artifact; never committed.
out/

# Per-job operational caches that workers sometimes leave behind.
.cache/
.pytest_cache/

# fleet-ops#8341: .bak-* siblings of live configs are a sprawl class
# (TRUST-STACK §3) — the versioned file plus its PR is the only record.
# ci also rejects a tracked file matching this.
config/*.bak-*
config/**/*.bak-*
