{
  "name": "absent-gate-repo",
  "comment": "A repo that runs the gate reports a check row on every PR head; a missing row there means the verdict never landed — fail closed, never arm blind.",
  "files": [
    {"filename": ".github/workflows/ci.yml", "previous_filename": null}
  ],
  "gate_globs": [
    ".github/workflows/**",
    ".github/scripts/**",
    ".github/CODEOWNERS",
    ".gitleaksignore",
    ".gitleaks.toml",
    ".semgrepignore",
    ".semgrep.yml",
    ".semgrep.yaml",
    ".fleet/**"
  ],
  "checks": [
    {"name": "P14 tests / PR checks", "bucket": "pass", "state": "SUCCESS"}
  ],
  "repo_has_gate": true,
  "expect": "refuse"
}
