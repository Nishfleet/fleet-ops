  "gaps": [
    {
      "agent": "amp-runner-nish and amp-runner-rajeev",
      "unit": null,
      "reason": "Still user units under ~/.config/systemd/user, so their settings are ignored on this box. They need the same move to system units with a service user, and their own live probe, before they can be switched.",
      "issue": "#9982"
    },
    {
      "agent": "hermes-gateway and hermes-serve",
      "unit": "rootfs/etc/systemd/system/hermes-gateway.service",
      "reason": "System units with a drop-in already, but the drop-in hides nothing: the chat agent can read the fleet's seats, Cloudflare tokens and the other agents' logins. Closing that needs its own probe, because the gateway also drives Claude Code and the vault.",
      "issue": "#9981"
    },
    {
      "agent": "GitHub self-hosted agent runners",
      "unit": "rootfs/etc/systemd/system/actions.runner.Nishfleet.netcup-agent-.service.d/10-agent.conf",
      "reason": "The runner unit has NoNewPrivileges and a memory cap, and agent.yml empties ~/.config/gh and ~/.config/cloudflare inside the job, but nothing stops a job from reading the other seat logins, ~/.ssh, or the host's restic files. Closing it needs a probe that runs inside a real runner job, because the claude lane reads one seat login and the default login by design.",
      "issue": "#9983"
    }
  ]
