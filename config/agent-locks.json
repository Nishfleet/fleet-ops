    {
      "agent": "issue-desk",
      "unit": null,
      "reason": "Still a user unit under systemd/, added in #10152 after this contract was written, so its settings are ignored on this box and it can read the fleet's keys; it needs the same system unit and live ask before it can be switched.",
      "issue": "#10813"
    },
    {
      "agent": "GitHub self-hosted agent runners",
      "unit": "rootfs/etc/systemd/system/actions.runner.Nishfleet.netcup-agent-.service.d/10-agent.conf",
      "reason": "The runner unit has NoNewPrivileges and a memory cap, and agent.yml empties ~/.config/gh and ~/.config/cloudflare inside the job, but nothing stops a job from reading the other seat logins, ~/.ssh, or the host's restic files. Closing it needs a probe that runs inside a real runner job, because the claude lane reads one seat login and the default login by design.",
      "issue": "#9983"
    }
