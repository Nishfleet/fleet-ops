            "indexByName": {
              "model_id": 0,
              "litellm_model_name": 1,
              "Value": 2
            },
            "renameByName": {
              "model_id": "Seat",
              "litellm_model_name": "Group",
              "Value": "State"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
