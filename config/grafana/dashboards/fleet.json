    {
      "type": "stat",
      "id": 23,
      "title": "Broken services",
      "description": "systemd units in the failed state.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "count(node_systemd_unit_state{state=\"failed\"} == 1) or vector(0)",
