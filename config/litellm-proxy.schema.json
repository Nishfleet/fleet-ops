{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Hard gate for config/litellm-proxy.yaml (fleet-ops#8653). Nish 2026-09-28: no benching unless he says so. A failed row is never taken out of rotation: no bench list, no per-row cooldown, and the router holds a failed row for at most 60 s.",
  "type": "object",
  "required": ["model_list", "router_settings"],
  "properties": {
    "model_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_name", "litellm_params"],
        "properties": {
          "litellm_params": {
            "type": "object",
            "required": ["model"],
            "properties": { "cooldown_time": false }
          },
          "model_info": {
            "type": "object",
            "properties": { "cooldown_time": false }
          }
        }
      }
    },
    "benched": false,
    "router_settings": {
      "type": "object",
      "properties": {
        "cooldown_time": { "type": "integer", "minimum": 1, "maximum": 60 },
        "allowed_fails_policy": false
      }
    }
  }
}
