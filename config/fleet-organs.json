{
  "_doc": "Registry of known fleet organs (fleet-ops#1010). Every organ exports a heartbeat metric and must have a matching absent(<heartbeat_metric>) rule in config/fleet_rules.yml. The drill (bin/fleet-organ-heartbeat-check verify) enumerates this registry and asserts each organ's absent_alert has an expr containing absent( and the heartbeat_metric. The gate (bin/fleet-organ-heartbeat-check gate) rejects a PR that adds/changes an organ without shipping/keeping its absent() rule. Add a new organ here in the same PR that ships its absent() rule. files[] lists in-repo paths that constitute the organ (empty for organs whose exporter lives outside this repo, e.g. the live ~/.local/libexec metrics exporter or agent-state-built canaries).",
  "organs": [
    {
      "name": "metrics-export",
      "kind": "exporter",
      "heartbeat_metric": "node_textfile_mtime_seconds",
      "absent_alert": "FleetMetricsExportMissing",
      "files": ["libexec/fleet-metrics-export.py", "systemd/fleet-metrics-export.service", "systemd/fleet-metrics-export.timer"]
    },
    {
      "name": "completion-canary",
      "kind": "canary",
      "heartbeat_metric": "fleet_chain_open",
      "absent_alert": "FleetCompletionCanaryAbsent",
      "files": ["bin/fleet-completion-canary.py", "systemd/fleet-completion-canary.service", "systemd/fleet-completion-canary.timer"]
    },
    {
      "name": "undersaturation-guard",
      "kind": "guard",
      "heartbeat_metric": "fleet_pi_workers_active",
      "absent_alert": "FleetUndersatGuardAbsent",
      "files": []
    },
    {
      "name": "keystone-routing",
      "kind": "guard",
      "heartbeat_metric": "fleet_keystone_routing_heartbeat_seconds",
      "absent_alert": "FleetKeystoneRoutingAbsent",
