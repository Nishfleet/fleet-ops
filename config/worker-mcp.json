{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "chrome-devtools-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--executablePath",
        "/usr/bin/google-chrome",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
