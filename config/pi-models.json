{
  "providers": {
    "xai-oauth": {
      "name": "xAI (SuperGrok Subscription)",
      "api": "openai-responses",
      "baseUrl": "https://cli-chat-proxy.grok.com/v1",
      "models": [
        {
          "id": "grok-4.6",
          "name": "Grok 4.6",
          "reasoning": true,
          "contextWindow": 500000,
          "maxTokens": 131072,
          "input": [
            "text",
            "image"
          ],
          "cost": {
            "input": 2,
            "output": 6,
            "cacheRead": 0.5,
            "cacheWrite": 0
          }
        }
      ]
    },
    "litellm": {
      "name": "LiteLLM proxy (fleet seat routing, fleet-ops#4130 P2+P3a)",
      "baseUrl": "http://litellm.fleet.local:4000",
      "api": "openai-completions",
      "apiKey": "!cut -d= -f2- /home/nish/.config/fleet-ops/litellm-master-key.env",
      "headers": { "x-litellm-session-id": "$FLEET_TASK_ID" },
      "models": [
        {
          "id": "worker-cheap",
          "name": "LiteLLM worker-cheap (free lanes first)",
          "contextWindow": 140000,
          "maxTokens": 32768
        },
        {
          "id": "worker-capable",
          "name": "LiteLLM worker-capable (strong models)",
          "contextWindow": 140000,
          "maxTokens": 32768
        },
        {
          "id": "worker-capable-desk",
          "name": "LiteLLM worker-capable-desk (alias of worker-capable; fleet-ops#9330 desk arm)",
          "contextWindow": 140000,
          "maxTokens": 32768
        },
        {
          "id": "worker-public",
          "name": "LiteLLM worker-public (Straitly credit, public repos only, falls back to worker-capable)",
          "contextWindow": 140000,
          "maxTokens": 32768
        },
        {
          "id": "worker-public-desk",
          "name": "LiteLLM worker-public-desk (alias of worker-public; fleet-ops#9330 desk arm)",
          "contextWindow": 140000,
          "maxTokens": 32768
        }
      ]
    }
  }
}
