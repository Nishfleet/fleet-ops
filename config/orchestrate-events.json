{
  "description": "Payloads that must and must not start an orchestrate hand-off, and payloads the agent.yml Gate must park for the workflow-path route. CI jq evaluates fire() and parks() against each case; needles must appear in the named workflow so the if: and the Gate jq cannot drift from this file.",
  "needles": {
    "agent-dispatch.yml": [
      "ORCHESTRATE",
      "needs-orchestrator",
      "orchestrate",
      "nish3451",
      "nishfleet-worker[bot]",
      "github-actions[bot]",
      "orchestrator-tried",
      "orch/issue-",
      "--max-turns 80",
      "--permission-mode bypassPermissions",
      "cancel-in-progress: false",
      "vars.ORCHESTRATE == 'live' && (",
      "github.event.label.name == 'needs-orchestrator'",
      "github.event.sender.login == 'nish3451'",
      "inputs.task == 'orchestrate' && inputs.issue != ''"
    ],
    "agent.yml": [
      ".github/workflows/",
      "needs-orchestrator",
      "agent-ready,agent-in-progress",
      "workflow-files",
      "routed: the deliverable edits .github/workflows/**, which the worker App cannot push; handed to the orchestrator",
      "if jq -e --arg p '.github/workflows/' '((.title // \"\") + \"\\n\" + (.body // \"\")) | contains($p)' <<<\"$issue\" >/dev/null; then"
    ]
  },
  "orchestrate_cases": [
    {
      "id": "label-trusted-nish",
      "want": true,
      "orchestrate": "live",
      "event_name": "issues",
      "action": "labeled",
      "label": "needs-orchestrator",
      "sender": "nish3451"
    },
    {
      "id": "label-trusted-worker-bot",
