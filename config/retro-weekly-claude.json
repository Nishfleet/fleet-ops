{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(git --git-dir=*/workspaces/products/*/.git show:*)",
      "Bash(git --git-dir=*/workspaces/products/*/.git log:*)",
      "Bash(git --git-dir=*/workspaces/products/*/.git ls-tree:*)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Bash(*credentials*)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Bash(*-exec*)",
      "Bash(*-ok*)",
      "Bash(*--compress-program*)",
      "Bash(*--hostname-bin*)",
      "Bash(*-delete*)",
      "Bash(*--pre*)",
      "Bash(*curl*)",
      "Bash(*wget*)",
      "Bash(*ssh*)",
      "Bash(*gh *)"
    ]
  }
}
