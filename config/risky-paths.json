{
  "description": "The one risky-change list for agent-dispatch.yml's hold-risky job. A PR is risky when it carries the needs-coordinator label, or a changed path (or a rename's old path) matches a pattern under \"*\" (and is not a docs file under \"safe\") or under its own repo, or an added diff line matches a \"diff\" entry whose \"files\" regex matches that file (and \"not_files\" does not). Only four kinds of change are risky: data deletion, secrets or credentials, billing or money, production data or deploys; everything else merges on green checks. A file the API returns no patch for (large or binary) that a diff entry's files regex covers holds. A risky PR merges only once its exact head sha carries a coordinator-approval=success commit status or an approver's comment (prompts/orchestrator-handoff.md step 4). Patterns are case-insensitive regexes on repo-relative paths or added diff lines. \"guard\" lists the paths that define the guard itself: the review-risky job never approves a PR that touches one, a person does. The job reads this file from fleet-ops main by URL at run time, so every caller repo uses this same copy. CI runs the job's own CLASSIFY program against every case and its APPROVAL program against every approval_case below; cases carry optional \"patches\": [{file, patch}]; approval_cases carry their own approvers, the live list is APPROVERS in the job; a case with sha and comments tests the comment path (an approver's unedited PR comment with the line \"coordinator-approval: <full head sha>\").",
  "paths": {
    "*": [
      "(^|/)\\.env",
      "(^|/)\\.dev\\.vars",
      "(^|/)[^/]*(secret|credential|api[_-]?key)[^/]*$",
      "billing",
      "entitlement",
      "pricing",
      "payments?([/._-]|$)",
      "(^|[/._-])top-?up([/._-]|$)",
      "(^|[/._-])meter(s|ing)?([/._-]|$)",
      "(^|/)(dodo|stripe|checkout|invoice|refund|subscription|wallet)[^/]*([/.]|$)",
      "^\\.github/workflows/[^/]*(deploy|release|publish|prod)[^/]*\\.ya?ml$",
      "(^|/)wrangler[^/]*\\.(json|jsonc|toml)$",
      "(^|[/._-])prod(uction)?[._-][^/]*\\.(json|jsonc|ya?ml|toml|env)$|(^|/)prod(uction)?/"
    ],
    "Nishfleet/fleet-ops": [
      "^\\.github/",
      "^docs/(REBUILD-|engines/|quality-bar\\.md)",
      "(^|/)AGENTS\\.md$",
      "(^|/)CLAUDE\\.md$",
      "^\\.claude/",
      "^prompts/",
      "^config/",
      "^ansible/",
      "^containers/",
      "quadlet",
      "^credentials/",
      "^rootfs/",
      "^\\.semgrep/",
      "^\\.gitleaksignore$",
      "security"
    ]
  },
  "safe": ["^docs/", "^docs-site/.*\\.mdx?$", "(^|/)(README|CHANGELOG|CONTRIBUTING|LICENSE)[^/]*$"],
  "diff": [
    {"id": "data-delete", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(drop|delete|truncate)\\b"},
    {"id": "row-rewrite", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(update\\b[^;]*\\bset\\b|alter\\s+table|rename\\s+(to|column))"},
    {"id": "object-purge", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "(deleteObjects?\\b|purge(Bucket|Objects?|All|Data)|emptyBucket|deleteBucket|bucket\\.delete)"},
    {"id": "workflow-secrets", "hold_no_patch": true, "files": "^\\.github/", "pattern": "\\bsecrets(\\.|\\[)"},
    {"id": "secret-handling", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "(api_?key|secret|private_?key|access_?token|auth_?token|credential|password|process\\.env\\.\\w*(key|token))"},
    {"id": "prod-deploy", "hold_no_patch": true, "files": "^\\.github/|(^|/)(wrangler|infra|deploy)[^/]*", "pattern": "(wrangler(@\\S+)?\\s+(deploy|publish)|cloudflare/wrangler-action|environment:\\s*\\W*prod|--env\\s+prod|d1 (execute|migrations apply)[^\\n]*--remote)"}
  ],
  "guard": [
    "^\\.github/",
    "^config/risky-paths\\.json$",
    "^prompts/risky-review\\.md$",
    "^credentials/"
  ],
