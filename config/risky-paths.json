{
  "description": "The one risky-path list for agent-dispatch.yml's hold-risky job. A PR is risky when it carries the needs-coordinator label or any changed path (or a rename's old path) matches a pattern under \"*\" or under its own repo; a risky PR merges only once its exact head sha carries a coordinator-approval=success commit status (prompts/orchestrator-handoff.md step 4). Patterns are case-insensitive regexes on repo-relative paths. The job reads this file from fleet-ops main by URL at run time, so every caller repo uses this same copy. CI runs the job's own CLASSIFY program against every case and its APPROVAL program against every approval_case below; approval_cases carry their own approvers, the live list is APPROVERS in the job.",
  "paths": {
    "*": [
      "^\\.github/",
      "^migrations/",
      "^app/lib/auth",
      "^app/lib/data/",
      "\\.sql$",
      "billing",
      "entitlement",
      "(^|/)_headers$",
      "security-headers",
      "(^|/)[^/]*csp[^/]*$",
      "(^|/)[^/]*polic(y|ies)[^/]*$",
      "^docs/(REBUILD-|engines/|quality-bar\\.md)",
      "(^|/)package(-lock)?\\.json$",
      "(^|/)wrangler[^/]*\\.(json|jsonc|toml)$",
      "(^|/)\\.dev\\.vars",
      "(^|/)\\.env",
      "^workers/"
    ],
    "Nishfleet/fleet-ops": [
      "(^|/)AGENTS\\.md$",
      "(^|/)CLAUDE\\.md$",
      "^\\.claude/",
      "^prompts/",
      "^config/",
      "^ansible/",
      "^containers/",
      "quadlet",
      "^credentials/",
      "^rootfs/",
      "^\\.semgrep/",
      "^\\.gitleaksignore$",
      "security"
    ]
  },
