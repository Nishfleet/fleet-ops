{
  "description": "The one risky-change list for agent-dispatch.yml's hold-risky job. A PR is risky when it carries the needs-coordinator label, or a changed path (or a rename's old path) matches a pattern under \"*\" (and is not a docs file under \"safe\") or under its own repo, or an added diff line matches a \"diff\" entry whose \"files\" regex matches that file (and \"not_files\" does not). Risky on \"*\": data deletion, secrets or credentials, billing or money, production data or deploys, any workflow, and what the old arm allowlist held on product repos (auth, security, dependencies and lockfiles, migrations, workers, CSP and _headers); everything else merges on green checks. A repo key adds that repo's own paths on top of \"*\", for a lock its CODEOWNERS asks for and no other repo shares: \"Nishfleet/0509\" and \"Nishfleet/fleet-ops\" hold scripts, wrappers and script dirs (the no-glue lock, fleet-ops#8459); on fleet-ops this replaced Nish's CODEOWNERS review (fleet-ops#10336). Files under tests/ alone are not held, except a test that is a gate's own check (every tests/*.py ci.yml names, which CI checks against this list, plus the runner-jail, review and risky tests, and every tests/ file that is not a test_*.py, such as conftest.py, tests/bin/ fakes and fixtures, because a gate test loads them): CI checks tests on every run (Nish 2026-10-28, nish-vault#80, fleet-ops#10621: three tiers, guard, held, green). The same file names in another repo stay under \"*\". A file the API returns no patch for (large or binary) that a diff entry's files regex covers holds. A risky PR merges only once its exact head sha carries a coordinator-approval=success commit status or an approver's comment (prompts/orchestrator-handoff.md step 4). Patterns are case-insensitive regexes on repo-relative paths or added diff lines. \"guard\" lists the paths that define the guard itself (workflows, this file, the risky-review prompt, nothing else): a PR that touches one is approved only when the judge and a second reviewer of another model family both approve it; no person is asked. The job reads this file from fleet-ops main by URL at run time, so every caller repo uses this same copy. CI runs the job's own CLASSIFY program against every case and its APPROVAL program against every approval_case below; cases carry optional \"patches\": [{file, patch}] and an optional \"tier\" (guard, held or green) that CI also checks against \"guard\"; approval_cases carry their own approvers, the live list is APPROVERS in the job; a case with sha and comments tests the comment path (an approver's unedited PR comment with the line \"coordinator-approval: <full head sha>\").",
  "paths": {
    "*": [
      "(^|/)\\.env",
      "(^|/)\\.dev\\.vars",
      "(^|/)[^/]*(secret|credential|api[_-]?key)[^/]*$",
      "billing",
      "entitlement",
      "pricing",
      "payments?([/._-]|$)",
      "(^|[/._-])top-?up([/._-]|$)",
      "(^|[/._-])meter(s|ing)?([/._-]|$)",
      "(^|/)(dodo|stripe|checkout|invoice|refund|subscription|wallet)[^/]*([/.]|$)",
      "^\\.github/",
      "(^|/)(o?auth|sessions?|permissions?)([/._-]|$)|(^|/)auth",
      "security",
      "(^|/)(package\\.json|package-lock\\.json|pnpm-lock\\.yaml|yarn\\.lock|bun\\.lockb?|uv\\.lock|poetry\\.lock)$",
      "(^|/)requirements[^/]*\\.txt$",
      "(^|/)migrations/",
      "(^|/)workers/",
      "(^|/)[^/]*csp[^/]*$",
      "(^|/)_headers$",
      "(^|/)[^/]*wrangler[^/]*\\.(json|jsonc|toml)$",
      "(^|[/._-])prod(uction)?[._-][^/]*\\.(json|jsonc|ya?ml|toml|env)$|(^|/)prod(uction)?/",
      "(^|/)db/",
      "(^|/)(Dockerfile|\\.npmrc)$",
      "(^|/)vite\\.config\\.[cm]?[jt]s$",
      "(^|/)(AGENTS|CLAUDE)\\.md$",
      "(^|/)\\.claude/",
      "^prompts/",
      "^docs/(REBUILD-|engines/|quality-bar\\.md)"
    ],
    "Nishfleet/0509": [
      "\\.(sh|py|bash|zsh)$",
      "(^|/)bin/",
      "(^|/)scripts/"
    ],
    "Nishfleet/fleet-ops": [
      "^tests/(alert_routes_check|github_app_stub|test_blocked_by_orchestrate|test_chrome_devtools_mcp|test_claude_lanes|test_claude_managed_settings|test_claude_max_agents|test_codex_execpolicy_floor|test_cua_desk_check|test_deploy_failed_engine|test_deploy_failed_rule|test_digest_checks|test_digest_reply_shape|test_fleet_sync_deploy_blocked|test_fleet_sync_link_guard|test_fleet_update_covers_apps|test_fleet_update_false_failures|test_gh_login_check|test_hermes_computer_use|test_hermes_xai_login_check|test_intake_repos|test_issue_desk|test_lighthouse_wall|test_litellm_proxy_migration_skip|test_litellm_proxy_stop_not_failure|test_mac_topgrade|test_orch_cleanup_keeps_busy_worktree|test_orch_mirror_survives|test_orch_rework|test_paid_plans|test_provider_watch|test_quadlet_hardening|test_queue_stuck_rule|test_red_main_sweep|test_review_seat_try|test_runner_jail_start_state|test_stuck_prs_argmax|test_sweep_requeue|test_systemd_unit_keys|test_triage_admit|test_worker_github_token|test_workflow_caps|webhook_sink)\\.py$",
      "^tests/(test_runner_jail[^/]*|test_review[^/]*|test_risky[^/]*)$",
      "^tests/(?!(.*/)?test_[^/]*\\.py$)",
      "^(?!tests/).*\\.(sh|py|bash|zsh)$",
      "^(?!tests/)(.*/)?bin/",
      "^(?!tests/)(.*/)?scripts/",
      "^\\.github/",
      "^docs/(REBUILD-|engines/|quality-bar\\.md)",
      "(^|/)AGENTS\\.md$",
      "(^|/)CLAUDE\\.md$",
      "^\\.claude/",
      "^prompts/",
      "^config/",
      "^ansible/",
      "^containers/",
      "quadlet",
      "^credentials/",
      "^rootfs/",
      "^\\.semgrep/",
      "^\\.gitleaksignore$",
      "^systemd/"
    ]
  },
  "safe": ["^docs/(?!(REBUILD-|engines/|quality-bar\\.md))", "^docs-site/.*\\.mdx?$", "(^|/)(README|CHANGELOG|CONTRIBUTING|LICENSE)[^/]*$"],
  "diff": [
    {"id": "data-delete", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(drop|delete|truncate)\\b"},
    {"id": "row-rewrite", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(update\\b[^;]*\\bset\\b|alter\\s+table|rename\\s+(to|column))"},
    {"id": "object-purge", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "(deleteObjects?\\b|purge(Bucket|Objects?|All|Data)|emptyBucket|deleteBucket|bucket\\.delete)"},
    {"id": "workflow-secrets", "hold_no_patch": true, "files": "^\\.github/", "pattern": "\\bsecrets(\\.|\\[)"},
    {"id": "secret-handling", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "(api_?key|secret|private_?key|access_?token|auth_?token|credential|password|process\\.env\\.\\w*(key|token))"},
    {"id": "billing-code", "hold_no_patch": true, "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "\\b(stripe|dodo|lemonsqueezy)(\\??\\.\\w+)*\\s*\\(|\\b\\w*(chargeBilling|createCharge|refund|(create|update|cancel|pause|resume|delete)Subscription|createCheckoutSession|paymentIntents?)\\w*\\s*\\(|\\bsubscription\\??\\.\\w+\\s*\\(|\\b\\w*payment\\w*\\??\\.\\w+\\s*\\(|\\.(charges|refunds|subscriptions|invoices|paymentIntents|checkout\\??\\.sessions)\\??\\.\\w+\\s*\\(|api\\.stripe\\.com|api\\.lemonsqueezy\\.com|dodopayments\\.com"},
    {"id": "prod-deploy", "hold_no_patch": true, "files": "^\\.github/|(^|/)(wrangler|infra|deploy)[^/]*", "pattern": "(wrangler(@\\S+)?\\s+(deploy|publish)|cloudflare/wrangler-action|environment:\\s*\\W*prod|--env\\s+prod|d1 (execute|migrations apply)[^\\n]*--remote)"}
  ],
  "guard": [
    "^\\.github/(workflows|actions)/",
    "^\\.github/zizmor\\.ya?ml$",
    "^credentials/",
    "^config/risky-paths\\.json$",
    "^prompts/risky-review\\.md$"
  ],
