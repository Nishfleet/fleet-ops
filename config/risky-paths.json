{
  "description": "The one risky-change list for agent-dispatch.yml's hold-risky job and .github/workflows/coordinator-approval.yml's merge-queue gate. A PR is risky when it carries the needs-coordinator label, or a changed path (or a rename's old path) matches a pattern under \"*\" (and is not a docs file under \"safe\") or under its own repo, or an added diff line matches a \"diff\" entry whose \"files\" regex matches that file (and \"not_files\" does not). Only four kinds of change are risky on \"*\": data deletion, secrets or credentials, billing or money, production data or deploys; everything else merges on green checks. A repo key adds that repo's own paths on top of \"*\", for a lock its CODEOWNERS asks for and no other repo shares: \"Nishfleet/0509\" and \"Nishfleet/fleet-ops\" hold scripts, wrappers and script dirs (the no-glue lock, fleet-ops#8459); on fleet-ops this replaced Nish's CODEOWNERS review (fleet-ops#10336). Scripts stay held for one review (Nish 2026-10-29: three reviewers only for money, secrets, data and this list). The same file names in another repo stay under \"*\". A file the API returns no patch for (large or binary) that a diff entry's files regex covers holds. A risky PR merges only once its exact head sha carries a coordinator-approval=success commit status or an approver's comment (prompts/orchestrator-handoff.md step 4). Patterns are case-insensitive regexes on repo-relative paths or added diff lines. The `secret-handling` diff entry skips a keyword assigned a literal false on the same added line, quoted or bare: `persist-credentials: false` is actions/checkout's hardening line and handles no credential (fleet-ops#9841), while a real value such as `password: ${{ secrets.X }}`, `persist-credentials: true`, `process.env.API_KEY` and `falsey` still holds. No other diff entry carries that exemption. \"guard\" lists money, secret and data paths, this file, the review prompt, and everything under .github/: a PR that touches one needs the judge and two more reviewers of other model families. .github/ stays in it until approvals come from an identity a PR's own workflow or action cannot post as (fleet-ops#9521), because code there runs with the token that comments as github-actions[bot]. The hold-risky job reads this file from fleet-ops main by URL at run time, and the merge-queue gate reads the base commit's copy on fleet-ops and this URL on a caller repo, so a caller uses this same copy. CI runs the job's own CLASSIFY program against every case and its APPROVAL program against every approval_case below; cases carry optional \"patches\": [{file, patch}]; approval_cases carry their own approvers, the live list is APPROVERS in agent-dispatch.yml's workflow env; a case with sha and comments tests the comment path (an approver's unedited PR comment with the line \"coordinator-approval: <full head sha>\").",
  "paths": {
    "*": [
      "(^|/)\\.env",
      "(^|/)\\.dev\\.vars",
      "(^|/)[^/]*(secret|credential|api[_-]?key)[^/]*$",
      "billing",
      "entitlement",
      "pricing",
      "payments?([/._-]|$)",
      "(^|[/._-])top-?up([/._-]|$)",
      "(^|[/._-])meter(s|ing)?([/._-]|$)",
      "(^|/)(dodo|stripe|checkout|invoice|refund|subscription|wallet)[^/]*([/.]|$)",
      "^\\.github/workflows/[^/]*(deploy|release|publish|prod)[^/]*\\.ya?ml$",
      "(^|/)wrangler[^/]*\\.(json|jsonc|toml)$",
      "(^|[/._-])prod(uction)?[._-][^/]*\\.(json|jsonc|ya?ml|toml|env)$|(^|/)prod(uction)?/"
    ],
    "Nishfleet/0509": [
      "\\.(sh|py|bash|zsh)$",
      "(^|/)bin/",
      "(^|/)scripts/"
    ],
    "Nishfleet/fleet-ops": [
      "\\.(sh|py|bash|zsh)$",
      "(^|/)bin/",
      "(^|/)scripts/",
      "^\\.github/",
      "^docs/(REBUILD-|engines/|quality-bar\\.md)",
      "^docs/(d1-migrations|cloudflare-credentials|detached-worker-unit)\\.md$",
      "(^|/)AGENTS\\.md$",
      "(^|/)CLAUDE\\.md$",
      "^\\.claude/",
      "^prompts/",
      "^config/",
      "^ansible/",
      "^containers/",
      "quadlet",
      "^credentials/",
      "^rootfs/",
      "^\\.semgrep/",
      "^\\.gitleaksignore$",
      "security"
    ]
  },
  "safe": ["^docs/", "^docs-site/.*\\.mdx?$", "(^|/)(README|CHANGELOG|CONTRIBUTING|LICENSE)[^/]*$"],
  "diff": [
    {"id": "data-delete", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(drop|delete|truncate)\\b"},
    {"id": "row-rewrite", "hold_no_patch": true, "files": "\\.sql$|^migrations/", "pattern": "\\b(update\\b[^;]*\\bset\\b|alter\\s+table|rename\\s+(to|column))"},
    {"id": "object-purge", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "(deleteObjects?\\b|purge(Bucket|Objects?|All|Data)|emptyBucket|deleteBucket|bucket\\.delete)"},
    {"id": "workflow-secrets", "hold_no_patch": true, "files": "^\\.github/", "pattern": "\\bsecrets(\\.|\\[)"},
    {"id": "secret-handling", "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.|_test\\.go$|(^|/)testdata/", "pattern": "(api_?key|secret|private_?key|access_?token|auth_?token|credential|password|process\\.env\\.\\w*(key|token))(?!\\w*[ \t]*[:=][ \t]*[\"']?false\\b)"},
    {"id": "billing-code", "hold_no_patch": true, "files": "\\.(js|jsx|ts|tsx|mjs|cjs|go|py|sh|ya?ml|json|jsonc|toml)$", "not_files": "(^|/)(tests?|__tests__|evals?)/|\\.(test|spec)\\.", "pattern": "\\b(stripe|dodo|lemonsqueezy)(\\??\\.\\w+)*\\s*\\(|\\b\\w*(chargeBilling|createCharge|refund|(create|update|cancel|pause|resume|delete)Subscription|createCheckoutSession|paymentIntents?)\\w*\\s*\\(|\\bsubscription\\??\\.\\w+\\s*\\(|\\b\\w*payment\\w*\\??\\.\\w+\\s*\\(|\\.(charges|refunds|subscriptions|invoices|paymentIntents|checkout\\??\\.sessions)\\??\\.\\w+\\s*\\(|api\\.stripe\\.com|api\\.lemonsqueezy\\.com|dodopayments\\.com"},
    {"id": "prod-deploy", "hold_no_patch": true, "files": "^\\.github/|(^|/)(wrangler|infra|deploy)[^/]*", "pattern": "(wrangler(@\\S+)?\\s+(deploy|publish)|cloudflare/wrangler-action|environment:\\s*\\W*prod|--env\\s+prod|d1 (execute|migrations apply)[^\\n]*--remote)"}
  ],
  "guard": [
    "^\\.github/",
    "^config/risky-paths\\.json$",
    "^prompts/risky-review\\.md$",
    "^credentials/",
    "(^|/)\\.env",
    "(^|/)\\.dev\\.vars",
    "(^|/)[^/]*(secret|credential|api[_-]?key)[^/]*$",
    "billing",
    "entitlement",
    "pricing",
    "payments?([/._-]|$)",
    "(^|[/._-])top-?up([/._-]|$)",
    "(^|/)(dodo|stripe|checkout|invoice|refund|subscription|wallet)[^/]*([/.]|$)",
    "\\.sql$",
    "(^|/)migrations/"
  ],
