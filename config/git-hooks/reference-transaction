#!/bin/sh
# The deploy clone deploys main, and nothing else (fleet-ops#9437).
#
# git runs this hook in the `prepared` phase of every ref update (githooks(5),
# git >= 2.28) and a non-zero exit aborts the command, so a ref update that would
# put a branch or a detached HEAD into this clone fails before it happens.
# fleet-sync.service sets core.hooksPath to this directory on every sync, so an
# install needs no root and no hand step, and the hook is always the copy main
# carries. git 2.43 on this box runs it for `git update-ref`, `git checkout -b`,
# `git switch --detach`, `git worktree add -b` and a fetch from a local path, so
# those fail before they happen. It does NOT run it for a fetch over https or for
# `git checkout <a branch that already exists>`, which is the 2026-10-08 shape
# exactly: git rewrites HEAD's symref without a ref transaction, and githooks(5)
# has no hook that can abort that. fleet-sync.service step 0a is the layer for it:
# it runs before the fetch on every sync and fails the deploy while HEAD is off
# main, so an off-main clone is a loud failed deploy that pages instead of 11
# minutes of live files from an unmerged branch.
#
# Allowed: `git fetch ... :refs/remotes/origin/main`, `git merge --ff-only`,
# `git merge-base --is-ancestor`, `git checkout main`.
#
# It is a guard against accidents, not against a deliberate bypass: `git -c
# core.hooksPath=...`, and any process that writes .git/refs behind git's back
# are not covered. A linked worktree of this clone keeps its own HEAD and is
# skipped, and a worktree of any other repo never loads this file at all.
[ "$1" = prepared ] || exit 0
[ "$(git rev-parse --absolute-git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
while read -r old new ref; do
  case "$ref" in
    HEAD)
      [ "$new" = "ref:refs/heads/main" ] && continue
      echo "DEPLOY-BLOCKED: this clone deploys main, so HEAD cannot move to $new." >&2 ;;
    refs/heads/main)
      continue ;;
    refs/heads/*)
      echo "DEPLOY-BLOCKED: this clone deploys main, so it cannot hold $ref." >&2 ;;
    *)
      continue ;;
  esac
  echo "  Review from the diff, or in a fresh worktree: git worktree add /home/nish/workspaces/agent-worktrees/<name> <ref>" >&2
  exit 1
done
exit 0
