#!/bin/sh
# The deploy clone deploys main, and nothing else (fleet-ops#9437).
#
# git runs this hook in the `prepared` phase of every ref update (githooks(5),
# git >= 2.28) and a non-zero exit aborts the command, so a ref update that would
# put a branch or a detached HEAD into this clone fails before it happens.
# fleet-sync.service sets core.hooksPath to this directory on every sync, so an
# install needs no root and no hand step, and the hook is always the copy main
# carries. It covers what git lets a hook see:
#
#   git fetch origin pull/9426/head:pr-9426   creates refs/heads/pr-9426  blocked
#   git checkout -b zz                        creates refs/heads/zz        blocked
#   git switch --detach / git checkout --detach moves HEAD to a sha       blocked
#   git worktree add -b x ../x origin/main    creates refs/heads/x        blocked
#   git fetch ... :refs/remotes/origin/main, git merge --ff-only,
#   git merge-base --is-ancestor, git checkout main                     allowed
#
# What git 2.54 on this box does NOT route through a ref transaction, so this
# hook cannot see: `git checkout <a branch that already exists>` and
# `git switch <a branch that already exists>`, which rewrite HEAD's symref
# directly. That is the 2026-10-08 shape (`git checkout pr-9426` after a fetch
# that created the branch), and the fetch half of it is blocked above, so a
# branch that arrives any other way is caught by fleet-sync.service step 0a,
# which fails the deploy with DEPLOY-BLOCKED while HEAD is off main.
#
# It is a guard against accidents, not against a deliberate bypass: `git -c
# core.hooksPath=...`, a fetch that lands the branch while the hook is unset, and
# any process that writes .git/refs behind git's back are not covered. A linked
# worktree of this clone keeps its own HEAD and is skipped, and a worktree of any
# other repo never loads this file at all.
[ "$1" = prepared ] || exit 0
[ "$(git rev-parse --absolute-git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
while read -r old new ref; do
  case "$ref" in
    HEAD)
      [ "$new" = "ref:refs/heads/main" ] && continue
      echo "DEPLOY-BLOCKED: this clone deploys main, so HEAD cannot move to $new." >&2 ;;
    refs/heads/main)
      continue ;;
    refs/heads/*)
      echo "DEPLOY-BLOCKED: this clone deploys main, so it cannot hold $ref." >&2 ;;
    *)
      continue ;;
  esac
  echo "  Review from the diff, or in a fresh worktree: git worktree add /home/nish/workspaces/agent-worktrees/<name> <ref>" >&2
  exit 1
done
exit 0
