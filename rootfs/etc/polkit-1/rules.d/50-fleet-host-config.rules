// Lets user nish (the deploy-box.yml and update-box.yml runner) start
// fleet-host-config.service and fleet-update.service and nothing else, so the
// deploy jobs need no sudo. polkit is what systemd
// asks before a non-root caller starts a system unit (man polkit,
// org.freedesktop.systemd1.manage-units). Both units only apply merged main
// from their own root-owned clones (fleet-update.service with --verify-commit),
// so starting them grants no other power.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        (action.lookup("unit") == "fleet-host-config.service" ||
         action.lookup("unit") == "fleet-update.service") &&
        action.lookup("verb") == "start" &&
        subject.user == "nish") {
        return polkit.Result.YES;
    }
});
