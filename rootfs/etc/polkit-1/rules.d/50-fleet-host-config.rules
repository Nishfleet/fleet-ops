// Lets user nish (the deploy-box.yml runner) start fleet-host-config.service
// and nothing else, so the deploy job needs no sudo. polkit is what systemd
// asks before a non-root caller starts a system unit (man polkit,
// org.freedesktop.systemd1.manage-units). The unit only applies merged main
// from its own root-owned clone, so starting it grants no other power.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "fleet-host-config.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "nish") {
        return polkit.Result.YES;
    }
});
