// Lets user nish (the merge-queue host-plan job on a fleet-ci runner) start the
// plan-template instances below, and nothing else. Each one runs as its own oneshot,
// so a systemctl call from a non-root caller reaches polkit first (man polkit,
// org.freedesktop.systemd1.manage-units). Only start is granted: restart, stop, kill,
// enable and every other unit stay refused. The instance is one 40-hex sha, the head
// of an approved merge-queue entry (see rootfs/etc/systemd/system/fleet-plan@.service),
// so a guessed or hand-crafted instance name cannot start an arbitrary unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        /^fleet-plan@[0-9a-f]{40}\.service$/.test(action.lookup("unit")) &&
        action.lookup("verb") == "start" &&
        subject.user == "nish") {
        return polkit.Result.YES;
    }
});
