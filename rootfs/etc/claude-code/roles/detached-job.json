{
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Edit(~/workspaces/**)",
      "Edit(//tmp/**)",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "systemctl status *",
      "systemctl list-units *",
      "systemctl list-timers *",
      "systemctl --user status *",
      "systemctl --user list-units *",
      "systemctl --user list-timers *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "127.0.0.1:4000"
      ]
    }
  },
  "env": {
    "XDG_RUNTIME_DIR": "/run/user/1000"
  }
}
