{
  "permissions": {
    "allow": [
      "Bash",
      "Edit(//var/lib/fleet-runner/*/_work/**)",
      "Edit(//var/lib/fleet-claude/*/_work/**)",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "TodoWrite"
    ],
    "deny": [
      "Read(//var/lib/fleet-claude/.config/fleet-ops/seats/**)",
      "Read(//var/lib/fleet-runner/.config/fleet-ops/seats/**)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "systemctl status *",
      "systemctl list-units *",
      "systemctl list-timers *",
      "systemctl --user status *",
      "systemctl --user list-units *",
      "systemctl --user list-timers *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm"
      ],
      "denyRead": [
        "/var/lib/fleet-claude/.config/fleet-ops/seats/**",
        "/var/lib/fleet-runner/.config/fleet-ops/seats/**"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "127.0.0.1:4000"
      ]
    }
  }
}
