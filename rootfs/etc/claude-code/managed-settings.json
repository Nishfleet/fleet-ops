{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "advisorModel": "opus",
  "modelSettings": {
    "claude-haiku-5-5": {
      "autoCompactWindow": 100000,
      "effortLevel": "medium"
    }
  },
  "enabledPlugins": {
    "model-lanes@nish-mods": true
  },
  "permissions": {
    "deny": [
      "Agent(general-purpose)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Read(//home/nish/.config/tincan/*.secret)",
      "Read(//home/nish/.config/fleet-ops/seats/**)",
      "Bash(cat *secret*)",
      "Bash(*/.config/fleet-ops/seats/*)",
      "Bash(*/.config/tincan/*)",
      "Edit(**/bin/**)",
      "Write(**/bin/**)",
      "Edit(**/scripts/**)",
      "Write(**/scripts/**)",
      "Edit(**/libexec/**)",
      "Write(**/libexec/**)",
      "Edit(**/ops/**)",
      "Write(**/ops/**)",
      "Edit(**/hooks/**)",
      "Write(**/hooks/**)",
      "Edit(**/.github/scripts/**)",
      "Write(**/.github/scripts/**)",
      "Edit(**/*.sh)",
      "Write(**/*.sh)",
      "Edit(**/*.mjs)",
      "Write(**/*.mjs)",
      "Edit(**/.fleet/**)",
      "Write(**/.fleet/**)",
      "Edit(//home/nish/workspaces/tooling/fleet-ops-deploy-clone/**)",
      "Write(//home/nish/workspaces/tooling/fleet-ops-deploy-clone/**)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm exec wrangler:*)",
      "Bash(pnpm wrangler:*)",
      "Bash(pnpm exec wrangler:*)",
      "Bash(bunx wrangler:*)",
      "Bash(yarn wrangler:*)",
      "Bash(npm i -g wrangler:*)",
      "Bash(npm install -g wrangler:*)",
      "Bash(sed -i:*)",
      "Bash(sed --in-place:*)",
      "Bash(perl -i:*)",
      "Bash(perl -pi:*)",
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add .)",
      "Task(general-purpose)"
    ],
    "ask": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(restic forget *)",
      "Bash(reboot*)",
      "Bash(sudo reboot*)",
      "Bash(shutdown*)",
      "Bash(git stash)",
      "Bash(git stash pop*)",
      "Bash(git push *--force-with-lease*main*)",
      "Bash(git push *main*--force-with-lease*)",
      "Bash(git push *--force-with-lease*master*)",
      "Bash(git push *master*--force-with-lease*)",
      "Bash(git push *+*main*)",
      "Bash(git push *+*master*)"
    ]
  }
}
