# Generated by cua-host (`cua host setup` / Cua Spaces "Set up for access").
# Unattended access to this machine through cua-spacesd.
[Unit]
Description=Cua unattended access (cua-spacesd)
Documentation=https://github.com/trycua/cua/tree/main/libs/cua-spacesd
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/nish/.cua/host/bin/cua-spacesd join --relay https://relay.cua.ai --relay-token-file /home/nish/.cua/host/machine-token --host-policy /home/nish/.cua/host/host.json --machine-id-file /home/nish/.cua/spacesd/id --relay-jwks /home/nish/.cua/host/relay-jwks.json --token-file /home/nish/.cua/host/env-token --data-dir /home/nish/.cua/spacesd --no-desktop --no-driver --no-mcp
WorkingDirectory=/home/nish
Environment=CUA_ENV_LOG=info
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=10
StandardOutput=append:/home/nish/.cua/host/driver.log
StandardError=append:/home/nish/.cua/host/driver.log

[Install]
WantedBy=default.target
