# Monthly full restore drill (restic docs: "Restoring from backup", --verify).
# Restores the whole latest snapshot, and --verify re-reads every restored file
# against the snapshot. Then pg_restore --list proves the LiteLLM dump is
# readable and holds table data (grep -c exits 1 on a count of 0).
#
# Never over a live path: TemporaryFileSystem= mounts /var/tmp as a tmpfs in
# this unit's own namespace, so the decrypted copy lives in RAM and is gone when
# the unit ends (that is the cleanup). The tmpfs counts against MemoryMax, so
# raise the two together if the snapshot grows past 5G.
[Unit]
Description=Restic restore drill: restore and verify the latest snapshot
Documentation=https://restic.readthedocs.io/en/stable/050_restore.html
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/netcup-r2.env
EnvironmentFile=/home/nish/.config/fleet-ops/keystone-hc.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
Environment=DRILL_DIR=/var/tmp/restic-restore-drill
ExecStartPre=/usr/bin/restic unlock
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic restore latest --host netcup-rs2000 --target ${DRILL_DIR} --verify
ExecStart=/usr/bin/bash -c 'set -o pipefail; /usr/bin/pg_restore --list "$${DRILL_DIR}/home/nish/workspaces/agent-state/backups/litellm.dump" | /usr/bin/grep -c "TABLE DATA"'
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_URL_RESTORE}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TemporaryFileSystem=/var/tmp:size=5G
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
MemoryMax=6G
TimeoutStartSec=30min
ReadWritePaths=/var/cache/restic-live /run/lock /var/tmp
