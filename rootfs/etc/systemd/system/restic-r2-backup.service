# Restic backup to Cloudflare R2 (netcup VPS)
# Deployed from fleet-ops rootfs/etc/systemd/system/
# flock serializes every restic/rclone job on one lock; exit 75 on a 15-min wait timeout.
[Unit]
Description=Encrypted netcup VPS backup to Cloudflare R2
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env
ConditionPathExists=/etc/restic/include.txt
ConditionPathExists=/etc/restic/exclude.txt
ConditionPathExists=/home/nish/.local/share/fleet-litellm-postgres/run/.s.PGSQL.5432

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/netcup-r2.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
EnvironmentFile=/etc/tiny-studio/heartbeats.env
# pg_dump only runs if socket exists; chain with && so mv only happens on success.
# If pg_dump fails, the backup still runs (it just won't have a fresh dump).
ExecStartPre=+/usr/sbin/runuser -u nish -- sh -c '/usr/lib/postgresql/16/bin/pg_dump -h /home/nish/.local/share/fleet-litellm-postgres/run -U litellm -Fc -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new litellm && mv -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new /home/nish/workspaces/agent-state/backups/litellm.dump'
ExecStartPre=/usr/bin/restic unlock
# Backup using include list (--files-from) and exclude list (--exclude-file)
# Prune is handled by the weekly maintenance service (authoritative policy).
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic backup --files-from=/etc/restic/include.txt --exclude-file=/etc/restic/exclude.txt --exclude-caches --host netcup-rs2000 --tag netcup-rs2000 --json
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_BACKUP_URL}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
ReadWritePaths=/var/cache/restic-live /run/lock /home/nish/workspaces/agent-state/backups

[Install]
WantedBy=multi-user.target