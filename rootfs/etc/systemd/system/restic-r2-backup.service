# Stock restic lines (was /usr/local/sbin/restic-r2-backup, removed 2026-09-25).
# flock serializes every restic/rclone job on one lock; exit 75 on a 15-min wait timeout.
[Unit]
Description=Encrypted netcup VPS backup to Cloudflare R2
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/netcup-r2.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
EnvironmentFile=/etc/tiny-studio/heartbeats.env
ExecStartPre=+/usr/sbin/runuser -u nish -- /usr/lib/postgresql/16/bin/pg_dump -h /home/nish/.local/share/fleet-litellm-postgres/run -U litellm -Fc -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new litellm
ExecStartPre=+/usr/sbin/runuser -u nish -- /usr/bin/mv -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new /home/nish/workspaces/agent-state/backups/litellm.dump
ExecStartPre=/usr/bin/restic unlock
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic backup --exclude-file=/etc/restic/netcup-r2-excludes --exclude-caches --host netcup-rs2000 --tag netcup-rs2000 /home/nish /etc /root /srv /usr/local /var/spool/cron
ExecStartPost=-/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic forget --keep-daily 7 --keep-weekly 4 --prune
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_BACKUP_URL}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
ReadWritePaths=/var/cache/restic-live /run/lock

[Install]
WantedBy=multi-user.target
