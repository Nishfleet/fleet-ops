# Nightly restic backup, retention and heartbeat (restic docs: "Backing up",
# "Removing backup snapshots"). flock serializes every restic/rclone job on one
# lock; exit 75 on a 15-min wait timeout. --group-by host,tags keeps one policy
# across include.txt changes (restic groups by host and paths by default).
# OnSuccess= starts the copy to the locked bucket only after a good run.
[Unit]
Description=Encrypted netcup VPS backup to Cloudflare R2
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env
OnSuccess=restic-r2-locked-copy.service
# A failed run retries itself (Restart=on-failure, allowed for Type=oneshot:
# https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html#Restart=).
# The start limit ends the retries after 3 starts, so a run that keeps failing
# reaches `failed`, which SystemUnitFailed reads; without it the unit would sit in
# auto-restart forever. systemd counts starts from the first one, so the 4th
# start comes burst * (run + RestartSec) later; the interval must be longer than
# 3 * (TimeoutStartSec + RestartSec) or a slow failure resets the count and retries
# forever (tests/test_oneshot_restart.py checks this).
StartLimitIntervalSec=7h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=15min
# Type=oneshot has no start timeout by default (systemd.service(5) TimeoutStartSec=).
# Runs took at most 5 min in Oct 2026; 2h also covers both 15-min flock waits.
TimeoutStartSec=2h
EnvironmentFile=/etc/restic/netcup-r2.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
EnvironmentFile=/etc/tiny-studio/heartbeats.env
ExecStartPre=+/usr/sbin/runuser -u nish -- /usr/lib/postgresql/16/bin/pg_dump -h /home/nish/.local/share/fleet-litellm-postgres/run -U litellm -Fc -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new litellm
ExecStartPre=+/usr/sbin/runuser -u nish -- /usr/bin/mv -f /home/nish/workspaces/agent-state/backups/.litellm.dump.new /home/nish/workspaces/agent-state/backups/litellm.dump
ExecStartPre=/usr/bin/restic unlock
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic backup --files-from=/etc/restic/include.txt --exclude-file=/etc/restic/exclude.txt --exclude-caches --host netcup-rs2000 --tag netcup-rs2000
ExecStartPost=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic forget --group-by host,tags --keep-daily 7 --keep-weekly 5 --keep-monthly 12 --prune
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_BACKUP_URL}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
ReadWritePaths=/var/cache/restic-live /run/lock

[Install]
WantedBy=multi-user.target
