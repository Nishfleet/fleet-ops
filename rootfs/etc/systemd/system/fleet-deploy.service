# The deploy, as root, started by fleet-deploy.path: the root-owned host config
# (fleet-host-config.service, which applies only signed main from its own clone, so a
# forged request can at most redeploy main). Its play also installs nish's user files
# (ansible/tasks/user-files.yml).
#
# The verdict goes to /var/lib/fleet-deploy/result as one line,
# `<request> <SERVICE_RESULT> <EXIT_STATUS> <UTC time>`, and the last journal lines
# of the three units to /var/lib/fleet-deploy/log, because the runner cannot read
# the system journal. The deploy-box job polls `result` for its own request line.
# Rollback: delete this file, fleet-deploy.path and rootfs/etc/tmpfiles.d/fleet-deploy.conf
# and add them to `retired` in ansible/host.yml.
[Unit]
Description=Apply a deploy request (fleet-host-config)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# fleet-host-config.service takes up to 600s. The deploy-box job waits longer.
TimeoutStartSec=900
# The request this run serves is copied at the start, so the verdict below names
# it even when a newer request lands while the run is going.
ExecStartPre=/bin/cp /var/lib/fleet-deploy/request /var/lib/fleet-deploy/running
ExecStart=/usr/bin/systemctl start fleet-host-config.service
ExecStopPost=/usr/bin/journalctl --sync
ExecStopPost=/bin/sh -c 'journalctl --no-pager -n 100 -u fleet-deploy.service -u fleet-host-config.service >/var/lib/fleet-deploy/log'
ExecStopPost=/bin/sh -c 'r=$$(head -c 80 /var/lib/fleet-deploy/running | tr -cd "A-Za-z0-9 ._-"); printf "%%s %%s %%s %%s\n" "$$r" "$$SERVICE_RESULT" "$$EXIT_STATUS" "$$(date -u +%%FT%%TZ)" >/var/lib/fleet-deploy/result'
