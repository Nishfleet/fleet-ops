[Unit]
Description=Weekly copy of the encrypted Restic repository into locked R2 storage

[Timer]
# Weekly run: --min-age 31d means daily runs are mostly no-ops. Weekly
# gives the same reclaim cadence with one API session instead of seven.
OnCalendar=Sat *-*-* 06:15:00 Asia/Kolkata
RandomizedDelaySec=2h
AccuracySec=1h
Persistent=true
Unit=restic-r2-locked-copy.service

[Install]
WantedBy=timers.target