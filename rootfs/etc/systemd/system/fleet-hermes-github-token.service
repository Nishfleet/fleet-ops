[Unit]
Description=Mint the short-lived GitHub App login Hermes' gh CLI reads (fleet-ops#10267)
# Hermes reads issues, pull requests and workflow runs through gh, and until
# this unit it did that with nish's admin login in ~/.config/gh. The sandbox
# drop-in (hermes-.service.d/sandbox.conf) hides that path and points
# GH_CONFIG_DIR at this unit's runtime directory instead. gh has no plugin or
# credential helper that mints a token (gh help environment, "GH_TOKEN"), so
# the login is a hosts.yml this oneshot refreshes before the one-hour App
# installation token expires (REST docs, "Create an installation access token
# for an app").
#
# The request body is what config/hermes/digest-*.md run, and nothing wider: no
# repositories key, because the digest counts with `gh repo list Nishfleet` and
# then `gh pr list`/`gh run list`/`gh issue view` per repo, so it reads every
# Nishfleet repo the App is installed on; issues write, because it comments on
# the issues it is asked about; pull requests and actions read, because the
# digest reads merged PRs and workflow runs. No contents, no administration, no
# workflow write.
#
# The token lives in /run (tmpfs, mode 0700, owned by nish), never on disk and
# never in argv: the SDK holds the key and the JWT in its own process and writes
# hosts.yml itself. A failed mint leaves
# the previous hosts.yml in place and pages through OnFailure=; the timer tries
# again in 20 minutes. The StartLimit below caps how fast a pull-in chain (a
# Hermes unit retrying through Restart=always) can mint, so a crash loop cannot
# spend the installation-token quota that the worker runs share. The token is
# the same nishfleet-worker App every worker run uses, so the login is
# attributed to nishfleet-worker[bot], not to a person.
#
# A run whose token file is younger than 15 min mints nothing: a Hermes restart
# pulls this unit in (Wants= in its sandbox drop-in), and without the skip
# every restart would spend two API calls on a token that still works. The
# minter checks the file age before it mints; stock systemd has no condition on
# a file's age. gh 2.103.3 writes nothing to its config dir (fleet-ops#10184),
# so the file age is the mint time.
#
# The token directory is not private to Hermes: /run is readable by every
# process that runs as nish, so the agent lock's shared drop-in hides this
# directory from every locked listener (fleet-agent-lock.service.d/50-shared.conf
# and config/agent-locks.json must_hide).
#
# Leave or switch back: `systemctl disable --now
# fleet-hermes-github-token.timer` and `systemctl mask
# fleet-hermes-github-token.service`, then remove the Wants= and After= lines,
# GH_CONFIG_DIR and the InaccessiblePaths= line from the sandbox drop-in: the
# pull-in is a Wants=, so a masked mint leaves Hermes running with gh
# unauthenticated unless the drop-in also goes.
# Six tries in ten minutes, then the pull-ins and the timer both report start
# failures until the window passes: without a cap a Hermes crash loop would
# mint about every five seconds, and each mint spends the same installation
# token quota the worker runs spend.
StartLimitIntervalSec=10min
StartLimitBurst=6
# The first mint after a boot must reach GitHub while /run is fresh, so order
# the start after the boot-wait target instead of racing DHCP and DNS
# (systemd.special(7), "network-online.target"); a mint that still meets
# no network fails and the timer tries again in 20 minutes.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nish
RuntimeDirectory=fleet-hermes-github-token
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# GITHUB_API_URL exists so CI can run this very ExecStart against a local stub
# (tests/test_hermes_github_token.py, which ci.yml runs); the host never
# overrides it.
Environment=GITHUB_API_URL=https://api.github.com
Environment=APP_ID=4728578
# The App key lives at a fixed path on this host, so the path is spelled out:
# %h and %u both name the service manager's identity (/root) in a system unit,
# whatever User= says (systemd.unit 255, "Specifiers", for %u: "not influenced
# by the User= setting").
Environment=APP_KEY=/home/nish/.config/fleet-worker/nishfleet-worker.private-key.pem
# GitHub's Octokit SDK (@octokit/auth-app, pinned by
# config/github-app-token/package-lock.json) signs the App JWT and mints the
# installation token, so this unit carries no crypto of its own (docs:
# "Generating an installation access token for a GitHub App", "use GitHub's
# Octokit SDKs"). gh reads a file, not an SDK, so the timer and the file write
# stay. GH_HOSTS=1 tells the minter to write hosts.yml; it writes the new file
# beside the old one and renames it over, so a reader never sees a partial file.
Environment=MINT=/home/nish/.local/share/github-app-token/mint.mjs
Environment='TOKEN_PERMISSIONS={"actions":"read","issues":"write","pull_requests":"read"}'
Environment=GH_HOSTS=1
ExecStart=/opt/node-v22.23.3/bin/node ${MINT}
TimeoutStartSec=300
