# Prune and verify the Cloudflare R2 restic repository
# Deployed from fleet-ops rootfs/etc/systemd/system/
# Retention: 7 daily, 5 weekly, 12 monthly. The backup service uses
# --keep-daily 7 --keep-weekly 4 (no monthly). Maintenance keeps more
# weeklies and adds monthly for long-term history; backup service just
# controls snapshot creation. The mismatch is intentional: maintenance
# is the authoritative prune policy.
[Unit]
Description=Prune and verify the Cloudflare R2 restic repository
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/netcup-r2.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
EnvironmentFile=/etc/tiny-studio/heartbeats.env
ExecStartPre=/usr/bin/restic unlock
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic forget --keep-daily 7 --keep-weekly 5 --keep-monthly 12 --prune
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic check --read-data-subset=5%%
ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_MAINTENANCE_URL}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
ReadWritePaths=/var/cache/restic-live /run/lock

[Install]
WantedBy=multi-user.target