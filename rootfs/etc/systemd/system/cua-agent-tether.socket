[Unit]
Description=Tether's socket to the Cua daemon (one socket per agent)
Documentation=https://github.com/Nishfleet/fleet-ops/blob/main/README.md
# One agent, one socket: its access is switched off alone with
# `touch /etc/fleet-ops/tether-cua-off`. The next host-config run then stops and
# removes this unit and the proxy unit and the env file, and keeps them away
# while the file exists (`systemctl mask` fails on a unit file under /etc, and a
# plain stop lasts only until tether-agent.service restarts and Wants= it back).
# `systemctl stop cua-agent-tether.socket cua-agent-tether.service` switches it
# off at once, until that run. The daemon's own socket is owner-only and its token changes at
# every start, so this stock socket unit owns the listening socket and the
# stock systemd-socket-proxyd in cua-agent-tether.service relays to the daemon.

[Socket]
ListenStream=/run/cua-agents/tether.sock
SocketUser=nish
SocketGroup=tether
SocketMode=0660
# The directory is root-owned; 0750 would keep the tether user out of it.
# The socket file's own mode and group are what admit tether.
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
