# A rootless podman API socket for drive's weekly agent eval (2026-10-22,
# fleet-ops#9983). The eval runs on one dedicated runner (fleet-ci-3, the
# drive-eval runner group) and reaches this engine through DOCKER_HOST, so no
# runner needs the host docker socket. Own storage and own runroot: it shares
# nothing with the fleet's Quadlet containers, which live in nish's own store
# (~/.local/share/containers). Rollback: stop and disable this unit, delete this
# file and 30-eval.conf, `systemctl daemon-reload`, restart the runner.
# Delegate=yes gives rootless podman a cgroup subtree it owns (cgroupfs manager).
# No NoNewPrivileges here: rootless podman needs the setuid newuidmap/newgidmap.
# The fleet's own store (containers/storage) is hidden; containers/cache stays visible, because podman fails every pull without it.
# A `-` before a path means a missing path never stops the unit from starting.
[Unit]
Description=Rootless podman API socket for the drive agent eval
Documentation=https://github.com/Nishfleet/fleet-ops/issues/9983
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
User=nish
Group=nish
RuntimeDirectory=podman-eval
Environment=XDG_RUNTIME_DIR=/run/podman-eval
Environment=HOME=/home/nish
Delegate=yes
ExecStart=/usr/bin/podman --root /home/nish/.local/share/podman-eval/storage --runroot /run/podman-eval/runroot --cgroup-manager=cgroupfs --events-backend=file system service --time=0 unix:///run/podman-eval/podman.sock
Restart=on-failure
RestartSec=10s
# Eval containers run in this unit's cgroup, so these cap the whole eval.
MemoryMax=6G
TasksMax=4096
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/home/nish/.docker -/run/user/1000 -/home/nish/.local/share/containers/storage
InaccessiblePaths=-/home/nish/.ssh -/home/nish/.gnupg -/home/nish/.config/cloudflare -/home/nish/.cloudflare -/home/nish/.wrangler
InaccessiblePaths=-/home/nish/.config/rclone -/home/nish/.codex -/home/nish/.netrc -/home/nish/.git-credentials -/home/nish/.aws
InaccessiblePaths=-/home/nish/.oci -/home/nish/.minio -/home/nish/.juicefs -/home/nish/.config/tailscale -/home/nish/.config/glab-cli -/home/nish/.hermes
InaccessiblePaths=-/etc/restic
InaccessiblePaths=-/home/nish/.config/gh -/home/nish/.config/fleet-worker
InaccessiblePaths=-/home/nish/.claude/.credentials.json -/home/nish/.claude.json -/home/nish/.claude-vps -/home/nish/.claude-max
InaccessiblePaths=-/home/nish/.claude-nish -/home/nish/.claude-team -/home/nish/.claude-telegram -/home/nish/.claude-auth-backup-max-2026-10-10
InaccessiblePaths=-/home/nish/.local/share/claude-seat-backup
InaccessiblePaths=-/home/nish/.claude/.credentials.json.bak-alert-repair-20260909T055545Z -/home/nish/.claude/.credentials.json.bak-issue-4670-20260909T122627 -/home/nish/.claude/.credentials.json.blanked.20260821T233543
InaccessiblePaths=-/home/nish/.pi/agent/auth.json -/home/nish/.pi/agent/mcp-adapter.json -/home/nish/.pi/agent/mcp-adapter.json.bak-executor -/home/nish/.pi/agent/models-store.json -/home/nish/.pi/agent/mcp-oauth-encrypted
InaccessiblePaths=-/home/nish/workspaces/tooling/nish-vault -/home/nish/nish-vault
InaccessiblePaths=-/home/nish/.config/fleet-ops -/home/nish/.local/share/drive

[Install]
WantedBy=multi-user.target
