# The cursor-vps relay listener, as a system unit (fleet-ops#9977). See
# tincan-listen-pi.service for why this is not a user unit. Its one service
# key comes from EnvironmentFile=, which systemd reads as root, so the seats
# directory itself stays hidden from the agent. Every path is absolute because a
# system unit's %h is /root, and HOME and PATH come from the shared drop-in.
[Unit]
Description=Agent Tincan wake for cursor-vps (tincan listen -> headless agent drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=nish
Group=nish
SupplementaryGroups=
Environment=TINCAN_CONFIG=/home/nish/.config/tincan/cursor-vps.json
Environment=FLEET_TASK_ID=tincan-cursor-vps
EnvironmentFile=/home/nish/.config/fleet-ops/seats/cursor.env
WorkingDirectory=/home/nish/.local/state/tincan-listen-cursor-vps
Restart=always
RestartSec=10
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/cursor-agent -p --yolo --trust "$$(cat /home/nish/.config/tincan/prompts/cursor-vps.txt)"'

[Install]
WantedBy=multi-user.target
