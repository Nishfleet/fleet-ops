# One GitHub Actions runner (instance = runner number) as the unprivileged user
# fleet-runner, per GitHub's "Security hardening for self-hosted runners" and the
# runner's own service template (actions/runner src/Misc/layoutbin/actions.runner.service.template).
# fleet-runner has no sudo, no group shared with nish, and a home holding only the
# runner installs, pi, pi's model file and the scoped router key, so a job cannot
# read nish's logins. No GitHub App key or git credential reaches a job here: agent.yml
# mints the App token only on GitHub-hosted runners (fleet-ops#11715). Installed by
# ansible/tasks/runners.yml (fleet-ops#10935).
[Unit]
Description=GitHub Actions runner netcup-agent-%i (fleet-runner)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
User=fleet-runner
Group=fleet-runner
WorkingDirectory=/var/lib/fleet-runner/%i
Environment=HOME=/var/lib/fleet-runner
Environment=VITEST_MAX_WORKERS=2
ExecStart=/var/lib/fleet-runner/%i/runsvc.sh
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
Slice=agent.slice
# MemoryHigh is the throttle, not a kill: past it the kernel reclaims hard, and
# oomd kills the runner once that pressure holds above 40% for 60s
# (DefaultMemoryPressureDurationSec=60s in oomd.conf.d/99-fleet.conf, oomd.conf(5);
# systemd.resource-control(5), MemoryHigh= and ManagedOOMMemoryPressure=).
# 4G sat on the need: a 0509 work job's vitest run alone peaks at 3.2G anon and
# npm ci at 4.5G with page cache (measured 2026-11-07, uncapped, VITEST_MAX_WORKERS=2),
# plus the runner and pi, so jobs throttled at 4.0G and oomd killed them
# (fleet-ops#11815). 6G is that peak plus about 50%. MemoryMax=8G stays the
# per-runner hard stop and agent.slice MemoryMax=28G the pool ceiling.
MemoryHigh=6G
MemoryMax=8G
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=40%

[Install]
WantedBy=multi-user.target
