# The fleet-worker relay listener, as a system unit (fleet-ops#9977). See
# tincan-listen-pi.service for why this is not a user unit. It keeps the
# human gh login readable: its prompt runs gh commands and it is not given a
# worker token of its own.
[Unit]
Description=Agent Tincan wake for fleet-worker (tincan listen -> headless pi drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=nish
Group=nish
SupplementaryGroups=
Environment=TINCAN_CONFIG=%h/.config/tincan/fleet-worker.json
Environment=FLEET_TASK_ID=tincan-fleet-worker
WorkingDirectory=%h/.local/state/tincan-listen-fleet-worker
Restart=always
RestartSec=10
ExecStart=%h/.local/bin/tincan listen --exec '%h/.local/bin/pi --print --provider litellm --model worker-cheap < %h/.config/tincan/prompts/fleet-worker.txt'

[Install]
WantedBy=multi-user.target
