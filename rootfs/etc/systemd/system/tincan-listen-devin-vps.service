# The devin-vps relay listener, as a system unit (fleet-ops#9977). See
# tincan-listen-pi.service for why this is not a user unit. Every path is
# absolute because a system unit's %h is /root, and HOME and PATH come from the
# shared drop-in.
[Unit]
Description=Agent Tincan wake for devin-vps (tincan listen -> headless devin drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=nish
Group=nish
SupplementaryGroups=
Environment=TINCAN_CONFIG=/home/nish/.config/tincan/devin-vps.json
Environment=FLEET_TASK_ID=tincan-devin-vps
WorkingDirectory=/home/nish/.local/state/tincan-listen-devin-vps
Restart=always
RestartSec=10
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/devin -p --permission-mode dangerous -- "$$(cat /home/nish/.config/tincan/prompts/devin-vps.txt)"'

[Install]
WantedBy=multi-user.target
