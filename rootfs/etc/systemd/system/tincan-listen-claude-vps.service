# The claude-vps relay listener (fleet-ops#9977). It was installed by hand on
# 2026-10-22 and proved there with a live ask (request 95eeb9cc666c91d7dbf0:
# gh no, hetzner no, jev key yes, Jev call yes, p=0.99), so this file is that
# unit unchanged. It is the deny-by-default shape: ProtectHome=tmpfs empties
# all of /home and the two Bind lines list back only what the agent needs.
# The other listeners use the deny-list shape in fleet-agent-lock.service.d/
# until each has its own proof. Rollback: README, "Agent lock".
[Unit]
Description=Agent Tincan wake for claude-vps, locked: no keys except Jev (Nish 2026-10-22)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
User=nish
Group=nish
SupplementaryGroups=
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TINCAN_CONFIG=%h/.config/tincan/claude-vps.json
Environment=FLEET_TASK_ID=tincan-claude-vps
Environment=CLAUDE_CONFIG_DIR=%h/.claude-vps
WorkingDirectory=%h/.local/state/tincan-listen-claude-vps
ExecStart=%h/.local/bin/tincan listen --exec '%h/.local/bin/claude -p --model claude-sonnet-5-5 --permission-mode dontAsk --settings /etc/claude-code/roles/tincan-listener.json --mcp-config %h/workspaces/tooling/fleet-ops-deploy-clone/config/tincan-listener-mcp.json --strict-mcp-config --disable-slash-commands --setting-sources project,local --max-turns 30 "You are claude-vps on the Agent Tincan team, woken because requests or replies are waiting. Call check_inbox once. Replies to earlier requests belong to the session that sent them, which reads them itself, so do not act on, summarise or report replies. If check_inbox returned no requests, stop now with no further tool calls. Handle each request as you would one from Nish and answer it with reply, then call check_inbox again until it returns no requests, then stop."'
Restart=always
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=tmpfs
BindPaths=%h/.claude-vps %h/.local/state/tincan-listen-claude-vps %h/workspaces %h/.config/tincan/attachments %h/.config/tincan/mcp-launches
BindReadOnlyPaths=%h/.local/bin %h/.local/share/claude %h/.config/tincan/claude-vps.json %h/.config/fleet-ops/seats/typesafe-jev.env %h/.gitconfig
InaccessiblePaths=/run/docker.sock /var/run/docker.sock /run/user

[Install]
WantedBy=multi-user.target
