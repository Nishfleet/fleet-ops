[Unit]
Description=6h test-restore of /etc/hostname + fleet control plane from R2 restic repo — p64
# Named reason for the schedule (vault: 'a schedule needs a named reason'):
# a stale or corrupt backup is silent — there is no event to subscribe to,
# so only a periodic real restore closes the gap. 6h is the period of the
# healthchecks.io dead-man this unit now pings, inherited from
# fleet-restore-drill (fleet-ops#388), which the glue sweep deleted.

[Timer]
OnCalendar=*-*-* 00/6:00:00 Asia/Kolkata
OnBootSec=25min
RandomizedDelaySec=15min
Persistent=true
Unit=restic-r2-restore-test.service

[Install]
WantedBy=timers.target