# Test-restore /etc/hostname + fleet control plane from R2 restic repo
# Deployed from fleet-ops rootfs/etc/systemd/system/
# restore --verify re-reads every restored byte against the snapshot; cmp proves
# /etc/hostname matches the live host; test proves the fleet control plane came
# back. Freshness is alerted from node_systemd_timer_last_trigger_seconds and
# failure from SystemUnitFailed. PrivateTmp makes /var/tmp per-run and wiped.
[Unit]
Description=Test-restore /etc/hostname + fleet control plane from R2 restic repo
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/netcup-r2.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/netcup-r2.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-live
EnvironmentFile=-/home/nish/.config/fleet-ops/keystone-hc.env
ExecStartPre=/usr/bin/restic unlock
ExecStart=/usr/bin/flock -E 75 -w 900 /run/lock/restic-r2-backup.lock /usr/bin/restic restore latest --target /var/tmp/restore --include /etc/hostname --include /home/nish/.config/systemd/user --verify
ExecStart=/usr/bin/cmp /etc/hostname /var/tmp/restore/etc/hostname
ExecStart=/usr/bin/test -s /var/tmp/restore/home/nish/.config/systemd/user/syncthing.service
# Asserts the litellm control-plane symlinks come back; the old
# fleet-litellm-proxy.service name was deleted upstream (fleet-ops#8669,
# LiteLLM stack moved to Quadlet), so the assertion tracks the unit that ships.
ExecStart=/usr/bin/test -L /var/tmp/restore/home/nish/.config/systemd/user/fleet-litellm-proxy-config.service
ExecStartPost=-/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HC_URL_RESTORE}
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
NoNewPrivileges=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectHome=read-only
ReadWritePaths=/var/cache/restic-live /run/lock /var/tmp
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target