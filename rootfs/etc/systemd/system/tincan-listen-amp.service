# The amp relay listener, as a system unit (fleet-ops#9977). See
# tincan-listen-pi.service for why this is not a user unit. Every path is
# absolute because a system unit's %h is /root, and HOME and PATH come from the
# shared drop-in.
[Unit]
Description=Agent Tincan wake for amp (tincan listen -> headless amp drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=nish
Group=nish
SupplementaryGroups=
Environment=TINCAN_CONFIG=/home/nish/.config/tincan/amp.json
Environment=FLEET_TASK_ID=tincan-amp
Environment=CLAUDE_CONFIG_DIR=/home/nish/.claude-vps
WorkingDirectory=/home/nish/.local/state/tincan-listen-amp
Restart=always
RestartSec=10
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/amp -x'

[Install]
WantedBy=multi-user.target
