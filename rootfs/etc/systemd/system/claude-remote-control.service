# Claude Code Remote Control server for ~/workspaces
# (https://code.claude.com/docs/en/remote-control, server mode). Replaces the
# hand-started tmux session "rc": restarts on crash, after the ~10 min network
# give-up the docs describe, and on reboot. Runs in claude.slice for CPU and
# memory priority over runner jobs.
# PATH is set here rather than from ~/.config/environment.d on purpose: that
# directory also exports CLAUDE_CODE_OAUTH_TOKEN, and Remote Control needs the
# claude.ai login instead.
# Installed and enabled at boot by fleet-host-config.service (ansible/host.yml).
[Unit]
Description=Claude Code Remote Control server (~/workspaces)
Wants=network-online.target
After=network-online.target user@1000.service

[Service]
User=nish
Group=nish
WorkingDirectory=/home/nish/workspaces
Environment=HOME=/home/nish SHELL=/usr/bin/zsh LANG=en_US.UTF-8
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# The TUI redraws the status line to stdout (~2k journal lines an hour); errors go
# to stderr and still reach the journal.
StandardOutput=null
# Nish 2026-10-03: sessions get full permissions (no prompts). Without the flag
# the server starts every session in "auto" mode, which raises prompts with no
# "always allow" option. permissions.ask/deny in ~/.claude/settings.json still
# gate force-push, reboot and deletes.
# Nish 2026-10-08 (#9425): no pre-created session, so relay work is
# fresh-per-task. The stock default (--create-session-in-dir) starts one standing
# session in ~/workspaces that every relayed coordinator message lands in, so it
# only grows: session a11f73e7 carried a 73k average context over 708 turns and
# cost $52.0 in 21.0 h, $2.47/h, with a $4.3/h peak in its busiest 3 h (#9407's
# measurement). With the flag off, each request from the phone or a claude.ai/code
# project relay gets its own session that starts and ends with a fresh context.
# Cost: opening the relay from the phone now creates the session instead of
# typing into one that is already there. The flag is stock: it is the
# --[no-]create-session-in-dir option that `claude remote-control --help`
# documents as on by default.
# Staged, not live: ansible/host.yml enables this unit and never restarts it, so
# a merge leaves the old session running. Only Nish restarts it, in a window he
# picks, because a restart cuts his phone link.
ExecStart=/home/nish/.local/bin/claude remote-control --name vps-rc --spawn=same-dir --permission-mode bypassPermissions --no-create-session-in-dir
Slice=claude.slice
OOMScoreAdjust=-900
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
