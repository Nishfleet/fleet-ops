# Claude Code Remote Control server for ~/workspaces
# (https://code.claude.com/docs/en/remote-control, server mode). Replaces the
# hand-started tmux session "rc": restarts on crash, after the ~10 min network
# give-up the docs describe, and on reboot. Runs in claude.slice for CPU and
# memory priority over runner jobs.
# PATH is set here rather than from ~/.config/environment.d on purpose: that
# directory also exports CLAUDE_CODE_OAUTH_TOKEN, and Remote Control needs the
# claude.ai login instead.
# Installed and enabled at boot by fleet-host-config.service (ansible/host.yml).
[Unit]
Description=Claude Code Remote Control server (~/workspaces)
Wants=network-online.target
After=network-online.target user@1000.service

[Service]
User=nish
Group=nish
WorkingDirectory=/home/nish/workspaces
Environment=HOME=/home/nish SHELL=/usr/bin/zsh LANG=en_US.UTF-8
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# The TUI redraws the status line to stdout (~2k journal lines an hour); errors go
# to stderr and still reach the journal.
StandardOutput=null
# Nish 2026-10-03: sessions got full permissions (no prompts). Nish 2026-10-09 (fleet-ops#9502):
# bypassPermissions skipped every permissions.ask rule. --permission-mode dontAsk keeps the
# bridge prompt-free and denies a call that would have prompted; the phone app can report it.
# `claude remote-control` refuses --settings (not carried to spawned sessions). Spawned
# sessions read ~/.claude/settings.json. The allow list in the repo is
# rootfs/etc/claude-code/roles/remote-control.json. dontAsk is intended: a call that
# would have prompted is denied and the phone app reports it, with no prompt to tap.
# Roll back: put --permission-mode bypassPermissions back on ExecStart and restart
# (only Nish restarts this unit, see below).
# Nish 2026-10-08 (#9425): --no-create-session-in-dir, so relayed coordinator
# work is fresh-per-task instead of piling into one standing session that only
# grows. The measurements, the cost and the session-file consequence are in the
# README, under the weekly-update heading, which is the source.
# Staged, not live: ansible/host.yml installs and enables this unit and never
# restarts it, so a merge leaves the old server and its old session running.
# Only Nish restarts it, because that cuts his phone link. The restart starts
# with `systemctl daemon-reload`, without which systemd keeps the ExecStart line
# it already loaded and the flag never takes effect.
ExecStart=/home/nish/.local/bin/claude remote-control --name vps-rc --spawn=same-dir --permission-mode dontAsk --no-create-session-in-dir
Slice=claude.slice
OOMScoreAdjust=-900
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
