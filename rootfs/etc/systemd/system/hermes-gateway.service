[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
After=user@1000.service
Wants=user@1000.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90s
User=nish
Group=nish
ExecStart="/home/nish/.hermes/hermes-agent/.hermes/bin/hermes" "gateway" "run"
WorkingDirectory=/home/nish/.hermes
Environment="HOME=/home/nish"
Environment="USER=nish"
Environment="LOGNAME=nish"
Environment="PATH=/home/nish/.hermes/tools/node-26.7.0-linux-x64/bin:/home/nish/.hermes/tools/npm-12.0.2-linux-x64/bin:/home/nish/.hermes/hermes-agent/node_modules/.bin:/home/nish/.hermes/node/bin:/home/nish/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Environment="HERMES_HOME=/home/nish/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-"/home/nish/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-"/home/nish/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
