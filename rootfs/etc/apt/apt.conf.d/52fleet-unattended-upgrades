// unattended-upgrades takes regular Ubuntu updates and the vendor apt repos
// this box installs from, the work the old daily update play did by hand.
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-updates";
};
Unattended-Upgrade::Origins-Pattern {
        "origin=Anthropic";
        "origin=gh";
        "origin=Syncthing";
        "origin=Tailscale";
        "origin=Google LLC";
};
// A pending reboot is taken in the Sunday 03:30 IST quiet window (fleet-ops#11922).
// Automatic-Reboot-Time is passed to shutdown(8), which takes a time of day and
// not a weekday, so the weekly part is the apt-daily-upgrade.timer drop-in
// (rootfs/etc/systemd/system/apt-daily-upgrade.timer.d/50-fleet-weekly.conf).
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "03:30";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
