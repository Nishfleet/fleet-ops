// unattended-upgrades takes regular Ubuntu updates and the vendor apt repos
// this box installs from, the work the old daily update play did by hand.
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-updates";
};
Unattended-Upgrade::Origins-Pattern {
        "origin=Anthropic";
        "origin=gh";
        "origin=Syncthing";
        "origin=Tailscale";
        "origin=Google LLC";
};
// Unattended-upgrades never reboots (Automatic-Reboot "false", the vendor
// default: https://ubuntu.com/server/docs/how-to/software/automatic-updates/).
// Automatic-Reboot-Time is a time of day and cannot name a weekday
// (shutdown(8)), so a pending reboot is taken by the Sunday 04:00 restart
// (rootfs/etc/systemd/system/fleet-reboot.timer) that closes the weekly
// maintenance window. Packages upgrade daily on the vendor's stock
// apt-daily-upgrade.timer; a kernel installed on any day takes effect there.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
