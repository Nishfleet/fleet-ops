// unattended-upgrades takes regular Ubuntu updates and the vendor apt repos
// this box installs from, the work the old daily update play did by hand.
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-updates";
};
Unattended-Upgrade::Origins-Pattern {
        "origin=Anthropic";
        "origin=gh";
        "origin=Syncthing";
        "origin=Tailscale";
        "origin=Google LLC";
};
// The Sunday window's restart is fleet-reboot.timer at 04:00:
// it runs every week, not only in a week that needs a reboot, and it waits for
// this upgrade (03:00) and the tool update (03:10) to finish. The vendor's own
// reboot would be a second owner of the same instant, so it is off.
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
