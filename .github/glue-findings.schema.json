{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["path", "line", "what", "replacement", "verify", "termination"],
    "properties": {
      "path": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._/@-]+$"},
      "line": {"type": "integer", "minimum": 1},
      "what": {"type": "string", "minLength": 10, "maxLength": 300},
      "replacement": {"type": "string", "minLength": 5, "maxLength": 300},
      "verify": {"type": "string", "minLength": 5, "maxLength": 300},
      "termination": {"type": "string", "minLength": 5, "maxLength": 300}
    }
  }
}
