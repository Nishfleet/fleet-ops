# OpenTofu state encryption for infra/cloudflare-tokens/ (README.md, "State encryption").
# Copy to ~/.config/cloudflare/tofu-state-encryption.env with mode 0600, replace the
# placeholder with a generated passphrase, never commit the real file. The value is one
# JSON line that OpenTofu reads from TF_ENCRYPTION. The fallback lets the first apply
# read the old plain state; delete the "fallback" member once the state is encrypted.
TF_ENCRYPTION={"key_provider":{"pbkdf2":{"state":{"passphrase":"PASTE_THE_GENERATED_PASSPHRASE_HERE"}}},"method":{"aes_gcm":{"state":{"keys":"key_provider.pbkdf2.state"}},"unencrypted":{"migrate":{}}},"state":{"method":"method.aes_gcm.state","fallback":{"method":"method.unencrypted.migrate"}}}
