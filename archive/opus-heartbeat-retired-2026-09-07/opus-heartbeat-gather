def scout_last_run():
    rc, out, err = run(
        [
            "systemctl",
            "--user",
            "list-timers",
            "--all",
            "--no-pager",
            "pi-scout@*",
        ]
    )
    # Fallback: list all and filter — some systemd versions ignore the pattern
    if "pi-scout@" not in out:
        rc2, out2, _ = run(
            ["systemctl", "--user", "list-timers", "--all", "--no-pager"]
        )
        if rc2 == 0:
            out = "\n".join(l for l in out2.splitlines() if "pi-scout@" in l)
            rc = rc2
    rows = []
    now = now_epoch()
    for line in out.splitlines():
        if "pi-scout@" not in line:
            continue
        # LAST is a human date; also ask systemd show
        unit = None
        for tok in line.split():
            if tok.startswith("pi-scout@") and tok.endswith(".timer"):
                unit = tok
                break
        if not unit:
            continue
        src, sout, _ = run(
            [
                "systemctl",
                "--user",
                "show",
                unit,
                "-p",
                "LastTriggerUSec",
                "-p",
                "NextElapseUSecRealtime",
                "--no-pager",
            ]
        )
        last_us = None
        next_us = None
        for sl in sout.splitlines():
            if sl.startswith("LastTriggerUSec="):
                last_us = sl.split("=", 1)[1]
            elif sl.startswith("NextElapseUSecRealtime="):
                next_us = sl.split("=", 1)[1]
        last_epoch = _systemd_timestamp_to_epoch(last_us)
        age = None if last_epoch is None else max(0, now - last_epoch)
        rows.append(
            {
                "timer": unit,
                "last_trigger": last_us,
                "last_epoch": last_epoch,
                "age_s": age,
                "next": next_us,
            }
        )
    oldest = None
    if rows:
        ages = [r["age_s"] for r in rows if r["age_s"] is not None]
        oldest = max(ages) if ages else None
    # stale_after_s lets consumers compare oldest_age_s against the real
    # scout-cadence bound instead of the snapshot window (fleet-ops#3189).
    return {
        "rc": rc,
        "n": len(rows),
        "oldest_age_s": oldest,
        "stale_after_s": SCOUT_STALE_S,
        "timers": rows,
        "error": err.strip() or None,
    }


def _systemd_timestamp_to_epoch(s):
    if not s or s in ("n/a", "0"):
        return None
    # "Thu 2026-08-27 20:00:56 IST" or microseconds since epoch
    if s.isdigit():
        us = int(s)
        if us <= 0:
            return None
        return us // 1_000_000
    rc, out, _ = run(["date", "-d", s, "+%s"])
    if rc == 0 and out.strip().isdigit():
        return int(out.strip())
    return None


