def check_failed_units_gate(fixture_path):
    """fleet-ops#2751 self-check: run parse + merge_prom_failed on a fixture
    file so the regression test does not need live systemctl or a live
    Prometheus. Fixture JSON:
      {
        "name": "<scenario>",
        "systemctl": {"rc": 0, "out": ""},
        "prom_rows": [{"metric": {"name": "u.service", "state": "failed"},
                       "value": [0, "1"]}],   // omit to simulate prom down
        "expect": {"names": [...], "count": N, "prom_merged": [...]}
      }
    Prints the merged system block and exits 0 when every expect key matches,
    1 otherwise."""
    import json as _json

    data = _json.loads(Path(fixture_path).read_text(encoding="utf-8"))
    sysctl = data.get("systemctl") or {"rc": 0, "out": ""}
    system = parse_failed_units_output(int(sysctl.get("rc", 0)), (sysctl.get("out") or ""), "system")
    if data.get("prom_rows") is None:
        system["crosscheck"] = {
            "source": 'node_systemd_unit_state{state="failed"} == 1',
            "status": "prom_unavailable",
            "error": "fixture_simulated_prom_down",
        }
    else:
        system = merge_prom_failed(system, prom_failed_names(data.get("prom_rows")))
        system["crosscheck"] = {
            "source": 'node_systemd_unit_state{state="failed"} == 1',
            "status": "ok",
            "prom_merged": system.get("prom_merged", []),
        }
    expect = data.get("expect") or {}
    ok = True
    for key, want in expect.items():
        got = system.get(key)
        if got != want:
            ok = False
            print(f"MISMATCH {key}: expected={want!r} got={got!r}", file=sys.stderr)
    print(_json.dumps(system, separators=(",", ":"), default=str))
    return 0 if ok else 1


def check_scout_staleness_gate(fixture_path):
    """Hermetic self-check for the scout staleness gate (fleet-ops#3189).

    The pi-scout@ timers fire on a 4h cadence, so an age must be compared
    against SCOUT_STALE_S (15000s) — not the 2h snapshot window — or every
    healthy cycle is flagged "stale". This subcommand drives the SAME gate
    logic in isolation so the regression test does not need live systemctl.
    Fixture JSON:
      {
        "rows": [{"timer": "pi-scout@0509.timer", "age_s": 11452}, ...],
        "expect_stale": ["pi-scout@0509.timer", ...]
      }
    Prints the stale set and exits 0 when the stale rows match expect_stale,
    1 otherwise."""
    import json as _json

    data = _json.loads(Path(fixture_path).read_text(encoding="utf-8"))
    rows = data.get("rows") or []
    stale = []
    for r in rows:
        age = r.get("age_s")
        if age is not None and age > SCOUT_STALE_S:
            stale.append(r.get("timer"))
    stale = sorted(t for t in stale if t is not None)
    expect = sorted(data.get("expect_stale") or [])
    ok = stale == expect
    if not ok:
        print(f"MISMATCH expect_stale={expect!r} got={stale!r}", file=sys.stderr)
    print(_json.dumps(
        {"stale_scouts": len(stale), "stale_rows": stale, "stale_after_s": SCOUT_STALE_S},
        separators=(",", ":"),
    ))
    return 0 if ok else 1


