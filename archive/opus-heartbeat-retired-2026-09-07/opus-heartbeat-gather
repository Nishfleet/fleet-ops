def _extract_verify_line(body):
    """Pull the Verification:/run-proof: cue from a PR body (display only).

    Kept for the verify_claim display field. Classification lives in
    _receipt_classifier — the shared grammar — so this line check can no
    longer disagree with the merge gate (fleet-ops#3731).
    """
    if not body:
        return None
    for line in body.splitlines():
        s = line.strip()
        low = s.lower()
        if low.startswith("verification:") or low.startswith("run-proof:"):
            return s
    return None


# fleet-ops#3731: ONE receipt grammar for the whole fleet. The slot's own
# line-start check classified a verified PR (fleet-ops#3717, body carried
# `## Verification` + a fenced run) as has_verify_cue=false and the judge
# filed a false unverified-merge finding. The authority is
# lib/exec-review-receipt.py — the same has_receipt() the worker --body
# gate, the heartbeat scan/disarm, and the tier1 arm gate all call —
# loaded from the installed copy (symlinked into the deploy clone, so the
# merged grammar is live here on the next deploy). Any load failure falls
# back to the legacy line check; the slot reports which grammar ran.
RECEIPT_LIB = os.environ.get(
    "OPUS_HB_RECEIPT_LIB",
    "/home/nish/.local/lib/pi-packet/exec-review-receipt.py",
)


def _receipt_classifier():
    """Return (has_receipt_fn, grammar_label). Never raises."""
    try:
        import importlib.machinery
        import importlib.util

        loader = importlib.machinery.SourceFileLoader(
            "exec_review_receipt", RECEIPT_LIB
        )
        spec = importlib.util.spec_from_file_location(
            "exec_review_receipt", RECEIPT_LIB, loader=loader
        )
        if spec is None or spec.loader is None:
            raise ImportError(f"no spec for {RECEIPT_LIB}")
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod.has_receipt, "shared"
    except Exception:
        return lambda body: _extract_verify_line(body) is not None, "fallback-line"


def t_random_merged_pr_verify():
    """Random merged PR in the last 24h and its claimed verification cue.

    Re-execution of an arbitrary PR's verify command is not allowlisted (and
    would be a side effect), so this slot SAMPLES the claim: it picks one
    recently-merged PR and reports whether the body carries a verification
    receipt under the SHARED grammar (lib/exec-review-receipt.py). The
    judge reviews plausibility; a missing cue on a merged PR is itself a
    finding (unverified merge).

    fleet-ops#3731: the slot also reports the FULL 24h classification —
    candidates_24h, missing_cue count and the missing slugs (revert/
    heads exempt, same as the tier1 arm gate) — so one sampled false
    negative can never again masquerade as the fleet-wide rate.
    """
    has_receipt, grammar = _receipt_classifier()
    cut = now_epoch() - THOROUGH_WINDOW
    candidates = []
    for repo in ENROLLED_REPOS:
        rc, stdout, err = run(
            ["gh", "pr", "list", "-R", f"Nishfleet/{repo}", "--state", "merged",
             "-L", "50", "--json", "number,title,mergedAt,body,headRefName"],
            timeout=25,
        )
        if rc != 0:
            continue
        try:
            rows = json.loads(stdout)
        except json.JSONDecodeError:
            continue
        for r in rows:
            mt = _parse_ts(r.get("mergedAt") or "")
            if mt is None or mt < cut:
                continue
            r["repo"] = repo
            candidates.append(r)
    if not candidates:
        return {"picked": None, "reason": "no merged PR in 24h window",
                "grammar": grammar}
    missing = []
    pool = []
    for r in candidates:
        head = str(r.get("headRefName") or "")
        if head.startswith("revert/"):
            continue  # auto-revert: no worker, no cue — same tier1 exemption
        pool.append(r)
        if not has_receipt(str(r.get("body") or "")):
            missing.append(f"{r.get('repo')}#{r.get('number')}")
    import random
    pick = random.choice(pool or candidates)
    verify = _extract_verify_line(pick.get("body"))
    pick_ok = has_receipt(str(pick.get("body") or ""))
    return {
        "picked": {"repo": pick.get("repo"), "number": pick.get("number"),
                   "title": pick.get("title"), "mergedAt": pick.get("mergedAt")},
        "verify_claim": verify,
        "has_verify_cue": pick_ok,
        "grammar": grammar,
        "candidates_24h": len(candidates),
        "classified_24h": len(pool),
        "missing_cue": len(missing),
        "missing_slugs": missing[:10],
    }


def check_verify_cue_gate(fixture_path):
    """Hermetic self-check for the merged-PR verify-cue slot (fleet-ops#3731).

    Drives the SAME receipt classification the slot uses, offline, so the
    regression test needs no live gh. Fixture JSON:
      {"cases": [{"name": str, "body": str, "expect": true|false}, ...]}
    Prints {"grammar": ..., "mismatches": [...]} and exits 0 when every
    case matches its expected receipt verdict, 1 otherwise."""
    import json as _json

    has_receipt, grammar = _receipt_classifier()
    data = _json.loads(Path(fixture_path).read_text(encoding="utf-8"))
    cases = data.get("cases") or []
    mismatches = []
    results = {}
    for c in cases:
        got = bool(has_receipt(str(c.get("body") or "")))
        results[c.get("name")] = got
        if got != bool(c.get("expect")):
            mismatches.append(c.get("name"))
    print(_json.dumps(
        {"grammar": grammar, "results": results, "mismatches": mismatches},
        separators=(",", ":"),
    ))
    return 0 if not mismatches else 1


