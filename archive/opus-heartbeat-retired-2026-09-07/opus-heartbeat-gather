        "packets_24h": len(packets),
        "oldest_packet_age_s": oldest_age,
        "packets_sample": packets[:5],
    }


def t_quality_shares():
    """Quality-SLO snapshot key fields (read-only)."""
    if not QUALITY_SLO.is_file():
        return {"present": False}
    try:
        doc = json.loads(QUALITY_SLO.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as ex:
        return {"present": False, "error": str(ex)}
    # keep it compact: top-level scalars + a few list lengths
    compact = {}
    for k, v in doc.items():
        if isinstance(v, (str, int, float, bool)) or v is None:
            compact[k] = v
        elif isinstance(v, list):
            compact[k] = f"list[{len(v)}]"
        elif isinstance(v, dict):
            compact[k] = f"dict[{len(v)}]"
    return {"present": True, "fields": compact}


