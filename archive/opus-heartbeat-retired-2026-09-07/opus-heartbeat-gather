def now_epoch() -> int:
    return int(time.time())


def iso_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run(argv, timeout=15, env=None):
    e = os.environ.copy()
    e["XDG_RUNTIME_DIR"] = XDG
    if env:
        e.update(env)
    try:
        p = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=e,
        )
        return p.returncode, p.stdout or "", p.stderr or ""
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as ex:
        return 124, "", str(ex)


def http_json(url, timeout=8):
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as ex:
        return {"_error": str(ex)}


def promql(query):
    q = urllib.parse.urlencode({"query": query})
    doc = http_json(f"{PROM}/api/v1/query?{q}")
    if doc.get("status") != "success":
        return None, doc.get("_error") or doc.get("error") or "promql_fail"
    rows = doc.get("data", {}).get("result") or []
    if not rows:
        return None, "empty"
    return rows, None


def scalar(query):
    rows, err = promql(query)
    if err or not rows:
        return None
    try:
        return float(rows[0]["value"][1])
    except (KeyError, IndexError, TypeError, ValueError):
        return None


def parse_prom_file(path: Path):
    out = []
    if not path.is_file():
        return out
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return out
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        out.append(line)
    return out


def metric_map(lines, name):
    """Parse NAME{labels} value lines into {label_tuple_or_None: float}."""
    found = {}
    prefix = name
    for line in lines:
        if not line.startswith(prefix):
            continue
        rest = line[len(prefix) :]
        labels = {}
        if rest.startswith("{"):
            end = rest.find("}")
            if end < 0:
                continue
            body, rest = rest[1:end], rest[end + 1 :]
            for part in body.split(","):
                if "=" not in part:
                    continue
                k, v = part.split("=", 1)
                labels[k.strip()] = v.strip().strip('"')
        rest = rest.strip()
        try:
            val = float(rest.split()[0])
        except (ValueError, IndexError):
            continue
        key = tuple(sorted(labels.items())) if labels else None
        found[key] = val
    return found


def prom_failed_names(rows):
    """Unit names whose node_systemd_unit_state{state="failed"} value is 1
    in an instant-vector result — the same series and the same == 1 match
    the SystemUnitFailed alert evaluates (config/fleet_rules.yml). Rows with
    value 0 are currently-fine units and never merge."""
    names = []
    for r in rows or []:
        try:
            if float(r.get("value", [0, "0"])[1]) == 1.0:
                names.append(r.get("metric", {}).get("name") or "")
        except (ValueError, TypeError, IndexError, KeyError):
            continue
    return [n for n in names if n]


def merge_prom_failed(system, prom_failed):
    """fleet-ops#2751: a single instant `systemctl --failed` query can miss a
    transient system unit that node_exporter still sees failed — a flapping
    unit (failed -> activating -> failed, e.g. netplan's
    systemd-networkd-wait-online.service) dodges the instant query while the
    15s node scrape catches the failed phase. The 2026-09-02T01:30:13Z
    snapshot reported failed_system=0 while SystemUnitFailed fired critical
    since 01:17:40Z: the snapshot lied, the alert plane was truthful.
    Cross-check the systemctl result against the alert's own series
    (node_systemd_unit_state{state="failed"} == 1) and merge any
    Prometheus-seen failed unit into names/count so a transient failure
    stays held visible. User scope is unchanged: node_exporter's systemd
    collector is system-scope only, so there is no prom series for user
    units to cross-check."""
    missing = [n for n in prom_failed if n not in system["names"]]
    if not missing:
        return system
    merged = dict(system)
    merged["names"] = list(system["names"]) + missing
    merged["count"] = len(merged["names"])
    merged["prom_merged"] = missing
    return merged


def parse_failed_units_output(rc, out, scope):
    names = []
    for line in out.splitlines():
        # UNIT LOAD ACTIVE SUB DESCRIPTION — skip header
        if line.startswith("UNIT ") or line.startswith("  "):
            continue
        parts = line.split()
        if len(parts) >= 4 and parts[3] == "failed":
            names.append(parts[0])
        elif "failed" in line and parts:
            # --plain --no-legend: first field is unit
            if parts[0].endswith(".service") or parts[0].endswith(".timer"):
                names.append(parts[0])
    return {"scope": scope, "rc": rc, "names": names, "count": len(names)}


def failed_units():
    u_rc, u_out, _ = run(
        ["systemctl", "--user", "--failed", "--no-pager", "--plain", "--no-legend"]
    )
    s_rc, s_out, _ = run(
        ["systemctl", "--failed", "--no-pager", "--plain", "--no-legend"]
    )
    system = parse_failed_units_output(s_rc, s_out, "system")
    # fleet-ops#2751: cross-check the instant systemctl query against the
    # same node_exporter series the SystemUnitFailed alert reads, so a
    # transient/flapping system failure stays visible in the snapshot.
    rows, err = promql('node_systemd_unit_state{state="failed"}')
    if err:
        system["crosscheck"] = {
            "source": 'node_systemd_unit_state{state="failed"} == 1',
            "status": "prom_unavailable",
            "error": err,
        }
    else:
        system = merge_prom_failed(system, prom_failed_names(rows))
        system["crosscheck"] = {
            "source": 'node_systemd_unit_state{state="failed"} == 1',
            "status": "ok",
            "prom_merged": system.get("prom_merged", []),
        }
    return {
        "user": parse_failed_units_output(u_rc, u_out, "user"),
        "system": system,
    }


def prom_alerts():
    doc = http_json(f"{PROM}/api/v1/alerts")
    if "_error" in doc:
        return {"error": doc["_error"], "firing": [], "pending": []}
    firing, pending = [], []
    for a in doc.get("data", {}).get("alerts") or []:
        labels = a.get("labels") or {}
        item = {
            "name": labels.get("alertname"),
            "state": a.get("state"),
            "severity": labels.get("severity"),
            "service": labels.get("service"),
            "activeAt": a.get("activeAt"),
            "value": a.get("value"),
        }
        st = a.get("state")
        if st == "firing":
            firing.append(item)
        elif st == "pending":
            pending.append(item)
    return {
        "firing_n": len(firing),
        "pending_n": len(pending),
        "firing": firing,
        "pending": pending,
    }


def chain_stats():
    lines = parse_prom_file(TEXTDIR / "fleet-chains.prom")
    if not lines:
        return {"present": False}
    open_m = metric_map(lines, "fleet_chain_open")
    stalled_m = metric_map(lines, "fleet_chain_stalled")
    cycle_m = metric_map(lines, "fleet_chain_cycle_seconds")

    def expand(m):
        rows = []
        total = 0.0
        for k, v in m.items():
            labels = dict(k) if k else {}
            rows.append({"labels": labels, "value": v})
            total += v
        return {"total": total, "rows": rows}

    return {
        "present": True,
        "open": expand(open_m),
        "stalled": expand(stalled_m),
        "cycle": expand(cycle_m),
    }


def _intentional_corpse_keys():
    """Build a set of ``provider/model`` keys for cap=0 intentional_cap_zero=corpse rows.

    Mirrors libexec/fleet-metrics-export.py _seat_caps_model_cap_map +
    _read_dead_credentials: a cap=0 row is never picked, so a dead seat on
    it is not an actionable fault. The duty officer snapshot must exclude
    these so it does not re-file issues about already-retired seats every
    tick (fleet-ops#3983: 8 duplicate MiniMax corpse PRs in 7d, 35.6% of
    self-maintenance merges).

    Only ``intentional_cap_zero=corpse`` rows are excluded — ``stale`` rows
    may still need visibility. Returns a frozenset (empty when the config is
    missing/unparseable, so a missing config never silently hides corpses).
    """
    for caps_path in (SEAT_CAPS_LIVE, SEAT_CAPS_REPO, SEAT_CAPS_FALLBACK):
        try:
            data = json.loads(caps_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        providers = data.get("providers") or {}
        if not isinstance(providers, dict):
            continue
        keys = set()
        for prov, cfg in providers.items():
            if not isinstance(cfg, dict):
                continue
            models = cfg.get("models") or {}
            if not isinstance(models, dict):
                continue
            for model, val in models.items():
                if not isinstance(val, dict):
                    continue
                if val.get("intentional_cap_zero") == "corpse":
                    keys.add(f"{prov}/{model}")
        return frozenset(keys)
    return frozenset()


_INTENTIONAL_CORPSE_KEYS = _intentional_corpse_keys()


def _is_excluded_seat(p: Path, d: dict) -> bool:
    """True for pseudo-fixture seats that must NOT appear in the real census.

    Three kinds of non-census seats live alongside real ledgers in the seats
    dir:

    - .spawn-bench markers (fleet-ops#1512): clobber-proof wrapper bench
      files named like ``foo__bar.model.spawn-bench.json``. They carry only
      ``usable_at`` + provenance and are consulted inline by seat_usable
      in seat-lib.sh; they are NOT independent seats and must not inflate
      the census or the comeback-overdue count.

    - test__test / test__test-model fixtures: synthetic provider == "test"
      entries used by seat-lib.test.sh. They are never real routable seats.

    - cap=0 intentional_cap_zero=corpse rows (fleet-ops#3983): a model
      retired at cap 0 with intentional_cap_zero=corpse in seat-caps.json
      is never picked, so a dead-seat ledger on it is not an actionable
      fault. The metric exporter already excludes these from
      fleet_pi_seat_dead_credential_total; the gather must do the same so
      the duty officer does not re-file issues about the same retired
      corpse every tick. A cap>0 seat with a stale corpse ledger is NOT
      excluded — that is a real inconsistency the duty officer should see.
    """
    if ".spawn-bench" in p.name:
        return True
    if d.get("provider") == "test":
        return True
    if _INTENTIONAL_CORPSE_KEYS:
        prov = d.get("provider", "") or ""
        model = d.get("model", "") or ""
        if f"{prov}/{model}" in _INTENTIONAL_CORPSE_KEYS:
            return True
    return False


# fleet-ops#2407: release-at-usable_at classes — the router (seat_usable in
# lib/seat-lib.sh) FAIL-OPENS the seat once its wall clock (bench_until ??
# usable_at) has passed for these classes. quota_exhausted / credentials_bad
# / corpse are held unconditionally until a healthy observation (billing or
# credential repair), so they are never release-at-expiry. Keep in lock-step
# with seat_usable's branches and libexec/fleet-metrics-export.py.
_RELEASE_AT_EXPIRY_CLASSES = frozenset(
    {"overload_bench", "quota_bench", "hang_bench", "transient_fault", "rate_limited"}
)

# fleet-ops#3737/#3795: freshness window for an expired spawn-bench marker
# that still gates the seat. Matches EMPTY_RUN_COUNT_WINDOW_S /
# SEAT_PARK_WALL_S in lib/seat-lib.sh and SPAWN_BENCH_FRESH_S in
# libexec/fleet-metrics-export.py (24 h). Older than this the marker is
# archaeology and fail-open.
_SPAWN_BENCH_FRESH_S = 86400


def _wall_clock(d):
    """ISO wall clock for one seat ledger: bench_until ?? usable_at."""
    return d.get("bench_until") or d.get("usable_at")


def _seat_is_released(d, now):
    """True when now >= usable_at for a release-at-expiry class.

    fleet-ops#2407: a walled seat is RELEASED the moment its wall clock passes
    — the router fail-opens it then, so the census must stop counting it as
    walled until the next observation happens to reclassify it (a healthy
    write, or a fresh failure re-anchoring the clock). quota_exhausted and
    seat_dead corpses never release here: they stay walled for the loud
    comeback-overdue clock instead.
    """
    if d.get("seat_dead") is True:
        return False
    if (d.get("health_class") or "unknown") not in _RELEASE_AT_EXPIRY_CLASSES:
        return False
    end = _parse_ts(_wall_clock(d))
    if end is None:
        return False
    return end < now


def _held_bench_overlay(p, now):
    """Return a census overlay for a seat with a HELD spawn-bench marker, else None.

    fleet-ops#3509: the empty-run bencher (mark_seat_empty_run /
    mark_seat_spawn_fail in lib/seat-lib.sh) writes a clobber-proof
    .spawn-bench.json marker (fleet-ops#1512) NEXT TO the per-seat health
    ledger. The pi seat-health extension re-writes the LEDGER back to
    health_class=healthy on a later 200 OK, so a bench-held seat that has
    since answered one simple packet shows healthy/walled=false in the
    census while the router still refuses to route agentic work to it — it
    keeps getting re-seated and burning empty runs (live: ollama/\
    deepseek-v4-flash:0731 benched with escalating backoff while the census
    said healthy/walled=false). A HELD wrapper bench is operator/wrapper-
    authored and is more authoritative than a later healthy observation
    (fleet-ops#2493 in libexec/fleet-metrics-export.py). When the marker's
    usable_at is still in the future the seat is WALLED until then
    regardless of the ledger; when it has passed the bench is over, the
    seat fail-opens (matches seat_usable and _spawn_bench_active), and no
    overlay applies.

    fleet-ops#3795: seat_usable holds the bench in TWO cases —
      (a) usable_at strictly in the future (the active bench), or
      (b) usable_at expired/absent BUT the marker is FRESH (written within
          _SPAWN_BENCH_FRESH_S, 24h — matches EMPTY_RUN_COUNT_WINDOW_S /
          SEAT_PARK_WALL_S in lib/seat-lib.sh and SPAWN_BENCH_FRESH_S in
          libexec/fleet-metrics-export.py) and still the seat's latest
          evidence: no sibling-ledger observed_at newer than written_at.
          A later ledger observation is post-bench evidence — a run that
          produced output writes healthy with no following marker — so
          case (b) releases on it; otherwise the comeback organ probes
          the seat before re-admission and the census must agree the seat
          is not healthy while it is probe-gated. Without case (b) a
          clobbered-healthy ledger reports an unprobed dead-weight seat
          as available (the ollama/deepseek-v4-flash:0731 empty-run churn
          this issue names: 25 no-ops in 2h while the census said healthy).
    """
    if not p.name.endswith(".json"):
        return None
    marker = p.with_name(p.stem + ".spawn-bench.json")
    if not marker.is_file():
        return None
    try:
        b = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(b, dict):
        return None
    end = _parse_ts(b.get("usable_at"))
    if end is not None and end > now:
        # Case (a): active bench — overlay applies.
        pass
    else:
        # Case (b): expired or clockless bench — held only while the
        # marker is fresh and remains the seat's latest evidence.
        written = _parse_ts(b.get("written_at"))
        if written is None or now - written > _SPAWN_BENCH_FRESH_S:
            return None  # stale marker -> fail-open
        try:
            led = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            led = None
        obs = _parse_ts(led.get("observed_at")) if isinstance(led, dict) else None
        if obs is not None and obs > written:
            return None  # newer ledger obs -> post-bench evidence, release
    overlay = {
        # Effective class: the wrapper bench is the real wall, and a
        # non-healthy class makes the census count it walled (fleet-ops#2493).
        "health_class": "spawn_bench",
        "usable_at": b.get("usable_at"),
        "consecutive_failure_count": b.get("consecutive_failure_count"),
        "failure_mode": b.get("failure_mode"),
        "bench_overlay": True,
        "bench_reason": b.get("reason"),
        "bench_backoff_s": b.get("backoff_s"),
        "bench_written_at": b.get("written_at"),
    }
    return {k: v for k, v in overlay.items() if v is not None}


def seat_table():
    rows = []
    excluded_n = 0
    if not SEATS.is_dir():
        return {"present": False, "seats": [], "excluded_n": 0}
    now = now_epoch()
    for p in sorted(SEATS.glob("*.json")):
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            rows.append({"file": p.name, "error": "unreadable"})
            continue
        if _is_excluded_seat(p, d):
            excluded_n += 1
            continue
        bench = _held_bench_overlay(p, now)
        if bench:
            # fleet-ops#3509: a HELD wrapper spawn-bench is authoritative
            # over a later healthy LEDGER write — overlay the marker's wall
            # clock + durable count so a bench-held seat shows walled in the
            # census until the bench expires, instead of healthy with no wall
            # (which silently lets it keep being re-seated and burning runs).
            _ledger_hc = d.get("health_class") or "unknown"
            d = {**d, **bench}
            d.setdefault("ledger_health_class", _ledger_hc)
        klass = d.get("health_class") or "unknown"
        wall_end = _wall_clock(d)
        released = klass != "healthy" and _seat_is_released(d, now)
        # fleet-ops#2435: a corpse (seat_dead=true, terminal "corpse" class,
        # no comeback clock by construction #2415) is DEAD capacity, not
        # WALLED capacity. Walled means "held by a wall clock that will
        # fail open at expiry" — a corpse never releases and is only
        # re-entered by manual repair (#2327), so counting it walled
        # depresses the walled/healthy census with capacity that is not
        # coming back (live: opencode/muse-spark-1.2-contributor-free at
        # c=150 straight 500s sat in seats_walled forever).
        dead = d.get("seat_dead") is True
        rows.append(
            {
                "id": p.stem,
                "provider": d.get("provider"),
                "model": d.get("model"),
                "health_class": klass,
                "ledger_health_class": d.get("ledger_health_class"),
                "bench_overlay": d.get("bench_overlay"),
                "bench_reason": d.get("bench_reason"),
                "bench_backoff_s": d.get("bench_backoff_s"),
                "bench_written_at": d.get("bench_written_at"),
                # fleet-ops#2407: walled only while the wall is HELD (future
                # clock or no clock / non-releasable class). A released seat
                # (expired clock on a release-at-expiry class) is available
                # capacity — the router admits it — not a walled seat. A
                # corpse (#2435) is neither walled nor released — dead.
                "walled": klass != "healthy" and not released and not dead,
                "released": released,
                "dead": dead,
                "wall_class": None if klass == "healthy" else klass,
                "usable_at": d.get("usable_at"),
                "bench_until": d.get("bench_until"),
