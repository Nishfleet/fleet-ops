def t_seat_probes_walled_comebacks():
    """Per-walled-seat comeback clock (usable_at/retry_after overdue?).

    fleet-ops#2152: two arithmetic and census bugs fixed here:
      1. retry_after is a *duration in seconds* (delta from observed_at),
         not an epoch timestamp. Treating it as an epoch made 1857600 land
         on 1970-01-22, so retry_after_overdue was always True. The correct
         deadline is observed_at_epoch + retry_after_seconds; the seat is
         comeback-overdue only once that deadline has passed AND there is
         no usable_at carrying a later reset.
      2. .spawn-bench markers and test__ fixtures are excluded — they are
         bench markers / synthetic entries, not real routable seats.
    """
    if not SEATS.is_dir():
        return {"present": False, "walled": [], "excluded_n": 0}
    now = now_epoch()
    walled = []
    excluded_n = 0
    for p in sorted(SEATS.glob("*.json")):
        try:
            d = json.loads(p.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if _is_excluded_seat(p, d):
            excluded_n += 1
            continue
        # fleet-ops#2435: a corpse (seat_dead=true) is terminal — retired,
        # not walled. It carries no comeback clock by construction (#2415),
        # so it has no place in the per-walled-seat comeback probe at all;
        # dead_n in the census is its record. Mirrors _read_comeback_overdue
        # in libexec/fleet-metrics-export.py.
        if d.get("seat_dead") is True:
            continue
        klass = d.get("health_class") or "unknown"
        if klass == "healthy":
            continue
        usable = d.get("usable_at")
        retry_after = d.get("retry_after")
        observed = d.get("observed_at")
        row = {
            "id": p.stem,
            "wall_class": klass,
            "usable_at": usable,
            "retry_after": retry_after,
            "observed_at": observed,
            "http_status": d.get("http_status"),
            "failure_mode": d.get("failure_mode"),
        }
        # usable_at is an absolute ISO timestamp → parse to epoch directly.
        usable_epoch = _parse_ts(usable)
        if usable_epoch is not None:
            row["usable_at_epoch"] = int(usable_epoch)
            # fleet-ops#2806: grace of one probe interval. A wall passed within
            # the grace window is mid-cycle — the release organ re-probes it
            # on the next 15-min tick (re-anchor on failure, unwall on
            # success), so it is NOT overdue yet. Overdue means the wall is
            # past by more than one probe interval: the releaser had a full
            # cycle to act and did not.
            row["usable_at_overdue"] = usable_epoch < (now - COMEBACK_GRACE_S)
        # retry_after is a *duration in seconds* from observed_at, NOT an
        # epoch. Compute the absolute deadline as observed_at + retry_after
        # and flag overdue only when that deadline has passed.
        if retry_after is not None and observed is not None:
            obs_epoch = _parse_ts(observed)
            if obs_epoch is not None and retry_after > 0:
                deadline = obs_epoch + retry_after
                row["retry_after_epoch"] = int(deadline)
                row["retry_after_overdue"] = deadline < now
        walled.append(row)
    # A seat is comeback-overdue when its usable_at has passed (the
    # advertised reset window elapsed) OR its retry_after deadline has
    # elapsed — but only the corrected computation above feeds this count.
    overdue = sum(
        1 for r in walled
        if r.get("usable_at_overdue") or r.get("retry_after_overdue")
    )
    return {
        "present": True,
        "walled_n": len(walled),
        "comeback_overdue_n": overdue,
        "excluded_n": excluded_n,
        "walled": walled,
    }


def t_doc_claims_sample():
    """Sample path claims from a house doc and verify they exist on disk."""
    doc = Path("/home/nish/AGENTS.md")
    if not doc.is_file():
        return {"present": False, "doc": str(doc)}
    try:
        text = doc.read_text(encoding="utf-8", errors="replace")
    except OSError as ex:
        return {"present": False, "error": str(ex)}
    claims = re.findall(r"`?(~/[^` \n]+|/home/nish/[^` \n]+)`?", text)
    # de-dup, keep order, sample up to 8
    seen = set()
    uniq = []
    for c in claims:
        c = c.rstrip(".,;:)`")
        expanded = c.replace("~", "/home/nish", 1) if c.startswith("~") else c
        if expanded in seen:
            continue
        seen.add(expanded)
        uniq.append(expanded)
        if len(uniq) >= 8:
            break
    sample = []
    for path in uniq:
        sample.append({"path": path, "exists": Path(path).exists()})
    missing = [s["path"] for s in sample if not s["exists"]]
    return {"present": True, "doc": str(doc), "sampled": sample, "missing_n": len(missing)}


def t_backup_freshness():
    """Restore-drill timer last result + backup-state file freshness."""
    rc, out, err = run(
        ["systemctl", "--user", "show", "fleet-restore-drill.timer",
         "-p", "LastTriggerUSec", "-p", "Result", "-p", "ActiveState", "--no-pager"]
    )
    fields = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k] = v
    last_us = fields.get("LastTriggerUSec")
    last_epoch = _systemd_timestamp_to_epoch(last_us)
    age = None if last_epoch is None else max(0, now_epoch() - last_epoch)
    # newest file under alert-repair that looks like a restore/backup marker
    newest = None
    if ALERT_REPAIR.is_dir():
        best = 0
        for name in ("fleet-restore-drill", "backup"):
            for p in ALERT_REPAIR.glob(f"{name}*"):
                try:
                    m = p.stat().st_mtime
                except OSError:
                    continue
                if m > best:
                    best = m
                    newest = {"path": str(p), "mtime_epoch": int(best),
                              "age_s": max(0, now_epoch() - int(best))}
    return {
        "timer_present": bool(fields),
        "timer_last_epoch": last_epoch,
        "timer_age_s": age,
        "timer_result": fields.get("Result"),
        "timer_active_state": fields.get("ActiveState"),
        "newest_backup_marker": newest,
    }


# fleet-ops#4118: surface the worktree reaper's last-run result so the
# heartbeat can gauge whether the drain is working. Returns a compact
# object: present + ts + the count fields that say what the reaper did
# (reaped, skipped_dirty, skipped_notpushed, skipped_young, skipped_live,
# post_count, bound_breached) + the oldest worktrees still on disk
# (sorted by age_s desc, top N) so the judge can see per-worktree
# age/owner without grepping the full TSV. Degrades to present:false when
# the summary is missing/unparseable/stale (a missing reaper result is
# data, not a crash — same defensive contract as every other slot).
REAPER_STALE_S = 7 * 86400  # a reaper summary older than 7d is stale
REAPER_OLDEST_N = 10        # top-N oldest worktrees in the snapshot


def worktree_reaper_result():
    p = WORKTREE_REAPER_SUMMARY
    if not p.is_file():
        return {"present": False, "reason": "summary-missing"}
    try:
        doc = json.loads(p.read_text(encoding="utf-8", errors="replace"))
    except (OSError, ValueError):
        return {"present": False, "reason": "summary-unparseable"}
    ts = doc.get("ts")
    age_s = None
    if isinstance(ts, str):
        try:
            age_s = now_epoch() - int(datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp())
        except ValueError:
            age_s = None
    if age_s is not None and age_s > REAPER_STALE_S:
        return {"present": False, "reason": "summary-stale", "ts": ts, "age_s": age_s}
    # Oldest worktrees still on disk: the reaper's `worktrees` array
    # carries every scanned dir with its age_s. Sort desc, take top N.
    wts = doc.get("worktrees") or []
    oldest = []
    if isinstance(wts, list):
        sortable = [w for w in wts if isinstance(w, dict) and isinstance(w.get("age_s"), (int, float))]
        sortable.sort(key=lambda w: w.get("age_s", 0), reverse=True)
        oldest = sortable[:REAPER_OLDEST_N]
    return {
        "present": True,
        "ts": ts,
        "age_s": age_s,
        "scanned": doc.get("scanned"),
        "reaped": doc.get("reaped"),
        "post_count": doc.get("post_count"),
        "pre_count": doc.get("pre_count"),
        "bound_breached": doc.get("bound_breached"),
        "skipped_dirty": doc.get("skipped_dirty"),
        "skipped_notpushed": doc.get("skipped_notpushed"),
        "skipped_young": doc.get("skipped_young"),
        "skipped_live": doc.get("skipped_live"),
        "skipped_unmerged": doc.get("skipped_unmerged"),
        "skipped_notterminal": doc.get("skipped_notterminal"),
        "salvaged": doc.get("salvaged"),
        "salvage_candidates": doc.get("salvage_candidates"),
        "failed": doc.get("failed"),
        "report_rows": doc.get("report_rows"),
        "report_capped": doc.get("report_capped"),
        "oldest": oldest,
    }


def t_hygiene_counts():
    """Stale scouts, orphan worktrees, vault sync-conflicts, failed units."""
    # stale scouts: oldest scout age already in snapshot; recompute count of
    # scouts whose last trigger is older than SCOUT_STALE_S (4h cadence +
    # jitter, fleet-ops#3189 — NOT the 2h window; see the constant).
    rc, out, _ = run(["systemctl", "--user", "list-timers", "--all", "--no-pager"])
    stale_scouts = 0
    now = now_epoch()
    scout_rows = []
    for line in out.splitlines():
        if "pi-scout@" not in line:
            continue
        unit = None
        for tok in line.split():
            if tok.startswith("pi-scout@") and tok.endswith(".timer"):
                unit = tok
                break
        if not unit:
            continue
        s_rc, s_out, _ = run(["systemctl", "--user", "show", unit, "-p", "LastTriggerUSec", "--no-pager"])
        last_us = None
        for sl in s_out.splitlines():
            if sl.startswith("LastTriggerUSec="):
                last_us = sl.split("=", 1)[1]
        le = _systemd_timestamp_to_epoch(last_us)
        age = None if le is None else now - le
        if age is not None and age > SCOUT_STALE_S:
            stale_scouts += 1
        scout_rows.append({"timer": unit, "age_s": age})
    # orphan worktrees: agent-worktrees dirs not on origin (best-effort count)
    worktree_root = Path("/home/nish/workspaces/agent-worktrees")
    orphan_wt = 0
    if worktree_root.is_dir():
        for d in worktree_root.iterdir():
            if not d.is_dir():
                continue
            rc2, out2, _ = run(["git", "-C", str(d), "worktree", "list", "--porcelain"], timeout=10)
            # cheap presence check: a git dir counts as a worktree
            if rc2 == 0:
                orphan_wt += 1
    # vault sync-conflicts (vault writes must stop if any exist)
    conflicts = []
    if VAULT.is_dir():
        for p in VAULT.rglob("*.sync-conflict-*"):
            conflicts.append(str(p))
            if len(conflicts) >= 20:
                break
    fu = failed_units()
    return {
        "failed_user": (fu.get("user") or {}).get("count"),
        "failed_system": (fu.get("system") or {}).get("count"),
        "stale_scouts": stale_scouts,
        "scout_timers": scout_rows,
        "worktree_dirs": orphan_wt,
        "worktree_reaper": worktree_reaper_result(),
        "vault_sync_conflicts_n": len(conflicts),
        "vault_sync_conflicts_sample": conflicts[:5],
    }


def t_escalation_drain():
    """NISH-ESCALATIONS.md volume + alert-repair packet churn in 24h."""
    esc_lines = None
    if ESCALATIONS.is_file():
        try:
            esc_lines = sum(1 for _ in ESCALATIONS.open(encoding="utf-8", errors="replace"))
        except OSError:
            esc_lines = None
    cut = now_epoch() - THOROUGH_WINDOW
    packets = []
    if ALERT_REPAIR.is_dir():
        for p in ALERT_REPAIR.glob("packet-*.md"):
            try:
                m = p.stat().st_mtime
            except OSError:
                continue
            if m >= cut:
                packets.append({"file": p.name, "mtime_epoch": int(m)})
