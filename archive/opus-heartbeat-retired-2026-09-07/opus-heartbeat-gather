def t_tailscale_reboot_spot():
    """Tailscale liveness, uptime, last boot, reboot-required, needrestart."""
    rc, out, err = run(["tailscale", "status"], timeout=8)
    ts_ok = rc == 0 and "failed to connect" not in (out + err).lower()
    up_rc, up_out, _ = run(["uptime", "-s"], timeout=5)
    boot = up_out.strip() if up_rc == 0 else None
    boot_epoch = None
    if boot:
        rc2, d_out, _ = run(["date", "-d", boot, "+%s"], timeout=5)
        if rc2 == 0 and d_out.strip().isdigit():
            boot_epoch = int(d_out.strip())
    reboot_required = Path("/var/run/reboot-required").is_file()
    # needrestart presence (best-effort, non-fatal)
    nr_rc, nr_out, _ = run(["needrestart", "-b"], timeout=10)
    needrestart_pending = None
    if nr_rc == 0:
        needrestart_pending = any("NEEDRESTART" in l for l in nr_out.splitlines())
    return {
        "tailscale_ok": ts_ok,
        "tailscale_error": None if ts_ok else (err or out).strip()[:200] or f"rc={rc}",
        "uptime_since": boot,
        "boot_epoch": boot_epoch,
        "uptime_s": None if boot_epoch is None else max(0, now_epoch() - boot_epoch),
        "reboot_required": reboot_required,
        "needrestart_pending": needrestart_pending,
    }


def t_trend_24h():
    """Verdict trend over the trailing 24h from the journal."""
    journal = STATE / "journal.jsonl"
    cut = now_epoch() - THOROUGH_WINDOW
    counts = {"SMOOTH": 0, "FAULTS": 0, "AUTH_WALL": 0, "NO_VERDICT": 0, "other": 0}
    n = 0
    if journal.is_file():
        try:
            with journal.open(encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        d = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    ep = d.get("epoch") or 0
                    if ep < cut:
                        continue
                    n += 1
                    v = d.get("verdict")
                    if v in counts:
                        counts[v] += 1
                    else:
                        counts["other"] += 1
        except OSError:
            pass
    return {"runs_24h": n, "verdicts": counts}


