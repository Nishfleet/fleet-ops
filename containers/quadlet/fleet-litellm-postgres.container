# Fleet LiteLLM Postgres, containerized (fleet-ops#8435, cutover #8494).
# postgres:16 matches the cluster's major version, so the existing data dir
# is reused as-is. The data dir is mounted at its own host path because
# postgresql.conf pins unix_socket_directories to <pgdata>/run by absolute path.

[Unit]
Description=Fleet LiteLLM Postgres (Quadlet, fleet-ops#8435)

[Container]
Image=docker.io/library/postgres:16
Network=host
# The host user maps to the image's postgres uid/gid 999, so the nish-owned
# data dir is owned by postgres inside the container.
UserNS=keep-id:uid=999,gid=999
Volume=%h/.local/share/fleet-litellm-postgres:%h/.local/share/fleet-litellm-postgres
Environment=PGDATA=%h/.local/share/fleet-litellm-postgres
# Password auth for every connection (scram-sha-256: unix socket, 127.0.0.1, ::1).
# The cluster already exists, so the image's POSTGRES_HOST_AUTH_METHOD (initdb time only) would do
# nothing: the pg_hba.conf comes from the repo through hba_file instead. The directory is mounted,
# not the file, so a git checkout that replaces the file is seen by the next reload. The mount
# source is the deploy clone, which fleet-sync keeps on origin/main (it refuses to deploy from any
# other state); a missing clone makes the start fail, loudly.
# Preconditions, all checked on the live host before this was merged (fleet-ops#10032): both login
# roles (litellm, nish; there is no `postgres` role) hold SCRAM-SHA-256 verifiers, ~/.pgpass
# (0600, host `*`, so it matches TCP and the socket directory) has both, and
# ~/.config/fleet-ops/litellm-db.env (0600, hex password, so no URL escaping) holds the proxy URL.
# Clients: the proxy reads DATABASE_URL from that env file; the restic dump (runuser -u nish --
# pg_dump, which sets HOME) reads libpq's default ~/.pgpass. Neither file is in the repo.
# Lockout recovery: delete the Volume= (config/postgres) and Exec= lines below and restart; the
# data dir's own pg_hba.conf (still `trust`) applies again.
# password_encryption is already the PG16 default; it is passed so the intent is explicit.
Volume=%h/workspaces/tooling/fleet-ops-deploy-clone/config/postgres:/etc/fleet-postgres:ro
Exec=postgres -c hba_file=/etc/fleet-postgres/pg_hba.conf -c password_encryption=scram-sha-256

[Service]
Slice=app-litellm-postgres.slice
ManagedOOMPreference=avoid
MemoryMin=256M
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30

[Install]
WantedBy=default.target
