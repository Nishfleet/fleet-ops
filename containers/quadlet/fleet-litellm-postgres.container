# Fleet LiteLLM Postgres, containerized (fleet-ops#8435, cutover #8494).
# postgres:16 matches the cluster's major version, so the existing data dir
# is reused as-is. The data dir is mounted at its own host path because
# postgresql.conf pins unix_socket_directories to <pgdata>/run by absolute path.

[Unit]
Description=Fleet LiteLLM Postgres (Quadlet, fleet-ops#8435)
# A crash loop must reach `failed`, which only the user-manager failed list
# (`systemctl --user list-units --state=failed`) reads: no OnFailure= hook, and
# the node_systemd_unit_state gauge reads system units only. The default 5
# starts in 10 s is never spent at RestartSec=3s (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Container]
# Pinned by digest (the image running when this was pinned); the tag is only a label.
# Bump the digest in its own PR: postgres holds the keys and spend.
Image=docker.io/library/postgres:16@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
Network=host
# The host user maps to the image's postgres uid/gid 999, so the nish-owned
# data dir is owned by postgres inside the container.
UserNS=keep-id:uid=999,gid=999
Volume=%h/.local/share/fleet-litellm-postgres:%h/.local/share/fleet-litellm-postgres
Environment=PGDATA=%h/.local/share/fleet-litellm-postgres
# Password auth for every connection (scram-sha-256: unix socket, 127.0.0.1, ::1).
# The cluster already exists, so the image's POSTGRES_HOST_AUTH_METHOD (initdb time only) does
# nothing: pg_hba.conf comes from the repo through hba_file. The directory is mounted, not the
# file. The source is the deploy clone, which fleet-sync refuses to deploy from unless it is on
# origin/main; a missing clone makes the start fail, loudly.
# Preconditions, checked on the live host before this merged (fleet-ops#10064): both login roles
# (litellm, nish; there is no `postgres` role) hold SCRAM-SHA-256 verifiers in pg_authid,
# ~/.pgpass (0600, host `*`) has both, and ~/.config/fleet-ops/litellm-db.env (0600, hex password,
# so no URL escaping) has the proxy URL. pg_stat_activity shows only two clients: the proxy
# (DATABASE_URL from that env file) and the restic dump (runuser -u nish -- pg_dump reads libpq's
# default ~/.pgpass).
# Lockout recovery: delete the Volume= (config/postgres) and Exec= lines and restart; the data
# dir's own pg_hba.conf (still `trust`) applies again.
Volume=%h/workspaces/tooling/fleet-ops-deploy-clone/config/postgres:/etc/fleet-postgres:ro
Exec=postgres -c hba_file=/etc/fleet-postgres/pg_hba.conf

[Service]
Slice=app-litellm-postgres.slice
ManagedOOMPreference=avoid
MemoryMin=256M
# Matches app-litellm-postgres.slice. Podman 4.9.3 has no Memory= key for [Container], so the
# cap is the unit's cgroup limit. Measured: the unit's cgroup peaked at 1.0G (page cache included,
# reclaimable) while the processes held about 20 MB, so no tighter cap is safe.
MemoryMax=1G
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30

[Install]
WantedBy=default.target
