# Fleet LiteLLM proxy, containerized (fleet-ops#8435). Additive twin of
# systemd/fleet-litellm-proxy.service + its drop-ins; the live unit stays
# until Nish runs the cutover.

[Unit]
Description=Fleet LiteLLM proxy (Quadlet, fleet-ops#8435)
Requires=fleet-litellm-postgres.service fleet-litellm-redis.service
After=fleet-litellm-postgres.service fleet-litellm-redis.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Container]
Image=ghcr.io/berriai/litellm:main-stable
Network=host
Volume=%h/.config/fleet-ops/litellm-proxy.yaml:/app/config.yaml:ro,Z
Environment=DATABASE_URL=postgresql://litellm@localhost:5432/litellm
# Quadlet's own EnvironmentFile= cannot glob, so the unit's [Service]
# EnvironmentFile= lines feed the host env and this flag passes it in.
EnvironmentHost=true
Exec=--config /app/config.yaml --port 4000 --host 127.0.0.1

[Service]
# Same four operator-owned env files as systemd/fleet-litellm-proxy.service.
EnvironmentFile=-%h/.config/fleet-ops/seats/*.env
EnvironmentFile=-%h/.config/xkiro/.env
EnvironmentFile=-%h/.config/straitly/straitly.env
EnvironmentFile=/home/nish/.config/fleet-ops/litellm-master-key.env
Slice=app-litellm.slice
MemoryMax=2G
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15

[Install]
WantedBy=default.target
