# Fleet LiteLLM proxy, containerized (fleet-ops#8435, cutover #8494).
# The image is pinned by tag and digest (1.105.0). Bump the tag in its own PR, and take a pg_dump -Fc of the router database first: the
# schema change between releases is not additive, so the dump is the rollback.

[Unit]
Description=Fleet LiteLLM proxy (Quadlet, fleet-ops#8435)
Requires=fleet-litellm-postgres.service fleet-litellm-redis.service
After=fleet-litellm-postgres.service fleet-litellm-redis.service
# Keep restarting for a few minutes, then enter failed and page
# (OnFailure=, fleet-ops#9033). Measured 2026-10-01: podman exit 125
# dies in ~2s; a healthy start reaches uvicorn in ~38s and readiness
# in ~75s (an Ollama model-info wait, fixed by OLLAMA_API_BASE below, once stretched it to about
# 5 min). Burst 20 × (RestartSec 10s + 75s) = 1700s, so the window
# must be 1h or the burst never fills and OnFailure never fires.
StartLimitIntervalSec=1h
StartLimitBurst=20
OnFailure=fleet-unit-failed@%N.service

[Container]
Image=ghcr.io/berriai/litellm:v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2
# general_settings.disable_prisma_schema_update stays true (an automatic migrate on every start
# stalled restarts), and with it true the proxy starts WITHOUT migrating: it only logs "prisma
# schema out of sync". A release bump therefore runs the image's own migration job once, by hand,
# with the proxy stopped, after the pg_dump -Fc (docs/RUNBOOK.md, LiteLLM stack). It is
# deliberately not an ExecStartPre=: that would repeat on every crash restart and config-save
# restart, and would name the image a second time.
# LiteLLM asks the default Ollama address (localhost:11434) for model info while it builds the
# router for each ollama_chat row, and on this host that connect hangs: startup measured about
# 5 min on both v1.98.0 and v1.105.0, and about 30 s with OLLAMA_API_BASE set (the stock variable
# for that default). Every ollama_chat row in config/litellm-proxy.yaml sets its own api_base
# (https://ollama.com), so no request changes.
Environment=OLLAMA_API_BASE=https://ollama.com
Network=host
Volume=%h/.config/fleet-ops/litellm-proxy.yaml:/app/config.yaml:ro
# DATABASE_URL carries the database password, so it comes from a 0600 file, not this
# repo (the database requires scram-sha-256). general_settings.database_url in
# config/litellm-proxy.yaml is os.environ/DATABASE_URL (fleet-ops#10020), so this variable is the
# one the proxy uses. The env file has no `-` prefix on purpose: if it is missing the proxy does
# not start (loud, OnFailure=) rather than start with a URL the database refuses. The password
# is hex, so the URL needs no escaping. LITELLM_LOG=INFO does not print the URL.
PodmanArgs=--env=DATABASE_URL
# INFO, not DEBUG: DEBUG dumps full prompts into the journal (fleet-ops#4449).
Environment=LITELLM_LOG=INFO
# Podman's default stop timeout is 10 s, so `podman rm -f` SIGKILLed the
# proxy at 10 s whatever TimeoutStopSec says: exit 137, unit failed, and
# OnFailure= sent a false fail ping on every restart (10-02 11:16:41 journal:
# "StopSignal SIGTERM failed to stop container ... in 10 seconds"). 110 s stays
# under TimeoutStopSec=120 so in-flight requests drain (fleet-ops#4449).
PodmanArgs=--stop-timeout=110
# Bytecode cache that outlives the --rm container. Each start re-compiled
# litellm+prisma into a throwaway layer; measured 2026-10-02 on the pinned
# image, `import litellm.proxy.proxy_server` 24.6/26.0 s cold vs 20.4/18.2 s
# warm, paid by the parent and each worker. Python revalidates every .pyc
# against its source mtime, so an image bump just recompiles.
Volume=fleet-litellm-pycache:/pycache
Environment=PYTHONPYCACHEPREFIX=/pycache
# Named pass-through, not --env-host (fleet-ops#9020): --env-host copied the whole
# systemd --user manager environment into the container. Podman 4.9.3 (Ubuntu 24.04)
# drops a bare `Environment=NAME` line, so each name is its own PodmanArgs=--env=NAME:
# podman reads that one variable from its own environment, which the [Service]
# EnvironmentFile= lines below fill. One line per os.environ/NAME in litellm-proxy.yaml.
# Alibaba Model Studio Token Plan (fleet-ops#9220, judge row only): os.environ/ALIBABA_CODING_API_KEY in
# config/litellm-proxy.yaml needs its own line, and the seat file ~/.config/fleet-ops/seats/alibaba-coding.env
# is already covered by the seats/*.env EnvironmentFile below.
PodmanArgs=--env=ALIBABA_CODING_API_KEY
# Anthropic Claude API (the tether group's Sonnet 5.5 row, Nish 2026-10-22): the prepaid key sits in a
# seat file that the seat EnvironmentFile lines below already cover.
PodmanArgs=--env=ANTHROPIC_API_KEY
PodmanArgs=--env=CLINE_API_KEY
PodmanArgs=--env=COMMANDCODE_API_KEY
PodmanArgs=--env=LITELLM_MASTER_KEY
PodmanArgs=--env=MINIMAX_API_KEY
PodmanArgs=--env=OLLAMA_API_KEY
PodmanArgs=--env=OPENCODE_API_KEY
PodmanArgs=--env=OPENCODE_API_KEY_2
PodmanArgs=--env=PARETO_API_KEY
# Redis cache password (router_settings.redis_password): filled from litellm-keys/redis.env below.
PodmanArgs=--env=REDIS_PASSWORD
PodmanArgs=--env=STEPFUN_API_KEY
PodmanArgs=--env=STRAITLY_API_KEY
PodmanArgs=--env=SYNTHETIC_API_KEY
PodmanArgs=--env=VERCEL_AI_GATEWAY_JEV_KEY
PodmanArgs=--env=ZAI_API_KEY
# --num_workers 2 (fleet-ops#8827). The default is 1, so /health/readiness,
# /metrics and the /jev pass-through all ran on the ONE event loop that also
# served every chat completion: 2026-09-28 ~15:20-15:35 IST, with eight
# audit-0509 units plus normal workers running, readiness accepted the
# connection and returned zero bytes even at -m 30 while the journal still
# showed completions 200ing. A light endpoint cannot be served while a
# long completion holds that loop, so the pool measured here is 2: a
# cooldowned/streaming completion then occupies one worker and the health
# and /jev endpoints answer from the other. The nginx-style headers are
# dropped on purpose: keepalive needs no tune at 1s agent requests.
#
# Both are the stock vendor flags of the pinned image (proxy_cli.py:
# --num_workers -> uvicorn.run(workers=...), and the same file starts
# prometheus multiproc-dir setup + the query-engine reaper at
# num_workers > 1, so the gauges stay correct and a force-killed worker's
# Prisma engine is reaped). Cooldowns stay fleet-wide because the router's
# CooldownCache is a DualCache over Redis (litellm/router_utils/
# cooldown_cache.py), not per-process state.
#
# 2 is measured, not chosen: 4 on this 2-core CPUQuota=200% slice buys no
# more throughput, and MemoryCurrent for --num_workers 2 is ~2.0G (786M at
# 1, 2022M at 2: every worker opens its own Prisma connection pool), so the
# slice cap was raised to clear it. 8 audit units on one host share that
# pool, so the ceiling is what keeps 8. max_parallel_requests is a
# per-process in-memory semaphore (litellm/router.py _get_client
# local_only=True), so the second worker admits a second copy of the sum;
# over-admission lands on the 429 cooldown the rows already carry rather
# than on a hung endpoint.
Exec=--config /app/config.yaml --port 4000 --host 127.0.0.1 --num_workers 2

[Service]
EnvironmentFile=-%h/.config/fleet-ops/seats/*.env
EnvironmentFile=-%h/.config/straitly/straitly.env
EnvironmentFile=%h/.config/fleet-ops/litellm-master-key.env
EnvironmentFile=%h/.config/fleet-ops/litellm-db.env
# No `-` prefix on purpose: without this file the proxy fails to start (loud, via OnFailure=)
# instead of running with a cache it cannot authenticate to. ansible/host.yml renders it.
EnvironmentFile=%h/.config/fleet-ops/litellm-keys/redis.env
Slice=app-litellm.slice
ManagedOOMPreference=avoid
Restart=on-failure
RestartSec=10s
# Let in-flight requests drain instead of being SIGKILLed at 15s (fleet-ops#4449).
TimeoutStopSec=120

[Install]
WantedBy=default.target
