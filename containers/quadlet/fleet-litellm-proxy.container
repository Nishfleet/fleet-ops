# Fleet LiteLLM proxy, containerized (fleet-ops#8435, cutover #8494).
# The image is pinned by tag and digest (v1.105.0, cosign-verified outside CI). A bump edits the
# Image= line only. The deploy then runs this image's own migration job and restarts the proxy, in
# that order (ansible/host.yml handlers, notified when this file changes): the upgrade guide's
# "run migrations before rollout", which Helm does with a pre-upgrade hook
# (https://docs.litellm.ai/docs/proxy/upgrade_guide). A plain restart (crash, config change,
# reboot) does not migrate, so it does not keep the router down for the job's 25-150 s
# (fleet-ops#11739).

[Unit]
Description=Fleet LiteLLM proxy (Quadlet, fleet-ops#8435)
Requires=fleet-litellm-postgres.service fleet-litellm-redis.service
After=fleet-litellm-postgres.service fleet-litellm-redis.service
# Keep restarting for a few minutes, then enter failed and page
# (OnFailure=, fleet-ops#9033). Measured 2026-10-01: podman exit 125
# dies in ~2s; a healthy start reaches uvicorn in ~38s and readiness
# in ~75s. Measured 2026-10-23 on v1.105.0: about 30 s to readiness.
# Burst 20 × (RestartSec 10s + about 2 min) = 2600s, so the window must be 1h or the burst never
# fills and OnFailure never fires.
StartLimitIntervalSec=1h
StartLimitBurst=20

[Container]
Image=ghcr.io/berriai/litellm:v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2
# general_settings.disable_prisma_schema_update stays true: the proxy itself never migrates, it only
# logs "prisma schema out of sync". The migration is the deploy's handler (see the header).
Network=host
Volume=%h/.config/fleet-ops/litellm-proxy.yaml:/app/config.yaml:ro
# DATABASE_URL carries the database password, so it comes from a 0600 file, not this
# repo (the database requires scram-sha-256). general_settings.database_url in
# config/litellm-proxy.yaml is os.environ/DATABASE_URL (fleet-ops#10020), so this variable is the
# one the proxy uses. The env file has no `-` prefix on purpose: if it is missing the proxy does
# not start (loud, OnFailure=) rather than start with a URL the database refuses. The password
# is hex, so the URL needs no escaping. LITELLM_LOG=INFO does not print the URL.
PodmanArgs=--env=DATABASE_URL
# INFO, not DEBUG: DEBUG dumps full prompts into the journal (fleet-ops#4449).
Environment=LITELLM_LOG=INFO
# A restart's stop waits for in-flight calls: uvicorn stops accepting, waits for open requests to
# finish ("Waiting for connections to close"), then exits; podman SIGKILLs at this timeout
# (https://docs.podman.io/en/v4.9.3/markdown/podman-run.1.html#stop-timeout-seconds; podman 4.9
# Quadlet has no StopTimeout= key). At 45 s the 2026-11-04 12:59 UTC deploy SIGKILLed a streamed
# call that was still running and the agent run failed (fleet-ops#11739). 300 s covers the p99.9
# call: 99,912 calls in the 7 days to 2026-11-04 took p50 4.8 s, p99 131 s, p99.9 298 s, max 604 s
# (LiteLLM_SpendLogs endTime-startTime). A stop with nothing in flight still ends at once: the five
# stops of 2026-11-01..04 with no call open took 5-19 s. The value is fixed when the container is
# created, so it bounds the next container's stop, not the running one's.
# tests/test_litellm_proxy_stop_window.py keeps it below TimeoutStopSec.
PodmanArgs=--stop-timeout=300
# Bytecode cache that outlives the --rm container. Each start re-compiled
# litellm+prisma into a throwaway layer; measured 2026-10-02 on the pinned
# image, `import litellm.proxy.proxy_server` 24.6/26.0 s cold vs 20.4/18.2 s
# warm, paid by the parent and each worker. Python revalidates every .pyc
# against its source mtime, so an image bump just recompiles.
Volume=fleet-litellm-pycache:/pycache
Environment=PYTHONPYCACHEPREFIX=/pycache
# uvicorn (>=0.37 on the pinned image, bundled 0.53.0) pings a spawned worker
# over a pipe and SIGKILLs it if the ping is not answered within
# timeout_worker_healthcheck, default 5 s. A litellm worker answers only after
# multiprocessing spawn re-runs the console script, which imports all of
# litellm — measured 8.1-23.8 s warm on this host, 24.6-26.0 s cold in the
# container (2026-10-02, the import note above implies warm 18-21 s) — so the
# default kills every worker at the 5.0-5.5 s cadence seen in the 2026-10-31
# boots (fleet-ops#11372: 1 to 252 deaths per boot, outage 4-5 min).
# 120 s = >=4x the slowest measured import, so a normal spawn always answers;
# with num_workers=2 the surviving worker keeps serving while a hung one is
# reaped at the 120 s bound. It reaches the uvicorn Config only from the next
# container creation; litellm proxy_cli passes timeout_worker_healthcheck to
# uvicorn.Config when the parameter exists (uvicorn>=0.37), and
# uvicorn supervisors/multiprocess.py uses it for the worker pings.
# The litellm CLI option --timeout_worker_healthcheck (same name as the env
# var TIMEOUT_WORKER_HEALTHCHECK) applies only under num_workers > 1.
Environment=TIMEOUT_WORKER_HEALTHCHECK=120
# Named pass-through, not --env-host (fleet-ops#9020): --env-host copied the whole
# systemd --user manager environment into the container. Podman 4.9.3 (Ubuntu 24.04)
# drops a bare `Environment=NAME` line, so each name is its own PodmanArgs=--env=NAME:
# podman reads that one variable from its own environment, which the [Service]
# EnvironmentFile= lines below fill. One line per os.environ/NAME in litellm-proxy.yaml.
# Alibaba Model Studio Token Plan (fleet-ops#9220, judge row only): os.environ/ALIBABA_CODING_API_KEY in
# config/litellm-proxy.yaml needs its own line, and the seat file ~/.config/fleet-ops/seats/alibaba-coding.env
# is already covered by the seat EnvironmentFile lines below.
PodmanArgs=--env=ALIBABA_CODING_API_KEY
# Anthropic Claude API (the tether group's Sonnet 5.5 row, Nish 2026-10-22): the prepaid key sits in a
# seat file that the seat EnvironmentFile lines below already cover.
PodmanArgs=--env=ANTHROPIC_API_KEY
PodmanArgs=--env=COMMANDCODE_API_KEY
PodmanArgs=--env=LITELLM_MASTER_KEY
PodmanArgs=--env=MINIMAX_API_KEY
PodmanArgs=--env=OPENCODE_API_KEY
# Redis cache password (router_settings.redis_password): filled from litellm-keys/redis.env below.
PodmanArgs=--env=REDIS_PASSWORD
PodmanArgs=--env=VERCEL_AI_GATEWAY_JEV_KEY
PodmanArgs=--env=ZAI_API_KEY
# --num_workers 2 (fleet-ops#8827). The default is 1, so /health/readiness,
# /metrics and the /jev pass-through all ran on the ONE event loop that also
# served every chat completion: 2026-09-28 ~15:20-15:35 IST, with eight
# audit-0509 units plus normal workers running, readiness accepted the
# connection and returned zero bytes even at -m 30 while the journal still
# showed completions 200ing. A light endpoint cannot be served while a
# long completion holds that loop, so the pool measured here is 2: a
# cooldowned/streaming completion then occupies one worker and the health
# and /jev endpoints answer from the other. The nginx-style headers are
# dropped on purpose: keepalive needs no tune at 1s agent requests.
#
# Both are the stock vendor flags of the pinned image (proxy_cli.py:
# --num_workers -> uvicorn.run(workers=...), and the same file starts
# prometheus multiproc-dir setup + the query-engine reaper at
# num_workers > 1, so the gauges stay correct and a force-killed worker's
# Prisma engine is reaped). Cooldowns stay fleet-wide because the router's
# CooldownCache is a DualCache over Redis (litellm/router_utils/
# cooldown_cache.py), not per-process state.
#
# 2 is measured, not chosen: 4 on this 2-core CPUQuota=200% slice buys no
# more throughput, and MemoryCurrent for --num_workers 2 is ~2.0G (786M at
# 1, 2022M at 2: every worker opens its own Prisma connection pool), so the
# slice cap was raised to clear it. 8 audit units on one host share that
# pool, so the ceiling is what keeps 8. max_parallel_requests is a
# per-process in-memory semaphore (litellm/router.py _get_client
# local_only=True), so the second worker admits a second copy of the sum;
# over-admission lands on the 429 cooldown the rows already carry rather
# than on a hung endpoint.
Exec=--config /app/config.yaml --port 4000 --host 127.0.0.1 --num_workers 2

[Service]
# One line per seat file whose key the PodmanArgs=--env=NAME lines above pass on (a test checks
# the config's os.environ/NAME vars are all passed); a glob would hand the router every other seat's key.
EnvironmentFile=-%h/.config/fleet-ops/seats/alibaba-coding.env
EnvironmentFile=-%h/.config/fleet-ops/seats/anthropic-api.env
EnvironmentFile=-%h/.config/fleet-ops/seats/commandcode.env
EnvironmentFile=-%h/.config/fleet-ops/seats/minimax.env
EnvironmentFile=-%h/.config/fleet-ops/seats/opencode.env
EnvironmentFile=-%h/.config/fleet-ops/seats/typesafe-jev.env
EnvironmentFile=-%h/.config/fleet-ops/seats/zai.env
EnvironmentFile=%h/.config/fleet-ops/litellm-master-key.env
EnvironmentFile=%h/.config/fleet-ops/litellm-db.env
# No `-` prefix on purpose: without this file the proxy fails to start (loud, via OnFailure=)
# instead of running with a cache it cannot authenticate to. ansible/host.yml renders it.
EnvironmentFile=%h/.config/fleet-ops/litellm-keys/redis.env
Slice=app-litellm.slice
# The router's own cap, equal to app-litellm.slice's MemoryMax; the slice test below asserts the two
# stay equal. The slice still bounds the whole tree at the same 5G, so this is not a tighter limit.
# It gives the unit a cap of its own instead of `infinity` in `systemctl show -p MemoryMax`, and
# makes the proxy's cgroup the one that hits its wall at 5G rather than the shared slice.
MemoryMax=5G
# systemd's 90 s default would not cover a first pull of a new image; Type=notify ends the wait at
# container start.
TimeoutStartSec=15min
ManagedOOMPreference=avoid
Restart=on-failure
RestartSec=10s
# Let in-flight requests drain (fleet-ops#4449, #11739). Above the 300 s --stop-timeout, so
# podman's own SIGKILL fires first and the unit still has time to remove the container.
TimeoutStopSec=320
# A planned stop whose call outlives --stop-timeout ends in podman's SIGKILL (the pinned litellm CLI
# has no uvicorn timeout_graceful_shutdown flag to bound it), so conmon exits 137 and the unit would
# fail and page on a restart that worked (fleet-ops#10177). Exit 137 is therefore a success. A failed start is podman exit 125, a crash is
# another exit code or signal, and a kernel OOM kill inside this unit's cgroup ends the unit as
# `oom-kill`, which OOMPolicy=stop (the default, written here so the pair stays together) sets
# whatever the exit code. Not covered: an external `podman kill` or `kill -9` of the main container
# with no OOM behind it ends as success, and Restart=on-failure does not restart it.
# tests/test_litellm_proxy_stop_not_failure.py pins both halves.
SuccessExitStatus=137
OOMPolicy=stop

[Install]
WantedBy=default.target
