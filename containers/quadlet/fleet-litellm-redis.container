# Fleet LiteLLM Redis, containerized (fleet-ops#8435, cutover #8494).
# Mounted at its own host path: redis.conf sets `dir` to that absolute path.
# save "" and appendonly no, so nothing is written; the mount is read-only.

[Unit]
Description=Fleet LiteLLM Redis (Quadlet, fleet-ops#8435)

[Container]
Image=docker.io/library/redis:7
# Floating tag, so `podman auto-update` moves it inside the weekly paused window
# (ansible/update.yml). A pinned tag must not carry this line (fleet-ops#9254).
AutoUpdate=registry
Network=host
Volume=%h/.local/share/fleet-litellm-redis:%h/.local/share/fleet-litellm-redis:ro
# Password: a 0600 one-line `requirepass` fragment pulled in with --include, so the value never sits
# on the command line. The host user maps to the image's redis uid 999, so the 0600 file reads inside
# the container; the data dir mount stays read-only (save "" and appendonly no, nothing is written).
# ansible/host.yml renders this file and litellm-keys/redis.env (read by the proxy) from ONE root-only
# password file (/etc/fleet-ops/litellm-redis-password, created by the stock password lookup), so the
# two cannot differ. FAIL CLOSED: if the fragment is missing, the bind mount fails and this unit does
# not start; the proxy Requires= it, so nothing runs with an open or unmatched cache.
UserNS=keep-id:uid=999,gid=999
Volume=%h/.config/fleet-ops/litellm-keys/redis-auth.conf:/run/secrets/redis-auth.conf:ro
Exec=redis-server %h/.local/share/fleet-litellm-redis/redis.conf --include /run/secrets/redis-auth.conf

[Service]
Slice=app-litellm-redis.slice
ManagedOOMPreference=avoid
MemoryMax=256M
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
