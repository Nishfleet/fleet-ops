[Unit]
Description=aiostreams (media streaming aggregator)
# A crash loop must reach `failed`, which only the user-manager failed list
# (`systemctl --user list-units --state=failed`) reads: no OnFailure= hook, and
# the node_systemd_unit_state gauge reads system units only. The default 5
# starts in 10 s is never spent at RestartSec=5s (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Container]
# Pinned by digest; the tag is only a label. Bump the digest in its own PR.
Image=ghcr.io/viren070/aiostreams:latest@sha256:83893d1c37eaaaf9ad1e9286bd857220a6b8f042a4f1eac3fa7356017aa2b184
ContainerName=aiostreams
PublishPort=127.0.0.1:3000:3000
Volume=/srv/aiostreams/data:/app/data
EnvironmentFile=%h/.config/aiostreams/aiostreams.env

[Service]
MemoryMax=512M
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
