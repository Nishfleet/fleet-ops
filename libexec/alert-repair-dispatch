def _target_repo(alertnames, common_labels, alerts):
    """Return the repo this dispatch targets, or "" for fleet-internal alerts.

    Priority: per-alert `repo` label (AMX_ALERT_<i>_LABEL_repo) > common
    `repo` label (AMX_LABEL_repo) > first non-empty per-alert label > "".
    Empty means no repo, so no claim needed — the dispatch is for the
    fleet itself (heartbeat, watchdog, etc.), not a per-repo fix.
    """
    for a in alerts:
        repo = a.get("labels", {}).get("repo", "")
        if repo:
            return repo
    repo = common_labels.get("repo", "")
    return repo or ""


def _acquire_alert_repair_claim(alertnames, repo, log):
    """Try to acquire the atomic claim branch. Returns True iff acquired.

    On rc=1 (already claimed), the dispatcher MUST spawn NOTHING and log
    `skipped-claimed`. On rc=0, the dispatcher may spawn. On rc=2 (script
    error: missing checkout, no remote, no AMX env, etc.) we log and let
    the dispatch proceed — a flaky mutex must not block every dispatch.
    """
    if not repo:
        # No target repo: fleet-internal alert, no claim branch to acquire.
        return True
    # The claim branch is scoped to the first (most-specific) alert name so
    # two different alerts on the same repo do NOT collide.
    scope_alert = alertnames[0] if alertnames else ""
    if not scope_alert:
        return True
    bin_path = ALERT_REPAIR_CLAIM_BIN
    if not Path(bin_path).exists():
        # Tests install the helper to a tmp path; in production install.sh
        # places it next to this script. Missing is a script error, not a
        # collision — log loud and let the dispatch proceed (same posture
        # as rc=2 below).
        log(f"WARN: alert-repair-claim helper missing at {bin_path}; "
            "dispatch proceeding without atomic mutex (this is a deploy bug)")
        return True
    try:
        r = subprocess.run(
            [bin_path, repo, scope_alert],
            capture_output=True, text=True, timeout=30,
        )
    except subprocess.TimeoutExpired:
        log(f"WARN: alert-repair-claim {repo}/{scope_alert} timed out; "
            "dispatch proceeding without mutex")
        return True
    if r.returncode == 0:
        log(f"acquired claim: {r.stdout.strip()}")
        return True
    if r.returncode == 1:
        # Already claimed — the canonical skip path. The caller writes the
        # `skipped-claimed` line.
        log(f"claim held by other: {r.stdout.strip()}")
        return False
    # Script error: log loud but proceed. A flaky mutex is preferable to
    # dropping every alert.
    log(f"WARN: alert-repair-claim {repo}/{scope_alert} exited "
        f"{r.returncode}: {r.stderr.strip()}; dispatch proceeding")
    return True


def _sanitise(s):
    return re.sub(r"[^A-Za-z0-9._-]", "_", s)


def _loud(msg):
    """Emit a LOUD line to stderr and the actions.log (fleet-ops#3661)."""
    line = f"[{utcnow()}] LOUD {msg}"
    print(line, file=sys.stderr)
    try:
        with LOG.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def _seat_key_in_caps(provider, model):
    """True if (provider, model) is a real seat in seat-caps.json.

    fleet-ops#3661: a pair not present in providers.<p>.models.<m> is a
    PHANTOM seat key (e.g. a probe-output filename fragment like
    "swe-1-7-.out") and must never be dispatched. Fail-open when the caps
    file is missing/unparseable so a missing caps file never bricks the
    dispatch ladder.

    fleet-ops#4018: a model id carrying a `.out` suffix is a probe-output
    filename fragment, never a real seat model. Reject it BEFORE the
    fail-open, so a phantom model read back from pi-seat-health.json (the
    single-record sidecar _select_seat prioritises) cannot pass the
    caps-missing fail-open and be re-dispatched as `--model <model>-.out` —
    the seat-health extension then re-writes the phantom `<model>-.out.json`
    ledger, self-perpetuating the split (live devin__glm-5-2-.out.json /
    xai-oauth__grok-4-6-.out.json).
    """
    if str(model).endswith(".out"):
        return False
    try:
        caps = json.loads(Path(SEAT_CAPS_JSON).read_text())
    except (OSError, json.JSONDecodeError):
        return True
    try:
        return caps.get("providers", {}).get(provider, {}).get("models", {}).get(model) is not None
    except AttributeError:
        return True


def _seat_key_valid(provider, model):
    """LOUD-reject a phantom seat key; True when the pair is a real seat.

    fleet-ops#3661: unknown key -> skip + LOUD, never probe or dispatch.
    """
    if _seat_key_in_caps(provider, model):
        return True
    _loud(f"SEAT-KEY-INVALID {provider}/{model} writer=alert-repair-dispatch")
    return False


def _in_future(ts):
    if not ts:
        return False
    try:
        return time.time() < calendar.timegm(
            time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return False


def _class_park_active(name):
    """Return iso `decision_class_until` if the canary has parked this
    alert's class and the park is still in the future, else None.

    Reads agent-state/fleet-completion-canary/open/<name>.json (the same
    file the canary writes — no new contract, no new state). A missing
    file or unparseable timestamp means "not parked" (fail-open: a flaky
    read must not block every dispatch, mirroring the alert-repair-claim
    posture for rc=2). The canary already enforces equivalence via
    `now < class_dt`; this helper reuses the same _in_future comparison.
    """
    try:
        d = json.loads((CLASS_PARK_DIR / f"{name}.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None
    until = d.get("decision_class_until")
    if not until:
        return None
    return until if _in_future(until) else None


def _fresh(ts):
    if not ts:
        return False
    try:
        return 0 <= time.time() - calendar.timegm(
            time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) <= 1800
    except ValueError:
        return False


def _provider_overload_wedged(provider):
    """True if this provider is mid a partial 503 storm (fleet-ops#2661).
    Mirrors lib/seat-lib.sh provider_overload_wedged(): a provider with >=2 of
    its seats in overload_bench whose wall end (bench_until ?? usable_at) is in
    the future or expired within the trailing 1800s is WEDGED — the escalation
    lanes must NEVER land on it (a dispatch into the storm just dies the same way
    the workers died)."""
    WINDOW_S = 1800
    MIN_SEATS = 2
    n = 0
    now = time.time()
    try:
        for f in sorted(Path(SEAT_LEDGER_DIR).iterdir()):
            if not f.is_file() or "__" not in f.name or not f.name.endswith(".json"):
                continue
            if ".spawn-bench" in f.name:
                continue
            try:
                d = json.loads(f.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            if d.get("provider") != provider:
                continue
            if d.get("health_class") != "overload_bench":
                continue
            end = d.get("bench_until") or d.get("usable_at") or ""
            if not end:
                continue
            try:
                we = calendar.timegm(time.strptime(end[:19], "%Y-%m-%dT%H:%M:%S"))
            except ValueError:
                continue
            if we >= now - WINDOW_S:
                n += 1
                if n >= MIN_SEATS:
                    return True
    except OSError:
        return False
    return False


def _spawn_bench_held(provider, model):
    """Return True if the wrapper's spawn-bench sibling benched this seat.

    Reads <ledger>/<provider>__<model>.spawn-bench.json — the clobber-proof
    empty-run/spawn-fail marker written ONLY by the wrapper
    (mark_seat_empty_run / mark_seat_spawn_fail, fleet-ops#1512) and never by
    seat-health.ts, whose next 200-OK observation re-writes the LEDGER to
    health_class=healthy + null usable_at. A ledger showing healthy while the
    sibling bench is held is exactly the "healthy on paper, benched in
    reality" split that re-seated the verify hop onto
    openrouter/deepseek/deepseek-v4.1-flash (empty-run bench, 0B stdout,
    provider no-op) at 15:22:13Z on 2026-09-01 (fleet-ops#2672): the seat
    returned nothing, and the chain stayed stuck at hop=verify. Mirrors
    lib/seat-lib.sh seat_usable() (checks the marker FIRST, before the
    ledger) and libexec/fleet-metrics-export.py _spawn_bench_marker_held().

    fleet-ops#3737: an expired marker no longer fails open while it is still
    the seat's latest evidence — the router holds a FRESH expired marker
    (written within the 24 h count-merge window, no newer ledger
    observed_at) until the comeback organ probes the seat. Mirror the same
    rule here so repair hops do not route onto a probe-gated seat.

    fleet-ops#3828 (mirror of seat_usable #3889/#3826): this function also
    holds the bench in two more cases the clock rules miss, so a repair hop
    never routes onto a seat the router already excludes. (1) corpse fence:
    a marker-declared corpse (seat_dead=true, a chronic spawn_fail past the
    corpse threshold) is held terminally, regardless of usable_at or a later
    false-healthy ledger clobber — only a recovery probe
    (source=comeback_release) releases it. (2) ceiling fence: a FRESH marker
    whose count is at/past the failure ceiling (20 for spawn_fail, 5 for
    empty_run) stays held even when the sibling ledger carries a NEWER
    healthy observation (the after_provider_response 200 that carries
    status+headers only, never the exit rc), unless source=comeback_release.
    """
    f = (Path(SEAT_LEDGER_DIR)
         / f"{_sanitise(provider)}__{_sanitise(model)}.spawn-bench.json")
    try:
        d = json.loads(f.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    lf = (Path(SEAT_LEDGER_DIR)
          / f"{_sanitise(provider)}__{_sanitise(model)}.json")

    def _ledger_source():
        try:
            j = json.loads(lf.read_text())
            return j.get("source") if isinstance(j, dict) else ""
        except (OSError, json.JSONDecodeError):
            return ""

    # fleet-ops#3889 corpse fence: terminal until a real recovery probe.
    if d.get("seat_dead") is True:
        if _ledger_source() != "comeback_release":
            return True
        # Recovered corpse: fall through, the fresh ledger now decides.
    if _in_future(d.get("usable_at") or ""):
        return True
    written = d.get("written_at") or ""
    try:
        w = calendar.timegm(time.strptime(written[:19], "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, TypeError):
        return False
    if time.time() - w > 86400:
        return False
    try:
        obs = json.loads(lf.read_text()).get("observed_at") or ""
        o = calendar.timegm(time.strptime(obs[:19], "%Y-%m-%dT%H:%M:%S"))
    except (OSError, json.JSONDecodeError, ValueError, TypeError):
        return True
    if o <= w:
        return True
    # fleet-ops#3826 ceiling fence: a NEWER healthy observation is the
    # false-healthy clobber, not recovery, for a ceiling-parked seat.
    try:
        mcount = int(d.get("consecutive_failure_count") or 0)
    except (TypeError, ValueError):
        mcount = 0
    _ceil = 5 if (d.get("failure_mode") or "") == "empty_run" else 20
    if mcount >= _ceil and _ledger_source() != "comeback_release":
        return True
    return False


def _seat_walled(provider, model):
    """Return True if the per-seat ledger marks this seat walled (unusable).

    Mirrors lib/seat-lib.sh seat_usable(): the wrapper's spawn-bench sibling
    (empty-run/spawn-fail marker, fleet-ops#1512) is checked FIRST — a held
    bench outranks a later healthy ledger observation, because the bench
    survives the seat-health clobber while the ledger does not; then
    seat_dead, hard-fail health classes, bench classes while bench_until is
    in the future, a fresh rate_limited marker with usable_at in the future,
    and any usable_at in the future. No ledger file / unparseable -> assume
    usable (fail-open), so a missing ledger never bricks the ladder.
    """
    if _spawn_bench_held(provider, model):
        return True
    f = Path(SEAT_LEDGER_DIR) / f"{_sanitise(provider)}__{_sanitise(model)}.json"
    try:
        d = json.loads(f.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    if d.get("seat_dead") is True:
        return True
    hc = d.get("health_class") or ""
    if hc in {"credentials_bad", "quota_exhausted"}:
        return True
    bench = d.get("bench_until") or ""
    if hc in {"quota_bench", "overload_bench", "hang_bench"}:
        # Bench classes are walled while bench_until is in the future;
        # once it passes the seat is retried (fail-open).
        return _in_future(bench)
    if hc == "rate_limited":
        # Trust the marker only while fresh AND usable_at is in the future.
        return _fresh(d.get("observed_at")) and _in_future(d.get("usable_at") or "")
    return _in_future(d.get("usable_at") or "")


def _enumerate_ledger_seats():
    """Yield (provider, model) pairs from the per-seat ledger directory.

    Reads the raw provider/model from each ledger file (not the sanitised
    filename) so the returned model is dispatch-correct.
    """
    try:
        entries = sorted(Path(SEAT_LEDGER_DIR).iterdir())
    except OSError:
        return
    for f in entries:
        if not f.is_file() or not f.name.endswith(".json"):
            continue
        try:
            d = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        p, m = d.get("provider"), d.get("model")
        # fleet-ops#3661: never dispatch a phantom seat key (skip + LOUD).
        if p and m and _seat_key_valid(p, m):
            yield p, m


def _select_seat(exclude):
    """Return (seat_or_None, wedged_skipped). A seat is (provider, model, reason)
    or None when no candidate is usable. wedged_skipped is True when a candidate
    was excluded for the overload provider-wedge (fleet-ops#2661), so the caller can
    distinguish "every lane wedged (transient 503 storm" — refuse the dispatch)
    from "every lane genuinely walled (billing/quota" — legacy park-on-first).

    Excludes seats that are walled (per-seat ledger) or on a walled /
    excluded provider. Re-selects from the per-seat ledger rather than
    parking on a walled seat (fleet-ops#1556). A provider with >=2 seats in
    overload_bench within the trailing 30 min is skipped entirely (fleet-ops#2661).
    """
    wedged_skipped = False
    # 1. Recorded seat (pi-seat-health.json) wins if healthy, fresh, usable
    #    AND not overload-wedged (fleet-ops#2661: a stormed provider must never
    #    host an escalation repair dispatch, regardless of its recorded health).
    try:
        d = json.loads(Path(SEAT_HEALTH_FILE).read_text())
        obs = d.get("observed_at")
        fresh = False
        if isinstance(obs, str):
            try:
                fresh = 0 <= time.time() - calendar.timegm(
                    time.strptime(obs[:19], "%Y-%m-%dT%H:%M:%S")) <= 1800
            except ValueError:
                fresh = False
        p, m = d.get("provider"), d.get("model")
        if p and m:
            if _provider_overload_wedged(p):
                wedged_skipped = True
            elif (d.get("health_class") == "healthy" and fresh and p and m
                    and p not in WALLED_PROVIDERS and p not in exclude
                    and _seat_key_valid(p, m)
                    and not _seat_walled(p, m)):
                return (p, m, "healthy"), False
    except (OSError, json.JSONDecodeError):
        pass
    # 2. Fallback ladder, skipping walled seats, excluded providers and
    #    overload-wedged providers (fleet-ops#2661).
    for p, m in FALLBACK_LADDER:

        if _provider_overload_wedged(p):
            wedged_skipped = True
            continue
        if (p not in WALLED_PROVIDERS and p not in exclude
                and _seat_key_valid(p, m)
                and not _seat_walled(p, m)):
            return (p, m, "fallback"), False
    # 3. Re-select from the per-seat ledger rather than park on a walled seat.

    for p, m in _enumerate_ledger_seats():
        if _provider_overload_wedged(p):
            wedged_skipped = True
            continue
        if (p not in WALLED_PROVIDERS and p not in exclude
                and not _seat_walled(p, m)):
            return (p, m, "re-selected"), False
    return None, wedged_skipped


def _pick_seat():
    """Return (provider, model, reason) or None. No probing, no retries.

    fleet-ops#2661: when every candidate lane is overload-wedged (transient
    503 storm), return None so the caller refuses the dispatch and spawns
    NOTHING. A genuinely-walled ladder (billing/quota/corpse — a money wall
    the worker must escalate to senior) keeps the legacy park-on
    FALLBACK_LADDER[0] so the money wall still reaches the senior pipeline."""
    seat, wedged = _select_seat(set())
    if seat:
        return seat
    if wedged:
        return None
    return FALLBACK_LADDER[0][0], FALLBACK_LADDER[0][1], "fallback"


def _senior_seats():
    """senior_seats_in_order from seat-caps.json -> [(provider, model)].

    fleet-ops#5785: the flagship ladder a repair_seat=flagship alert walks
    BEFORE the cheapest-healthy default. Order is the seat-caps declared
    senior order; entries are "provider/model" strings. Unreadable/absent
    caps -> [] (the caller falls back to _pick_seat and logs the degrade).
    """
    try:
        caps = json.loads(Path(SEAT_CAPS_JSON).read_text())
    except (OSError, json.JSONDecodeError):
        return []
    out = []
    for entry in caps.get("senior_seats_in_order") or []:
        if isinstance(entry, str) and "/" in entry:
            p, m = entry.split("/", 1)
            if p and m:
                out.append((p, m))
    return out


def _pick_flagship_seat():
    """Return (provider, model, reason) or None — the flagship pick.

    fleet-ops#5785: a repair_seat=flagship alert names a fault the cheapest
    healthy seat demonstrably cannot fix (ProductDeployStalled dispatched to
    cheap seats for days while 0509 production stayed broken). The flagship
    path walks senior_seats_in_order and takes the FIRST usable senior seat
    under the same rules _select_seat applies: walled providers, per-seat
    ledger walls, overload wedges and the seat-caps allowlist all still
    exclude. When no senior seat is usable the pick degrades to _pick_seat()
    and logs FLAGSHIP-DEGRADED — a cheap repair attempt beats no repair, and
    the degrade is loud in actions.log instead of silent.
    """
    for p, m in _senior_seats():
        if _provider_overload_wedged(p):
            continue
        if (p not in WALLED_PROVIDERS and _seat_key_valid(p, m)
                and not _seat_walled(p, m)):
            return (p, m, "flagship")
    picked = _pick_seat()
    if picked:
        _loud(f"FLAGSHIP-DEGRADED no senior seat usable — fell back to "
              f"{picked[0]}/{picked[1]} ({picked[2]})")
        return (picked[0], picked[1], f"flagship-degraded:{picked[2]}")
    return None


def utcnow():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def utcstamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def _slowburn_firing_seconds(starts_at):
    """Return seconds since the alert started firing, or None if unknown.

    `starts_at` is the AMX_ALERT_<i>_START env var. In production
    prometheus-am-executor sends a Unix epoch integer (e.g. `1789051780`),
    as seen in every recent packet file (`starts_at: 1789051780`); ISO 8601
    (`%Y-%m-%dT%H:%M:%S`, optionally with a trailing `Z`) is also accepted
    for robustness/backward-compat. A missing/unparseable timestamp means
    the duration is unknown; the caller treats unknown as "not past
    threshold" so a flaky timestamp never files prematurely.
    """
    if not starts_at:
        return None
    s = starts_at.strip()
    # AMX epoch format: digits only, optionally with a trailing `Z` or a
    # `.fff` fractional-seconds component (e.g. `1789051780`, `1789051780Z`,
    # `1789051780.123`). Strip those and treat the remaining digits as
    # epoch seconds.
    epoch = s
    if epoch.endswith("Z"):
        epoch = epoch[:-1]
    if "." in epoch:
        epoch = epoch.split(".", 1)[0]
    if epoch.isdigit():
        try:
            t = int(epoch)
        except ValueError:
            return None
    else:
        try:
            t = calendar.timegm(time.strptime(s[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            return None
    return max(0, int(time.time() - t))


def _slowburn_run(cmd, timeout=30):
    """Run one slowburn helper command and never raise.

    fleet-ops#4773: a hung `gh` (TimeoutExpired) or a missing/unusable
    binary (OSError) must be a FAILED LOOKUP — the caller sees rc!=0 with
    empty stdout — not an uncaught traceback that takes the whole
    dispatch down while the skip-list entry is supposed to stay intact.
    """
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=False,
            timeout=timeout)
    except (subprocess.TimeoutExpired, OSError):
        return subprocess.CompletedProcess(cmd, 1, "", "")


def _slowburn_find_existing(repo, signal, gh):
    """Return the open critical-path issue number carrying the signal key,
    or "" if none / the search failed. Mirrors the detector->queue
    reconciler's find_existing_signal, but a `<signal>`-only search is NOT
    enough (fleet-ops#4773): the search tokenizes the hyphenated key, so an
    unrelated issue whose text merely contains the words matches — live,
    the #4773 meta-issue itself was returned and accepted as the repair
    terminus. Accept an item ONLY when it carries the `critical-path` label
    (filtered server-side, re-checked here) AND its title carries the
    signal key in the `[{signal}]` form _slowburn_file writes. A failed
    search (rc!=0 / empty / unparseable) returns "" (fail-open: a flaky gh
    must not block the file path, and a duplicate file is caught by
    fleet-issue-file's own dedupe).
    """
    proc = _slowburn_run(
        [gh, "issue", "list", "-R", repo, "--state", "open",
         "--limit", "50", "--search", signal,
         "--label", SLOWBURN_LABEL,
         "--json", "number,title,labels"])
    if proc.returncode != 0 or not (proc.stdout or "").strip():
        return ""
    try:
        items = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return ""
    # A malformed response (a JSON object, a bare string) is a failed
    # lookup, not something to iterate (fleet-ops#4773).
    if not isinstance(items, list):
        return ""
    marker = f"[{signal}]"
    for it in items:
        n = it.get("number")
        if not (isinstance(n, int) and n > 0):
            continue
        labels = []
        for lab in it.get("labels") or []:
            name = lab.get("name") if isinstance(lab, dict) else lab
            if isinstance(name, str):
                labels.append(name)
        if SLOWBURN_LABEL not in labels:
            continue
        if marker not in (it.get("title") or ""):
            continue
        return str(n)
    return ""


def _slowburn_file(repo, signal, gh, issue_file):
    """File exactly one critical-path issue via fleet-issue-file. Returns
    the new issue number (str) or "" on failure. The title embeds the
    signal key (fleet-ops#4622) so a filed-issue title check can
    distinguish a genuine filing from a dedupe-comment pointer."""
    title = (f"alarm: FleetSloSeatAvailSlowBurn — seat-availability SLO "
             f"slow burn past 1h, no linked repair-rung claim "
             f"[{signal}]")
    body = (
        "The FleetSloSeatAvailSlowBurn alert has been firing for more than "
        "1h with no open critical-path fleet-ops item linked to it. The "
        "alert-repair dispatcher (am-executor receiver) auto-filed this "
        "issue so the degradation is visible to the autonomous repair "
        "path.\n\n"
        f"- alert: `FleetSloSeatAvailSlowBurn` (seat_availability SLO, "
        f"fleet-ops#1291)\n"
        f"- repair rung: the intake REPAIR-RUNG (fleet-ops#4639) claims "
        f"critical-path fleet-ops on reserved seats after two ticks with "
        f"usable slots < 2; this issue is the terminus the alert names.\n"
        f"- am-executor: notified via the alert-repair dispatch path.\n"
        f"- do NOT page Nish for a seat-availability warning (the alert's "
        f"own description forbids it); seat supply is operator-owned.\n\n"
        # fleet-ops#4773: the machine-checkable spec below is what makes
        # the terminus CLAIMABLE. Without it the admission gate refuses
        # the body (`agent-ready-spec-gate.py check-body`: "body has no
        # termination:/accept:/required:/metric:"), so the item would be
        # filed and no repair rung could ever claim it. Repo fleet-ops
        # additionally needs a `moves:` line naming a product metric;
        # this path moves no_usable_seat_events (seat supply is what the
        # alert is about). The bare `{signal}` trailer below stays on its
        # own line and last: it is the shipped signal-key file form (same
        # trailer as `issue_body` in lib/detector-queue-reconciler.py), so
        # do not reformat it.
        f"- metric: the auto-filed terminus is claimable and runs its "
        f"repair rung within one dispatch tick of the 1h threshold\n"
        f"- accept: `python3 lib/agent-ready-spec-gate.py check-body "
        f"--repo fleet-ops` on this body prints `SPEC-GATE: ok`\n"
        # fleet-ops#5272: the terminus must also carry a `termination:`
        # clause naming its runtime gate (AMX_STATUS=resolved ->
        # observe-to-close). Without it the fleet-ops#4540 park detector
        # can never engage, so a multi-day burn re-claims the open
        # critical-path terminus forever — every claim a reserved-seat
        # worker session with nothing left to repair.
        f"- termination: AMX_STATUS=resolved — the dispatcher's "
        f"observe-to-close pass closes this terminus when the burn "
        f"clears (fleet-ops#5299); while firing it stays OPEN as the "
        f"live-burn claim, parked by the fleet-ops#4540 gate once a "
        f"claim-branch PR merges and re-claims pass the cap\n"
        f"- moves: no_usable_seat_events\n\n"
        f"`{signal}`\n"
    )
    cmd = [issue_file, "file", "-R", repo, "--title", title, "--body", body,
           "--label", SLOWBURN_LABEL]
    proc = _slowburn_run(cmd, timeout=60)
    out = (proc.stdout or proc.stderr or "").strip()
    if proc.returncode != 0:
        return ""
    m = re.search(r"/issues/(\d+)", out)
    if not m:
        m = re.search(r"#(\d+)", out)
    if not m:
        return ""
    number = m.group(1)
    # fleet-ops#4773: the URL the create call prints is NOT proof a new
    # issue exists. fleet-issue-file dedupes by token overlap and may
    # COMMENT on an unrelated issue, printing ITS url (live: the #4773
    # meta-issue, dup score 1.00), so logging FILED for that pointer would
    # report a terminus that nothing filed. Verify the returned issue's
    # title carries the [{signal}] key — the same discriminator the
    # detector->queue reconciler's verify_filed_signal uses
    # (fleet-ops#4622/#4841) — and refuse to report a filing on mismatch.
    # A failed/unreadable view also returns "": never guess.
    view = _slowburn_run(
        [gh, "issue", "view", number, "-R", repo,
         "--json", "title", "--jq", ".title"])
    title = (view.stdout or "").strip()
    if view.returncode != 0 or not title or f"[{signal}]" not in title:
        _loud(
            f"FILED-LINK-MISMATCH {SLOWBURN_NAME} fleet-issue-file "
            f"returned issue=#{number} title='{title or '<unavailable>'}' "
            f"which does not carry signal key [{signal}]; refusing to "
            f"report it as FILED (fleet-ops#4773)")
        return ""
    return number


def _slowburn_heartbeat(repo, number, gh):
    """Post a heartbeat comment on the existing linked issue so it stays
    warm (and the observe-to-close pass has fresh evidence). Best effort:
    a failed comment is logged but never blocks the dispatch."""
    body = (f"alert-repair heartbeat: FleetSloSeatAvailSlowBurn still "
            f"firing past 1h; linked claim #{number} owns the repair rung "
            f"(fleet-ops#4773).")
    _slowburn_run(
        [gh, "issue", "comment", number, "-R", repo, "--body", body])


def _slowburn_observe_to_close(receiver, log):
    """fleet-ops#5272: when the FleetSloSeatAvailSlowBurn alert RESOLVES,
    the auto-filed terminus must not linger open. An open critical-path
    terminus is reclaim-bait for workers with nothing to repair, and
    `_slowburn_find_existing` only matches OPEN items — a stale terminus
    would swallow the next burn's file-or-link (LINK forever, no fresh
    claim) exactly the way the #4773 decoy swallowed the first one.

    Find the open terminus carrying the signal key, verify its title by
    the same read-back discriminator `_slowburn_file` uses, then close it
    with an observe-to-close comment. Every step is best-effort: a failed
    gh call skips the close (fail-open, terminus stays open — never
    worse than today) and never blocks the dispatch."""
    repo = SLOWBURN_REPO
    signal = SLOWBURN_SIGNAL
    gh = GH_BIN
    number = _slowburn_find_existing(repo, signal, gh)
    if not number:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] SKIP {SLOWBURN_NAME} observe-to-close: "
                f"no open terminus carrying [{signal}] (nothing to close; "
                f"receiver={receiver})\n"
            )
        log(f"SKIP {SLOWBURN_NAME} observe-to-close: no open terminus "
            f"(nothing to close)")
        return "no-terminus"
    # Read-back title verify (fleet-ops#4773 discriminator): never close an
    # issue the search fuzzy-matched but whose title does not carry the key.
    view = _slowburn_run(
        [gh, "issue", "view", number, "-R", repo,
         "--json", "title", "--jq", ".title"])
    title = (view.stdout or "").strip()
    if view.returncode != 0 or not title or f"[{signal}]" not in title:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] WARN {SLOWBURN_NAME} observe-to-close "
                f"skipped: candidate #{number} title='{title or '<unavailable>'}' "
                f"does not carry signal key [{signal}]\n"
            )
        log(f"WARN {SLOWBURN_NAME} observe-to-close skipped on #{number} "
            f"(title verify failed)")
        return "skip-mismatch"
    body = (
        f"observe-to-close: FleetSloSeatAvailSlowBurn resolved "
        f"(AMX status=resolved, receiver={receiver}) at {utcnow()}. "
        f"The auto-filed terminus #{number} is no longer a live burn "
        f"claim — closing so a future burn files a FRESH terminus "
        f"instead of linking this one forever (fleet-ops#4773/#5272). "
        f"Seat-supply root causes continue on their own repair issues."
    )
    _slowburn_run(
        [gh, "issue", "comment", number, "-R", repo, "--body", body])
    close = _slowburn_run(
        [gh, "issue", "close", number, "-R", repo,
         "--reason", "completed"])
    if close.returncode != 0:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] WARN {SLOWBURN_NAME} observe-to-close: "
                f"close of #{number} failed rc={close.returncode}; "
                f"terminus left open\n"
            )
        log(f"WARN {SLOWBURN_NAME} observe-to-close: close of #{number} "
            f"failed (rc={close.returncode}); terminus left open")
        return "close-failed"
    with LOG.open("a") as f:
        f.write(
            f"[{utcnow()}] CLOSED alertname={SLOWBURN_NAME} "
            f"repo={repo} issue=#{number} signal={signal} "
            f"receiver={receiver} reason=observe-to-close\n"
        )
    log(f"CLOSED {SLOWBURN_NAME} -> #{number} (observe-to-close: the "
        f"slow burn resolved; terminus no longer a live claim)")
    return "closed"


def _slowburn_file_or_link(starts_at, log):
    """fleet-ops#4773: when FleetSloSeatAvailSlowBurn has been firing past
    the threshold, file exactly one critical-path issue or link an
    existing one. The skip-list entry STAYS — this never spawns a worker.
    Returns the action taken: "filed", "linked", "skip-short", or
    "skip-error". Idempotent: a second tick finds the existing issue and
    links instead of filing a second. `starts_at` is the first alert's
    AMX_ALERT_<i>_START (ISO 8601); the skip loop calls this before the
    full per-alert list is built, so it takes the timestamp directly.
    """
    secs = _slowburn_firing_seconds(starts_at)
    if secs is None or secs < SLOWBURN_THRESHOLD_S:
        log(f"SKIP {SLOWBURN_NAME} reason=skip-list "
            f"(firing {secs}s < {SLOWBURN_THRESHOLD_S}s; rung not yet "
            f"past threshold, no file-or-link)")
        return "skip-short"
    repo = SLOWBURN_REPO
    signal = SLOWBURN_SIGNAL
    gh = GH_BIN
    issue_file = FLEET_ISSUE_FILE_BIN
    existing = _slowburn_find_existing(repo, signal, gh)
    if existing:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] LINK alertname={SLOWBURN_NAME} "
                f"repo={repo} issue=#{existing} signal={signal} "
                f"firing={secs}s receiver=repair-dispatch\n"
            )
        log(f"LINK {SLOWBURN_NAME} -> #{existing} (existing claim, "
            f"no second file; firing {secs}s)")
        _slowburn_heartbeat(repo, existing, gh)
        return "linked"
    if not Path(issue_file).exists():
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] WARN {SLOWBURN_NAME} fleet-issue-file "
                f"missing at {issue_file}; cannot auto-file (firing "
                f"{secs}s)\n"
            )
        log(f"WARN {SLOWBURN_NAME} fleet-issue-file missing; cannot "
            f"auto-file (firing {secs}s)")
        return "skip-error"
    number = _slowburn_file(repo, signal, gh, issue_file)
    # "" from _slowburn_file covers two causes: the fleet-issue-file call
    # itself failed, or it succeeded but the returned issue failed the
    # [{signal}] title verify (a FILED-LINK-MISMATCH, fleet-ops#4773).
    # Either way there is no terminus, so this is skip-error, never filed.
    if not number:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] WARN {SLOWBURN_NAME} auto-file failed "
                f"(firing {secs}s)\n"
            )
        log(f"WARN {SLOWBURN_NAME} auto-file failed (firing {secs}s)")
        return "skip-error"
    with LOG.open("a") as f:
        f.write(
            f"[{utcnow()}] FILED alertname={SLOWBURN_NAME} "
            f"repo={repo} issue=#{number} signal={signal} firing={secs}s "
            f"receiver=repair-dispatch\n"
        )
    log(f"FILED {SLOWBURN_NAME} -> #{number} (auto-filed critical-path; "
        f"firing {secs}s)")
    return "filed"


# ---------------------------------------------------------------------------
# fleet-ops#5142: bounded, fail-open deliverable pre-flight for surviving
# DetachedJobDied alerts. A dead detached unit whose packet already landed
# its deliverable (the declared file exists non-empty, or the PR the packet
# named merged / is armed + mergeable) must NOT be relaunched — the repair
# worker would re-do finished work and burn a seat. The check is journal
# first (the dead-man `died:` line is the only record of the declared
# deliverable path), then dispatch-ledger -> packet -> exactly one gh call.
# Every helper below swallows all errors: any ambiguity falls through to
# the unchanged relaunch path — a genuinely dead packet is never stranded.


def _read_tail(path, max_bytes):
    """Return the last `max_bytes` of `path` as text, or None on any error."""
    try:
        p = Path(path)
        with p.open("rb") as f:
            if p.stat().st_size > max_bytes:
                f.seek(-max_bytes, os.SEEK_END)
            return f.read().decode("utf-8", "replace")
    except (OSError, ValueError):
        return None


def _journal_deliverable(unit):
    """Declared deliverable path for `unit` from the dead-man `died:` line.

    pi-detached-deadman logs `died: unit=<u> result=<r>
    deliverable=<path|unset>` into the dead unit's journal; the dispatch
    ledger does NOT carry the path. One bounded journalctl call (10s); the
    last `died:` line for THIS unit wins. Returns the path only when it is
    absolute and the file exists non-empty, else '' (fail-open).
    """
    try:
        r = subprocess.run(
            [JOURNALCTL_BIN, "--user", "-u", unit, "-u", unit + ".service",
             "--no-pager", "-n", "500"],
            capture_output=True, text=True, check=False, timeout=10)
    except Exception:
        return ""
    found = ""
    for line in (r.stdout or "").splitlines():
        if "died:" not in line:
            continue
        mu = re.search(r"\bunit=(\S+)", line)
        md = re.search(r"\bdeliverable=(\S+)", line)
        if mu and md and mu.group(1) == unit:
            found = md.group(1)
    if not found or found == "unset" or not os.path.isabs(found):
        return ""
    try:
        p = Path(found)
        if not p.is_file() or p.stat().st_size <= 0:
            return ""
    except OSError:
        return ""
    return found


def _ledger_packet_path(dispatch_id, unit):
    """packet_path of the LAST ledger entry whose `id` == `dispatch_id`
    (fallback: `unit` == `unit`), or ''. Bounded 256KB tail read; a
    mid-line cut or corrupt entry is skipped, never fatal."""
    text = _read_tail(DISPATCH_LEDGER, 256 * 1024)
    if not text:
        return ""
    entries = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(d, dict):
            entries.append(d)
    last = None
    if dispatch_id:
        for d in entries:
            if d.get("id") == dispatch_id:
                last = d
    if last is None and unit:
        for d in entries:
            if d.get("unit") == unit:
                last = d
    if not last:
        return ""
    pp = last.get("packet_path")
    return pp if isinstance(pp, str) else ""


# Branch prefixes a packet's deliverable ref is allowed to carry.
_BRANCH_PREFIXES = ("claim", "fable", "chore", "fix", "feat", "hotfix",
                    "repair")


def _packet_branch(text):
    """First branch ref named in the packet, in priority order:
    `claim/issue-<N>`, `branch[: ]+<token>`, or a backticked
    `prefix/rest` token with a known prefix. '' when none."""
    m = re.search(r"\bclaim/issue-\d+\b", text)
    if m:
        return m.group(0)
    m = re.search(r"(?i)\bbranch\b[:\s]+([A-Za-z0-9_.\-/]+)", text)
    if m:
        return m.group(1).rstrip(".,:;")
    m = re.search(
        r"`((?:" + "|".join(_BRANCH_PREFIXES) + r")/[^`\s]+)`", text)
    if m:
        return m.group(1).rstrip(".,:;")
    return ""


def _packet_repo(text, exclude=()):
    """First `<org>/<repo>` token naming a repo. Prefers `Nishfleet/<repo>`
    and explicit `repo: X/Y` / `TARGET: repo X/Y` forms; generic X/Y tokens
    are skipped when they are path fragments (preceded by `/` or part of a
    longer path segment), branch-shaped (prefix in _BRANCH_PREFIXES), or in
    `exclude` (the branch token itself must not be mistaken for a repo)."""
    m = re.search(r"\bNishfleet/([A-Za-z0-9_.-]+)", text)
    if m:
        return "Nishfleet/" + m.group(1)
    m = re.search(r"(?i)\brepo[:=\s]+([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)", text)
    if m:
        return m.group(1)
    for m in re.finditer(
            r"(?<![/\w.-])([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)", text):
        tok = m.group(1)
        if tok in exclude or tok.split("/", 1)[0] in _BRANCH_PREFIXES:
            continue
        return tok
    return ""


def _packet_pr_candidate(text):
    """Extract ONE PR candidate from the packet, in priority order:
    ('list', repo, branch) when a branch ref plus a repo token are both
    present; else ('view', repo, N) for `<org>/<repo>#<N>`; else ('view',
    repo, N) for `PR #<N>` plus a repo token. None -> the caller makes no
    gh call at all."""
    branch = _packet_branch(text)
    if branch:
        repo = _packet_repo(text, exclude={branch})
        if repo:
            return ("list", repo, branch)
    m = re.search(
        r"(?<![/\w.-])([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#(\d+)", text)
    if m:
        return ("view", m.group(1), m.group(2))
    m = re.search(r"(?i)\bPR\s*#(\d+)", text)
    if m:
        repo = _packet_repo(text)
        if repo:
            return ("view", repo, m.group(1))
    return None


def _gh_pr_satisfied(candidate, gh_budget):
    """Spend the single gh budget on `candidate`; return the deliverable
    label (`<repo>#<N>`, or the branch when no number is known) when the
    named PR proves delivered, else ''. Delivered iff state==MERGED, or
    state==OPEN with autoMergeRequest truthy and mergeable==MERGEABLE.
    HARD BUDGET: at most one gh invocation per dispatch run — a spent
    budget, a timeout, a non-zero exit or non-JSON output all fail open."""
    if gh_budget["spent"]:
        return ""
    gh_budget["spent"] = True
    kind, repo, ref = candidate
    if kind == "list":
        argv = [GH_BIN, "pr", "list", "-R", repo, "--head", ref,
                "--state", "all",
                "--json", "number,state,autoMergeRequest,mergeable"]
    else:
        argv = [GH_BIN, "pr", "view", str(ref), "-R", repo,
                "--json", "state,autoMergeRequest,mergeable"]
    try:
        r = subprocess.run(argv, capture_output=True, text=True,
                           check=False, timeout=5)
    except Exception:
        return ""
    if r.returncode != 0:
        return ""
    try:
        data = json.loads(r.stdout or "")
    except (json.JSONDecodeError, ValueError):
        return ""
    if isinstance(data, dict):
        items = [data]
    elif isinstance(data, list):
        items = [d for d in data if isinstance(d, dict)]
    else:
        return ""
    for d in items:
        state = d.get("state")
        if state != "MERGED" and not (
                state == "OPEN" and d.get("autoMergeRequest")
                and d.get("mergeable") == "MERGEABLE"):
            continue
        num = d.get("number")
        return f"{repo}#{num}" if num else str(ref)
    return ""


def _deliverable_satisfied(labels, gh_budget):
    """Return the deliverable evidence for a surviving DetachedJobDied
    alert — the journal-declared file path or `repo#<N>`/branch — or ''.
    Journal first (the `died:` line carries the declared path), then
    ledger -> packet -> the single gh PR check. NEVER raises: every
    ambiguity (journal error, no died line, missing/unreadable ledger or
    packet, no candidate, gh failure/timeout/parse error) returns '' so
    the caller falls through to the unchanged relaunch path."""
    unit = labels.get("unit", "")
    if not unit:
        return ""
    try:
        path = _journal_deliverable(unit)
        if path:
            return path
        packet_path = _ledger_packet_path(labels.get("dispatch", ""), unit)
        if not packet_path:
            return ""
        text = _read_tail(packet_path, 256 * 1024)
        if not text:
            return ""
        candidate = _packet_pr_candidate(text)
        if not candidate:
            return ""
        return _gh_pr_satisfied(candidate, gh_budget)
    except Exception:
        return ""


def main():
    # --print-seat (no AMX env): emit a single "<provider>\t<model>\t<reason>"
    # line on stdout and exit 0. Used by fleet-completion-canary when it
    # needs a fresh seat for a re-dispatch without duplicating the seat
    # selection logic. An optional --exclude=prov1,prov2 removes providers
    # from the fallback ladder (the canary passes the original seat here so
    # a re-dispatch lands on a different lane).
    if "--print-seat" in sys.argv[1:]:
        excl = set()
        try:
            i = sys.argv.index("--exclude")
            if i + 1 < len(sys.argv) and not sys.argv[i + 1].startswith("--"):
                excl = {p for p in sys.argv[i + 1].split(",") if p}
        except ValueError:
            pass
        seat, _ = _select_seat(excl)
        if seat:
            print(f"{seat[0]}\t{seat[1]}\t{seat[2]}")
            return 0
        # No seat available in the requested exclusions — exit 2 so the
        # caller can decide (the canary falls back to a STOP-REASON
        # write rather than dispatching into a wall).
        print("WALLED\t-\tall-seats-walled-or-excluded", file=sys.stderr)
        return 2

    PACKET_DIR.mkdir(parents=True, exist_ok=True)
    status = os.environ.get("AMX_STATUS", "")
    receiver = os.environ.get("AMX_RECEIVER", "?")

    # fleet-ops#5272: the resolved branch needs the alert group's alertnames
    # (collected below) to attribute the resolution to the slow burn, so the
    # handling moved AFTER the collection and BEFORE the empty guard — a
    # resolved notification with no per-alert labels still skips cleanly
    # (fail-open, exactly the old behaviour).

    # AMX_ALERT_<i>_LABEL_alertname — find unique alertnames (1-indexed).
    alertnames = []
    for i in range(1, 65):
        v = os.environ.get(f"AMX_ALERT_{i}_LABEL_alertname")
        if v and v not in alertnames:
            alertnames.append(v)

    # fleet-ops#1199 / #4773: stderr logger used by the skip loop's
    # slowburn file-or-link and the alert-repair mutex below.
    def _log(msg):
        print(f"[{utcnow()}] {msg}", file=sys.stderr)

    if status == "resolved":
        with LOG.open("a") as f:
            f.write(f"[{utcnow()}] SKIP resolved notification receiver={receiver}\n")
        # fleet-ops#5272 observe-to-close: when the resolved group includes
        # the slow burn, close the auto-filed terminus — an open critical-path
        # terminus after the burn cleared is reclaim-bait and would swallow
        # the NEXT burn's file-or-link (`_slowburn_find_existing` only
        # matches open items). Everything inside is best-effort fail-open.
        if SLOWBURN_NAME in alertnames:
            _slowburn_observe_to_close(receiver, _log)
        print(f"[{utcnow()}] SKIP resolved (receiver={receiver})", file=sys.stderr)
        return 0

    if not alertnames:
        print(f"[{utcnow()}] ERROR: no AMX_ALERT_<n>_LABEL_alertname env vars",
              file=sys.stderr)
        return 2

    # fleet-ops#1199 / #4773: stderr logger used by the skip loop's
    # slowburn file-or-link and the alert-repair mutex below.
    def _log(msg):
        print(f"[{utcnow()}] {msg}", file=sys.stderr)

    # Skip synthetic/heartbeat alerts.
    for name in alertnames:
        if name in SKIP_SET:
            # fleet-ops#4773: FleetSloSeatAvailSlowBurn stays in SKIP_SET (no
            # repair worker can raise seats), but a slow burn firing >1h
            # with zero linked critical-path items is invisible to every
            # autonomous path. Defer the return so the file-or-link step
            # can file/link exactly one issue before the skip return. The
            # skip-list entry STAYS — this never spawns a worker.
            if name == SLOWBURN_NAME:
                # Find the AMX_ALERT_<i>_START for THIS alert, not a
                # hardcoded index: alertnames is deduped, so SlowBurn
                # may sit at any 1-indexed slot. A wrong index would feed
                # another alert's start time and file prematurely/late.
                sb_start = ""
                for _i in range(1, 65):
                    if os.environ.get(
                            f"AMX_ALERT_{_i}_LABEL_alertname") == name:
                        sb_start = os.environ.get(
                            f"AMX_ALERT_{_i}_START", "")
                        break
                _slowburn_file_or_link(sb_start, _log)
                with LOG.open("a") as f:
                    f.write(
                        f"[{utcnow()}] SKIP alertname={name} "
                        f"receiver={receiver} reason=skip-list "
                        f"(slowburn file-or-link attempted)\n"
                    )
                print(f"[{utcnow()}] SKIP alertname={name} (in skip-list)",
                      file=sys.stderr)
                return 0
            with LOG.open("a") as f:
                f.write(
                    f"[{utcnow()}] SKIP alertname={name} receiver={receiver} "
                    f"reason=skip-list\n"
                )
            print(f"[{utcnow()}] SKIP alertname={name} (in skip-list)", file=sys.stderr)
            return 0

    # Class-park skip (auditor 2026-08-31T11:1xZ): honor fleet-completion-canary's
    # `decision_class_until` verdict. If the canary has parked this alert's
    # class (e.g. FleetQueueSelfMaintenanceRatioHigh — a structural-signal
    # alert whose Nish-reserved root cannot be cleared in-turn), a fresh
    # AMX dispatch MUST NOT spawn a new unit; the existing chain owns the
    # escalation. Park expiry re-opens the dispatch window on the next
    # AMX fire after `decision_class_until + repeat_interval`.
    for name in alertnames:
        until = _class_park_active(name)
        if until:
            with LOG.open("a") as f:
                f.write(
                    f"[{utcnow()}] SKIP alertname={name} receiver={receiver} "
                    f"reason=class-park until={until}\n"
                )
            print(f"[{utcnow()}] SKIP alertname={name} (class-park "
                  f"until={until})", file=sys.stderr)
            return 0

    # Common (group) labels.
    common_labels = {
        k[len("AMX_LABEL_"):]: v
        for k, v in os.environ.items()
        if k.startswith("AMX_LABEL_") and not k.startswith("AMX_ALERT_")
    }
    common_annotations = {
        k[len("AMX_ANNOTATION_"):]: v
        for k, v in os.environ.items()
        if k.startswith("AMX_ANNOTATION_") and not k.startswith("AMX_ALERT_")
    }

    # Per-alert labels/annotations (n=1..N).
    alerts = []
    for i in range(1, 65):
        alertname = os.environ.get(f"AMX_ALERT_{i}_LABEL_alertname")
        if not alertname:
            break
        labels = {
            k[len(f"AMX_ALERT_{i}_LABEL_"):]: v
            for k, v in os.environ.items()
            if k.startswith(f"AMX_ALERT_{i}_LABEL_")
        }
        annotations = {
            k[len(f"AMX_ALERT_{i}_ANNOTATION_"):]: v
            for k, v in os.environ.items()
            if k.startswith(f"AMX_ALERT_{i}_ANNOTATION_")
        }
        alerts.append({
            "status": os.environ.get(f"AMX_ALERT_{i}_STATUS", ""),
            "starts_at": os.environ.get(f"AMX_ALERT_{i}_START", ""),
            "ends_at": os.environ.get(f"AMX_ALERT_{i}_END", ""),
            "url": os.environ.get(f"AMX_ALERT_{i}_URL", ""),
            "fingerprint": os.environ.get(f"AMX_ALERT_{i}_FINGERPRINT", ""),
            "labels": labels,
            "annotations": annotations,
        })

    # DetachedJobDied repair-artifact recursion guard (auditor 2026-09-09):
    # a failed alert-repair-DetachedJobDied-<ts> unit itself writes a
    # fleet_detached_job_died metric, which Alertmanager groups and dispatches
    # a fresh repair unit for. Each failed repair has a unique unit name (new
    # fingerprint), so Alertmanager's 6h repeat does not throttle it and the
    # chain self-amplifies. Break the loop by clearing the dead-man for
    # unlaunchable / repair-artifact deaths and not dispatching a worker for
    # them. Real detached jobs (pi-issue-*, pi-fleetops-*, etc.) still dispatch.
    filtered = []
    deadman_bin = Path(
        os.environ.get(
            "PI_DEADMAN_BIN",
            str(Path.home() / ".local" / "bin" / "pi-detached-deadman"),
        )
    )
    # fleet-ops#5142: the deliverable pre-flight below may make AT MOST ONE
    # gh call for the whole dispatch run — the first extracted candidate
    # spends the budget; every later candidate fails open.
    gh_budget = {"spent": False}
    for a in alerts:
        if a["labels"].get("alertname") == "DetachedJobDied":
            unit_name = a["labels"].get("unit", "")
            cmdline = a["labels"].get("cmdline", "")
            if (unit_name.startswith("alert-repair-") or
                    unit_name == "test-unit" or not cmdline):
                if unit_name:
                    with LOG.open("a") as f:
                        f.write(
                            f"[{utcnow()}] SKIP alertname=DetachedJobDied "
                            f"unit={unit_name} reason=repair-artifact-cleared "
                            f"(recursion-guard)\n"
                        )
                    print(
                        f"[{utcnow()}] SKIP alertname=DetachedJobDied "
                        f"unit={unit_name} reason=repair-artifact-cleared",
                        file=sys.stderr,
                    )
                    # Best-effort clear of the dead-man textfile entry so the
                    # alert resolves at the next Prometheus scrape.
                    try:
                        subprocess.run(
                            [str(deadman_bin), "--clear", unit_name],
                            check=False,
                            timeout=30,
                        )
                    except Exception:
                        pass
                    continue
            # fleet-ops#5142: bounded, fail-open deliverable pre-flight. A
            # dead detached unit whose packet already delivered (declared
            # file present+non-empty, or the named PR merged / armed +
            # mergeable) must NOT be relaunched. Any ambiguity leaves the
            # alert untouched so it falls through to the relaunch path —
            # a genuinely dead packet is never stranded.
            try:
                delivered = _deliverable_satisfied(a["labels"], gh_budget)
                if delivered:
                    with LOG.open("a") as f:
                        f.write(
                            f"[{utcnow()}] RESOLVED-DELIVERED "
                            f"unit={unit_name} deliverable={delivered}\n"
                        )
                    # Same best-effort dead-man clear as the recursion
                    # guard so the alert resolves at the next scrape.
                    try:
                        subprocess.run(
                            [str(deadman_bin), "--clear", unit_name],
                            check=False,
                            timeout=30,
                        )
                    except Exception:
                        pass
                    print(
                        f"[{utcnow()}] SKIP alertname=DetachedJobDied "
                        f"unit={unit_name} reason=deliverable-satisfied",
                        file=sys.stderr,
                    )
                    continue
            except Exception:
                pass
        filtered.append(a)
    alerts = filtered

    # Recompute alertnames from the surviving alerts so the packet, unit name
    # and claim scope match the actual dispatch.
    alertnames = []
    seen = set()
    for a in alerts:
        n = a["labels"].get("alertname", "")
        if n and n not in seen:
            alertnames.append(n)
            seen.add(n)

    if not alerts:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] SKIP all alerts were repair artifacts / "
                f"unlaunchable (recursion-guard) receiver={receiver}\n"
            )
        print(
            f"[{utcnow()}] SKIP all alerts were repair artifacts / unlaunchable "
            f"(recursion-guard)",
            file=sys.stderr,
        )
        return 0

    stamp = utcstamp()
    joined = "+".join(alertnames)
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", joined)
    packet = PACKET_DIR / f"packet-{safe}-{stamp}.md"
    unit = f"alert-repair-{safe}-{stamp}"

    # Render the packet.
    lines = [
        "# Alert repair packet",
        "",
        f"- Generated: {utcnow()}",
        f"- Receiver:  {receiver}",
        f"- Status:    {status}",
        f"- AMX URL:   {os.environ.get('AMX_EXTERNAL_URL', '?')}",
        "",
        "## Where things are (read before touching the filesystem — fleet-ops#4896)",
        "",
        "- fleet-ops checkout: /home/nish/workspaces/tooling/fleet-ops. `bin/...`, `lib/...`,",
        "  `libexec/...` and `config/...` in the annotations below are relative to it.",
        "- Alert rules: /home/nish/workspaces/tooling/fleet-ops/config/fleet_rules.yml",
        "  (`rg -n 'alert: <alertname>' config/fleet_rules.yml` from the checkout).",
        "- Metrics: Prometheus http://127.0.0.1:9090 (`curl -s 'http://127.0.0.1:9090/api/v1/query?query=<metric>'`);",
        "  textfile gauges in /var/lib/prometheus/node-exporter/*.prom; Alertmanager http://127.0.0.1:9093.",
        "- Fleet state: /home/nish/.local/state/pi-packet (packets, seats, actions.log),",
        "  /home/nish/.local/state/fleet-heartbeat, /home/nish/workspaces/agent-state/lanes.",
        "- Units: `systemctl --user status <unit>`, `journalctl --user -u <unit> -n 80`.",
        "- NEVER sweep the filesystem: no `find /home/nish`, `find /`, `grep -r ... /home/nish/...`",
        "  or `rg ... /home/nish` above a repo checkout — the spawn guard blocks them. Two such",
        "  sweeps (2026-09-10) pushed load to 20 on 8 vCPU with zero product workers admitted.",
        "  Search inside the checkout with `rg`; everything you need is listed above.",
        "",
        "## Alertnames",
        "",
    ]
    for n in alertnames:
        lines.append(f"- {n}")
    lines += ["", "## Common labels", ""]
    for k, v in sorted(common_labels.items()):
        lines.append(f"- {k}={v}")
    lines += ["", "## Common annotations", ""]
    for k, v in sorted(common_annotations.items()):
        lines.append(f"- {k}={v}")
    lines += ["", "## Per-alert details", ""]
    for idx, a in enumerate(alerts, 1):
        lines.append(f"### Alert {idx} (fingerprint {a['fingerprint']})")
        lines.append("")
        lines.append(f"- status: {a['status']}")
        lines.append(f"- starts_at: {a['starts_at']}")
        lines.append(f"- ends_at:   {a['ends_at']}")
        lines.append(f"- url:       {a['url']}")
        lines.append("- labels:")
        for k, v in sorted(a["labels"].items()):
            lines.append(f"  - {k}={v}")
        lines.append("- annotations:")
        for k, v in sorted(a["annotations"].items()):
            lines.append(f"  - {k}={v}")
        lines.append("")
    lines += [
        "## Worker instructions",
        "",
        "You are a repair worker on netcup-rs2000. Diagnose this Prometheus",
        "alert's root cause on this host, FIX it, verify the alert resolves",
        "via `curl -s 127.0.0.1:9090/api/v1/alerts`, and append a one-line",
        "result to /home/nish/workspaces/agent-state/alert-repair/actions.log.",
        "Fix same-turn; fail loud only if genuinely unrepairable.",
        "",
        "EXIT CONTRACT: after your fix, re-check `curl -s 127.0.0.1:9090/api/v1/alerts`. If the alert you were dispatched for is no longer firing, exit 0. If it still fires, or you could not repair it, append your full diagnosis to your packet file under '## FAILED-REPAIR CONTEXT' and EXIT NON-ZERO — your unit's failure mechanically escalates to the senior-auditor pipeline, which needs that context. Never exit 0 on an unresolved alert.",
        "",
        "PRODUCTION-CLAIM RULE (fleet-ops#5786): a deliverable line may state a change is already in production or already serving on this host only when that same line cites a git SHA that `git merge-base --is-ancestor <sha> origin/main` proves is merged to origin/main. A fix on a branch is a PR, not production — the deploy clone checked out on your branch is NOT production, and the packet-verdict checker + dead-man reject and fail the unit on a false claim.",
        "",
        "TRAILING-WINDOW RULE (senior auditor 2026-09-10T15:55Z; alert-repair-FleetOomdKillsHigh-20260910T144950Z timed out waiting for its window to drain): a trailing-window metric — `increase(<counter>[Nh])` or any long-window ratio — CANNOT clear on your fix alone; the pre-fix events must age out. Do NOT wait, sleep or poll for the drain. This unit is killed at RuntimeMaxSec 60 min, and a killed unit trips the dead-man with NO context for the senior auditor, which is strictly worse than an honest non-zero exit.",
        "Do this instead: append your one-line result to actions.log, append '## FAILED-REPAIR CONTEXT' naming the root cause, the fix, and the PREDICTED CLEAR TIME (oldest in-window event + window length), then finish the turn. Any bounded re-check must be under 5 minutes total.",
        "",
        "HOT-PATCH RULE: `~/.local/state/pi-packet/seat-caps.json` and `pi-models.json` are MANIFEST copy-installed files — deploy `install.sh` overwrites them from the repo copy on the next merge, so a live edit there is reverted and shows up as MANIFEST install drift (and resets learned caps). If a fix belongs in one of those files, make it in `config/<file>` in the fleet-ops repo via PR and say so in FAILED-REPAIR CONTEXT; never present a live edit to them as a durable repair.",
        "",
    ]
    packet.write_text("\n".join(lines))

    # fleet-ops#1199: acquire the alert-repair mutex BEFORE spawning. A
    # claimed-by-other result means another dispatch already owns this
    # (alert, repo) pair — heartbeat re-dispatch, prior alert, or a
    # parallel webhook 10s apart. Log `skipped-claimed` and spawn NOTHING.
    target_repo = _target_repo(alertnames, common_labels, alerts)
    if not _acquire_alert_repair_claim(alertnames, target_repo, _log):
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] SKIPPED-CLAIMED alertname={joined} "
                f"repo={target_repo} reason=alert-repair-claim-already-held "
                f"receiver={receiver}\n"
            )
        print(f"[{utcnow()}] SKIPPED-CLAIMED alertname={joined} "
              f"repo={target_repo} reason=alert-repair-claim-already-held "
              f"receiver={receiver}", file=sys.stderr)
        return 0

    # Dispatch — pick a healthy lane (no hardcoded seat). fleet-ops#2661:
    # when every candidate lane is overload-wedged (transient 503 storm, partial),
    # _pick_seat returns None — NEVER park a repair/spawn on a storming provider;
    # log `skipped-wedged` and spawn NOTHING (the alert re-fires on the next
    # AMX repeat_interval(6h); a stormed lane is worse than no lane).
    # fleet-ops#5785: an alert carrying repair_seat=flagship (e.g.
    # FleetProductionStale — a production outage cheap seats kept seeing but
    # never fixed) routes to the senior_seats_in_order ladder first; the
    # flagship pick degrades to the normal pick, loudly, when no senior seat
    # is usable.
    want_flagship = any(
        a["labels"].get("repair_seat") == "flagship" for a in alerts)
    picked = _pick_flagship_seat() if want_flagship else _pick_seat()
    if not picked:
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] SKIP alertname={joined} receiver={receiver} "
                f"reason=all-seats-wedged\n"
            )
        print(f"[{utcnow()}] SKIP alertname={joined} reason=all-seats-wedged (storm lane isolation; refusing dispatch)", file=sys.stderr)
        return 0
    provider, model, seat_reason = picked

    # fleet-ops#2495 follow-up (repair worker 2026-09-01T13:0xZ): honour a
    # no-spawn request BEFORE touching pi-systemd-run.
    #
    # tests/alert-repair-class-park-skip.test.sh calls this script directly and
    # advertises itself as "hermetic, no live 9090/systemd". It redirected
    # PACKET_DIR, CLASS_PARK_DIR, SEAT_* and CLAIM_BIN — but there was no way to
    # suppress the spawn, so every run fired REAL pi-systemd-run units for its
    # fixture alertnames (NoClassParkAlert / ClassExpiredAlert / NoParkKeyAlert).
    # Each became a real worker asked to repair an alert that has no Prometheus
    # rule, could not resolve it, exited non-zero, and re-summoned the senior
    # auditor via OnFailure — who ran the test again. That is precisely the
    # amplification loop this test was written to prevent, with the test as the
    # cause: 100+ phantom packets and 4 concurrent phantom workers on
    # 2026-08-31..09-01.
    #
    # Unset (production) behaviour is byte-for-byte unchanged: the guard is
    # opt-in only. Placed after _pick_seat() so tests still exercise seat
    # selection, packet rendering and the claim path.
    if os.environ.get("ALERT_REPAIR_NO_SPAWN"):
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] NO-SPAWN alertname={joined} unit={unit} "
                f"seat={provider}/{model} reason={seat_reason} "
                f"packet={packet} suppressed_by=ALERT_REPAIR_NO_SPAWN\n"
            )
        print(f"[{utcnow()}] NO-SPAWN alertname={joined} unit={unit} "
              f"seat={provider}/{model} reason={seat_reason} "
              f"suppressed_by=ALERT_REPAIR_NO_SPAWN", file=sys.stderr)
        return 0

    env = os.environ.copy()
    env["PATH"] = f"{os.environ.get('HOME', '/home/nish')}/.local/bin:" + env.get("PATH", "")
    env["XDG_RUNTIME_DIR"] = "/run/user/1000"
    argv = [
        PI_SYSTEMD_RUN_BIN,
        "--unit", unit,
        "--stdin", str(packet),
        # CLOCK_RUN is 3600s (packet 11). --deadline drives RuntimeMaxSec so
        # the unit self-terminates at the run-hop budget instead of holding
        # fleet_chain_stalled{hop=run} open (fleet-ops#3328). pi-systemd-run's
        # default 90 min is the dispatch-plane orphan window, not this hop.
        "--deadline", "60",
        "--",
        "pi", "--print",
        "--provider", provider,
        "--model", model,
    ]
    try:
        r = subprocess.run(argv, env=env, check=False)
    except FileNotFoundError as exc:
        print(f"[{utcnow()}] ERROR: dispatcher not found: {exc}", file=sys.stderr)
        with LOG.open("a") as f:
            f.write(
                f"[{utcnow()}] ERROR alertname={joined} dispatch_failed={exc}\n"
            )
        return 1
    rc = r.returncode
    with LOG.open("a") as f:
        f.write(
            f"[{utcnow()}] DISPATCH alertname={joined} unit={unit} "
            f"seat={provider}/{model} reason={seat_reason} "
            f"packet={packet} rc={rc}\n"
        )
    print(f"[{utcnow()}] DISPATCH alertname={joined} unit={unit} "
          f"seat={provider}/{model} reason={seat_reason} rc={rc}",
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
