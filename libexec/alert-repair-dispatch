# fleet-completion-canary (packet 11, fleet-ops#468) — also must not
# spawn a real repair worker; the canary drives the drill by faking a
# DISPATCH line + a transient unit and watching the ladder.
# WasteRatioRising (fleet-ops#1211) is a TREND alert for Weekly Review.
# FleetSloSeatAvailSlowBurn (fleet-ops#2429) is the same WFR-input class:
# the seat_availability SLO is a slow-burn gauge that "feeds the weekly
# fleet review" (fleet-ops#1291). Repair is mechanism-impossible — seat
# compliance is operator/Nish-owned (credentials, quotas, seat health);
# no repair worker can raise it. The metric bug (compliance pinned at
# 1/13 regardless of real health) was fixed in PR #2377; the remaining
# signal (e.g. 0.846 < 0.9) is honest and clears only when seats recover
# + the 6h smoothing window flushes. Without the skip, Alertmanager's 6h
# repeat spawned a worker every cycle into the same unrepairable alert
# (live 2026-08-30 dispatches 07:00/11:57/17:57, each running, failing
# and escalating — the 'chain ran and failed to clear it' loop).
# severity=none is not enough: this dispatcher keys on alertname, not
# severity, so the name must live in SKIP_SET or a firing trend pages.
SKIP_SET = {"Watchdog", "FleetTestAlert", "CanaryDrill",
           "WasteRatioRising", "FleetSloSeatAvailSlowBurn",
           # WFR-input slow-burn SLO (fleet-ops#1291/2429): the main_green
           # burn-rate rule is a lagging integrator — it clears only when
           # ~30min of all-green samples flush the 30m window and ~6h flush
           # the 6h window, regardless of any repair worker. Repair is
           # mechanism-impossible (an alert-repair worker cannot rewind the
           # burn windows; the underlying CI red is owned by FleetMainRed).
           # Without the skip, Alertmanager's 6h repeat dispatched a worker
           # every cycle: 6+ dispatches in 3 days (2026-08-30..09-01), every
           # one Failed/RESOLVED with the same verdict, and each new chain
           # stalled at hop=verify until its deadline — the exact verify
           # stall fleet-ops#2672 was filed for (chain_stalled=1 at
           # 2026-09-01T15:23Z). Workers' own class-park (decision_class_until)
           # is the stopgap; this skip is the durable rail.
           "FleetSloMainGreenSlowBurn",
           # WFR-input trend regression (fleet-ops#1136): the WFR ratchets.
           # Trend alert (delta, not level) — repair mechanism-impossible; an
           # alert-repair worker cannot reverse a 24h delta in turn.
           "FleetSelfMaintenanceRegression",
           # WFR-input trend regression (fleet-ops#1136): the WFR ratchets.
           # Trend alert (delta, not level) — repair mechanism-impossible; an
           # alert-repair worker cannot reverse a 24h delta in turn.
           "FleetQualityChurnRegression",
           # WFR-input trend regression (fleet-ops#1136): the WFR ratchets.
           # Trend alert (delta, not level) — repair mechanism-impossible; an
           # alert-repair worker cannot reverse a 24h delta in turn.
           "FleetVerifiedMergeRegression",
           # fleet-ops#3367: consistency check, not a repairable alert. The
           # SLO compliance and green-map rollup both derive from the same
           # main_ci dict; a disagreement means a stale/frozen SLO gauge
           # (config parse failure, exporter crash mid-emit). An alert-repair
           # worker cannot fix a stale Prometheus gauge — the fix is in the
           # exporter code (emit instrumented=0 on config failure, which this
           # PR already ships). Skip to avoid a verify-stall loop.
           "FleetSloMainGreenGreenMapDisagree",
           # fleet-ops#3180: 24h lagging count / trend alert. The
           # fleet_escalations_24h metric is a rolling 24-hour gauge; a worker
           # cannot repair it because it clears only as the 24-hour window ages
           # out. Dispatching a repair worker re-summons the same unrepairable
           # alert every 6 hours. Skip it here so the issue worker can fix the
           # metric/rule at its own pace.
           "FleetEscalationStorm"}

