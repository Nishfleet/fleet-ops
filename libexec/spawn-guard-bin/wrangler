#!/usr/bin/env bash
# wrangler shim — below-agent spawn guard (fleet-ops#3126). Blocks direct
# `wrangler deploy` / `versions upload` on 0509 (P10-B item 4) so the
# vendor's own wrangler call cannot sneak past the extension hook.
if [[ "${FLEET_SPAWN_GUARD:-0}" == "1" ]]; then
    _sg_core="${FLEET_SPAWN_GUARD_CORE:-}"
    [[ -n "$_sg_core" && -f "$_sg_core" ]] || _sg_core="$HOME/.local/lib/pi-packet/spawn-guard-core.sh"
    if [[ -f "$_sg_core" ]]; then
        # shellcheck disable=SC1090
        . "$_sg_core"
        _sg_reason="$(spawn_guard_check_command "wrangler $*" "$PWD")"
        if [[ -n "$_sg_reason" ]]; then
            spawn_guard_block "$_sg_reason" "wrangler $*" "$PWD"
            exit 2
        fi
        unset _sg_reason
    fi
    unset _sg_core
fi
_sg_guard_dir="$(dirname "$(readlink -f "$0")")"
_sg_path_rest=""
for _sg_dir in ${PATH//:/ }; do
    [[ -n "$_sg_dir" && "$_sg_dir" != "$_sg_guard_dir" ]] && _sg_path_rest="${_sg_path_rest}${_sg_path_rest:+:}${_sg_dir}"
done
_sg_real="$(PATH="$_sg_path_rest" command -v wrangler 2>/dev/null)"
if [[ -z "$_sg_real" ]]; then
    echo "fleet-spawn-guard: cannot locate real wrangler" >&2
    exit 3
fi
exec "$_sg_real" "$@"