#!/usr/bin/env bash
# fleet-gap-closure-slo — per-cycle SLO snapshot from logs already produced
# (fleet-ops#180, step 4). Mechanical. No LLM.
#
# product_vs_control_plane_merge_ratio is a declared PLACEHOLDER filled by
# #153's THROUGHPUT line (visibility, not a cap). This script does not
# recompute that split.

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"

STATE_DIR="${GAP_LOOP_STATE_DIR:-/home/nish/workspaces/agent-state/gap-closure}"
REPO="${GAP_LOOP_REPO:-Nishfleet/fleet-ops}"
GH="${GAP_LOOP_GH:-gh}"
DISABLE="${GAP_LOOP_DISABLE:-0}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
QUALITY_JSON="${GAP_LOOP_QUALITY_JSON:-/home/nish/workspaces/agent-state/quality-slo/snapshot.json}"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
usage: fleet-gap-closure-slo
Print one JSON SLO snapshot on stdout. --help prints this and exits 0.
EOF
    exit 0
fi

now_iso() {
    if [ -n "${GAP_LOOP_FAKE_NOW:-}" ]; then printf '%s' "$GAP_LOOP_FAKE_NOW"
    else date -u +%Y-%m-%dT%H:%M:%SZ; fi
}

command -v jq >/dev/null 2>&1 || { echo '{"green":false,"error":"jq missing"}'; exit 2; }

if [ "$DISABLE" = "1" ]; then
    jq -c -n '{green:true, unmeasured:[], snapshot:{}, note:"disabled"}'
    exit 0
fi

drill_pass_rate="null"
if [ -f "$STATE_DIR/drill-results.json" ]; then
    drill_pass_rate="$(jq -r '
        if .all_pass == true then 1
        elif .all_pass == false then 0
        elif (.results // [] | length) > 0
        then ([.results[] | if .pass then 1 else 0 end] | add / length)
        else null end' "$STATE_DIR/drill-results.json" 2>/dev/null || echo "null")"
fi
# fleet-ops#375: the chain-e2e drill (whole-chain DONE-proof) writes its own
# per-hop results; fold its pass rate into the snapshot beside the loop drill.
chain_e2e_drill_pass_rate="null"
CHAIN_E2E_STATE_DIR="${CHAIN_E2E_STATE_DIR:-/home/nish/workspaces/agent-state/chain-e2e}"
if [ -f "$CHAIN_E2E_STATE_DIR/chain-e2e-drill-results.json" ]; then
    chain_e2e_drill_pass_rate="$(jq -r '
        if .all_pass == true then 1
        elif .all_pass == false then 0
        elif (.results // [] | length) > 0
        then ([.results[] | if .pass then 1 else 0 end] | add / length)
        else null end' "$CHAIN_E2E_STATE_DIR/chain-e2e-drill-results.json" 2>/dev/null || echo "null")"
    # A torn/empty results file must read as null (unknown), never as a
    # bogus green or a jq --argjson error.
    case "$chain_e2e_drill_pass_rate" in
        0|1|"null") : ;;
        *) chain_e2e_drill_pass_rate="null" ;;
    esac
fi

esc_to_nish="null"
if command -v "$GH" >/dev/null 2>&1; then
    esc_to_nish="$("$GH" issue list -R "$REPO" --state open --search "blocked-on:nish-decision" \
        --json number --jq length 2>/dev/null || echo "null")"
fi

# fleet-ops#5400: the old `--search "-blocked-on:nish-decision"` returned 0 on
# every repo — GitHub cannot negate a free-text phrase with a bare `-` — so
# pct_auto_repaired read a permanent 0.0 (the cycle-15 senior dissent named
# exactly that line). Count client-side instead: a closed gap-audit issue that
# never carried the agent-blocked label was repaired without escalation.
# --limit: the gh default (30) already truncates the closed board today.
pct_auto_repaired="null"
if command -v "$GH" >/dev/null 2>&1; then
    closed_json="$("$GH" issue list -R "$REPO" -l gap-audit --state closed \
        --limit 500 --json labels 2>/dev/null || echo '[]')"
    pct_auto_repaired="$(printf '%s' "$closed_json" | jq -r '
        if (type != "array") or (length == 0) then null
        else (([.[] | select([.labels[].name] | index("agent-blocked") | not)]
               | length) * 1000 / length | round / 10)
        end' 2>/dev/null || echo "null")"
fi

starvation_min="null"
starve_state="${GAP_LOOP_STARVATION_JSON:-${HOME}/.local/state/fleet-heartbeat/queue-starvation.json}"
if [ -f "$starve_state" ]; then
    starvation_min="$(jq -r '.starvation_minutes_24h // null' "$starve_state" 2>/dev/null || echo "null")"
    # A present-but-non-numeric read is unmeasured, not 0.
    case "$starvation_min" in ''|*[!0-9.]*) starvation_min="null" ;; esac
fi

# time_to_repair_per_class has no instrumented producer yet (the cycle-15
# senior dissent, fleet-ops#5400, names exactly this hole). Read a producer
# file when one exists; an absent or empty object is UNMEASURED and counts as
# budget exhausted below — never as a pass (fail closed, fleet-ops#4297).
ttr='{}'
TTR_JSON="${GAP_LOOP_TTR_JSON:-$STATE_DIR/time-to-repair.json}"
if [ -f "$TTR_JSON" ]; then
    ttr="$(jq -c 'if type == "object" then . else {} end' "$TTR_JSON" 2>/dev/null || echo '{}')"
fi

# Fill from #153's last THROUGHPUT line when present; otherwise the declared placeholder.
ratio='{"value":null,"source":"PLACEHOLDER:fleet-ops#153","note":"product-vs-control-plane merge ratio; filled by #153 throughput-split line; visibility not cap"}'
if [ -f "$TRIAGE" ]; then
    last_tp="$(grep -E '\[THROUGHPUT\]' "$TRIAGE" | tail -1 || true)"
    if [ -n "$last_tp" ]; then
        prod="$(printf '%s' "$last_tp" | sed -n 's/.*merged_product_PRs=\([0-9][0-9]*\).*/\1/p')"
        ctrl="$(printf '%s' "$last_tp" | sed -n 's/.*merged_control_plane_PRs=\([0-9][0-9]*\).*/\1/p')"
        if [ -n "$prod" ] && [ -n "$ctrl" ]; then
            ratio="$(jq -nc --argjson p "$prod" --argjson c "$ctrl" \
                '{value:{merged_product_PRs:$p, merged_control_plane_PRs:$c}, source:"fleet-ops#153", note:"read from last THROUGHPUT line; not recomputed"}')"
        fi
    fi
fi

quality='{"present":false}'
quality_green="true"
if [ -f "$QUALITY_JSON" ]; then
    quality="$(jq -c '{
        present:true,
        computed_at:(.computed_at // null),
        cycle_verdict:(.cycle.verdict // null),
        regressions:(.cycle.regressions // []),
        auto_revert_rate:(.metrics.auto_revert_rate.value // null),
        post_merge_defect_rate:(.metrics.post_merge_defect_rate.value // null),
        churn_pct:(.metrics.churn_pct.value // null),
        decision_overturn_rate:(.metrics.decision_overturn_rate.value // null),
        drill_pass_rate:(.metrics.drill_pass_rate.value // null),
        canary_regression_count:(.metrics.canary_regression_count.value // null),
        scout_futility_rate:(.metrics.scout_futility_rate.value // null),
        merge_count:(.metrics.merge_count.value // null),
        saturation_pct:(.metrics.saturation_pct.value // null)
    }' "$QUALITY_JSON" 2>/dev/null || echo '{"present":false}')"
    if jq -e '(.cycle_verdict // "") == "FAIL" or ((.regressions // []) | length) > 0' <<<"$quality" >/dev/null 2>&1; then
        quality_green="false"
    fi
fi

# fleet-ops#5400 / #4297: green is EARNED, not defaulted. Every required input
# must be measured AND passing; an unmeasured required field (null, empty, or
# unparseable) is budget-exhausted, never a pass. Before this, nulls fell
# through the checks untouched and green stayed true while
# queue_starvation_minutes was null and time_to_repair_per_class was {} — the
# fail-open the cycle-15 senior dissent refused to stake the audit floor on.
unmeasured='[]'
add_unmeasured() { unmeasured="$(printf '%s' "$unmeasured" | jq -c --arg f "$1" '. + [$f]')"; }

green="true"
if [ "$drill_pass_rate" != "null" ]; then
    awk_ok="$(awk -v d="$drill_pass_rate" 'BEGIN { print (d+0 >= 1) ? "true" : "false" }')"
    [ "$awk_ok" = "true" ] || green="false"
else
    add_unmeasured detector_drill_pass_rate; green="false"
fi
if [ "$chain_e2e_drill_pass_rate" != "null" ]; then
    awk_chain="$(awk -v d="$chain_e2e_drill_pass_rate" 'BEGIN { print (d+0 >= 1) ? "true" : "false" }')"
    [ "$awk_chain" = "true" ] || green="false"
else
    add_unmeasured chain_e2e_drill_pass_rate; green="false"
fi
# queue_starvation_minutes and time_to_repair_per_class carry no numeric pass
# bar anywhere in the specs or config — measured is the bar until the
# burn-math follow-up (#5125) defines remaining-budget thresholds.
if [ "$starvation_min" = "null" ]; then
    add_unmeasured queue_starvation_minutes; green="false"
fi
if [ "$(printf '%s' "$ttr" | jq 'length' 2>/dev/null || echo 0)" = "0" ]; then
    add_unmeasured time_to_repair_per_class; green="false"
fi
if [ "$pct_auto_repaired" = "null" ]; then
    add_unmeasured pct_auto_repaired; green="false"
elif [ "$(awk -v p="$pct_auto_repaired" 'BEGIN { print (p+0 > 0) ? "true" : "false" }')" != "true" ]; then
    # A measured 0% auto-repair rate is a failing self-repair SLO, not a pass.
    green="false"
fi
if [ "$quality_green" != "true" ]; then
    green="false"
fi

jq -c -n \
    --argjson green "$green" \
    --argjson unmeasured "$unmeasured" \
    --argjson drill_pass_rate "$drill_pass_rate" \
    --argjson chain_e2e_drill_pass_rate "$chain_e2e_drill_pass_rate" \
    --argjson escalations_to_nish "$esc_to_nish" \
    --argjson pct_auto_repaired "$pct_auto_repaired" \
    --argjson starvation_minutes "$starvation_min" \
    --argjson ttr "$ttr" \
    --argjson ratio "$ratio" \
    --argjson quality "$quality" \
    --arg now "$(now_iso)" \
    '{green:$green, unmeasured:$unmeasured, snapshot:{
        time_to_repair_per_class:$ttr,
        pct_auto_repaired:$pct_auto_repaired,
        queue_starvation_minutes:$starvation_minutes,
        detector_drill_pass_rate:$drill_pass_rate,
        chain_e2e_drill_pass_rate:$chain_e2e_drill_pass_rate,
        product_vs_control_plane_merge_ratio:$ratio,
        escalations_to_nish:$escalations_to_nish,
        quality:$quality,
        computed_at:$now}}'
