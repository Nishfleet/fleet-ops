#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# fleet-decisions-ledger — session-close lint (fleet-ops#514).
#
# Standing rule: before asking Nish ANY question, grep the decisions
# ledger. Re-asking a decided question is a failed run. Claude Code's
# PreToolUse hook only covers AskUserQuestion; this detector scans
# recent Pi session JSONL for ask-shaped assistant text / ask tools
# whose tokens already sit on a ledger line, without the 'ledger-checked'
# escape valve, and auto-files.
#
# No new scheduler. Run by fleet-heartbeat-tier1 every tick.
# Exit 0: no overlapping re-asks in the window. Exit 1: at least one
# (LOUD + auto-filed, deduped by signal: decisions-ledger/<slug>).
# Exit 1 also if the helper itself is broken (missing python/lib/ledger).
#
# Live #1138: systemd "should we read from the service" self-talk is not
# a vacation-window re-ask. Overlap ignores the ledger context-pointer
# and treats `from` as a stop word. Auto-filed issues close via
# observe-to-close (fleet-ops#650 shape) when the detector is green for
# that slug on a later tick — workers never `gh issue close`.
#
# Environment seams (tests override all of these):
#   FLEET_DECISIONS_LEDGER_SESSIONS   default ~/.pi/agent/sessions
#   FLEET_DECISIONS_LEDGER            default vault decisions-ledger.md
#   FLEET_DECISIONS_LEDGER_LIB        python helper
#   FLEET_DECISIONS_LEDGER_WINDOW_HOURS   default 24
#   FLEET_DECISIONS_LEDGER_GRACE_MINUTES  default 20 (skip in-flight sessions)
#   FLEET_DECISIONS_LEDGER_NOW        ISO timestamp
#   FLEET_DECISIONS_LEDGER_FILE_ISSUES    1 (default) / 0
#   FLEET_DECISIONS_LEDGER_CLOSE_ISSUES   1 (default) / 0
#   FLEET_DECISIONS_LEDGER_ISSUE_REPO     default Nishfleet/fleet-ops
#   FLEET_DECISIONS_LEDGER_CAP            default 5
#   FLEET_HEARTBEAT_TRIAGE
#   GH

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)

GH="${GH:-gh}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"
SESSIONS="${FLEET_DECISIONS_LEDGER_SESSIONS:-$HOME/.pi/agent/sessions}"
LEDGER="${FLEET_DECISIONS_LEDGER:-$HOME/workspaces/tooling/nish-vault/_system/shared-memory/decisions-ledger.md}"
LIB="${FLEET_DECISIONS_LEDGER_LIB:-$_canon_repo/lib/decisions-ledger.py}"
# fleet-ops#631: an explicit FLEET_DECISIONS_LEDGER_LIB pin (even to a missing
# path) MUST win over the installed fallback. Without this guard the bin
# silently falls back to ~/.local/lib/pi-packet/decisions-ledger.py, the
# missing-helper drill scans clean, and the "fails loud" test exits 0 — a
# broken helper looks healthy. The -z test below is the guard; do not remove.
if [[ -z "${FLEET_DECISIONS_LEDGER_LIB:-}" && ! -f "$LIB" && -f "${HOME}/.local/lib/pi-packet/decisions-ledger.py" ]]; then
    LIB="${HOME}/.local/lib/pi-packet/decisions-ledger.py"
fi
WINDOW_HOURS="${FLEET_DECISIONS_LEDGER_WINDOW_HOURS:-24}"
GRACE_MINUTES="${FLEET_DECISIONS_LEDGER_GRACE_MINUTES:-20}"
NOW_ISO="${FLEET_DECISIONS_LEDGER_NOW:-}"
FILE_ISSUES="${FLEET_DECISIONS_LEDGER_FILE_ISSUES:-1}"
CLOSE_ISSUES="${FLEET_DECISIONS_LEDGER_CLOSE_ISSUES:-1}"
ISSUE_REPO="${FLEET_DECISIONS_LEDGER_ISSUE_REPO:-Nishfleet/fleet-ops}"
CAP="${FLEET_DECISIONS_LEDGER_CAP:-5}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"

log() {
    printf '[%s] [fleet-decisions-ledger] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

if ! command -v python3 >/dev/null 2>&1; then
    loud "DECISIONS-LEDGER-BROKEN" "python3 missing — cannot lint sessions"
    exit 1
fi
if [[ ! -f "$LIB" ]]; then
    loud "DECISIONS-LEDGER-BROKEN" "helper missing at $LIB"
    exit 1
fi
if [[ ! -f "$LEDGER" ]]; then
    loud "DECISIONS-LEDGER-BROKEN" "ledger missing at $LEDGER"
    exit 1
fi

scan_args=(scan --root "$SESSIONS" --ledger "$LEDGER" --window-hours "$WINDOW_HOURS" --grace-minutes "$GRACE_MINUTES")
if [[ -n "$NOW_ISO" ]]; then
    scan_args+=(--now "$NOW_ISO")
fi

set +e
report=$(python3 "$LIB" "${scan_args[@]}" 2>/tmp/decisions-ledger.err)
scan_rc=$?
set -e

if [[ "$scan_rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$report"; then
    loud "DECISIONS-LEDGER-BROKEN" "helper produced no JSON (rc=$scan_rc) $(tr '\n' ' ' </tmp/decisions-ledger.err 2>/dev/null)"
    exit 1
fi

finding_count=$(jq '.findings | length' <<<"$report")
scanned=$(jq -r '.scanned' <<<"$report")
skipped_grace_slugs=$(jq -r '.skipped_grace_slugs[] // empty' <<<"$report")
log "scanned=$scanned old=$(jq -r .skipped_old <<<"$report") grace=$(jq -r .skipped_grace <<<"$report") findings=$finding_count ledger_lines=$(jq -r .ledger_lines <<<"$report")"

open_json="[]"
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    set +e
    open_json=$("$GH" issue list -R "$ISSUE_REPO" --state open --limit 200 --json number,body,comments 2>/dev/null)
    set -e
    open_json="${open_json:-[]}"
    if ! jq -e . >/dev/null 2>&1 <<<"$open_json"; then
        log "WARN: gh issue list produced no JSON"
        open_json="[]"
    fi
fi

filed=0
if [[ "$finding_count" != "0" ]]; then
    while IFS= read -r row; do
        [[ -n "$row" ]] || continue
        slug=$(jq -r '.slug' <<<"$row")
        snippet=$(jq -r '.snippet' <<<"$row")
        path=$(jq -r '.path' <<<"$row")
        ledger_line=$(jq -r '.ledger_line' <<<"$row")
        loud "DECISIONS-LEDGER-REASK" "decision=$slug path=$path snippet=$snippet"

        [[ "$FILE_ISSUES" == "1" ]] || continue
        [[ "$filed" -lt "$CAP" ]] || continue
        command -v "$GH" >/dev/null 2>&1 || continue

        signal="signal: decisions-ledger/${slug}"
        if printf '%s' "$open_json" | jq -e --arg s "$signal" \
            '[.[] | select((.body // "") | contains($s))] | length > 0' \
            >/dev/null 2>&1; then
            log "auto-file: $slug already open (deduped)"
            continue
        fi

        title="fix(decisions-ledger): $slug — decided question was re-asked"
        body="The session-close lint (fleet-ops#514, standing rule: check the decisions ledger before asking Nish) found an assistant ask whose tokens already sit on a ledger line, with no ledger-checked escape.

- session: \`$path\`
- ledger line: $ledger_line
- snippet: $snippet
- detector: bin/fleet-decisions-ledger (heartbeat tier1)

Do not close until the detector reports this clean on a real heartbeat tick (observe-to-close).

$signal"
        set +e
        created=$("$ISSUE_FILE" file -R "$ISSUE_REPO" --title "$title" --body "$body" 2>/dev/null)
        create_rc=$?
        set -e
        if [[ "$create_rc" -eq 0 && -n "$created" ]]; then
            log "auto-file: FILED $slug -> $created"
            filed=$((filed + 1))
        else
            log "auto-file: failed to file $slug (rc=$create_rc)"
        fi
    done < <(jq -c '.findings[]' <<<"$report")
fi

# Observe-to-close: comment resolved-at when a previously filed slug is no
# longer a finding; close on a later tick once that marker is already present.
# fleet-ops#1138 / #650. A slug still in skipped_grace_slugs is in-flight,
# not resolved.
observed=0
closed=0
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    finding_slugs=$(jq -r '.findings[].slug // empty' <<<"$report")
    while IFS= read -r irow; do
        [[ -n "$irow" ]] || continue
        num=$(jq -r '.number // empty' <<<"$irow")
        [[ -n "$num" && "$num" != "null" ]] || continue
        body=$(jq -r '.body // ""' <<<"$irow")
        signal=$(grep -oE 'signal: decisions-ledger/[a-z0-9-]+' <<<"$body" | head -1 || true)
        [[ -n "$signal" ]] || continue
        slug="${signal#signal: decisions-ledger/}"
        if printf '%s\n' "$finding_slugs" | grep -qxF -- "$slug"; then
            log "observe: $slug still a finding (#$num) — skip"
            continue
        fi
        if printf '%s\n' "$skipped_grace_slugs" | grep -qxF -- "$slug"; then
            log "observe: $slug skipped due to in-flight grace (#$num) — not resolved"
            continue
        fi
        blob=$(jq -r '"\(.body // "")\n\((.comments // []) | map(.body // "") | join("\n"))"' <<<"$irow")
        marker="resolved-at: ${signal}"
        if grep -Fq -- "$marker" <<<"$blob"; then
            if [[ "$CLOSE_ISSUES" == "1" ]] && [[ "$closed" -lt "$CAP" ]]; then
                set +e
                "$GH" issue close "$num" -R "$ISSUE_REPO" --reason completed >/tmp/decisions-ledger-close.err 2>&1
                close_rc=$?
                set -e
                if [[ "$close_rc" -eq 0 ]]; then
                    closed=$((closed + 1))
                    log "OBSERVE-CLOSED $slug -> #$num (resolved-at + no longer a finding)"
                else
                    log "WARN: failed to close #$num (rc=$close_rc) $(tr '\n' ' ' </tmp/decisions-ledger-close.err 2>/dev/null)"
                fi
            else
                log "dedup observe: #$num already carries $marker"
            fi
            continue
        fi
        [[ "$observed" -lt "$CAP" ]] || continue
        comment="${marker}

observed-at: $(date -u +%Y-%m-%dT%H:%M:%SZ)

Detector is green for this decision on a real heartbeat tick (fleet-ops#1138 observe-to-close)."
        set +e
        "$GH" issue comment "$num" -R "$ISSUE_REPO" --body "$comment" >/tmp/decisions-ledger-comment.err 2>&1
        comment_rc=$?
        set -e
        if [[ "$comment_rc" -eq 0 ]]; then
            observed=$((observed + 1))
            log "OBSERVED-RESOLVED $slug -> #$num"
        else
            log "WARN: failed to comment on #$num (rc=$comment_rc) $(tr '\n' ' ' </tmp/decisions-ledger-comment.err 2>/dev/null)"
        fi
    done < <(jq -c '.[]' <<<"$open_json")
    log "observe-to-close: commented=$observed closed=$closed"
fi

if [[ "$finding_count" == "0" ]]; then
    loud "DECISIONS-LEDGER-OK" "no ledger-overlapping re-asks in window (scanned=$scanned)"
    exit 0
fi

loud "DECISIONS-LEDGER-FAIL" "re-asks=$finding_count — a decided question was asked again; heartbeat tick will fail"
exit 1
