#!/usr/bin/env bash
# scout-futility-check — green-and-empty + provider-wall crash detector
# (fleet-ops#454, fleet-ops#2468).
#
# The supply chain already covers crash, dead timer, and dead heartbeat.
# The remaining holes are FUTILITY:
#   (a) pi-scout@ exits 0, files nothing, every supervision layer stays green,
#       and low-water skipped_fresh even blocks a retry. N consecutive green
#       runs with no net runway increase below the 12h buffer => escalate.
#   (b) pi-scout@ crashes (exit!=0) on a provider wall (503 overload,
#       429 quota/FreeUsageLimitError, INFERENCE_CAP_ERROR, out-of-credits,
#       opencode 404 "Provider returned error") every run on the same repo.
#       N consecutive wall-crashes are structurally equivalent to green-and-
#       empty futility — a bench/seat famine, not a work crash. The OnFailure
#       repair hop dispatches against the SAME walled lane and dies the same
#       way. Each crash writes a fresh STOP-REASON (fresh hash), so the
#       auditor pipeline re-summons a fresh SENIOR AUDITOR per crash on the
#       SAME root cause (proven 2026-08-31, fleet-ops#2468).
#
# This helper is the class prevention. It snapshots the agent-ready buffer
# and measured drain rate around each scout completion (ExecStartPre begin /
# ExecStopPost end on pi-scout@.service). For (a), N consecutive green runs
# with no net runway increase below the 12h buffer emit LOUD SCOUT-FUTILITY
# and auto-file an escalate-senior ticket. For (b), N consecutive non-zero
# exits whose journal lines are ALL provider-wall patterns emit the same
# LOUD SCOUT-FUTILITY / auto-file under signal: scout-futility/<repo>. The
# existing dedupe gate in unit-escalation-write then suppresses the repair-
# hop re-summon loop. Restarts cannot fix either class; senior judgment can.
#
# Always exit 0. A broken tracker must not fail the scout (that would
# trip OnFailure repair and hide the case). The `-` prefix on the unit's
# ExecStartPre/StopPost is belt-and-suspenders.
#
# Usage:
#   scout-futility-check begin <repo>
#   scout-futility-check end   <repo> [exit_code]
#
# Environment seams (tests):
#   GH                         default gh
#   FLEET_HEARTBEAT_TRIAGE     triage file
#   SCOUT_FUTILITY_STATE_DIR   per-repo state (default ~/.local/state/scout-futility)
#   SCOUT_FUTILITY_N           consecutive dry/wall runs before escalate (default 3)
#   SCOUT_FUTILITY_BUFFER_H    "below the 12h buffer" cap in banked-work hours (default 12)
#   SCOUT_FUTILITY_BUFFER      deprecated alias for SCOUT_FUTILITY_BUFFER_H
#   SCOUT_FUTILITY_WINDOW_H    drain-rate measurement window hours (default 6)
#   SCOUT_FUTILITY_REPO        repo to file tickets in (default Nishfleet/fleet-ops)
#   SCOUT_FUTILITY_FILE        1 (default) file issues; 0 skip gh create
#   SCOUT_FUTILITY_READY_COUNT override ready count (fixture scout)
#   SCOUT_FUTILITY_CLOSED_JSON closed-issue JSON fixture (file path or literal)
#   SCOUT_FUTILITY_WS_LIB      path to work-supply.sh (tests/development)
#   SCOUT_FUTILITY_PROM          textfile path (default
#                                /var/lib/prometheus/node-exporter/fleet-scout.prom)
#   JOURNALCTL                 journalctl binary path (default journalctl; tests stub)
#   EXIT_STATUS / SERVICE_RESULT  systemd ExecStopPost env when argv omits exit_code

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

GH="${GH:-gh}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
STATE_DIR="${SCOUT_FUTILITY_STATE_DIR:-$HOME/.local/state/scout-futility}"
N="${SCOUT_FUTILITY_N:-3}"
BUFFER_H="${SCOUT_FUTILITY_BUFFER_H:-${SCOUT_FUTILITY_BUFFER:-12}}"
WINDOW_H="${SCOUT_FUTILITY_WINDOW_H:-6}"
FILE_REPO="${SCOUT_FUTILITY_REPO:-Nishfleet/fleet-ops}"
FILE_ISSUES="${SCOUT_FUTILITY_FILE:-1}"
PROM="${SCOUT_FUTILITY_PROM:-/var/lib/prometheus/node-exporter/fleet-scout.prom}"
# Tests stub journalctl via a PATH-prepended shim; production uses the system
# binary. Empty JOURNALCTL falls back to journalctl on PATH.
JOURNALCTL="${JOURNALCTL:-journalctl}"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)
WS_LIB="${SCOUT_FUTILITY_WS_LIB:-$_canon_repo/lib/work-supply.sh}"
if [[ ! -f "$WS_LIB" ]]; then
    WS_LIB="$HOME/.local/lib/pi-packet/work-supply.sh"
fi
if [[ -f "$WS_LIB" ]]; then
    # shellcheck source=../lib/work-supply.sh source-path=SCRIPTDIR
    source "$WS_LIB"
fi

log() {
    printf '[%s] [scout-futility-check] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

usage() {
    echo "usage: scout-futility-check begin <repo> | end <repo> [exit_code]" >&2
}

# Fail-open: never take the scout down with us.
safe_exit() {
    exit 0
}

trap safe_exit EXIT

is_uint() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_repo() {
    case "${1:-}" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
        *) return 0 ;;
    esac
}

ready_count() {
    local repo="$1" n
    if [[ -n "${SCOUT_FUTILITY_READY_COUNT:-}" ]]; then
        printf '%s\n' "$SCOUT_FUTILITY_READY_COUNT"
        return 0
    fi
    n=$("$GH" issue list -R "Nishfleet/${repo}" -l agent-ready --state open \
        --json number --limit 200 --jq 'length' 2>/dev/null || true)
    printf '%s\n' "$n"
}

fetch_closed_json() {
    local repo="$1"
    if [[ -n "${SCOUT_FUTILITY_CLOSED_JSON:-}" ]]; then
        if [[ -f "$SCOUT_FUTILITY_CLOSED_JSON" ]]; then
            cat "$SCOUT_FUTILITY_CLOSED_JSON"
            return 0
        fi
        printf '%s\n' "$SCOUT_FUTILITY_CLOSED_JSON"
        return 0
    fi
    "$GH" issue list -R "Nishfleet/${repo}" -l agent-ready --state closed \
        --limit 100 --search 'sort:updated-desc' \
        --json number,closedAt 2>/dev/null || true
}

runway_hours() {
    local repo="$1" ready="$2" now_s="$3" closed_json closed window
    window="$WINDOW_H"
    is_uint "$window" || window=6
    is_uint "$ready" || { printf '0\n'; return 0; }
    is_uint "$now_s" || now_s=$(date -u +%s)
    closed_json=$(fetch_closed_json "$repo")
    if [[ -z "$closed_json" ]]; then
        closed=0
    elif type work_supply_closed_in_window >/dev/null 2>&1; then
        closed=$(work_supply_closed_in_window "$closed_json" "$window" "$now_s" 2>/dev/null || true)
        is_uint "$closed" || closed=0
    else
        closed=0
    fi
    if type work_supply_hours >/dev/null 2>&1; then
        work_supply_hours "$ready" "$closed" "$window"
    else
        printf '%s\n' "$ready"
    fi
}

state_path() {
    printf '%s/%s.state\n' "$STATE_DIR" "$1"
}

lock_path() {
    printf '%s/%s.lock\n' "$STATE_DIR" "$1"
}

read_field() {
    local file="$1" key="$2" line
    [[ -f "$file" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "${key}="*) printf '%s\n' "${line#"${key}"=}"; return 0 ;;
        esac
    done <"$file"
}

write_state() {
    local file="$1"
    shift
    local tmp
    tmp=$(mktemp "${file}.XXXXXX")
    {
        printf '# scout-futility state\n'
        printf '%s\n' "$@"
    } >"$tmp"
    mv -f "$tmp" "$file"
}

# fleet-ops#1277: last actual begin (ExecStartPre) per repo. ExecStopPost
# still runs when ExecCondition skipped the scout, so last_run_epoch is
# written on begin only. 0 means begin has never succeeded.
export_last_run() {
    local dir tmp file repo epoch
    dir=$(dirname "$PROM")
    mkdir -p "$dir" 2>/dev/null || {
        log "WARN: cannot mkdir $dir for scout last_run export"
        return 0
    }
    tmp=$(mktemp "$dir/.fleet-scout.XXXXXX" 2>/dev/null) || {
        log "WARN: cannot mktemp for scout last_run export"
        return 0
    }
    {
        printf '# HELP fleet_scout_last_run_seconds Epoch seconds of the last pi-scout begin (ExecStartPre) per repo. 0 means begin has never succeeded.\n'
        printf '# TYPE fleet_scout_last_run_seconds gauge\n'
        shopt -s nullglob
        for file in "$STATE_DIR"/*.state; do
            repo=$(basename "$file" .state)
            valid_repo "$repo" || continue
            epoch=$(read_field "$file" last_run_epoch)
            # 0 / missing = begin never succeeded. Exporting 0 makes
            # (time()-last_run)>28800 true immediately and re-fires
            # FleetScoutStale on an ExecCondition rest skip (fleet-ops
            # 2026-08-27T19:41Z). Omit instead; absent() covers none-begun.
            is_uint "$epoch" || continue
            [[ "$epoch" -gt 0 ]] || continue
            printf 'fleet_scout_last_run_seconds{repo="%s"} %s\n' "$repo" "$epoch"
        done
        shopt -u nullglob
    } >"$tmp"
    # node_exporter runs as prometheus; mktemp is 0600. 0644 or the
    # family is absent and FleetScoutStale fires (2026-08-27T19:41Z).
    chmod 0644 "$tmp" 2>/dev/null || {
        rm -f "$tmp"
        log "WARN: cannot chmod 0644 $tmp"
        return 0
    }
    if ! mv -f "$tmp" "$PROM" 2>/dev/null; then
        rm -f "$tmp"
        log "WARN: cannot write $PROM"
        return 0
    fi
    chmod 0644 "$PROM" 2>/dev/null || log "WARN: cannot chmod 0644 $PROM"
}

with_lock() {
    local repo="$1"
    local lock
    lock=$(lock_path "$repo")
    exec 9>"$lock"
    flock 9
}

signal_key() {
    printf 'signal: scout-futility/%s\n' "$1"
}

file_escalation() {
    local repo="$1" dry="$2" before="$3" after="$4"
    local marker title body_file existing
    marker=$(signal_key "$repo")
    if [[ "$FILE_ISSUES" != "1" ]]; then
        log "file skipped (SCOUT_FUTILITY_FILE=$FILE_ISSUES) $marker"
        return 0
    fi
    existing=$("$GH" issue list -R "$FILE_REPO" --state open --limit 100 \
        --json number,body 2>/dev/null \
        | jq -r --arg m "$marker" \
            '.[] | select((.body // "") | contains($m)) | .number' \
        | head -n 1 || true)
    if [[ -n "$existing" ]]; then
        log "dedup: open $FILE_REPO#$existing already carries $marker"
        return 0
    fi
    title="[escalate-senior] scout futility: Nishfleet/${repo} ran green ${dry} times with no runway increase"
    body_file=$(mktemp)
    cat >"$body_file" <<EOF
Scout futility (fleet-ops#454). \`pi-scout@${repo}\` completed green ${dry} times in a row with no net runway increase while the work buffer stayed below ${BUFFER_H} hours (the 12h banked-work cap). Supervision is green (timer, OnFailure repair, low-water skipped_fresh) so this loops forever without a human.

This is a judge, provider, or quality problem, not a crash. Do not restart the scout. Route to the senior-auditor panel.

## Evidence
- repo: Nishfleet/${repo}
- consecutive_dry: ${dry}
- runway before -> after: ${before}h -> ${after}h
- buffer_threshold: ${BUFFER_H}h
- N: ${N}

${marker}
EOF
    if "$ISSUE_FILE" file -R "$FILE_REPO" \
        --title "$title" \
        --body-file "$body_file" \
        --label escalate-senior \
        --label agent-ready >/dev/null 2>&1; then
        log "filed: $title"
    else
        log "WARN: gh issue create failed for $marker"
    fi
    rm -f "$body_file"
}

# --- provider-wall crash detection (fleet-ops#2468) ---
# Patterns that indicate a bench/provider wall, not a work crash:
#   - 503 overloaded_error (Anthropic-style provider overload)
#   - 429 + FreeUsageLimitError / quota_cap / out-of-credits
#   - INFERENCE_CAP_ERROR (the literal error name)
#   - 404 Provider returned error (opencode corpse pattern — the model
#     itself is gone, the provider returns 404)
# Matched against the last 10 error-priority journal lines of the failed
# pi-scout@<repo>.service unit. ALL non-empty error lines must match for the
# crash to count as wall-class (a stray non-wall error demotes the run to
# "non-wall crash" and lets the OnFailure repair path handle it normally).
PROVIDER_WALL_PATTERNS='overloaded_error|FreeUsageLimitError|quota_cap|INFERENCE_CAP_ERROR|out-of-credits|Provider returned error|Upstream model provider is temporarily unavailable'

# Return 0 if ALL non-empty error-priority journal lines for pi-scout@<repo>
# match a provider-wall pattern (i.e. the crash was a wall, not a work
# fault). Return 1 otherwise, including when the journal is unreadable
# (the safer default — leave non-wall crashes to OnFailure repair).
# Usage: detect_provider_wall <repo>
detect_provider_wall() {
    local repo="$1"
    local jlines unit="pi-scout@${repo}.service"
    local line matched
    if ! command -v "$JOURNALCTL" >/dev/null 2>&1 && [[ ! -x "$JOURNALCTL" ]]; then
        return 1
    fi
    # Last 50 lines (all priorities) — the provider wall error (503/429) is
    # printed by the pi script to stdout/stderr at info priority, not err.
    # The error may be far back if the run was long. Use -o cat to avoid
    # timestamp/host wrappers confusing the pattern match.
    jlines=$("$JOURNALCTL" --user -u "$unit" -n 50 --no-pager -o cat 2>/dev/null || true)
    [[ -n "$jlines" ]] || return 1
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"  # ltrim
        line="${line%"${line##*[![:space:]]}"}"  # rtrim
        [[ -z "$line" ]] && continue
        matched=0
        if grep -qE "$PROVIDER_WALL_PATTERNS" <<<"$line"; then
            matched=1
        fi
        [[ "$matched" == "1" ]] || return 1
    done <<<"$jlines"
    return 0
}

# File an escalate-senior ticket under the same signal key as the green-and-
# empty path (signal: scout-futility/<repo>), so the existing unit-escalation-
# write dedupe gate matches it (#2351 / #2054). Title + body name the wall-
# crash class so the auditor can see at a glance that this is a bench/seat
# famine, not a work fault.
file_wall_escalation() {
    local repo="$1" wall_count="$2"
    local marker title body_file existing
    marker=$(signal_key "$repo")
    if [[ "$FILE_ISSUES" != "1" ]]; then
        log "file skipped (SCOUT_FUTILITY_FILE=$FILE_ISSUES) $marker (wall)"
        return 0
    fi
    existing=$("$GH" issue list -R "$FILE_REPO" --state open --limit 100 \
        --json number,body 2>/dev/null \
        | jq -r --arg m "$marker" \
            '.[] | select((.body // "") | contains($m)) | .number' \
        | head -n 1 || true)
    if [[ -n "$existing" ]]; then
        log "dedup: open $FILE_REPO#$existing already carries $marker (wall)"
        return 0
    fi
    title="[escalate-senior] scout wall-crash loop: Nishfleet/${repo} died ${wall_count}x on provider wall (503/429/quota)"
    body_file=$(mktemp)
    cat >"$body_file" <<EOF
Provider-wall crash loop (fleet-ops#2468 / #2054). \`pi-scout@${repo}\` crashed ${wall_count} consecutive times on provider-wall errors (HTTP 503 overloaded_error, 429 FreeUsageLimitError, INFERENCE_CAP_ERROR, quota_cap, out-of-credits, opencode 404 "Provider returned error"). This is structurally equivalent to green-and-empty futility: a bench/seat famine, not a work crash.

The OnFailure repair hop (\`pi-scout-repair@<repo>\`) dispatches against the SAME walled lane and dies the same way. Each crash writes a fresh STOP-REASON (fresh timestamp = fresh dispatch hash), so without this ticket's signal key the auditor pipeline summons a fresh SENIOR AUDITOR per crash on the SAME root cause. This ticket's marker \`signal: scout-futility/${repo}\` falls through the existing #2351 dedupe gate and suppresses the re-summon loop.

Non-wall crashes (assertions, OOM, real work bugs) fall through to the normal OnFailure repair path, which IS designed for those.

## Evidence
- repo: Nishfleet/${repo}
- consecutive_wall: ${wall_count}
- N: ${N}
- exit code: non-zero (provider wall death)

${marker}
EOF
    if "$ISSUE_FILE" file -R "$FILE_REPO" \
        --title "$title" \
        --body-file "$body_file" \
        --label escalate-senior \
        --label agent-ready >/dev/null 2>&1; then
        log "filed: $title"
    else
        log "WARN: gh issue create failed for $marker (wall)"
    fi
    rm -f "$body_file"
}
cmd_begin() {
    local repo="$1" before before_hours file now_s
    valid_repo "$repo" || { log "begin: invalid repo '$repo'"; return 0; }
    is_uint "$N" || { log "begin: SCOUT_FUTILITY_N not a uint: $N"; return 0; }
    mkdir -p "$STATE_DIR"
    with_lock "$repo"
    before=$(ready_count "$repo")
    file=$(state_path "$repo")
    if ! is_uint "$before"; then
        log "begin: $repo ready count not numeric ('$before') — skip snapshot"
        return 0
    fi
    now_s=$(date -u +%s)
    before_hours=$(runway_hours "$repo" "$before" "$now_s")
    is_uint "$before_hours" || before_hours="$before"
    write_state "$file" \
        "before=${before}" \
        "before_hours=${before_hours}" \
        "begin_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "consecutive_dry=$(read_field "$file" consecutive_dry)" \
        "consecutive_wall=$(read_field "$file" consecutive_wall)" \
        "last_after=$(read_field "$file" last_after)" \
        "last_after_hours=$(read_field "$file" last_after_hours)" \
        "last_exit=$(read_field "$file" last_exit)" \
        "last_run_epoch=${now_s}" \
        "updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    export_last_run
    log "begin: $repo ready_before=$before runway_before=${before_hours}h last_run_epoch=$now_s"
}

resolve_exit() {
    local arg="${1:-}"
    if is_uint "$arg"; then
        printf '%s\n' "$arg"
        return 0
    fi
    if [[ "${SERVICE_RESULT:-}" == "success" ]]; then
        printf '0\n'
        return 0
    fi
    if is_uint "${EXIT_STATUS:-}"; then
        printf '%s\n' "$EXIT_STATUS"
        return 0
    fi
    # Unknown result: do not treat as green.
    printf '1\n'
}

cmd_end() {
    local repo="$1"
    local exit_code
    exit_code=$(resolve_exit "${2:-}")
    local file before before_hours after after_hours dry next_dry wall_count next_wall last_run now_s
    valid_repo "$repo" || { log "end: invalid repo '$repo'"; return 0; }
    is_uint "$N" || { log "end: SCOUT_FUTILITY_N not a uint: $N"; return 0; }
    is_uint "$BUFFER_H" || { log "end: SCOUT_FUTILITY_BUFFER_H not a uint: $BUFFER_H"; return 0; }
    [[ "$N" -ge 1 ]] || { log "end: SCOUT_FUTILITY_N must be >= 1"; return 0; }
    mkdir -p "$STATE_DIR"
    with_lock "$repo"
    file=$(state_path "$repo")
    before=$(read_field "$file" before)
    before_hours=$(read_field "$file" before_hours)
    if ! is_uint "$before"; then
        # fleet-ops#1277: missing/unreadable snapshot is absence-of-evidence,
        # not futility. Seed a snapshot and exit 0 (success-run). Do not
        # increment consecutive_dry: ExecStopPost still runs when
        # ExecCondition skipped the scout, so this is not a completed tick.
        after=$(ready_count "$repo")
        is_uint "$after" || after=""
        now_s=$(date -u +%s)
        after_hours=$(runway_hours "$repo" "$after" "$now_s")
        is_uint "$after_hours" || after_hours="$after"
        dry=$(read_field "$file" consecutive_dry)
        is_uint "$dry" || dry=0
        wall_count=$(read_field "$file" consecutive_wall)
        is_uint "$wall_count" || wall_count=0
        last_run=$(read_field "$file" last_run_epoch)
        is_uint "$last_run" || last_run=0
        if ! is_uint "$after"; then
            after=""
            after_hours=""
        fi
        write_state "$file" \
            "before=" \
            "before_hours=" \
            "begin_at=" \
            "consecutive_dry=${dry}" \
            "consecutive_wall=${wall_count}" \
            "last_after=${after}" \
            "last_after_hours=${after_hours}" \
            "last_exit=${exit_code}" \
            "last_run_epoch=${last_run}" \
            "updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        export_last_run
        log "end: $repo missing begin snapshot — created snapshot (success-run); not counted as dry consecutive_dry=$dry consecutive_wall=$wall_count last_run_epoch=$last_run runway_after=${after_hours}h"
        return 0
    fi
    after=$(ready_count "$repo")
    if ! is_uint "$after"; then
        log "end: $repo ready count not numeric ('$after') — skip"
        return 0
    fi
    now_s=$(date -u +%s)
    after_hours=$(runway_hours "$repo" "$after" "$now_s")
    is_uint "$after_hours" || after_hours="$after"
    dry=$(read_field "$file" consecutive_dry)
    is_uint "$dry" || dry=0
    wall_count=$(read_field "$file" consecutive_wall)
    is_uint "$wall_count" || wall_count=0
    next_dry=$dry
    next_wall=$wall_count
    if ! is_uint "$before_hours"; then
        before_hours=$before
    fi
    if [[ "$exit_code" != "0" ]]; then
        # Crash path (fleet-ops#2468): classify the crash by scanning the
        # scout unit's error-priority journal. ALL non-empty error lines
        # matching a provider-wall pattern => wall-class. Increment the
        # consecutive_wall counter and escalate at N (same signal key as the
        # green-and-empty path so #2351 dedupe gate suppresses the repair-
        # hop re-summon). Any non-wall error resets consecutive_wall to 0
        # so a transient assertion / OOM does NOT burn the auditor budget.
        if detect_provider_wall "$repo"; then
            next_wall=$((wall_count + 1))
            log "end: $repo exit=$exit_code wall-crash #${next_wall} — leave consecutive_dry=$dry, consecutive_wall=${next_wall}"
            if [[ "$next_wall" -ge "$N" ]]; then
                loud "SCOUT-FUTILITY" "repo=Nishfleet/${repo} consecutive_wall=${next_wall} (N=${N}) provider-wall crash loop (503/429/quota/INFERENCE_CAP_ERROR). same structural famine class as green-and-empty; escalate-senior, do not restart"
                file_wall_escalation "$repo" "$next_wall"
            fi
        else
            next_wall=0
            log "end: $repo exit=$exit_code (not green, not provider-wall) — leave consecutive_dry=$dry, consecutive_wall=0"
        fi
    elif [[ "$after_hours" -ge "$BUFFER_H" ]]; then
        next_dry=0
        next_wall=0
        log "end: $repo runway_after=${after_hours}h >= buffer=${BUFFER_H}h — reset consecutive_dry + consecutive_wall"
    elif [[ "$after_hours" -gt "$before_hours" ]]; then
        next_dry=0
        next_wall=0
        log "end: $repo runway ${before_hours} -> ${after_hours}h (net increase) — reset consecutive_dry + consecutive_wall"
    else
        next_dry=$((dry + 1))
        log "end: $repo runway ${before_hours} -> ${after_hours}h (no net increase, below buffer=${BUFFER_H}h) consecutive_dry=$next_dry"
        if [[ "$next_dry" -ge "$N" ]]; then
            loud "SCOUT-FUTILITY" "repo=Nishfleet/${repo} consecutive_dry=${next_dry} (N=${N}) runway ${before_hours}->${after_hours}h below buffer=${BUFFER_H}h. green scout filed nothing; escalate-senior, do not restart"
            file_escalation "$repo" "$next_dry" "$before_hours" "$after_hours"
        fi
    fi
    last_run=$(read_field "$file" last_run_epoch)
    is_uint "$last_run" || last_run=0
    write_state "$file" \
        "before=" \
        "before_hours=" \
        "begin_at=" \
        "consecutive_dry=${next_dry}" \
        "consecutive_wall=${next_wall}" \
        "last_before=${before}" \
        "last_before_hours=${before_hours}" \
        "last_after=${after}" \
        "last_after_hours=${after_hours}" \
        "last_exit=${exit_code}" \
        "last_run_epoch=${last_run}" \
        "updated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    export_last_run
}

[[ $# -ge 2 ]] || { usage; safe_exit; }

case "$1" in
    begin) cmd_begin "$2" ;;
    end)   cmd_end "$2" "${3:-}" ;;
    *)     usage ;;
esac
