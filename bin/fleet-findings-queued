#!/usr/bin/env bash
# fleet-findings-queued — session-close lint (fleet-ops#515, fleet-ops#602).
#
# Standing rule: every finding gets queued, automatically. A finding named
# in chat and nowhere else is an incomplete run. This detector scans recent
# session JSONL — Pi sessions, Cursor agent-transcripts, and Claude project
# sessions — for the named ask-phrases ("want me to file", "say the word")
# in assistant text and auto-files when the same session never queued
# (gh issue create / routed-by-standing-order / issue URL).
#
# No new scheduler. Run by fleet-heartbeat-tier1 every tick.
# Exit 0: no unqueued offers in the window. Exit 1: at least one
# (LOUD + auto-filed, deduped by signal: findings-queued/<slug>).
# Exit 1 also if the helper itself is broken (missing python/lib).
#
# The standing rule binds every agent on Mac and VPS, so every reachable
# transcript root is scanned with the same predicates (fleet-ops#602):
# Pi sessions, Cursor agent-transcripts, and Claude project sessions.
# Set any root env var to "" to skip that source (tests do this for
# hermeticity).
#
# Environment seams (tests override all of these):
#   FLEET_FINDINGS_QUEUED_SESSIONS       default ~/.pi/agent/sessions (Pi)
#   FLEET_FINDINGS_QUEUED_CURSOR_ROOTS   default ~/.cursor/projects (Cursor
#                                        agent-transcripts are nested under
#                                        per-project dirs)
#   FLEET_FINDINGS_QUEUED_CLAUDE_ROOTS   default ~/.claude/projects (Claude
#                                        session jsonl live in per-project dirs)
#   FLEET_FINDINGS_QUEUED_LIB        python helper
#   FLEET_FINDINGS_QUEUED_WINDOW_HOURS   default 24
#   FLEET_FINDINGS_QUEUED_GRACE_MINUTES  default 20 (skip in-flight sessions)
#   FLEET_FINDINGS_QUEUED_NOW        ISO timestamp
#   FLEET_FINDINGS_QUEUED_FILE_ISSUES    1 (default) / 0
#   FLEET_FINDINGS_QUEUED_ISSUE_REPO     default Nishfleet/fleet-ops
#   FLEET_FINDINGS_QUEUED_CAP            default 5
#   FLEET_HEARTBEAT_TRIAGE
#   GH

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)

GH="${GH:-gh}"
# Use `-` (not `:-`) so an explicit empty value disables a root (hermeticity
# for tests); only an unset var falls back to the live VPS default.
SESSIONS="${FLEET_FINDINGS_QUEUED_SESSIONS-$HOME/.pi/agent/sessions}"
CURSOR_ROOTS="${FLEET_FINDINGS_QUEUED_CURSOR_ROOTS-$HOME/.cursor/projects}"
CLAUDE_ROOTS="${FLEET_FINDINGS_QUEUED_CLAUDE_ROOTS-$HOME/.claude/projects}"
LIB="${FLEET_FINDINGS_QUEUED_LIB:-$_canon_repo/lib/findings-queued.py}"
if [[ -z "${FLEET_FINDINGS_QUEUED_LIB:-}" && ! -f "$LIB" && -f "${HOME}/.local/lib/pi-packet/findings-queued.py" ]]; then
    LIB="${HOME}/.local/lib/pi-packet/findings-queued.py"
fi
WINDOW_HOURS="${FLEET_FINDINGS_QUEUED_WINDOW_HOURS:-24}"
GRACE_MINUTES="${FLEET_FINDINGS_QUEUED_GRACE_MINUTES:-20}"
NOW_ISO="${FLEET_FINDINGS_QUEUED_NOW:-}"
FILE_ISSUES="${FLEET_FINDINGS_QUEUED_FILE_ISSUES:-1}"
ISSUE_REPO="${FLEET_FINDINGS_QUEUED_ISSUE_REPO:-Nishfleet/fleet-ops}"
CAP="${FLEET_FINDINGS_QUEUED_CAP:-5}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"

log() {
    printf '[%s] [fleet-findings-queued] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

if ! command -v python3 >/dev/null 2>&1; then
    loud "FINDINGS-QUEUED-BROKEN" "python3 missing — cannot lint sessions"
    exit 1
fi
if [[ ! -f "$LIB" ]]; then
    loud "FINDINGS-QUEUED-BROKEN" "helper missing at $LIB"
    exit 1
fi

scan_args=(scan --window-hours "$WINDOW_HOURS" --grace-minutes "$GRACE_MINUTES")
if [[ -n "$NOW_ISO" ]]; then
    scan_args+=(--now "$NOW_ISO")
fi

# Pi sessions (flat root).
[[ -n "$SESSIONS" ]] && scan_args+=(--root "$SESSIONS")

# Cursor agent-transcripts are nested under per-project dirs:
#   ~/.cursor/projects/<project>/agent-transcripts/<uuid>/<uuid>.jsonl
if [[ -n "$CURSOR_ROOTS" ]]; then
    while IFS= read -r d; do
        [[ -n "$d" ]] && scan_args+=(--root "$d")
    done < <(find "$CURSOR_ROOTS" -type d -name agent-transcripts 2>/dev/null)
fi

# Claude session jsonl live directly in per-project dirs:
#   ~/.claude/projects/<project>/<uuid>.jsonl
if [[ -n "$CLAUDE_ROOTS" ]]; then
    while IFS= read -r d; do
        [[ -n "$d" ]] && scan_args+=(--root "$d")
    done < <(find "$CLAUDE_ROOTS" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
fi

set +e
report=$(python3 "$LIB" "${scan_args[@]}" 2>/tmp/findings-queued.err)
scan_rc=$?
set -e

if [[ "$scan_rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$report"; then
    loud "FINDINGS-QUEUED-BROKEN" "helper produced no JSON (rc=$scan_rc) $(tr '\n' ' ' </tmp/findings-queued.err 2>/dev/null)"
    exit 1
fi

finding_count=$(jq '.findings | length' <<<"$report")
scanned=$(jq -r '.scanned' <<<"$report")
log "scanned=$scanned old=$(jq -r .skipped_old <<<"$report") grace=$(jq -r .skipped_grace <<<"$report") findings=$finding_count"

if [[ "$finding_count" == "0" ]]; then
    loud "FINDINGS-QUEUED-OK" "no unqueued offers in window (scanned=$scanned)"
    exit 0
fi

open_json="[]"
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    set +e
    open_json=$("$GH" issue list -R "$ISSUE_REPO" --state open --limit 200 --json number,body 2>/dev/null)
    set -e
    open_json="${open_json:-[]}"
fi

filed=0
while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    slug=$(jq -r '.slug' <<<"$row")
    snippet=$(jq -r '.snippet' <<<"$row")
    path=$(jq -r '.path' <<<"$row")
    loud "FINDINGS-UNQUEUED" "session=$slug path=$path snippet=$snippet"

    [[ "$FILE_ISSUES" == "1" ]] || continue
    [[ "$filed" -lt "$CAP" ]] || continue
    command -v "$GH" >/dev/null 2>&1 || continue

    signal="signal: findings-queued/${slug}"
    if printf '%s' "$open_json" | jq -e --arg s "$signal" \
        '[.[] | select((.body // "") | contains($s))] | length > 0' \
        >/dev/null 2>&1; then
        log "auto-file: $slug already open (deduped)"
        continue
    fi

    title="fix(findings-queued): $slug — finding named in chat, never filed"
    body="The session-close lint (fleet-ops#515, standing rule: every finding gets queued) found an assistant ask to file/queue with no queue action in the same Pi session.

- session: \`$path\`
- snippet: $snippet
- detector: bin/fleet-findings-queued (heartbeat tier1)

Do not close until the detector reports this clean on a real heartbeat tick (observe-to-close).

$signal"
    set +e
    created=$("$GH" issue create -R "$ISSUE_REPO" --title "$title" --body "$body" 2>/dev/null)
    create_rc=$?
    set -e
    if [[ "$create_rc" -eq 0 && -n "$created" ]]; then
        log "auto-file: FILED $slug -> $created"
        filed=$((filed + 1))
    else
        log "auto-file: failed to file $slug (rc=$create_rc)"
    fi
done < <(jq -c '.findings[]' <<<"$report")

loud "FINDINGS-QUEUED-FAIL" "unqueued offers=$finding_count — a finding named in chat was never filed; heartbeat tick will fail"
exit 1
