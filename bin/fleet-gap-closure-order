#!/usr/bin/env bash
# fleet-gap-closure-order — reorder ready issues for intake (fleet-ops#180).
#
# stdin: JSON array of {number, labels:[{name}]}
# stdout: issue numbers, one per line.
#
# precedence=loop (default): gap-audit first, then by number.
# precedence=product: gap-audit last, then by number.

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
usage: fleet-gap-closure-order
Reorder agent-ready JSON on stdin. --help prints this and exits 0.
EOF
    exit 0
fi

PREC_FILE="${GAP_LOOP_PRECEDENCE_FILE:-/home/nish/workspaces/agent-state/gap-closure/precedence}"
prec="loop"
if [ -f "$PREC_FILE" ]; then
    prec="$(tr -d '[:space:]' <"$PREC_FILE")"
fi
[ -n "$prec" ] || prec="loop"

json="$(cat)"
[ -n "$json" ] || exit 0

if [ "$prec" = "product" ]; then
    printf '%s' "$json" | jq -r '
      sort_by(
        (([.labels[]?.name] | index("gap-audit")) != null),
        .number
      ) | .[].number'
else
    printf '%s' "$json" | jq -r '
      sort_by(
        (([.labels[]?.name] | index("gap-audit")) == null),
        .number
      ) | .[].number'
fi
