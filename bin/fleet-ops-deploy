#!/usr/bin/env bash
# fleet-ops-deploy — merge-to-live install for fleet-ops (fleet-ops#149).
#
# Pulls origin/main into the deploy checkout, runs install.sh (user-scope)
# then install.sh --system (fleet-ops#1247: /etc/prometheus/fleet_rules.yml
# and the other /etc/... MANIFEST entries), reloads prometheus when it is
# active, converges the declared per-repo set, then runs the drift canary.
# Dirty tracked files or a non-fast-forward checkout block the update (no reset, no
# stash). A named non-main branch whose HEAD is already on a remote is
# recovered onto main (fleet-ops#5222). Unique unpushed commits on a named
# branch still block (fleet-ops#477): merge --ff-only would rewind that
# auditor/hotfix branch onto origin/main. Any remaining divergence fails loud
# (exit 1).
#   --dry-run  recover/refuse the checkout then skip install (fleet-ops#5222)
#
# Environment:
#   FLEET_OPS_CHECKOUT          deploy checkout (default: this script's repo)
#   FLEET_OPS_DEPLOY_AUDIT_LOG  audit log (default: ~/.local/state/fleet-heartbeat/deploy-audit.log)
#   FLEET_OPS_TRIAGE            heartbeat triage file for LOUD lines
#   FLEET_OPS_DRIFT_BIN         drift canary (default: $HOME/.local/bin/fleet-ops-drift)
#   FLEET_OPS_EXPECTED_ORIGIN_URL  expected origin fetch URL (default: fleet-ops;
#                                  tests point it at a local bare remote)
#   FLEET_DEPLOY_ORIGIN_REPAIR_PROM / FLEET_DEPLOY_ORIGIN_REPAIR_LOG
#                                  origin-remote repair counter + 24h history
#                                  (fleet-ops#5301)
set -euo pipefail

export HOME="${HOME:-/home/nish}"

DEPLOY_DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DEPLOY_DRY_RUN=1 ;;
        --help|-h)
            printf '%s\n' \
                "usage: fleet-ops-deploy [--dry-run]" \
                "  --dry-run  assert/recover the deploy-clone checkout, skip install"
            exit 0
            ;;
    esac
done

self=$(readlink -f "$0")
DEPLOY_CHECKOUT="${FLEET_OPS_CHECKOUT:-$(cd "$(dirname "$self")/.." && pwd)}"
DEPLOY_AUDIT_LOG="${FLEET_OPS_DEPLOY_AUDIT_LOG:-$HOME/.local/state/fleet-heartbeat/deploy-audit.log}"
TRIAGE="${FLEET_OPS_TRIAGE:-${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}}"
CANARY="${FLEET_OPS_DRIFT_BIN:-$HOME/.local/bin/fleet-ops-drift}"
AGENT_STATE="${FLEET_OPS_AGENT_STATE:-/home/nish/workspaces/agent-state}"

mkdir -p "$(dirname "$DEPLOY_AUDIT_LOG")"

log() {
    printf '[%s] [fleet-ops-deploy] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

deploy_audit() {
    local unit="$1" action="$2" why="$3"
    printf '%s %s %s actor=heartbeat-deploy why=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$unit" "$action" "$why" >> "$DEPLOY_AUDIT_LOG"
}

# fleet-ops#477: DEPLOY-BLOCKED exits before the drift canary, so file here
# when the clone is on a named non-main branch. Dedup lives in the canary.
auto_file_off_main() {
    local why="$1"
    local py="$DEPLOY_CHECKOUT/bin/fleet-ops-drift.py"
    if [ ! -f "$py" ]; then
        log "WARN: off-main auto-file skipped (missing $py)"
        return 0
    fi
    python3 "$py" --file-off-main "$why" \
        || log "WARN: off-main auto-file failed"
}

# fleet-ops#2725: the deploy-clone on main but dirty/diverged blocks
# merge-to-live with the same DEPLOY-BLOCKED line as off-main, but the
# off-main auto-file does not fire (the branch IS main). Without this the
# block sat silent for 30+ min until the blind-audit caught it. File the
# class from the deploy step so it is queued the moment the block starts.
auto_file_deploy_blocked_main() {
    local why="$1"
    local py="$DEPLOY_CHECKOUT/bin/fleet-ops-drift.py"
    if [ ! -f "$py" ]; then
        log "WARN: deploy-blocked-on-main auto-file skipped (missing $py)"
        return 0
    fi
    python3 "$py" --file-deploy-blocked-main "$why" \
        || log "WARN: deploy-blocked-on-main auto-file failed"
}

# fleet-ops#3634: detect whether any live process other than this deploy run
# has its cwd inside the deploy checkout. If one does, the clone is actively
# in use and must not be reset out from under it — keep the LOUD block.
# Otherwise the clone is abandoned and we can self-rescue.
# fleet-ops#5222: also capture pid + cmdline so DEPLOY-BLOCKED names the
# holder instead of only saying a process exists.
CLONE_HOLDER_PID=""
CLONE_HOLDER_CMDLINE=""
clone_held_as_cwd() {
    local clone="$1"
    local canon
    canon=$(readlink -f "$clone" 2>/dev/null || printf '%s' "$clone")
    local self=$$
    local p pid tgt cmd
    CLONE_HOLDER_PID=""
    CLONE_HOLDER_CMDLINE=""
    for p in /proc/[0-9]*/cwd; do
        [ -e "$p" ] || continue
        tgt=$(readlink "$p" 2>/dev/null) || continue
        case "$tgt" in
            "$canon"|"$canon"/*)
                pid=${p#/proc/}; pid=${pid%/cwd}
                [ "$pid" = "$self" ] && continue
                cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
                cmd=$(printf '%s' "$cmd" | sed 's/[[:space:]]*$//')
                cmd=${cmd:0:200}
                CLONE_HOLDER_PID="$pid"
                CLONE_HOLDER_CMDLINE="$cmd"
                return 0
                ;;
        esac
    done
    return 1
}

format_clone_holder() {
    if clone_held_as_cwd "$DEPLOY_CHECKOUT"; then
        printf 'live process holds the clone as cwd: pid=%s cmdline=%s' \
            "$CLONE_HOLDER_PID" "$CLONE_HOLDER_CMDLINE"
    else
        printf 'no live process holds the clone as cwd'
    fi
}

# fleet-ops#5222: HEAD is "fully pushed" when it is an ancestor of at least
# one origin remote-tracking ref. A local branch name that does not exist
# on the remote still counts if the commit itself is on origin/main (or
# any other origin/*).
head_is_on_remote() {
    local head r
    head=$(git -C "$DEPLOY_CHECKOUT" rev-parse HEAD 2>/dev/null) || return 1
    [ -n "$head" ] || return 1
    while IFS= read -r r; do
        [ -n "$r" ] || continue
        if git -C "$DEPLOY_CHECKOUT" merge-base --is-ancestor "$head" "$r" >/dev/null 2>&1; then
            return 0
        fi
    done < <(git -C "$DEPLOY_CHECKOUT" for-each-ref --format='%(refname)' refs/remotes/origin)
    return 1
}

# fleet-ops#3634: self-rescue an abandoned deploy clone. The merge-to-live
# gate blocks when the clone is on a non-main branch and/or has dirty tracked
# or untracked files. Historically that block sat until a human/orchestrator
# rescued by hand (2 incidents 2026-09-05). When no live process holds the
# clone as its cwd, the clone is abandoned: commit the WIP onto the current
# branch (or a rescue/<ts> branch when detached/on main), push it to origin
# as backup, snapshot the patch under agent-state/deploy-clone-rescue-<ts>/,
# log one audit line, then reset the clone to a clean origin/main and
# continue the deploy in the same tick.
rescue_deploy_clone() {
    local why="$1"
    local ts
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    local rescue_dir="${FLEET_OPS_RESCUE_DIR:-$AGENT_STATE/deploy-clone-rescue-$ts}"
    local rescue_branch="$branch"

    # Detached HEAD or on main with dirty files: park the WIP on a rescue
    # branch rather than polluting origin/main.
    if [ -z "$rescue_branch" ] || [ "$rescue_branch" = "main" ]; then
        rescue_branch="rescue/$ts"
        if ! git -C "$DEPLOY_CHECKOUT" checkout -q -b "$rescue_branch" 2>/dev/null; then
            loud "DEPLOY-RESCUE" "could not create rescue branch $rescue_branch"
            return 1
        fi
    fi

    # Snapshot the WIP before committing so the patch survives even if the
    # commit/push fails.
    mkdir -p "$rescue_dir"
    git -C "$DEPLOY_CHECKOUT" diff HEAD > "$rescue_dir/tracked.patch" 2>/dev/null || true
    local untracked
    untracked=$(git -C "$DEPLOY_CHECKOUT" ls-files --others --exclude-standard 2>/dev/null || true)
    if [ -n "$untracked" ]; then
        mkdir -p "$rescue_dir/untracked"
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            [ -f "$DEPLOY_CHECKOUT/$f" ] || continue
            mkdir -p "$rescue_dir/untracked/$(dirname "$f")"
            cp -a "$DEPLOY_CHECKOUT/$f" "$rescue_dir/untracked/$f"
        done <<< "$untracked"
    fi

    # Commit the WIP onto the rescue branch. A clean-but-diverged or clean
    # named branch has nothing to commit — its tip is still backed up below.
    git -C "$DEPLOY_CHECKOUT" add -A
    if ! git -C "$DEPLOY_CHECKOUT" diff --cached --quiet; then
        if ! git -C "$DEPLOY_CHECKOUT" commit -q -m "deploy-clone rescue WIP $ts (fleet-ops#3634)" 2>/dev/null; then
            loud "DEPLOY-RESCUE" "WIP commit failed on $rescue_branch"
            return 1
        fi
    fi
    local newhead
    newhead=$(git -C "$DEPLOY_CHECKOUT" rev-parse HEAD)
    printf '%s\n%s\n' "$rescue_branch" "$newhead" > "$rescue_dir/branch"

    # Push the branch to origin as backup. A push failure is not fatal — the
    # patch is already saved locally under $rescue_dir.
    if ! git -C "$DEPLOY_CHECKOUT" push -q origin "$rescue_branch" 2>/dev/null; then
        loud "DEPLOY-RESCUE" "push of $rescue_branch to origin failed; WIP saved locally at $rescue_dir"
    fi

    # Reset the clone to a clean origin/main and continue the deploy.
    git -C "$DEPLOY_CHECKOUT" checkout -q -B main origin/main 2>/dev/null \
        || git -C "$DEPLOY_CHECKOUT" checkout -q main 2>/dev/null
    git -C "$DEPLOY_CHECKOUT" reset -q --hard origin/main
    git -C "$DEPLOY_CHECKOUT" clean -fd

    log "rescued deploy clone: WIP on $rescue_branch ($newhead), patch at $rescue_dir, reset to origin/main"
    deploy_audit "fleet-ops" "rescue" "$why -> $rescue_branch $newhead patch=$rescue_dir"
    return 0
}

# fleet-ops#5016: the origin fetch URL must name the fleet-ops repo. On
# 2026-09-10T16:16Z this clone's origin fetch URL was
# https://github.com/Nishfleet/0509.git (pushurl correctly fleet-ops), so
# `origin/main` tracked 0509's main. The deploy tick reset the live install
# source to 0509's tree: bin/, lib/ and install.sh went away and every
# ~/.local/bin + ~/.local/lib/pi-packet helper symlink into the clone dangled.
# Nothing asserted the remote URL, and the drift canary compares origin/main to
# the checkout, so the two moved together and the drift looked like a normal
# fast-forward. Refuse BEFORE the fetch / rescue / reset / install whenever the
# origin fetch URL is not the fleet-ops repo URL: never reset a checkout to an
# origin/main the remote URL does not own.
EXPECTED_ORIGIN_URL="${FLEET_OPS_EXPECTED_ORIGIN_URL:-https://github.com/Nishfleet/fleet-ops.git}"

# Normalize a git remote URL to host/owner/repo for comparison, so
# https://github.com/Nishfleet/fleet-ops.git, git@github.com:Nishfleet/fleet-ops
# and ssh://git@github.com/Nishfleet/fleet-ops.git all compare equal.
normalize_origin_url() {
    local u="${1:-}"
    u="${u#ssh://}"
    u="${u#https://}"
    u="${u#http://}"
    u="${u#git://}"
    u="${u#git@}"
    u="${u/:/\/}"
    u="${u%.git}"
    u="${u%/}"
    printf '%s\n' "${u,,}"
}

# Empty output = the origin fetch URL is the expected one. Anything else is
# the URL (or 'origin remote is missing') to repair (fleet-ops#5301).
origin_remote_to_repair() {
    local url got want
    if ! url=$(git -C "$DEPLOY_CHECKOUT" remote get-url origin 2>/dev/null); then
        printf 'origin remote is missing'
        return 0
    fi
    got=$(normalize_origin_url "$url")
    want=$(normalize_origin_url "$EXPECTED_ORIGIN_URL")
    if [ "$got" != "$want" ]; then
        printf '%s' "$url"
    fi
    return 0
}

# fleet-ops#5301: repair-and-continue. The clone is disposable and the
# correct URL is a constant, so an automatic set-url is safe: set origin
# back to the expected URL (or `remote add` when missing), drop any extra
# remote carrying the expected URL under another name, then proceed with
# the deploy in the SAME tick. Counter + 24h-rate alert via the shared
# .prom (same metric name as fleet-deploy-check).
repair_origin_remote() {
    local was="$1" name rurl prom hist now prev n
    if [ "$was" = "origin remote is missing" ]; then
        git -C "$DEPLOY_CHECKOUT" remote add origin "$EXPECTED_ORIGIN_URL" 2>/dev/null || true
    else
        git -C "$DEPLOY_CHECKOUT" remote set-url origin "$EXPECTED_ORIGIN_URL"
    fi
    while IFS=$'\t' read -r name rurl; do
        [ "$name" = "origin" ] && continue
        [ -z "$name" ] && continue
        if [ "$(normalize_origin_url "$rurl")" = "$(normalize_origin_url "$EXPECTED_ORIGIN_URL")" ]; then
            git -C "$DEPLOY_CHECKOUT" remote remove "$name" 2>/dev/null || true
        fi
    done < <(git -C "$DEPLOY_CHECKOUT" remote -v 2>/dev/null | awk -F'\t' '$2 ~ / \(fetch\)$/ { sub(/ \(fetch\)$/, "", $2); print $1 "\t" $2 }')
    loud "DEPLOY-ORIGIN-REMOTE" \
        "repaired at $DEPLOY_CHECKOUT (was $was) — origin set back to $EXPECTED_ORIGIN_URL, deploy proceeds (fleet-ops#5301)"
    deploy_audit "fleet-ops" "origin-remote-repaired" "$was"
    prom="${FLEET_DEPLOY_ORIGIN_REPAIR_PROM:-/var/lib/prometheus/node-exporter/fleet-deploy-check.prom}"
    hist="${FLEET_DEPLOY_ORIGIN_REPAIR_LOG:-${AGENT_STATE}/deploy-clone-origin-repairs.log}"
    now=$(date -u +%s)
    mkdir -p "$(dirname "$prom")" "$(dirname "$hist")" 2>/dev/null || true
    printf '%s\n' "$now" >>"$hist" 2>/dev/null || true
    n=$(awk -v cutoff=$((now - 86400)) '$1 >= cutoff' "$hist" 2>/dev/null | wc -l)
    if [ "$n" -gt 2 ]; then
        loud "DEPLOY-ORIGIN-REMOTE" \
            "origin repaired ${n}x in 24h (>2) — something is rewriting the deploy clone's origin URL; find the writer (fleet-ops#5301)"
    fi
    prev=0
    if [ -f "$prom" ]; then
        prev=$(awk '$1 ~ /^fleet_deploy_origin_remote_repaired_total$/ { print $2; exit }' "$prom" 2>/dev/null) || prev=0
        prev="${prev:-0}"
    fi
    if {
        printf '# HELP fleet_deploy_origin_remote_repaired_total Deploy-clone origin fetch URL repairs (fleet-ops#5301).\n'
        printf '# TYPE fleet_deploy_origin_remote_repaired_total counter\n'
        printf 'fleet_deploy_origin_remote_repaired_total %d\n' "$((prev + 1))"
    } >"$prom.tmp" 2>/dev/null; then
        mv "$prom.tmp" "$prom" 2>/dev/null || true
    fi
}

log "starting: checkout=$DEPLOY_CHECKOUT"

# fleet-ops#370: the paper-over drop-in must die even when merge is later
# blocked (dirty/non-ff). install.sh also removes it on a successful install.
dropin="${HOME}/.config/systemd/user/fleet-heartbeat.service.d/10-deploy-checkout.conf"
if [ -e "$dropin" ] || [ -L "$dropin" ]; then
    rm -f "$dropin"
    log "removed paper-over drop-in: $dropin (fleet-ops#370)"
    systemctl --user daemon-reload >/dev/null 2>&1 \
        || log "WARN: daemon-reload after drop-in removal failed"
fi

