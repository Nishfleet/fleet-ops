# fleet-ops#4502: orphaned drop-in dir for the deleted fleet-loop@ unit
# (hand-placed control-plane machinery; the unit file, any timer, and the
# gate/fleet-gate + fleet-scout-run + gate-retry.sh it referenced are all
# gone). install.sh also removes it on a successful install; remove here too
# so a dirty/non-ff deploy still clears the invisible leftover.
dropin_dir="${HOME}/.config/systemd/user/fleet-loop@.service.d"
if [ -d "$dropin_dir" ]; then
    rm -rf "$dropin_dir"
    log "removed orphaned fleet-loop@.service.d drop-in dir: $dropin_dir (fleet-ops#4502)"
    systemctl --user daemon-reload >/dev/null 2>&1 \
        || log "WARN: daemon-reload after fleet-loop drop-in removal failed"
fi

# The same drop-in pointed FLEET_OPS_DRIFT_BIN at a GC-able worktree. Env
# for this tick is already set; refusing the path stops the self-compare.
canary_resolved=$(readlink -f "$CANARY" 2>/dev/null || printf '%s' "$CANARY")
canary_is_worktree=0
case "$CANARY" in */agent-worktrees/*) canary_is_worktree=1 ;; esac
case "$canary_resolved" in */agent-worktrees/*) canary_is_worktree=1 ;; esac
if [ "$canary_is_worktree" = 1 ]; then
    loud "DEPLOY-DRIFT-BIN-VOLATILE" \
        "FLEET_OPS_DRIFT_BIN is a GC-able worktree path ($CANARY); use $HOME/.local/bin/fleet-ops-drift (fleet-ops#370)"
    deploy_audit "fleet-ops" "drift-bin-volatile" "$CANARY"
    exit 1
fi

# fleet-ops#463: also refuse a canary that resolves to a non-canonical
# workspaces tree (e.g. the pre-rewrite products/fleet-ops worktree-parent,
# or an auditor worktree that does not live under agent-worktrees). The
# installed $HOME/.local/bin/fleet-ops-drift must resolve to the canonical
# deploy-clone.
if [ "${FLEET_OPS_ALLOW_NONCANONICAL:-}" != 1 ]; then
    ws_root="${FLEET_OPS_WORKSPACES_ROOT:-/home/nish/workspaces}"
    canon="${FLEET_OPS_CANONICAL_CHECKOUT:-$ws_root/tooling/fleet-ops-deploy-clone}"
    got=$(readlink -f "$canary_resolved" 2>/dev/null || printf '%s\n' "$canary_resolved")
    want=$(readlink -f "$canon" 2>/dev/null || printf '%s\n' "$canon")
    root=$(readlink -f "$ws_root" 2>/dev/null || printf '%s\n' "$ws_root")
    canary_noncanonical=0
    if [ "$got" != "$want" ]; then
        case "$got" in
            "$want"/*) : ;;
            "$root"|"$root"/*) canary_noncanonical=1 ;;
        esac
    fi
    if [ "$canary_noncanonical" = 1 ]; then
        loud "DEPLOY-DRIFT-BIN-NONCANONICAL" \
            "FLEET_OPS_DRIFT_BIN $CANARY (resolved $got) is not under the canonical checkout $want (fleet-ops#463)"
        deploy_audit "fleet-ops" "drift-bin-noncanonical" "$CANARY -> $got"
        exit 1
    fi
fi

# Worktrees carry a .git FILE (gitdir pointer), not a directory. `[ ! -d .git ]`
# false-negatives on a linked worktree and turns every heartbeat tick red
# (fleet-ops#313, auto-reverted twice). rev-parse --git-dir accepts both shapes.
if ! git -C "$DEPLOY_CHECKOUT" rev-parse --git-dir >/dev/null 2>&1; then
    loud "DEPLOY-CHECKOUT-MISSING" "no git checkout at $DEPLOY_CHECKOUT"
    exit 1
fi

# fleet-ops#176: the heartbeat pin is not enough if FLEET_OPS_CHECKOUT is
# overridden to a hotfix worktree. Refuse deploy from any workspaces path
# that is not the canonical checkout. Tests use /tmp checkouts.
if [ "${FLEET_OPS_ALLOW_NONCANONICAL:-}" != 1 ]; then
    ws_root="${FLEET_OPS_WORKSPACES_ROOT:-/home/nish/workspaces}"
    canon="${FLEET_OPS_CANONICAL_CHECKOUT:-$ws_root/tooling/fleet-ops-deploy-clone}"
    got=$(readlink -f "$DEPLOY_CHECKOUT")
    want=$(readlink -f "$canon" 2>/dev/null || printf '%s\n' "$canon")
    root=$(readlink -f "$ws_root" 2>/dev/null || printf '%s\n' "$ws_root")
    if [ "$got" != "$want" ]; then
        case "$got" in
            "$root"|"$root"/*)
                loud "DEPLOY-NONCANONICAL" \
                    "refusing deploy from $got; canonical checkout is $want (fleet-ops#176)"
                deploy_audit "fleet-ops" "deploy-noncanonical" "$got"
                exit 1
                ;;
        esac
    fi
fi

# fleet-ops#5301: repair the origin fetch URL before anything is fetched,
# rescued, reset or installed (replacing the fleet-ops#5016 refuse). A
# foreign URL means origin/main is another repo's main; the URL is a
# constant, so set it back and proceed in the same tick.
remote_problem=$(origin_remote_to_repair)
if [ -n "$remote_problem" ]; then
    repair_origin_remote "$remote_problem"
fi

if ! git -C "$DEPLOY_CHECKOUT" fetch origin >/dev/null 2>&1; then
    loud "DEPLOY-FETCH" "git fetch origin failed at $DEPLOY_CHECKOUT"
    exit 1
fi

ahead=0
ahead=$(git -C "$DEPLOY_CHECKOUT" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)

dirty=""
if ! dirty=$(git -C "$DEPLOY_CHECKOUT" status --porcelain --untracked-files=no 2>/dev/null); then
    loud "DEPLOY-STATUS" "git status failed at $DEPLOY_CHECKOUT"
    exit 1
fi

untracked=""
if ! untracked=$(git -C "$DEPLOY_CHECKOUT" ls-files --others --exclude-standard 2>/dev/null); then
    loud "DEPLOY-STATUS" "git ls-files failed at $DEPLOY_CHECKOUT"
    exit 1
fi

nonff=0
if ! git -C "$DEPLOY_CHECKOUT" merge-base --is-ancestor HEAD origin/main >/dev/null 2>&1; then
    nonff=1
fi

reasons=()
[ -n "$dirty" ] && reasons+=("dirty tracked files")
[ -n "$untracked" ] && reasons+=("untracked files")
[ "$nonff" = 1 ] && reasons+=("checkout not an ancestor of origin/main (hot-patch/diverged)")
branch=""
branch=$(git -C "$DEPLOY_CHECKOUT" symbolic-ref --short HEAD 2>/dev/null || true)
# fleet-ops#5222: a clean named branch whose HEAD is already on a remote is
# not a workspace. Check out main (no reset, no clean) even if a process
# holds the clone as cwd — the work is already pushed. Unique unpushed
# commits are refused in place; never discard them via rescue/reset.
if [ -n "$branch" ] && [ "$branch" != "main" ]; then
    if [ -z "$dirty" ] && head_is_on_remote; then
        if git -C "$DEPLOY_CHECKOUT" checkout -q main 2>/dev/null \
            || git -C "$DEPLOY_CHECKOUT" checkout -q -B main origin/main 2>/dev/null; then
            log "recovered deploy clone from $branch to main (HEAD was an ancestor of a remote ref; no reset, no clean; fleet-ops#5222)"
            deploy_audit "fleet-ops" "off-main-recovered" "$branch -> main"
            branch="main"
            ahead=$(git -C "$DEPLOY_CHECKOUT" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
            dirty=""
            dirty=$(git -C "$DEPLOY_CHECKOUT" status --porcelain --untracked-files=no 2>/dev/null || true)
            untracked=$(git -C "$DEPLOY_CHECKOUT" ls-files --others --exclude-standard 2>/dev/null || true)
            nonff=0
            if ! git -C "$DEPLOY_CHECKOUT" merge-base --is-ancestor HEAD origin/main >/dev/null 2>&1; then
                nonff=1
            fi
            reasons=()
            [ -n "$dirty" ] && reasons+=("dirty tracked files")
            [ -n "$untracked" ] && reasons+=("untracked files")
            [ "$nonff" = 1 ] && reasons+=("checkout not an ancestor of origin/main (hot-patch/diverged)")
        fi
    elif ! head_is_on_remote; then
        why="checkout on '$branch' not main (fleet-ops#477); HEAD is not an ancestor of any origin ref (unpushed)"
        auto_file_off_main "$why"
        loud "DEPLOY-BLOCKED" "merge-to-live blocked at $DEPLOY_CHECKOUT: $why ($(format_clone_holder))"
        deploy_audit "fleet-ops" "deploy-blocked" "$why"
        exit 1
    fi
fi
if [ -n "$branch" ] && [ "$branch" != "main" ]; then
    reasons+=("checkout on '$branch' not main (fleet-ops#477)")
fi
if [ "${#reasons[@]}" -gt 0 ]; then
    why=$(printf '%s; ' "${reasons[@]}")
    why=${why%; }
    # fleet-ops#3634: if no live process holds the clone as its cwd, the
    # clone is abandoned — self-rescue instead of blocking. Keep the LOUD
    # block only when a live process is actively working inside the clone.
    if clone_held_as_cwd "$DEPLOY_CHECKOUT"; then
        if [ -n "$branch" ] && [ "$branch" != "main" ]; then
            auto_file_off_main "$why"
        else
            # fleet-ops#2725: on main but dirty/diverged — file the distinct
            # deploy-blocked-on-main class so it does not sit silent until the
            # blind-audit catches it 30+ min later.
            auto_file_deploy_blocked_main "$why"
        fi
        loud "DEPLOY-BLOCKED" "merge-to-live blocked at $DEPLOY_CHECKOUT: $why (live process holds the clone as cwd: pid=$CLONE_HOLDER_PID cmdline=$CLONE_HOLDER_CMDLINE)"
        deploy_audit "fleet-ops" "deploy-blocked" "$why"
        exit 1
    fi
    if ! rescue_deploy_clone "$why"; then
        # Rescue failed — fall back to the LOUD block so the block is never
        # silent.
        if [ -n "$branch" ] && [ "$branch" != "main" ]; then
            auto_file_off_main "$why"
        else
            auto_file_deploy_blocked_main "$why"
        fi
        loud "DEPLOY-BLOCKED" "merge-to-live blocked at $DEPLOY_CHECKOUT: $why (rescue failed; $(format_clone_holder))"
        deploy_audit "fleet-ops" "deploy-blocked" "$why"
        exit 1
    fi
    # Recompute state after the rescue: the clone is now clean on origin/main.
    ahead=0
    dirty=""
    untracked=""
    nonff=0
    branch="main"
fi

if [ "${ahead:-0}" -gt 0 ]; then
    if ! git -C "$DEPLOY_CHECKOUT" merge --ff-only origin/main >/dev/null 2>&1; then
        loud "DEPLOY-MERGE" "git merge --ff-only origin/main failed at $DEPLOY_CHECKOUT"
        exit 1
    fi
    newhead=$(git -C "$DEPLOY_CHECKOUT" rev-parse --short HEAD)
    log "checkout merged origin/main -> $newhead"
    deploy_audit "fleet-ops" "merge" "origin/main to $newhead"
else
    log "checkout up to date"
fi

if [ "$DEPLOY_DRY_RUN" = 1 ]; then
    log "dry-run: checkout recovered/verified; skipping install (fleet-ops#5222)"
    deploy_audit "fleet-ops" "dry-run" "skip-install"
    exit 0
fi

# fleet-ops#1247: default install.sh skips /etc/... MANIFEST entries
# (config/fleet_rules.yml -> /etc/prometheus/fleet_rules.yml). Without
# --system, ConsoleLying sits in git and never loads.
run_install() {
    local label="$1"
    shift
    local out rc=0
    if out=$("$DEPLOY_CHECKOUT/install.sh" "$@" 2>&1); then
        rc=0
    else
        rc=$?
        loud "DEPLOY-INSTALL" "$label failed (rc=$rc): $out"
        deploy_audit "fleet-ops" "install-failed" "$label rc=$rc"
        exit 1
    fi
    log "ran $label (rc=$rc)"
    if [ -n "$out" ]; then
        log "$label output: $out"
    fi
}

run_install "install.sh"

# fleet-ops#1235: --storage.tsdb.retention.time is a start-time flag, so a
# changed /etc/default/prometheus (the prometheus.service EnvironmentFile)
# needs `systemctl restart`, not a HUP. Snapshot the live env file BEFORE
# install.sh --system so we can detect the change and pick restart vs reload.
PROM_ENV_FILE="${PROM_ENV_FILE:-/etc/default/prometheus}"
prom_env_before=""
if [ -f "$PROM_ENV_FILE" ]; then
    prom_env_before=$(sha256sum "$PROM_ENV_FILE" 2>/dev/null | awk '{print $1}')
fi

run_install "install.sh --system" --system
deploy_audit "fleet-ops" "install" "ok"

prom_env_after=""
if [ -f "$PROM_ENV_FILE" ]; then
    prom_env_after=$(sha256sum "$PROM_ENV_FILE" 2>/dev/null | awk '{print $1}')
fi
prom_env_changed=0
if [ -n "$prom_env_before" ] && [ "$prom_env_before" != "$prom_env_after" ]; then
    prom_env_changed=1
elif [ -z "$prom_env_before" ] && [ -n "$prom_env_after" ]; then
    prom_env_changed=1
fi

# Prometheus reads rule_files into RAM; install -D does not HUP it.
# Skip when the unit is not active (CI, the offline deploy test — a live
# `sudo -n systemctl reload` would ignore PATH and HUP the real daemon).
prom_state=$(systemctl is-active prometheus 2>/dev/null || true)
if [ "$prom_state" = "active" ]; then
    if [ "$prom_env_changed" = 1 ]; then
        # fleet-ops#1235: a start-time flag changed. Check disk headroom on
        # the TSDB filesystem before restarting — a longer retention with no
        # free space would fill the disk and crash prometheus. Fail loud and
        # leave the unit running on its old (already-loaded) config rather
        # than restarting into a full disk.
        headroom_gb="${PROM_RETENTION_HEADROOM_GB:-2}"
        tsdb_fs="${PROM_TSDB_FS:-/var/lib/prometheus}"
        free_kb=$(df -P --output=avail "$tsdb_fs" 2>/dev/null | awk 'NR==2{print $1}')
        if [ -z "$free_kb" ]; then
            loud "DEPLOY-PROMETHEUS-HEADROOM" \
                "could not read free space on $tsdb_fs; refusing to restart prometheus with a changed retention"
            deploy_audit "fleet-ops" "prometheus-headroom-unknown" "df failed"
            exit 1
        fi
        free_gb=$(( free_kb / 1024 / 1024 ))
        if [ "$free_gb" -lt "$headroom_gb" ]; then
            loud "DEPLOY-PROMETHEUS-HEADROOM" \
                "only ${free_gb}G free on $tsdb_fs (threshold ${headroom_gb}G); refusing to restart prometheus with a longer retention"
            deploy_audit "fleet-ops" "prometheus-headroom-low" "${free_gb}G < ${headroom_gb}G"
            exit 1
        fi
        log "prometheus env file changed; headroom OK (${free_gb}G >= ${headroom_gb}G); restarting"
        if ! sudo -n systemctl restart prometheus; then
            loud "DEPLOY-PROMETHEUS-RESTART" \
                "systemctl restart prometheus failed after /etc/default/prometheus change"
            deploy_audit "fleet-ops" "prometheus-restart-failed" "restart"
            exit 1
        fi
        log "prometheus restarted (retention flag applied)"
        deploy_audit "fleet-ops" "prometheus-restart" "ok env-changed"
    else
        if ! sudo -n systemctl reload prometheus; then
            loud "DEPLOY-PROMETHEUS-RELOAD" \
                "systemctl reload prometheus failed after install.sh --system"
            deploy_audit "fleet-ops" "prometheus-reload-failed" "reload"
            exit 1
        fi
        log "prometheus reloaded"
        deploy_audit "fleet-ops" "prometheus-reload" "ok"
    fi
fi

recon="$DEPLOY_CHECKOUT/bin/intake-reconcile"
if [ ! -x "$recon" ]; then
    loud "DEPLOY-RECONCILE" "intake-reconcile missing at $recon"
    deploy_audit "fleet-ops" "intake-reconcile-missing" "missing"
    exit 1
fi
recon_out=""
if recon_out=$(INTAKE_RECONCILE_INTAKE_JSON="$DEPLOY_CHECKOUT/config/intake-repos.json" "$recon" 2>&1); then
    if [ -n "$recon_out" ]; then
        log "intake-reconcile output: $recon_out"
    fi
    deploy_audit "fleet-ops" "intake-reconcile" "ok"
else
    recon_rc=$?
    loud "DEPLOY-RECONCILE" "intake-reconcile failed (rc=$recon_rc): $recon_out"
    deploy_audit "fleet-ops" "intake-reconcile-failed" "rc=$recon_rc"
    # Canary below is the pass/fail on live unit state. A gh blip must not
    # skip install, but it is never silent.
fi

if [ ! -x "$CANARY" ]; then
    loud "DEPLOY-CANARY" "drift canary missing at $CANARY after install.sh"
    deploy_audit "fleet-ops" "canary-missing" "$CANARY"
    exit 1
fi

canary_out=""
canary_rc=0
set +e
canary_out=$(FLEET_OPS_CHECKOUT="$DEPLOY_CHECKOUT" FLEET_OPS_AUDIT_LOG="$DEPLOY_AUDIT_LOG" FLEET_OPS_TRIAGE="$TRIAGE" "$CANARY" 2>&1)
canary_rc=$?
set -e
if [ "$canary_rc" -ne 0 ]; then
    if [ -n "$canary_out" ]; then
        log "drift canary failed (rc=$canary_rc): $canary_out"
    else
        log "drift canary failed (rc=$canary_rc): <no output>"
    fi
    deploy_audit "fleet-ops" "drift-failed" "rc=$canary_rc"
    exit 1
fi
if [ -n "$canary_out" ]; then
    log "drift canary output: $canary_out"
fi

log "complete"
deploy_audit "fleet-ops" "drift-ok" "checkout-and-installed-state-match-main"
exit 0
