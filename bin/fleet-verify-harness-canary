#!/usr/bin/env bash
# fleet-verify-harness-canary — product repos must ship a verify skill
# (fleet-ops#524).
#
# Standing rule (Nish, 2026-08-20): every product repo gets ONE checked-in
# verification skill at `.claude/skills/verify-<app>/SKILL.md` with
# LAUNCH / DOCTOR / DRIVE / EVIDENCE / CLEANUP plus a features/ map.
#
# STEP 0: ran `gh api --help`, `gh search code --help`,
# `gh issue list --help`, `gh issue close --help`,
# `fleet-exec-review-canary --help`, `research-before-build-check --help`.
# gh api can GET a single contents path; gh search code can find
# SKILL.md files (default --limit 30). gh issue list default --limit is
# 30 (max 1000); gh issue close has --comment and --reason. Neither gh
# primitive joins intake, checks the five required headings, requires a
# features/ map, fail-louds enrolled products, auto-files, or
# observe-to-closes leftover missing-harness tickets. fleet-repo-visibility-canary
# classifies product vs sink for *visibility*, not harness files. pstack
# create-verification-skill *generates* a skill; it does not watch that
# every product repo still has one. opencode-m3-catalog-canary
# observe-to-closes a different marker. This canary is that missing watch:
#   1. GATE (fail-loud, exit 1): an enrolled intake product whose HEAD
#      lacks a valid verify-* skill.
#   2. DETECTOR (auto-file, tick stays green): a deferred product with
#      the same gap. Cap per tick. Deduped on the marker.
#   3. FAIL-LOUD on a broken watch: intake/config missing or unparseable,
#      enrolled checkout missing / not a git repo.
#   4. OBSERVE-TO-CLOSE: when inspect_product returns ok, close EVERY
#      open issue carrying `fleet-verify-harness-canary: missing-harness
#      <name>` (leftover-duplicate drain for fleet-ops#812 / #999).
#      Open-list uses --limit 1000; --limit 50 missed #812 on a 200-issue
#      desk and filed leftover #999.
#
# Why not wrap an existing tool:
#   0. Read gh api --help, gh search code --help, gh issue list --help,
#      gh issue close --help, fleet-exec-review-canary --help,
#      research-before-build-check --help. fleet-repo-visibility-canary
#      has no --help (running it performs the visibility watch).
#   1. Those flags do not already do this (no intake join, no heading
#      check, no auto-file, no enrolled fail-loud, no leftover drain).
#   2. pstack create-verification-skill is a generator, not a fleet watch.
#      repo-standards-sync / semgrep would need a workflow or .semgrep.yml
#      edit this token cannot push.
#   3. No managed GitHub setting watches a skill path per product repo.
#   4. opencode-m3-catalog-canary observe-to-closes a different marker;
#      it does not walk missing-harness tickets.
#
# No new scheduler. Run by fleet-heartbeat-tier1 block 29.
#
# Environment seams (tests):
#   FLEET_VERIFY_HARNESS_JSON     skip + required_headings config
#   FLEET_VERIFY_HARNESS_INTAKE   intake-repos.json override
#   FLEET_VERIFY_HARNESS_CHECKOUT_ROOT  checkout root override
#   FLEET_HEARTBEAT_TRIAGE
#   FLEET_VERIFY_HARNESS_REPO     default Nishfleet/fleet-ops
#   FLEET_VERIFY_HARNESS_FILE     1 (default) file issues AND
#                                 observe-to-close leftovers; 0 skip both
#   FLEET_VERIFY_HARNESS_CAP      per-tick file cap (default 5). Does not
#                                 cap observe-to-close: leftover piles
#                                 (#812 + #999) must all drain same tick.
#   FLEET_VERIFY_HARNESS_LIST_LIMIT  open-issue list cap (default 1000).
#                                 Was hardcoded 50; that missed #812 on a
#                                 200-issue desk and filed leftover #999.
#   FLEET_VERIFY_HARNESS_ORIGIN_FALLBACK  1 (default) re-check against
#                                 origin's default-branch HEAD before filing
#                                 when the local checkout is stale; 0 disables
#                                 (used by tests that assert the local-only
#                                 path). When on, also re-checks a
#                                 `nishfleet` remote (fleet-ops#961) so a
#                                 fork-named remote carries the same
#                                 fleet-ops#927 spirit when `origin` is
#                                 upstream.
#   FLEET_OPS_REPO
#   GH                            gh binary (tests stub this)

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

GH="${GH:-gh}"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)
FLEET_OPS_REPO="${FLEET_OPS_REPO:-$_canon_repo}"

usage() {
    printf 'usage: fleet-verify-harness-canary [-h|--help]\n' >&2
    printf '  Heartbeat canary: enrolled product repos must have\n' >&2
    printf '  .claude/skills/verify-<app>/SKILL.md with required sections.\n' >&2
    exit 0
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
fi

CONFIG="${FLEET_VERIFY_HARNESS_JSON:-$FLEET_OPS_REPO/config/verify-harness.json}"
if [[ ! -f "$CONFIG" ]]; then
    CONFIG="${HOME}/.local/state/pi-packet/verify-harness.json"
fi

INTAKE="${FLEET_VERIFY_HARNESS_INTAKE:-$FLEET_OPS_REPO/config/intake-repos.json}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
REPO="${FLEET_VERIFY_HARNESS_REPO:-Nishfleet/fleet-ops}"
FILE_ISSUES="${FLEET_VERIFY_HARNESS_FILE:-1}"
FILE_CAP="${FLEET_VERIFY_HARNESS_CAP:-5}"
LIST_LIMIT="${FLEET_VERIFY_HARNESS_LIST_LIMIT:-1000}"
# Re-check against origin's default-branch HEAD before filing when the local
# checkout is stale (fleet-ops#927: canary filed 7s after the harness PR merged
# because the local HEAD was behind origin/main). 1 = on (default), 0 = off.
ORIGIN_FALLBACK="${FLEET_VERIFY_HARNESS_ORIGIN_FALLBACK:-1}"

log() {
    printf '[%s] [fleet-verify-harness-canary] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

filed_this_tick=0

file_finding() {
    local name="$1" title="$2" body="$3"
    local marker="fleet-verify-harness-canary: missing-harness ${name}"
    if [[ "$FILE_ISSUES" != "1" ]]; then
        log "file skipped (FLEET_VERIFY_HARNESS_FILE=$FILE_ISSUES) marker=$marker"
        return 0
    fi
    if (( filed_this_tick >= FILE_CAP )); then
        log "file cap reached ($FILE_CAP); skipping $marker"
        return 0
    fi
    local existing
    existing=$("$GH" issue list -R "$REPO" --state open --limit "$LIST_LIMIT" \
        --json number,body 2>/dev/null \
        | jq -r --arg m "$marker" '.[] | select(.body | contains($m)) | .number' \
        | head -n 1 || true)
    if [[ -n "$existing" ]]; then
        log "dedup: open $REPO#$existing already carries $marker"
        return 0
    fi
    local full
    full="${body}

${marker}
"
    if "$GH" issue create -R "$REPO" --title "$title" --body "$full" >/dev/null 2>&1; then
        log "filed: $title"
        filed_this_tick=$((filed_this_tick + 1))
    else
        log "WARN: gh issue create failed for $marker"
    fi
}

# observe_to_close — drain leftover missing-harness tickets when the
# product is now ok (fleet-ops#812 / #999). GitHub's --limit 50 open-list
# plus no close path left #812 sitting while a later tick filed #999 for
# the same marker, even though tinystudio-in origin/main already had the
# harness (Nishfleet/tinystudio-in#281). Walk every matching open issue;
# do not first-only close; do not apply FILE_CAP (that cap is for filing).
# Wired only when FLEET_VERIFY_HARNESS_FILE=1; FILE=0 live probes stay
# read-only. Closes only on a positive inspect_product=ok — a still-missing
# leftover stays open.
observe_to_close() {
    if [[ "$FILE_ISSUES" != "1" ]]; then
        log "observe-to-close skipped (FLEET_VERIFY_HARNESS_FILE=$FILE_ISSUES)"
        return 0
    fi
    local open_json="" list_rc=0
    set +e
    open_json=$("$GH" issue list -R "$REPO" --state open --limit "$LIST_LIMIT" \
        --json number,body 2>/dev/null)
    list_rc=$?
    set -e
    if [[ "$list_rc" -ne 0 || -z "$open_json" ]]; then
        log "observe-to-close: gh issue list failed (rc=$list_rc), skip"
        return 0
    fi
    if ! jq -e . >/dev/null 2>&1 <<<"$open_json"; then
        log "observe-to-close: gh issue list returned non-JSON, skip"
        return 0
    fi
    local closed=0 num body marker name state ts comment close_rc
    while IFS= read -r row; do
        [[ -n "$row" ]] || continue
        num=$(jq -r '.number // empty' <<<"$row")
        body=$(jq -r '.body // ""' <<<"$row")
        [[ -n "$num" && "$num" != "null" ]] || continue
        marker=$(grep -oE 'fleet-verify-harness-canary: missing-harness [^[:space:]]+' \
            <<<"$body" | head -n 1 || true)
        [[ -n "$marker" ]] || continue
        name="${marker#fleet-verify-harness-canary: missing-harness }"
        [[ -n "$name" ]] || continue
        state="${product_state[$name]:-}"
        if [[ "$state" != "ok" ]]; then
            log "observe-to-close: keep #$num (name=$name state=${state:-unknown})"
            continue
        fi
        ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        comment="observe-to-close: fleet-verify-harness-canary missing-harness ${name} is no longer a gap on heartbeat tick at ${ts}. HEAD on the default branch has a valid verify skill (LAUNCH/DOCTOR/DRIVE/EVIDENCE/CLEANUP + features/). Leftover-duplicate drain (fleet-ops#812, fleet-ops#999)."
        set +e
        "$GH" issue close "$num" -R "$REPO" --reason completed --comment "$comment" >/dev/null 2>&1
        close_rc=$?
        set -e
        if [[ "$close_rc" -eq 0 ]]; then
            closed=$((closed + 1))
            log "OBSERVE-CLOSED $name -> #$num (inspect_product=ok)"
        else
            log "observe-to-close: failed to close #$num (rc=$close_rc)"
        fi
    done < <(jq -c '.[]' <<<"$open_json")
    log "observe-to-close: closed=$closed"
}

if [[ ! -f "$CONFIG" ]]; then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "config missing: $CONFIG"
    exit 1
fi
if ! jq -e . "$CONFIG" >/dev/null 2>&1; then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "config unparseable: $CONFIG"
    exit 1
fi
if [[ ! -f "$INTAKE" ]]; then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "intake missing: $INTAKE"
    exit 1
fi
if ! jq -e . "$INTAKE" >/dev/null 2>&1; then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "intake unparseable: $INTAKE"
    exit 1
fi

mapfile -t required_headings < <(jq -r '.required_headings[]? // empty' "$CONFIG")
if (( ${#required_headings[@]} < 1 )); then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "config missing required_headings: $CONFIG"
    exit 1
fi

declare -A skip_set=()
while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    skip_set["$name"]=1
done < <(jq -r '.skip[]?.name // empty' "$CONFIG")

declare -A enrolled_set=()
while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    enrolled_set["$name"]=1
done < <(jq -r '.repos[]?.name // empty' "$INTAKE")

checkout_root="${FLEET_VERIFY_HARNESS_CHECKOUT_ROOT:-}"
if [[ -z "$checkout_root" ]]; then
    checkout_root=$(jq -r '.checkout_root // empty' "$INTAKE")
fi
if [[ -z "$checkout_root" ]]; then
    loud "VERIFY-HARNESS-WATCHER-BROKEN" "intake missing checkout_root: $INTAKE"
    exit 1
fi

# Collect unique product names: enrolled + deferred, skip[] removed.
declare -A seen_names=()
declare -A product_state=()
product_names=()
while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if [[ -n "${skip_set[$name]:-}" ]]; then
        log "skip non-product: $name"
        continue
    fi
    if [[ -n "${seen_names[$name]:-}" ]]; then
        continue
    fi
    seen_names["$name"]=1
    product_names+=("$name")
done < <(jq -r '.repos[]?.name, .deferred[]?.name | select(. != null)' "$INTAKE")

skill_paths_on_head() {
    local checkout="$1" ref="${2:-HEAD}"
    git -C "$checkout" ls-tree -r --name-only "$ref" -- .claude/skills 2>/dev/null \
        | grep -E '^\.claude/skills/verify-[^/]+/SKILL.md$' || true
}

features_on_head() {
    local checkout="$1" skill_dir="$2" ref="${3:-HEAD}"
    git -C "$checkout" ls-tree -r --name-only "$ref" -- "$skill_dir/features" 2>/dev/null \
        | grep -E "^${skill_dir}/features/[^/]+\.md$" || true
}

harness_ok() {
    local checkout="$1" skill_path="$2" ref="${3:-HEAD}"
    local skill_dir content heading
    skill_dir=$(dirname "$skill_path")
    if ! content=$(git -C "$checkout" show "${ref}:${skill_path}" 2>/dev/null); then
        return 1
    fi
    for heading in "${required_headings[@]}"; do
        if ! grep -qiE "^##[[:space:]]*${heading}([[:space:]]|$)" <<<"$content"; then
            return 1
        fi
    done
    local feats
    feats=$(features_on_head "$checkout" "$skill_dir" "$ref")
    [[ -n "$feats" ]]
}

# Resolve a remote's default-branch ref for a checkout, or print empty when
# there is no <remote> remote / no default-branch ref (fresh fixtures,
# offline). Tries `refs/remotes/<remote>/HEAD` first (set by
# `git remote set-head` / a fetch), then `<remote>/main`, then
# `<remote>/master`. Prints the ref to use, or nothing.
remote_default_ref() {
    local checkout="$1" remote="$2" ref
    ref=$(git -C "$checkout" symbolic-ref --quiet "refs/remotes/${remote}/HEAD" 2>/dev/null || true)
    if [[ -n "$ref" ]] && git -C "$checkout" rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
        printf '%s' "$ref"
        return 0
    fi
    for cand in "${remote}/main" "${remote}/master"; do
        if git -C "$checkout" rev-parse --verify --quiet "$cand" >/dev/null 2>&1; then
            printf '%s' "$cand"
            return 0
        fi
    done
    return 0
}

inspect_product() {
    # Prints one token: ok | missing | invalid | no-checkout | not-git
    local name="$1"
    local checkout="$checkout_root/$name"
    if [[ ! -d "$checkout" ]]; then
        printf 'no-checkout\n'
        return 0
    fi
    if ! git -C "$checkout" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'not-git\n'
        return 0
    fi
    local paths path local_state
    paths=$(skill_paths_on_head "$checkout")
    if [[ -z "$paths" ]]; then
        local_state="missing"
    else
        local_state="invalid"
        while IFS= read -r path; do
            [[ -n "$path" ]] || continue
            if harness_ok "$checkout" "$path"; then
                local_state="ok"
                break
            fi
        done <<<"$paths"
    fi
    if [[ "$local_state" == "ok" ]]; then
        printf 'ok\n'
        return 0
    fi
    # The compliance target is "HEAD on the default branch has a valid skill"
    # (issue body, fleet-ops#524). The local checkout's HEAD can lag any
    # default branch the operator pulls from. Re-check before reporting a gap;
    # a stale local checkout with a valid harness on a remote default branch
    # is `ok`, not a violation.
    #
    # Fallback order (fleet-ops#961):
    #   1. origin/<default> — fleet-ops#927. Covers the common case where
    #      `origin` is the user's fork (Nishfleet/<repo>).
    #   2. nishfleet/<default> — covers the case where `origin` is upstream
    #      (e.g. context-hub, where origin = andrewyng/context-hub) and the
    #      user's fork is a separately named remote. Same fleet-ops#927 spirit
    #      extended to a second remote name (fleet-ops#961).
    #
    # Both are off when ORIGIN_FALLBACK=0 (tests assert the local-only
    # path). ORIGIN_FALLBACK=1 (default) is the production seam.
    if [[ "$ORIGIN_FALLBACK" == "1" ]]; then
        local -a fallback_remotes=("origin" "nishfleet")
        local remote oref opaths opath
        for remote in "${fallback_remotes[@]}"; do
            if ! git -C "$checkout" remote get-url "$remote" >/dev/null 2>&1; then
                continue
            fi
            oref=$(remote_default_ref "$checkout" "$remote")
            [[ -n "$oref" ]] || continue
            opaths=$(skill_paths_on_head "$checkout" "$oref")
            [[ -n "$opaths" ]] || continue
            while IFS= read -r opath; do
                [[ -n "$opath" ]] || continue
                if harness_ok "$checkout" "$opath" "$oref"; then
                    log "stale-local: $name local HEAD lacks a valid harness but ${oref} has one — treating as ok (fleet-ops#927)"
                    printf 'ok\n'
                    return 0
                fi
            done <<<"$opaths"
        done
    fi
    printf '%s\n' "$local_state"
}

issue_body_for() {
    local name="$1" kind="$2"
    printf '%s\n' \
        "Standing rule: every product repo gets ONE checked-in verification skill at \`.claude/skills/verify-<app>/SKILL.md\` (LAUNCH, DOCTOR, DRIVE, EVIDENCE, CLEANUP, plus a features/ map)." \
        "" \
        "- repo: \`Nishfleet/${name}\`" \
        "- finding: \`${kind}\`" \
        "- checkout: \`${checkout_root}/${name}\`" \
        "" \
        "Implement the harness in Nishfleet/${name}. Do not close this until HEAD on the default branch has a valid skill. fleet-ops#524."
}

violations=0
deferred_gaps=0

if (( ${#product_names[@]} == 0 )); then
    log "no product names after skip[] — nothing to inspect"
else
    for name in "${product_names[@]}"; do
        enrolled=0
        if [[ -n "${enrolled_set[$name]:-}" ]]; then
            enrolled=1
        fi
        state=$(inspect_product "$name")
        product_state["$name"]="$state"
        case "$state" in
            ok)
                log "ok: $name"
                ;;
            no-checkout|not-git)
                if (( enrolled )); then
                    loud "VERIFY-HARNESS-WATCHER-BROKEN" \
                        "enrolled product $name checkout is ${state} at $checkout_root/$name"
                    violations=$((violations + 1))
                else
                    log "deferred ${state}: $name"
                fi
                ;;
            missing|invalid)
                kind="HEAD ${state} verify harness"
                if (( enrolled )); then
                    loud "VERIFY-HARNESS-VIOLATION" \
                        "enrolled product $name: $kind"
                    file_finding "$name" \
                        "feat(${name}): add .claude/skills/verify-<app> harness" \
                        "$(issue_body_for "$name" "$kind")"
                    violations=$((violations + 1))
                else
                    log "deferred gap: $name ($kind)"
                    file_finding "$name" \
                        "feat(${name}): add .claude/skills/verify-<app> harness" \
                        "$(issue_body_for "$name" "$kind")"
                    deferred_gaps=$((deferred_gaps + 1))
                fi
                ;;
            *)
                loud "VERIFY-HARNESS-WATCHER-BROKEN" \
                    "inspect_product returned unknown state '$state' for $name"
                violations=$((violations + 1))
                ;;
        esac
    done
fi

observe_to_close

if (( violations > 0 )); then
    log "FAIL: $violations enrolled product harness gap(s); deferred_gaps=$deferred_gaps"
    exit 1
fi

loud "VERIFY-HARNESS-OK" \
    "enrolled product harnesses present; deferred_gaps=$deferred_gaps"
exit 0
