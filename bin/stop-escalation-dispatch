#!/usr/bin/env bash
# stop-escalation-dispatch — SENIOR AUDITOR escalation on a STOP-REASON trip.
# Thin runner: ONE dispatch per firing, no retries/loops. Dedupes by content
# hash; same hash within cooldown = no refire; max 2 dispatches per hash, then
# NISH-ESCALATIONS.md. Seat unhealthy OR pi call fails => fail loud + NISH line.
#
# fleet-ops#95: a transient seat blip (rate_limited / transient_fault,
# dead=false) is a LANE FAULT, never a Nish escalation. The seat-health gate
# now re-reads seat-health once after a bounded delay when the seat is
# unhealthy-but-not-dead and not on the poison ladder; it dispatches on
# recovery and fails loud + NISH ONLY on dead=true, poison_ladder=true, or
# unhealth persisting across the re-read. The 2-per-hash bound is unchanged.
# Layer: never-say-next SENIOR-AUDITOR (visual-quality-waves.md escalation scope).
set -euo pipefail
AS=${STOP_ESCALATION_AS:-/home/nish/workspaces/agent-state}
SR=${STOP_ESCALATION_STOP_REASON:-$AS/STOP-REASON.json}
SH=${STOP_ESCALATION_SEAT_HEALTH:-$AS/lanes/pi-seat-health.json}
SEEN=${STOP_ESCALATION_SEEN:-$AS/stop-escalation-seen.txt}
NISH=${STOP_ESCALATION_NISH:-$AS/NISH-ESCALATIONS.md}
LOG=${STOP_ESCALATION_AUDITOR_LOG:-$AS/AUDITOR-LOG.md}
CD=${STOP_ESCALATION_COOLDOWN:-300}
PI=${STOP_ESCALATION_PI_BIN:-/home/nish/.local/bin/pi}
DRY=${STOP_ESCALATION_DRY_RUN:-0}
PROVIDER=${STOP_ESCALATION_PROVIDER:-devin}
MODEL=${STOP_ESCALATION_MODEL:-glm-5-2}
# Bounded delay (seconds) for the single transient-blip re-read. Clamped to
# [5, 60] so a runaway retry_after can never eat the unit's 25min budget.
TRANSIENT_DELAY=${STOP_ESCALATION_TRANSIENT_DELAY:-30}
ts(){ date -u +%FT%TZ; }
[ -f "$SR" ] || exit 0
reason=$(python3 -c 'import sys,json;print(json.load(sys.stdin).get("reason",""))' < "$SR" 2>/dev/null || echo "")
# Skip non-fault stops: boundary:* = legitimate human-only stop (money/creds/legal),
# cooldown_active = circuit already tripped, cooldown holding. Neither is a fresh
# fault to escalate. Only circuit trips (max_auto_continues, same_error_circuit,
# no_progress_circuit, continuation_inject_failed) and unknown reasons escalate.
case "$reason" in
  boundary:*|cooldown_active) exit 0 ;;
esac
hash=$(sha256sum "$SR" | awk '{print $1}')
now=$(date +%s)
count=0; last=0
if [ -f "$SEEN" ]; then e=$(grep -F "$hash " "$SEEN" | head -1 || true); [ -n "$e" ] && { count=$(awk '{print $2}'<<<"$e"); last=$(awk '{print $3}'<<<"$e"); }; fi
if [ "$count" -ge 2 ]; then printf '%s CAP-REACHED hash=%s count=%s\n' "$(ts)" "$hash" "$count" >> "$NISH"; exit 0; fi
if [ "$count" -ge 1 ] && [ $((now-last)) -lt "$CD" ]; then exit 0; fi

# Seat-health gate (pipeline-up signal). Broad-repair lane = devin/glm-5-2.
# Reads the seat-health snapshot into SH_* vars.
read_seat_health() {
  local json
  json=$(cat "$SH" 2>/dev/null || echo '{}')
  SH_CLASS=$(python3 -c 'import sys,json;d=json.load(sys.stdin);print(d.get("health_class","unknown"))'<<<"$json" 2>/dev/null||echo unknown)
  SH_DEAD=$(python3 -c 'import sys,json;d=json.load(sys.stdin);print(str(d.get("seat_dead",False)).lower())'<<<"$json" 2>/dev/null||echo false)
  SH_POISON=$(python3 -c 'import sys,json;d=json.load(sys.stdin);print(str(d.get("poison_ladder",False)).lower())'<<<"$json" 2>/dev/null||echo false)
  SH_RETRY_AFTER=$(python3 -c 'import sys,json;d=json.load(sys.stdin);v=d.get("retry_after");print("" if v is None else v)'<<<"$json" 2>/dev/null||echo "")
}

# Returns 0 when the seat is healthy and dispatch may proceed; 1 when the
# seat is hard-down (dead=true / poison_ladder=true) OR a transient blip
# failed to clear within one bounded re-read. Caller writes the NISH line on 1.
# SH_* vars are left holding the most recent read for the caller's log line.
seat_health_gate() {
  read_seat_health
  if [ "$SH_CLASS" = healthy ] && [ "$SH_DEAD" != true ]; then return 0; fi
  # Hard-down: never wait, fail loud immediately.
  if [ "$SH_DEAD" = true ] || [ "$SH_POISON" = true ]; then return 1; fi
  # Transient retryable blip (rate_limited / transient_fault / unknown,
  # dead=false, not poison): one bounded re-read, then fail loud if it
  # has not cleared. retry_after (seconds) is honoured but clamped.
  local delay="$TRANSIENT_DELAY"
  if [ -n "$SH_RETRY_AFTER" ]; then
    delay="$SH_RETRY_AFTER"
  fi
  if [ "$delay" -lt 5 ] 2>/dev/null; then delay=5; fi
  if [ "$delay" -gt 60 ] 2>/dev/null; then delay=60; fi
  sleep "$delay"
  read_seat_health
  if [ "$SH_CLASS" = healthy ] && [ "$SH_DEAD" != true ]; then return 0; fi
  return 1
}

if ! seat_health_gate; then
  printf '%s SEAT-UNHEALTHY hash=%s class=%s dead=%s poison=%s\n' "$(ts)" "$hash" "$SH_CLASS" "$SH_DEAD" "$SH_POISON" >> "$NISH"
  echo "STOP-ESCALATION-FAULT: seat unhealthy ($SH_CLASS/$SH_DEAD)" >&2; exit 1
fi
# SENIOR AUDITOR packet — heredoc pointing at LIVE files, not frozen content.
packet=$(cat <<'PACKET'
EXECUTE-DONT-NARRATE. You are the SENIOR AUDITOR. A never-say-next circuit breaker tripped. Confer across agents, diagnose the gap, fix it, re-queue the halted item. Read these LIVE files (do not assume content):
1. /home/nish/workspaces/agent-state/STOP-REASON.json — the trip reason + detail.
2. The tripped session's log if STOP-REASON.json references a session path under /home/nish/.pi/agent/sessions/.
3. /home/nish/workspaces/agent-state/READY-WORK.md — the ready-work queue.
4. /home/nish/workspaces/agent-state/visual-quality-waves.md — program status (read the Status log + the active never-say-next workstream).
5. /home/nish/workspaces/agent-state/fleet-restoration-2026-08-25.md — the fleet-restoration ledger's DECISIONS LEDGER + Done + In flight.
6. RECENT peer session transcripts under /home/nish/.pi/agent/sessions/ — confer amongst agents: list newest-first, read the last few bounded to the same workspace, to see what peer agents actually recorded doing.
DIAGNOSE the gap: stuck loop cause, wrong assumption, missing dependency, or lane fault.
FIX it via worker-lane discipline (dispatch a sealed packet to a cheap lane; or fix directly if the change is small and obvious).
CLEAR the cooldown marker only when the cause is fixed (the stop-judge cooldown is internal state — clearing means the root cause is resolved, not disabling the extension).
RE-QUEUE the halted item in /home/nish/workspaces/agent-state/READY-WORK.md (which auto-dispatches via ready-work.path).
APPEND your diagnosis + action to /home/nish/workspaces/agent-state/AUDITOR-LOG.md.
Worked example (fresh case study): restore-chain-0509 halted because it polled deploys by mergeCommit SHA, but 0509's merge queue rewrites SHAs — the fix was query-by-recency, and the wave was re-queued. Apply this pattern: find the wrong assumption, fix the query/method, re-queue.
Do not wait for approval. Act now.

CATCH-ALL SWEEP (MANDATORY ending for EVERY auditor summon — COMPLETENESS
CLOSURES, visual-quality-waves.md 2026-08-25). Failure classes without a
dedicated tripwire are caught whenever ANY tripwire fires. Before you close,
run ALL of these and diagnose/fix/queue anything found, same discipline as
the summoning failure:
1. systemctl --user --state=failed --no-pager  — every failed USER unit.
   Reset/repair each; a unit stuck failed is a fault you own this turn.
2. systemctl --state=failed --no-pager  — SYSTEM scope, READ-ONLY (you lack
   root; report unrepairable system faults to NISH-ESCALATIONS.md, do not
   attempt sudo). Still diagnose what you can.
3. hermes cron list  +  hermes cron history <id>  — recent cron run failures.
   hermes is at /home/nish/.local/bin/hermes. Any failed run = a fault to fix.
4. Unprocessed STOP-REASON entries: re-read
   /home/nish/workspaces/agent-state/STOP-REASON.json — if its reason is NOT
   the one you were summoned for (a different trip landed while you ran), or
   if stop-escalation-seen.txt shows a hash at count<2 still unaddressed,
   pick it up too.
5. Open auto-revert-halt issues across Nishfleet repos:
   gh search issues "AUTO-REVERT HALT" --owner Nishfleet --state open
   Each is a deploy that halted revert on a suspected bad commit. Diagnose
   whether the halt is still valid or stale; fix/queue/close accordingly.
Anything found gets diagnosed/fixed/queued SAME as the summoning failure.
If ALL five are clean, say so explicitly in your AUDITOR-LOG.md block
("catch-all sweep: quiet on all 5 channels") — quiet IS a valid outcome.
PACKET
)
if [ "$DRY" = 1 ]; then
  printf '%s DRY-RUN auditor hash=%s provider=%s model=%s\n---PACKET---\n%s\n---END---\n' "$(ts)" "$hash" "$PROVIDER" "$MODEL" "$packet" >> "$LOG"
else
  if ! printf '%s' "$packet" | "$PI" --print --provider "$PROVIDER" --model "$MODEL" >> "$LOG" 2>&1; then
    printf '%s PI-DISPATCH-FAILED hash=%s provider=%s model=%s\n' "$(ts)" "$hash" "$PROVIDER" "$MODEL" >> "$NISH"
    echo "STOP-ESCALATION-FAULT: pi auditor dispatch failed" >&2; exit 1
  fi
fi
nc=$((count+1))
grep -v -F "$hash " "$SEEN" 2>/dev/null > "$SEEN.tmp" || true
printf '%s %s %s\n' "$hash" "$nc" "$now" >> "$SEEN.tmp"; mv "$SEEN.tmp" "$SEEN"
printf '%s dispatched auditor hash=%s count=%s provider=%s model=%s\n' "$(ts)" "$hash" "$nc" "$PROVIDER" "$MODEL" >> "$LOG"
exit 0
