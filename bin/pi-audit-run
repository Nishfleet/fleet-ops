#!/usr/bin/env bash
# bin/pi-audit-run
#
# Runs one SENIOR AUDITOR for a scout candidate. Called as ExecStart of
# pi-audit@<repo>--<candidate>--<role>.service. Assembles the context packet
# deterministically, runs the auditor seat, writes a PASS/FAIL vote, and
# exits 1 when the output does not meet the required shape (so systemd retries
# once via Restart=on-failure, then the inherited OnFailure ladder takes over).
#
# Roles:
#   devin            -> devin/glm-5-2
#   free-glm-5-3     -> free seat serving glm-5.3 per seat-caps allowlist
#   straitly         -> straitly/deepseek/deepseek-v4-pro
#
# Environment seams:
#   AUDIT_STATE_DIR              vote file tree (default ~/.local/state/fleet-audit)
#   AUDIT_DEVIN_SEAT             override provider:model, e.g. "devin:glm-5-2"
#   AUDIT_FREE_GLM53_SEAT        override provider:model
#   AUDIT_STRAITLY_SEAT          override provider:model
#   AUDIT_PROMPT                 path to auditor prompt
#   AUDIT_PLAN_FILE              decisions ledger source
#   AUDIT_GH, AUDIT_SYSTEMCTL    overrides for tests
#   PI_BIN                       default ~/.local/bin/pi

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${AUDIT_GH:-gh}"
PI_BIN="${PI_BIN:-$HOME/.local/bin/pi}"
SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
PROMPT="${AUDIT_PROMPT:-$HOME/.pi/agent/prompts/auditor.md}"
PLAN_FILE="${AUDIT_PLAN_FILE:-/home/nish/workspaces/agent-state/fleet-restoration-2026-08-25.md}"
STATE_DIR="${AUDIT_STATE_DIR:-$HOME/.local/state/fleet-audit}"
DRY_RUN="${AUDIT_DRY_RUN:-0}"

[ -f "$PROMPT" ] || { echo "pi-audit-run: prompt missing: $PROMPT" >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "pi-audit-run: jq missing" >&2; exit 2; }

# --- seat resolution ---------------------------------------------------------
if [ -f "$SEAT_LIB" ]; then
    # shellcheck source=/dev/null
    source "$SEAT_LIB"
fi

log() { printf '[%s] [pi-audit-run] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

find_free_glm53_seat() {
    if [ -n "${AUDIT_FREE_GLM53_SEAT:-}" ]; then
        printf '%s\t%s\n' "${AUDIT_FREE_GLM53_SEAT%%:*}" "${AUDIT_FREE_GLM53_SEAT#*:}"
        return 0
    fi
    if ! command -v enumerate_seats >/dev/null 2>&1; then
        return 1
    fi
    local p m _capable
    while IFS=$'\t' read -r p m _ _capable; do
        [ -n "$p" ] || continue
        [[ "$m" == *glm-5.3* ]] || continue
        [ "$(class_of "$p" 2>/dev/null || echo "")" = "free" ] || continue
        [ "$(model_cap "$p" "$m" 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || continue
        seat_usable "$p" "$m" 2>/dev/null || continue
        printf '%s\t%s\n' "$p" "$m"
        return 0
    done < <(enumerate_seats)
    return 1
}

resolve_seat() {
    local role="$1"
    case "$role" in
        devin)
            if [ -n "${AUDIT_DEVIN_SEAT:-}" ]; then
                printf '%s\t%s\n' "${AUDIT_DEVIN_SEAT%%:*}" "${AUDIT_DEVIN_SEAT#*:}"
            else
                printf 'devin\tglm-5-2\n'
            fi
            ;;
        free-glm-5-3|free)
            find_free_glm53_seat
            ;;
        straitly)
            if [ -n "${AUDIT_STRAITLY_SEAT:-}" ]; then
                printf '%s\t%s\n' "${AUDIT_STRAITLY_SEAT%%:*}" "${AUDIT_STRAITLY_SEAT#*:}"
            else
                printf 'straitly\tdeepseek/deepseek-v4-pro\n'
            fi
            ;;
        *)
            log "unknown auditor role: $role"
            return 1
            ;;
    esac
}

# --- helpers -----------------------------------------------------------------
instance_to_parts() {
    local inst="$1"
    inst="${inst%.service}"
    # repo--candidate--role. Use awk to print one field per line.
    printf '%s\n' "$inst" | awk -F '--' '{ for(i=1;i<=NF;i++) print $i }'
}

vote_path() {
    local repo="$1" candidate="$2" role="$3"
    printf '%s/%s/%s/%s.vote\n' "$STATE_DIR" "$repo" "$candidate" "$role"
}

repo_reality() {
    local repo="$1"
    local merged issues prs
    merged=$("$GH" pr list -R "Nishfleet/$repo" --state merged --json title --limit 20 2>/dev/null | jq -r '[.[] | .title] | join("\n")' || true)
    issues=$("$GH" issue list -R "Nishfleet/$repo" --state open --json number,title --limit 200 2>/dev/null | jq -r '[.[] | "#\(.number): \(.title)"] | join("\n")' || true)
    prs=$("$GH" pr list -R "Nishfleet/$repo" --state open --json number,title --limit 100 2>/dev/null | jq -r '[.[] | "#\(.number): \(.title)"] | join("\n")' || true)
    {
        printf '## Recent merged PR titles (last 20)\n%s\n\n' "${merged:-<none>}"
        printf '## Open issues\n%s\n\n' "${issues:-<none>}"
        printf '## Open PRs\n%s\n\n' "${prs:-<none>}"
    }
}

decisions_ledger() {
    if [ ! -f "$PLAN_FILE" ]; then
        printf '## Decisions ledger\n<missing: %s>\n\n' "$PLAN_FILE"
        return
    fi
    printf '## Decisions ledger (verbatim)\n'
    if grep -qEi '^#* *DECISIONS LEDGER' "$PLAN_FILE" 2>/dev/null; then
        awk 'BEGIN{flag=0} /^#* *DECISIONS LEDGER/{flag=1; print; next} flag && /^#|^--- *$/{if(/^--- *$/) exit; if(/^#/) exit} flag' "$PLAN_FILE" | head -c 8000
    else
        head -c 8000 "$PLAN_FILE"
    fi
    printf '\n\n'
}

build_packet() {
    local repo="$1" candidate="$2" role="$3"
    local issue_json title body labels
    issue_json=$("$GH" issue view "$candidate" -R "Nishfleet/$repo" --json title,body,labels 2>/dev/null) || {
        log "cannot fetch issue $candidate from Nishfleet/$repo"
        return 1
    }
    title=$(printf '%s\n' "$issue_json" | jq -r '.title // "<no title>"')
    body=$(printf '%s\n' "$issue_json" | jq -r '.body // "<no body>"')
    labels=$(printf '%s\n' "$issue_json" | jq -r '[.labels[]?.name] | join(", ")')

    {
        cat "$PROMPT"
        printf '\n\n---\n\n'
        printf 'AUDIT CONTEXT (deterministic, same for all three auditors):\n\n'
        printf 'repo: Nishfleet/%s\ncandidate issue: #%s\nrole: %s\nlabels: %s\n\n' "$repo" "$candidate" "$role" "$labels"
        printf '## Candidate title\n%s\n\n' "$title"
        printf '## Candidate body\n%s\n\n' "$body"
        repo_reality "$repo"
        decisions_ledger
        printf '## Campaign priority pointer\nSee the repo-specific campaign doc / decisions ledger; north-star: product must beat the customer'\''s own edge AI; parity work is raised, not shipped.\n\n'
    }
}

extract_verdict() {
    local out="$1"
    # Strip markdown bold/italic and look for a standalone PASS or FAIL line.
    sed -E 's/[*#`_]//g' "$out" | grep -m1 -E '^[[:space:]]*(PASS|FAIL)[[:space:]]*$' | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//' | tr '[:lower:]' '[:upper:]'
}

extract_reason() {
    local out="$1" v
    v=$(extract_verdict "$out")
    [ -n "$v" ] || return 0
    awk -v v="$v" 'BEGIN{out=0} {
        gsub(/[*#`_]/,"")
        if (!out && $0 ~ "^[[:space:]]*"v"[[:space:]]*$") { out=1; next }
        if (out) print
    }' "$out" | sed '/^$/d' | head -c 2000
}

# True if the reason paragraph explicitly addresses duplicates and north-star fit.
reason_complete() {
    local reason="$1"
    [ -n "$reason" ] || return 1
    local lc
    lc=$(printf '%s\n' "$reason" | tr '[:upper:]' '[:lower:]')
    if ! grep -qiE 'duplicat' <<<"$lc"; then
        log "reason does not address duplicates"
        return 1
    fi
    if ! grep -qiE 'north[[:space:]-]*star|customer|edge|parity|beat' <<<"$lc"; then
        log "reason does not address north-star fit"
        return 1
    fi
    return 0
}

write_vote() {
    local repo="$1" candidate="$2" role="$3" verdict="$4" reason="$5"
    local dir path
    path=$(vote_path "$repo" "$candidate" "$role")
    dir=$(dirname "$path")
    mkdir -p "$dir"
    jq -n \
        --arg repo "$repo" \
        --arg candidate "$candidate" \
        --arg role "$role" \
        --arg verdict "$verdict" \
        --arg reason "$reason" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{repo:$repo,candidate:$candidate,role:$role,verdict:$verdict,reason:$reason,at:$at}' > "$path"
    log "wrote $verdict vote for $repo/#$candidate/$role"
}

# --- main --------------------------------------------------------------------
main() {
    local instance="${1:-}"
    if [ -z "$instance" ]; then
        log "usage: pi-audit-run <repo>--<candidate>--<role>"
        exit 2
    fi

    local repo candidate role
    mapfile -t parts < <(instance_to_parts "$instance")
    if [ "${#parts[@]}" -ne 3 ]; then
        log "instance must be repo--candidate--role (got $instance)"
        exit 2
    fi
    repo="${parts[0]}"
    candidate="${parts[1]}"
    role="${parts[2]}"

    case "$role" in
        devin|free-glm-5-3|free|straitly) : ;;
        *) log "unknown role '$role' in instance $instance"; exit 2 ;;
    esac

    if ! [[ "$candidate" =~ ^[0-9]+$ ]]; then
        log "candidate must be a number (got $candidate)"
        exit 2
    fi

    local seat provider model
    if ! seat=$(resolve_seat "$role"); then
        log "no usable seat for role $role"
        exit 1
    fi
    provider=$(printf '%s\n' "$seat" | cut -f1)
    model=$(printf '%s\n' "$seat" | cut -f2)

    log "auditing $repo/#$candidate with $provider/$model (role=$role)"

    if [ "$DRY_RUN" = "1" ]; then
        log "DRY-RUN: would audit $repo/#$candidate/$role on $provider/$model"
        exit 0
    fi

    local tmp packet out err combined verdict reason
    tmp=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT INT TERM
    packet="$tmp/packet.md"
    out="$tmp/out"
    err="$tmp/err"

    build_packet "$repo" "$candidate" "$role" > "$packet" || exit 1

    set +e
    "$PI_BIN" --print --provider "$provider" --model "$model" < "$packet" > "$out" 2> "$err"
    pi_rc=$?
    set -e

    if [ "$pi_rc" -ne 0 ]; then
        log "pi --provider $provider --model $model exited $pi_rc"
        { printf '## stderr\n'; cat "$err"; } >> "$out" 2>/dev/null || true
        exit 1
    fi

    combined="$out"
    if [ -s "$err" ]; then
        combined="$tmp/combined"
        { cat "$out"; printf '\n\n## stderr\n'; cat "$err"; } > "$combined"
    fi

    verdict=$(extract_verdict "$combined")
    reason=$(extract_reason "$combined")

    if [ -z "$verdict" ]; then
        log "auditor output did not contain a PASS/FAIL verdict"
        exit 1
    fi
    if [ -z "$reason" ]; then
        log "auditor output did not contain a reason"
        exit 1
    fi
    if ! reason_complete "$reason"; then
        log "auditor reason incomplete (missing duplicates/north-star)"
        exit 1
    fi

    write_vote "$repo" "$candidate" "$role" "$verdict" "$reason"
}

main "$@"
