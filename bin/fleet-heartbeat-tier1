# last-blind-audit-run stamp and LOUDs if it is older than 30h (or missing).
# Implementation lives in lib/blind-audit-cadence.sh so tests run the same
# function the tick runs — not a copy of the predicate.
CADENCE_LIB="${FLEET_BLIND_AUDIT_CADENCE_LIB:-$HOME/.local/lib/pi-packet/blind-audit-cadence.sh}"
audit_canary_status="ok"
if [ -f "$CADENCE_LIB" ]; then
    # shellcheck source=../lib/blind-audit-cadence.sh source-path=SCRIPTDIR
    source "$CADENCE_LIB"
    heartbeat_blind_audit_cadence_canary
