#!/usr/bin/env bash
# fleet-heartbeat-tier1 — deterministic, no-LLM ops (P13, 2026-08-25).
#
# Runs every tick. Zero quota. Keeps the pipeline flowing even when every
# LLM is dead. Idempotent — safe to run as often as the timer fires.
#
# Responsibilities (one per labelled block, in order):
#   1. Update the last-heartbeat: line in the plan file (so interactive
#      sessions see the durable timer is alive).
#   2. Queue green fleet-authored PRs (auto-merge per repo, respecting
#      the hands-off list).
#   3. Release orphaned claims (agent-in-progress + no live worker +
#      no open claim/issue-N PR).
#   4. Recover/log failed fleet worker/repair/cleanup units; attempt a plain
#      reset+start for transient lane faults on supply/repair units, and
#      escalate loudly after N attempts so a unit never ends failed quietly.
#   6. Re-examine agent-blocked issues. Named reason this is a sweep:
#      the blocker (a dependency issue/PR, or a Nish decision) changes
#      outside this repo, and the GitHub App has no webhooks. If every
#      machine-checkable dependency is closed/merged, flip back to
#      agent-ready. Nish-decision blocks stay labelled and are published
#      (count + oldest age) into the triage file.
#   8. Undersaturation alarm + throughput line (fleet-ops#75). Delegates to
#      bin/fleet-heartbeat-undersaturation: counts ready/claimed work and
#      live pi-issue workers; if work>0 and running==0 it repairs (reset-
#      failed, reap stale active-seats, restart intake) on the first wedged
#      tick and fails LOUD on the second consecutive one. Also emits one
#      THROUGHPUT line per tick (merged fleet-worker PRs since last tick)
#      into the triage log. The helper's non-zero exit propagates here so
#      fleet-heartbeat.service lands in --state=failed -> page + Telegram.
#   9. Low-water-mark scouting (fleet-ops#146). Delegates to
#      bin/fleet-heartbeat-low-water-mark: for each enrolled repo, when
#      ready < lane ceiling (seat_max_concurrent) and no scout is running
#      and the per-repo threshold stamp is stale (>2h), start pi-scout@<repo>
#      so replenishment overlaps consumption and lanes never hit empty. The
#      4h timer stays as the floor; this only pulls a scout LOOK sooner.
#      Best-effort nudge — a CONFIG error is logged + LOUD but NOT propagated
#      (a broken refill must not stop queuing/reclaim/wedge alarm).
#
# Logging: every action goes to stderr (systemd journal) AND to the per-
# tick log file at $FLEET_HEARTBEAT_LOG_DIR/tier1-<UTC>.log. NO stdout
# output (exit code is the signal; nothing else needs to be parsed).

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

PLAN_FILE="${FLEET_PLAN_FILE:-/home/nish/workspaces/agent-state/fleet-restoration-2026-08-25.md}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
LOG_DIR="${FLEET_HEARTBEAT_LOG_DIR:-/home/nish/.local/state/fleet-heartbeat}"
REPOS_JSON="${FLEET_REPOS_JSON:-/home/nish/.local/state/fleet-heartbeat/fleet-repos.json}"

mkdir -p "$LOG_DIR"

# Per-tick log file (UTC timestamp; one file per fire, easy to diff).
TICK_TS=$(date -u +%Y%m%dT%H%M%SZ)
TICK_LOG="$LOG_DIR/tier1-$TICK_TS.log"
exec 3>"$TICK_LOG"

log() {
    local line
    line="[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
    printf '%s\n' "$line" >&2
    printf '%s\n' "$line" >&3
}

# Loud tier2 / handoff lines go to BOTH the tick log and the triage file.
# Other agents (and humans) watch the triage file as a single page.
loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

# --- failed-unit recovery helpers -------------------------------------------
FAILED_UNITS_STATE_DIR="${FLEET_HEARTBEAT_FAILED_STATE_DIR:-$LOG_DIR/failed-units}"
FAILED_UNITS_MAX_ATTEMPTS="${FLEET_HEARTBEAT_FAILED_MAX_ATTEMPTS:-3}"
mkdir -p "$FAILED_UNITS_STATE_DIR"

# Safe on-disk filename for a systemd unit name.
unit_state_file() {
    local u="$1" safe
    safe=$(printf '%s' "$u" | tr -c 'A-Za-z0-9._-' '_')
    printf '%s/%s.json\n' "$FAILED_UNITS_STATE_DIR" "$safe"
}

# Read a single key from a unit's JSON state file.
state_get() {
    local f="$1" key="$2" default="${3:-}"
    if [[ -f "$f" ]]; then
        jq -r --arg k "$key" --arg d "$default" '(.[$k] // $d) | tostring' "$f" 2>/dev/null || printf '%s' "$default"
    else
        printf '%s' "$default"
    fi
}

# Write a unit's JSON state file atomically. Empty attempts/escalated means
# "leave the current value".
state_update() {
    local f="$1" unit="$2" class="$3" action="$4" still="$5" attempts="${6:-}" escalated="${7:-}"
    python3 - "$f" "$unit" "$class" "$action" "$still" "$attempts" "$escalated" <<'PY'
import sys, os, json, datetime
f, unit, cls, action, still = sys.argv[1:6]
attempts = sys.argv[6] if len(sys.argv) > 6 else ''
escalated = sys.argv[7] if len(sys.argv) > 7 else ''
state = {}
if os.path.exists(f):
    try:
        with open(f, 'r', encoding='utf-8') as fh:
            state = json.load(fh)
    except Exception:
        state = {}
now = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
state['unit'] = unit
state['class'] = cls
if 'first_seen' not in state:
    state['first_seen'] = now
state['last_seen'] = now
state['last_action'] = action
state['last_action_at'] = now
state['still_failed'] = (still == 'true')
if attempts != '':
    try:
        state['attempts'] = int(attempts)
    except ValueError:
        state['attempts'] = state.get('attempts', 0)
if escalated != '':
    state['escalated'] = (escalated == 'true')
tmp = f + '.tmp.' + str(os.getpid())
with open(tmp, 'w', encoding='utf-8') as fh:
    json.dump(state, fh)
os.rename(tmp, f)
PY
}

# Remove state when a unit has recovered.
state_remove() {
    local f="$1"
    rm -f "$f"
}

# Classify a failure from the lower-cased journal text.
classify_failure() {
    local journal="$1"
    local low
    low=$(printf '%s' "$journal" | tr '[:upper:]' '[:lower:]')
    if printf '%s' "$low" | grep -qiE 'rate limit|reached.*message.*limit|429|too many requests|etimedout|connection timed out|connect etimedout|econn|handshake.*timeout|spawn.*timeout|timed out waiting|retryable.*true|transient_fault'; then
        printf 'transient-lane'; return
    fi
    if printf '%s' "$low" | grep -qiE 'start.*limit|startlimitburst|start-limit|start-limit-hit'; then
        printf 'start-limit'; return
    fi
    if printf '%s' "$low" | grep -qiE 'auth.*fail|credential.*bad|api key.*invalid|token.*invalid|model missing|llm.*dead|permission denied.*(invalid|bad|missing)|quota.*exhausted|out of quota|daily limit'; then
        printf 'llm-dead'; return
    fi
    if printf '%s' "$low" | grep -qiE 'code=exited.*status=1|exit-code|syntax error|command not found|no such file|fatal|error'; then
        printf 'code-fail'; return
    fi
    printf 'unknown'
}

# Extract provider/model from the unit's ExecStart line.
unit_seat() {
    local u="$1"
    local ex p m
    ex=$(systemctl --user show "$u" --property=ExecStart --value 2>/dev/null || true)
    p=""; m=""
    if [[ "$ex" =~ --provider[[:space:]]+([^[:space:]\'\"]+) ]]; then
        p="${BASH_REMATCH[1]}"
    fi
    if [[ "$ex" =~ --model[[:space:]]+([^[:space:]\'\"]+) ]]; then
        m="${BASH_REMATCH[1]}"
    fi
    printf '%s\t%s\n' "${p:-unknown}" "${m:-unknown}"
}

# True if a tag+unit triage line already exists (so we do not repeat every tick).
already_in_triage() {
    local tag="$1" unit="$2"
    [[ -s "$TRIAGE" ]] && grep -qF "[$tag] unit=$unit" "$TRIAGE" 2>/dev/null
}

# Remove stale trigger lines for a unit before writing a new one, so the
# triage file does not hold a classification that is no longer current.
triage_remove_unit() {
    local unit="$1"
    [[ -s "$TRIAGE" ]] || return 0
    python3 - "$TRIAGE" "$unit" <<'PY'
import sys, re, os
path, unit = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    sys.exit(0)
pattern = re.compile(
    r'^\[[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\] '
    r'\[(LLM-DEAD|CODE-FAIL|UNIT-ESCALATE)\] unit=' + re.escape(unit) + ' '
)
with open(path, 'r', encoding='utf-8') as f:
    kept = [ln for ln in f if not pattern.match(ln)]
with open(path, 'w', encoding='utf-8') as f:
    f.writelines(kept)
PY
}

# Whether tier 1 may reset+start this failed unit itself.
#   recover — supply/repair units with NO OnFailure reap. A transient lane
#             fault (provider 429, ETIMEDOUT, StartLimit from transient
#             retries) leaves them failed with no other recovery path, so
#             the heartbeat's reset+start floor is safe and is the fix the
#             2026-08-25 incident (#28) was missing.
#   observe — worker units (pi-issue@/pi-packet@/fable-p*) and reap cleanup
#             units (*-failed@). Restarting these races the OnFailure reap
#             (which releases the claim branch and flips the label) and the
#             intake re-dispatch: two workers would land on the same issue.
#             Their own retry/reap path is the correct recovery, so tier 1
#             only observes and surfaces non-transient faults.
unit_recovery_class() {
    case "$1" in
        pi-intake@*.service)        printf 'recover' ;;
        pi-intake-repair@*.service) printf 'recover' ;;
        pi-scout@*.service)         printf 'recover' ;;
        pi-scout-repair@*.service)  printf 'recover' ;;
        *)                          printf 'observe' ;;
    esac
}

[ -f "$PLAN_FILE" ] || { log "FATAL: plan file missing: $PLAN_FILE"; exit 1; }
[ -f "$REPOS_JSON" ] || {
    log "WARN: fleet-repos.json missing at $REPOS_JSON — writing default"
    mkdir -p "$(dirname "$REPOS_JSON")"
    cat > "$REPOS_JSON" <<'JSON'
{
  "queue_repos": ["Nishfleet/0509", "Nishfleet/inish-site", "Nishfleet/seo-fix-kit", "Nishfleet/TinyStudio.io", "Nishfleet/tinystudio-in", "Nishfleet/siterep-public"],
  "claim_repos": ["Nishfleet/fleet-ops", "Nishfleet/0509", "Nishfleet/inish-site", "Nishfleet/seo-fix-kit", "Nishfleet/TinyStudio.io", "Nishfleet/tinystudio-in", "Nishfleet/siterep-public"],
  "hands_off": []
}
JSON
    log "wrote default $REPOS_JSON"
}

# Read the repos config with jq once.
queue_repos=$(jq -r '.queue_repos[]' "$REPOS_JSON")
claim_repos=$(jq -r '.claim_repos[]' "$REPOS_JSON")
hands_off=$(jq -r '.hands_off[]' "$REPOS_JSON" 2>/dev/null || true)

# Derive the timer verification list from the declared intake repo set. The
# reconciler (bin/intake-reconcile) uses config/intake-repos.json as the single
# source of truth for enrolment; heartbeat §5 must use the same source or its
# verify list drifts the moment a repo is added/removed (fleet-ops#156 finding 9).
INTAKE_REPOS_JSON="${FLEET_INTAKE_REPOS_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"
[ -f "$INTAKE_REPOS_JSON" ] || { log "FATAL: $INTAKE_REPOS_JSON missing"; exit 2; }
jq empty "$INTAKE_REPOS_JSON" >/dev/null 2>&1 || { log "FATAL: $INTAKE_REPOS_JSON invalid JSON"; exit 2; }
verify_timers=$(jq -r '.repos[]? | "pi-scout@\(.name).timer", "pi-intake@\(.name).timer"' "$INTAKE_REPOS_JSON")

# is_hands_off <repo>
is_hands_off() {
    local r="$1"
    while IFS= read -r ho; do
        [ -z "$ho" ] && continue
        [ "$ho" = "$r" ] && return 0
    done <<< "$hands_off"
    return 1
}

# --- merge-to-live deploy step (fleet-ops#149) -----------------------------
DEPLOY_CHECKOUT="${FLEET_OPS_CHECKOUT:-}"
if [ -z "$DEPLOY_CHECKOUT" ]; then
    DEPLOY_CHECKOUT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
fi
DEPLOY_AUDIT_LOG="${FLEET_OPS_DEPLOY_AUDIT_LOG:-$LOG_DIR/deploy-audit.log}"
mkdir -p "$(dirname "$DEPLOY_AUDIT_LOG")"

deploy_audit() {
    local unit="$1" action="$2" why="$3"
    printf '%s %s %s actor=heartbeat-deploy why=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$unit" "$action" "$why" >> "$DEPLOY_AUDIT_LOG"
}

# Update the deploy checkout to origin/main, run install.sh, reconcile the
# declared per-repo set, and run the drift canary. Any divergence is LOUD and
# fails the unit (exit 1), matching the agent-scheduler-drift pattern.
deploy_step() {
    log "0. deploy step starting: checkout=$DEPLOY_CHECKOUT"

    if [ ! -d "$DEPLOY_CHECKOUT/.git" ]; then
        loud "DEPLOY-CHECKOUT-MISSING" "no git checkout at $DEPLOY_CHECKOUT"
        return 1
    fi

    if ! git -C "$DEPLOY_CHECKOUT" fetch origin >/dev/null 2>&1; then
        loud "DEPLOY-FETCH" "git fetch origin failed at $DEPLOY_CHECKOUT"
        return 1
    fi

    local ahead=0
    ahead=$(git -C "$DEPLOY_CHECKOUT" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)

    local dirty=""
    if ! dirty=$(git -C "$DEPLOY_CHECKOUT" status --porcelain --untracked-files=no 2>/dev/null); then
        loud "DEPLOY-STATUS" "git status failed at $DEPLOY_CHECKOUT"
        return 1
    fi

    local nonff=0
    if ! git -C "$DEPLOY_CHECKOUT" merge-base --is-ancestor HEAD origin/main >/dev/null 2>&1; then
        nonff=1
    fi

    local reasons=()
    [ "$ahead" -gt 0 ] && reasons+=("origin/main ahead by $ahead")
    [ -n "$dirty" ] && reasons+=("dirty tracked files")
    [ "$nonff" = 1 ] && reasons+=("checkout not an ancestor of origin/main (hot-patch/diverged)")
    if [ "${#reasons[@]}" -gt 0 ]; then
        local why
        why=$(printf '%s; ' "${reasons[@]}" | sed 's/; $//')
        loud "DEPLOY-BLOCKED" "merge-to-live blocked at $DEPLOY_CHECKOUT: $why"
        deploy_audit "fleet-ops" "deploy-blocked" "$why"
        return 1
    fi

    if [ "$ahead" -gt 0 ]; then
        if ! git -C "$DEPLOY_CHECKOUT" merge --ff-only origin/main >/dev/null 2>&1; then
            loud "DEPLOY-MERGE" "git merge --ff-only origin/main failed at $DEPLOY_CHECKOUT"
            return 1
        fi
        local newhead
        newhead=$(git -C "$DEPLOY_CHECKOUT" rev-parse --short HEAD)
        log "0. deploy checkout merged origin/main -> $newhead"
        deploy_audit "fleet-ops" "merge" "origin/main to $newhead"
    else
        log "0. deploy checkout up to date"
    fi

    # Run install.sh idempotently.
    local install_out="" install_rc=0
    if install_out=$("$DEPLOY_CHECKOUT/install.sh" 2>&1); then
        install_rc=0
    else
        install_rc=$?
        loud "DEPLOY-INSTALL" "install.sh failed (rc=$install_rc): $install_out"
        deploy_audit "fleet-ops" "install-failed" "rc=$install_rc"
        return 1
    fi
    if [ -n "$install_out" ]; then
        log "0. install.sh output: $install_out"
    fi
    deploy_audit "fleet-ops" "install" "ok"

    # Converge the per-repo declared set. Failures are best-effort here: the
    # drift canary below is the authoritative pass/fail on live state.
    local recon_out="" recon_rc=0
    if [ -x "$DEPLOY_CHECKOUT/bin/intake-reconcile" ]; then
        if recon_out=$(INTAKE_RECONCILE_INTAKE_JSON="$DEPLOY_CHECKOUT/config/intake-repos.json" "$DEPLOY_CHECKOUT/bin/intake-reconcile" 2>&1); then
            if [ -n "$recon_out" ]; then
                log "0. intake-reconcile output: $recon_out"
            fi
            deploy_audit "fleet-ops" "intake-reconcile" "ok"
        else
            recon_rc=$?
            loud "DEPLOY-RECONCILE" "intake-reconcile failed (rc=$recon_rc): $recon_out"
            deploy_audit "fleet-ops" "intake-reconcile-failed" "rc=$recon_rc"
        fi
    else
        log "0. intake-reconcile not present in checkout — skip"
    fi

    # Run the drift canary. Any divergence fails the unit loud.
    local canary canary_out
    canary="${FLEET_OPS_DRIFT_BIN:-/home/nish/.local/bin/fleet-ops-drift}"
    if [ -x "$canary" ]; then
        if canary_out=$(FLEET_OPS_CHECKOUT="$DEPLOY_CHECKOUT" FLEET_OPS_AUDIT_LOG="$DEPLOY_AUDIT_LOG" "$canary" 2>&1); then
            if [ -n "$canary_out" ]; then
                log "0. drift canary output: $canary_out"
            fi
        else
            if [ -n "$canary_out" ]; then
                log "0. drift canary failed: $canary_out"
            fi
            # Loud output already written by canary.
            return 1
        fi
    else
        log "0. drift canary not installed at $canary — skip"
    fi

    log "0. deploy step complete"
    deploy_audit "fleet-ops" "drift-ok" "checkout-and-installed-state-match-main"
    return 0
}

# ============================================================================
# 0. MERGE-TO-LIVE DEPLOY + DRIFT CANARY (fleet-ops#149)
# ============================================================================
# Before any orchestration work, make sure the installed units are exactly
# what origin/main declares. A dirty tracked file, non-ff branch, or install
# drift blocks the update with a LOUD line — no reset, no stash, no silent
# deployment around it.
deploy_rc=0
deploy_step || deploy_rc=$?

# ============================================================================
# 1. UPDATE last-heartbeat: LINE IN PLAN FILE
# ============================================================================
# The freshness guard (in fleet-heartbeat) already proved this line is
# >20 min old. We update it in place: only the timestamp portion of the
# matching line, never the prefix, never the rest of the file.
new_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
if grep -qE '^last-heartbeat:' "$PLAN_FILE"; then
    # sed in place, anchored to start-of-line, only on the matching line.
    # Use a python one-liner for portability — sed -i differs across GNU/BSD.
    python3 - "$PLAN_FILE" "$new_ts" <<'PY'
import sys, re
path, ts = sys.argv[1], sys.argv[2]
with open(path, 'r', encoding='utf-8') as f:
    lines = f.readlines()
new = []
hit = False
for ln in lines:
    if not hit and re.match(r'^last-heartbeat:', ln):
        new.append(f'last-heartbeat: {ts} (durable-timer)\n')
        hit = True
    else:
        new.append(ln)
if not hit:
    # Should not happen — fleet-heartbeat created it. Append just in case.
    new.append(f'\nlast-heartbeat: {ts} (durable-timer)\n')
with open(path, 'w', encoding='utf-8') as f:
    f.writelines(new)
PY
    log "1. last-heartbeat updated to $new_ts"
else
    log "1. WARN: no last-heartbeat: line found in plan file (freshness guard expected one)"
fi

# ============================================================================
# 2. QUEUE GREEN FLEET-AUTHORED PRS
# ============================================================================
# For each repo in queue_repos:
#   - list open PRs whose head ref matches a fleet worker prefix
#   - skip hands-off
#   - if all required checks green + mergeable -> enable auto-merge
#
# Fleet worker prefixes (data, not code, so the list can grow):
#   claim/issue-*    -> standard pi-issue worker PR
#   p<N>/*           -> packet branches
#   lane*/           -> lane worker branches
#   revert/          -> auto-revert worker
#   dependabot/      -> leave to dependabot policy; we skip
#
# We only queue PRs whose headRef starts with claim/issue- or p<digit>/
# or lane<digit>- or revert/. The full gate proof is `gh pr checks` returning
# all PASS.
queued=0
skipped=0
log "2. queue pass starting"
while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    if is_hands_off "$repo"; then
        log "2.  - $repo: HANDS-OFF, skipping queue pass"
        continue
    fi

    # Fetch open PRs. --jq filters to fleet-worker head refs and excludes
    # dependabot (handled by its own policy).
    prs_json=$(gh pr list -R "$repo" --state open \
        --json number,headRefName,isDraft,mergeable \
        --jq '[.[] | select((.headRefName | startswith("claim/issue-")) or (.headRefName | test("^(p[0-9]+|lane[0-9]+|revert)/")))]' \
        2>/dev/null) || {
            log "2.  - $repo: gh pr list FAILED — skipping (auth/network?)"
            continue
        }

    # Empty array?
    pr_count=$(printf '%s' "$prs_json" | jq 'length')
    if [ "$pr_count" = "0" ]; then
        log "2.  - $repo: no fleet-worker PRs open"
        continue
    fi

    # For each PR, check status and queue if green.
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        pr_num=$(printf '%s' "$row" | jq -r '.number')
        pr_head=$(printf '%s' "$row" | jq -r '.headRefName')
        pr_draft=$(printf '%s' "$row" | jq -r '.isDraft')
        # pr_mergeable comes from the same PR row but we gate on check status,
        # not the mergeable flag (a red PR can still report mergeable=true on
        # GitHub while checks are pending; we trust checks). Read it so shellcheck
        # doesn't flag SC2034, and so the next operator can wire it as an
        # additional gate without re-parsing the row.
        pr_mergeable=$(printf '%s' "$row" | jq -r '.mergeable')
        : "${pr_mergeable:=UNKNOWN}"

        if [ "$pr_draft" = "true" ]; then
            log "2.  - $repo#$pr_num ($pr_head): DRAFT — skip"
            skipped=$((skipped+1))
            continue
        fi

        # Check the status: count checks; all must be SUCCESS (no FAILURE,
        # no PENDING). If there are no required checks at all, treat as not
        # mergeable (defensive).
        checks_json=$(gh pr checks "$pr_num" -R "$repo" --json name,bucket,state 2>/dev/null) || {
            log "2.  - $repo#$pr_num ($pr_head): gh pr checks FAILED — skip"
            skipped=$((skipped+1))
            continue
        }
        n_total=$(printf '%s' "$checks_json" | jq 'length')
        if [ "$n_total" = "0" ]; then
            log "2.  - $repo#$pr_num ($pr_head): NO CHECKS — skip (no auto-merge)"
            skipped=$((skipped+1))
            continue
        fi
        n_fail=$(printf '%s' "$checks_json" | jq '[.[] | select(.bucket == "fail" or .state == "FAILURE" or .state == "ERROR")] | length')
        n_pending=$(printf '%s' "$checks_json" | jq '[.[] | select(.state == "PENDING" or .state == "QUEUED")] | length')
        if [ "$n_fail" != "0" ] || [ "$n_pending" != "0" ]; then
            log "2.  - $repo#$pr_num ($pr_head): not green (fail=$n_fail pending=$n_pending) — skip"
            skipped=$((skipped+1))
            continue
        fi

        # Green: enable auto-merge (squash is the fleet default; matches
        # 0509's ruleset config and every other repo's branch protection).
        # --auto is idempotent: if already set, gh exits 0 with a notice.
        if gh pr merge "$pr_num" -R "$repo" --auto --squash >/dev/null 2>&1; then
            log "2.  - $repo#$pr_num ($pr_head): AUTO-MERGE armed"
            queued=$((queued+1))
        else
            log "2.  - $repo#$pr_num ($pr_head): gh pr merge --auto FAILED — skip"
            skipped=$((skipped+1))
        fi
    done < <(printf '%s' "$prs_json" | jq -c '.[]')
done <<< "$queue_repos"
log "2. queue pass complete: queued=$queued skipped=$skipped"

# ============================================================================
# 3. RELEASE ORPHANED CLAIMS
# ============================================================================
# Definition of orphaned claim:
#   - issue has label agent-in-progress
#   - no pi-issue@<repo>-<issue> unit is currently running
#   - no open claim/issue-<issue> PR exists on the repo
#
# Action:
#   - delete the claim branch
#   - flip label: agent-in-progress -> agent-ready
#   - comment on the issue noting the heartbeat release
#
# Safety: if the issue is closed, skip the label flip (just clean up).
released=0
log "3. orphan-pass starting"
while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    short=$(printf '%s' "$repo" | awk -F/ '{print $2}')

    issues_json=$(gh issue list -R "$repo" -l agent-in-progress --state open \
        --json number,title --jq '.[]' 2>/dev/null) || {
            log "3.  - $repo: gh issue list FAILED — skip"
            continue
        }

    while IFS= read -r issue_row; do
        [ -z "$issue_row" ] && continue
        issue_n=$(printf '%s' "$issue_row" | jq -r '.number')

        # Is a pi-issue worker for this claim currently doing work?
        # fleet-ops#63: --state=running misses both activating/start
        # (a worker that is just now launching pi — held, busy) AND
        # activating/auto-restart (a crash-loop waiting for its next
        # RestartSec window — held, degraded). The old check would
        # release the claim of BOTH cases and strand the issue with no
        # worker and no label-flip path (the worker would just come back,
        # or the reap would fire and skip a live claim). Hold the lane in
        # both cases; the heartbeat tier 1 §7 surfaces auto-restart units
        # as DEGRADED so the operator and tier 2 can see the real state
        # without mistaking it for an orphan.
        unit="pi-issue@${short}-${issue_n}.service"
        if systemctl --user list-units "$unit" --state=active,activating --no-legend 2>/dev/null \
            | awk '{print $1}' | grep -qx "$unit"; then
            sub=$(systemctl --user show "$unit" --property=SubState --value 2>/dev/null || echo unknown)
            case "$sub" in
                auto-restart)
                    log "3.  - $repo#$issue_n: worker $unit DEGRADED (sub=$sub) — not orphan, lane held (heartbeat §7 will publish)"
                    ;;
                *)
                    log "3.  - $repo#$issue_n: worker $unit LIVE (sub=$sub) — not orphan"
                    ;;
            esac
            continue
        fi
        # Also check transient fable-p* that may be working on it.
        if systemctl --user list-units --no-legend --type=service --state=running 2>/dev/null \
            | awk '{print $1}' | grep -E "(fable-p|pi-issue)" | grep -q "${short}-${issue_n}"; then
            log "3.  - $repo#$issue_n: transient worker active — not orphan"
            continue
        fi

        # Open PR from claim/issue-<N>?
        if gh pr list -R "$repo" --head "claim/issue-${issue_n}" --state open --json number 2>/dev/null \
            | jq -e 'length > 0' >/dev/null 2>&1; then
            log "3.  - $repo#$issue_n: open claim PR exists — not orphan (leave to queue pass)"
            continue
        fi

        # Orphan. Release it.
        branch="claim/issue-${issue_n}"
        if gh api "repos/${repo}/git/refs/heads/${branch}" >/dev/null 2>&1; then
            if gh api "repos/${repo}/git/refs/heads/${branch}" -X DELETE >/dev/null 2>&1; then
                log "3.  - $repo#$issue_n: deleted branch $branch"
            else
                log "3.  - $repo#$issue_n: branch delete FAILED ($branch) — will retry next tick"
                continue
            fi
        fi

        if gh issue edit "$issue_n" -R "$repo" \
            --remove-label agent-in-progress --add-label agent-ready 2>/dev/null; then
            gh issue comment "$issue_n" -R "$repo" \
                --body "claim branch released by fleet-heartbeat at $(date -u +%FT%TZ) (no live worker, no open PR)" \
                >/dev/null 2>&1 || true
            log "3.  - $repo#$issue_n: RELEASED -> agent-ready"
            released=$((released+1))
        else
            log "3.  - $repo#$issue_n: label flip FAILED — will retry next tick"
        fi
    done <<< "$issues_json"
done <<< "$claim_repos"
log "3. orphan-pass complete: released=$released"

# ============================================================================
# 4. RECOVER / LOG FAILED FLEET UNITS
# ============================================================================
# Tier 1 now owns the failed-unit pass. For every fleet-owned unit in
# --state=failed we record it, classify it, and either:
#   - recover: reset-failed + start (supply/repair units only — see
#     unit_recovery_class), bounded by FAILED_UNITS_MAX_ATTEMPTS, or
#   - observe: log + surface, no restart (workers + reaps; their OnFailure
#     reap and intake re-dispatch are the retry path).
# Non-transient faults (dead provider, code bug) and exhausted recovery
# attempts are written to the triage file as LOUD lines so tier 2 / humans
# see them — a unit never ends in a quiet failed state.
#
# The 2026-08-25 incident (#28): pi-intake-repair@0509.service failed with a
# Devin rate limit at 23:16:54 IST. Heartbeat ran 57 seconds later but its
# matcher only looked at pi-issue-* and fable-p* (hyphen), so it matched
# neither the template instance pi-issue@* (at-sign) nor the repair unit
# pi-intake-repair@*. The unit was invisible and was cleared by hand. The
# matcher below now covers every fleet worker / repair / cleanup unit
# instance, and the reset+start floor does not depend on any agent lane
# being healthy.
#
# Idempotency: a per-unit JSON state file tracks attempts and escalation so
# the N-attempt ceiling is real and the triage file is not spammed.
seen=0
repaired=0
requeued=0
still_failed=0
exhausted=0
escd=0
current_failed_units=""
log "4. failed-units pass starting"

mapfile -t failed_units < <(systemctl --user --state=failed --no-legend 2>/dev/null \
    | awk '{print $1}' \
    | grep -E '^(pi-(intake|intake-repair|scout|scout-repair|packet|packet-failed|issue|issue-failed)@|fable-p)' \
    || true)

for unit in "${failed_units[@]}"; do
    [ -z "$unit" ] && continue
    current_failed_units="${current_failed_units}${unit}"$'\n'

    # Read enough journal to classify and leave an audit breadcrumb.
    journal=$(journalctl --user -u "$unit" -n 50 --no-pager -q 2>/dev/null || true)
    excerpt=$(printf '%s' "$journal" | tr '\n' ' ' | head -c 400 || true)
    cls=$(classify_failure "$journal")
    log "4.  - $unit: seen class=$cls"

    state_f=$(unit_state_file "$unit")
    state_update "$state_f" "$unit" "$cls" "seen" true

    seen=$((seen+1))
    rclass=$(unit_recovery_class "$unit")

    # Non-transient failures: hand to tier 2 via triage. Deduplicate so the
    # same unit does not generate a new line every 30 minutes. Applies to
    # both recover- and observe-class units — a dead provider or a code bug
    # is not fixed by a restart.
    if [ "$cls" = "llm-dead" ] || [ "$cls" = "code-fail" ] || [ "$cls" = "unknown" ]; then
        tag="CODE-FAIL"
        [ "$cls" = "llm-dead" ] && tag="LLM-DEAD"
        if ! already_in_triage "$tag" "$unit"; then
            triage_remove_unit "$unit"
            read -r provider model < <(unit_seat "$unit")
            loud "$tag" "unit=$unit provider=$provider model=$model class=$cls excerpt=${excerpt:-<none>}"
            state_update "$state_f" "$unit" "$cls" "escalated" true "" true
            escd=$((escd+1))
        fi
        still_failed=$((still_failed+1))
        continue
    fi

    # Transient lane fault or start-limit from here on. observe-class units
    # (workers + reaps) must NOT be reset+started here: their OnFailure reap
    # releases the claim and intake re-dispatches, so a heartbeat restart
    # would race a second worker onto the same issue. Surface and stop.
    if [ "$rclass" = "observe" ]; then
        log "4.  - $unit: observe-only class=$cls — no restart (reap/intake is the retry path)"
        still_failed=$((still_failed+1))
        continue
    fi

    # recover-class: try reset + start, bounded by FAILED_UNITS_MAX_ATTEMPTS.
    attempts=$(state_get "$state_f" "attempts" "0")
    if [ "$attempts" -ge "$FAILED_UNITS_MAX_ATTEMPTS" ]; then
        if ! already_in_triage "UNIT-ESCALATE" "$unit"; then
            triage_remove_unit "$unit"
            loud "UNIT-ESCALATE" "unit=$unit class=$cls attempts=$attempts recovery exhausted (max=$FAILED_UNITS_MAX_ATTEMPTS) — needs manual seat or code fix"
            state_update "$state_f" "$unit" "$cls" "exhausted" true "$attempts" true
            exhausted=$((exhausted+1))
        fi
        still_failed=$((still_failed+1))
        continue
    fi

    log "4.  - $unit: reset-failed + start --no-block (attempt=$((attempts+1))/$FAILED_UNITS_MAX_ATTEMPTS)"
    if systemctl --user reset-failed "$unit" 2>/dev/null; then
        if systemctl --user start --no-block "$unit" 2>/dev/null; then
            # Give systemd a moment to start the job and either run or fail.
            sleep 2
            active_state=$(systemctl --user show "$unit" --property=ActiveState --value 2>/dev/null || true)
            log "4.  - $unit: ActiveState=$active_state after start"
            if [ "$active_state" = "failed" ]; then
                new_attempts=$((attempts+1))
                state_update "$state_f" "$unit" "$cls" "reset+start" true "$new_attempts" false
                still_failed=$((still_failed+1))
                if [ "$new_attempts" -ge "$FAILED_UNITS_MAX_ATTEMPTS" ]; then
                    if ! already_in_triage "UNIT-ESCALATE" "$unit"; then
                        triage_remove_unit "$unit"
                        loud "UNIT-ESCALATE" "unit=$unit class=$cls attempts=$new_attempts recovery exhausted after reset+start — needs manual seat or code fix"
                        state_update "$state_f" "$unit" "$cls" "exhausted" true "$new_attempts" true
                        exhausted=$((exhausted+1))
                    fi
                fi
            elif [ "$active_state" = "inactive" ]; then
                triage_remove_unit "$unit"
                log "4.  - $unit: RECOVERED"
                loud "UNIT-RECOVERED" "unit=$unit recovered (class=$cls, failed_attempts=$attempts)"
                state_remove "$state_f"
                repaired=$((repaired+1))
            else
                # activating, active, or unknown: the job is queued/running.
                triage_remove_unit "$unit"
                log "4.  - $unit: start queued (ActiveState=$active_state, not failed)"
                state_update "$state_f" "$unit" "$cls" "reset+start-queued" false "$((attempts+1))" false
                requeued=$((requeued+1))
            fi
        else
            log "4.  - $unit: start --no-block failed"
            state_update "$state_f" "$unit" "$cls" "start-failed" true "$((attempts+1))" false
            still_failed=$((still_failed+1))
        fi
    else
        log "4.  - $unit: reset-failed failed"
        state_update "$state_f" "$unit" "$cls" "reset-failed-failed" true "$((attempts+1))" false
        still_failed=$((still_failed+1))
    fi
done

# Clean up state files for units that are no longer failed or active.
shopt -s nullglob
for f in "$FAILED_UNITS_STATE_DIR"/*.json; do
    [ -f "$f" ] || continue
    u=$(jq -r '.unit // empty' "$f" 2>/dev/null || true)
    [ -n "$u" ] || continue
    if printf '%s' "$current_failed_units" | grep -qxF "$u"; then
        continue
    fi
    as=$(systemctl --user show "$u" --property=ActiveState --value 2>/dev/null || true)
    if [ "$as" = "failed" ] || [ "$as" = "activating" ] || [ "$as" = "active" ]; then
        continue
    fi
    # inactive, condition-skip, dead, or gone: recovery worked or unit stopped.
    rm -f "$f"
done
shopt -u nullglob

log "4. failed-units pass complete: seen=$seen repaired=$repaired requeued=$requeued still_failed=$still_failed exhausted=$exhausted escd=$escd"

# ============================================================================
# 5. VERIFY SCOUT / INTAKE TIMERS ARMED
# ============================================================================
# If a fleet-supply timer is disabled, supply stops. Re-enable + log loud.
# (Hands-off list is not respected here: these are fleet-internal timers
#  the fleet itself owns, not user code.)
verified=0
re_enabled=0
log "5. timer-arm pass starting"
while IFS= read -r t; do
    [ -z "$t" ] && continue
    state=$(systemctl --user is-enabled "$t" 2>/dev/null || echo unknown)
    # Is the timer actually scheduled to fire? Show property gives us both
    # the enabled state and the next elapse; --all shows paused/stopped too.
    next_us=$(systemctl --user show "$t" --property=NextElapseUSecRealtime --value 2>/dev/null || echo "")
    active=$(systemctl --user show "$t" --property=ActiveState --value 2>/dev/null || echo unknown)

    if [ "$state" = "enabled" ] && [ -n "$next_us" ] && [ "$next_us" != "0" ]; then
        log "5.  - $t: ENABLED active=$active next=${next_us}"
        verified=$((verified+1))
        continue
    fi

    if [ "$state" != "enabled" ]; then
        loud "TIMER-DISABLED" "$t is $state — re-enabling + starting"
        if ! systemctl --user enable --now "$t" 2>/dev/null; then
            loud "TIMER-REENABLE-FAIL" "$t could not be re-enabled ($state) — manual fix needed"
            continue
        fi
        re_enabled=$((re_enabled+1))
        continue
    fi

    # enabled but no Next firing — likely paused or stale. Start it.
    loud "TIMER-NO-NEXT" "$t is enabled (state=$state active=$active) but no Next firing — starting it"
    systemctl --user start "$t" 2>/dev/null || {
        loud "TIMER-START-FAIL" "$t start failed — manual fix needed"
        continue
    }
    re_enabled=$((re_enabled+1))
done <<< "$verify_timers"
log "5. timer-arm pass complete: verified=$verified re_enabled=$re_enabled"

# ============================================================================
# 6. RECONCILE agent-blocked ISSUES
# ============================================================================
# Named reason for this sweep (vault: "a schedule needs a NAMED reason"):
# the blocking condition changes outside the repo — a dependency issue/PR
# closes, or Nish answers. Event-driven is the default, but the
# nishfleet-worker App has no webhooks (credentials/app-manifest.json
# events=[]), so there is no event to subscribe to. Heartbeat's existing
# 30-minute timer is the observer; this is not a new schedule.
BLOCKED_BIN="${FLEET_BLOCKED_RECONCILE:-/home/nish/.local/bin/blocked-reconcile}"
if [ -x "$BLOCKED_BIN" ]; then
    log "6. blocked-reconcile starting"
    if BLOCKED_RECONCILE_REPOS="$(printf '%s\n' "$claim_repos")" \
        BLOCKED_RECONCILE_TRIAGE="$TRIAGE" \
        BLOCKED_RECONCILE_STATE="$LOG_DIR/blocked-queue.json" \
        BLOCKED_RECONCILE_LOCKDIR="${XDG_RUNTIME_DIR}/blocked-reconcile" \
        "$BLOCKED_BIN"; then
        log "6. blocked-reconcile done"
    else
        log "6. blocked-reconcile FAILED — next tick retries"
    fi
else
    log "6. blocked-reconcile missing at $BLOCKED_BIN — skip (not installed)"
fi

# ============================================================================
# 7. DEGRADED-LANE REPORT (fleet-ops#63)
# ============================================================================
# For every pi-issue-* unit in activating/auto-restart state, publish a
# LOUD triage line. These workers hold their claim branch and their
# agent-in-progress label (the orphan sweep must NOT reap them — the
# worker is between crashes, the StartLimitBurst path is the right
# release trigger, not the heartbeat), but they do no work. Without this
# pass, every angle the fleet exposes — queue count, list-units, the
# heartbeat's own logs — reported them as indistinguishable from a
# genuinely running worker. "5 issues agent-in-progress, 4 doing nothing"
# was the live symptom.
#
# This is OBSERVABILITY, not a fix path: StartLimitBurst=3 / RestartSec=
# are the source of truth on whether the unit will give up, and
# pi-issue-failed@ (OnFailure) is the right release path. The heartbeat
# surfaces the degraded count; tier 2 may escalate via [LOUD] if the
# number crosses a threshold.
degraded=0
degraded_units=""
log "7. degraded-lane pass starting"
while IFS= read -r u; do
    [ -z "$u" ] && continue
    # Limit scope to fleet worker units (template-instances and transients).
    case "$u" in
        pi-issue-*|fable-p*) : ;;  # match
        *) continue ;;
    esac
    sub=$(systemctl --user show "$u" --property=SubState --value 2>/dev/null || echo unknown)
    if [ "$sub" = "auto-restart" ]; then
        degraded=$((degraded+1))
        # Pull the last journal line for the breadcrumb (truncated).
        excerpt=$(journalctl --user -u "$u" -n 1 --no-pager -q 2>/dev/null \
                    | tr '\n' ' ' | head -c 200 || true)
        if [ -z "$degraded_units" ]; then
            degraded_units="$u sub=auto-restart :: ${excerpt:-<no-journal>}"
        else
            degraded_units="${degraded_units} | $u sub=auto-restart :: ${excerpt:-<no-journal>}"
        fi
        log "7.  - $u :: auto-restart (held, no work — wait for StartLimitBurst / OnFailure)"
    fi
done < <(systemctl --user list-units 'pi-issue-*.service' 'pi-packet-*.service' 'fable-p*.service' --state=activating --no-legend 2>/dev/null \
            | awk '{print $1}' \
            | grep -E '^(pi-issue-|pi-packet-|fable-p)' || true)
log "7. degraded-lane pass complete: degraded=$degraded"
if [ "$degraded" -gt 0 ]; then
    loud "DEGRADED-LANES" "degraded=$degraded :: ${degraded_units}"
fi

# ============================================================================
# 8. UNDERSATURATION ALARM + THROUGHPUT LINE (fleet-ops#75)
# ============================================================================
# Delegates to bin/fleet-heartbeat-undersaturation. The helper counts ready/
# claimed work vs live pi-issue workers; on a wedge (work>0, running==0) it
# repairs on the first tick and fails LOUD on the second consecutive one. It
# also emits a per-tick THROUGHPUT line. A non-zero exit here propagates so
# fleet-heartbeat.service lands in --state=failed (page + Telegram) — that is
# the deliberate fail-loud signal, not an error to swallow.
UNDERSAT_BIN="${FLEET_HEARTBEAT_UNDERSAT:-/home/nish/.local/bin/fleet-heartbeat-undersaturation}"
undersat_rc=0
if [ -x "$UNDERSAT_BIN" ]; then
    log "8. undersaturation+throughput pass starting"
    if "$UNDERSAT_BIN"; then
        log "8. undersaturation pass complete"
    else
        undersat_rc=$?
        log "8. undersaturation: FAIL LOUD (rc=$undersat_rc) — second consecutive wedged tick; unit will land in --state=failed"
    fi
else
    log "8. undersaturation helper missing at $UNDERSAT_BIN — skip (not installed)"
fi

# ============================================================================
# 9. LOW-WATER-MARK SCOUTING (fleet-ops#146)
# ============================================================================
# Supply cadence is the constraint, not lanes. The 4h scout timer refills
# AFTER lanes drain, scheduling a starvation gap every cycle (measured
# 2026-08-26: feast ~40min, famine ~3h20m). This pass treats the ready
# queue as a producer-consumer buffer with a low-water mark: when ready <
# lane ceiling (seat_max_concurrent — fewer ready items than lanes means
# starvation is already scheduled) and no scout is running for that repo
# and the per-repo threshold stamp is stale (>2h), start pi-scout@<repo>
# now so replenishment overlaps consumption. The 4h timer stays as the
# floor; this only pulls a scout LOOK sooner. Quality bar unchanged — the
# scout's own ExecCondition + spec gate decide what qualifies as work; an
# empty pass is a valid logged outcome and never manufactures make-work.
#
# This is a best-effort supply nudge, NOT a fail-loud alarm (that is block
# 8). The helper exits 2 only on a CONFIG error (missing intake-repos.json
# / jq / seat-lib); we log its rc and let the helper write its own LOUD
# triage line, but we do NOT propagate — a broken refill nudge must not
# stop PR queuing, orphan reclaim, or the wedge alarm. undersaturation's
# fail-loud still wins the unit's exit code.
LOW_WATER_BIN="${FLEET_HEARTBEAT_LOW_WATER:-/home/nish/.local/bin/fleet-heartbeat-low-water-mark}"
low_water_rc=0
if [ -x "$LOW_WATER_BIN" ]; then
    log "9. low-water-mark scouting pass starting"
    if "$LOW_WATER_BIN"; then
        log "9. low-water-mark pass complete"
    else
        low_water_rc=$?
        log "9. low-water-mark: CONFIG error (rc=$low_water_rc) — logged + LOUD triage line written; not propagated (best-effort nudge)"
    fi
else
    log "9. low-water-mark helper missing at $LOW_WATER_BIN — skip (not installed)"
fi

# ============================================================================
# done
# ============================================================================
log "tier 1 complete: queued=$queued orphan_released=$released failed_seen=$seen failed_repaired=$repaired failed_requeued=$requeued failed_still_failed=$still_failed failed_exhausted=$exhausted failed_escalated=$escd timers_verified=$verified timers_re_enabled=$re_enabled degraded=$degraded undersat_rc=$undersat_rc low_water_rc=$low_water_rc deploy_rc=$deploy_rc"
if [ "$deploy_rc" -ne 0 ]; then
    exit "$deploy_rc"
fi
if [ "$undersat_rc" -ne 0 ]; then
    exit "$undersat_rc"
fi
exit 0
