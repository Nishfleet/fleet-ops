# ============================================================================
# 14. RAM MEASUREMENT (fleet-ops#45) + metric compare (fleet-ops#202)
# ============================================================================
# Mechanical re-measurement of peak RSS across fleet worker units. The
# 1.5 in seat-caps.json's ram_gb_per_worker is the floor; a re-derive
# is `ram-measure` + jq over $RAM_STATE_DIR/ram-measurement.json. The
# single one-line stdout (mean/median/p95/max in GiB) is logged to the
# tick log so a trend is visible from the journal alone. The script is
# a pure observer — it never fails the tick, never escalates, never
# touches the cap map. Drift between the live memory.current p95*3 and
# ram_gb_per_worker is a HUMAN action (re-derive from a fresh
# ram-metric-compare, then a PR). fleet-ops#489 keeps memory.current.
#
# ram-metric-compare (fleet-ops#202) then samples live pi-issue@ units
# for BOTH cgroup memory.current and process VmRSS, so the 35 MB vs
# ~800 MB mismatch cannot silently return as "RSS means cgroup". It
# also never edits the cap map.
#
# Skipped silently if ram-measure is not installed; the .local/bin
# symlink is a fleet-ops install step (MANIFEST + ./install.sh), so a
# missing binary is a config drift, not a code bug.
ram_measure_rc=0
RAM_BIN="${FLEET_RAM_MEASURE_BIN:-/home/nish/.local/bin/ram-measure}"
if require_manifest_helper "$RAM_BIN"; then
    if ram_summary="$("$RAM_BIN" 2>/dev/null)"; then
        log "14. ram-measure: $ram_summary"
    else
        # Measurement is observability; an unexpected non-zero here is
        # logged but does NOT fail the tick.
        _ram_rc=$?
        log "14. ram-measure: non-zero exit (rc=$_ram_rc) — state file may be stale"
    fi
else
    _req=$?
    if [ "$_req" -eq 1 ]; then
        loud "HELPER-MISSING" "ram-measure helper missing at $RAM_BIN — MANIFEST dest; silent skip disabled the RAM measurement pass (fleet-ops#485)"
        ram_measure_rc=1
    else
        log "14. ram-measure helper missing at $RAM_BIN — skip (not installed; re-run ./install.sh)"
    fi
fi
COMPARE_BIN="${FLEET_RAM_COMPARE_BIN:-/home/nish/.local/bin/ram-metric-compare}"
if [ -x "$COMPARE_BIN" ]; then
    if compare_summary="$("$COMPARE_BIN" 2>/dev/null)"; then
        log "14. ram-metric-compare: $compare_summary"
    else
        log "14. ram-metric-compare: non-zero exit (rc=$?) — state file may be stale"
    fi
else
    log "14. ram-metric-compare helper missing at $COMPARE_BIN — skip (not installed; re-run ./install.sh)"
fi

