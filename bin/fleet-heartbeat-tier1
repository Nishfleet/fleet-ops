# ============================================================================
# 15. ESCALATION COVERAGE CANARY (fleet-ops#152)
# ============================================================================
# Every tick, prove the two-plane invariant "every failure path lands in the
# escalation matrix" mechanically:
#   VPS plane  — every loaded user service inherits the unit-escalation drop-in
#                and no fleet pi execution path lives outside a systemd unit.
#   GitHub plane — every repo's red checks are covered by auto-revert,
#                #124 redispatch, or the red-check->senior-auditor bridge.
# The canary exits 0 when the only findings are the documented pending holes
# (#76 delivery, #124 guard, #152 bridge); it exits 1 on real coverage gaps
# and the unit lands in --state=failed like every other fail-loud block.
# Anti-recursion: the canary runs inside this unit (already escalation-covered)
# and creates no unit/OnFailure of its own.
CANARY_BIN="${FLEET_ESCALATION_CANARY:-/home/nish/.local/bin/fleet-escalation-canary}"
canary_rc=0
if require_manifest_helper "$CANARY_BIN"; then
    log "15. escalation-coverage canary starting"
    if "$CANARY_BIN"; then
        log "15. escalation-coverage canary complete"
    else
        canary_rc=$?
        log "15. escalation-coverage canary FAILED (rc=$canary_rc) — two-plane invariant violated; unit will land in --state=failed"
    fi
else
    _req=$?
