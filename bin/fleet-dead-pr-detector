#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# fleet-dead-pr-detector — flag open CONFLICTING PRs whose parent issue is
# already resolved (fleet-ops#4468).
#
# The class: an open PR that GitHub reports as `mergeable: CONFLICTING` but
# whose work was already shipped by a merged/closed fix on the default
# branch. Nothing detects it automatically — the branch sits red until a
# manual sweep. When its parent issue is MERGED or CLOSED the PR is dead:
# the branch cannot merge and its work already landed.
#
# Parent-originating issue resolution is deterministic, exact-number only
# (never substring; #11352 must not match issue 1135 — same convention as
# fleet-merged-pr-close). The body is scrubbed BEFORE any matching — refs
# that can never name a parent issue of the scanned repo are removed:
#   0. cross-repo qualified refs — `owner/repo#N`, `owner/repo #N` and
#      the short `repo#N` form, unless the ref is exactly the scanned repo
#      `Nishfleet/fleet-ops#N` or its short name `fleet-ops#N`. The keep is
#      the WHOLE token, never a path segment — an other-owner
#      `acme/fleet-ops#N` is still scrubbed
#   0b. PR-marked refs — `PR #N`/`PRs #N`, `pull #N`/`pulls #N`, `pull
#      request(s) #N`, `pull-request(s) #N` (any case): a PR reference is
#      never an issue parent. "Companion to Nishfleet/siterep-public PR
#      #36" thus leaves no refs and resolves no bogus fleet-ops parent #36
# Then, first match wins on the SCRUBBED body:
#   1. explicit delivery trailer in the body — `Closes|Fixes|Resolves
#      #N`, `Closed #N`, with an optional `<repo>#N` /
#      `<owner>/<repo>#N` prefix
#   2. `Relates to #N` in the body
#   3. head branch `claim/issue-<N>`
#   4. first bounded `#N` reference in the body (word-boundary, N >= 1,
#      optional repo prefix accepted)
# A CONFLICTING PR with no resolvable parent is NOT dead-classified — we
# cannot prove a resolved parent, so it is skipped, never guessed.
#
# Third class (fleet-ops#5205) — STALE-CONFLICTING: a decided-CONFLICTING PR
# whose parent is still OPEN is not dead, but a conflict left standing rots
# the branch, holds the parent's claim, and feeds the red-PR repair rail a
# failure shape no worker can fix (a conflict is not a red check). A PR
# joins the class when its conflict has stood longer than
# DEAD_PR_STALE_HOURS (default 24). Conflict age CANNOT come from GitHub —
# createdAt/updatedAt are branch age, and a PR can be created MERGEABLE and
# conflict later — so the detector keeps a first-seen marker per PR under
# its state dir (DEAD_PR_STATE_DIR, beside the red-pr-repair state) and
# prunes it the same way that state is pruned: the instant the PR leaves
# the class (goes MERGEABLE, dead-classifies, loses its resolvable parent,
# or leaves the open list) the marker is dropped by the same GC pass, and
# the flagged list is rewritten to exactly the currently-flagged set.
# Flagged members are also written to $STATE_DIR/stale-conflicting.list
# (one `<repo> <pr>` line each) which fleet-heartbeat-red-pr-repair
# consumes to suppress repair dispatches the flag has already proven
# futile.
#
# GitHub computes mergeability asynchronously: while undecided gh returns
# `mergeable: "UNKNOWN"` or null, and a future gh may return new values.
# Any value that is not exactly MERGEABLE or CONFLICTING is counted in the
# `unknown-mergeable` figure and kept in the scan — never silently dropped
# (fleet-ops#5079: a dead PR whose mergeable was still UNKNOWN read clean
# on a live tick). The `unknown-mergeable` figure is list-time: it counts
# VALUES seen at list time, not PRs still undecided — a PR the re-query
# then decides is still counted there, so the same PR can appear in both
# `conflicting` and `unknown-mergeable`. An undecided PR is re-queried with
# `gh pr view` — up to DEAD_PR_UNKNOWN_ATTEMPTS tries, DEAD_PR_UNKNOWN_SLEEP
# seconds between — and only a MERGEABLE/CONFLICTING answer ends the
# question. Still undecided after the retries, the parent decides:
# MERGED/CLOSED parent -> DEAD-PR-UNRESOLVED, exit 2, so the sweep can never
# read clean over a possible dead PR; OPEN parent -> logged and skipped (a
# live parent is never dead); no resolvable parent -> logged and skipped,
# consistent with the never-guess rule. A `gh pr view` that errors is
# fail-closed (exit 2), never a silent pass.
#
# Retry budget: bounded per PR at DEAD_PR_UNKNOWN_ATTEMPTS - 1 waits of
# DEAD_PR_UNKNOWN_SLEEP seconds (2 waits x 2s by default), and the sweep
# over PRs is serial — so the invoking unit's start timeout stays the outer
# bound on a tick and the sweep is never silently truncated.
#
# Runs as ExecStartPre of the fleet-merged-pr-close unit (same rail, no new
# timer). A found dead PR exits 1 so the unit fails and the existing
# OnFailure escalation pages instead of the branch lingering until a manual
# sweep.
#
# Output: one `dead-pr:` evidence line + one human line per dead PR, one
# `stale-conflicting-pr:` evidence line + one human line per
# stale-conflicting PR, then the `stale_conflicting_prs=<n>` measure line,
# then the measure line `dead_conflicting_prs=<n>` as the LAST stdout line.
# Logging is stderr only; stdout is machine-readable.
#
# Exit codes: 0 clean, 1 when at least one dead or stale-conflicting PR is
# proven (same rail, same OnFailure page), 2 on any gh/jq infra failure or
# on a PR whose mergeable stays undecided while its parent is MERGED/CLOSED
# (fail-closed — never a false green).
#
# Environment seams (tests override all of these):
#   GH             gh binary (mockable)
#   DEAD_PR_REPO   owner/repo to scan (default Nishfleet/fleet-ops)
#   DEAD_PR_UNKNOWN_ATTEMPTS  `gh pr view` re-query tries for an undecided
#                  mergeable value (default 3)
#   DEAD_PR_UNKNOWN_SLEEP     seconds between re-query tries (default 2)
#   DEAD_PR_STATE_DIR         first-seen markers + stale-conflicting.list
#                  (default $FLEET_HEARTBEAT_LOG_DIR/dead-pr-detector, which
#                  itself defaults to ~/.local/state/fleet-heartbeat)
#   DEAD_PR_STALE_HOURS       conflict-age bound for the stale class in
#                  whole hours (default 24)

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${GH:-gh}"
REPO="${DEAD_PR_REPO:-Nishfleet/fleet-ops}"
UNKNOWN_ATTEMPTS="${DEAD_PR_UNKNOWN_ATTEMPTS:-3}"
UNKNOWN_SLEEP="${DEAD_PR_UNKNOWN_SLEEP:-2}"
STATE_DIR="${DEAD_PR_STATE_DIR:-${FLEET_HEARTBEAT_LOG_DIR:-$HOME/.local/state/fleet-heartbeat}/dead-pr-detector}"
STALE_HOURS="${DEAD_PR_STALE_HOURS:-24}"

log() {
    printf '[fleet-dead-pr-detector] %s\n' "$*" >&2
}

loud() {
    local tag="$1"; shift
    log "LOUD [$tag] $*"
}

command -v "$GH" >/dev/null 2>&1 || { loud "DEAD-PR-BROKEN" "gh missing at $GH"; exit 2; }
command -v jq >/dev/null 2>&1 || { loud "DEAD-PR-BROKEN" "jq missing"; exit 2; }
[[ "$STALE_HOURS" =~ ^[0-9]+$ ]] || { loud "DEAD-PR-BROKEN" "invalid DEAD_PR_STALE_HOURS=$STALE_HOURS"; exit 2; }
mkdir -p "$STATE_DIR" 2>/dev/null \
    || { loud "DEAD-PR-BROKEN" "could not create state dir $STATE_DIR"; exit 2; }

# first-seen marker filename for a PR: <repo-short>-<num>.first-seen under
# STATE_DIR. Conflict age lives here because GitHub exposes no
# conflict-since field (createdAt is branch age).
repo_short="$(printf '%s' "${REPO##*/}" | tr -c 'A-Za-z0-9._-' '_')"
marker_file() { printf '%s/%s-%s.first-seen' "$STATE_DIR" "$repo_short" "$1"; }

# Delivery/related/reference patterns, exact-number bounded with an optional
# repo prefix — mirrors fleet-merged-pr-close (#1135 must never match
# #11352; the closing keyword family and `Relates to` forms are as GitHub
# accepts them).
TRAILER_RE='(^|[^0-9A-Za-z])(Clos(es?|ed)|Fix(es|ed)?|Resolv(es?|ed))[[:space:]]+([A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?)?#[1-9][0-9]*([^0-9A-Za-z]|$)'
RELATES_RE='(^|[^0-9A-Za-z])Relat(es|ed)[[:space:]]+to[[:space:]]+#[1-9][0-9]*([^0-9A-Za-z]|$)'
REF_RE='(^|[^0-9A-Za-z])([A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?)?#[1-9][0-9]*([^0-9A-Za-z]|$)'

# first_num TEXT PATTERN — the first bounded issue number matched by PATTERN
# in TEXT, top-to-bottom; empty when none.
first_num() {
    local text="$1" pattern="$2" match
    match="$(printf '%s\n' "$text" | grep -Eio "$pattern" | head -n 1 || true)"
    [ -n "$match" ] || return 0
    printf '%s' "$match" | grep -Eio '#[1-9][0-9]*' | head -n 1 | tr -d '#'
}

# branch_num HEAD — the issue number when HEAD is claim/issue-<N>; empty
# otherwise.
#
# scrub_body TEXT — strip refs that can never name a parent-originating
# issue of the scanned repo before any matching:
#   - cross-repo qualified refs: `owner/repo#N`, `owner/repo #N`, and the
#     short `repo#N` form, whenever the repo is neither the scanned repo
#     (Nishfleet/fleet-ops) nor its short name (fleet-ops). Bare prose
#     `word #N` refs (space between word and #N) are NOT touched, so
#     `Fixes #595` trailers and plain `#N` mentions survive
#   - PR-marked refs: `PR #N`/`PRs #N`, `pull #N`/`pulls #N`, `pull
#     request(s) #N`, `pull-request(s) #N` — a PR reference is never an
#     issue parent
# Same-repo qualifiers survive only as whole tokens: `Nishfleet/fleet-ops#N`
# (full form) and `fleet-ops#N` (short form); `acme/fleet-ops#N` is a
# cross-repo ref and is scrubbed. Sed only, no regex lookahead: the
# keep-forms are parked on @-wrapped sentinels first, the removals run,
# then the sentinels are restored.
scrub_body() {
    local text="$1" out
    out="$(printf '%s\n' "$text" | sed -E \
        -e 's%([^A-Za-z0-9_.-/]|^)Nishfleet/fleet-ops%\1@@FULLKEEP@@%g' \
        -e 's%([^A-Za-z0-9_.-/]|^)fleet-ops%\1@@SHORTKEEP@@%g' \
        -e 's%(^|[^0-9A-Za-z])[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[[:space:]]*#[1-9][0-9]*([^0-9A-Za-z]|$)%\1\2%g' \
        -e 's%(^|[^0-9A-Za-z])[A-Za-z0-9_.-]+#[1-9][0-9]*([^0-9A-Za-z]|$)%\1\2%g' \
        -e 's%(^|[^0-9A-Za-z])(prs?|pulls?|pull[[:space:]-]requests?)[[:space:]]*#[1-9][0-9]*([^0-9A-Za-z]|$)%\1\3%gi' \
        -e 's%@@FULLKEEP@@%Nishfleet/fleet-ops%g' \
        -e 's%@@SHORTKEEP@@%fleet-ops%g')"
    printf '%s' "$out"
}

branch_num() {
    local head="$1" n
    case "$head" in
        claim/issue-*)
            n="${head#claim/issue-}"
            if [[ "$n" =~ ^[1-9][0-9]*$ ]]; then
                printf '%s' "$n"
            fi
            ;;
    esac
}

# resolve_parent BODY HEAD — deterministic parent-originating issue number
# per the priority in the header comment.
resolve_parent() {
    local body="$1" head="$2" scrubbed n
    scrubbed="$(scrub_body "$body")"
    n="$(first_num "$scrubbed" "$TRAILER_RE")"
    [ -n "$n" ] || n="$(first_num "$scrubbed" "$RELATES_RE")"
    [ -n "$n" ] || n="$(branch_num "$head")"
    [ -n "$n" ] || n="$(first_num "$scrubbed" "$REF_RE")"
    printf '%s' "$n"
}

# issue_state PARENT PRNUM — read the state of PARENT with `gh issue view`
# and print it. Any gh/jq failure or a missing state is fail-closed (loud +
# exit 2), so a broken call can never read as a clean sweep.
issue_state() {
    local parent="$1" prnum="$2" issue_json state
    if ! issue_json=$("$GH" issue view "$parent" -R "$REPO" --json state,title 2>/dev/null); then
        loud "DEAD-PR-GH" "$REPO: gh issue view #$parent failed for PR #$prnum"
        exit 2
    fi
    if ! state="$(printf '%s' "$issue_json" | jq -r '.state // ""' 2>/dev/null)"; then
        loud "DEAD-PR-BROKEN" "$REPO: could not read state of issue #$parent (PR #$prnum)"
        exit 2
    fi
    if [ -z "$state" ]; then
        loud "DEAD-PR-BROKEN" "$REPO: no state for issue #$parent (PR #$prnum)"
        exit 2
    fi
    printf '%s' "$state"
}

# requery_mergeable NUM — force a mergeability computation for one PR with
# `gh pr view NUM --json mergeable`, up to UNKNOWN_ATTEMPTS tries with
# UNKNOWN_SLEEP seconds between. Only MERGEABLE/CONFLICTING ends the
# question: any other answer ("UNKNOWN", null, a value gh has not taught us
# yet) is retried. Prints the decided value, or the last undecided one once
# the tries are spent. A gh/jq error is fail-closed (exit 2), never a silent
# pass.
requery_mergeable() {
    local num="$1" attempt=1 view_json value=""
    while [ "$attempt" -le "$UNKNOWN_ATTEMPTS" ]; do
        if ! view_json=$("$GH" pr view "$num" -R "$REPO" --json mergeable 2>/dev/null); then
            loud "DEAD-PR-GH" "$REPO: gh pr view #$num failed for mergeable re-query"
            exit 2
        fi
        if ! value="$(printf '%s' "$view_json" | jq -r '.mergeable // ""' 2>/dev/null)"; then
            loud "DEAD-PR-BROKEN" "$REPO: could not read mergeable of PR #$num"
            exit 2
        fi
        case "$value" in
            MERGEABLE | CONFLICTING)
                printf '%s' "$value"
                return 0
                ;;
        esac
        if [ "$attempt" -lt "$UNKNOWN_ATTEMPTS" ]; then
            log "PR #$num: mergeable still '$value' after try $attempt/$UNKNOWN_ATTEMPTS — re-querying in ${UNKNOWN_SLEEP}s"
            sleep "$UNKNOWN_SLEEP"
        fi
        attempt=$((attempt + 1))
    done
    printf '%s' "${value:-UNKNOWN}"
}

log "dead-conflicting-PR scan starting (repo=$REPO, gh=$GH)"

# Open PRs, one fetch. A non-zero rc or empty output is an infra failure —
# fail closed so a broken call can never read as a clean sweep.
if ! prs_json=$("$GH" pr list -R "$REPO" --state open --limit 300 \
    --json number,title,headRefName,mergeable,body 2>/dev/null); then
    loud "DEAD-PR-GH" "$REPO: gh pr list failed"
    exit 2
fi
if [ -z "$prs_json" ]; then
    loud "DEAD-PR-GH" "$REPO: gh pr list returned empty output"
    exit 2
fi
if ! printf '%s' "$prs_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
    loud "DEAD-PR-BROKEN" "$REPO: gh pr list output is not a JSON array"
    exit 2
fi

conflicting=0
dead=0
stale=0
unknown_mergeable=0
in_class=()
flagged=()

while IFS= read -r pr; do
    [ -z "$pr" ] && continue
    num="$(printf '%s' "$pr" | jq -r '.number')"
    title="$(printf '%s' "$pr" | jq -r '.title')"
    head="$(printf '%s' "$pr" | jq -r '.headRefName // ""')"
    body="$(printf '%s' "$pr" | jq -r '.body // ""')"
    mergeable="$(printf '%s' "$pr" | jq -r '.mergeable // ""')"

    # Anything that is not exactly MERGEABLE or CONFLICTING (the string
    # "UNKNOWN", null, or a value gh has not taught us yet) is undecided:
    # counted in the honesty figure and kept in the scan, never dropped.
    undecided=0
    if [ "$mergeable" != "MERGEABLE" ] && [ "$mergeable" != "CONFLICTING" ]; then
        undecided=1
        unknown_mergeable=$((unknown_mergeable + 1))
        log "PR #$num: mergeable '$mergeable' is not MERGEABLE/CONFLICTING — undecided, re-querying"
        mergeable="$(requery_mergeable "$num")"
        case "$mergeable" in
            MERGEABLE | CONFLICTING)
                undecided=0
                log "PR #$num: re-query answered mergeable=$mergeable"
                ;;
        esac
    fi

    if [ "$mergeable" = "MERGEABLE" ]; then
        continue
    fi

    parent="$(resolve_parent "$body" "$head")"

    if [ "$undecided" = "1" ]; then
        # Still undecided after the retries: resolve the parent FIRST and
        # let it decide, so the sweep can never read clean over a possible
        # dead PR. Anything the parent reports that is not OPEN cannot be
        # proven live, so it fails closed with the CLOSED/MERGED case.
        if [ -z "$parent" ]; then
            log "PR #$num: mergeable '$mergeable' still undecided after $UNKNOWN_ATTEMPTS tries and no resolvable parent issue — not dead-classified, skipped"
            continue
        fi
        state="$(issue_state "$parent" "$num")"
        if [ "$state" = "OPEN" ]; then
            log "PR #$num: mergeable '$mergeable' still undecided after $UNKNOWN_ATTEMPTS tries, parent #$parent state=OPEN — live parent, not dead, skipped"
            continue
        fi
        loud "DEAD-PR-UNRESOLVED" "$REPO: PR #$num mergeable '$mergeable' still undecided after $UNKNOWN_ATTEMPTS tries and parent issue #$parent is $state — possible dead conflicting branch, sweep cannot be proven clean"
        exit 2
    fi

    conflicting=$((conflicting + 1))
    if [ -z "$parent" ]; then
        log "PR #$num: CONFLICTING but no resolvable parent issue — not dead-classified, skipped"
        continue
    fi

    state="$(issue_state "$parent" "$num")"

    if [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ]; then
        dead=$((dead + 1))
        url="https://github.com/${REPO}/issues/${parent}"
        printf 'dead-pr: %s %s parent=%s parent-state=%s %s\n' \
            "$num" "$title" "$parent" "$state" "$url"
        printf 'dead-pr-human: PR #%s is a dead conflicting branch — parent issue #%s is %s (%s); the fix already shipped, the branch cannot merge.\n' \
            "$num" "$parent" "$state" "$url"
    elif [ "$state" = "OPEN" ]; then
        # Stale-conflicting class (fleet-ops#5205): the parent is alive so
        # the PR is not dead, but a conflict that has stood past
        # STALE_HOURS is its own fault. Age comes from the first-seen
        # marker, never from createdAt (branch age, not conflict age).
        mf="$(marker_file "$num")"
        in_class+=("${mf##*/}")
        now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        first_seen=""
        first_epoch=""
        if [ -f "$mf" ]; then
            first_seen="$(head -n 1 "$mf" 2>/dev/null | tr -d '[:space:]' || true)"
            [ -n "$first_seen" ] \
                && first_epoch="$(date -u -d "$first_seen" +%s 2>/dev/null || true)"
            if [ -z "$first_seen" ] || [ -z "$first_epoch" ]; then
                # Unreadable marker: never flag on a guess, never let a
                # corrupt file hide a conflict forever — reset the clock
                # loudly and self-heal.
                loud "DEAD-PR-STATE" "$REPO: PR #$num first-seen marker unreadable ('$first_seen') — resetting to $now_iso"
                first_seen=""
            fi
        fi
        if [ -z "$first_seen" ]; then
            printf '%s\n' "$now_iso" >"$mf"
            log "PR #$num: parent #$parent state=OPEN — conflict first seen $now_iso (inside ${STALE_HOURS}h bound) — still live, not stale"
        else
            age_s=$(( $(date -u +%s) - first_epoch ))
            if [ "$age_s" -ge "$((STALE_HOURS * 3600))" ]; then
                stale=$((stale + 1))
                flagged+=("$REPO $num $parent")
                url="https://github.com/${REPO}/pull/${num}"
                printf 'stale-conflicting-pr: %s %s parent=%s first-seen=%s age-hours=%s %s\n' \
                    "$num" "$title" "$parent" "$first_seen" "$((age_s / 3600))" "$url"
                printf 'stale-conflicting-pr-human: PR #%s is a stale conflicting branch — parent issue #%s is still OPEN but the conflict has stood %sh (bound %sh); land/rebase it or close it with evidence.\n' \
                    "$num" "$parent" "$((age_s / 3600))" "$STALE_HOURS"
            else
                log "PR #$num: parent #$parent state=OPEN — still live, not dead; conflicting since $first_seen (inside ${STALE_HOURS}h bound) — not stale"
            fi
        fi
    else
        log "PR #$num: parent #$parent state=$state — still live, not dead"
    fi
done < <(printf '%s' "$prs_json" | jq -c '.[]')

# GC: a first-seen marker whose PR left the class this scan (went
# MERGEABLE, stayed undecided, dead-classified, lost its resolvable parent,
# or vanished from the open list) is stale state — drop it. Same
# prune-on-class-exit path the red-pr-repair state uses beside it; the
# flagged-list rewrite below bounds the flagged set to this scan.
shopt -s nullglob
for marker in "$STATE_DIR"/*.first-seen; do
    base="${marker##*/}"
    keep=0
    for k in ${in_class[@]+"${in_class[@]}"}; do
        [ "$k" = "$base" ] && { keep=1; break; }
    done
    [ "$keep" = 0 ] && { rm -f "$marker"; log "GC: dropped first-seen marker $base (PR left the stale-conflicting class)"; }
done
shopt -u nullglob

# Rewrite the flagged list atomically to exactly this scan's flagged set —
# fleet-heartbeat-red-pr-repair consumes it to not spend dispatches on a
# conflict shape no worker can repair. A fail-closed exit above leaves the
# last good list in place rather than emptying it mid-fault.
_tmp_list="$STATE_DIR/.stale-conflicting.list.$$"
: >"$_tmp_list"
for entry in ${flagged[@]+"${flagged[@]}"}; do
    [ -n "$entry" ] && printf '%s\n' "$entry" >>"$_tmp_list"
done
mv "$_tmp_list" "$STATE_DIR/stale-conflicting.list"

printf 'stale_conflicting_prs=%s\n' "$stale"
printf 'dead_conflicting_prs=%s\n' "$dead"
log "scan done: conflicting=$conflicting unknown-mergeable=$unknown_mergeable dead=$dead stale-conflicting=$stale"
if [ "$dead" -gt 0 ] || [ "$stale" -gt 0 ]; then
    exit 1
fi
exit 0