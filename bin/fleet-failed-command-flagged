#!/usr/bin/env bash
# fleet-failed-command-flagged — session-close lint (fleet-ops#535).
#
# Standing rule: a failed command is ALWAYS flagged, never walked past.
# This detector scans recent Pi session JSONL for toolResults with isError /
# non-zero exit / timeout that the assistant never named in later text, and
# auto-files when the failure was swallowed. grep/rg/diff exit 1 is skipped
# (POSIX no-match, not a failure). SPAWN_BLOCKED / harness confirmation
# blocks are skipped (the command never ran).
#
# No new scheduler. Run by fleet-heartbeat-tier1 every tick.
# Exit 0: no swallowed failures in the window. Exit 1: at least one
# (LOUD + auto-filed, deduped by signal: failed-command-flagged/<slug>).
# Exit 1 also if the helper itself is broken (missing python/lib).
#
# Observe-to-close (fleet-ops#650, same two-tick shape as #521): a green
# tick for a previously filed slug comments `resolved-at: signal: ...`.
# A later tick that already carries that marker closes the issue. A slug
# still in findings is neither commented nor closed. Same-tick close
# (fleet-ops#649) is replaced because a single scan miss tried to close
# #650 while the origin session was still a finding.
#
# Environment seams (tests override all of these):
#   FLEET_FAILED_COMMAND_SESSIONS   default ~/.pi/agent/sessions
#   FLEET_FAILED_COMMAND_LIB        python helper
#   FLEET_FAILED_COMMAND_WINDOW_HOURS   default 24
#   FLEET_FAILED_COMMAND_GRACE_MINUTES  default 20 (skip in-flight sessions)
#   FLEET_FAILED_COMMAND_NOW        ISO timestamp
#   FLEET_FAILED_COMMAND_FILE_ISSUES    1 (default) / 0
#   FLEET_FAILED_COMMAND_CLOSE_ISSUES   1 (default) / 0
#   FLEET_FAILED_COMMAND_ISSUE_REPO     default Nishfleet/fleet-ops
#   FLEET_FAILED_COMMAND_CAP            default 5
#   FLEET_HEARTBEAT_TRIAGE
#   GH

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)

GH="${GH:-gh}"
SESSIONS="${FLEET_FAILED_COMMAND_SESSIONS:-$HOME/.pi/agent/sessions}"
LIB="${FLEET_FAILED_COMMAND_LIB:-$_canon_repo/lib/failed-command-flagged.py}"
# Only fall back to the installed copy when the caller did not pin LIB.
if [[ -z "${FLEET_FAILED_COMMAND_LIB:-}" && ! -f "$LIB" && -f "${HOME}/.local/lib/pi-packet/failed-command-flagged.py" ]]; then
    LIB="${HOME}/.local/lib/pi-packet/failed-command-flagged.py"
fi
WINDOW_HOURS="${FLEET_FAILED_COMMAND_WINDOW_HOURS:-24}"
GRACE_MINUTES="${FLEET_FAILED_COMMAND_GRACE_MINUTES:-20}"
NOW_ISO="${FLEET_FAILED_COMMAND_NOW:-}"
FILE_ISSUES="${FLEET_FAILED_COMMAND_FILE_ISSUES:-1}"
CLOSE_ISSUES="${FLEET_FAILED_COMMAND_CLOSE_ISSUES:-1}"
ISSUE_REPO="${FLEET_FAILED_COMMAND_ISSUE_REPO:-Nishfleet/fleet-ops}"
CAP="${FLEET_FAILED_COMMAND_CAP:-5}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"

log() {
    printf '[%s] [fleet-failed-command-flagged] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

if ! command -v python3 >/dev/null 2>&1; then
    loud "FAILED-COMMAND-BROKEN" "python3 missing — cannot lint sessions"
    exit 1
fi
if [[ ! -f "$LIB" ]]; then
    loud "FAILED-COMMAND-BROKEN" "helper missing at $LIB"
    exit 1
fi

scan_args=(scan --root "$SESSIONS" --window-hours "$WINDOW_HOURS" --grace-minutes "$GRACE_MINUTES")
if [[ -n "$NOW_ISO" ]]; then
    scan_args+=(--now "$NOW_ISO")
fi

set +e
report=$(python3 "$LIB" "${scan_args[@]}" 2>/tmp/failed-command-flagged.err)
scan_rc=$?
set -e

if [[ "$scan_rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$report"; then
    loud "FAILED-COMMAND-BROKEN" "helper produced no JSON (rc=$scan_rc) $(tr '\n' ' ' </tmp/failed-command-flagged.err 2>/dev/null)"
    exit 1
fi

finding_count=$(jq '.findings | length' <<<"$report")
scanned=$(jq -r '.scanned' <<<"$report")
log "scanned=$scanned old=$(jq -r .skipped_old <<<"$report") grace=$(jq -r .skipped_grace <<<"$report") findings=$finding_count"

open_json="[]"
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    set +e
    open_json=$("$GH" issue list -R "$ISSUE_REPO" --state open --limit 200 --json number,body,comments 2>/dev/null)
    set -e
    open_json="${open_json:-[]}"
    if ! jq -e . >/dev/null 2>&1 <<<"$open_json"; then
        log "WARN: gh issue list produced no JSON"
        open_json="[]"
    fi
fi

filed=0
if [[ "$finding_count" != "0" ]]; then
    while IFS= read -r row; do
        [[ -n "$row" ]] || continue
        slug=$(jq -r '.slug' <<<"$row")
        snippet=$(jq -r '.snippet' <<<"$row")
        path=$(jq -r '.path' <<<"$row")
        loud "FAILED-COMMAND-SWALLOWED" "session=$slug path=$path snippet=$snippet"

        [[ "$FILE_ISSUES" == "1" ]] || continue
        [[ "$filed" -lt "$CAP" ]] || continue
        command -v "$GH" >/dev/null 2>&1 || continue

        signal="signal: failed-command-flagged/${slug}"
        if printf '%s' "$open_json" | jq -e --arg s "$signal" \
            '[.[] | select((.body // "") | contains($s))] | length > 0' \
            >/dev/null 2>&1; then
            log "auto-file: $slug already open (deduped)"
            continue
        fi

        title="fix(failed-command): $slug — failed command walked past, never flagged"
        body="The session-close lint (fleet-ops#535, standing rule: a failed command is ALWAYS flagged) found a Pi toolResult with a non-zero exit / isError / timeout and no later assistant text naming the failure.

- session: \`$path\`
- snippet: $snippet
- detector: bin/fleet-failed-command-flagged (heartbeat tier1)

Do not close until the detector reports this clean on a real heartbeat tick (observe-to-close).

$signal"
        set +e
        created=$("$GH" issue create -R "$ISSUE_REPO" --title "$title" --body "$body" 2>/dev/null)
        create_rc=$?
        set -e
        if [[ "$create_rc" -eq 0 && -n "$created" ]]; then
            log "auto-file: FILED $slug -> $created"
            filed=$((filed + 1))
        else
            log "auto-file: failed to file $slug (rc=$create_rc)"
        fi
    done < <(jq -c '.findings[]' <<<"$report")
fi

# Observe-to-close: comment resolved-at when a previously filed slug is no
# longer a finding; close on a later tick once that marker is already present.
observed=0
closed=0
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    finding_slugs=$(jq -r '.findings[].slug // empty' <<<"$report")
    while IFS= read -r irow; do
        [[ -n "$irow" ]] || continue
        num=$(jq -r '.number // empty' <<<"$irow")
        [[ -n "$num" && "$num" != "null" ]] || continue
        body=$(jq -r '.body // ""' <<<"$irow")
        signal=$(grep -oE 'signal: failed-command-flagged/[a-z0-9-]+' <<<"$body" | head -1 || true)
        [[ -n "$signal" ]] || continue
        slug="${signal#signal: failed-command-flagged/}"
        if printf '%s\n' "$finding_slugs" | grep -qxF -- "$slug"; then
            log "observe: $slug still a finding (#$num) — skip"
            continue
        fi
        blob=$(jq -r '"\(.body // "")\n\((.comments // []) | map(.body // "") | join("\n"))"' <<<"$irow")
        marker="resolved-at: ${signal}"
        if grep -Fq -- "$marker" <<<"$blob"; then
            if [[ "$CLOSE_ISSUES" == "1" ]] && [[ "$closed" -lt "$CAP" ]]; then
                set +e
                "$GH" issue close "$num" -R "$ISSUE_REPO" --reason completed >/tmp/failed-command-close.err 2>&1
                close_rc=$?
                set -e
                if [[ "$close_rc" -eq 0 ]]; then
                    closed=$((closed + 1))
                    log "OBSERVE-CLOSED $slug -> #$num (resolved-at + no longer a finding)"
                else
                    log "WARN: failed to close #$num (rc=$close_rc) $(tr '\n' ' ' </tmp/failed-command-close.err 2>/dev/null)"
                fi
            else
                log "dedup observe: #$num already carries $marker"
            fi
            continue
        fi
        [[ "$observed" -lt "$CAP" ]] || continue
        comment="${marker}

observed-at: $(date -u +%Y-%m-%dT%H:%M:%SZ)

Detector is green for this session on a real heartbeat tick (fleet-ops#650 observe-to-close)."
        set +e
        "$GH" issue comment "$num" -R "$ISSUE_REPO" --body "$comment" >/tmp/failed-command-comment.err 2>&1
        comment_rc=$?
        set -e
        if [[ "$comment_rc" -eq 0 ]]; then
            observed=$((observed + 1))
            log "OBSERVED-RESOLVED $slug -> #$num"
        else
            log "WARN: failed to comment on #$num (rc=$comment_rc) $(tr '\n' ' ' </tmp/failed-command-comment.err 2>/dev/null)"
        fi
    done < <(jq -c '.[]' <<<"$open_json")
    log "observe-to-close: commented=$observed closed=$closed"
fi

if [[ "$finding_count" == "0" ]]; then
    loud "FAILED-COMMAND-OK" "no swallowed failures in window (scanned=$scanned)"
    exit 0
fi

loud "FAILED-COMMAND-FAIL" "swallowed failures=$finding_count — a failed command was walked past; heartbeat tick will fail"
exit 1
