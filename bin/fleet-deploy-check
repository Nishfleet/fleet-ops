#!/usr/bin/env bash
# fleet-deploy-check — tight-cadence merge-to-live gate (fleet-ops#468).
#
# Named reason (decisions-ledger 2026-08-27 TOP GEAR): merged-but-not-live
# latency. Seat-cap PRs and other fixes waited for the 30-min heartbeat
# before reaching the live box. TOP GEAR says merge->live <= 5 minutes,
# event-driven. This check runs on a tight cadence (fleet-deploy-check.timer,
# 2 minutes), does a cheap git fetch + rev compare, and invokes the existing
# sanctioned deploy step (bin/fleet-ops-deploy) when origin/main moved OR
# the clone is on a named non-main branch (fleet-ops#5222). No new dispatcher,
# no polling for work — a pure event-driven gate on the merge event and on
# off-main checkout.
#
# Guards (all inherited from fleet-ops-deploy):
#   - origin fetch URL must be the fleet-ops repo; a foreign URL is repaired
#     in the same tick (set-url back to the expected constant), not refused
#     (fleet-ops#5301, replacing the fleet-ops#5016 refuse-and-wait)
#   - deploy refuses dirty tracked files / non-fast-forward with a LOUD line
#   - deploy only mutates when invoked from the canonical checkout or when
#     FLEET_OPS_CHECKOUT is explicitly set
#   - flock: one deploy at a time (a deploy already running or a heartbeat
#     block 0 deploy in flight means this check yields — never concurrent)
#   - off-main checkout invokes deploy even when HEAD SHA == origin/main
#     (fleet-ops#5222) so a fully-pushed named branch self-recovers on the
#     2-min cadence instead of waiting for a merge
#
# Deploy-clone read-only gate (fleet-ops#3758): the deploy clone is the live
# install source and must stay a clean origin/main. Workers that need to edit
# fleet-ops code use separate git worktrees, never the deploy clone. When a
# worker breaks that rule (in-progress tracked edits or stray untracked files
# in the deploy clone), this check flags it with a DEPLOY-CHECK-DIRTY-CLONE
# LOUD line on EVERY tick - regardless of whether origin/main moved - so the
# violation is surfaced within the 2-min cadence instead of sitting silent
# until a merge arrives. The LOUD line lists the offending paths to make the
# culprit obvious. The dirty state is not itself fatal here: fleet-ops-deploy
# still rejects a dirty clone and auto-files the deploy-blocked issue (and
# self-rescues an abandoned clone), so this gate is visibility + the existing
# rejection, not a deployment skip.
#
# Environment seams (tests):
#   FLEET_OPS_CHECKOUT            checkout to watch (default: canonical clone)
#   FLEET_OPS_DEPLOY_BIN          deploy binary (default: $checkout/bin/fleet-ops-deploy)
#   FLEET_DEPLOY_CHECK_LOCK       flock path (default: /tmp/fleet-deploy-check.lock)
#   FLEET_DEPLOY_CHECK_NO_DEPLOY  1 = compare only, never invoke deploy
#   FLEET_OPS_EXPECTED_ORIGIN_URL  expected origin fetch URL (default: fleet-ops;
#                                  tests point it at a local bare remote)
#   FLEET_OPS_DEPLOY_AUDIT_LOG / FLEET_OPS_TRIAGE passed through to deploy
#   FLEET_DEPLOY_CHECK_DIRTY_AUTOFILE  1 = the DIRTY-CLONE gate auto-files a
#                                  dedupe-gated issue on the 3rd consecutive
#                                  dirty tick (fleet-ops#5687). Default OFF:
#                                  without it the check behaves exactly as
#                                  before (LOUD only). The live unit sets it
#                                  in its Environment, so revert is a
#                                  one-line re-deploy.
#   FLEET_DEPLOY_CHECK_DIRTY_STATE_DIR  streak/episode state (default:
#                                  $AGENT_STATE/deploy-check)
#   FLEET_DEPLOY_CHECK_DIRTY_ISSUE_REPO filing repo (default Nishfleet/fleet-ops)
#   FLEET_DEPLOY_CHECK_DIRTY_STREAK    consecutive-tick threshold (default 3)
#   FLEET_ISSUE_FILE                   issue-file binary override (tests stub it)
#   FLEET_DEPLOY_CLONE_PROM            node-exporter .prom for the
#                                  fleet_deploy_clone_off_main{repo} drift
#                                  gauge (fleet-ops#5786; default
#                                  /var/lib/prometheus/node-exporter/fleet-deploy-clone.prom)
#   FLEET_DEPLOY_CLONE_REPO            repo label on that gauge (default:
#                                  basename of the expected origin URL)
#
# Exit: 0 always (a check that found nothing to do is not a failure).
#       Non-zero only on a hard internal error (fetch failure is logged,
#       not fatal — the next tick retries; the heartbeat still deploys).
#
# fleet-ops#5301: an origin-remote rewrite is repaired and the tick proceeds
# — no deploy tick is ever refused for a wrong origin fetch URL. A counter
# (fleet_deploy_origin_remote_repaired_total in the node-exporter .prom) and
# a 24h-repair-rate alert track how often the repair fires; >2 repairs in
# 24h means something is actively rewriting the URL. A remote-config
# tripwire (agent-state/deploy-clone-remotes.txt) diffs each tick and names
# any process with cwd inside the clone, so the next rewrite names its
# author.

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
command -v gh >/dev/null 2>&1 || export PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin

AS="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-$AS/FLEET-HEARTBEAT-TRIAGE.md}"
CHECKOUT="${FLEET_OPS_CHECKOUT:-/home/nish/workspaces/tooling/fleet-ops-deploy-clone}"
DEPLOY_BIN="${FLEET_OPS_DEPLOY_BIN:-$CHECKOUT/bin/fleet-ops-deploy}"
LOCK="${FLEET_DEPLOY_CHECK_LOCK:-/tmp/fleet-deploy-check.lock}"
NO_DEPLOY="${FLEET_DEPLOY_CHECK_NO_DEPLOY:-0}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
# fleet-ops#5016: the watched clone's origin fetch URL must name fleet-ops.
EXPECTED_ORIGIN_URL="${FLEET_OPS_EXPECTED_ORIGIN_URL:-https://github.com/Nishfleet/fleet-ops.git}"
export FLEET_OPS_TRIAGE="${FLEET_OPS_TRIAGE:-$TRIAGE}"
_wipe_here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
WIPE_LIB="${FLEET_WIPE_LESSONS_LIB:-$_wipe_here/../lib/fleet-wipe-lessons.py}"
# fleet-ops#5687: DIRTY-CLONE auto-file. The visibility LOUD alone shouts on
# every 2-min tick and files nothing (live 2026-09-12: 55 LOUD lines in 14h,
# zero filed issues — a treadmill, not a control). When
# FLEET_DEPLOY_CHECK_DIRTY_AUTOFILE=1 the 3rd consecutive dirty tick
# auto-files one dedupe-gated issue per episode through the alarm issue-file
# path (bin/fleet-issue-file, fleet-ops#1212); a clean tick clears the
# episode. Default OFF per the issue's rollback note.
DIRTY_AUTOFILE="${FLEET_DEPLOY_CHECK_DIRTY_AUTOFILE:-0}"
DIRTY_STATE_DIR="${FLEET_DEPLOY_CHECK_DIRTY_STATE_DIR:-$AS/deploy-check}"
DIRTY_ISSUE_REPO="${FLEET_DEPLOY_CHECK_DIRTY_ISSUE_REPO:-Nishfleet/fleet-ops}"
DIRTY_STREAK_THRESHOLD="${FLEET_DEPLOY_CHECK_DIRTY_STREAK:-3}"
ISSUE_FILE_BIN="${FLEET_ISSUE_FILE:-$_wipe_here/fleet-issue-file}"
if [[ ! -f "$WIPE_LIB" ]]; then
    WIPE_LIB="${_wipe_here}/../lib/pi-packet/fleet-wipe-lessons.py"
fi

log() {
    printf '[%s] [fleet-deploy-check] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local msg="$*"
    log "LOUD $msg"
    {
        printf '\n[%s] [fleet-deploy-check] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

# A deploy is already in flight: yield quietly. The heartbeat block 0 also
# deploys; two deploys racing would both mutate live state.
deploy_in_flight() {
    # systemctl --user is-active fleet-ops-deploy... is not a unit. Instead
    # check for a running fleet-ops-deploy process (the deploy step runs in
    # the heartbeat's own process tree). Match argv[0]/argv[1] only
    # (fleet-ops#533): pgrep -f matches any later argument that merely
    # carries the path. The flock on the deploy's own lock is the
    # authoritative gate — fleet-ops-deploy will fail loudly if it
    # cannot take it — so this check is a soft pre-filter only.
    python3 "$WIPE_LIB" argv-running fleet-ops-deploy >/dev/null 2>&1
}

# Return the offending paths in a dirty deploy clone, or empty when it is
# clean. Uses plain `git status --porcelain` (with untracked) so "clean"
# means truly porcelain-empty - a worker leaving either a tracked edit or a
# stray untracked file in the deploy clone trips the gate.
deploy_clone_dirty() {
    git -C "$CHECKOUT" status --porcelain 2>/dev/null | cut -c4-
}

# fleet-ops#5687: consecutive-recurrence state for the DIRTY-CLONE gate.
#   <DIRTY_STATE_DIR>/dirty-clone-streak : consecutive dirty ticks this episode
#   <DIRTY_STATE_DIR>/dirty-clone-filed  : present once this episode's issue
#                                          has been filed (one filing/episode)
dirty_streak_file() { printf '%s/dirty-clone-streak' "$DIRTY_STATE_DIR"; }
dirty_filed_file() { printf '%s/dirty-clone-filed' "$DIRTY_STATE_DIR"; }

# Clean tick: the episode is over — clear streak and filed marker so the next
# dirty episode starts counting from scratch and can file again.
dirty_episode_reset() {
    rm -f "$(dirty_streak_file)" "$(dirty_filed_file)" 2>/dev/null || true
}

# Dirty tick: bump the consecutive streak; on the 3rd (threshold) consecutive
# tick, auto-file one dedupe-gated issue via the alarm issue-file path
# (fleet-issue-file scores the candidate against open issues, so repeat
# episodes dedupe instead of piling up). A failed filing is logged and
# retried on the next tick — never fatal, this check still exits 0.
dirty_episode_bump() {
    local paths="$1" streak=0 title body out_file rc
    if [[ -f "$(dirty_streak_file)" ]]; then
        streak=$(cat "$(dirty_streak_file)" 2>/dev/null || true)
    fi
    [[ "$streak" =~ ^[0-9]+$ ]] || streak=0
    streak=$((streak + 1))
    mkdir -p "$DIRTY_STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$streak" >"$(dirty_streak_file)" 2>/dev/null || true
    (( streak >= DIRTY_STREAK_THRESHOLD )) || return 0
    [[ ! -f "$(dirty_filed_file)" ]] || return 0
    title="DEPLOY-CHECK-DIRTY-CLONE ${streak} consecutive ticks: deploy clone dirty — salvage-or-reconcile, restore clean"
    body="signal: deploy-check/dirty-clone

fleet-deploy-check observed the deploy clone ($CHECKOUT) dirty on ${streak} consecutive 2-min ticks (fleet-ops#5687; standing rule fleet-ops#3758: workers edit in worktrees, never the deploy clone).

paths: ${paths}
observed: $(date -u +%Y-%m-%dT%H:%M:%SZ)
evidence: journalctl --user -u fleet-deploy-check.service | grep DIRTY-CLONE

accept: name the writer before touching anything (active pi-issue@* units, open PRs touching the named paths). Salvage-or-reconcile: discard an in-clone edit when an open PR already carries the identical change, else salvage it into the writer's claim worktree and PR it. Never commit on the clone. Done means git -C $CHECKOUT status --porcelain is empty."
    out_file="${DIRTY_STATE_DIR}/dirty-clone-filed.out"
    rc=0
    # --label agent-ready: the intake only claims issues carrying that label
    # (`gh issue list -l agent-ready`); a label-less filing is never claimed —
    # the same silent-drop class fleet-ops#5687 was reopened for.
    "$ISSUE_FILE_BIN" file -R "$DIRTY_ISSUE_REPO" --title "$title" --body "$body" --label agent-ready >"$out_file" 2>&1 || rc=$?
    if (( rc == 0 )); then
        : >"$(dirty_filed_file)"
        log "DIRTY-CLONE auto-filed issue (${streak} consecutive ticks): $(head -1 "$out_file" 2>/dev/null || echo filed)"
    else
        log "WARN: DIRTY-CLONE auto-file failed (rc=$rc) — retried on the next tick"
    fi
}

# Per-tick gate (fleet-ops#4166): a worker running install.sh from a
# non-canonical worktree (FLEET_OPS_ALLOW_NONCANONICAL=1) retargets EVERY
# live fleet systemd unit symlink at that GC-able worktree. When the
# worktree is rotated/removed, the unit files vanish -> systemd logs
# "Unit to trigger vanished" / "Failed with result 'resources'" -> the
# canary stops -> the chain gauge goes absent -> FleetCompletionCanaryAbsent
# (3h backstop). The drift canary (fleet-ops-drift check_canonical_source)
# detects this on the 30-min heartbeat cadence and the heartbeat's own
# install.sh repairs it, but a worktree removed inside that 30-min window
# blinds the fleet before the heartbeat can repair it (live 2026-09-07:
# pi-issue@fleet-ops-4146 retargeted all unit symlinks at its worktree, then
# the worktree was removed at 07:33Z; the completion canary went blind until
# the 08:05Z recovery). This per-tick gate closes the detect->repair loop
# to the 2-min deploy-check cadence: detect a live fleet unit symlink whose
# target is non-canonical (under the workspaces root but not the canonical
# checkout) or dangling (target vanished), and retarget it to canonical via
# the sanctioned install.sh, so a worktree removal can never blind the
# fleet. The repair is the same install.sh the heartbeat runs; it retargets
# non-canonical symlinks to canonical (fleet-ops#1189) and daemon-reloads.
# Compare-only mode (FLEET_DEPLOY_CHECK_NO_DEPLOY=1) detects+LOUDs only.
noncanonical_unit_symlinks() {
    local unit_dir="${FLEET_DEPLOY_CHECK_UNIT_DIR:-$HOME/.config/systemd/user}"
    local canon ws_root f link target
    canon=$(readlink -f "${FLEET_OPS_CANONICAL_CHECKOUT:-$CHECKOUT}" 2>/dev/null || printf '%s\n' "$CHECKOUT")
    ws_root=$(readlink -f "${FLEET_OPS_WORKSPACES_ROOT:-/home/nish/workspaces}" 2>/dev/null || printf '%s\n' '/home/nish/workspaces')
    [[ -d "$unit_dir" ]] || return 0
    shopt -s nullglob
    for f in "$unit_dir"/*.service "$unit_dir"/*.timer; do
        [[ -L "$f" ]] || continue
        # Only fleet-managed unit symlinks point at a systemd/ path; skip
        # any foreign/distro unit symlinks that live in the same dir.
        link=$(readlink "$f" 2>/dev/null || true)
        case "$link" in */systemd/*) ;; *) continue ;; esac
        if target=$(readlink -f "$f" 2>/dev/null) && [[ -n "$target" ]]; then
            case "$target" in
                "$canon"|"$canon"/*) continue ;;
                "$ws_root"|"$ws_root"/*) printf '%s\n' "$f" ;;
            esac
        else
            # Dangling symlink (target vanished) — the exact condition that
            # blinded the fleet at 07:33Z. Flag it so install.sh retargets.
            printf '%s\n' "$f"
        fi
    done
    shopt -u nullglob
}

repair_noncanonical_units() {
    local install_bin="${FLEET_DEPLOY_CHECK_INSTALL_BIN:-$CHECKOUT/install.sh}"
    if [[ ! -x "$install_bin" ]] && [[ ! -f "$install_bin" ]]; then
        loud "DEPLOY-CHECK-NONCANONICAL-UNITS" \
            "cannot repair: install.sh not found at $install_bin"
        return 0
    fi
    log "retargeting non-canonical unit symlinks via $install_bin"
    local rc=0
    local out
    out=$(bash "$install_bin" 2>&1) || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        # Surface the first failure line (REFUSE, NONFATAL REFUSE, install.sh
        # fatal, or DIFF) so the loud message names the failing repair step
        # instead of only the exit code.
        local reason
        reason=$(printf '%s\n' "$out" | grep -m1 -E '^(NONFATAL |install\.sh: |DIFF:|REFUSE:)' || true)
        if [[ -n "$reason" ]]; then
            loud "DEPLOY-CHECK-NONCANONICAL-UNITS" \
                "install.sh repair reported: $reason (rc=$rc; retry next tick)"
        else
            loud "DEPLOY-CHECK-NONCANONICAL-UNITS" \
                "install.sh repair exited rc=$rc (retry next tick)"
        fi
    else
        log "non-canonical unit symlinks retargeted to canonical (rc=0)"
    fi
}

# Join at most five paths (plus a remainder count) for the LOUD line, so the
# message stays readable even if a worker dirtied many files.
clip_paths() {
    local max=5 i n joined
    readarray -t paths <<<"$1"
    n=${#paths[@]}
    if (( n > max )); then n=$max; fi
    joined=""
    for ((i = 0; i < n; i++)); do
        [[ -n "$joined" ]] && joined+=","
        joined+="${paths[i]}"
    done
    [[ $n -gt 0 ]] || return 0
    printf -v out '%s' "$joined"
    if (( ${#paths[@]} > max )); then
        out+=",+$(( ${#paths[@]} - max )) more"
    fi
}

# fleet-ops#5016: the origin fetch URL must name the fleet-ops repo. On
# 2026-09-10T16:16Z this clone's origin fetch URL was
# https://github.com/Nishfleet/0509.git (pushurl correctly fleet-ops), so
# `origin/main` tracked 0509's main; this check saw a "move" and invoked the
# sanctioned deploy, which reset the live install source to 0509's tree and
# dangled every helper symlink into it. Nothing asserted the remote URL, and
# this check compares origin/main to the checkout — the two moved together, so
# the drift looked like a normal fast-forward. Refuse BEFORE the fetch (and
# before the unit-symlink repair, which runs install.sh), so no ref is
# updated, nothing is installed, and the checkout is untouched.
#
# Normalize a git remote URL to host/owner/repo for comparison, so
# https://github.com/Nishfleet/fleet-ops.git, git@github.com:Nishfleet/fleet-ops
# and ssh://git@github.com/Nishfleet/fleet-ops.git all compare equal.
normalize_origin_url() {
    local u="${1:-}"
    u="${u#ssh://}"
    u="${u#https://}"
    u="${u#http://}"
    u="${u#git://}"
    u="${u#git@}"
    u="${u/:/\/}"
    u="${u%.git}"
    u="${u%/}"
    printf '%s\n' "${u,,}"
}

# fleet-ops#5301: repair the origin remote instead of refusing. The clone is
# disposable and the correct URL is a constant, so an automatic set-url is
# safe. Repairs: set origin back to the expected URL (or `remote add` when
# origin is missing entirely) and drop any extra remote that carries the
# expected URL under another name (the observed 2026-09-11 rewrite left
# `origin=0509` + `real=fleet-ops`). Returns the URL it repaired from
# (empty = nothing to do).
origin_remote_to_repair() {
    local url got want
    if ! url=$(git -C "$CHECKOUT" remote get-url origin 2>/dev/null); then
        printf 'origin remote is missing'
        return 0
    fi
    got=$(normalize_origin_url "$url")
    want=$(normalize_origin_url "$EXPECTED_ORIGIN_URL")
    if [[ "$got" != "$want" ]]; then
        printf '%s' "$url"
    fi
    return 0
}

repair_origin_remote() {
    local was="$1"
    if [[ "$was" == "origin remote is missing" ]]; then
        git -C "$CHECKOUT" remote add origin "$EXPECTED_ORIGIN_URL" 2>/dev/null || true
    else
        git -C "$CHECKOUT" remote set-url origin "$EXPECTED_ORIGIN_URL"
    fi
    loud "DEPLOY-CHECK-ORIGIN-REMOTE" \
        "repaired at $CHECKOUT (was $was) — origin set back to $EXPECTED_ORIGIN_URL and the tick proceeds (fleet-ops#5301)"
    record_origin_repair_count
}

# Drop any remote that carries the expected URL under another name (the
# observed 2026-09-11 rewrite left `origin=0509` + `real=fleet-ops`). Runs
# every tick, not just on repair, so a duplicate never lingers (fleet-ops#5301).
sweep_duplicate_origin_remotes() {
    local name rurl
    while IFS=$'\t' read -r name rurl; do
        [[ "$name" == "origin" ]] && continue
        [[ -z "$name" ]] && continue
        if [[ "$(normalize_origin_url "$rurl")" == "$(normalize_origin_url "$EXPECTED_ORIGIN_URL")" ]]; then
            git -C "$CHECKOUT" remote remove "$name" 2>/dev/null || true
        fi
    done < <(git -C "$CHECKOUT" remote -v 2>/dev/null | awk -F'\t' '$2 ~ / \(fetch\)$/ { sub(/ \(fetch\)$/, "", $2); print $1 "\t" $2 }')
}

# Counter fleet_deploy_origin_remote_repaired_total in the node-exporter
# .prom + a >2-repairs-in-24h alert (fleet-ops#5301).
record_origin_repair_count() {
    local prom="${FLEET_DEPLOY_ORIGIN_REPAIR_PROM:-/var/lib/prometheus/node-exporter/fleet-deploy-check.prom}"
    local hist="${FLEET_DEPLOY_ORIGIN_REPAIR_LOG:-$AS/deploy-clone-origin-repairs.log}"
    local now prev n
    now=$(date -u +%s)
    mkdir -p "$(dirname "$prom")" "$(dirname "$hist")" 2>/dev/null || true
    printf '%s\n' "$now" >>"$hist" 2>/dev/null || true
    n=$(awk -v cutoff=$((now - 86400)) '$1 >= cutoff' "$hist" 2>/dev/null | wc -l)
    if (( n > 2 )); then
        loud "DEPLOY-CHECK-ORIGIN-REMOTE" \
            "origin repaired ${n}x in 24h (>2) — something is rewriting the deploy clone's origin URL; find the writer (fleet-ops#5301)"
    fi
    prev=0
    if [[ -f "$prom" ]]; then
        prev=$(awk '$1 ~ /^fleet_deploy_origin_remote_repaired_total$/ { print $2; exit }' "$prom" 2>/dev/null) || prev=0
        prev="${prev:-0}"
    fi
    if {
        printf '# HELP fleet_deploy_origin_remote_repaired_total Deploy-clone origin fetch URL repairs (fleet-ops#5301).\n'
        printf '# TYPE fleet_deploy_origin_remote_repaired_total counter\n'
        printf 'fleet_deploy_origin_remote_repaired_total %d\n' "$((prev + 1))"
    } >"$prom.tmp" 2>/dev/null; then
        mv "$prom.tmp" "$prom" 2>/dev/null || true
    fi
}

# fleet-ops#5786: fleet_deploy_clone_off_main{repo} gauge in the
# node-exporter .prom, written on EVERY tick — 1 while the deploy clone is
# off main or dirty, 0 once it is clean main again. Deploy-clone drift means
# the live install source may be riding unmerged code (2026-09-12: an
# alert-repair worker reported a change "Live on this host" by inspecting a
# clone it had left on its fix branch). DeployCloneOffMain pages when the
# gauge holds 1 for >15 min, and clears the first clean tick after the
# converger restores main.
record_clone_off_main() {
    local want="$1"
    local prom="${FLEET_DEPLOY_CLONE_PROM:-/var/lib/prometheus/node-exporter/fleet-deploy-clone.prom}"
    local repo="${FLEET_DEPLOY_CLONE_REPO:-$(basename "${EXPECTED_ORIGIN_URL%.git}")}"
    mkdir -p "$(dirname "$prom")" 2>/dev/null || true
    if {
        printf '# HELP fleet_deploy_clone_off_main Deploy clone off main or dirty (fleet-ops#5786).\n'
        printf '# TYPE fleet_deploy_clone_off_main gauge\n'
        printf 'fleet_deploy_clone_off_main{repo="%s"} %d\n' "$repo" "$want"
    } >"$prom.tmp" 2>/dev/null; then
        chmod 0644 "$prom.tmp" 2>/dev/null || true
        mv "$prom.tmp" "$prom" 2>/dev/null || true
    fi
}

# fleet-ops#5301 tripwire: diff the clone's remote config against the last
# tick's snapshot; on a diff, log it plus any process whose cwd sits inside
# the clone, so the next rewrite names its author. The duplicate-remote
# sweep runs after the diff and the snapshot stores the post-sweep state,
# so a foreign mutation is logged exactly once.
origin_remote_tripwire() {
    local snap="$AS/deploy-clone-remotes.txt" now prev pid target culprits="" line
    mkdir -p "$(dirname "$snap")" 2>/dev/null || true
    now=$(git -C "$CHECKOUT" config --get-regexp '^remote\.' 2>/dev/null | sort) || true
    if [[ -s "$snap" ]]; then
        prev=$(cat "$snap")
        if [[ "$now" != "$prev" ]]; then
            for d in /proc/[0-9]*/cwd; do
                pid=${d#/proc/}; pid=${pid%/cwd}
                target=$(readlink "$d" 2>/dev/null) || continue
                [[ "$target" == "$CHECKOUT" || "$target" == "$CHECKOUT"/* ]] || continue
                line=$(ps -o pid=,etimes=,cmd= -p "$pid" 2>/dev/null) || true
                culprits+="${line}; "
            done
            loud "DEPLOY-CHECK-ORIGIN-TRIPWIRE" \
                "deploy-clone remote config changed since last tick (fleet-ops#5301): $(diff <(printf '%s\n' "$prev") <(printf '%s\n' "$now") 2>/dev/null || true) processes in clone: ${culprits:-none}"
        fi
    fi
    sweep_duplicate_origin_remotes
    now=$(git -C "$CHECKOUT" config --get-regexp '^remote\.' 2>/dev/null | sort) || true
    printf '%s\n' "$now" >"$snap.tmp" 2>/dev/null && mv "$snap.tmp" "$snap" 2>/dev/null || true
}

main() {
    # Origin-remote repair (fleet-ops#5301, replacing the #5016 refuse): a
    # foreign origin URL means origin/main is another repo's main, so repair
    # it (set-url back to the expected constant) and proceed in the SAME
    # tick — a wrong URL never blocks a deploy tick.
    if [[ -d "$CHECKOUT/.git" ]] || [[ -f "$CHECKOUT/.git" ]]; then
        local remote_problem
        remote_problem=$(origin_remote_to_repair)
        if [[ -n "$remote_problem" ]]; then
            repair_origin_remote "$remote_problem"
        fi
        origin_remote_tripwire
    fi
    # Per-tick non-canonical unit symlink gate (fleet-ops#4166): a worker's
    # non-canonical install.sh retargets every live fleet unit symlink at a
    # GC-able worktree; removing it blinds the fleet (Unit to trigger
    # vanished -> canary stops -> chain gauge absent). Detect + repair on
    # the 2-min cadence so a worktree removal can never blind the fleet
    # before the 30-min heartbeat repairs it. This runs BEFORE the
    # checkout-missing early return: a blinded unit symlink is an independent
    # fault that must surface even when the checkout is also missing, and
    # the repair only needs install.sh (which may still exist). Compare-only
    # mode LOUDs only.
    local nc_list nc_disp
    nc_list=$(noncanonical_unit_symlinks)
    if [[ -n "$nc_list" ]]; then
        clip_paths "$nc_list"
        nc_disp="$out"
        loud "DEPLOY-CHECK-NONCANONICAL-UNITS" \
            "live fleet unit symlinks point at a non-canonical/vanished target (fleet-ops#4166): $nc_disp"
        if [[ "$NO_DEPLOY" != "1" ]]; then
            repair_noncanonical_units
        fi
    fi

    if [[ ! -d "$CHECKOUT/.git" ]] && [[ ! -f "$CHECKOUT/.git" ]]; then
        record_clone_off_main 1
        loud "DEPLOY-CHECK-CHECKOUT-MISSING" "checkout $CHECKOUT is not a git worktree — nothing to watch"
        return 0
    fi

    # fleet-ops#5786: deploy-clone drift = off main OR dirty, computed BEFORE
    # the fetch so the gauge and the LOUD line stay accurate even when the
    # network is down. A named non-main branch and a detached HEAD both count
    # as off-main: a clone parked detached can no more converge than one on a
    # worker's branch.
    local branch=""
    branch=$(git -C "$CHECKOUT" symbolic-ref --short HEAD 2>/dev/null || true)
    local off_main=0
    if [[ "$branch" != "main" ]]; then
        off_main=1
    fi

    # Read-only gate: flag a dirty deploy clone on every tick. Visibility
    # first - the offending paths go in the LOUD line. Do NOT return early:
    # fleet-ops-deploy still needs to run when origin/main moved so it can
    # reject-dirty / auto-file / self-rescue the abandoned clone.
    # fleet-ops#5687: with FLEET_DEPLOY_CHECK_DIRTY_AUTOFILE=1 the 3rd
    # consecutive dirty tick also auto-files a dedupe-gated issue (one per
    # episode; a clean tick resets the episode). Flag default-off keeps the
    # pre-#5687 behavior byte-identical.
    local dirty_list dirty_disp out
    dirty_list=$(deploy_clone_dirty)

    # fleet-ops#5786: every tick writes the drift gauge — 1 while off-main or
    # dirty, 0 on clean main — so DeployCloneOffMain pages on >15 min of drift
    # and clears on the first converged tick.
    if [[ "$off_main" == "1" || -n "$dirty_list" ]]; then
        record_clone_off_main 1
    else
        record_clone_off_main 0
    fi
    if [[ "$off_main" == "1" ]]; then
        loud "DEPLOY-CHECK-OFF-MAIN" \
            "deploy clone $CHECKOUT is not on main (branch=${branch:-detached}) — merge-to-live may be riding unmerged code; converger resets it this tick (fleet-ops#5786)"
    fi
    if [[ -n "$dirty_list" ]]; then
        clip_paths "$dirty_list"
        dirty_disp="$out"
        loud "DEPLOY-CHECK-DIRTY-CLONE" \
            "deploy clone $CHECKOUT is dirty (must stay clean origin/main; workers edit in worktrees, not the deploy clone - fleet-ops#3758): $dirty_disp"
        if [[ "$DIRTY_AUTOFILE" == "1" ]]; then
            dirty_episode_bump "$dirty_disp"
        fi
    elif [[ "$DIRTY_AUTOFILE" == "1" ]]; then
        dirty_episode_reset
    fi

    local before after rc=0
    before=$(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || echo "unknown")

    # Fetch origin/main (cheap: refs only). Failure is not fatal — next tick
    # retries and the heartbeat still deploys at its own cadence.
    if ! git -C "$CHECKOUT" fetch -q origin 2>/dev/null; then
        log "fetch failed (retry next tick); HEAD=$before"
        return 0
    fi

    after=$(git -C "$CHECKOUT" rev-parse origin/main 2>/dev/null || echo "unknown")
    if [[ "$after" == "unknown" ]]; then
        log "no origin/main ref; HEAD=$before"
        return 0
    fi

    if [[ "$before" == "$after" && "$off_main" != 1 ]]; then
        log "origin/main unchanged (HEAD=$before) — nothing to do"
        return 0
    fi

    if [[ "$off_main" == 1 ]]; then
        log "checkout on '$branch' not main (HEAD=$before origin/main=$after) — invoking sanctioned deploy (fleet-ops#5222)"
    else
        log "origin/main moved $before -> $after — invoking sanctioned deploy"
    fi
    if [[ "$NO_DEPLOY" == "1" ]]; then
        log "compare-only mode (FLEET_DEPLOY_CHECK_NO_DEPLOY=1): deploy not invoked"
        return 0
    fi

    if [[ ! -x "$DEPLOY_BIN" ]]; then
        loud "DEPLOY-CHECK-MISSING" "deploy binary $DEPLOY_BIN missing — merge-to-live stalled"
        return 0
    fi

    # Yield if a deploy is already running (heartbeat block 0 or another
    # deploy-check tick that won the flock). fleet-ops-deploy's own flock
    # is the hard gate; this avoids spurious concurrent invocation.
    if deploy_in_flight; then
        log "deploy already in flight — yielding this tick"
        return 0
    fi

    # Take the flock, then re-verify the rev (another tick may have deployed
    # between fetch and lock).
    exec 9>"$LOCK"
    if ! flock -n 9; then
        log "lock held — another deploy in flight; yielding"
        return 0
    fi

    local now now_branch
    now=$(git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || echo "unknown")
    now_branch=$(git -C "$CHECKOUT" symbolic-ref --short HEAD 2>/dev/null || true)
    # fleet-ops#5786: a detached HEAD at the same SHA is still off-main drift
    # — only an on-main checkout at origin/main counts as converged.
    if [[ "$now" == "$after" && "$now_branch" == "main" ]]; then
        log "already deployed between fetch and lock (HEAD=$now) — nothing to do"
        return 0
    fi

    FLEET_OPS_CHECKOUT="$CHECKOUT" \
    FLEET_OPS_DEPLOY_AUDIT_LOG="${FLEET_OPS_DEPLOY_AUDIT_LOG:-$HOME/.local/state/fleet-heartbeat/deploy-audit.log}" \
    FLEET_OPS_TRIAGE="$TRIAGE" \
        "$DEPLOY_BIN" || rc=$?

    if [[ "$rc" -ne 0 ]]; then
        # fleet-ops-deploy already auto-filed a deploy-blocked issue via
        # auto_file_off_main() when the cause was a non-main branch / dirty
        # tracked files / non-ff (those are operator-fixable, not hard
        # errors). Returning its rc here would trip the systemd unit, fire
        # OnFailure=, and summon the auditor on every tick a worker
        # transiently dirties the deploy-clone. The trip-to-auditor loop
        # is exactly the failure mode this watcher must not feed
        # (auditor-summoned trip 2026-08-27T01:54Z: the prior 13 minutes
        # of the same LOUD line summoned the auditor, even though the
        # inner deploy had already auto-filed the only-actionable signal).
        # Surface the LOUD line for visibility, log the rc, return 0; the
        # next tick retries. A hard internal error inside the deploy
        # binary still propagates because fleet-ops-deploy does not exit
        # with the LOUD-only paths except for those reasons.
        loud "DEPLOY-CHECK-FAILED" "fleet-ops-deploy exited rc=$rc — merge-to-live gate red (soft, auto-filed, retry next tick; fleet-ops#768)"
        return 0
    fi
    log "deploy completed rc=0 — live now at origin/main ($after)"
    return 0
}

main "$@"
