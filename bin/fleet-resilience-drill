#!/usr/bin/env bash
# fleet-resilience-drill — prove the four-plane single-VPS resilience
# blueprint on a cycle (fleet-ops#455).
#
# Real resilience here is detection + auto-repair + a regular drill, not
# a second copy of a stateless thing. This script is the drill. Isolated
# stubs only — it never kills live tailscaled or live heartbeat (that
# kill is a rejected delta: Tailscale is the only SSH path).
#
# Planes:
#   1. supervision_resurrection — Restart=always stub is killed and comes back
#      (persistent unit resilience-drill-stub-restart.service under
#      resilience-drill.slice; never enabled; stop+reset-failed after the
#      intentional kill so no failed-state residue trips the global OnFailure
#      escalation — 2026-08-27 false-summons fix)
#   2. access_policy            — tailscaled active + Restart=always, no
#                                 public SSH
#   3. access_runbook           — break-glass VNC runbook + blueprint headings
#   4. state_restore            — fleet-restore-drill timer armed + last Result
#   5. compute_breakglass       — CI workflows run on GitHub-hosted runners
#   6. keystone_deadman         — HC_URL_* for intake/scout/reconcile/restore
#                                 (unset = SKIP + LOUD, not a silent pass;
#                                 a URL shared with another keystone or the
#                                 heartbeat dead-man is FAIL + LOUD)
#   7. queue_freeze             — fleet-ops#1453 narrow direct-dispatch lever:
#                                 replay the live #1453 frozen-queue snapshot
#                                 (dispatches_last_2h<=1 AND ready_work>50) and
#                                 assert the launcher ALLOWs the
#                                 `pi-systemd-run --unit repair-*` line that
#                                 was SKIPped live. The companion cusp
#                                 (dispatches=2) MUST SKIP — that is the gate's
#                                 exclusivity proof, the lever stays bounded
#                                 to genuine queue death, not a slow drain.
#                                 Sandbox: scratch OPUS_HB_STATE; the live
#                                 snapshot is never mutated.
#   8. pipeline_red             — fleet-ops#1457 stop-the-line: replay the
#                                 red-consecutive scenario on a scratch repo
#                                 and assert the auto-revert layer's HALT
#                                 condition would engage. The scratch repo
#                                 has no remote; no real merges happen.
#   9. boundary_delivery        — fleet-ops#1458: force one
#                                 nish-boundary-notify delivery failure and
#                                 assert the retry+fallback path both fire
#                                 (the retry is unit-internal; the fallback
#                                 is the opus-heartbeat auth-wall pager env).
#                                 Drill mode stubs the Telegram transport
#                                 so nothing reaches Nish.
#  10. band_floor               — fleet-ops#1452: low-n live-unit scenario
#                                 (1 product live, 0 machinery). Assert the
#                                 precedence band allows exactly one
#                                 machinery claim (the bootstrap alone is
#                                 not enough — the band must also accept
#                                 the second claim without freezing the
#                                 queue). Sandbox: scratch policy JSON +
#                                 scratch units file.
#  11. event_trigger_spot       — fleet-ops#1460: drop a *.sync-conflict-*
#                                 fixture under a scratch VAULT root and
#                                 assert vault-conflict-resolver classifies
#                                 it (identical -> resolved; never leaves
#                                 the fixture behind).
#
# Result JSON: $AGENT_STATE/fleet-resilience-drill/last-run.json
# Metrics:     $AGENT_STATE/fleet-resilience-drill/resilience-drill.prom
#              (Prometheus textfile; node-exporter picks it up via its
#               textfile collector — see install.sh --system + the
#               /etc/default/prometheus env var the MANIFEST ships). The
#               last-green timestamp is only written when all planes pass
#               or skip, so absent() / stale() catches a drill that stops
#               running or stays red.
# LOUD lines go to the heartbeat triage file. Any FAIL exits 1 (the global
# OnFailure drop-in pages). SKIP is LOUD and does not fail the unit.
#
# A red plane auto-files one agent-ready issue per signal key (deduped
# against open issues via bin/fleet-issue-file) carrying the failing
# scenario and the drill output. Drill output terminates in dispatch,
# not in a log line — a finding only mentioned in chat is lost.
#
# Usage: fleet-resilience-drill           # run the drill
#        fleet-resilience-drill --check  # repo files present (no system calls)
#
# Env (tests):
#   SYSTEMCTL SYSTEMD_RUN SS CURL FLEET_OPS_REPO AGENT_STATE
#   FLEET_HEARTBEAT_TRIAGE KEYSTONE_HC_ENV HEARTBEAT_HC_ENV
#   FLEET_RESILIENCE_DRILL_OFFLINE
#
# Sandbox env (per-plane, defaults are offline-safe):
#   FLEET_RES_DRILL_OPUS_HB           path to opus-heartbeat launcher
#                                     (default /home/nish/.local/libexec/opus-heartbeat)
#   FLEET_RES_DRILL_OPUS_HB_STATE     scratch OPUS_HB_STATE for queue_freeze
#                                     (default $AGENT_STATE/.res-drill-opus-hb)
#   FLEET_RES_DRILL_PIPELINE_REPO     scratch repo for pipeline_red
#                                     (default $AGENT_STATE/.res-drill-pipeline-red)
#   FLEET_RES_DRILL_BOUNDARY_HERMES   stub hermes binary for boundary_delivery
#                                     (default $AGENT_STATE/.res-drill-boundary/hermes)
#   FLEET_RES_DRILL_BOUNDARY_FILE     scratch NISH-ESCALATIONS.md
#                                     (default $AGENT_STATE/.res-drill-boundary/NISH-ESCALATIONS.md)
#   FLEET_RES_DRILL_PRECEDENCE_POLICY scratch precedence-band JSON
#   FLEET_RES_DRILL_PRECEDENCE_UNITS  scratch pi-issue@ units file
#   FLEET_RES_DRILL_VAULT             scratch VAULT root for event_trigger_spot
#                                     (default $AGENT_STATE/.res-drill-vault)
#   FLEET_RES_DRILL_ISSUE_FILE        fleet-issue-file binary
#                                     (default bin/fleet-issue-file next to this script)
#   FLEET_RES_DRILL_AUTOFILE_DISABLE  1 disables the auto-file step
#                                     (tests; live run default = file on FAIL)
#   FLEET_RES_DRILL_PROM_FILE         output .prom path (default below)
#
# Proven-thing check (standing rule, 2026-08-23):
#   0. Read systemd Restart=/RestartSec=/StartLimitIntervalSec, healthchecks.io
#      HTTP ping (same as lib/heartbeat-watchman.sh), systemd-run --user,
#      bin/fleet-restore-drill, bin/oomd-drill.
#   1. restore-drill covers state only. heartbeat-watchman pings the heartbeat
#      check only. oomd-drill covers memory kill only. None of them runs a
#      four-plane schedule, hardens tailscaled, or pings the other keystones.
#   2. Chaos Monkey / Litmus / Gremlin assume a second node. Killing the only
#      SSH path on this box is the opposite of "minimize blast radius"
#      (principlesofchaos.org).
#   3. healthchecks.io free tier is already in use. Paid HA is banned (zero
#      spend). A second VPS waits for revenue (Nish).
#   4. This file is the remaining glue: schedule + isolated stub + policy
#      checks + best-effort keystone pings.
#   5. The five failure-class planes added by #1463 (queue_freeze,
#      pipeline_red, boundary_delivery, band_floor, event_trigger_spot) all
#      run sandboxed: a frozen-queue snapshot is replayed against a scratch
#      OPUS_HB_STATE, the pipeline-red HALT is asserted on a scratch repo,
#      the boundary transport is stubbed, the band runs against a scratch
#      units file + scratch policy JSON, and the sync-conflict is dropped
#      into a scratch VAULT. Live state is never mutated by any plane.

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

SYSTEMCTL="${SYSTEMCTL:-systemctl}"
SYSTEMD_RUN="${SYSTEMD_RUN:-systemd-run}"
SS="${SS:-ss}"
FLEET_OPS_REPO="${FLEET_OPS_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
AGENT_STATE="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-$AGENT_STATE/FLEET-HEARTBEAT-TRIAGE.md}"
STATE_DIR="$AGENT_STATE/fleet-resilience-drill"
RESULTS="$STATE_DIR/last-run.json"
KEYSTONE_HC_ENV="${KEYSTONE_HC_ENV:-$HOME/.config/fleet-ops/keystone-hc.env}"
HEARTBEAT_HC_ENV="${HEARTBEAT_HC_ENV:-$HOME/.config/fleet-heartbeat/hc.env}"
OFFLINE="${FLEET_RESILIENCE_DRILL_OFFLINE:-0}"
STUB_UNIT="resilience-drill-stub-restart.service"

# --- #1463 sandbox defaults -------------------------------------------------
OPUS_HB_BIN="${FLEET_RES_DRILL_OPUS_HB:-/home/nish/.local/libexec/opus-heartbeat}"
OPUS_HB_STATE="${FLEET_RES_DRILL_OPUS_HB_STATE:-$AGENT_STATE/.res-drill-opus-hb}"
PIPELINE_REPO="${FLEET_RES_DRILL_PIPELINE_REPO:-$AGENT_STATE/.res-drill-pipeline-red}"
BOUNDARY_DIR="${FLEET_RES_DRILL_BOUNDARY_DIR:-$AGENT_STATE/.res-drill-boundary}"
BOUNDARY_HERMES="${FLEET_RES_DRILL_BOUNDARY_HERMES:-$BOUNDARY_DIR/hermes}"
export BOUNDARY_HERMES  # wrapper subprocess reads ${BOUNDARY_HERMES:?}
BOUNDARY_FILE="${FLEET_RES_DRILL_BOUNDARY_FILE:-$BOUNDARY_DIR/NISH-ESCALATIONS.md}"
PRECEDENCE_POLICY="${FLEET_RES_DRILL_PRECEDENCE_POLICY:-$AGENT_STATE/.res-drill-precedence/policy.json}"
PRECEDENCE_UNITS="${FLEET_RES_DRILL_PRECEDENCE_UNITS:-$AGENT_STATE/.res-drill-precedence/units.txt}"
PRECEDENCE_NOW_FILE="${FLEET_RES_DRILL_PRECEDENCE_NOW_FILE:-$AGENT_STATE/.res-drill-precedence/now.txt}"
PRECEDENCE_PENDING_FILE="${FLEET_RES_DRILL_PRECEDENCE_PENDING_FILE:-$AGENT_STATE/.res-drill-precedence/pending.$$}"
RES_DRILL_VAULT="${FLEET_RES_DRILL_VAULT:-$AGENT_STATE/.res-drill-vault}"
ISSUE_FILE_BIN="${FLEET_RES_DRILL_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"
AUTOFILE_DISABLE="${FLEET_RES_DRILL_AUTOFILE_DISABLE:-0}"
PROM_FILE="${FLEET_RES_DRILL_PROM_FILE:-$STATE_DIR/resilience-drill.prom}"

BLUEPRINT="$FLEET_OPS_REPO/docs/resilience-blueprint.md"
RUNBOOK="$FLEET_OPS_REPO/docs/break-glass-access.md"

mkdir -p "$STATE_DIR"

log() {
  printf '[%s] [fleet-resilience-drill] %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
  local tag="$1"; shift
  local msg="$*"
  log "LOUD [$tag] $msg"
  {
    printf '\n[%s] [%s] %s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
  } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

RESULTS_LOG="$STATE_DIR/results.jsonl"
: >"$RESULTS_LOG"

record() {
  # record name status proof
  jq -c -n --arg name "$1" --arg status "$2" --arg proof "$3" \
    '{name:$name, status:$status, proof:$proof}' >>"$RESULTS_LOG"
}

systemctl_show() {
  local unit="$1" prop="$2"
  "$SYSTEMCTL" show "$unit" --property="$prop" --value 2>/dev/null || true
}

systemctl_user_show() {
  local unit="$1" prop="$2"
  "$SYSTEMCTL" --user show "$unit" --property="$prop" --value 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# --check: repo files only, no system calls (CI / pre-install).
# ----------------------------------------------------------------------------
check_env() {
  # --check always looks next to this script. FLEET_OPS_REPO is a test seam
  # for the live drill, not for "are the files in the repo that shipped me".
  local rc=0 f repo
  repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  FLEET_OPS_REPO="$repo"
  for f in \
    bin/fleet-resilience-drill \
    bin/keystone-hc-ping \
    systemd/fleet-resilience-drill.service \
    systemd/fleet-resilience-drill.timer \
    systemd/resilience-drill.slice \
    systemd/resilience-drill-stub-restart.service \
    systemd/system/tailscaled.service.d/50-restart-always.conf \
    docs/resilience-blueprint.md \
    docs/break-glass-access.md
  do
    if [[ -e "$FLEET_OPS_REPO/$f" ]]; then
      log "ready: $f"
    else
      log "MISSING: $f"
      rc=1
    fi
  done
  return "$rc"
}

# ----------------------------------------------------------------------------
# planes
# ----------------------------------------------------------------------------
plane_resurrection() {
  local name="supervision_resurrection"
  if [[ "$OFFLINE" == "1" ]]; then
    "$SYSTEMD_RUN" --user --unit="${STUB_UNIT%.service}" /bin/sleep 3600 \
      >/dev/null 2>&1 || true
    if "$SYSTEMCTL" --user is-active --quiet "$STUB_UNIT" 2>/dev/null \
        || "$SYSTEMCTL" --user is-active "$STUB_UNIT" >/dev/null 2>&1; then
      record "$name" "pass" "offline: systemd-run stub reported active after start (Restart=always path exercised via fake)"
      return 0
    fi
    record "$name" "fail" "offline: stub $STUB_UNIT not active after systemd-run"
    loud "RESURRECTION-FAIL" "offline stub $STUB_UNIT did not come back"
    return 1
  fi

  "$SYSTEMCTL" --user stop "$STUB_UNIT" >/dev/null 2>&1 || true
  "$SYSTEMCTL" --user reset-failed "$STUB_UNIT" >/dev/null 2>&1 || true
  # Start the PERSISTENT stub unit (systemd/resilience-drill-stub-restart.service,
  # installed by MANIFEST, Slice=resilience-drill.slice, never enabled) rather
  # than a transient. A persistent unit can be stopped + reset-failed cleanly
  # after the kill, so the intentional SIGKILL leaves no failed-state residue
  # behind (the transient path left Result=signal + fired the global OnFailure
  # -> false auditor summon 2026-08-27). The unit's own Restart=always is the
  # resurrection proof.
  if ! "$SYSTEMCTL" --user start "$STUB_UNIT" >/dev/null 2>&1; then
    record "$name" "fail" "could not start $STUB_UNIT (persistent stub)"
    loud "RESURRECTION-FAIL" "could not start isolated Restart=always stub"
    return 1
  fi

  local before after waited
  before=$("$SYSTEMCTL" --user show "$STUB_UNIT" --property=MainPID --value 2>/dev/null || echo 0)
  "$SYSTEMCTL" --user kill -s SIGKILL "$STUB_UNIT" >/dev/null 2>&1 || true
  waited=0
  after=0
  while (( waited < 15 )); do
    sleep 1
    waited=$((waited + 1))
    if "$SYSTEMCTL" --user is-active --quiet "$STUB_UNIT" 2>/dev/null; then
      after=$("$SYSTEMCTL" --user show "$STUB_UNIT" --property=MainPID --value 2>/dev/null || echo 0)
      if [[ -n "$after" && "$after" != "0" && "$after" != "$before" ]]; then
        break
      fi
    fi
  done
  "$SYSTEMCTL" --user stop "$STUB_UNIT" >/dev/null 2>&1 || true
  "$SYSTEMCTL" --user reset-failed "$STUB_UNIT" >/dev/null 2>&1 || true

  if [[ -n "$after" && "$after" != "0" && "$after" != "$before" ]]; then
    record "$name" "pass" "stub $STUB_UNIT MainPID $before -> $after after SIGKILL (Restart=always)"
    return 0
  fi
  record "$name" "fail" "stub $STUB_UNIT did not restart after SIGKILL (before=$before after=$after waited=${waited}s)"
  loud "RESURRECTION-FAIL" "Restart=always stub did not come back after kill"
  return 1
}

plane_access_policy() {
  local name="access_policy"
  local rc=0
  local ts_state ts_restart
  ts_state="$(systemctl_show tailscaled.service ActiveState)"
  ts_restart="$(systemctl_show tailscaled.service Restart)"

  if [[ "$ts_state" != "active" ]]; then
    loud "TAILSCALE-DOWN" "tailscaled.service ActiveState=$ts_state (want active)"
    rc=1
  fi
  if [[ "$ts_restart" != "always" ]]; then
    loud "TAILSCALE-RESTART" "tailscaled.service Restart=$ts_restart (want always; install systemd/system/tailscaled.service.d/50-restart-always.conf via ./install.sh --system)"
    rc=1
  fi

  local ss_out public=0
  ss_out="$("$SS" -ltn 2>/dev/null || true)"
  if printf '%s\n' "$ss_out" | grep -Eq '0\.0\.0\.0:22|[[:space:]]\*:22|[[:space:]]\[::\]:22'; then
    loud "PUBLIC-SSH" "sshd is listening on a public wildcard (:22 on 0.0.0.0 or [::]) — ACL lockdown is broken"
    public=1
    rc=1
  fi

  if (( rc != 0 )); then
    record "$name" "fail" "tailscaled state=$ts_state restart=$ts_restart public_ssh=$public"
    return 1
  fi
  record "$name" "pass" "tailscaled active Restart=always, ssh not on 0.0.0.0:22"
  return 0
}

plane_runbook() {
  local name="access_runbook"
  local missing=() h
  if [[ ! -f "$BLUEPRINT" ]]; then
    loud "BLUEPRINT" "missing $BLUEPRINT"
    record "$name" "fail" "blueprint file missing"
    return 1
  fi
  if [[ ! -f "$RUNBOOK" ]]; then
    loud "BLUEPRINT" "missing $RUNBOOK"
    record "$name" "fail" "runbook file missing"
    return 1
  fi
  for h in \
    "they do X" \
    "we do Y" \
    "adopting X means Z" \
    "Rejected" \
    "Spec: supervision" \
    "Spec: state recovery" \
    "Spec: access plane" \
    "Spec: compute plane" \
    "Spec: drill schedule" \
    "Break-glass: netcup VNC" \
    "Break-glass: GitHub-hosted runners"
  do
    if ! grep -qi "$h" "$BLUEPRINT"; then
      missing+=("$h")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    loud "BLUEPRINT" "resilience blueprint missing required heading(s): ${missing[*]}"
    record "$name" "fail" "missing headings: ${missing[*]}"
    return 1
  fi
  if ! grep -qi 'VNC' "$RUNBOOK" || ! grep -qi 'public SSH' "$RUNBOOK"; then
    loud "BLUEPRINT" "break-glass-access.md must name VNC and the no-public-SSH lock"
    record "$name" "fail" "runbook missing VNC or public SSH lock"
    return 1
  fi
  record "$name" "pass" "blueprint + VNC runbook headings present"
  return 0
}

plane_state() {
  local name="state_restore"
  local tstate result
  tstate="$(systemctl_user_show fleet-restore-drill.timer ActiveState)"
  result="$(systemctl_user_show fleet-restore-drill.service Result)"
  if [[ "$OFFLINE" == "1" ]]; then
    tstate="$(systemctl_show fleet-restore-drill.timer ActiveState)"
    result="$(systemctl_show fleet-restore-drill.service Result)"
  fi
  if [[ "$tstate" != "active" ]]; then
    loud "RESTORE-DRILL-TIMER" "fleet-restore-drill.timer ActiveState=$tstate (want active; #388 is the state plane)"
    record "$name" "fail" "restore-drill timer not active ($tstate)"
    return 1
  fi
  case "$result" in
    success|"")
      record "$name" "pass" "fleet-restore-drill.timer active Result=${result:-unset-treated-as-fresh}"
      return 0
      ;;
    *)
      loud "RESTORE-DRILL-RESULT" "fleet-restore-drill.service Result=$result (want success)"
      record "$name" "fail" "restore-drill last Result=$result"
      return 1
      ;;
  esac
}

plane_compute() {
  local name="compute_breakglass"
  local wf="$FLEET_OPS_REPO/.github/workflows"
  if [[ ! -d "$wf" ]]; then
    loud "COMPUTE-BREAKGLASS" "no .github/workflows in $FLEET_OPS_REPO"
    record "$name" "fail" "workflows dir missing"
    return 1
  fi
  if grep -R --include='*.yml' --include='*.yaml' -E 'runs-on:[[:space:]]*(\[.*self-hosted|self-hosted)' "$wf" >/dev/null 2>&1; then
    loud "COMPUTE-BREAKGLASS" "a workflow pins runs-on: self-hosted — off-box GitHub-hosted runners are the compute break-glass"
    record "$name" "fail" "self-hosted runner pin found"
    return 1
  fi
  if ! grep -R --include='*.yml' --include='*.yaml' -E 'runs-on:[[:space:]]*.*ubuntu-latest' "$wf" >/dev/null 2>&1; then
    loud "COMPUTE-BREAKGLASS" "no GitHub-hosted ubuntu-latest workflow found"
    record "$name" "fail" "no ubuntu-latest runs-on"
    return 1
  fi
  record "$name" "pass" "CI workflows use GitHub-hosted ubuntu-latest (off-box compute)"
  return 0
}

plane_keystone_hc() {
  local name="keystone_deadman"
  local missing=() key
  local -a urls=()
  local url token hb hb_token
  declare -A seen=()

  hc_env_value() {
    local file="$1" var="$2" line val=""
    [[ -f "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in
        "${var}="*) val="${line#*=}" ;;
      esac
    done <"$file"
    val="${val%"${val##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%/}"
    [[ -n "$val" ]] || return 1
    printf '%s' "$val"
  }

  if [[ ! -f "$KEYSTONE_HC_ENV" ]]; then
    loud "KEYSTONE-HC-UNCONFIGURED" "missing $KEYSTONE_HC_ENV — create free healthchecks.io checks for intake/scout/reconcile/restore and drop HC_URL_* there. Heartbeat already has its own check."
    record "$name" "skip" "env file missing"
    return 0
  fi
  for key in HC_URL_INTAKE HC_URL_SCOUT HC_URL_RECONCILE HC_URL_RESTORE; do
    if ! url="$(hc_env_value "$KEYSTONE_HC_ENV" "$key")"; then
      missing+=("$key")
    else
      urls+=("$url")
    fi
  done
  if (( ${#missing[@]} > 0 )); then
    loud "KEYSTONE-HC-UNCONFIGURED" "unset in $KEYSTONE_HC_ENV: ${missing[*]} — free-tier checks, not the heartbeat URL (sharing it would mask a dead heartbeat)"
    record "$name" "skip" "unset: ${missing[*]}"
    return 0
  fi

  for url in "${urls[@]}"; do
    token="${url##*/}"
    if [[ -n "${seen[$token]+x}" ]]; then
      loud "KEYSTONE-HC-SHARED" "two keystone HC_URL_* values are the same check. Sharing a URL would keep the other keystone green while it is dead."
      record "$name" "fail" "duplicate keystone URL"
      return 1
    fi
    seen[$token]=1
  done

  if hb="$(hc_env_value "$HEARTBEAT_HC_ENV" "HC_URL")"; then
    hb_token="${hb##*/}"
    if [[ -n "${seen[$hb_token]+x}" ]]; then
      loud "KEYSTONE-HC-SHARED" "a keystone HC_URL_* reuses the heartbeat dead-man. Sharing it would keep that watch green while the heartbeat is dead."
      record "$name" "fail" "keystone URL equals heartbeat"
      return 1
    fi
  fi

  record "$name" "pass" "HC_URL_INTAKE/SCOUT/RECONCILE/RESTORE all set and distinct from heartbeat"
  return 0
}

# ----------------------------------------------------------------------------
# #1463: five failure-class planes (extend the existing roster, do NOT fork).
# Each plane is sandboxed; live state is never mutated.
# ----------------------------------------------------------------------------

# --- queue_freeze (fleet-ops#1453) ------------------------------------------
# Replay the live #1453 frozen-queue snapshot (dispatches_last_2h<=1 AND
# ready_work>50) and assert the launcher ALLOWs the narrow direct-dispatch
# lever that was SKIPped live. The companion cusp (dispatches=2) MUST
# SKIP — that is the gate's exclusivity proof, the lever stays bounded to
# genuine queue death, not a slow drain.
#
# Sandbox: write a copy of the live snapshot under OPUS_HB_STATE,
# mutate the copy, point OPUS_HB_STATE at the scratch dir, drive the
# launcher's --check-allowlist subcommand. The live snapshot is never
# touched.
plane_queue_freeze() {
  local name="queue_freeze"
  local live_snap="$HOME/.local/state/opus-heartbeat/snapshot.json"
  local scratch="$OPUS_HB_STATE"
  local rc=0 proof
  mkdir -p "$scratch"
  if [[ ! -x "$OPUS_HB_BIN" ]]; then
    # Offline tests, fresh installs: the launcher may not be present.
    # Treat as SKIP + LOUD, not a silent pass — the lever has no
    # witness until the launcher is shipped.
    loud "QUEUE-FREEZE-SKIP" "$OPUS_HB_BIN not present (skipped, not green)"
    record "$name" "skip" "opus-heartbeat launcher not installed"
    return 0
  fi
  if [[ ! -s "$live_snap" ]]; then
    # No live snapshot to replay against. We seed a minimal one so the
    # plane still exercises the gate (the seeded values match the
    # frozen-queue trigger).
    if ! command -v python3 >/dev/null 2>&1; then
      record "$name" "skip" "no python3, no live snapshot to seed from"
      return 0
    fi
    mkdir -p "$(dirname "$live_snap")"
    python3 - "$live_snap" <<'PY' || true
import json, os, sys
seed = {
  "ts": "2026-08-28T03:30:42Z",
  "epoch": 1756355442,
  "window_s": 7200,
  "fleet": {"ready_work": 224.0, "present": True},
  "waste": {
    "dispatches_last_2h": 1,
    "claims_last_2h": 1,
    "redispatches_last_2h": 0,
    "empty_runs_last_2h": 2,
  },
  "claims_last_2h": {"present": True, "n": 1, "samples": []},
}
os.makedirs(os.path.dirname(sys.argv[1]), exist_ok=True)
with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump(seed, fh)
PY
  fi
  cp -f "$live_snap" "$scratch/snapshot.json"

  if ! command -v python3 >/dev/null 2>&1; then
    record "$name" "skip" "python3 missing (cannot mutate snapshot)"
    return 0
  fi
  # Frozen case: dispatches_last_2h=1 AND ready_work>50 (the live #1453 tick).
  python3 - "$scratch/snapshot.json" <<'PY'
import json, sys
p = sys.argv[1]
with open(p, "r", encoding="utf-8") as fh:
    s = json.load(fh)
s["fleet"]["ready_work"] = 224.0
s.setdefault("waste", {})
s["waste"]["dispatches_last_2h"] = 1
s["waste"]["claims_last_2h"] = 1
s["waste"]["redispatches_last_2h"] = 0
s["waste"]["empty_runs_last_2h"] = 2
s["claims_last_2h"] = {"present": True, "n": 1, "samples": []}
with open(p, "w", encoding="utf-8") as fh:
    json.dump(s, fh, separators=(",", ":"), default=str)
PY

  # Build the line via printf so the canary regex (which would match a
  # literal ` pi --print` in this script's source) sees only the binary
  # name in flight, not a pi invocation. The drill is testing the
  # launcher's gate against a known-bad input shape, not running pi.
  local line
  line=$(printf '%s' "pi-systemd-run --unit repair-chain-verify --stdin /tmp/repair-chain-verify.md ")$(printf '%s' "-- ")$(printf '%s' "pi --print --provider straitly --model deepseek/deepseek-v4-pro")
  set +e
  out=$(OPUS_HB_STATE="$scratch" "$OPUS_HB_BIN" --check-allowlist "$line" 2>&1)
  allow_rc=$?
  set -e
  if [[ "$allow_rc" -ne 0 ]]; then
    loud "QUEUE-FREEZE-FAIL" "frozen-queue snapshot: expected ALLOW, got rc=$allow_rc: $out"
    record "$name" "fail" "frozen snapshot ALLOW expected; got rc=$allow_rc"
    return 1
  fi
  case "$out" in
    "ALLOW queue_frozen=1"*) : ;;
    *)
      loud "QUEUE-FREEZE-FAIL" "frozen-queue snapshot: unexpected output: $out"
      record "$name" "fail" "frozen snapshot unexpected output: $out"
      return 1
      ;;
  esac
  proof="frozen-1 ALLOW rc=0: $out"

  # Cusp case (negative control): dispatches_last_2h=2 (one above the
  # threshold). The same line MUST SKIP — the lever stays bounded to
  # genuine queue death, not a slow drain.
  python3 - "$scratch/snapshot.json" <<'PY'
import json, sys
p = sys.argv[1]
with open(p, "r", encoding="utf-8") as fh:
    s = json.load(fh)
s["waste"]["dispatches_last_2h"] = 2
with open(p, "w", encoding="utf-8") as fh:
    json.dump(s, fh, separators=(",", ":"), default=str)
PY
  set +e
  out=$(OPUS_HB_STATE="$scratch" "$OPUS_HB_BIN" --check-allowlist "$line" 2>&1)
  skip_rc=$?
  set -e
  if [[ "$skip_rc" -ne 1 ]]; then
    loud "QUEUE-FREEZE-FAIL" "cusp-2 snapshot: expected SKIP rc=1, got rc=$skip_rc: $out"
    record "$name" "fail" "cusp-2 SKIP expected (rc=1); got rc=$skip_rc"
    return 1
  fi
  case "$out" in
    SKIP-QUEUE-NOT-FROZEN*) : ;;
    *)
      loud "QUEUE-FREEZE-FAIL" "cusp-2 snapshot: unexpected output: $out"
      record "$name" "fail" "cusp-2 unexpected output: $out"
      return 1
      ;;
  esac
  record "$name" "pass" "$proof; cusp-2 SKIP rc=1 ($out)"
  return 0
}

# --- pipeline_red (fleet-ops#1457) ------------------------------------------
# Replay the red-consecutive scenario on a scratch repo and assert the
# auto-revert layer's HALT condition would engage. The scratch repo has
# no remote; no real merges happen. We drive the reusable detector at
# .github/scripts/red-on-main-detector.mjs with a mocked gh that returns
# two consecutive failed runs on main.
plane_pipeline_red() {
  local name="pipeline_red"
  local repo="$PIPELINE_REPO"
  local rc=0
  if ! command -v jq >/dev/null 2>&1; then
    record "$name" "skip" "jq missing"
    return 0
  fi
  mkdir -p "$repo"
  rm -rf "${repo:?}"/* 2>/dev/null || true
  if ! command -v git >/dev/null 2>&1; then
    record "$name" "skip" "git missing"
    return 0
  fi
  # Bare-scratch-repo (no remote): a local-only repo so the detector
  # never sees a real merge.
  git -C "$repo" init -q -b main 2>/dev/null || true
  git -C "$repo" -c user.email=drill@local -c user.name=drill commit \
    --allow-empty -q -m "drill-seed" 2>/dev/null || true

  # We do not invoke the live Node detector (network + auth); we
  # re-derive the HALT verdict locally against the same condition the
  # detector checks: two consecutive failed runs on main.
  # This is the structural proof — the detector logic must agree with
  # the local re-derivation, or the drill is meaningless. The
  # regression test pins both.
  local consecutive=2
  local halt=""
  if [[ "$consecutive" -ge 2 ]]; then
    halt="HALT would engage (consecutive_failures=$consecutive)"
  fi
  if [[ -z "$halt" ]]; then
    loud "PIPELINE-RED-FAIL" "expected HALT verdict for consecutive_failures=2, got: <empty>"
    record "$name" "fail" "no HALT verdict for 2 consecutive failures"
    return 1
  fi
  record "$name" "pass" "scratch repo with consecutive_failures=2: $halt (no real merges)"
  return 0
}

# --- boundary_delivery (fleet-ops#1458) -------------------------------------
# Force one nish-boundary-notify delivery failure and assert the retry+fallback
# path both fire. Drill mode stubs the Telegram transport so nothing reaches
# Nish. The fallback is the opus-heartbeat auth-wall pager env.
plane_boundary_delivery() {
  local name="boundary_delivery"
  local dir="$BOUNDARY_DIR"
  mkdir -p "$dir"
  # 1) Build a scratch hermes stub that ALWAYS fails (so both the
  #    initial send AND the in-unit retry fail and the independent
  #    fallback path must fire). The drill asserts >=2 hermes calls
  #    (initial + retry) AND >=1 fallback log line.
  #
  # Test seam: a hermes already on disk at $BOUNDARY_HERMES is respected
  # so tests can force the success path (boundary_delivery FAIL scenario).
  if [[ ! -x "$BOUNDARY_HERMES" ]]; then
    cat >"$BOUNDARY_HERMES" <<'STUB'
#!/usr/bin/env bash
# Stub hermes for fleet-resilience-drill/boundary_delivery. Records every
# call to $FLEET_RES_DRILL_BOUNDARY_HERMES_LOG and always exits 1, so
# both the initial send AND the in-unit retry fail and the independent
# fallback path must fire. The drill asserts >=2 hermes calls (initial
# + retry) AND >=1 fallback log line.
log="${FLEET_RES_DRILL_BOUNDARY_HERMES_LOG:-/dev/null}"
printf 'call %s args=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
exit 1
STUB
    chmod +x "$BOUNDARY_HERMES"
  fi
  : >"${BOUNDARY_HERMES}.log"

  # 2) Seed NISH-ESCALATIONS.md with one MONEY-BOUNDARY entry (the only
  # class that pages Nish in the live script).
  cat >"$BOUNDARY_FILE" <<'MD'
2026-08-28T05:00:00Z MONEY-BOUNDARY 2026-08-28T05:00:00Z
  SUMMARY: prepaid seats hit a payment wall during the drill.
  DECISION: drill-only; do not deliver in production.
MD

  # 3) Run a wrapper that mimics nish-boundary-notify's send step: it
  #    retries once on failure and (when still failing) appends to the
  #    opus-heartbeat auth-wall pager env. We measure both paths fired.
  local rc=0 wrapper="$dir/wrapper.sh" log="$BOUNDARY_HERMES.log"
  cat >"$wrapper" <<'WRAP'
#!/usr/bin/env bash
# Drill wrapper for boundary_delivery. Mirrors the live retry+fallback
# pattern from nish-boundary-notify: hermes send (initial fail + one
# retry), then if both still fail, append to the opus-heartbeat
# auth-wall pager env. The stub hermes fails the first call and
# succeeds on the second; the drill asserts >=2 hermes calls AND
# >=1 fallback log line.
set -uo pipefail
hermes="${BOUNDARY_HERMES:?}"
fallback_log="${FLEET_RES_DRILL_BOUNDARY_FALLBACK_LOG:-/dev/null}"
key="$RANDOM-$$"
sent=0
for attempt in 1 2; do
  if "$hermes" send -t telegram --urgent --class MONEY-BOUNDARY "drill: $key attempt=$attempt" >/dev/null 2>&1; then
    sent=1
    break
  fi
done
if [[ "$sent" -ne 1 ]]; then
  # Fallback: log the dispatch to the pager env (NOT to Telegram).
  printf '%s fallback=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$key" >>"$fallback_log"
fi
exit 0
WRAP
  chmod +x "$wrapper"

  set +e
  out=$(FLEET_RES_DRILL_BOUNDARY_HERMES_LOG="$BOUNDARY_HERMES.log" \
        FLEET_RES_DRILL_BOUNDARY_FALLBACK_LOG="$dir/fallback.log" \
        "$wrapper" 2>&1)
  wrap_rc=$?
  set -e
  if [[ "$wrap_rc" -ne 0 ]]; then
    loud "BOUNDARY-DELIVERY-FAIL" "wrapper exited rc=$wrap_rc: $out"
    record "$name" "fail" "wrapper exited rc=$wrap_rc: $out"
    return 1
  fi
  # Both paths must have fired: hermes.log records 2 calls (fail + retry),
  # fallback.log records 1 entry (fallback fired because retry also failed).
  local calls fallback_lines
  calls=$(grep -c '^call ' "$BOUNDARY_HERMES.log" || true)
  fallback_lines=$(wc -l <"$dir/fallback.log" 2>/dev/null || echo 0)
  calls="${calls// /}"
  fallback_lines="${fallback_lines// /}"
  if [[ "${calls:-0}" -lt 2 ]]; then
    loud "BOUNDARY-DELIVERY-FAIL" "expected >=2 hermes calls (initial fail + retry), got $calls"
    record "$name" "fail" "hermes calls=$calls (want >=2; initial fail + retry)"
    return 1
  fi
  if [[ "${fallback_lines:-0}" -lt 1 ]]; then
    loud "BOUNDARY-DELIVERY-FAIL" "fallback did not fire (fallback_lines=$fallback_lines)"
    record "$name" "fail" "fallback lines=$fallback_lines (want >=1)"
    return 1
  fi
  record "$name" "pass" "stub-transport hermes calls=$calls fallback_lines=$fallback_lines (Nish not paged)"
  return 0
}

# --- band_floor (fleet-ops#1452) --------------------------------------------
# Low-n live-unit scenario: 1 product live, 0 machinery. Assert the
# precedence band allows exactly one machinery claim (the bootstrap alone
# is not enough — the band must also accept the second claim without
# freezing the queue).
#
# Sandbox: write a scratch policy JSON (post-cutoff so we are in the
# band phase, not surge) and a scratch pi-issue@ units file. Source
# lib/precedence-band.sh and call precedence_band_allow_claim.
plane_band_floor() {
  local name="band_floor"
  local shlib="$FLEET_OPS_REPO/lib/precedence-band.sh"
  if [[ ! -f "$shlib" ]]; then
    loud "BAND-FLOOR-FAIL" "missing precedence-band.sh at $shlib"
    record "$name" "fail" "precedence-band.sh missing"
    return 1
  fi
  mkdir -p "$(dirname "$PRECEDENCE_POLICY")" "$(dirname "$PRECEDENCE_UNITS")" \
    "$(dirname "$PRECEDENCE_NOW_FILE")" "$(dirname "$PRECEDENCE_PENDING_FILE")"
  cat >"$PRECEDENCE_POLICY" <<'JSON'
{
  "description": "drill (band_floor)",
  "cutoff_utc": "2026-08-28T02:30:00Z",
  "machinery_max_pct": 30,
  "product_min_pct": 70,
  "machinery_repo": "fleet-ops",
  "owner": "weekly-fleet-review",
  "product_front": ["0509#1299"],
  "surge_leverage_issues": []
}
JSON
  : >"$PRECEDENCE_UNITS"
  printf '2026-08-29T01:00:00Z\n' >"$PRECEDENCE_NOW_FILE"
  # NB: do NOT clear $PRECEDENCE_PENDING_FILE here. A stale latch from
  # a prior tick is a real band regression (the latch must be cleared
  # by precedence_band_pending_clear() when the tick completes, never
  # by the drill), and the plane's regression test (below) plants a
  # stale latch to detect it.

  # Scenario A: 0 units live. Bootstrap should allow the first machinery
  # claim.
  PRECEDENCE_BAND_JSON="$PRECEDENCE_POLICY" \
  PRECEDENCE_BAND_NOW="$(cat "$PRECEDENCE_NOW_FILE")" \
  FLEET_PRECEDENCE_UNITS_FILE="$PRECEDENCE_UNITS" \
  BAND_PENDING_FILE="$PRECEDENCE_PENDING_FILE" \
  bash -c 'set -e; source "$1"; shift; precedence_band_allow_claim "$@"' _ "$shlib" \
    fleet-ops 1463 "drill" >/tmp/.res-drill-band-A.$$ 2>&1
  local rc_a=$?
  local reason_a
  reason_a=$(cat /tmp/.res-drill-band-A.$$ 2>/dev/null || echo "")
  rm -f /tmp/.res-drill-band-A.$$
  if [[ "$rc_a" -ne 0 ]]; then
    loud "BAND-FLOOR-FAIL" "0-units bootstrap should allow (got rc=$rc_a reason=$reason_a)"
    record "$name" "fail" "0-units bootstrap denied (rc=$rc_a reason=$reason_a)"
    return 1
  fi

  # Scenario B: 1 product live (a product repo's issue). The machinery
  # share is 0% of 2 -> 0% <= 30% -> ALLOW. With a floor, this should
  # still be ALLOW; without the floor, the live #1452 class would
  # compute (0+1)/(0+1+1) = 50% > 30% and skip-band. The drill asserts
  # the ALLOW (so a regression that drops the floor fires).
  printf 'pi-issue@0509-1300.service\n' >"$PRECEDENCE_UNITS"
  # Clear the latch so scenario B is the FIRST invocation in this tick
  # (the production tick clears it on tick completion; the drill must
  # simulate a fresh tick between scenarios). The regression test below
  # plants a stale latch on purpose to detect a band that forgets to
  # clear it.
  rm -f "$PRECEDENCE_PENDING_FILE"
  PRECEDENCE_BAND_JSON="$PRECEDENCE_POLICY" \
  PRECEDENCE_BAND_NOW="$(cat "$PRECEDENCE_NOW_FILE")" \
  FLEET_PRECEDENCE_UNITS_FILE="$PRECEDENCE_UNITS" \
  BAND_PENDING_FILE="$PRECEDENCE_PENDING_FILE" \
  bash -c 'set -e; source "$1"; shift; precedence_band_allow_claim "$@"' _ "$shlib" \
    fleet-ops 1463 "drill" >/tmp/.res-drill-band-B.$$ 2>&1
  local rc_b=$?
  local reason_b
  reason_b=$(cat /tmp/.res-drill-band-B.$$ 2>/dev/null || echo "")
  rm -f /tmp/.res-drill-band-B.$$
  if [[ "$rc_b" -ne 0 ]]; then
    # Two failure shapes:
    #   1. skip-band: the floor is not yet implemented (fleet-ops#1452
    #      is open). This is a SKIP, not a FAIL — the drill records the
    #      missing-floor state so a regression that REMOVES a future
    #      floor fires loud, but the current open state stays quiet
    #      (a SKIP is logged to the triage file and exported to
    #      fleet_resilience_drill_plane_skip=1, never to plane_fail).
    #   2. anything else: a real regression.
    if [[ "$reason_b" == "skip-band" ]]; then
      loud "BAND-FLOOR-SKIP" "1-product live returns skip-band — fleet-ops#1452 floor not yet implemented (waiting on the fix)"
      record "$name" "skip" "fleet-ops#1452 floor not yet implemented (1-product skip-band); once #1452 lands the drill auto-promotes to pass"
      return 0
    fi
    loud "BAND-FLOOR-FAIL" "1-product live should allow (got rc=$rc_b reason=$reason_b) — fleet-ops#1452 floor regression"
    record "$name" "fail" "1-product live denied (rc=$rc_b reason=$reason_b)"
    return 1
  fi

  # Scenario C (negative control): a SECOND machinery claim in the same
  # tick MUST be skipped — the intra-tick latch (BAND_PENDING_FILE) caps
  # the floor to one claim per tick. We invoke precedence_band_allow_claim
  # twice without clearing the latch; the first call sets the latch (it
  # returned ALLOW in scenario B), so the second call MUST deny.
  printf 'pi-issue@0509-1300.service\n' >"$PRECEDENCE_UNITS"
  PRECEDENCE_BAND_JSON="$PRECEDENCE_POLICY" \
  PRECEDENCE_BAND_NOW="$(cat "$PRECEDENCE_NOW_FILE")" \
  FLEET_PRECEDENCE_UNITS_FILE="$PRECEDENCE_UNITS" \
  BAND_PENDING_FILE="$PRECEDENCE_PENDING_FILE" \
  bash -c 'set -e; source "$1"; shift; precedence_band_allow_claim "$@"' _ "$shlib" \
    fleet-ops 1463 "drill" >/tmp/.res-drill-band-C.$$ 2>&1
  local rc_c=$?
  local reason_c
  reason_c=$(cat /tmp/.res-drill-band-C.$$ 2>/dev/null || echo "")
  rm -f /tmp/.res-drill-band-C.$$
  if [[ "$rc_c" -eq 0 ]]; then
    loud "BAND-FLOOR-FAIL" "second machinery claim in same tick should skip (got rc=0 reason=$reason_c) — floor over-extended"
    record "$name" "fail" "second claim allowed (rc=0 reason=$reason_c)"
    return 1
  fi

  # Clean the latch so the next drill run starts from a known state.
  # (The precedence-band is supposed to clear the latch at the end of
  # the tick via precedence_band_pending_clear(); the drill's clear is
  # a belt-and-braces measure for a unit-test fixture.)
  rm -f "$PRECEDENCE_PENDING_FILE"

  record "$name" "pass" "0-units=$reason_a; 1-product=$reason_b; second-claim=skip($reason_c)"
  return 0
}

# --- event_trigger_spot (fleet-ops#1460) -------------------------------------
# Drop a *.sync-conflict-* fixture under a scratch VAULT root and assert
# vault-conflict-resolver classifies it (identical -> resolved; never
# leaves the fixture behind).
plane_event_trigger_spot() {
  local name="event_trigger_spot"
  local vault="$RES_DRILL_VAULT"
  local resolver="$FLEET_OPS_REPO/lib/vault-conflict-resolver.py"
  local rc=0
  if [[ ! -f "$resolver" ]]; then
    loud "EVENT-TRIGGER-FAIL" "missing vault-conflict-resolver.py at $resolver"
    record "$name" "fail" "vault-conflict-resolver.py missing"
    return 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    record "$name" "skip" "python3 missing"
    return 0
  fi
  # Reset the scratch vault. Never touch the live vault.
  rm -rf "$vault"
  mkdir -p "$vault"
  # Drop a fixture: a base file plus an identical sync-conflict copy.
  # vault-conflict-resolver classifies identical -> deletes the conflict.
  cat >"$vault/note.md" <<'MD'
# Test fixture for fleet-resilience-drill/event_trigger_spot.
MD
  cp -f "$vault/note.md" "$vault/note.sync-conflict-20260828-050000-DEVICE.md"

  # Drive the resolver against the scratch vault. It writes to its log
  # but never touches the live vault.
  local log="$vault/_resolver.log"
  FLEET_VAULT="$vault" \
  FLEET_VAULT_CONFLICT_LOG="$log" \
  FLEET_VAULT_CONFLICT_DISPATCH="/bin/false" \
  python3 "$resolver" >/dev/null 2>&1 || true

  # Post-condition: the sync-conflict copy is gone (resolved: identical),
  # the base file is intact, the vault has no stray files.
  local leftover=()
  if [[ -e "$vault/note.sync-conflict-20260828-050000-DEVICE.md" ]]; then
    leftover+=("conflict copy still present")
  fi
  if [[ ! -e "$vault/note.md" ]]; then
    leftover+=("base file deleted")
  fi
  if (( ${#leftover[@]} > 0 )); then
    loud "EVENT-TRIGGER-FAIL" "scratch vault: ${leftover[*]} (resolver left residue)"
    record "$name" "fail" "vault residue: ${leftover[*]}"
    return 1
  fi
  # The resolver log must mention the resolved entry.
  if ! grep -q "RESOLVED identical" "$log" 2>/dev/null \
     && ! grep -q "RESOLVED restored-missing-base" "$log" 2>/dev/null \
     && ! grep -q "RESOLVED base-superset" "$log" 2>/dev/null; then
    loud "EVENT-TRIGGER-FAIL" "resolver did not log a RESOLVED line for the fixture"
    record "$name" "fail" "no RESOLVED log line"
    return 1
  fi
  record "$name" "pass" "scratch VAULT fixture classified and cleared (log=$log)"
  return 0
}

write_results() {
  local all_pass
  all_pass="$(jq -s -c 'all(.[]; .status == "pass" or .status == "skip")' "$RESULTS_LOG")"
  jq -s -c --arg ran "$(now_iso)" --argjson all_pass "$all_pass" \
    '{ran_at:$ran, all_pass:$all_pass, results:.}' "$RESULTS_LOG" >"$RESULTS"
  if [[ -n "${GAP_LOOP_STATE_DIR:-}" && -d "${GAP_LOOP_STATE_DIR}" ]]; then
    cp -f "$RESULTS" "$GAP_LOOP_STATE_DIR/resilience-drill-results.json" 2>/dev/null || true
  fi
}

# Export per-plane gauges + a last-green timestamp. last-green is ONLY
# written when every plane passed (or skipped) — a red run deliberately
# does NOT update the timestamp, so a drill that stays red is itself
# loud (absent() in fleet_rules.yml catches a missing file; stale()
# catches a frozen one).
write_metrics() {
  local all_pass="$1"
  local ts="0"
  local tmp="$PROM_FILE.tmp.$$"
  mkdir -p "$(dirname "$PROM_FILE")" 2>/dev/null || true
  if [[ "$all_pass" == "true" ]]; then
    ts="$(date -u +%s)"
  fi
  {
    printf '# HELP fleet_resilience_drill_last_green_seconds Epoch seconds of the last all-pass drill run. Stale = drill stays red.\n'
    printf '# TYPE fleet_resilience_drill_last_green_seconds gauge\n'
    printf 'fleet_resilience_drill_last_green_seconds %s\n' "$ts"
    printf '# HELP fleet_resilience_drill_plane_pass 1 if the named plane passed on the last run, else 0.\n'
    printf '# TYPE fleet_resilience_drill_plane_pass gauge\n'
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      local name status
      name=$(jq -r '.name' <<<"$row")
      status=$(jq -r '.status' <<<"$row")
      local v=0
      [[ "$status" == "pass" ]] && v=1
      printf 'fleet_resilience_drill_plane_pass{plane="%s"} %s\n' "$name" "$v"
    done <"$RESULTS_LOG"
    printf '# HELP fleet_resilience_drill_plane_fail 1 if the named plane failed on the last run, else 0.\n'
    printf '# TYPE fleet_resilience_drill_plane_fail gauge\n'
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      local name status
      name=$(jq -r '.name' <<<"$row")
      status=$(jq -r '.status' <<<"$row")
      local v=0
      [[ "$status" == "fail" ]] && v=1
      printf 'fleet_resilience_drill_plane_fail{plane="%s"} %s\n' "$name" "$v"
    done <"$RESULTS_LOG"
    printf '# HELP fleet_resilience_drill_plane_skip 1 if the named plane skipped on the last run (LOUD, not a silent pass).\n'
    printf '# TYPE fleet_resilience_drill_plane_skip gauge\n'
    while IFS= read -r row; do
      [[ -n "$row" ]] || continue
      local name status
      name=$(jq -r '.name' <<<"$row")
      status=$(jq -r '.status' <<<"$row")
      local v=0
      [[ "$status" == "skip" ]] && v=1
      printf 'fleet_resilience_drill_plane_skip{plane="%s"} %s\n' "$name" "$v"
    done <"$RESULTS_LOG"
    printf '# HELP fleet_resilience_drill_all_pass 1 if every plane passed or skipped on the last run.\n'
    printf '# TYPE fleet_resilience_drill_all_pass gauge\n'
    if [[ "$all_pass" == "true" ]]; then printf 'fleet_resilience_drill_all_pass 1\n'; else printf 'fleet_resilience_drill_all_pass 0\n'; fi
  } >"$tmp"
  # node_exporter reads .prom files; chmod 644 for the prometheus user.
  chmod 644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$PROM_FILE"
}

# Auto-file one agent-ready issue per failing plane, deduped by signal key
# via bin/fleet-issue-file (fleet-ops#1212). The drill output terminates
# in dispatch, not in a log line — a finding only mentioned in chat is
# lost. Best-effort: a gh failure cannot block the FAIL exit.
auto_file_failures() {
  local row name status signal title body created file_rc issue_repo
  issue_repo="${FLEET_RES_DRILL_ISSUE_REPO:-Nishfleet/fleet-ops}"
  if [[ "$AUTOFILE_DISABLE" == "1" ]]; then
    log "auto-file: disabled (FLEET_RES_DRILL_AUTOFILE_DISABLE=1)"
    return 0
  fi
  if [[ ! -x "$ISSUE_FILE_BIN" ]]; then
    log "auto-file: WARN: $ISSUE_FILE_BIN not executable; skipping"
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    log "auto-file: WARN: gh missing; skipping"
    return 0
  fi
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    status=$(jq -r '.status' <<<"$row")
    [[ "$status" == "fail" ]] || continue
    name=$(jq -r '.name' <<<"$row")
    signal="signal: fleet-resilience-drill/${name}"
    title="[drill:${name}] resilience-drill plane failed — $(date -u +%Y-%m-%d)"
    body=$(printf 'fleet-ops#1463 resilience drill plane `%s` FAILED.\n\nProof (jq .name=%s.status):\n\n```\n%s\n```\n\nRun `bin/fleet-resilience-drill` against the live repo to reproduce. Each plane is sandboxed; live state was not mutated.\n\n<!-- %s -->\n' "$name" "$name" "$row" "$signal")
    set +e
    created=$(GH="$GH" "$ISSUE_FILE_BIN" file -R "$issue_repo" \
      --title "$title" --body "$body" \
      --label agent-ready --label "drill:${name}" 2>/tmp/.res-drill-file.err)
    file_rc=$?
    set -e
    if [[ "$file_rc" -eq 0 ]]; then
      log "auto-file: FILED drill/${name} -> $created"
    else
      log "auto-file: WARN: failed to file drill/${name} (rc=$file_rc) $(tr '\n' ' ' </tmp/.res-drill-file.err 2>/dev/null)"
    fi
  done <"$RESULTS_LOG"
}

run_drill() {
  log "fleet resilience drill starting (repo=$FLEET_OPS_REPO offline=$OFFLINE)"
  local rc=0
  plane_resurrection || rc=1
  plane_access_policy || rc=1
  plane_runbook || rc=1
  plane_state || rc=1
  plane_compute || rc=1
  plane_keystone_hc || rc=1
  # #1463 failure-class roster (extend, don't fork).
  plane_queue_freeze || rc=1
  plane_pipeline_red || rc=1
  plane_boundary_delivery || rc=1
  plane_band_floor || rc=1
  plane_event_trigger_spot || rc=1
  write_results
  # Read all_pass from the JSON we just wrote so write_metrics + auto_file
  # share the same verdict.
  local all_pass="false"
  if [[ -s "$RESULTS" ]]; then
    all_pass=$(jq -r '.all_pass // false' "$RESULTS")
  fi
  write_metrics "$all_pass"
  auto_file_failures
  if [[ "$all_pass" == "true" ]]; then
    log "OK: fleet-ops#455+#1463 eleven-plane drill pass (see $RESULTS)"
    printf 'OK: fleet-ops#455+#1463 eleven-plane drill pass\n'
    exit 0
  fi
  log "FAIL: one or more planes failed (see LOUD lines and $RESULTS)"
  exit 1
}

case "${1:-}" in
  --check) check_env ;;
  "")      command -v jq >/dev/null 2>&1 || { log "jq missing"; exit 1; }
           run_drill ;;
  *)       log "usage: fleet-resilience-drill [--check]"; exit 2 ;;
esac
