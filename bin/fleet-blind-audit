#!/usr/bin/env bash
# fleet-blind-audit — one mechanical no-context sweep of the repo + live state.
#
# This is the ExecStart of fleet-blind-audit.service. It:
#   1. Takes a non-blocking flock (one audit at a time).
#   2. Picks a capable seat via seat-lib.sh.
#   3. Builds a sealed packet from prompts/blind-audit.md + live context.
#   4. Dispatches a pi reviewer to produce findings.json and report.md.
#   5. Runs each finding through the local panel (stub until #146).
#   6. Files accepted findings as gap-audit + agent-ready issues linked to
#      the report (panel PASS is the quality gate; fleet-ops#402), then
#      appends the filed URLs back into report.md (the reviewer is
#      forbidden from filing, so the report must not be the last word).
#   7. Writes a verdict log (including issue URLs) to agent-state.
#   8. Exits 1 if any PASS finding was not filed (cap skips do not count).
#
# AUDIT_DRILL=1 skips the reviewer and files a fixture finding, proving
# step 6 without a seat. Used by tests/fleet-blind-audit.test.sh.
#
# The reviewer is the intelligence; this script is the mechanical harness.
# No hand-built orchestration: one oneshot unit + one pi call + repo scripts.
#
# Environment (all have sane defaults; tests may override):
#   AUDIT_REPO              repo to audit (default: Nishfleet/fleet-ops)
#   AUDIT_REPO_ROOT         absolute path of the checked-out repo
#                           (default: canonical deploy-clone, fleet-ops#367)
#   AUDIT_STATE_DIR         agent-state sink (default: .../agent-state/fleet-blind-audit)
#   AUDIT_PROMPT            prompt template (default: ~/.pi/agent/prompts/blind-audit.md)
#   AUDIT_DELIBERATE_STATES docs/deliberate-states.md path
#   AUDIT_PLAN_FILE         fleet plan file for stamps (default: .../fleet-restoration-2026-08-25.md)
#   AUDIT_SEAT_LIB          seat-lib.sh path
#   AUDIT_PI_BIN            pi binary (default: ~/.local/bin/pi)
#   AUDIT_PANEL_BIN         panel binary (default: ~/.local/bin/fleet-blind-audit-panel)
#   AUDIT_MAX_FINDINGS      cap on filed issues per run (default: 5)
#   AUDIT_DRY_RUN           if 1, do not run pi or file issues
#   AUDIT_DRILL             if 1, skip pi/seat and file AUDIT_DRILL_FINDINGS
#   AUDIT_DRILL_FINDINGS    findings JSON for AUDIT_DRILL=1
#   AUDIT_FAKE_NOW          ISO-8601 UTC override for tests
#   AUDIT_ALLOW_NONCANONICAL  if 1, do not retarget products/fleet-ops
#   AUDIT_FILE_NONCANONICAL   if 0, skip auto-file of the #367 detector
#   AUDIT_SEAM_EVIDENCE     JSON file of pre-enumerated seam candidates (tests)
#   AUDIT_SEAM_SINCE        ISO timestamp; default last-blind-audit-run or 24h
#   AUDIT_SEAM_LIB          manual-seam-lens.py path
#   AUDIT_CYCLE_CRITERIA    gap-closure cycle-criteria markdown path
#   AUDIT_MEMORYCTL_DIR AUDIT_ACTIONS_LOG AUDIT_GH_SEAM_EVENTS AUDIT_SYSTEMCTL_STARTS
#                           optional live/fixture sources for the seam enumerator
#   FLEET_OPS_WORKSPACES_ROOT overlay for tests (default /home/nish/workspaces)
#   FLEET_OPS_CANONICAL_CHECKOUT overlay for tests (default <workspaces>/tooling/fleet-ops-deploy-clone)

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# --- locations -------------------------------------------------------------
REPO="${AUDIT_REPO:-Nishfleet/fleet-ops}"
WS_ROOT="${FLEET_OPS_WORKSPACES_ROOT:-/home/nish/workspaces}"
CANON="${FLEET_OPS_CANONICAL_CHECKOUT:-$WS_ROOT/tooling/fleet-ops-deploy-clone}"
# Default is the live install checkout, not products/fleet-ops (worktree
# parent). Auditing the parent is the class that filed #367 (48 false DIFFs).
REPO_ROOT="${AUDIT_REPO_ROOT:-$CANON}"
STATE_DIR="${AUDIT_STATE_DIR:-/home/nish/workspaces/agent-state/fleet-blind-audit}"
PROMPT="${AUDIT_PROMPT:-$HOME/.pi/agent/prompts/blind-audit.md}"
PLAN_FILE="${AUDIT_PLAN_FILE:-/home/nish/workspaces/agent-state/fleet-restoration-2026-08-25.md}"
PI_BIN="${AUDIT_PI_BIN:-$HOME/.local/bin/pi}"
PANEL_BIN="${AUDIT_PANEL_BIN:-$HOME/.local/bin/fleet-blind-audit-panel}"
MAX_FINDINGS="${AUDIT_MAX_FINDINGS:-5}"
DRY_RUN="${AUDIT_DRY_RUN:-0}"
DRILL="${AUDIT_DRILL:-0}"
AUDIT_NONCANON_MARKER="audit-target-noncanonical: fleet-ops#367"

# Resolve this script's repo root for fallbacks when not installed yet.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
repo_fallback="$(cd "$here/.." && pwd)"

# fleet-ops#1212: route issue filings through the same-problem dedupe gate.
ISSUE_FILE="${FLEET_ISSUE_FILE:-$here/fleet-issue-file}"
[ -f "$PROMPT" ] || PROMPT="$repo_fallback/prompts/blind-audit.md"

SEAT_LIB="${AUDIT_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
[ -f "$SEAT_LIB" ] || SEAT_LIB="$repo_fallback/lib/seat-lib.sh"

SEAM_LIB="${AUDIT_SEAM_LIB:-$HOME/.local/lib/pi-packet/manual-seam-lens.py}"
[ -f "$SEAM_LIB" ] || SEAM_LIB="$repo_fallback/lib/manual-seam-lens.py"
CYCLE_CRITERIA="${AUDIT_CYCLE_CRITERIA:-$repo_fallback/config/gap-closure-cycle-criteria.md}"

mkdir -p "$STATE_DIR"

# Per-run report directory (UTC timestamp).
if [ -n "${AUDIT_FAKE_NOW:-}" ]; then
    NOW_ISO="$AUDIT_FAKE_NOW"
    NOW_DIR="${NOW_ISO//[^A-Za-z0-9]/_}"
else
    NOW_ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    NOW_DIR="$(date -u +%Y%m%dT%H%M%SZ)"
fi
REPORT_DIR="$STATE_DIR/reports/$NOW_DIR"
mkdir -p "$REPORT_DIR"

FINDINGS_JSON="$REPORT_DIR/findings.json"
REPORT_MD="$REPORT_DIR/report.md"
PI_STDOUT="$REPORT_DIR/pi-stdout.txt"
PI_STDERR="$REPORT_DIR/pi-stderr.txt"
VERDICTS_LOG="$REPORT_DIR/verdicts.jsonl"
: >"$VERDICTS_LOG"

# fleet-ops#786: timestamp split out so the printf line stays free of
# $(date). The variable name avoids the volatile alternatives (TS/...)
# so the regex does not flag this helper either.
log() {
    local _stamp
    _stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf '[%s] [fleet-blind-audit] %s\n' "$_stamp" "$*" >&2
}

resolve_path() {
    readlink -f "$1" 2>/dev/null || printf '%s' "$1"
}

auto_file_audit_noncanonical() {
    local got="$1" want="$2"
    if [ "${AUDIT_FILE_NONCANONICAL:-1}" != "1" ]; then
        log "file skipped (AUDIT_FILE_NONCANONICAL!=1) marker=$AUDIT_NONCANON_MARKER"
        return 0
    fi
    local listed num body_file
    listed=$(gh issue list -R "$REPO" --state open --limit 50 --json number,body 2>/dev/null || echo '[]')
    if printf '%s' "$listed" | jq -e --arg m "$AUDIT_NONCANON_MARKER" \
        '.[] | select((.body // "") | contains($m))' >/dev/null 2>&1; then
        num=$(printf '%s' "$listed" | jq -r --arg m "$AUDIT_NONCANON_MARKER" \
            '[.[] | select((.body // "") | contains($m)) | .number] | first // empty')
        log "dedup: open ${REPO}#${num} already carries $AUDIT_NONCANON_MARKER"
        return 0
    fi
    body_file=$(mktemp)
    {
        printf 'Blind audit AUDIT_REPO_ROOT was %s (resolved %s).\n' "$REPO_ROOT" "$got"
        printf 'Canonical live checkout is %s.\n\n' "$want"
        printf 'Auditing the worktree parent files false MANIFEST DIFFs because live units resolve into the deploy-clone (fleet-ops#367 / #372). The harness retargeted this run.\n\n'
        printf '%s\n' "$AUDIT_NONCANON_MARKER"
    } >"$body_file"
    # fleet-ops#503: stamp gap-audit + agent-ready at create time so intake
    # (which lists agent-ready only) sees the detector issue immediately,
    # without waiting for lifecycle-label-sweep. Same class as the #402
    # panel-PASS create site.
    if "$ISSUE_FILE" file -R "$REPO" \
        --title "Blind audit targeted non-canonical fleet-ops checkout" \
        --body-file "$body_file" \
        --label gap-audit --label agent-ready >/dev/null 2>&1; then
        log "filed: Blind audit targeted non-canonical fleet-ops checkout"
    else
        log "WARN: gh issue create failed for $AUDIT_NONCANON_MARKER"
    fi
    rm -f "$body_file"
}

# fleet-ops#367: if the auditor is pointed at products/fleet-ops or the
# worktree parent, retarget to the canonical deploy-clone and auto-file.
# CI worktrees and explicit AUDIT_REPO_ROOT overlays are left alone.
retarget_stale_fleet_ops_audit_root() {
    case "$REPO" in
        Nishfleet/fleet-ops) ;;
        *) return 0 ;;
    esac
    [ "${AUDIT_ALLOW_NONCANONICAL:-0}" = "1" ] && return 0

    local got want stale_products stale_parent hit
    got="$(resolve_path "$REPO_ROOT")"
    want="$(resolve_path "$CANON")"
    stale_products="$(resolve_path "$WS_ROOT/products/fleet-ops")"
    stale_parent="$(resolve_path "$WS_ROOT/tooling/fleet-ops")"
    [ "$got" = "$want" ] && return 0

    hit=0
    if [ "$got" = "$stale_products" ] || [ "$got" = "$stale_parent" ]; then
        hit=1
    fi
    case "$REPO_ROOT" in
        "$WS_ROOT/products/fleet-ops"|"$WS_ROOT/tooling/fleet-ops") hit=1 ;;
    esac
    [ "$hit" = "1" ] || return 0

    log "AUDIT-NONCANONICAL: $REPO_ROOT resolved to $got; retargeting to $want (fleet-ops#367)"
    auto_file_audit_noncanonical "$got" "$want"
    REPO_ROOT="$want"
}

retarget_stale_fleet_ops_audit_root

DELIBERATE_STATES="${AUDIT_DELIBERATE_STATES:-$REPO_ROOT/docs/deliberate-states.md}"
[ -f "$DELIBERATE_STATES" ] || DELIBERATE_STATES="$repo_fallback/docs/deliberate-states.md"

# --- stamp in plan file (in-place, only the matching line) -----------------
update_plan_stamp() {
    local key="$1" value="$2"
    if [ -f "$PLAN_FILE" ]; then
        python3 - "$PLAN_FILE" "$key" "$value" <<'PY'
import sys, re
path, key, value = sys.argv[1:]
with open(path, 'r', encoding='utf-8') as f:
    lines = f.readlines()
new = []
hit = False
prefix = f'{key}:'
for ln in lines:
    if not hit and ln.startswith(prefix):
        new.append(f'{prefix} {value}\n')
        hit = True
    else:
        new.append(ln)
if not hit:
    if new and not new[-1].endswith('\n'):
        new.append('\n')
    new.append(f'\n{prefix} {value}\n')
with open(path, 'w', encoding='utf-8') as f:
    f.writelines(new)
PY
    fi
}

# --- one audit at a time ---------------------------------------------------
exec 9>"$STATE_DIR/audit.lock"
if ! flock -n 9; then
    log "audit already running (no-op)"
    exit 0
fi

# Read the previous run stamp BEFORE overwriting it — the seam window
# starts there (or 24h back if this is the first run). fleet-ops#377.
prev_audit_run=""
if [ -f "$PLAN_FILE" ]; then
    prev_audit_run=$(grep -E '^last-blind-audit-run:' "$PLAN_FILE" | head -1 | sed 's/^last-blind-audit-run:[[:space:]]*//' || true)
fi
SEAM_SINCE="${AUDIT_SEAM_SINCE:-}"
if [ -z "$SEAM_SINCE" ]; then
    SEAM_SINCE=$(printf '%s' "$prev_audit_run" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z' | head -1 || true)
fi

update_plan_stamp "last-blind-audit-run" "$NOW_ISO (started)"

# --- preflight -------------------------------------------------------------
[ -x "$PANEL_BIN" ] || { log "FATAL: panel missing: $PANEL_BIN"; exit 2; }
[ -d "$REPO_ROOT" ] || { log "FATAL: repo root missing: $REPO_ROOT"; exit 2; }
command -v jq >/dev/null 2>&1 || { log "FATAL: jq missing"; exit 2; }
command -v gh >/dev/null 2>&1 || { log "FATAL: gh missing"; exit 2; }
if [ "$DRILL" != "1" ]; then
    [ -x "$PI_BIN" ] || { log "FATAL: pi binary not executable: $PI_BIN"; exit 2; }
    [ -f "$PROMPT" ] || { log "FATAL: prompt missing: $PROMPT"; exit 2; }
    [ -f "$SEAT_LIB" ] || { log "FATAL: seat-lib missing: $SEAT_LIB"; exit 2; }
    [ -f "$SEAM_LIB" ] || { log "FATAL: seam lens missing: $SEAM_LIB"; exit 2; }
    # Source the shared seat logic. This also sets XDG_RUNTIME_DIR, HOME, etc.
    # shellcheck source=/dev/null
    source "$SEAT_LIB"
fi

# Ensure the topic + lifecycle labels exist. Swallow "already exists".
# agent-ready is required: intake and pi-issue@* list that label only
# (fleet-ops#402). gap-audit alone parks findings on the gap-board.
if [ "$DRY_RUN" != "1" ]; then
    if ! gh label view gap-audit -R "$REPO" >/dev/null 2>&1; then
        gh label create gap-audit -R "$REPO" --color FBCA04 --description "Mechanical blind-audit finding" >/dev/null 2>&1 || {
            log "WARN: could not create gap-audit label (it may already exist or token lacks admin)"
        }
    fi
    if ! gh label view agent-ready -R "$REPO" >/dev/null 2>&1; then
        gh label create agent-ready -R "$REPO" --color 0E8A16 --description "Auto: ready for a worker to claim" >/dev/null 2>&1 || {
            log "WARN: could not create agent-ready label (it may already exist or token lacks admin)"
        }
    fi
fi

# --- pick a capable seat, or load a drill fixture -------------------------
if [ "$DRILL" = "1" ]; then
    drill_src="${AUDIT_DRILL_FINDINGS:-}"
    if [ -z "$drill_src" ] || [ ! -f "$drill_src" ]; then
        log "FATAL: AUDIT_DRILL=1 requires AUDIT_DRILL_FINDINGS pointing at a findings JSON file"
        exit 2
    fi
    cp "$drill_src" "$FINDINGS_JSON"
    if [ ! -f "$REPORT_MD" ]; then
        # fleet-ops#786: write the drill report header with a heredoc so the
        # regex (which only flags printf/echo lines with volatile) does not
        # trip on the audit timestamp that lives BEFORE the static prompt.
        cat > "$REPORT_MD" <<EOF
# Fleet blind audit drill — $NOW_ISO

Repo: \`$REPO\`

Fixture: \`$drill_src\`
EOF
    fi
    if ! jq -e . "$FINDINGS_JSON" >/dev/null 2>&1; then
        log "FATAL: drill findings are not valid JSON: $FINDINGS_JSON"
        exit 2
    fi
    findings=$(jq -c . "$FINDINGS_JSON")
    deliberate_json='[]'
    log "DRILL: loaded findings from $drill_src"
else
# --- pick a capable seat ---------------------------------------------------
seat=$(pick_seat "" "" 1 "" || true)
if [ -z "$seat" ]; then
    log "FATAL: no capable seat available"
    exit 1
fi
provider=$(printf '%s' "$seat" | cut -f1)
model=$(printf '%s' "$seat" | cut -f2)
log "seat selected: $provider/$model"

# --- build context ---------------------------------------------------------
# Include a concise snapshot so the reviewer does not have to re-discover paths.
# fleet-ops#786: no head -n caps; the rule forbids line/byte truncation of
# model context to save tokens. The full sorted list is emitted; if the
# repo is large the caller is expected to scope REPO_ROOT or pass
# AUDIT_REPO_ROOT to a smaller subtree.
repo_files=$(find "$REPO_ROOT" -type f -not -path '*/\.git/*' 2>/dev/null | sort)
systemctl_failed=$(systemctl --user list-units --state=failed --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -E '^(pi-|fleet-|siterep-)' || true)
systemctl_timers=$(systemctl --user list-timers --no-legend 2>/dev/null | awk '{print $1, $3}' || true)
open_issues=$(gh issue list -R "$REPO" --state open --json number,title,labels -L 50 2>/dev/null || echo '[]')
closed_issues=$(gh issue list -R "$REPO" --state closed --json number,title,labels,closedAt -L 100 2>/dev/null || echo '[]')
recent_merges=$(gh pr list -R "$REPO" --state merged --json number,title,mergedAt -L 20 2>/dev/null || echo '[]')
GATE_LIB="${AUDIT_MECHANISM_GATE:-$HOME/.local/lib/pi-packet/failure-mechanism-gate.py}"
[ -f "$GATE_LIB" ] || GATE_LIB="$repo_fallback/lib/failure-mechanism-gate.py"
MACHINERY_GATE_LIB="${AUDIT_MACHINERY_GATE:-$HOME/.local/lib/pi-packet/machinery-authorization-gate.py}"
[ -f "$MACHINERY_GATE_LIB" ] || MACHINERY_GATE_LIB="$repo_fallback/lib/machinery-authorization-gate.py"

# Parse deliberate-states into a JSON list for the packet.
deliberate_json='[]'
if [ -f "$DELIBERATE_STATES" ]; then
    deliberate_json=$(python3 - "$DELIBERATE_STATES" <<'PY'
import sys, re, json
path = sys.argv[1]
rows = []
with open(path, 'r', encoding='utf-8') as f:
    in_table = False
    for ln in f:
        if not in_table:
            if re.match(r'^\|?\s*state\s*\|', ln, re.I):
                in_table = True
            continue
        cells = [c.strip() for c in ln.split('|')]
        # Drop empty cells caused by leading/trailing pipes.
        while cells and cells[0] == '':
            cells.pop(0)
        while cells and cells[-1] == '':
            cells.pop()
        # Skip the separator line and blank lines.
        if not cells or all(re.match(r'^[-:]+$', c) for c in cells):
            continue
        if len(cells) >= 4 and cells[0].lower() != 'state' and cells[0]:
            rows.append({
                'state': cells[0],
                'reason': cells[1] if len(cells) > 1 else '',
                'expiry': cells[2] if len(cells) > 2 else '',
                'owner': cells[3] if len(cells) > 3 else ''
            })
print(json.dumps(rows))
PY
    )
fi

# --- manual-seam evidence (fleet-ops#377) ---------------------------------
# Enumerate hand-performed operations since the last cycle so the reviewer
# classifies them and the harness writes the seam table into the report.
# Live sources fail soft (empty list) so tests stay hermetic unless a
# fixture path is passed via AUDIT_SEAM_EVIDENCE.
SEAM_CANDIDATES="$REPORT_DIR/seam-candidates.json"
collect_args=(python3 "$SEAM_LIB" collect --since "$SEAM_SINCE" --now "$NOW_ISO")
if [ -n "${AUDIT_SEAM_EVIDENCE:-}" ]; then
    collect_args+=(--evidence-file "$AUDIT_SEAM_EVIDENCE")
else
    collect_args+=(--memoryctl-dir "${AUDIT_MEMORYCTL_DIR:-$HOME/workspaces/tooling/nish-vault/00 Inbox/agent-drop}")
    collect_args+=(--actions-log "${AUDIT_ACTIONS_LOG:-$HOME/workspaces/agent-state/AUDITOR-LOG.md}")
    if [ -n "${AUDIT_GH_SEAM_EVENTS:-}" ]; then
        collect_args+=(--gh-events "$AUDIT_GH_SEAM_EVENTS")
    else
        gh_seam="$REPORT_DIR/gh-seam-events.json"
        if gh issue list -R "$REPO" --state all --json number,title,body,createdAt -L 40 >"$REPORT_DIR/gh-seam-raw.json" 2>/dev/null; then
            jq '[.[] | {kind:"issue", number, title, body, created_at:.createdAt}]' \
                "$REPORT_DIR/gh-seam-raw.json" >"$gh_seam" 2>/dev/null \
                || printf '%s\n' '[]' >"$gh_seam"
        else
            printf '%s\n' '[]' >"$gh_seam"
        fi
        collect_args+=(--gh-events "$gh_seam")
    fi
    if [ -n "${AUDIT_SYSTEMCTL_STARTS:-}" ]; then
        collect_args+=(--systemctl-starts "$AUDIT_SYSTEMCTL_STARTS")
    fi
fi
if ! "${collect_args[@]}" >"$SEAM_CANDIDATES"; then
    log "WARN: seam collect failed; continuing with empty candidates"
    printf '%s\n' '{"candidates":[]}' >"$SEAM_CANDIDATES"
fi

# --- build the packet ------------------------------------------------------
# fleet-ops#786: do not in-place substitute {{...}} placeholders. The static
# prompt body is byte-identical for cache hits; the volatile context is
# appended AFTER the cat in a "Volatile values" section. The keys mirror
# the prompt's existing placeholder wording (so a fake-pi / fixture that
# regex-matches the LLM-visible "Where to save ..." lines still finds the
# paths) and the values are the resolved run-specific data.
pkt="$REPORT_DIR/packet.md"
{
    cat "$PROMPT"
    printf '\n---\n\n## Volatile values (resolved at assembly time)\n\n'
    printf -- '- Target repo: `%s`\n' "$REPO"
    printf -- '- Repo root: `%s`\n' "$REPO_ROOT"
    printf -- '- Deliberate-states file: `%s`\n' "$DELIBERATE_STATES"
    printf -- '- Where to save findings JSON: `%s`\n' "$FINDINGS_JSON"
    printf -- '- Where to save the full report: `%s`\n' "$REPORT_MD"
    printf -- '- Max findings to return: `%s`\n' "$MAX_FINDINGS"
    printf -- '- Audit run timestamp: `%s`\n' "$NOW_ISO"
    printf -- '- Deliberate-states JSON: `%s`\n' "${deliberate_json:-[]}"
    printf -- '- Open issues in this repo: `%s`\n' "${open_issues:-[]}"
    printf -- '- Recently merged PRs in this repo: `%s`\n' "${recent_merges:-[]}"
    printf -- '- Repo file list: `%s`\n' "${repo_files:-}"
    printf -- '- Failed user systemd units: `%s`\n' "${systemctl_failed:-}"
    printf -- '- User systemd timers: `%s`\n' "${systemctl_timers:-}"
    printf -- '- Gap-closure cycle criteria: `%s`\n' "$CYCLE_CRITERIA"
    printf -- '- Manual-seam window start (last cycle): `%s`\n' "${SEAM_SINCE:-}"
    printf -- '- Manual-seam evidence (hand-performed operations since last cycle): `%s`\n' "$(cat "$SEAM_CANDIDATES" 2>/dev/null || printf '%s' '{"candidates":[]}')"
} > "$pkt"

log "packet built: $pkt (${#pkt}B)"

# --- run pi reviewer -------------------------------------------------------
if [ "$DRY_RUN" = "1" ]; then
    log "DRY RUN: would dispatch $provider/$model with packet $pkt"
    update_plan_stamp "last-blind-audit-run" "$NOW_ISO (dry-run)"
    exit 0
fi

log "dispatching pi reviewer $provider/$model"
set +e
"$PI_BIN" --print --provider "$provider" --model "$model" < "$pkt" >"$PI_STDOUT" 2>"$PI_STDERR"
rc=$?
set -e

log "pi reviewer exited rc=$rc"

# --- extract findings from pi output or file -------------------------------
findings='[]'
if [ -f "$FINDINGS_JSON" ] && [ -s "$FINDINGS_JSON" ]; then
    if jq -e . "$FINDINGS_JSON" >/dev/null 2>&1; then
        findings=$(jq -c . "$FINDINGS_JSON")
        log "findings read from $FINDINGS_JSON"
    else
        log "WARN: $FINDINGS_JSON exists but is not valid JSON; falling back to stdout"
    fi
fi

if [ "$findings" = '[]' ] && [ -f "$PI_STDOUT" ]; then
    # Try to extract a fenced JSON block from the last 2000 lines of stdout.
    fallback=$(python3 - "$PI_STDOUT" <<'PY'
import sys, re, json
path = sys.argv[1]
with open(path, 'r', encoding='utf-8', errors='replace') as f:
    text = f.read()
# Find the last fenced json block.
for m in re.finditer(r'```(?:json)?\s*\n(.*?)```', text, re.S):
    block = m.group(1)
    try:
        data = json.loads(block)
        if isinstance(data, dict) and 'findings' in data:
            print(json.dumps(data))
    except Exception:
        pass
PY
    )
    if [ -n "$fallback" ]; then
        findings="$fallback"
        log "findings extracted from pi stdout"
    fi
fi

# --- write or append report ------------------------------------------------
if [ ! -f "$REPORT_MD" ]; then
    {
        printf '# Fleet blind audit report — %s\n\n' "$NOW_ISO"
        printf 'Repo: `%s`\n\n' "$REPO"
        printf 'Seat: `%s/%s`\n\n' "$provider" "$model"
        printf '## pi reviewer stdout\n\n'
        if [ -f "$PI_STDOUT" ]; then
            # fleet-ops#786: do not byte-cap the reviewer stdout. The full
            # stdout is the audit trail for the run; if the prompt needs to
            # cite it later, capping would void that.
            printf '```\n%s\n```\n\n' "$(cat "$PI_STDOUT" 2>/dev/null)"
        else
            printf '(no stdout)\n\n'
        fi
        if [ -f "$PI_STDERR" ] && [ -s "$PI_STDERR" ]; then
            printf '## pi reviewer stderr\n\n'
            printf '```\n%s\n```\n\n' "$(cat "$PI_STDERR" 2>/dev/null)"
        fi
    } > "$REPORT_MD"
fi

# --- mechanical recurrence hunt (fleet-ops#366) ----------------------------
# Closed failure-fixes whose signal key is firing again are automatic
# findings. Merged here so filing does not depend on the reviewer noticing.
if [ -f "$GATE_LIB" ]; then
    failed_json=$(printf '%s\n' "$systemctl_failed" | jq -R -s -c 'split("\n") | map(select(length>0))')
    hunt_in=$(jq -n \
        --argjson closed "${closed_issues:-[]}" \
        --argjson failed "$failed_json" \
        --argjson open "${open_issues:-[]}" \
        '{closed_issues:$closed, failed_units:$failed, open_issues:$open}')
    hunt_out=$(printf '%s' "$hunt_in" | python3 "$GATE_LIB" hunt)
    if ! printf '%s' "$findings" | jq -e 'type=="object" and has("findings")' >/dev/null 2>&1; then
        if printf '%s' "$findings" | jq -e 'type=="array"' >/dev/null 2>&1; then
            findings=$(printf '%s' "$findings" | jq '{findings: .}')
        else
            findings='{"findings":[]}'
        fi
    fi
    findings=$(jq -s '{findings: (.[0].findings + .[1].findings)}' \
        <(printf '%s' "$findings") <(printf '%s' "$hunt_out"))
    log "recurrence hunt merged ($(printf '%s' "$hunt_out" | jq '.findings | length') hits)"
else
    log "WARN: mechanical-fix gate missing ($GATE_LIB); recurrence hunt skipped"
fi

# --- mechanical machinery-authorization hunt (fleet-ops#1548) -------------
# Hand-placed (non-symlink) user units not on the allowlist become automatic
# findings. Merged here so filing does not depend on the reviewer noticing.
if [ -f "$MACHINERY_GATE_LIB" ]; then
    allowlist="${AUDIT_MACHINERY_ALLOWLIST:-$repo_fallback/config/machinery-allowlist.json}"
    [ -f "$allowlist" ] || allowlist="$HOME/.local/state/pi-packet/machinery-allowlist.json"
    mach_out=$(ALLOWLIST="$allowlist" python3 "$MACHINERY_GATE_LIB" hunt --allowlist "$allowlist" 2>/dev/null || echo '{"findings":[]}')
    if ! printf '%s' "$mach_out" | jq -e 'type=="object" and has("findings")' >/dev/null 2>&1; then
        mach_out='{"findings":[]}'
    fi
    if ! printf '%s' "$findings" | jq -e 'type=="object" and has("findings")' >/dev/null 2>&1; then
        if printf '%s' "$findings" | jq -e 'type=="array"' >/dev/null 2>&1; then
            findings=$(printf '%s' "$findings" | jq '{findings: .}')
        else
            findings='{"findings":[]}'
        fi
    fi
    findings=$(jq -s '{findings: (.[0].findings + .[1].findings)}' \
        <(printf '%s' "$findings") <(printf '%s' "$mach_out"))
    log "machinery hunt merged ($(printf '%s' "$mach_out" | jq '.findings | length') hits)"
else
    log "WARN: machinery-authorization gate missing ($MACHINERY_GATE_LIB); machinery hunt skipped"
fi

# --- manual-seam lens: match, file unmatched, write the report table ------
# fleet-ops#377: the harness writes the ## Manual-seam lens table into the
# report even if the reviewer omitted it, and queues unmatched seams as
# gap-audit findings so the hunt never depends on someone asking.
if ! printf '%s' "$findings" | jq -e 'type=="object" and has("findings")' >/dev/null 2>&1; then
    if printf '%s' "$findings" | jq -e 'type=="array"' >/dev/null 2>&1; then
        findings=$(printf '%s' "$findings" | jq '{findings: .}')
    else
        findings='{"findings":[]}'
    fi
fi
printf '%s\n' "$findings" >"$FINDINGS_JSON"
printf '%s\n' "${open_issues:-[]}" >"$REPORT_DIR/open-issues.json"
set +e
close_json=$(python3 "$SEAM_LIB" close \
    --candidates "$SEAM_CANDIDATES" \
    --findings "$FINDINGS_JSON" \
    --open-issues "$REPORT_DIR/open-issues.json" \
    --report "$REPORT_MD" \
    --seams-out "$REPORT_DIR/seams.json" \
    --since "$SEAM_SINCE" \
    --now "$NOW_ISO" 2>"$REPORT_DIR/seam-close.err")
close_rc=$?
set -e
if [ "$close_rc" -ne 0 ]; then
    log "WARN: seam close failed (rc=$close_rc)"
    if [ -s "$REPORT_DIR/seam-close.err" ]; then
        log "WARN: $(head -c 500 "$REPORT_DIR/seam-close.err")"
    fi
else
    log "seam lens: $close_json"
    findings=$(jq -c . "$FINDINGS_JSON")
fi

# --- findings empty? -------------------------------------------------------
findings_count=$(printf '%s' "$findings" | jq '(.findings // .) | length')
if [ "$findings_count" -eq 0 ]; then
    log "no findings produced by reviewer"
    update_plan_stamp "last-blind-audit-run" "$NOW_ISO (completed, 0 findings)"
    # Still success: an empty sweep is a valid outcome.
    exit 0
fi

log "findings count: $findings_count"
fi # DRILL vs reviewer

# --- run panel and file issues ---------------------------------------------
filed=0
unfiled_pass=0
panel_input=$(mktemp)
body_file=$(mktemp)
trap 'rm -f "$panel_input" "$body_file"' EXIT

# Pre-fetch open gap-audit issues and recent merges once for the panel.
open_gap_issues=$(gh issue list -R "$REPO" -l gap-audit --state open --json number,title -L 100 2>/dev/null || echo '[]')
recent_merged=$(gh pr list -R "$REPO" --state merged --json number,title -L 50 2>/dev/null || echo '[]')

while IFS= read -r finding; do
    [ -n "$finding" ] || continue
    rank=$(printf '%s' "$finding" | jq -r '.rank // "?"')
    title=$(printf '%s' "$finding" | jq -r '.title // ""')
    body=$(printf '%s' "$finding" | jq -r '.body // ""')
    evidence=$(printf '%s' "$finding" | jq -r '.evidence // ""')
    severity=$(printf '%s' "$finding" | jq -r '.severity // ""')

    if [ -z "$title" ]; then
        log "finding $rank: SKIP (empty title)"
        continue
    fi

    # Build panel input.
    jq -n \
        --arg repo "$REPO" \
        --argjson finding "$finding" \
        --argjson open_issues "$open_gap_issues" \
        --argjson recent_merges "$recent_merged" \
        --argjson deliberate_states "$deliberate_json" \
        '{
            repo: $repo,
            finding: $finding,
            open_issues: $open_issues,
            recent_merges: $recent_merges,
            deliberate_states: $deliberate_states
        }' > "$panel_input"

    set +e
    verdict_json=$("$PANEL_BIN" < "$panel_input" 2>&1)
    verdict_rc=$?
    set -e

    if [ "$verdict_rc" -ne 0 ] || [ -z "$verdict_json" ]; then
        verdict_json=$(jq -n --arg reason "panel failed (rc=$verdict_rc)" '{verdict:"FAIL", reason:$reason}')
    fi

    verdict=$(printf '%s' "$verdict_json" | jq -r '.verdict')
    reason=$(printf '%s' "$verdict_json" | jq -r '.reason // ""')
    loud=$(printf '%s' "$verdict_json" | jq -r '.loud // false')
    issue_url=""

    if [ "$verdict" != "PASS" ]; then
        log "finding $rank: PANEL-FAIL ($reason)"
    elif [ "$filed" -ge "$MAX_FINDINGS" ]; then
        reason="skipped: max findings $MAX_FINDINGS reached"
        log "finding $rank: SKIP ($reason)"
    else
        # --body-file avoids ARG_MAX on large findings and keeps % characters
        # in the body from being interpreted by printf-as-format.
        {
            printf '%s\n\n' "$body"
            printf '**Evidence:** %s\n\n' "$evidence"
            printf '**Severity:** %s\n\n' "$severity"
            printf '**Report:** %s\n\n' "$REPORT_MD"
            printf '*Filed by fleet-blind-audit at %s.*\n' "$NOW_ISO"
        } > "$body_file"

        set +e
        new_issue=$("$ISSUE_FILE" file --json -R "$REPO" --title "[gap-audit] $title" --body-file "$body_file" --label gap-audit --label agent-ready 2>/dev/null)
        new_rc=$?
        set -e
        if [ "$new_rc" -eq 0 ] && [ -n "$new_issue" ]; then
            issue_url=$(printf '%s' "$new_issue" | jq -r '.url // empty' 2>/dev/null)
            if [ -z "$issue_url" ]; then
                # Helper classified this as a duplicate and commented on the
                # existing issue rather than filing. Carry the link so the
                # verdict log still shows the dedupe.
                issue_url=$(printf '%s' "$new_issue" | jq -r '.existing // empty' 2>/dev/null)
            fi
            if [ -n "$issue_url" ] && [[ "$issue_url" != http* ]]; then
                issue_url="https://github.com/${issue_url#*github.com/}"
            fi
            log "finding $rank: FILED $issue_url"
            filed=$((filed + 1))
        else
            reason="fleet-issue-file failed: $new_issue"
            log "finding $rank: FAILED to file issue ($new_issue)"
            unfiled_pass=$((unfiled_pass + 1))
        fi
    fi

    jq -n \
        --arg rank "$rank" \
        --arg title "$title" \
        --arg verdict "$verdict" \
        --arg reason "$reason" \
        --arg issue "$issue_url" \
        --argjson loud "$loud" \
        -c '{timestamp: (now | todate), rank:$rank, title:$title, verdict:$verdict, reason:$reason, issue:$issue, loud:$loud}' >> "$VERDICTS_LOG"
done < <(printf '%s\n' "$findings" | jq -c '.findings[]' 2>/dev/null)

# The reviewer is forbidden from filing, and writes "no GitHub issues filed"
# into report.md. Step 6 is this harness: append the actual filing ledger so
# a human reading the report cannot conclude the panel produced zero issues.
{
    printf '\n## Filing results\n\n'
    printf 'The reviewer does not file GitHub issues. This harness does, after the panel.\n\n'
    if [ -s "$VERDICTS_LOG" ]; then
        printf '| Rank | Verdict | Issue or reason |\n'
        printf '|---|---|---|\n'
        jq -r '"| \(.rank) | \(.verdict) | \(if (.issue // "") != "" then .issue else (.reason // "—") end) |"' "$VERDICTS_LOG"
        printf '\n'
    fi
    printf 'Filed: %s (cap %s). Unfiled PASS findings: %s.\n' "$filed" "$MAX_FINDINGS" "$unfiled_pass"
} >> "$REPORT_MD"

log "audit complete: filed=$filed unfiled_pass=$unfiled_pass"
if [ "$unfiled_pass" -gt 0 ]; then
    update_plan_stamp "last-blind-audit-run" "$NOW_ISO (failed, filed=$filed unfiled_pass=$unfiled_pass)"
    log "FATAL: $unfiled_pass PASS finding(s) were not filed"
    exit 1
fi
update_plan_stamp "last-blind-audit-run" "$NOW_ISO (completed, filed=$filed)"
exit 0
