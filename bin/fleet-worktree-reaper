#!/usr/bin/env bash
# fleet-worktree-reaper — GC orphan agent worktrees whose cycle state is
# recorded as terminal (fleet-ops#2227, fleet-ops#2637). Late duplicate
# alerts (e.g. fleet-ops#2560/#2575/#2616/#2637/#2676/#2717/#2774) are
# auto-filed by opus-heartbeat when hygiene_counts.worktree_dirs spikes;
# the reaper is the standing fix and this script's daily timer run is
# the only drain that addresses the count without crossing a boundary.
#
# Heartbeat reports hygiene_counts.worktree_dirs growing monotonically
# (1238 dirs on 2026-08-30, 595 on 2026-09-01, ~619 git-worktree dirs
# today). Each pi-issue worker worktree is ~440MB and there was no
# mechanism for the OTHER branch shapes (main, fix/*, gate/*, etc.) a
# worker leaves behind after its claim branch moves on. This reaper is
# on existing rails: a systemd user timer (no new organ — it exports no
# heartbeat metric) runs this script once daily.
#
# TWO REAPING MODES — a worktree is deleted only when ALL gates for its
# mode hold. The two modes are independent; either may match.
#
# MODE A — claim branch with a terminal PR (fleet-ops#2227, extended
# fleet-ops#3023 to also reap CLOSED-not-merged claims):
#   1. SHAPE:  branch is claim/issue-<N> (the pi-issue claim shape).
#   2. TERMINAL PR: a PR with head claim/issue-<N> exists on the
#              worktree's repo in state MERGED or CLOSED. MERGED means
#              the work landed on main (reaped immediately). CLOSED means
#              the cycle ended without merging — rejected or superseded;
#              the worktree is reaped only after the age gate (grace
#              period for a close-reopen). Squash-merge safe: uses PR
#              state, not SHA ancestry. A claim with NO PR (never opened)
#              is skipped — the cycle state cannot be proved. gh failure
#              for a repo => skip EVERY worktree on it (fail safe, never
#              delete blind).
#   3. TERMINAL: pi-issue@<short>-<N>.service is not active/activating.
#   4. CLEAN:  git status --porcelain empty. Dirty skipped, never
#              force-removed.
#   5. AGE (CLOSED only): worktree directory mtime older than
#              --min-age-hours. MERGED claims are reaped immediately
#              (merged is final); CLOSED claims get the same grace
#              period as Mode C so a freshly-closed PR a worker may
#              reopen is not swept on the next timer tick.
#
# MODE B — pi-issue worker PATH with terminal cycle in dispatch-ledger
# (fleet-ops#2637):
#   1. SHAPE:  path matches issue-<short>-<N> (the pi-issue worker
#              worktree naming convention). Branch may be anything
#              (main, claim/issue-N, wip/*, fix/*, auditor/*, …) — the
#              worker may have moved on after its cycle ended.
#   2. LEDGER-TERMINAL: the dispatch-ledger.jsonl entry for unit
#              pi-issue-<short>-<N> has its MOST RECENT status in
#              {completed, salvaged, closed} (per ledger convention).
#              This is the recorded cycle state — the unit was
#              dispatched, ran, and exited. No ledger entry OR most
#              recent entry is open / redispatched => skip (we cannot
#              prove the cycle is terminal).
#   3. TERMINAL: pi-issue@<short>-<N>.service is not active/activating
#              (defense in depth — the ledger could be stale; the live
#              unit check is authoritative).
#   4. PUSHED:  HEAD is on origin (the fleet-wipe-lessons worktree-
#              remove contract). The branch ref is preserved on origin,
#              so the work survives the worktree removal. This is the
#              safety check the prompt's "never delete a live worktree
#              per repo protocol" requires: push before delete. We use
#              `git ls-remote origin HEAD` for this — one extra gh-free
#              git call per candidate, cheap.
#   5. CLEAN:   git status --porcelain empty. Dirty skipped.
#
# Mode A is the safety-tested original; Mode B is the extension
# that lets the reaper catch worktrees whose claim branch moved on
# (worker died, then someone else moved the worktree to main or a
# different branch). Mode B is gated by the dispatch ledger AND HEAD-
# on-origin, which together make deletion safe even when no PR was
# ever merged — the work is preserved on origin's branch ref either
# way.
#
# MODE C — ANY worktree under $ROOT with HEAD on origin (fleet-ops#2774):
#   1. SHAPE:  any worktree under $ROOT NOT already matched by Mode A
#              or Mode B. Catches the orphan tail on other branch shapes
#              (fix/*, lane1/*, feat/*, docs/*, detached HEAD, …) left
#              behind by lane runners, scout runs, and manual work.
#   2. PUSHED: HEAD is on origin — the vault's actual safe-cleanup check
#              ("Push before deleting a worktree; 'merged' is the wrong
#              question … is this branch PUSHED", global-standing-rules).
#              Uses the per-parent origin SHA cache (one ls-remote per
#              parent repo, not per worktree). Fail-closed: if the cache
#              could not be built, skip every Mode C worktree on that
#              parent.
#   3. CLEAN:  git status --porcelain empty. Dirty skipped, never
#              force-removed.
#   4. TERMINAL: worktree directory mtime older than --min-age-hours
#              (default 24). A worktree a runner just created is
#              protected even if it is momentarily clean + on origin;
#              an orphan that has sat untouched for a day is fair game.
#              When the path matches issue-<short>-<N>, the live-pi-issue
#              unit check (gate B.3) is ALSO applied — defense in depth.
#
# Mode C does NOT consult the dispatch ledger (non-pi-issue worktrees
# have no ledger entries) and does NOT require a merged PR (the vault
# says merged is the wrong question; HEAD-on-origin is the safety
# check). The age gate is the freshness proof that replaces the
# ledger's cycle-terminal proof.
#
# MODE D — stale dirty orphan salvage (fleet-ops#3023 follow-through):
#   The 2026-09-03 snapshot showed worktree_dirs=487 AFTER Mode C
#   landed: the residual is dominated by dirty worktrees the safety
#   gates correctly refuse — uncommitted work exists nowhere else, so
#   deleting the worktree destroys it. Mode D banks that dirt first,
#   then lets the normal mode gates decide:
#   1. STALE:  worktree directory mtime older than --salvage-age-days
#              (default 14) — a much longer grace than Mode C's 24h,
#              because deletion follows a banked copy, not the tree.
#   2. BANK:   run pi-salvage-worktree on the worktree — the same
#              secret-scan + quarantine + push path a dying pi-issue
#              worker gets (fleet-ops#1204). The dirt is committed to
#              wip/wfr-<name>-<ts> and pushed to origin.
#   3. PROOF:  the pushed ref must appear in a fresh `git ls-remote
#              origin` — the helper's own log line is never trusted.
#              A quarantined or push-failed salvage stays local-only
#              and the worktree is kept. EXCEPTION — archived repos:
#              `gh repo view --json isArchived` is checked once per
#              parent; on an archived repo the push can NEVER land, so
#              the local wip ref the helper leaves in the parent clone
#              is the maximal possible preservation, and its existence
#              is verified the same way (SALVAGE-BANKED-LOCAL). Any
#              other push failure keeps the pushed-bank requirement.
#   4. GATES:  a banked worktree then flows through its normal mode
#              gates — Mode A still needs a terminal PR, Mode B a
#              terminal ledger entry. The pushed wip ref satisfies the
#              head-on-origin proof for Modes B/C (the ref's tip is
#              the worktree's post-salvage HEAD, dirt included).
#   5. LIMIT:  at most --salvage-limit salvage attempts per run
#              (default 50) so a first-run backlog drains gradually
#              across daily timer ticks instead of one burst of pushes.
#   Salvage unit names use the wfr-<basename> shape so the ledger
#   records never collide with a real pi-issue unit (Mode B's
#   terminality check is unaffected). Dry-run never banks: stale dirty
#   worktrees are reported as salvage_candidates instead.
#
# Standing rule honored: never delete a live worktree belonging to
# another agent cycle (gates A.3 / B.3 — systemd is authoritative;
# gate C.4 — age + systemd for pi-issue paths; gate D.1 — a stale
# worktree's dirt is banked on origin before the tree is removed).
#
# Removal uses `git worktree remove` (no --force), which itself refuses
# a dirty or locked worktree — defense in depth on top of gates A.4,
# B.5, and C.3.
#
# Usage:
#   fleet-worktree-reaper [--dry-run] [--root DIR] [--min-age-hours N] [--help]
#
# Options:
#   --dry-run        Report what would be removed; delete nothing.
#   --root DIR       Worktree root (default /home/nish/workspaces/agent-worktrees).
#   --min-age-hours N  Mode C freshness gate: only reap worktrees whose
#                    directory mtime is older than N hours (default 24).
#   --salvage-age-days N  Mode D gate: only bank+reap dirty worktrees
#                    whose directory mtime is older than N days (default 14).
#   --salvage-limit N  Max Mode D salvage attempts per run (default 50).
#   --summary-file P  Write the run breakdown as JSON to P (default:
#                    $AGENT_STATE/worktree-reaper-last-run.json). Use
#                    --no-summary-file to disable.
#   --no-summary-file  Skip writing the summary JSON.
#
# Environment seams (tests):
#   SYSTEMCTL          systemctl binary
#   GH                 gh binary
#   FLEET_DISPATCH_LEDGER  dispatch-ledger path (default
#                          $AGENT_STATE/dispatch-ledger.jsonl)
#   FLEET_WORKTREE_REAPER_MERGED_LIMIT  gh pr list --limit (default 5000)
#   FLEET_WORKTREE_REAPER_MIN_AGE_HOURS  Mode C age gate (default 24)
#   FLEET_WORKTREE_REAPER_SALVAGE_AGE_DAYS  Mode D stale-dirty gate
#                          (default 14 days)
#   FLEET_WORKTREE_REAPER_SALVAGE_AGE_S  Mode D gate in seconds —
#                          overrides the days computation (tests)
#   FLEET_WORKTREE_REAPER_SALVAGE_LIMIT  Mode D per-run cap (default 50)
#   PI_SALVAGE_BIN     pi-salvage-worktree binary for Mode D banking
#                          (default: pi-salvage-worktree on PATH)
#   FLEET_WORKTREE_REAPER_NOW_EPOCH      override epoch for age tests
#   FLEET_WORKTREE_REAPER_SUMMARY_FILE   summary JSON path (default:
#                       $AGENT_STATE/worktree-reaper-last-run.json; "" disables)
#
# Exit codes:
#   0  best-effort GC complete (per-worktree failures are logged + counted,
#      never fatal — a timer that aborts on one bad worktree stops all GC)
#   2  missing prereq (git, gh, jq, systemctl) or usage
set -euo pipefail

ROOT="${FLEET_WORKTREE_REAPER_ROOT:-/home/nish/workspaces/agent-worktrees}"
DRY_RUN=0
MERGED_LIMIT="${FLEET_WORKTREE_REAPER_MERGED_LIMIT:-5000}"
MIN_AGE_HOURS="${FLEET_WORKTREE_REAPER_MIN_AGE_HOURS:-24}"
SALVAGE_AGE_DAYS="${FLEET_WORKTREE_REAPER_SALVAGE_AGE_DAYS:-14}"
SALVAGE_LIMIT="${FLEET_WORKTREE_REAPER_SALVAGE_LIMIT:-50}"
# pi-salvage-worktree (fleet-ops#1204) owns the bank semantics — secret
# scan, quarantine, wip/<unit>-<ts> push. Mode D reuses it rather than
# duplicating the scan.
SALVAGE_BIN="${PI_SALVAGE_BIN:-pi-salvage-worktree}"
NOW_EPOCH="${FLEET_WORKTREE_REAPER_NOW_EPOCH:-}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
GH="${GH:-gh}"
AGENT_STATE="${AGENT_STATE:-${HOME:-/home/nish}/workspaces/agent-state}"
LEDGER="${FLEET_DISPATCH_LEDGER:-$AGENT_STATE/dispatch-ledger.jsonl}"
# Summary file: persist the run breakdown so the duty officer (and manual
# verification) can see WHY worktree_dirs is high — reaped vs skipped_dirty
# vs skipped_notpushed — without grepping journalctl. Default writes to
# agent-state/worktree-reaper-last-run.json; set to "" to disable.
SUMMARY_FILE="${FLEET_WORKTREE_REAPER_SUMMARY_FILE:-$AGENT_STATE/worktree-reaper-last-run.json}"

usage() {
    # Print the whole header comment block (line 2 through the first
    # non-comment line) — the fixed `2,105p` range used to truncate
    # before the Usage/Options sections.
    awk 'NR>1 { if ($0 ~ /^#/) { sub(/^# ?/, ""); print; next } exit }' "$0" >&2
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --root) ROOT="${2:?--root needs a DIR}"; shift 2 ;;
        --min-age-hours) MIN_AGE_HOURS="${2:?--min-age-hours needs an N}"; shift 2 ;;
        --salvage-age-days) SALVAGE_AGE_DAYS="${2:?--salvage-age-days needs an N}"; shift 2 ;;
        --salvage-limit) SALVAGE_LIMIT="${2:?--salvage-limit needs an N}"; shift 2 ;;
        --summary-file) SUMMARY_FILE="${2:?--summary-file needs a PATH}"; shift 2 ;;
        --no-summary-file) SUMMARY_FILE=""; shift ;;
        -h|--help) usage ;;
        *) echo "fleet-worktree-reaper: unknown arg: $1" >&2; exit 2 ;;
    esac
done
[[ "$MIN_AGE_HOURS" =~ ^[0-9]+$ ]] || { echo "fleet-worktree-reaper: --min-age-hours must be a non-negative integer" >&2; exit 2; }
[[ "$SALVAGE_AGE_DAYS" =~ ^[0-9]+$ ]] || { echo "fleet-worktree-reaper: --salvage-age-days must be a non-negative integer" >&2; exit 2; }
[[ "$SALVAGE_LIMIT" =~ ^[0-9]+$ ]] || { echo "fleet-worktree-reaper: --salvage-limit must be a non-negative integer" >&2; exit 2; }
# Mode D stale gate in seconds; the _S env seam overrides the days
# computation so tests can use small values (mirrors NOW_EPOCH).
SALVAGE_AGE_S="${FLEET_WORKTREE_REAPER_SALVAGE_AGE_S:-$(( SALVAGE_AGE_DAYS * 86400 ))}"

command -v git >/dev/null 2>&1 || { echo "fleet-worktree-reaper: git missing" >&2; exit 2; }
command -v jq >/dev/null 2>&1  || { echo "fleet-worktree-reaper: jq missing" >&2; exit 2; }
command -v "$GH" >/dev/null 2>&1 || { echo "fleet-worktree-reaper: gh missing" >&2; exit 2; }
command -v "$SYSTEMCTL" >/dev/null 2>&1 || { echo "fleet-worktree-reaper: systemctl missing" >&2; exit 2; }

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

log() { printf '[%s] [worktree-reaper] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# --- discover parent repos from worktree .git pointers --------------------
# Each worktree dir has a .git file: `gitdir: <parent>/.git/worktrees/<name>`.
# Collect the set of parent repos that have worktrees under $ROOT.
declare -a parents=()
declare -A parent_seen=()
while IFS= read -r d; do
    [ -f "$d/.git" ] || continue
    gitdir=$(cat "$d/.git" 2>/dev/null | sed 's/^gitdir: //')
    [ -n "$gitdir" ] || continue
    parent=${gitdir%/.git/worktrees/*}
    [ "$parent" = "$gitdir" ] && continue   # not the expected shape
    if [ -z "${parent_seen[$parent]:-}" ]; then
        parent_seen[$parent]=1
        parents+=("$parent")
    fi
done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)

log "root=$ROOT dry_run=$DRY_RUN parents=${#parents[@]}"

# --- per-parent: list worktrees, resolve repo, batch merged-PR query ------
total_scanned=0
total_claim=0
total_pi_path=0
total_other=0
reaped_a=0
reaped_a_closed=0
reaped_b=0
reaped_c=0
reaped=0
skipped_live=0
skipped_unmerged=0
skipped_dirty=0
skipped_nogit=0
skipped_notpushed=0
skipped_notterminal=0
skipped_young=0
salvaged=0
salvage_attempts=0
salvage_candidates=0
failed=0

# is_live_worker <short> <issue_n>  — mirrors claim-reconcile.
is_live_worker() {
    local short="$1" issue_n="$2"
    local unit="pi-issue@${short}-${issue_n}.service"
    if "$SYSTEMCTL" --user list-units "$unit" --state=active,activating --no-legend 2>/dev/null \
        | awk '{print $1}' | grep -qx "$unit"; then
        return 0
    fi
    if "$SYSTEMCTL" --user list-units --no-legend --type=service --state=running 2>/dev/null \
        | awk '{print $1}' | grep -E "(fable-p|pi-issue)" | grep -q "${short}-${issue_n}"; then
        return 0
    fi
    return 1
}

# closed_claim_refs <owner/repo> -> echoes "<STATE>\t<ref>" lines for
# claim/issue-<N> PRs in state MERGED or CLOSED. GitHub's --state closed
# returns both (a merged PR has state=MERGED inside the closed set). The
# caller splits on the state column: MERGED => reap immediately, CLOSED
# => reap after the age gate (fleet-ops#3023). Empty + rc=1 (gh failure)
# is distinguished from empty + rc=0 (no closed PRs).
closed_claim_refs() {
    local repo="$1"
    "$GH" pr list -R "$repo" --state closed --json headRefName,state --limit "$MERGED_LIMIT" 2>/dev/null \
        | jq -r '.[] | select(.headRefName|startswith("claim/issue-")) | "\(.state)\t\(.headRefName)"' 2>/dev/null
}

# parse_pi_issue_path <path> -> sets globals PI_SHORT, PI_N if path matches
# issue-<short>-<N>[-<suffix>]. Returns 0 on match, 1 otherwise. <short>
# may itself contain hyphens (e.g. fleet-ops, tinystudio-io), so the
# split is greedy on the trailing -<N>[-<suffix>]. The -<suffix>
# variant (e.g. issue-fleet-ops-1179-auditor) is intentional — same
# unit, different worker flavour — and we ignore it for reaping
# purposes: the unit name is pi-issue-<short>-<N> regardless.
parse_pi_issue_path() {
    local path="$1" base="${1##*/}"
    PI_SHORT=""; PI_N=""
    if [[ "$base" =~ ^issue-([A-Za-z0-9._-]+)-([0-9]+)(-.+)?$ ]]; then
        PI_SHORT="${BASH_REMATCH[1]}"
        PI_N="${BASH_REMATCH[2]}"
        # Require <short> to contain no slashes (already enforced by the
        # bracket) and N to be a positive integer (regex does that).
        return 0
    fi
    return 1
}

# unit_terminal_in_ledger <unit> -> 0 if the most recent ledger entry
# for <unit> has status in {completed, salvaged, closed}, 1 otherwise
# (including when the ledger file is absent — fail closed, never
# delete blind). The ledger is read line-by-line because the file is
# large and only the most recent entry per unit matters; a sorted-by-ts
# scan stops at the latest one for each unit.
unit_terminal_in_ledger() {
    local unit="$1"
    [ -r "$LEDGER" ] || return 1
    local latest_status="" latest_ts=""
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        # Cheap unit/ts/status slice via jq — avoids parsing JSON in
        # bash. jq is required (preflight above).
        local u s ts
        u=$(printf '%s' "$line" | jq -r '.unit // ""' 2>/dev/null) || continue
        [ "$u" = "$unit" ] || continue
        s=$(printf '%s' "$line" | jq -r '.status // ""' 2>/dev/null) || continue
        ts=$(printf '%s' "$line" | jq -r '.ts // ""' 2>/dev/null) || continue
        if [ -z "$latest_ts" ] || [[ "$ts" > "$latest_ts" ]]; then
            latest_ts="$ts"; latest_status="$s"
        fi
    done < "$LEDGER"
    case "$latest_status" in
        completed|salvaged|closed) return 0 ;;
        *) return 1 ;;
    esac
}

# head_on_origin <worktree> -> 0 if HEAD is on a tip of some origin
# ref, 1 otherwise. Uses git ls-remote to avoid the round-trip of a
# fetch. This is the same gate fleet-wipe-lessons-check worktree-remove
# uses (fleet-ops#533).
head_on_origin() {
    local wt="$1"
    local head_sha ls_out
    head_sha=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || return 1
    [ -n "$head_sha" ] || return 1
    # git ls-remote prints "<sha>\t<ref>" lines; match the sha. Refuse
    # if the network/remote is unreachable (fail closed — never delete
    # blind).
    ls_out=$(git -C "$wt" ls-remote origin 2>/dev/null) || return 1
    [ -n "$ls_out" ] || return 1
    if printf '%s\n' "$ls_out" | awk '{print $1}' | grep -qx "$head_sha"; then
        return 0
    fi
    return 1
}

# Per-parent origin SHA cache: one `git ls-remote origin` per parent
# repo, then every worktree under that parent checks HEAD against the
# cached SHA set. Without this, Mode C would fire one ls-remote per
# worktree (hundreds of network calls). The cache is a newline-separated
# SHA file scoped to the parent loop iteration.
#
# head_on_origin_cached <worktree> <sha_cache_file> -> 0 if HEAD is in
# the cache file, 1 otherwise. Fail-closed: missing/empty cache => skip.
head_on_origin_cached() {
    local wt="$1" cache="$2"
    local head_sha
    head_sha=$(git -C "$wt" rev-parse HEAD 2>/dev/null) || return 1
    [ -n "$head_sha" ] || return 1
    [ -r "$cache" ] || return 1
    grep -qx "$head_sha" "$cache" 2>/dev/null
}

# worktree_age_seconds <path> -> echoes the directory mtime epoch.
worktree_age_seconds() {
    local wt="$1"
    stat -c %Y "$wt" 2>/dev/null || echo 0
}

# salvage_and_bank <worktree> -> 0 when the worktree's uncommitted work
# is banked on origin under wip/wfr-<basename>-<ts>; 1 otherwise.
# Reuses pi-salvage-worktree (fleet-ops#1204) — the same secret-scan +
# quarantine + push semantics a dying pi-issue worker gets — so the
# scan logic is not duplicated here. The proof is a fresh ls-remote of
# the banked ref, never the helper's own log line: a quarantined or
# push-failed salvage stays local-only and returns 1 so the worktree
# is kept. The wfr-<basename> unit name keeps ledger records clear of
# real pi-issue units (Mode B's terminality check reads unit names).
salvage_and_bank() {
    local wt="$1" parent_archived="${2:-0}"
    command -v "$SALVAGE_BIN" >/dev/null 2>&1 || return 1
    local base unit ts br out rc
    # Unit name is the ROOT-relative path so nested worktrees cannot
    # collide (e.g. candidates/<run>/candidate-1 appears under many
    # parents — basename alone would collide on the wip ref name).
    base="${wt#"$ROOT"/}"
    unit="wfr-$(printf '%s' "$base" | tr -c 'A-Za-z0-9:_.-' '_')"
    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    br="wip/${unit}-${ts}"
    set +e
    out=$(PI_SALVAGE_WORKDIR="$wt" \
          PI_SALVAGE_UNIT="$unit" \
          PI_SALVAGE_NOW="$ts" \
          PI_SALVAGE_PACKET="" \
          FLEET_DISPATCH_LEDGER="$LEDGER" \
          "$SALVAGE_BIN" 2>&1)
    rc=$?
    set -e
    [ -n "$out" ] && log "  $wt: salvage helper: ${out//$'\n'/ | }"
    if [ "$rc" -ne 0 ]; then
        log "  $wt: salvage helper exited rc=$rc — kept"
        return 1
    fi
    # The bank must be PROVEN: a fresh ls-remote of the exact ref the
    # helper was told to create — the helper's own log line is never
    # trusted.
    if git -C "$wt" ls-remote --exit-code origin "refs/heads/${br}" >/dev/null 2>&1; then
        log "  $wt: SALVAGE-BANKED $br on origin"
        return 0
    fi
    # Archived remote: the push can NEVER land (read-only), so the local
    # wip ref the helper leaves in the parent clone is the maximal
    # possible preservation. Verify the ref exists, then the bank counts.
    # On a live repo, a missing pushed ref (quarantine, transient push
    # failure, no permission) keeps the worktree.
    if [ "$parent_archived" = "1" ] \
       && git -C "$wt" rev-parse --verify --quiet "refs/heads/${br}" >/dev/null 2>&1; then
        log "  $wt: SALVAGE-BANKED-LOCAL $br (archived repo — origin is read-only)"
        return 0
    fi
    log "  $wt: salvage not on origin (quarantined or push failed) — kept"
    return 1
}

# now_epoch -> echoes the current epoch (overridable for tests).
now_epoch() {
    if [ -n "$NOW_EPOCH" ]; then
        printf '%s' "$NOW_EPOCH"
    else
        date +%s
    fi
}

for parent in "${parents[@]}"; do
    [ -d "$parent" ] || continue
    # Resolve canonical owner/repo from the parent's origin remote.
    url=$(git -C "$parent" config --get remote.origin.url 2>/dev/null || true)
    [ -n "$url" ] || { log "parent $parent: no origin remote — skip"; continue; }
    # Strip trailing .git, take last path segment as repo; owner is the
    # segment before it. Handles https://github.com/OWNER/REPO(.git).
    owner_repo=${url%.git}
    owner_repo=${owner_repo#*://*/}
    short=${owner_repo##*/}
    [ -n "$short" ] || { log "parent $parent: cannot parse repo from $url — skip"; continue; }

    # Enumerate this parent's worktrees under $ROOT with their branches
    # and a "mode" tag:
    #   Mode A: branch is claim/issue-<N>  (merged-PR gate).
    #   Mode B: path matches issue-<short>-<N>  (ledger + HEAD-on-origin).
    #   Mode C: everything else under $ROOT  (HEAD-on-origin + age gate).
    # All three modes are collected; the per-worktree loop applies the
    # mode-specific gates. Mode C is the catch-all that reaps orphan
    # worktrees on other branch shapes (fix/*, lane1/*, detached, …).
    declare -a wt_paths=() wt_branches=() wt_modes=() wt_shorts=() wt_ns=()
    cur_path=""
    while IFS= read -r line; do
        case "$line" in
            "worktree "*) cur_path=${line#worktree };;
            "branch "*)
                branch=${line#branch }
                branch=${branch#refs/heads/}
                mode="" pshort="" pn=""
                if [ -n "$cur_path" ] && [[ "$cur_path" == "$ROOT"/* ]]; then
                    if [[ "$branch" == claim/issue-* ]]; then
                        n=${branch#claim/issue-}
                        if [[ "$n" =~ ^[1-9][0-9]*$ ]]; then
                            mode="A"
                            pshort="$short"
                            pn="$n"
                        fi
                    fi
                    # Mode B: only set if Mode A didn't claim the same
                    # worktree (avoid double-counting). The path-shape
                    # check is independent of branch.
                    if [ -z "$mode" ] && parse_pi_issue_path "$cur_path"; then
                        # Only count paths whose <short> matches this
                        # parent's resolved short — a worktree named
                        # issue-fleet-ops-1211 in the fleet-ops parent
                        # is ours; a stray issue-context-hub-961 is
                        # not (it belongs to a different parent).
                        if [ "$PI_SHORT" = "$short" ]; then
                            mode="B"
                            pshort="$PI_SHORT"
                            pn="$PI_N"
                        fi
                    fi
                    # Mode C: catch-all for any worktree under $ROOT not
                    # already tagged A or B. pshort/pn stay empty unless
                    # the path happens to match the pi-issue shape (in
                    # which case the live-worker check still applies).
                    if [ -z "$mode" ]; then
                        mode="C"
                        if parse_pi_issue_path "$cur_path" && [ "$PI_SHORT" = "$short" ]; then
                            pshort="$PI_SHORT"
                            pn="$PI_N"
                        fi
                    fi
                fi
                if [ -n "$mode" ]; then
                    wt_paths+=("$cur_path")
                    wt_branches+=("$branch")
                    wt_modes+=("$mode")
                    wt_shorts+=("$pshort")
                    wt_ns+=("$pn")
                fi
                cur_path=""
                ;;
            "detached"*)
                # Detached HEAD worktree: no branch line, but still a
                # Mode C candidate if under $ROOT.
                if [ -n "$cur_path" ] && [[ "$cur_path" == "$ROOT"/* ]]; then
                    pshort="" pn=""
                    if parse_pi_issue_path "$cur_path" && [ "$PI_SHORT" = "$short" ]; then
                        pshort="$PI_SHORT"
                        pn="$PI_N"
                    fi
                    wt_paths+=("$cur_path")
                    wt_branches+=("(detached)")
                    wt_modes+=("C")
                    wt_shorts+=("$pshort")
                    wt_ns+=("$pn")
                fi
                cur_path=""
                ;;
        esac
    done < <(git -C "$parent" worktree list --porcelain 2>/dev/null)
    [ "${#wt_paths[@]}" -gt 0 ] || continue

    # Batch the closed-PR query once per repo (Mode A). GitHub's
    # --state closed returns both MERGED and CLOSED PRs; split into two
    # sets so Mode A can reap MERGED immediately and CLOSED after the
    # age gate (fleet-ops#3023).
    combined=$("$(command -v mktemp)" 2>/dev/null) || combined=""
    merged_set=$("$(command -v mktemp)" 2>/dev/null) || merged_set=""
    closed_set=$("$(command -v mktemp)" 2>/dev/null) || closed_set=""
    gh_ok=1
    if ! closed_claim_refs "$owner_repo" >"$combined" 2>/dev/null; then
        gh_ok=0
        log "repo $owner_repo: gh closed query FAILED — Mode A skip all claim-shaped worktrees (fail safe)"
    else
        awk -F'\t' '$1=="MERGED"{print $2}' "$combined" >"$merged_set" 2>/dev/null || true
        awk -F'\t' '$1=="CLOSED"{print $2}' "$combined" >"$closed_set" 2>/dev/null || true
    fi

    # Per-parent archived flag (Mode D): an archived repo can never
    # accept a salvage push — the local wip ref is the maximal possible
    # bank there. gh failure or any non-"true" answer => not archived
    # (pushed-bank requirement stays; fail safe).
    parent_archived=0
    if [ "$("$GH" repo view "$owner_repo" --json isArchived -q '.isArchived' 2>/dev/null)" = "true" ]; then
        parent_archived=1
        log "repo $owner_repo: ARCHIVED — salvage banks local-only (origin read-only)"
    fi

    # Build the per-parent origin SHA cache once (Mode B + C share it).
    # One `git ls-remote origin` per parent; every worktree under this
    # parent checks HEAD against the cached set. Fail-closed: if the
    # cache cannot be built, Mode B falls back to per-worktree ls-remote
    # (head_on_origin) and Mode C skips every worktree (never delete
    # blind).
    origin_cache=$("$(command -v mktemp)" 2>/dev/null) || origin_cache=""
    origin_cache_ok=0
    if [ -n "$origin_cache" ]; then
        if git -C "$parent" ls-remote origin 2>/dev/null | awk '{print $1}' >"$origin_cache" 2>/dev/null; then
            [ -s "$origin_cache" ] && origin_cache_ok=1
        fi
    fi
    [ "$origin_cache_ok" = 1 ] || log "parent $parent: origin SHA cache FAILED — Mode C skip all (fail safe)"

    for i in "${!wt_paths[@]}"; do
        path="${wt_paths[$i]}"
        branch="${wt_branches[$i]}"
        mode="${wt_modes[$i]}"
        pshort="${wt_shorts[$i]}"
        pn="${wt_ns[$i]}"
        total_scanned=$((total_scanned + 1))
        case "$mode" in
            A) total_claim=$((total_claim + 1)) ;;
            B) total_pi_path=$((total_pi_path + 1)) ;;
            C) total_other=$((total_other + 1)) ;;
        esac

        # Common gates: live worker (only when path matches pi-issue
        # shape) + clean tree (all modes).
        if [ -n "$pshort" ] && [ -n "$pn" ] && is_live_worker "$pshort" "$pn"; then
            skipped_live=$((skipped_live + 1))
            log "  $path: SKIP live worker ($branch, mode=$mode, unit=pi-issue-$pshort-$pn)"
            continue
        fi
        wt_banked=0
        if ! git -C "$path" diff --quiet --ignore-submodules HEAD 2>/dev/null \
           || [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
            # Dirty gate. A STALE dirty orphan gets one Mode D salvage
            # attempt (fleet-ops#3023): bank the dirt to
            # wip/wfr-<name>-<ts> on origin, then let the mode gates
            # re-evaluate — the pushed ref is the work-on-origin proof.
            # Younger dirty worktrees and failed salvages keep the
            # existing SKIP dirty refusal.
            wt_mtime=$(worktree_age_seconds "$path")
            age_s=$(( $(now_epoch) - wt_mtime ))
            if [ "$age_s" -ge "$SALVAGE_AGE_S" ]; then
                # salvage_candidates counts the WHOLE stale-dirty
                # backlog (uncapped) so the summary reports the true
                # pile size; the per-run bank cap applies to attempts.
                salvage_candidates=$((salvage_candidates + 1))
                if [ "$DRY_RUN" = 1 ]; then
                    log "  $path: DRY-SALVAGE-CAND ($branch, mode=$mode, age=${age_s}s)"
                elif [ "$salvage_attempts" -lt "$SALVAGE_LIMIT" ]; then
                    salvage_attempts=$((salvage_attempts + 1))
                    if salvage_and_bank "$path" "$parent_archived"; then
                        salvaged=$((salvaged + 1))
                        wt_banked=1
                        # A banked tree should now be clean (the helper
                        # committed the dirt); re-verify before the mode
                        # gates see it as reaped-eligible.
                        if ! git -C "$path" diff --quiet --ignore-submodules HEAD 2>/dev/null \
                           || [ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]; then
                            wt_banked=0
                            log "  $path: salvage banked but tree still dirty — kept"
                        fi
                    fi
                else
                    log "  $path: SKIP-D salvage-limit ($branch, mode=$mode, limit=$SALVAGE_LIMIT)"
                fi
            fi
            if [ "$wt_banked" = 0 ]; then
                skipped_dirty=$((skipped_dirty + 1))
                log "  $path: SKIP dirty ($branch, mode=$mode)"
                continue
            fi
        fi

        if [ "$mode" = "A" ]; then
            # Gate A.2: terminal PR (MERGED or CLOSED). gh failure =>
            # fail safe: skip every Mode A worktree on this repo (never
            # delete blind).
            if [ "$gh_ok" = 0 ]; then
                skipped_unmerged=$((skipped_unmerged + 1))
                log "  $path: SKIP gh-fail repo ($branch)"
                continue
            fi
            a_kind=""
            if grep -qx "$branch" "$merged_set" 2>/dev/null; then
                a_kind="merged"
            elif grep -qx "$branch" "$closed_set" 2>/dev/null; then
                # CLOSED-not-merged: the cycle ended (rejected or
                # superseded). Reap after the age gate so a freshly-
                # closed PR a worker may reopen is not swept on the next
                # timer tick (fleet-ops#3023). MERGED is reaped
                # immediately (merged is final).
                wt_mtime=$(worktree_age_seconds "$path")
                now_s=$(now_epoch)
                age_s=$(( now_s - wt_mtime ))
                min_age_s=$(( MIN_AGE_HOURS * 3600 ))
                if [ "$age_s" -lt "$min_age_s" ]; then
                    skipped_young=$((skipped_young + 1))
                    log "  $path: SKIP-A closed-too-young ($branch, age=${age_s}s < ${min_age_s}s)"
                    continue
                fi
                a_kind="closed"
            else
                skipped_unmerged=$((skipped_unmerged + 1))
                log "  $path: SKIP not-merged ($branch)"
                continue
            fi
            if [ "$DRY_RUN" = 1 ]; then
                reaped_a=$((reaped_a + 1))
                [ "$a_kind" = "closed" ] && reaped_a_closed=$((reaped_a_closed + 1))
                reaped=$((reaped + 1))
                log "  $path: DRY-REAP-A ($branch, $a_kind, terminal, clean)"
                continue
            fi
            if git -C "$parent" worktree remove "$path" 2>/dev/null; then
                reaped_a=$((reaped_a + 1))
                [ "$a_kind" = "closed" ] && reaped_a_closed=$((reaped_a_closed + 1))
                reaped=$((reaped + 1))
                log "  $path: REAPED-A ($branch, $a_kind)"
            else
                failed=$((failed + 1))
                log "  $path: REMOVE-A FAILED ($branch) — left in place"
            fi
        elif [ "$mode" = "B" ]; then
            # Mode B: ledger-terminal + HEAD on origin. The ledger is
            # the recorded cycle state; the live-worker check above is
            # defense in depth.
            unit="pi-issue-${pshort}-${pn}"
            if ! unit_terminal_in_ledger "$unit"; then
                skipped_notterminal=$((skipped_notterminal + 1))
                log "  $path: SKIP-B not-ledger-terminal ($branch, unit=$unit)"
                continue
            fi
            # Use the per-parent cache if available; fall back to the
            # per-worktree ls-remote (preserves the original contract).
            # A Mode D banked tree needs no check: the pushed wip ref
            # already proved the work (HEAD + dirt) is on origin.
            if [ "$wt_banked" = 0 ]; then
                if [ "$origin_cache_ok" = 1 ]; then
                    if ! head_on_origin_cached "$path" "$origin_cache"; then
                        skipped_notpushed=$((skipped_notpushed + 1))
                        log "  $path: SKIP-B head-not-on-origin ($branch) — work is local; refuse"
                        continue
                    fi
                else
                    if ! head_on_origin "$path"; then
                        skipped_notpushed=$((skipped_notpushed + 1))
                        log "  $path: SKIP-B head-not-on-origin ($branch) — work is local; refuse"
                        continue
                    fi
                fi
            fi
            if [ "$DRY_RUN" = 1 ]; then
                reaped_b=$((reaped_b + 1))
                reaped=$((reaped + 1))
                log "  $path: DRY-REAP-B ($branch, mode=B ledger-terminal=$unit, clean, pushed)"
                continue
            fi
            if git -C "$parent" worktree remove "$path" 2>/dev/null; then
                reaped_b=$((reaped_b + 1))
                reaped=$((reaped + 1))
                log "  $path: REAPED-B ($branch, mode=B)"
            else
                failed=$((failed + 1))
                log "  $path: REMOVE-B FAILED ($branch) — left in place"
            fi
        else
            # Mode C: HEAD on origin (vault safe-cleanup order) + age
            # gate. No ledger, no merged-PR requirement — the vault says
            # "merged is the wrong question; is this branch PUSHED."
            # Fail-closed on the origin cache: never delete blind. A
            # Mode D banked tree skips both checks: the pushed wip ref
            # already proved the work (HEAD + dirt) is on origin, and
            # the cache was built before the push so it cannot contain
            # the post-salvage HEAD anyway.
            if [ "$wt_banked" = 0 ]; then
                if [ "$origin_cache_ok" = 0 ]; then
                    skipped_notpushed=$((skipped_notpushed + 1))
                    log "  $path: SKIP-C origin-cache-fail ($branch) — fail safe"
                    continue
                fi
                if ! head_on_origin_cached "$path" "$origin_cache"; then
                    skipped_notpushed=$((skipped_notpushed + 1))
                    log "  $path: SKIP-C head-not-on-origin ($branch) — work is local; refuse"
                    continue
                fi
            fi
            # Age gate: worktree directory mtime must be older than
            # --min-age-hours. Protects a worktree a runner just created
            # that is momentarily clean + on origin.
            wt_mtime=$(worktree_age_seconds "$path")
            now_s=$(now_epoch)
            age_s=$(( now_s - wt_mtime ))
            min_age_s=$(( MIN_AGE_HOURS * 3600 ))
            if [ "$age_s" -lt "$min_age_s" ]; then
                skipped_young=$((skipped_young + 1))
                log "  $path: SKIP-C too-young ($branch, age=${age_s}s < ${min_age_s}s)"
                continue
            fi
            if [ "$DRY_RUN" = 1 ]; then
                reaped_c=$((reaped_c + 1))
                reaped=$((reaped + 1))
                log "  $path: DRY-REAP-C ($branch, mode=C on-origin, clean, age=${age_s}s)"
                continue
            fi
            if git -C "$parent" worktree remove "$path" 2>/dev/null; then
                reaped_c=$((reaped_c + 1))
                reaped=$((reaped + 1))
                log "  $path: REAPED-C ($branch, mode=C)"
            else
                failed=$((failed + 1))
                log "  $path: REMOVE-C FAILED ($branch) — left in place"
            fi
        fi
    done
    [ -n "$combined" ] && rm -f "$combined"
    [ -n "$merged_set" ] && rm -f "$merged_set"
    [ -n "$closed_set" ] && rm -f "$closed_set"
    [ -n "$origin_cache" ] && rm -f "$origin_cache"
done

log "done: scanned=$total_scanned claim=$total_claim pi_path=$total_pi_path other=$total_other \
reaped=$reaped (A=$reaped_a [closed=$reaped_a_closed] B=$reaped_b C=$reaped_c) \
skipped_live=$skipped_live skipped_unmerged=$skipped_unmerged \
skipped_dirty=$skipped_dirty skipped_notpushed=$skipped_notpushed \
skipped_notterminal=$skipped_notterminal skipped_young=$skipped_young \
salvaged=$salvaged salvage_attempts=$salvage_attempts salvage_candidates=$salvage_candidates nogit=$skipped_nogit failed=$failed"
printf 'fleet-worktree-reaper scanned=%s claim=%s pi_path=%s other=%s reaped=%s (A=%s [closed=%s] B=%s C=%s) live=%s unmerged=%s dirty=%s notpushed=%s notterminal=%s young=%s salvaged=%s salvage_attempts=%s salvage_candidates=%s nogit=%s failed=%s\n' \
    "$total_scanned" "$total_claim" "$total_pi_path" "$total_other" \
    "$reaped" "$reaped_a" "$reaped_a_closed" "$reaped_b" "$reaped_c" \
    "$skipped_live" "$skipped_unmerged" "$skipped_dirty" \
    "$skipped_notpushed" "$skipped_notterminal" "$skipped_young" \
    "$salvaged" "$salvage_attempts" "$salvage_candidates" "$skipped_nogit" "$failed"

# Persist the run breakdown as JSON so the duty officer and manual
# verification can see WHY worktree_dirs is high (reaped vs skipped_dirty
# vs skipped_notpushed) without grepping journalctl. Best-effort: a write
# failure is logged, never fatal.
if [ -n "$SUMMARY_FILE" ]; then
    run_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    summary_json=$(printf '{"script":"fleet-worktree-reaper","ts":"%s","dry_run":%s,"scanned":%s,"reaped":%s,"reaped_a":%s,"reaped_a_closed":%s,"reaped_b":%s,"reaped_c":%s,"skipped_live":%s,"skipped_unmerged":%s,"skipped_dirty":%s,"skipped_notpushed":%s,"skipped_notterminal":%s,"skipped_young":%s,"salvaged":%s,"salvage_attempts":%s,"salvage_candidates":%s,"skipped_nogit":%s,"failed":%s,"claim":%s,"pi_path":%s,"other":%s}' \
        "$run_ts" "$DRY_RUN" "$total_scanned" "$reaped" "$reaped_a" "$reaped_a_closed" "$reaped_b" "$reaped_c" \
        "$skipped_live" "$skipped_unmerged" "$skipped_dirty" "$skipped_notpushed" \
        "$skipped_notterminal" "$skipped_young" "$salvaged" "$salvage_attempts" "$salvage_candidates" \
        "$skipped_nogit" "$failed" \
        "$total_claim" "$total_pi_path" "$total_other")
    if ! printf '%s\n' "$summary_json" >"$SUMMARY_FILE.tmp.$$" 2>/dev/null \
       || ! mv -f "$SUMMARY_FILE.tmp.$$" "$SUMMARY_FILE" 2>/dev/null; then
        log "summary-file write FAILED ($SUMMARY_FILE) — non-fatal"
        rm -f "$SUMMARY_FILE.tmp.$$" 2>/dev/null || true
    fi
fi
