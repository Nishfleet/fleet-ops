#!/usr/bin/env bash
# fleet-credential-expiry-canary — credential/token expiry coverage gate
# (fleet-ops#938, led-2026-08-27-vacation-window-corrected;
#  pre-expiry probe fleet-ops#2134, WFR 2026-08-29 lens-6-security).
#
# Nish departs 2026-08-28, returns 2026-09-08. The ledger line requires that
# credential/token/quota expiry checks cover through 2026-09-08 inclusive.
#
# Official docs (not folklore):
#   GitHub App private keys do not expire
#   (docs.github.com/.../managing-private-keys-for-github-apps).
#   There is no App private-key list API. This wrapper proves GET /app
#   accepts a minted App JWT, and that FLEET_SYNC_PAT's
#   GitHub-Authentication-Token-Expiration header (changelog 2021-07-26)
#   is after 2026-09-08 when the PAT is present.
#
# Installation tokens (GH_TOKEN) last <=1h and are reminted — not checked here.
# worker-app-canary covers mint liveness (fleet-ops#413).
# verify-fleet-sync-pat covers PAT scope/push liveness (fleet-ops#482) and has
# no expiry-horizon flag (--help confirmed 2026-08-27).
#
# PRE-EXPIRY PROBE (fleet-ops#2134): a model-seat credential that CARRIES a
# known expiry (the OAuth `expires` field pi writes to
# ~/.pi/agent/auth.json[<provider>]) is probed N hours before it expires.
# The reactive seat-health ledger only records credentials_bad AFTER a
# worker burns a slot — that gap let devin/swe-1-7 die to a production 403
# (fleet-ops#2108). This probe fires BEFORE the 403: on PRE-EXPIRY-DETECTED
# the wrapper auto-files a renewal issue (deduped by
# `signal: cred-expiry/<provider>`) via fleet-issue-file, and observe-to-
# closes it (canary-covered comment + close) the tick the signal clears.
# grok-token-refresh heals xai-oauth on a 4h timer; this probe is the
# defence-in-depth that catches a broken heal path on the next heartbeat.
# The threshold N is AI-advisory; the probe-fires-before-403 invariant is
# deterministic. Credentials with no known expiry (static API keys, GitHub
# App private keys) are not probeable here.
#
# Fail-loud: dead App, a PAT that expires on or before 2026-09-08, or a
# PRE-EXPIRY-DETECTED model-seat credential.
# SKIP: network unreachable.
#
# Environment seams (tests):
#   FLEET_CRED_EXPIRY_FILE_ISSUES   1 (default) auto-file renewal issues on
#                                   PRE-EXPIRY-DETECTED; 0 skips filing.
#   FLEET_CRED_EXPIRY_CLOSE_ISSUES  1 (default) observe-to-close (comment +
#                                   close) renewal issues the tick the
#                                   signal clears; 0 skips closing.
#   FLEET_CRED_EXPIRY_ISSUE_REPO    Nishfleet/fleet-ops (where to file).
#   GH                              gh binary (tests stub this).
#   FLEET_ISSUE_FILE                fleet-issue-file binary (tests stub).
#
# The implementation lives in lib/credential-expiry-canary.py.

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
lib="${FLEET_CREDENTIAL_EXPIRY_CANARY_LIB:-$here/../lib/pi-packet/credential-expiry-canary.py}"
[ -f "$lib" ] || lib="$here/../lib/credential-expiry-canary.py"
[ -f "$lib" ] || { echo "fleet-credential-expiry-canary: library missing: $lib" >&2; exit 2; }

GH="${GH:-gh}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$here" && pwd)/fleet-issue-file}"
FILE_ISSUES="${FLEET_CRED_EXPIRY_FILE_ISSUES:-1}"
CLOSE_ISSUES="${FLEET_CRED_EXPIRY_CLOSE_ISSUES:-1}"
ISSUE_REPO="${FLEET_CRED_EXPIRY_ISSUE_REPO:-Nishfleet/fleet-ops}"
SIGNAL_PREFIX="cred-expiry"

log() {
    printf '[%s] [fleet-credential-expiry-canary] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

# --ledger-line is a metadata query (prints the standing-rule line to
# stdout and exits 0). It needs no stdout capture and no auto-file, so exec
# the lib directly — preserving stdout for the caller.
for _a in "$@"; do
    if [[ "$_a" == "--ledger-line" ]]; then
        exec python3 "$lib" "$@"
    fi
done

# Run the lib, capturing stdout (machine-readable JSON when there are
# pre-expiry findings) to a temp file and passing stderr through unchanged
# to the heartbeat journal. The lib's exit code is the canary verdict
# (1 = REJECT or PRE-EXPIRY-DETECTED). The lib is deterministic for the
# GitHub path and the online path is bounded (one GET /app + one GET /user),
# so a single run with split streams is correct and cheap. stdout is only
# used for the JSON contract (the human verdict goes to stderr), so
# capturing it does not affect callers other than --ledger-line (handled
# above).
stdout_file="$(mktemp -t cred-expiry-stdout.XXXXXX)"
trap 'rm -f "$stdout_file"' EXIT INT TERM
set +e
python3 "$lib" "$@" >"$stdout_file"
rc=$?
set -e

# --- pre-expiry auto-file + observe-to-close (fleet-ops#2134) -------------
# Parse the lib's stdout JSON. When non-empty, it carries
# {"pre_expiry_detected":[{provider,expires_at,remaining_s,signal,...}]}.
# When empty, no pre-expiry finding this tick -> observe-to-close any open
# renewal issue whose signal is no longer detected.
has_json=0
findings_json="[]"
if [[ -s "$stdout_file" ]]; then
    if findings_json="$(jq -c '.pre_expiry_detected // []' "$stdout_file" 2>/dev/null)" && [[ -n "$findings_json" ]]; then
        has_json=1
    fi
fi

detected_count=0
if [[ "$has_json" == "1" ]]; then
    detected_count="$(jq 'length' <<<"$findings_json" 2>/dev/null || echo 0)"
fi

if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    # List open issues in the repo so we can dedupe (file) and observe-to-close.
    open_json="[]"
    set +e
    open_json="$("$GH" issue list -R "$ISSUE_REPO" --state open --limit 200 --json number,body,title 2>/dev/null)"
    gh_list_rc=$?
    set -e
    if [[ "$gh_list_rc" -ne 0 ]] || [[ -z "$open_json" ]]; then
        open_json="[]"
        log "WARN: could not list open issues for dedupe/observe-to-close (gh rc=$gh_list_rc)"
    fi

    # --- auto-file renewal issues for new PRE-EXPIRY-DETECTED signals ---
    if [[ "$detected_count" -gt 0 ]]; then
        while IFS= read -r finding; do
            [[ -n "$finding" ]] || continue
            provider=$(jq -r '.provider' <<<"$finding")
            signal=$(jq -r '.signal' <<<"$finding")
            expires_at=$(jq -r '.expires_at' <<<"$finding")
            remaining_s=$(jq -r '.remaining_s' <<<"$finding")
            # Dedupe: skip if an open issue already carries this signal.
            if jq -e --arg s "$signal" '[.[] | select((.body // "") | contains($s))] | length > 0' \
                <<<"$open_json" >/dev/null 2>&1; then
                log "pre-expiry: $provider already has an open renewal issue (deduped, $signal)"
                continue
            fi
            title="fix(cred-expiry): renew $provider credential before expiry (auto-filed)"
            body="## Problem

The credential-expiry canary detected a model-seat credential with a known
expiry that is within the pre-expiry threshold of expiring. The reactive
seat-health ledger only records credentials_bad AFTER a worker burns a slot
— this probe fires BEFORE the 403 (fleet-ops#2134, WFR 2026-08-29
lens-6-security).

## Finding

- provider: \`$provider\`
- expires_at: \`$expires_at\`
- remaining_s: \`$remaining_s\` (negative = already past expiry)
- $signal

## Action

Renew the \`$provider\` credential. For xai-oauth (SuperGrok), the
grok-token-refresh.timer is the heal path — check
\`systemctl --user status grok-token-refresh.service\` and
\`journalctl --user -u grok-token-refresh.service\`. If the timer is
healthy the next tick will rotate the token and this issue auto-closes
(observe-to-close).

## Termination

The credential-expiry canary next tick no longer reports
PRE-EXPIRY-DETECTED for \`$provider\` — this issue observe-to-closes.

$signal"
            set +e
            created=$("$ISSUE_FILE" file -R "$ISSUE_REPO" --title "$title" --body "$body" 2>/tmp/cred-expiry-create.err)
            create_rc=$?
            set -e
            if [[ "$create_rc" -eq 0 ]]; then
                log "pre-expiry: FILED renewal issue for $provider -> $created ($signal)"
            else
                log "WARN: failed to file renewal issue for $provider (rc=$create_rc) $(tr '\n' ' ' </tmp/cred-expiry-create.err 2>/dev/null)"
            fi
        done < <(jq -c '.[]' <<<"$findings_json")
    fi

    # --- observe-to-close: signals no longer detected this tick ---
    # An open issue carrying `signal: cred-expiry/<provider>` whose provider
    # is NOT in the current detected list has cleared -> comment + close.
    if [[ "$CLOSE_ISSUES" == "1" ]]; then
        detected_providers="$(jq -r '[.[].provider] | join("|")' <<<"$findings_json" 2>/dev/null || echo "")"
        while IFS=$'\t' read -r num body; do
            [[ -n "$num" ]] || continue
            sig=$(printf '%s' "$body" | grep -oE "signal: ${SIGNAL_PREFIX}/[A-Za-z0-9_.-]+" | head -1 || true)
            [[ -n "$sig" ]] || continue
            prov="${sig#signal: "${SIGNAL_PREFIX}"/}"
            # Skip if this provider is still detected this tick.
            if [[ -n "$detected_providers" ]] && printf '%s' "|$detected_providers|" | grep -qF "|$prov|"; then
                continue
            fi
            ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            comment="canary-covered: $sig no longer reported on heartbeat tick at $ts. The credential-expiry canary pre-expiry probe (fleet-ops#2134) shows $prov is no longer within the pre-expiry threshold — renewed or healed. Observe-to-close."
            set +e
            "$GH" issue comment "$num" -R "$ISSUE_REPO" --body "$comment" >/dev/null 2>&1
            comment_rc=$?
            "$GH" issue close "$num" -R "$ISSUE_REPO" >/dev/null 2>&1
            close_rc=$?
            set -e
            if [[ "$close_rc" -eq 0 ]]; then
                log "observe-to-close: CLOSED renewal issue #$num ($sig)"
            else
                log "observe-to-close: failed to close #$num (comment_rc=$comment_rc close_rc=$close_rc)"
            fi
        done < <(jq -r '.[] | [.number, (.body // "")] | @tsv' <<<"$open_json" 2>/dev/null)
    fi
fi

exit "$rc"
