#!/usr/bin/env bash
# fleet-credential-expiry-canary — credential/token expiry coverage gate
# (fleet-ops#938, led-2026-08-27-vacation-window-corrected).
#
# Nish departs 2026-08-28, returns 2026-09-08. The ledger line requires that
# credential/token/quota expiry checks cover through 2026-09-08 inclusive.
#
# Official docs (not folklore):
#   GitHub App private keys do not expire
#   (docs.github.com/.../managing-private-keys-for-github-apps).
#   There is no App private-key list API. This wrapper proves GET /app
#   accepts a minted App JWT, and that FLEET_SYNC_PAT's
#   GitHub-Authentication-Token-Expiration header (changelog 2021-07-26)
#   is after 2026-09-08 when the PAT is present.
#
# Installation tokens (GH_TOKEN) last <=1h and are reminted — not checked here.
# worker-app-canary covers mint liveness (fleet-ops#413).
# verify-fleet-sync-pat covers PAT scope/push liveness (fleet-ops#482) and has
# no expiry-horizon flag (--help confirmed 2026-08-27).
#
# Fail-loud: dead App, or a PAT that expires on or before 2026-09-08.
# SKIP: network unreachable.
#
# The implementation lives in lib/credential-expiry-canary.py.

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
lib="${FLEET_CREDENTIAL_EXPIRY_CANARY_LIB:-$here/../lib/pi-packet/credential-expiry-canary.py}"
[ -f "$lib" ] || lib="$here/../lib/credential-expiry-canary.py"
[ -f "$lib" ] || { echo "fleet-credential-expiry-canary: library missing: $lib" >&2; exit 2; }

exec python3 "$lib" "$@"
