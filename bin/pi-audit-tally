#!/usr/bin/env bash
# bin/pi-audit-tally
#
# Tallies the three senior-auditor votes for one scout candidate and applies
# the result to the GitHub issue: 2-of-3 PASS -> add agent-ready, drop
# scout-candidate; 2-of-3 FAIL -> add discarded, drop scout-candidate, and
# comment with the fail reasons; otherwise -> no action (pending).
#
# Args: <repo> <candidate>
#
# Environment seams:
#   AUDIT_STATE_DIR    vote file tree
#   AUDIT_GH           gh override
#   AUDIT_DRY_RUN      1 = log, do not mutate labels

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${AUDIT_GH:-gh}"
STATE_DIR="${AUDIT_STATE_DIR:-$HOME/.local/state/fleet-audit}"
DRY_RUN="${AUDIT_DRY_RUN:-0}"

spec_gate_py() {
    if [ -n "${AGENT_READY_SPEC_GATE:-}" ]; then
        printf '%s\n' "$AGENT_READY_SPEC_GATE"
        return 0
    fi
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$here/../lib/agent-ready-spec-gate.py" ]; then
        printf '%s\n' "$here/../lib/agent-ready-spec-gate.py"
        return 0
    fi
    printf '%s\n' "/home/nish/.local/lib/pi-packet/agent-ready-spec-gate.py"
}

issue_passes_spec_gate() {
    local body="$1"
    local py
    py=$(spec_gate_py)
    if [ ! -f "$py" ]; then
        log "SPEC-GATE missing at $py — refuse agent-ready (fail closed)"
        return 1
    fi
    printf '%s' "$body" | python3 "$py" check-body >/dev/null
}

# fleet-ops#3121: keyword-only compliance is not a judgement. A PASS reason
# must carry repo-specific evidence — an issue number (#N), a path, or a URL —
# or the admission (2-of-3 PASS) is keyword-babble, not a senior verdict.
# Returns 0 when the reason names evidence, 1 when it is keyword-only.
reason_has_evidence() {
    local r="$1"
    grep -qE '#[0-9]+|[a-z][a-z0-9+.-]*://|[A-Za-z0-9_.]+/[A-Za-z0-9_.]+' <<<"$r"
}

log() { printf '[%s] [pi-audit-tally] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

[ $# -eq 2 ] || { log "usage: pi-audit-tally <repo> <candidate>"; exit 2; }
repo="$1"
candidate="$2"

case_dir() {
    printf '%s/%s/%s\n' "$STATE_DIR" "$repo" "$candidate"
}

votes_json() {
    local dir
    dir=$(case_dir)
    shopt -s nullglob
    local files=("$dir"/*.vote)
    shopt -u nullglob
    if [ "${#files[@]}" -eq 0 ]; then
        printf '[]\n'
        return
    fi
    jq -s '.' "${files[@]}"
}

main() {
    local dir votes pass fail reasons
    dir=$(case_dir)
    if [ ! -d "$dir" ]; then
        log "no votes yet for $repo/#$candidate"
        exit 0
    fi

    votes=$(votes_json)
    pass=$(printf '%s\n' "$votes" | jq '[.[] | select(.verdict == "PASS")] | length')
    fail=$(printf '%s\n' "$votes" | jq '[.[] | select(.verdict == "FAIL")] | length')
    reasons=$(printf '%s\n' "$votes" | jq -r '[.[] | "\(.role): \(.verdict) - \(.reason)"] | join("\n")')

    log "$repo/#$candidate votes: PASS=$pass FAIL=$fail"

    if [ "$pass" -ge 2 ]; then
        # fleet-ops#543: 2-of-3 PASS is not enough without a spec.
        # fleet-ops#3121: nor without repo-specific evidence in the PASS
        # reasons — keyword-only compliance is not a judgement.
        local pass_reasons evidenceless
        pass_reasons=$(printf '%s\n' "$votes" | jq -r '[.[] | select(.verdict == "PASS") | .reason] | join("\n")')
        evidenceless=0
        while IFS= read -r r; do
            [ -n "$r" ] || continue
            if ! reason_has_evidence "$r"; then
                evidenceless=1
                log "$repo/#$candidate PASS reason lacks repo-specific evidence (issue #, path, or URL): $(printf '%s' "$r" | head -c 160)"
            fi
        done <<<"$pass_reasons"
        if [ "$evidenceless" = "1" ]; then
            log "$repo/#$candidate EVIDENCE-REFUSED (2-of-3 PASS but keyword-only reasons)"
            if [ "$DRY_RUN" = "1" ]; then
                log "DRY-RUN: would refuse agent-ready for $repo/#$candidate (keyword-only PASS reasons)"
            else
                "$GH" issue comment "$candidate" -R "Nishfleet/$repo" \
                    --body "evidence-refused (fleet-ops#3121). 2-of-3 PASS, but at least one PASS reason is keyword-only with no repo-specific evidence (issue number, path, or URL). Keyword-only compliance is not a judgement." \
                    >/dev/null 2>&1 || true
            fi
            exit 0
        fi
        issue_json=$("$GH" issue view "$candidate" -R "Nishfleet/$repo" --json body 2>/dev/null || true)
        issue_body=$(printf '%s' "$issue_json" | jq -r '.body // empty')
        if ! issue_passes_spec_gate "$issue_body"; then
            log "$repo/#$candidate SPEC-GATE-REFUSED (2-of-3 PASS but no spec)"
            if [ "$DRY_RUN" = "1" ]; then
                log "DRY-RUN: would refuse agent-ready for $repo/#$candidate (no spec)"
            else
                "$GH" issue comment "$candidate" -R "Nishfleet/$repo" \
                    --body "spec-gate: refused agent-ready (fleet-ops#543). 2-of-3 PASS, but the body needs termination: / accept: / required: / metric:." \
                    >/dev/null 2>&1 || true
            fi
            exit 0
        fi
        log "$repo/#$candidate admitted (2-of-3 PASS)"
        if [ "$DRY_RUN" = "1" ]; then
            log "DRY-RUN: would add agent-ready + remove scout-candidate for $repo/#$candidate"
        else
            if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label agent-ready >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue edit FAILED (admit)"
                exit 1
            fi
        fi
        exit 0
    fi

    if [ "$fail" -ge 2 ]; then
        log "$repo/#$candidate discarded (2-of-3 FAIL)"
        if [ "$DRY_RUN" = "1" ]; then
            log "DRY-RUN: would add discarded + remove scout-candidate + comment for $repo/#$candidate"
            log "discarded reasons:\n$reasons"
        else
            if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label discarded >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue edit FAILED (discard)"
                return 0  # still try to comment
            fi
            if ! "$GH" issue comment "$candidate" -R "Nishfleet/$repo" --body "Senior auditor panel (2-of-3) discarded this candidate. Reasons:\n\n$reasons" >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue comment FAILED (discard)"
            fi
        fi
        exit 0
    fi

    log "$repo/#$candidate remains PENDING (PASS=$pass FAIL=$fail)"
    exit 0
}

main
