#!/usr/bin/env bash

# pi-audit-tally's gh override is AUDIT_GH, not GH. Resolve it before the
# worker-token preamble so the ${GH:-gh} guard sees the real gh binary and
# skips the mint when a test injects a fake (fleet-ops#3576).
GH="${AUDIT_GH:-gh}"

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# bin/pi-audit-tally
#
# Tallies the three senior-auditor votes for one scout candidate and applies
# the result to the GitHub issue: 2-of-3 PASS -> add agent-ready, drop
# scout-candidate; 2-of-3 FAIL -> add discarded, drop scout-candidate, and
# comment with the fail reasons; otherwise -> no action (pending).
#
# Args: <repo> <candidate>
#
# Environment seams:
#   AUDIT_STATE_DIR    vote file tree
#   AUDIT_GH           gh override
#   AUDIT_DRY_RUN      1 = log, do not mutate labels
#   ESCALATE_AFTER     refuse EVIDENCE-REFUSED N times before escalate-senior (default 3)

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

STATE_DIR="${AUDIT_STATE_DIR:-$HOME/.local/state/fleet-audit}"
DRY_RUN="${AUDIT_DRY_RUN:-0}"
ESCALATE_AFTER="${ESCALATE_AFTER:-3}"

spec_gate_py() {
    if [ -n "${AGENT_READY_SPEC_GATE:-}" ]; then
        printf '%s\n' "$AGENT_READY_SPEC_GATE"
        return 0
    fi
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$here/../lib/agent-ready-spec-gate.py" ]; then
        printf '%s\n' "$here/../lib/agent-ready-spec-gate.py"
        return 0
    fi
    printf '%s\n' "/home/nish/.local/lib/pi-packet/agent-ready-spec-gate.py"
}

issue_passes_spec_gate() {
    local body="$1" repo="$2"
    local py
    py=$(spec_gate_py)
    if [ ! -f "$py" ]; then
        log "SPEC-GATE missing at $py — refuse agent-ready (fail closed)"
        return 1
    fi
    printf '%s' "$body" | python3 "$py" check-body --repo "$repo" >/dev/null
}

# fleet-ops#3121: keyword-only compliance is not a judgement. A PASS reason
# must carry repo-specific evidence — an issue number (#N), a path, or a URL —
# or the admission (2-of-3 PASS) is keyword-babble, not a senior verdict.
# Returns 0 when the reason names evidence, 1 when it is keyword-only.
# fleet-ops#4451 epic guard: a candidate that belongs to a Nish epic is NEVER
# discarded by the panel. It is epic-linked if its TITLE matches `EPIC #[0-9]+`
# or its BODY cites `docs/epics/` or names a `EPIC (Nish):` epic. These three
# signals are read from the candidate's own issue (the title/body the auditors
# were handed), so no extra GitHub round-trips are needed. Returns 0 when the
# candidate is epic-linked, 1 otherwise.
# fleet-ops#4451: the epic's dependency chain (evals-before-specs Q1, then
# wiring Q2, then UI Q3, then enablement Q5) fails the scout candidate bar by
# construction — a later Q is not "smallest durable fix" standing alone, and an
# early Q has no direct user-facing impact yet. So the panel must never discard
# it; on a FAIL majority it gets spec-needed and a comment naming the failing
# bar instead (the auditor prompt's new line judges these on the epic).
is_epic_linked() {
    local title="$1" body="$2"
    # (1) title matches `EPIC #1367` (child-of-epic convention).
    if [[ "$title" =~ EPIC[[:space:]]*#[0-9]+ ]]; then
        return 0
    fi
    # (2) body cites a docs/epics file.
    if [[ "$body" == *"docs/epics/"* ]]; then
        return 0
    fi
    # (3) body names a `EPIC (Nish):` epic literally.
    if [[ "$body" == *"EPIC (Nish):"* ]]; then
        return 0
    fi
    return 1
}

# fleet-ops#4451: fetch the candidate issue once (title, body, labels) so the
# idempotency guard, the epic guard, the spec gate and the evidence gate all
# read one GitHub round-trip. On failure it degrades to empty values (fail
# open on the read; the write gates still decide).
fetch_candidate_issue() {
    local cand="$1" rp="$2"
    local j
    j=$("$GH" issue view "$cand" -R "Nishfleet/$rp" --json title,body,labels 2>/dev/null || true)
    issue_title=$(printf '%s\n' "$j" | jq -r '.title // empty' 2>/dev/null || true)
    issue_body=$(printf '%s\n' "$j" | jq -r '.body // empty' 2>/dev/null || true)
    issue_label_names=$(printf '%s\n' "$j" | jq -r '[.labels[]?.name] | join(",")' 2>/dev/null || true)
}

# fleet-ops#4451 idempotency: a candidate that already carries a decided
# label (discarded / agent-ready / spec-needed) OR a local `.decided` marker
# must never be re-tallied or re-commented. Without this the tally re-ran on
# every heartbeat for an already-discarded candidate and spammed 243 identical
# "Senior auditor panel ... discarded" comments on #1382.
candidate_decided() {
    local labels="$1" dir="$2"
    case ",$labels," in
        *,discarded,*|*,agent-ready,*|*,spec-needed,*) return 0 ;;
    esac
    [ -f "$dir/.decided" ] && return 0
    return 1
}

reason_has_evidence() {
    local r="$1" candidate="$2" body="$3"
    # (1) Existing repo-specific evidence: any issue number, URL, or path.
    if grep -qE '#[0-9]+|[a-z][a-z0-9+.-]*://|[A-Za-z0-9_.]+/[A-Za-z0-9_.]+' <<<"$r"; then
        return 0
    fi
    # fleet-ops#3573: the auditors run with NO tools (tools=0), so they cannot
    # cite a live path or URL. Accept a PASS whose reason cites THIS candidate
    # issue number together with a concrete repo path that appears VERBATIM in
    # the candidate's own issue body — the body is the only repo specificity a
    # tool-less auditor is handed, so a body-path citation is still evidence,
    # not keyword-babble. Without the path it is still refused.
    grep -qE "#${candidate}([^0-9]|$)" <<<"$r" || return 1
    local tok
    while IFS= read -r tok; do
        [ -n "$tok" ] || continue
        grep -qF "$tok" <<<"$r" && return 0
    done <<<"$(printf '%s\n' "$body" | grep -oE '[A-Za-z0-9_.]+(/[A-Za-z0-9_.]+)+' | sort -u 2>/dev/null)"
    return 1
}

log() { printf '[%s] [pi-audit-tally] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

[ $# -eq 2 ] || { log "usage: pi-audit-tally <repo> <candidate>"; exit 2; }
repo="$1"
candidate="$2"

case_dir() {
    printf '%s/%s/%s\n' "$STATE_DIR" "$repo" "$candidate"
}

votes_json() {
    local dir
    dir=$(case_dir)
    shopt -s nullglob
    local files=("$dir"/*.vote)
    shopt -u nullglob
    if [ "${#files[@]}" -eq 0 ]; then
        printf '[]\n'
        return
    fi
    jq -s '.' "${files[@]}"
}

main() {
    local dir votes pass fail skip real reasons issue_json issue_title issue_body issue_label_names
    dir=$(case_dir)
    if [ ! -d "$dir" ]; then
        log "no votes yet for $repo/#$candidate"
        exit 0
    fi

    # fleet-ops#4451: fetch the candidate issue once (title, body, labels) and
    # read labels FIRST. A candidate that already carries a decided label, or
    # a locally-marked decision, is a no-op — exit 0 with NO write. This is
    # the idempotence fix that stops the heartbeat re-running the tally on an
    # already-decided candidate and re-commenting 243 times on one issue.
    issue_json=$("$GH" issue view "$candidate" -R "Nishfleet/$repo" --json title,body,labels 2>/dev/null || true)
    issue_title=$(printf '%s\n' "$issue_json" | jq -r '.title // empty' 2>/dev/null || true)
    issue_body=$(printf '%s\n' "$issue_json" | jq -r '.body // empty' 2>/dev/null || true)
    issue_label_names=$(printf '%s\n' "$issue_json" | jq -r '[.labels[]?.name] | join(",")' 2>/dev/null || true)
    if candidate_decided "$issue_label_names" "$dir"; then
        log "$repo/#$candidate already decided (discarded/agent-ready/spec-needed or .decided marker) — no-op"
        exit 0
    fi

    votes=$(votes_json)
    pass=$(printf '%s\n' "$votes" | jq '[.[] | select(.verdict == "PASS")] | length')
    fail=$(printf '%s\n' "$votes" | jq '[.[] | select(.verdict == "FAIL")] | length')
    skip=$(printf '%s\n' "$votes" | jq '[.[] | select(.verdict == "SKIP")] | length')
    real=$(( pass + fail ))
    reasons=$(printf '%s\n' "$votes" | jq -r '[.[] | "\(.role): \(.verdict) - \(.reason)"] | join("\n")')

    log "$repo/#$candidate votes: PASS=$pass FAIL=$fail SKIP=$skip (real=$real)"

    # fleet-ops#4451 vote arithmetic: SKIP votes do not count in the
    # denominator. When a SKIP is present the panel has at most 2 real votes
    # (PASS+FAIL), so the result is PENDING until the third seat returns —
    # never 2-of-2 (an admit/discard on 2 real votes while the third SKIPs).
    # A panel with no SKIP and 2 real votes is a normal 2-of-3 in progress
    # and still decides when it reaches a majority.
    if [ "$skip" -gt 0 ] && [ "$real" -lt 3 ]; then
        log "$repo/#$candidate remains PENDING (real votes=$real < 3 with SKIP=$skip) — never 2-of-2 (fleet-ops#4451)"
        exit 0
    fi

    # fleet-ops#4451 epic guard: an epic-linked candidate is NEVER discarded.
    # On a FAIL majority it gets spec-needed + a comment naming the failing
    # bar and STAYS scout-candidate. The audit prompt's one new line makes the
    # panel judge a Nish epic's items on the epic, not on standalone impact.
    if [ "$fail" -ge 2 ] && is_epic_linked "$issue_title" "$issue_body"; then
        log "$repo/#$candidate EPIC-LINKED with $fail FAIL — spec-needed, never discarded (fleet-ops#4451)"
        if [ "$DRY_RUN" = "1" ]; then
            log "DRY-RUN: would add spec-needed (keep scout-candidate) + comment for epic-linked $repo/#$candidate"
        else
            if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --add-label spec-needed >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue edit FAILED (spec-needed epic)"
                exit 1
            fi
            local bar
            bar=$(printf '%s\n' "$reasons" | head -1)
            if ! "$GH" issue comment "$candidate" -R "Nishfleet/$repo" --body "spec-needed (fleet-ops#4451): this is a dependency item of Nish EPIC $issue_title — the panel bar is written for standalone scout candidates, so it is NEVER discarded. Panel returned FAIL for: $bar. The failing bar applies to the epic's user impact, not this item in isolation." >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue comment FAILED (spec-needed epic)"
            fi
        fi
        printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/.decided" 2>/dev/null || true
        exit 0
    fi

    if [ "$pass" -ge 2 ]; then
        # fleet-ops#543: 2-of-3 PASS is not enough without a spec.
        # fleet-ops#3121: nor without repo-specific evidence in the PASS
        # reasons — keyword-only compliance is not a judgement.
        # fleet-ops#3573: the body is already fetched above so the evidence
        # gate can accept a tool-less auditor's citation of this candidate#
        # + a body path.
        local pass_reasons evidenceless r_b64 r
        pass_reasons=$(printf '%s\n' "$votes" | jq -r '[.[] | select(.verdict == "PASS") | .reason] | join("\n")')
        evidenceless=0
        # fleet-ops#3548 follow-up: judge each PASS vote's reason as ONE unit,
        # not line by line. The reasons were joined with "\n" and read back
        # per line, so a multi-line reason was split and every line had to
        # carry evidence on its own. Live votes end in a "## stderr"
        # diagnostic line (cast before #3934 stripped it at the source): that
        # line has no evidence, so unanimous, evidence-citing panels were
        # refused 13 times and escalated (0509#1747/#1749/#1750/#1759-#1763).
        # Each reason is read back base64-safe, the stderr block is dropped
        # (same rule as pi-audit-run extract_reason), and an empty reason is
        # keyword-less by definition.
        while IFS= read -r r_b64; do
            r=$(printf '%s' "$r_b64" | base64 -d | sed -E '/^#+[[:space:]]+stderr([[:space:]]|$)/,$d')
            if [ -z "$(printf '%s' "$r" | tr -d '[:space:]')" ] || ! reason_has_evidence "$r" "$candidate" "$issue_body"; then
                evidenceless=1
                log "$repo/#$candidate PASS reason lacks repo-specific evidence (issue #, path, or URL): $(printf '%s' "$r" | tr '\n' ' ' | head -c 160)"
            fi
        done <<<"$(printf '%s\n' "$votes" | jq -r '.[] | select(.verdict == "PASS") | (.reason // "") | @base64')"
        if [ "$evidenceless" = "1" ]; then
            # fleet-ops#3574: a candidate refused for evidence ESCALATE_AFTER
            # times (default 3) is escalated (escalate-senior + drop
            # scout-candidate) so the admission queue never re-runs the same
            # evidence-less panel forever. The counter and refusal-history
            # ledger live under the candidate's state dir.
            local refusals reasons_ledger n
            refusals="$dir/.evidence-refusals"
            reasons_ledger="$dir/.evidence-refusal-reasons"
            n=0
            [ -f "$refusals" ] && n=$(<"$refusals")
            n=$(( ${n:-0} + 1 ))
            printf '%s\n' "$n" > "$refusals"
            printf '\n== evidence refusal #%s (%s) ==\n%s\n' "$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$pass_reasons" >> "$reasons_ledger" 2>/dev/null || true
            log "$repo/#$candidate EVIDENCE-REFUSED (2-of-3 PASS but keyword-only reasons) count=$n (escalate at $ESCALATE_AFTER)"
            if [ "$n" -ge "$ESCALATE_AFTER" ]; then
                log "$repo/#$candidate escalated: $n evidence refusals, escalate-senior, stop re-queuing (fleet-ops#3574)"
                if [ "$DRY_RUN" = "1" ]; then
                    log "DRY-RUN: would add escalate-senior + remove scout-candidate + comment for $repo/#$candidate"
                else
                    if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label escalate-senior >/dev/null 2>&1; then
                        log "$repo/#$candidate: gh issue edit FAILED (escalate-senior)"
                        exit 1
                    fi
                    local ledger
                    ledger=$(cat "$reasons_ledger" 2>/dev/null || printf 'refusal history unavailable')
                    "$GH" issue comment "$candidate" -R "Nishfleet/$repo" \
                        --body "escalate-senior (fleet-ops#3574): $repo/#$candidate refused for evidence $n times. Every PASS reason was keyword-only with no repo-specific evidence (issue number, path, or URL), so 2-of-3 PASS could never admit. Escalated rather than re-queued forever. Refusals:$ledger" \
                        >/dev/null 2>&1 || true
                fi
            else
                if [ "$DRY_RUN" = "1" ]; then
                    log "DRY-RUN: would refuse agent-ready for $repo/#$candidate (keyword-only PASS reasons)"
                else
                    "$GH" issue comment "$candidate" -R "Nishfleet/$repo" \
                        --body "evidence-refused (fleet-ops#3121). 2-of-3 PASS, but at least one PASS reason is keyword-only with no repo-specific evidence (issue number, path, or URL). Keyword-only compliance is not a judgement." \
                        >/dev/null 2>&1 || true
                fi
            fi
            exit 0
        fi
        if ! issue_passes_spec_gate "$issue_body" "$repo"; then
            log "$repo/#$candidate SPEC-GATE-REFUSED (2-of-3 PASS but no spec)"
            if [ "$DRY_RUN" = "1" ]; then
                log "DRY-RUN: would refuse agent-ready for $repo/#$candidate (no spec)"
            else
                "$GH" issue comment "$candidate" -R "Nishfleet/$repo" \
                    --body "spec-gate: refused agent-ready (fleet-ops#543). 2-of-3 PASS, but the body needs termination: / accept: / required: / metric:." \
                    >/dev/null 2>&1 || true
            fi
            exit 0
        fi
        log "$repo/#$candidate admitted (2-of-3 PASS)"
        if [ "$DRY_RUN" = "1" ]; then
            log "DRY-RUN: would add agent-ready + remove scout-candidate for $repo/#$candidate"
        else
            if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label agent-ready >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue edit FAILED (admit)"
                exit 1
            fi
        fi
        printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/.decided" 2>/dev/null || true
        exit 0
    fi

    if [ "$fail" -ge 2 ]; then
        log "$repo/#$candidate discarded (2-of-3 FAIL)"
        if [ "$DRY_RUN" = "1" ]; then
            log "DRY-RUN: would add discarded + remove scout-candidate + comment for $repo/#$candidate"
            log "discarded reasons:\n$reasons"
        else
            if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label discarded >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue edit FAILED (discard)"
                return 0  # still try to comment
            fi
            if ! "$GH" issue comment "$candidate" -R "Nishfleet/$repo" --body "Senior auditor panel (2-of-3) discarded this candidate. Reasons:\n\n$reasons" >/dev/null 2>&1; then
                log "$repo/#$candidate: gh issue comment FAILED (discard)"
            fi
        fi
        printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/.decided" 2>/dev/null || true
        exit 0
    fi

    log "$repo/#$candidate remains PENDING (PASS=$pass FAIL=$fail)"
    exit 0
}

main
