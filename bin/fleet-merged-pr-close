#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# fleet-merged-pr-close — observe-to-close an open issue that a merged PR
# shipped but forgot to close (fleet-ops#1435).
#
# The class: a merged PR that delivers an open issue but ships without the
# `Closes #<N>` trailer leaves that issue OPEN and the heartbeat keeps
# re-queuing it — a worker is dispatched again to re-do already-merged work
# (the live #1135 accident: PR #1429 merged the work on 2026-08-28 but
# omitted `Closes #1135`, so #1135 cycled through 5+ claim/release rounds
# before the mistake was noticed).
#
# DELIVERY RULES (fleet-ops#3231): observe-to-close may close an issue ONLY
# when a merged PR is an explicit delivery for it:
#   (a) the PR head branch is claim/issue-<N> — the worker delivery PR, or
#   (b) the PR body carries an explicit `Closes|Fixes|Resolves #N` trailer.
# A bare reference — a title/prose/body mention, a `blocked-on:` line, a
# comment, quoted text — is NOT a fix and never closes; it is comment-only
# ('PR #M mentions this issue; not closing'). This is the direct lesson of
# PR #3205 (2026-09-04): it closed the #3161 packet only, but observe-to-
# close read every `blocked-on: #N` / prose mention it carried as a delivery
# and wrongly closed the Nish-endorsed critical-path packets #3140 and
# #3146. A mention is not a fix.
#
# Protected issues — any open issue labelled critical-path or authored by
# the repo owner (nish3451) — are ALWAYS comment-only, even on a real
# delivery, the same rule close-duplicates follows (fleet-ops#3161); they
# stay open until their own delivery PR merges and closes them.
#
# No existing heartbeat tier closes issues: tier1 §3 / claim-reconcile
# release claims but never close issues; observe-to-close is gated to the
# findings-queued signal class. This detector is the mechanical prevention:
# once a merged PR has shipped the work, the issue is closed with evidence.
#
# Observable, deterministic, no LLM. Runs under fleet-heartbeat-tier1 every
# tick. For each enrolled repo, for each OPEN issue labelled
# agent-in-progress or critical-path:
#   1. Skip if there is an open PR on its claim/issue-<N> branch (work in
#      flight — the queue pass owns it).
#   2. If the claim/issue-<N> branch still exists on origin, check whether it
#      has commits beyond the default branch (ahead_by). A branch with
#      ahead_by > 0 is real in-flight work in a worktree → skip. A branch with
#      ahead_by = 0 is a stale re-queue pointer the heartbeat recreated after
#      §3 released it (fleet-ops#2080) → fall through so the merged-PR match
#      can close the delivered issue. claim-reconcile owns cleaning the branch.
#   3. Skip if a live pi-issue worker is running for that issue (actively
#      being worked).
#   4. List merged PRs in the last MERGED_PR_CLOSE_WINDOW_DAYS (default 7)
#      and classify each reference to the issue as a DELIVERY ((a) claim
#      branch, (b) explicit Closes/Fixes/Resolves trailer) or a MENTION
#      (anything else — comment-only, never close).
#      - exactly one delivery → close it (reason=claim-branch|closes-trailer)
#      - more than one delivery → signal is ambiguous — LOUD SKIP, defer to
#        a human, never close.
#      - mentions only, no delivery → comment 'PR #M mentions this issue;
#        not closing' (deduped), never close.
#      - protected issue (critical-path label or nish3451-authored) →
#        comment-only even on a delivery, never close.
#      - if the in-window scan finds NOTHING (no delivery AND no mention),
#        probe the claim/issue-<N> head branch for a merged delivery PR
#        directly: a merged claim-branch PR is unambiguous delivery even
#        outside the window (all in-flight guards above already cleared),
#        and the window edge only moves forward so an out-of-window delivery
#        would otherwise strand its issue forever (fleet-ops#820: delivery
#        PR #930 shipped 8 days earlier than a 7-day window could see). The
#        probed claim-branch PR is added to deliveries[] as reason=claim-branch
#        and flows through the same protected/non-protected paths below.
#
# The close/comment actions are gated behind FLEET_MERGED_PR_CLOSE_OK=1
# (mirrors FLEET_FINDINGS_QUEUED_OK_TO_CLOSE, fleet-ops#820): only the
# production heartbeat — which sets the flag — writes to the live repo.
# A test or one-off invocation with a mocked gh must not touch live issues,
# so the default is OFF. Per-tick close counts by reason are written to the
# summary JSON (MERGED_PR_CLOSE_SUMMARY) that libexec/fleet-metrics-export.py
# turns into fleet_observe_to_close_total{reason}.
#
# Environment seams (tests override all of these):
#   MERGED_PR_CLOSE_REPOS          newline-separated owner/name list
#   MERGED_PR_CLOSE_INTAKE_JSON    default repo list (intake-repos.json)
#   FLEET_MERGED_PR_CLOSE_OK       0 (default — close OFF) / 1 (heartbeat
#                                  opts in; required to actually comment/close)
#   MERGED_PR_CLOSE_WINDOW_DAYS    default 7
#   MERGED_PR_CLOSE_NOW            ISO-8601 UTC clock (window edge)
#   MERGED_PR_CLOSE_TRIAGE         triage file for LOUD (default heartbeat)
#   MERGED_PR_CLOSE_SUMMARY        summary JSON path (metric source; default
#                                  heartbeat log dir merged-pr-close.json)
#   GH                             gh binary
#
# Exit 0 on a clean sweep, a gated-off pass, or after closing candidates.
# Exit 2 on a crash (jq/gh missing, intake JSON missing/invalid).
# The heartbeat propagates only rc >= 2 — a found candidate is normal
# operation (it closes), not an invariant violation.

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${GH:-gh}"
OK_TO_CLOSE="${FLEET_MERGED_PR_CLOSE_OK:-0}"
WINDOW_DAYS="${MERGED_PR_CLOSE_WINDOW_DAYS:-7}"
NOW_ISO="${MERGED_PR_CLOSE_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
TRIAGE="${MERGED_PR_CLOSE_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
# Summary JSON consumed by libexec/fleet-metrics-export.py -> the
# fleet_observe_to_close_total{reason} family (fleet-ops#3231). Mirrors the
# close-duplicates.json contract: written every tick, exported per-reason,
# bare-mention and protected must stay 0 (an alert fires otherwise).
SUMMARY_FILE="${MERGED_PR_CLOSE_SUMMARY:-/home/nish/.local/state/fleet-heartbeat/merged-pr-close.json}"
INTAKE_JSON="${MERGED_PR_CLOSE_INTAKE_JSON:-/home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/intake-repos.json}"
# fleet-ops#2462: per-issue state dir for reclaiming the reclaim-count and
# systemic-failure markers on close. Matches the path used by
# pi-intake-tick.sh and pi-issue-failed-reap.
ATTEMPTS_DIR="${ATTEMPTS_DIR:-${PI_PACKET_STATE:-$HOME/.local/state/pi-packet}/attempts}"

log() {
    printf '[%s] [fleet-merged-pr-close] %s\n' "$NOW_ISO" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' "$NOW_ISO" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

command -v "$GH" >/dev/null 2>&1 || { loud "MERGED-PR-CLOSE-BROKEN" "gh missing at $GH"; exit 2; }
command -v jq >/dev/null 2>&1 || { loud "MERGED-PR-CLOSE-BROKEN" "jq missing"; exit 2; }

# Repos: explicit env wins; else project from intake-repos.json.
if [[ -n "${MERGED_PR_CLOSE_REPOS:-}" ]]; then
    repos="$MERGED_PR_CLOSE_REPOS"
elif [[ -f "$INTAKE_JSON" ]]; then
    if ! jq empty "$INTAKE_JSON" >/dev/null 2>&1; then
        loud "MERGED-PR-CLOSE-BROKEN" "invalid intake JSON: $INTAKE_JSON"
        exit 2
    fi
    if ! repos=$(jq -r '.repos[]? | "Nishfleet/" + .name' "$INTAKE_JSON" 2>/dev/null); then
        loud "MERGED-PR-CLOSE-BROKEN" "could not read repos from $INTAKE_JSON"
        exit 2
    fi
else
    loud "MERGED-PR-CLOSE-BROKEN" "no MERGED_PR_CLOSE_REPOS and intake JSON missing: $INTAKE_JSON"
    exit 2
fi

# Window cutoff as an ISO-8601 UTC string. mergedAt from gh is ISO-8601
# UTC with integer seconds, so a lexicographic string comparison against
# this cutoff is exact and has no date-parse failure mode. NOW must be
# ISO-8601 UTC; if it cannot be shifted, fail closed (do not close) rather
# than close old work by accident.
window_iso=${NOW_ISO%\.*}
if ! window_start=$(date -u -d "$window_iso - $WINDOW_DAYS days" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null); then
    loud "MERGED-PR-CLOSE-BROKEN" "could not shift NOW_ISO=$NOW_ISO by $WINDOW_DAYS days"
    exit 2
fi

# Fast-fail on a bad WINDOW_DAYS so we never compare against a negative edge.
if ! [ "$WINDOW_DAYS" -ge 0 ] 2>/dev/null; then
    loud "MERGED-PR-CLOSE-BROKEN" "invalid MERGED_PR_CLOSE_WINDOW_DAYS=$WINDOW_DAYS"
    exit 2
fi

# has_live_worker REPO N — is a fleet worker actively working this issue?
# Mirrors heartbeat tier1 §3: the pi-issue@<short>-<N> unit active, or any
# transient fable-p*/pi-issue worker whose name carries <short>-<N>.
has_live_worker() {
    local repo="$1" n="$2"
    local short="${repo#Nishfleet/}"
    local unit="pi-issue@${short}-${n}.service"
    if systemctl --user list-units "$unit" --state=active,activating --no-legend 2>/dev/null \
        | awk '{print $1}' | grep -qx "$unit"; then
        return 0
    fi
    if systemctl --user list-units --no-legend --type=service --state=running 2>/dev/null \
        | awk '{print $1}' | grep -E "(fable-p|pi-issue)" | grep -q "${short}-${n}"; then
        return 0
    fi
    return 1
}

# references_issue TEXT N — does TEXT reference issue N (#N, <repo>#N)?
# Issue matches are exact-number: #1135 must not match #11352. The optional
# prefix covers the bare form (<repo>#N, e.g. fleet-ops#1135) and the fully
# qualified form (Nishfleet/fleet-ops#1135). A preceding/following letter
# or digit bounds the token so #1135abc or #11352 do not match.
references_issue() {
    local text="$1" n="$2"
    printf '%s' "$text" \
        | grep -Eq "(^|[^0-9A-Za-z])([A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?)?#${n}([^0-9A-Za-z]|$)"
}

# trailer_delivery TEXT N — does TEXT carry an explicit `Closes|Fixes|Resolves
# #N` trailer for issue N (fleet-ops#3231)? This is the ONLY body signal that
# may close an issue: a bare mention (prose, `blocked-on:` line, comment,
# quoted text) is comment-only. Matches GitHub's closing-keyword family
# (close/closes/closed, fix/fixes/fixed, resolve/resolves/resolved),
# exact-number bounded (#1135 must not match #11352), and requires a
# whitespace gap between the keyword and the reference so "Closes#1135"
# (not a GitHub form) does not match.
trailer_delivery() {
    local text="$1" n="$2"
    printf '%s' "$text" \
        | grep -Eiq "(^|[^0-9A-Za-z])(Clos(es?|ed)|Fix(es|ed)?|Resolv(es?|ed))[[:space:]]+#${n}([^0-9A-Za-z]|$)"
}

existing_comment() {
    local repo="$1" n="$2" marker="$3"
    "$GH" issue view "$n" -R "$repo" --json comments --jq '.[]?.body // empty' 2>/dev/null \
        | grep -Fq "$marker"
}

# post_note REPO N URL PRNUM MODE — comment-only path (fleet-ops#3231).
# MODE=mention: 'PR #M mentions this issue; not closing'. MODE=protected:
# the issue is critical-path/owner-authored so even a delivery is not
# auto-closed. Comments are deduped per (issue, PR) so an hourly tick cannot
# spam the thread; a dedup-scan failure posts once (comment is harmless).
post_note() {
    local repo="$1" n="$2" murl="$3" mnum="$4" mode="$5"
    local marker
    if [ "$mode" = "protected" ]; then
        marker="observe-to-close (fleet-ops#1435): issue is protected (critical-path label or owner-authored) and is never auto-closed; merged PR ${murl} (#${mnum}) is not closing it."
    else
        marker="observe-to-close (fleet-ops#1435): merged PR ${murl} (#${mnum}) mentions this issue; not closing (a mention is not a fix)."
    fi
    if existing_comment "$repo" "$n" "$murl"; then
        log "  $repo#$n: note for PR #$mnum already posted — skip"
        return 0
    fi
    if ! "$GH" issue comment "$n" -R "$repo" --body "$marker" >/dev/null 2>&1; then
        loud "MERGED-PR-CLOSE-ERE" "$repo#$n: gh issue comment failed — will retry next tick"
        return 1
    fi
    log "  $repo#$n: NOTE (mode=$mode) posted for merged PR #$mnum"
}

log "merged-pr observe-to-close starting (close=${OK_TO_CLOSE}, window=${WINDOW_DAYS}d)"
scanned=0
candidates=0
closed=0
closes_claim=0
closes_trailer=0
skipped_live=0
skipped_open_pr=0
skipped_branch=0
skipped_ambiguous=0
skipped_mention=0
skipped_protected=0

while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    log "repo $repo"

    # Default branch for the divergence check in guard #2. One call per repo
    # per tick; cached for the inner loop. A missing default branch fails the
    # repo closed (every branch guard would otherwise treat main as "main",
    # which is wrong for repos whose default is master).
    default_branch=$("$GH" api "repos/${repo}" --jq '.default_branch' 2>/dev/null) || true
    if [ -z "$default_branch" ]; then
        loud "MERGED-PR-CLOSE-GH" "$repo: could not resolve default branch — skip (next tick retries)"
        continue
    fi

    # Open issues carrying agent-in-progress or critical-path (author needed
    # for the owner-authored protection, fleet-ops#3231).
    if ! list_json=$("$GH" issue list -R "$repo" --state open \
        --json number,title,labels,body,author --limit 500 2>/dev/null); then
        loud "MERGED-PR-CLOSE-GH" "$repo: gh issue list failed — skip (next tick retries)"
        continue
    fi

    # Recent merged PRs (title+body + number+url + mergedAt + headRefName) in
    # one fetch, filtered to the window in jq. `gh pr list` has no --sort;
    # length is enough for a 7-day window on the fleet's merge volume.
    if ! merged_json=$("$GH" pr list -R "$repo" --state merged --limit 300 \
        --json number,title,body,mergedAt,url,headRefName 2>/dev/null); then
        loud "MERGED-PR-CLOSE-GH" "$repo: gh pr list merged failed — skip (next tick retries)"
        continue
    fi
    if ! in_window=$(printf '%s' "$merged_json" | jq -r --arg ws "$window_start" '
        [ .[] | select((.mergedAt // "") != "") | select(.mergedAt >= $ws)
          | [.number, (.title | gsub("\n"; " ")), ((.body // "") | gsub("\n"; " ")), .url, (.headRefName // "")] | @tsv ] | .[]' 2>/dev/null); then
        loud "MERGED-PR-CLOSE-BROKEN" "$repo: jq window filter failed — skip (next tick retries)"
        continue
    fi

    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')

        # Restrict to the two lifecycle labels this detector owns:
        # agent-in-progress (a worker may still be on it) or critical-path.
        if ! printf '%s' "$labels_json" \
            | jq -e 'map(.name) | index("agent-in-progress") != null or index("critical-path") != null' >/dev/null 2>&1; then
            continue
        fi
        scanned=$((scanned + 1))

        # --- Safety guards, all fail-closed ---
        # 1. Open PR on the claim branch → work in flight; queue pass owns it.
        if open_pr=$("$GH" pr list -R "$repo" --head "claim/issue-${num}" \
            --state open --json number 2>/dev/null) \
            && printf '%s' "$open_pr" | jq -e 'length > 0' >/dev/null 2>&1; then
            log "  $repo#$num: open claim PR — skip (in flight)"
            skipped_open_pr=$((skipped_open_pr + 1))
            continue
        fi
        # 2. Claim branch still present → may be in-flight work in a worktree.
        #    But a branch with NO commits beyond the default (ahead_by=0) is a
        #    stale re-queue pointer the heartbeat recreated after §3 released
        #    it — not in-flight work (fleet-ops#2080: this exact stale pointer
        #    kept #1135 cycling forever). Only skip when the branch carries
        #    real divergent commits (ahead_by > 0); otherwise fall through so
        #    the merged-PR match can close the delivered issue.
        if "$GH" api "repos/${repo}/git/refs/heads/claim/issue-${num}" >/dev/null 2>&1; then
            ahead_by=$("$GH" api "repos/${repo}/compare/${default_branch}...claim/issue-${num}" \
                --jq '.ahead_by' 2>/dev/null) || ahead_by=-1
            if [ "${ahead_by:-0}" -gt 0 ]; then
                log "  $repo#$num: claim/issue-${num} branch has ${ahead_by} divergent commit(s) — skip (may be in a worktree)"
                skipped_branch=$((skipped_branch + 1))
                continue
            fi
            log "  $repo#$num: claim/issue-${num} branch exists but has no divergent commits (ahead_by=${ahead_by}) — stale re-queue pointer, not in-flight"
        fi
        # 3. Live worker → actively being worked.
        if has_live_worker "$repo" "$num"; then
            log "  $repo#$num: live worker active — skip"
            skipped_live=$((skipped_live + 1))
            continue
        fi

        # 4. Classify every merged PR in the window that bears on this issue
        #    into DELIVERIES (the only closers) vs MENTIONS (comment-only).
        #    observe-to-close may close ONLY when a merged PR is an explicit
        #    delivery (fleet-ops#3231): (a) its head branch is
        #    claim/issue-<N> — the worker delivery PR (fleet-ops#1672), or (b)
        #    its body carries an explicit `Closes|Fixes|Resolves #N` trailer.
        #    A bare reference — a title/prose/body mention, a `blocked-on:`
        #    line, a comment, quoted text — is NOT a fix and never closes; it
        #    is comment-only ('PR #M mentions this issue; not closing'). This
        #    is the direct lesson of PR #3205, which closed #3140/#3146 by
        #    merely mentioning them (fleet-ops#3231).
        author=$(printf '%s' "$row" | jq -r '.author.login // ""' 2>/dev/null)
        deliveries=()
        mentions=()
        while IFS=$'\t' read -r mnum mtitle mbody murl mhead; do
            [ -z "$mnum" ] && continue
            if [ "$mhead" = "claim/issue-${num}" ]; then
                deliveries+=("$mnum|$murl|claim-branch")
            elif trailer_delivery "$mbody" "$num"; then
                deliveries+=("$mnum|$murl|closes-trailer")
            elif references_issue "$mtitle" "$num" || references_issue "$mbody" "$num"; then
                mentions+=("$mnum|$murl")
            fi
        done <<< "$in_window"

        # Protected issues (critical-path label or nish3451-authored) are
        # ALWAYS comment-only — even on a real delivery — the same rule
        # close-duplicates follows (fleet-ops#3161). #3140/#3146 are the live
        # lesson: Nish-endorsed critical-path packets wrongly closed by a
        # bare mention stay open until their own delivery PR closes them.
        protected=0
        if printf '%s' "$labels_json" \
            | jq -e 'map(.name) | index("critical-path") != null' >/dev/null 2>&1; then
            protected=1
        fi
        if [ "${author:-}" = "nish3451" ]; then
            protected=1
        fi

        # 4b. Out-of-window delivery fallback (fleet-ops#820): a merged PR on
        #     the claim/issue-<N> head branch is unambiguous delivery evidence
        #     (the fleet merge queue only merges with every required check
        #     green), and all guards above already cleared — no open PR, no
        #     live worker, no divergent claim branch. When the in-window scan
        #     found nothing (no delivery AND no mention), probe for that
        #     delivery PR directly even though its mergedAt has fallen out of
        #     the lookback window. Without this, an issue whose delivery PR
        #     shipped just before the window edge can never be closed and
        #     re-claims forever (fleet-ops#820's #930 merged 8 days earlier
        #     than a 7-day window could see). The window edge only moves
        #     forward, so an out-of-window PR will NEVER re-enter it — this
        #     fallback is the only path that closes such a delivered-but-stuck
        #     issue. The probed PR is added to deliveries[] as reason=claim-branch
        #     and flows through the same protected/non-protected paths below.
        if [ "${#deliveries[@]}" -eq 0 ] && [ "${#mentions[@]}" -eq 0 ]; then
            if claim_merged=$("$GH" pr list -R "$repo" --head "claim/issue-${num}" \
                --state merged --json number,url,mergedAt 2>/dev/null); then
                while IFS=$'\t' read -r cn cu cma; do
                    [ -z "$cn" ] && continue
                    log "  $repo#$num: no in-window reference, but merged claim-branch PR #$cn (merged $cma) is the delivery — out-of-window fallback"
                    deliveries+=("$cn|$cu|claim-branch")
                done < <(printf '%s' "$claim_merged" | jq -r '.[] | [.number,.url,.mergedAt] | @tsv' 2>/dev/null)
            fi
        fi

        if [ "$protected" = "1" ]; then
            if [ "${#deliveries[@]}" -gt 0 ]; then
                mp=$(printf '%s\n' "${deliveries[0]}")
                mnum="${mp%%|*}"
                murl="${mp#*|}"; murl="${murl%%|*}"
                if [ "$OK_TO_CLOSE" = "1" ]; then
                    post_note "$repo" "$num" "$murl" "$mnum" protected
                else
                    log "  $repo#$num: PROTECTED-delivery candidate (merged PR #$mnum) but FLEET_MERGED_PR_CLOSE_OK != 1 — no write"
                fi
                skipped_protected=$((skipped_protected + 1))
            elif [ "${#mentions[@]}" -gt 0 ]; then
                mp=$(printf '%s\n' "${mentions[0]}")
                mnum="${mp%%|*}"
                murl="${mp#*|}"
                if [ "$OK_TO_CLOSE" = "1" ]; then
                    post_note "$repo" "$num" "$murl" "$mnum" protected
                else
                    log "  $repo#$num: PROTECTED-mention candidate (merged PR #$mnum) but FLEET_MERGED_PR_CLOSE_OK != 1 — no write"
                fi
                skipped_protected=$((skipped_protected + 1))
            else
                log "  $repo#$num: protected issue, no merged PR references it — leave open (never auto-close)"
            fi
            continue
        fi

        ndel=${#deliveries[@]}
        if [ "$ndel" -eq 0 ]; then
            nmentions=${#mentions[@]}
            if [ "$nmentions" -eq 0 ]; then
                log "  $repo#$num: no merged PR references it — leave open"
                continue
            fi
            # Bare mention(s) with no explicit delivery -> comment-only,
            # never close (fleet-ops#3231: a mention is not a fix). The PR
            # merely talking about the issue is not evidence the work shipped.
            mp=$(printf '%s\n' "${mentions[0]}")
            mnum="${mp%%|*}"
            murl="${mp#*|}"
            if [ "$OK_TO_CLOSE" = "1" ]; then
                post_note "$repo" "$num" "$murl" "$mnum" mention
            else
                log "  $repo#$num: MENTION-only candidate (merged PR #$mnum) but FLEET_MERGED_PR_CLOSE_OK != 1 — no write"
            fi
            skipped_mention=$((skipped_mention + 1))
            continue
        fi
        if [ "$ndel" -gt 1 ]; then
            loud "MERGED-PR-CLOSE-AMBIGUOUS" "$repo#$num: $ndel merged PRs deliver it — SKIP, defer to human (${deliveries[*]})"
            skipped_ambiguous=$((skipped_ambiguous + 1))
            continue
        fi

        # Exactly one merged PR delivered this issue. Close it (gated).
        candidates=$((candidates + 1))
        mp=$(printf '%s\n' "${deliveries[0]}")
        mnum="${mp%%|*}"
        rest="${mp#*|}"
        murl="${rest%%|*}"
        reason="${rest#*|}"
        ts="$NOW_ISO"

        if [ "$OK_TO_CLOSE" != "1" ]; then
            log "  $repo#$num: CANDIDATE (merged PR #$mnum, reason=$reason) but FLEET_MERGED_PR_CLOSE_OK != 1 — close skipped"
            continue
        fi

        if [ "$reason" = "claim-branch" ]; then
            comment="observe-to-close (fleet-ops#1435): merged PR ${murl} (#${mnum}) shipped this issue from the claim/issue-${num} branch. The work is delivered (the fleet merge queue only merges with every required check green — that is the verification) and no open PR, live worker, or claim branch remains for this issue, so the heartbeat closes it at ${ts}."
        else
            comment="observe-to-close (fleet-ops#1435): merged PR ${murl} (#${mnum}) ships this issue with an explicit \`Closes #${num}\` trailer. The work is delivered (the fleet merge queue only merges with every required check green — that is the verification) and no open PR, live worker, or claim branch remains for this issue, so the heartbeat closes it at ${ts}."
        fi

        if ! "$GH" issue close "$num" -R "$repo" --comment "$comment" >/dev/null 2>&1; then
            loud "MERGED-PR-CLOSE-ERR" "$repo#$num: gh issue close failed — will retry next tick"
            continue
        fi
        # fleet-ops#2462: reset reclaim-count + clear systemic marker on close.
        # The merged PR shipped the work; a future re-open of the issue must
        # start fresh, not inherit a stale cap/marker from this failure cycle.
        _rc_clear_file="$ATTEMPTS_DIR/pi-issue-${repo}-${num}.reclaim-count"
        _sys_clear_file="$ATTEMPTS_DIR/pi-issue-${repo}-${num}.systemic"
        rm -f "$_rc_clear_file" "$_sys_clear_file" 2>/dev/null || true

        closed=$((closed + 1))
        if [ "$reason" = "claim-branch" ]; then
            closes_claim=$((closes_claim + 1))
        else
            closes_trailer=$((closes_trailer + 1))
        fi
        log "  $repo#$num: CLOSED (delivered by merged PR #$mnum via $reason) -- reset reclaim-count + systemic marker"
    done < <(printf '%s' "$list_json" | jq -c '.[]')
done <<< "$repos"

# Per-tick summary for the exporter: fleet_observe_to_close_total{reason}.
# bare-mention and protected are never incremented by this code — they are
# emitted as 0 so an alert fires if a regression ever closes on a mention or
# closes a protected issue (fleet-ops#3231). Missing/unparseable summary
# degrades to all-zero in the exporter.
if [ -n "$SUMMARY_FILE" ] \
    && mkdir -p "$(dirname "$SUMMARY_FILE")" 2>/dev/null; then
    cat >"$SUMMARY_FILE" <<EOF
{"_meta":{"ts":"$NOW_ISO","tool":"fleet-merged-pr-close"},"closed":$closed,"closes_by_reason":{"claim-branch":$closes_claim,"closes-trailer":$closes_trailer,"bare-mention":0,"protected":0}}
EOF
else
    log "WARN: could not write summary $SUMMARY_FILE"
fi

log "merged-pr observe-to-close done: scanned=$scanned candidates=$candidates closed=$closed(claim=$closes_claim,trailer=$closes_trailer) skipped_open_pr=$skipped_open_pr skipped_branch=$skipped_branch skipped_live=$skipped_live skipped_ambiguous=$skipped_ambiguous skipped_mention=$skipped_mention skipped_protected=$skipped_protected"
exit 0
