#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    command -v gh >/dev/null 2>&1 || export PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}
    # 2026-09-18: bin/worker-token is deleted. `gh token` (the Link-/gh-token gh
    # extension) mints the same nishfleet-worker installation token with the same
    # three GitHub calls, so there is no hand-rolled JWT to maintain.
    _minted="$(gh token generate \
        --app-id "${NISHFLEET_WORKER_APP_ID:-4728578}" \
        --key "${NISHFLEET_WORKER_PEM:-${HOME:-/home/nish}/.config/fleet-worker/nishfleet-worker.private-key.pem}" \
        --installation-id "${NISHFLEET_WORKER_INSTALLATION_ID:-156789042}" \
        --token-only)" \
        || { echo "fleet-ops#3445: gh token generate failed - refusing human-gh writes" >&2; exit 1; }
    [[ -n "$_minted" ]] || { echo "fleet-ops#3445: gh token generate returned empty - refusing human-gh writes" >&2; exit 1; }
    export GH_TOKEN="$_minted"
    unset _minted
fi
# fleet-issue-file — filing-time same-problem dedupe (fleet-ops#1212).
#
# Drop-in for `gh issue create` that scores the candidate against open
# issues (title+body token overlap + key-path/unit-name match) and either
# comments on the existing issue, files with a possible-duplicate-of
# marker, or files clean.
#
# Implementation: lib/issue-file.py

set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
lib="${FLEET_ISSUE_FILE_LIB:-$here/../lib/pi-packet/issue-file.py}"
[ -f "$lib" ] || lib="$here/../lib/issue-file.py"
[ -f "$lib" ] || { echo "fleet-issue-file: library missing: $lib" >&2; exit 2; }

exec python3 "$lib" "$@"
