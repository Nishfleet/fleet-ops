#!/usr/bin/env bash
# salvage-secret-scan — pre-push safety for fleet-ops#1204 salvage commits.
#
# Scans the DIFF being salvaged for credentials before a wip/ branch is
# pushed. A salvage branch that leaks a credential trades one defect class
# (lost work) for a worse one (a leaked secret on the remote), so the salvage
# path must gate the push on a deterministic secret scan.
#
#   salvage-secret-scan <repo> <ref> [--base <base>] [--json]
#
#   <repo>  path to the git repository
#   <ref>   the commit/branch being salvaged (the wip commit)
#   --base  optional base to diff against (default: origin/HEAD, then
#           origin/main, then main, then the ref's first parent)
#   --json  print a one-line JSON summary to stdout (for the ledger)
#
# Exit:
#   0  clean — push allowed
#   1  quarantine — credential(s) found in the salvaged diff (local-only
#      salvage + ledger salvage_quarantined)
#   2  usage / cannot resolve repo or ref
#   3  cannot scan (fail-closed — caller should quarantine)
#
# Layers (deterministic, stdlib + sgscan when available):
#   1. guard_secrets HARD_PATTERNS + value patterns (python stdlib) on the
#      added lines of the diff. Always runs; authoritative.
#   2. sgscan (semgrep) diff scan, when installed and the ref is checked out.
#      Best-effort: a WARNING/ERROR finding quarantines; an sgscan failure or
#      timeout never blocks the scan (layer 1 is the exit-code authority).
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCANNER="${SALVAGE_SCANNER_PY:-$here/../lib/salvage_secret_scan.py}"
SGSCAN="${SGSCAN:-sgscan}"
SGSCAN_TIMEOUT="${SGSCAN_TIMEOUT:-120}"

usage() {
    cat <<'EOF' >&2
usage: salvage-secret-scan <repo> <ref> [--base <base>] [--json]

Scan the diff being salvaged for credentials before a wip/ branch is pushed.
Exit 0 = clean (push allowed), 1 = quarantine (credential found).
EOF
    exit 2
}

[[ $# -ge 2 ]] || usage
repo="$1"
ref="$2"
shift 2
base=""
as_json=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --base) [[ $# -ge 2 ]] || usage; base="$2"; shift 2 ;;
        --json) as_json=1; shift ;;
        -h|--help) usage ;;
        *) echo "salvage-secret-scan: unknown flag: $1" >&2; usage ;;
    esac
done

[[ -d "$repo/.git" ]] || { echo "salvage-secret-scan: not a git repo: $repo" >&2; exit 2; }
cd "$repo"

# Resolve the ref to a commit.
if ! commit="$(git rev-parse --verify --quiet "$ref^{commit}")"; then
    echo "salvage-secret-scan: cannot resolve ref: $ref" >&2
    exit 2
fi

# Determine the base to diff against.
if [[ -z "$base" ]]; then
    for candidate in origin/HEAD origin/main main; do
        if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
            base="$candidate"
            break
        fi
    done
fi
if [[ -n "$base" ]] && git rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    merge_base="$(git merge-base "$base" "$commit" 2>/dev/null || true)"
    if [[ -n "$merge_base" ]]; then
        base="$merge_base"
    fi
else
    # No usable base: diff the ref against its first parent (a single commit).
    base="$commit^"
fi

# Build the diff being salvaged.
if ! diff_text="$(git diff "$base" "$commit" 2>/dev/null)"; then
    echo "salvage-secret-scan: cannot compute diff $base..$commit" >&2
    exit 3
fi

findings=0
sgscan_ran=0
sgscan_findings=0

# Layer 1: guard_secrets patterns (python stdlib) on added lines. Authoritative.
if [[ -f "$SCANNER" ]]; then
    if ! printf '%s\n' "$diff_text" | python3 "$SCANNER"; then
        findings=1
    fi
else
    echo "salvage-secret-scan: scanner not found: $SCANNER" >&2
    exit 3
fi

# Layer 2: sgscan (semgrep) diff scan, when installed AND the ref is checked
# out (sgscan scans the working tree/HEAD against a base, so it is only
# meaningful when HEAD == the salvaged commit). Best-effort.
if command -v "$SGSCAN" >/dev/null 2>&1 \
    && [[ "$(git rev-parse HEAD 2>/dev/null || true)" == "$commit" ]]; then
    sgscan_ran=1
    set +e
    timeout "$SGSCAN_TIMEOUT" "$SGSCAN" --base "$base" >/dev/null 2>&1
    sg_rc=$?
    set -e
    # sgscan: 0 clean, 1 WARNING, 2 ERROR, 5 not installed, 6 not a repo.
    if [[ "$sg_rc" -eq 1 || "$sg_rc" -eq 2 ]]; then
        echo "salvage-secret-scan: sgscan flagged findings (exit $sg_rc)" >&2
        sgscan_findings=1
        findings=1
    fi
fi

if [[ "$as_json" -eq 1 ]]; then
    verdict="clean"
    [[ "$findings" -eq 0 ]] || verdict="quarantine"
    printf '{"repo":"%s","ref":"%s","commit":"%s","verdict":"%s","sgscan_ran":%s,"sgscan_findings":%s}\n' \
        "$repo" "$ref" "$commit" "$verdict" "$sgscan_ran" "$sgscan_findings"
fi

exit "$findings"
