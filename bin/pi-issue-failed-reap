#!/usr/bin/env bash
# pi-issue-failed-reap — release a claim after its worker exhausts retries.
#
# Triggered by pi-issue@.service OnFailure=pi-issue-failed@%i.service.
# This runs only on failure; the normal worker path cleans up by finishing
# the issue and opening a PR.
#
# Action:
#   1. Parse %i as <repo>-<issue>.
#   2. Load the issue state.
#   3. If an open PR exists from claim/issue-<N>, leave the branch alone and
#      just remove the agent-in-progress label (the worker got far enough).
#   4. Otherwise delete the claim branch and either:
#        - open issue  -> remove agent-in-progress, add agent-ready
#        - closed issue -> remove agent-in-progress only
#
# Exit: 0 on success, non-zero on unexpected gh/network/auth errors.

set -euo pipefail

log() {
    printf '[%s] pi-issue-failed-reap: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

[[ $# -ge 1 ]] || { log "usage: $0 <repo>-<issue>"; exit 1; }

instance="$1"
repo="${instance%-*}"
issue="${instance##*-}"

if [[ -z "$repo" || -z "$issue" || ! "$issue" =~ ^[0-9]+$ ]]; then
    log "cannot parse instance '$instance' into repo and issue number"
    exit 1
fi

repo_slug="Nishfleet/$repo"
branch_name="claim/issue-$issue"

# --- load issue state --------------------------------------------------------
state_json=$(gh issue view "$issue" -R "$repo_slug" --json state,labels 2>&1) || {
    log "gh issue view $repo_slug#$issue failed: $state_json"
    exit 1
}

issue_state=$(printf '%s' "$state_json" | jq -r '.state // "UNKNOWN"')
in_progress=$(printf '%s' "$state_json" | jq -e '[.labels[]?.name] | any(. == "agent-in-progress")' >/dev/null 2>&1 && echo yes || echo no)

log "state=$issue_state in_progress=$in_progress for $repo_slug#$issue"

# --- branch cleanup: only if no open PR from this branch --------------------
open_pr_count=$(gh pr list -R "$repo_slug" --head "$branch_name" --state open --json number --jq 'length' 2>&1) || {
    log "gh pr list $repo_slug head=$branch_name failed: $open_pr_count"
    exit 1
}

if [[ "$open_pr_count" -gt 0 ]]; then
    log "open PR exists from $branch_name; leaving branch intact"
    if [[ "$in_progress" == "yes" ]]; then
        gh issue edit "$issue" -R "$repo_slug" --remove-label agent-in-progress || true
    fi
    exit 0
fi

# --- delete the claim branch if it still exists ------------------------------
branch_exists=no
if gh api "repos/$repo_slug/git/refs/heads/$branch_name" >/dev/null 2>&1; then
    branch_exists=yes
fi

if [[ "$branch_exists" == "yes" ]]; then
    if ! gh api "repos/$repo_slug/git/refs/heads/$branch_name" -X DELETE >/dev/null 2>&1; then
        log "failed to delete branch $branch_name on $repo_slug"
        exit 1
    fi
    log "deleted branch $branch_name"
fi

# --- flip labels according to issue state ------------------------------------
if [[ "$issue_state" == "OPEN" ]]; then
    if [[ "$in_progress" == "yes" ]]; then
        gh issue edit "$issue" -R "$repo_slug" --remove-label agent-in-progress --add-label agent-ready
    else
        gh issue edit "$issue" -R "$repo_slug" --add-label agent-ready
    fi
    gh issue comment "$issue" -R "$repo_slug" --body "claim branch released after pi-issue-$instance reached StartLimitBurst at $(date -u +%FT%TZ)" || true
    log "released $repo_slug#$issue back to agent-ready"
elif [[ "$issue_state" == "CLOSED" ]]; then
    if [[ "$in_progress" == "yes" ]]; then
        gh issue edit "$issue" -R "$repo_slug" --remove-label agent-in-progress
    fi
    log "cleaned up closed $repo_slug#$issue"
else
    log "unknown issue state '$issue_state' for $repo_slug#$issue; leaving labels"
fi

exit 0
