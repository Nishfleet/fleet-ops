#!/usr/bin/env bash
# pi-issue-failed-reap — release a claim after its worker exhausts retries.
#
# Triggered by pi-issue@.service OnFailure=pi-issue-failed@%i.service.
# This runs only on failure; the normal worker path cleans up by finishing
# the issue and opening a PR.
#
# Environment:
#   TRIAGE_FILE             Defaults to ~/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md.
#                           One line is appended per invocation regardless of
#                           outcome (success, partial-fail, total-fail).
#   SYSTEMCTL               Defaults to systemctl. Tests inject a fake.
#   PI_PACKET_STATE         Defaults to ~/.local/state/pi-packet. Houses the
#                           per-issue tried-seats + last-seat files under
#                           $PI_PACKET_STATE/attempts/.
#   PI_ISSUES_DIR           Defaults to ~/.local/state/pi-issues. Houses the
#                           per-instance .in / .out / .err packets the
#                           pi-issue@.service Type=oneshot consumed. The
#                           reaper archives (mv -> ARCHIVED-<instance>.<ext>-<ts>)
#                           these on a successful CLOSED or branch_deleted
#                           reap so a stale packet cannot keep a dead unit
#                           on Restart=on-failure life support (auditor
#                           2026-08-27T03:31Z, fleet-ops#638 root cause).
#
# Action:
#   1. Parse %i as <repo>-<issue>.
#   2. If pi-issue@%i is still live (active/activating or nonzero MainPID),
#      do nothing — StartLimitBurst can fire OnFailure while ExecStart is
#      still running (fleet-ops#26). Never release a live worker's claim.
#   3. Load the issue state.
#   4. If an open PR exists from claim/issue-<N>, leave the branch alone
#      and write a triage note (the worker got far enough).
#   5. Otherwise delete the claim branch and either:
#        - open issue  -> remove agent-in-progress, add agent-ready
#        - closed issue -> remove agent-in-progress only
#   6. On a successful CLOSED reap or a successful branch delete, archive
#      the .in/.out/.err packets so the systemd unit does not auto-restart
#      on a stale packet (fleet-ops#638 cascade root cause).
#   7. ALWAYS write one line to the heartbeat triage file so other agents
#      can see the cleanup happened. This was the missing observability for
#      P13-B: 0509-948 reaped silently twice today (2026-08-25) before the
#      claim branch and label were released manually.
#
# Flags:
#   --dry-run   Read-only; do not call any mutating gh endpoint
#               (no branch delete, no label edit, no comment). Logs as usual.
#               Useful for proving the parse/observation path without
#               touching the repo. Standalone runnable.
#
# Exit: 0 = claimed cleanup done (branch deleted AND labels flipped on a
#       matching open issue), or the open-PR shortcut was taken. Non-zero
#       only when a hard pre-condition failed (unparseable instance, gh
#       auth missing, etc.). Partial cleanup is not a hard error — the
#       triage file captures what succeeded and what didn't, and the
#       30-min orphan sweep (P13 tier-1) is the safety net.

set -uo pipefail

TRIAGE_FILE="${TRIAGE_FILE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
STATE_DIR="${PI_PACKET_STATE:-$HOME/.local/state/pi-packet}"
ATTEMPTS_DIR="$STATE_DIR/attempts"
ISSUES_DIR="${PI_ISSUES_DIR:-$HOME/.local/state/pi-issues}"

# Set to 1 when this invocation actually reaped a claim (CLOSED cleanup or
# branch_deleted). Drives the packet-archive step at the end. Live-skip,
# open-PR-shortcut, parse-fail, gh-fail, and dry-run leave it 0.
should_archive_packets=0

dry_run=0
if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run=1
    shift
fi

log() {
    printf '[%s] pi-issue-failed-reap: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

# Format matches fleet-heartbeat-tier1's `loud()` helper:
#   [ISO ts] [TAG] message
# One blank line precedes the entry so successive appends stay readable.
log_to_triage() {
    local tag="$1"; shift
    local msg="$*"
    {
        printf '\n[%s] [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE_FILE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE_FILE"
}

[[ $# -ge 1 ]] || { log "usage: $0 [--dry-run] <repo>-<issue>"; exit 1; }

instance="$1"
repo="${instance%-*}"
issue="${instance##*-}"

if [[ -z "$repo" || -z "$issue" || ! "$issue" =~ ^[0-9]+$ ]]; then
    log "cannot parse instance '$instance' into repo and issue number"
    log_to_triage "CLAIM-REAP-PARSE-FAIL" "instance=$instance repo=$repo issue=$issue"
    exit 1
fi

repo_slug="Nishfleet/$repo"
branch_name="claim/issue-$issue"

# Never release a claim while this instance's worker is still live.
# StartLimitBurst can fire OnFailure while ExecStart is still running
# (two overlapping `systemctl start`s of a Type=oneshot). Releasing then
# is the split-brain in Nishfleet/fleet-ops#26: an unsanctioned worker
# with no claim, and the next tick free to duplicate the work.
worker_is_live() {
    local unit="pi-issue@${instance}.service"
    local active main
    active="$("$SYSTEMCTL" --user show -p ActiveState --value "$unit" 2>/dev/null || echo "")"
    main="$("$SYSTEMCTL" --user show -p MainPID --value "$unit" 2>/dev/null || echo 0)"
    case "$active" in
        active) return 0 ;;
        activating)
            # auto-restart has MainPID=0 (worker process exited, only the
            # restart timer is pending) — NOT live. Only activating/start
            # (MainPID>0) is a real running worker. Treating auto-restart as
            # live was the never-say-next stuck-loop root cause
            # (fleet-ops#109, 2026-08-26): a worker that exits non-zero
            # thrashed forever because the reaper refused to release its
            # claim while StartLimitIntervalSec reset hourly.
            [[ "$main" =~ ^[1-9][0-9]*$ ]] && return 0
            return 1
            ;;
    esac
    if [[ "$main" =~ ^[1-9][0-9]*$ ]]; then
        return 0
    fi
    return 1
}

if worker_is_live; then
    log "worker pi-issue@${instance} still live; not releasing claim"
    log_to_triage "CLAIM-REAP-SKIP-LIVE" "instance=$instance repo=$repo_slug issue=$issue"
    exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
    log "gh CLI missing — cannot reap $repo_slug#$issue (will leave orphan)"
    log_to_triage "CLAIM-REAP-NO-GH" "instance=$instance repo=$repo_slug issue=$issue"
    exit 1
fi

log_to_triage "CLAIM-REAP-STARTED" "instance=$instance repo=$repo_slug issue=$issue dry_run=$dry_run"

# --- load issue state --------------------------------------------------------
# Auditor 2026-08-27T19:00Z (fleet-ops#1001 reaper trip): `gh issue view --json`
# and `gh pr list --json` route through GitHub's GraphQL API which has its own
# rate-limit bucket (independent of the REST bucket the reaper's other `gh api`
# calls use). Hitting the GraphQL rate limit made the reaper exit 1, which
# fired OnFailure -> unit-escalation -> auditor summon. The fix is to load
# state via `gh api` (REST) and to treat transient failures (rate limit, network
# blip) as a soft skip rather than a hard fail — the 30-min orphan sweep
# (P13 tier-1) is the durable backstop for any claim the reaper couldn't reap.
state_json=$(gh api "repos/$repo_slug/issues/$issue" 2>&1) || {
    log "gh api repos/$repo_slug/issues/$issue failed: $(printf '%s' "$state_json" | head -c 200)"
    log_to_triage "CLAIM-REAP-TRANSIENT-SKIP" "step=issue_view instance=$instance reason=gh_api_failed"
    log "transient gh failure on issue state load — exiting 0 and letting the 30-min orphan sweep pick this up"
    exit 0
}

# REST `state` is lowercase; normalize for downstream comparisons.
issue_state=$(printf '%s' "$state_json" | jq -r '.state // "UNKNOWN"' | tr '[:lower:]' '[:upper:]')
in_progress=$(printf '%s' "$state_json" | jq -e '[.labels[]?.name] | any(. == "agent-in-progress")' >/dev/null 2>&1 && echo yes || echo no)

log "state=$issue_state in_progress=$in_progress for $repo_slug#$issue"

# --- branch cleanup: only if no open PR from this branch --------------------
# Same REST-vs-GraphQL split: `gh pr list --json` is GraphQL; use `gh api` REST
# with a head=<branch> filter and count the result.
# The REST head filter is owner:branch (Nishfleet:claim/...), NOT repo:branch.
# 2026-09-05: ${repo_slug#*/} produced "fleet-ops:claim/..." which matches
# nothing, so the guard saw 0 open PRs and deleted branches with live PRs.
open_pr_json=$(gh api "repos/$repo_slug/pulls?state=open&head=${repo_slug%/*}:${branch_name}&per_page=1" 2>&1) || {
    log "gh api repos/$repo_slug/pulls failed: $(printf '%s' "$open_pr_json" | head -c 200)"
    log_to_triage "CLAIM-REAP-TRANSIENT-SKIP" "step=pr_list instance=$instance branch=$branch_name reason=gh_api_failed"
    log "transient gh failure on PR list — exiting 0 and letting the 30-min orphan sweep pick this up"
    exit 0
}
open_pr_count=$(printf '%s' "$open_pr_json" | jq 'length // 0' 2>/dev/null || echo 0)

if [[ "$open_pr_count" -gt 0 ]]; then
    log "open PR exists from $branch_name; leaving branch and labels intact"
    log_to_triage "CLAIM-REAP-NEEDED" "instance=$instance branch=$branch_name open_pr_count=$open_pr_count reason=open_pr_exists"
    exit 0
fi

# --- delete the claim branch if it still exists ------------------------------
branch_exists=no
if gh api "repos/$repo_slug/git/refs/heads/$branch_name" >/dev/null 2>&1; then
    branch_exists=yes
fi

branch_deleted=no
if [[ "$branch_exists" == "yes" ]]; then
    if [[ "$dry_run" == "1" ]]; then
        log "DRY-RUN: would delete branch $branch_name on $repo_slug"
        branch_deleted=skip
    elif gh api "repos/$repo_slug/git/refs/heads/$branch_name" -X DELETE >/dev/null 2>&1; then
        branch_deleted=yes
        should_archive_packets=1
        log "deleted branch $branch_name"
    else
        log "failed to delete branch $branch_name on $repo_slug (label flip will continue)"
        log_to_triage "CLAIM-REAP-BRANCH-FAIL" "instance=$instance branch=$branch_name"
    fi
fi

# --- flip labels according to issue state ------------------------------------
if [[ "$dry_run" == "1" ]]; then
    log "DRY-RUN: would flip labels and post comment on $repo_slug#$issue (state=$issue_state)"
    log_to_triage "CLAIM-REAP-NEEDED" "instance=$instance branch=$branch_name branch_deleted=$branch_deleted state=$issue_state in_progress=$in_progress dry_run=1"
    exit 0
fi

if [[ "$issue_state" == "OPEN" ]]; then
    label_ok=no
    if gh issue edit "$issue" -R "$repo_slug" --remove-label agent-in-progress --add-label agent-ready 2>/dev/null; then
        label_ok=yes
    else
        log "label flip (remove in-progress / add ready) failed on $repo_slug#$issue"
        log_to_triage "CLAIM-REAP-LABEL-FAIL" "instance=$instance step=open_labels"
    fi
    comment_ok=no
    if gh issue comment "$issue" -R "$repo_slug" --body "claim branch released after pi-issue-$instance reached StartLimitBurst at $(date -u +%FT%TZ)" 2>/dev/null; then
        comment_ok=yes
    else
        log "comment post failed on $repo_slug#$issue (label flip already attempted)"
    fi
    log_to_triage "CLAIM-RELEASED" "instance=$instance repo=$repo_slug branch=$branch_name branch_deleted=$branch_deleted label_flipped=$label_ok comment_posted=$comment_ok"
    # --- reclaim cooldown (fleet-ops#2133, auditor 2026-08-30) -----------------
    # A failed worker's claim was just released back to agent-ready. Without a
    # cooldown, the next intake tick (every ~8min) re-claims the same issue,
    # spawns a new worker, and pick_seat routes to another free seat that dies
    # the same way — a spawn-die-respawn loop that burned #2133 6x in one day
    # (05:52, 07:01, 08:26, 09:23 IST + 2 more). The cooldown marker tells
    # intake to skip this issue for PI_INTAKE_RECLAIM_COOLDOWN_S (default 900s
    # = 15min), giving the seat-health ledger time to bench the killing seat
    # and breaking the tight loop. Only written when the branch was actually
    # deleted (the reclaim path); the open-PR shortcut exits before here.
    if [[ "$branch_deleted" == "yes" ]]; then
        cooldown_file="$ATTEMPTS_DIR/pi-issue-${instance}.cooldown"
        if date -u +%Y-%m-%dT%H:%M:%SZ >"$cooldown_file" 2>/dev/null; then
            log "wrote reclaim cooldown marker for $instance (branch deleted, OPEN issue re-queued with backoff)"
        else
            log "WARN: could not write cooldown marker $cooldown_file"
        fi
        log_to_triage "RECLAIM-COOLDOWN-SET" "instance=$instance repo=$repo_slug issue=$issue cooldown=$cooldown_file"
    fi

    # fleet-ops#2462: reclaim-count increment. Each failed re-claim is one
    # strike against MAX_RECLAIMS (see pi-intake-tick.sh). The first claim is
    # counted by pi-issue-run on success; every failed re-claim (this path)
    # increments the counter. When the count reaches the cap, intake escalates
    # the issue instead of re-claiming. A successful PR open resets it.
    _rc_file="$ATTEMPTS_DIR/pi-issue-${instance}.reclaim-count"
    _rc_prev=0
    if [[ -f "$_rc_file" ]]; then
        _rc_prev=$(cat "$_rc_file" 2>/dev/null || echo 0)
        _rc_prev=${_rc_prev//[^0-9]/}
        _rc_prev=${_rc_prev:-0}
    fi
    _rc_new=$(( _rc_prev + 1 ))
    if printf '%s' "$_rc_new" > "$_rc_file" 2>/dev/null; then
        log "incremented reclaim-count to $_rc_new for $instance (was $_rc_prev)"
        log_to_triage "RECLAIM-COUNT-INCREMENTED" "instance=$instance count=$_rc_new"
    else
        log "WARN: could not write reclaim-count $_rc_file"
    fi

    # fleet-ops#2462: systemic-failure detection. When the issue has failed
    # on every seat in the tried-seats list AND all those seats are now
    # benched (seat-health ledger says unusable), the failure is systemic —
    # a provider-wide outage (503/429/500 storm), not per-seat faults.
    # Write a .systemic marker so the next intake tick skips re-claiming
    # until the seat pool recovers, instead of spawning another worker
    # into a dead provider. The tried-seats list is the evidence: one entry
    # per failed attempt; if every entry is benched, the issue has exhausted
    # every available seat.
    _tried_file="$ATTEMPTS_DIR/pi-issue-${instance}.tried-seats"
    _systemic_file="$ATTEMPTS_DIR/pi-issue-${instance}.systemic"
    if [[ -f "$_tried_file" ]]; then
        _seat_lib="${SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
        _src_seat_lib=""
        if [[ -f "$_seat_lib" ]]; then
            # shellcheck disable=SC1090
            _src_seat_lib=$(source "$_seat_lib" 2>/dev/null && echo yes || echo no)
        fi
        _all_benched=1
        _seat_scan_total=0
        _seat_scan_benched=0
        while IFS= read -r _ts_line; do
            [[ -z "$_ts_line" ]] && continue
            _ts_provider="${_ts_line%%/*}"
            _ts_model="${_ts_line#*/}"
            [[ -n "$_ts_provider" && -n "$_ts_model" ]] || continue
            _seat_scan_total=$(( _seat_scan_total + 1 ))
            if [[ "$_src_seat_lib" == "yes" ]] && declare -F seat_usable >/dev/null 2>&1; then
                if ! seat_usable "$_ts_provider" "$_ts_model" 2>/dev/null; then
                    _seat_scan_benched=$(( _seat_scan_benched + 1 ))
                fi
            fi
        done < "$_tried_file"
        # A systemic marker fires only when every tried seat is benched AND
        # we saw at least one seat (otherwise there is no exhaustion to signal).
        # If seat-lib is absent (CI), we cannot evaluate seat_usable — skip
        # the marker (fail-open: re-claim normally).
        if (( _seat_scan_total > 0 && _seat_scan_total == _seat_scan_benched )); then
            if date -u +%Y-%m-%dT%H:%M:%SZ > "$_systemic_file" 2>/dev/null; then
                log "SYSTEMIC-FAILURE detected for $instance: all $_seat_scan_total tried seats are benched — writing .systemic marker (intake will skip re-claim until recovery)"
                log_to_triage "SYSTEMIC-FAILURE-DETECTED" "instance=$instance seats_tried=$_seat_scan_total seats_benched=$_seat_scan_benched"
            fi
        fi
    fi
elif [[ "$issue_state" == "CLOSED" ]]; then
    label_ok=no
    if [[ "$in_progress" == "yes" ]]; then
        if gh issue edit "$issue" -R "$repo_slug" --remove-label agent-in-progress 2>/dev/null; then
            label_ok=yes
        else
            log "label remove (in-progress) failed on closed $repo_slug#$issue"
            log_to_triage "CLAIM-REAP-LABEL-FAIL" "instance=$instance step=closed_labels"
        fi
    fi
    should_archive_packets=1
    log_to_triage "CLAIM-CLOSED-CLEANUP" "instance=$instance repo=$repo_slug branch=$branch_name branch_deleted=$branch_deleted label_removed=$label_ok"
    # fleet-ops#2462: reset reclaim-count + clear systemic marker on close.
    # A closed issue means the work shipped (merged PR): the per-issue state
    # files must clear so a future re-open starts fresh, not inheriting a
    # stale cap or systemic marker from a prior failure cycle.
    rm -f "$ATTEMPTS_DIR/pi-issue-${instance}.reclaim-count" 2>/dev/null || true
    rm -f "$ATTEMPTS_DIR/pi-issue-${instance}.systemic" 2>/dev/null || true
    log "reset reclaim-count + cleared systemic marker for $instance (issue closed)"
    log_to_triage "CLAIM-CLOSED-RESET" "instance=$instance repo=$repo_slug"
else
    log "unknown issue state '$issue_state' for $repo_slug#$issue; leaving labels"
    log_to_triage "CLAIM-REAP-UNKNOWN-STATE" "instance=$instance state=$issue_state"
fi

# --- preserve per-seat avoidance across the claim reset ----------------------
# fleet-ops#516 (auditor 2026-08-27): the reap must NOT wipe the per-issue
# tried-seats file when the last failure was a mid-session provider death on
# a still-healthy seat. Without this, the intake re-claim starts from an
# empty tried-seats list and pick_seat re-selects the SAME killing seat
# (0509-974 cursor-grok-4.6-high 143 x3). The seat-health ledger is the
# DURABLE avoidance authority (pi-issue-run now benches mid-session deaths
# there), but a seat that was killed ONCE should still be excluded until the
# next restart would anyway move on; an empty list also throws away the rest
# of the burst's rotation history. Only clear when every seat in the list is
# already benched in the ledger (seat_usable=no) — the next claim then picks
# a healthy seat from the full pool, which is exactly the recover case the
# reset exists for (fleet-ops-32).
last_seat=""
last_seat_file="$ATTEMPTS_DIR/pi-issue-${instance}.seat"
if [[ -f "$last_seat_file" ]]; then
    last_seat=$(cat "$last_seat_file" 2>/dev/null || true)
fi
mid_session_bench=0
if [[ -n "$last_seat" ]]; then
    # shellcheck disable=SC1091
    # Source the repo copy when present so CI does not leak the live VPS
    # seat ledger (a missing seat_usable there looks like "benched" and
    # keeps tried-seats, which is the opposite of the recover case).
    _seat_lib="${SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
    if [[ -f "$_seat_lib" ]]; then
        # shellcheck disable=SC1090
        source "$_seat_lib" 2>/dev/null || true
    fi
    if declare -F seat_usable >/dev/null 2>&1; then
        if ! seat_usable "${last_seat%%/*}" "${last_seat#*/}" 2>/dev/null; then
            mid_session_bench=1
        fi
    fi
fi

tried_file="$ATTEMPTS_DIR/pi-issue-${instance}.tried-seats"
if [[ -f "$tried_file" && "$mid_session_bench" == "1" ]]; then
    log "keeping tried-seats file for $instance (last seat $last_seat is benched in the seat ledger — the re-claim must pick a different seat)"
    log_to_triage "TRIED-SEATS-KEPT" "instance=$instance last_seat=$last_seat"
elif [[ -f "$tried_file" ]]; then
    : >"$tried_file"
    log "reset tried-seats file for $instance"
    log_to_triage "TRIED-SEATS-RESET" "instance=$instance file=$tried_file"
fi

# --- archive the per-instance .in/.out/.err packets on a real reap -----------
# fleet-ops#638 (auditor 2026-08-27T03:31Z): a stale .in packet at
# $ISSUES_DIR/<instance>.in keeps pi-issue@<instance>.service on life
# support via Restart=on-failure, StartLimitBurst=3 — a closed issue whose
# PR was already merged will keep re-firing the worker on a transient blip
# until the burst exhausts (or a 503 ends the loop, summoning the auditor).
# Once the reaper has actually released the claim (CLOSED state OR a real
# branch delete), there is nothing left for the unit to do. Move the
# packets to ARCHIVED-<instance>.<ext>-<UTCts> in the same directory so the
# next .path / .inotify fire is a no-op. Dry-run skips this; open-PR
# shortcut and live-skip exit before reaching here.
archive_packets() {
    local ext
    local archived=0
    local stamp
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    # fleet-ops#638 follow-up (senior auditor 2026-08-27): the .in packet
    # must NOT be archived while the unit still has a pending restart in its
    # ladder. The reaper runs on OnFailure= at the FIRST failure — systemd's
    # Restart=on-failure ladder (RestartSteps=3, RestartSec=240) is still
    # armed, and a unit with StartLimitBurst=3 gets 3 more chances after
    # OnFailure fired. If we mv the .in now, the next ladder restart fails
    # 208/STDIN (missing StandardInput=file) -> ANOTHER OnFailure -> another
    # unit-escalation -> another STOP-REASON -> another auditor summon per
    # ladder step. Fix: cancel the ladder first (stop + reset-failed), THEN
    # archive. stop silences the pending restart timer; reset-failed clears
    # the failure state so the unit cannot re-arm. Both are safe: the worker
    # process already exited (MainPID=0 verified by worker_is_live) and the
    # claim is being released on GitHub in this same run.
    local unit_name="pi-issue@${instance}.service"
    if "$SYSTEMCTL" --user stop "$unit_name" >/dev/null 2>&1; then
        log "stopped $unit_name (cancel pending restart ladder before archiving packets)"
    else
        log "WARN: could not stop $unit_name before archiving packets (ladder may still fire 208/STDIN)"
    fi
    if "$SYSTEMCTL" --user reset-failed "$unit_name" >/dev/null 2>&1; then
        log "reset-failed $unit_name (cleared failure state so no stale OnFailure re-fire)"
    else
        log "WARN: could not reset-failed $unit_name"
    fi
    for ext in in out err; do
        local f="$ISSUES_DIR/${instance}.${ext}"
        if [[ -f "$f" ]]; then
            local target="$ISSUES_DIR/ARCHIVED-${instance}.${ext}-${stamp}"
            if mv "$f" "$target" 2>/dev/null; then
                archived=$((archived + 1))
            else
                log "WARN: could not archive $f -> $target (will leave in place — unit may auto-restart)"
            fi
        fi
    done
    if [[ "$archived" -gt 0 ]]; then
        log "archived $archived packet file(s) for $instance (state=$issue_state branch_deleted=$branch_deleted)"
        log_to_triage "PACKETS-ARCHIVED" "instance=$instance repo=$repo_slug state=$issue_state branch_deleted=$branch_deleted count=$archived stamp=$stamp"
    fi
}

if [[ "$should_archive_packets" == "1" ]]; then
    archive_packets
fi

exit 0
