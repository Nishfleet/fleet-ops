#!/usr/bin/env bash
# fleet-gap-closure-conference — three-senior-auditor conference
# (fleet-ops#180). Two modes: research | termination.
#
# Round 1: start all three fleet-gap-closure-auditor@ instances together;
# systemd waits. Round 2: same, with round-1 verdicts in the packet. Then
# tally. Sibling of pi-audit@ (admission panel). No sleep-wait. A failed
# auditor unit fails this oneshot (OnFailure=).

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

STATE_DIR="${GAP_LOOP_STATE_DIR:-/home/nish/workspaces/agent-state/gap-closure}"
REPO="${GAP_LOOP_REPO:-Nishfleet/fleet-ops}"
SYSTEMCTL="${GAP_LOOP_SYSTEMCTL:-systemctl}"
TALLY_BIN="${GAP_LOOP_TALLY_BIN:-}"
PI_AUDIT_RUN="${GAP_LOOP_PI_AUDIT_RUN:-}"
GH="${GAP_LOOP_GH:-gh}"
DRY_RUN="${GAP_LOOP_DRY_RUN:-0}"
DISABLE="${GAP_LOOP_DISABLE:-0}"
JOBS_DIR="$STATE_DIR/pi-audit-jobs"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
usage: fleet-gap-closure-conference
Two-round senior-auditor conference (research | termination).
--help prints this and exits 0 without starting auditors.
EOF
    exit 0
fi

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
[ -n "$TALLY_BIN" ] || TALLY_BIN="$here/fleet-gap-closure-tally"
[ -n "$PI_AUDIT_RUN" ] || PI_AUDIT_RUN="$here/fleet-gap-closure-auditor"
[ -x "$TALLY_BIN" ] || TALLY_BIN="${HOME}/.local/bin/fleet-gap-closure-tally"
[ -x "$PI_AUDIT_RUN" ] || PI_AUDIT_RUN="${HOME}/.local/bin/fleet-gap-closure-auditor"

# fleet-ops#3121: the dead straitly/ds4-pro third auditor is replaced by the
# senior role. The conference resolves the first usable senior seat
# (senior_seats_in_order from config/seat-caps.json) at start so the blind
# panel always has a live capable third judge. AUDITORS (the JSON array) is
# built below once jq is confirmed.
resolve_senior_conf_seat() {
    local SEAT_LIB_PATH caps s
    SEAT_LIB_PATH="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/litellm-seat.sh}"
    if [ -f "$SEAT_LIB_PATH" ]; then
        # shellcheck source=/dev/null
        source "$SEAT_LIB_PATH"
        load_seat_caps >/dev/null 2>&1 || true
        if command -v find_senior_seat >/dev/null 2>&1; then
            if s=$(find_senior_seat); then
                printf '%s' "$s"
                return 0
            fi
        fi
    fi
    caps="${SEAT_CAPS_JSON:-}"
    if [ -z "$caps" ] || [ ! -f "$caps" ]; then caps="$here/../config/seat-caps.json"; fi
    s="$(jq -r '.senior_seats_in_order[0] // ""' "$caps" 2>/dev/null || true)"
    [ -n "$s" ] && { printf '%s' "$s"; return 0; }
    printf 'cursor/cursor-grok-4.6-high'
}

# fleet-ops#4210: the glm-5-3 auditor used to be hardcoded to the slug
# zenmux/z-ai/glm-5.3-free, which is NOT wired in config/seat-caps.json or
# config/pi-models.json (the live zenmux free GLM is z-ai/glm-4.7-flash-free;
# the wired GLM-5.3 lane is cline/z-ai/glm-5.3-flash). An unwired slug has no
# health ledger, so the auditor preflight refused it at EVERY conference and
# every termination conference filed a mechanical gap-audit dissent. The
# free-GLM auditor is now resolved to the first live usable wired seat at
# start, mirroring the #3121 senior-seat resolution: a free-GLM ladder
# (unwired / unusable slugs skipped), then any free-class seat, then any
# usable capable seat. Prints provider<TAB>model; returns 1 when no usable
# free-GLM seat exists.
_conf_seat_has_health_data() {
    local p="$1" m="$2" f hc
    f=$(seat_ledger_path "$p" "$m" 2>/dev/null || true)
    if [ -f "$f" ]; then
        hc=$(jq -r '.health_class // ""' "$f" 2>/dev/null || true)
    elif [ -f "$SEAT_HEALTH_FILE" ]; then
        # Auditor parity (fleet-ops#1593): the global sidecar is a fallback
        # only when it names this exact provider/model.
        if [ "$(jq -r '.provider // ""' "$SEAT_HEALTH_FILE" 2>/dev/null || true)" = "$p" ] \
           && [ "$(jq -r '.model // ""' "$SEAT_HEALTH_FILE" 2>/dev/null || true)" = "$m" ]; then
            hc=$(jq -r '.health_class // ""' "$SEAT_HEALTH_FILE" 2>/dev/null || true)
        fi
    fi
    # fleet-ops#4523: under `set -u`, `[ -n "$hc" ]` aborts the whole
    # resolve_free_glm_conf_seat subshell with "hc: unbound variable" when a
    # candidate seat has NO health ledger (no ledger file and the global
    # sidecar does not name this exact provider/model) — `local hc` leaves it
    # unset, and referencing it is a fatal nounset error, not a false test.
    # In production enumerate_seats scans the full models.json, so the first
    # wired free-class seat without a ledger crashed the resolver and glm-5-3
    # fell back to the unwired zenmux/z-ai/glm-5.3-free ladder slug, whose
    # preflight always refuses -> a blind-seat dissent every conference
    # (cycle-4 #4210, cycle-6 #4523). `${hc:-}` makes a no-ledger seat a
    # normal non-match so the resolver skips it and falls through to a live
    # usable seat instead of aborting.
    [ -n "${hc:-}" ]
}
resolve_free_glm_conf_seat() {
    local SEAT_LIB_PATH slug p m
    SEAT_LIB_PATH="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/litellm-seat.sh}"
    if [ -f "$SEAT_LIB_PATH" ]; then
        # shellcheck source=/dev/null
        source "$SEAT_LIB_PATH"
        load_seat_caps >/dev/null 2>&1 || true
    else
        return 1
    fi
    # 1) Free-GLM ladder (Nish 2026-09-04 three-role panel). A slug is only
    #    resolvable when wired (model_cap > 0), has health data the auditor
    #    preflight will accept, and is usable right now.
    for slug in zenmux/z-ai/glm-5.3-free cline/z-ai/glm-5.3-flash; do
        p="${slug%%/*}"
        m="${slug#*/}"
        [ -n "$p" ] && [ -n "$m" ] || continue
        [ "$(model_cap "$p" "$m" 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || continue
        _conf_seat_has_health_data "$p" "$m" || continue
        seat_usable "$p" "$m" 2>/dev/null || continue
        printf '%s\t%s\n' "$p" "$m"
        return 0
    done
    # 2) Any free-class seat first (the role is the free lane), then any
    #    capable seat — same degradation shape as pi-audit-run's
    #    resolve_free_role (fleet-ops#3121). A live capable vote is better
    #    than a guaranteed preflight refusal, and it is the only thing that
    #    lets the loop converge while every free lane is benched (2026-09-07:
    #    all free seats quota_bench / corpse / parked). Poison seats are
    #    skipped when the installed routing helper knows them.
    local pass fp fm _fcap _capable cls
    for pass in 1 2; do
        while IFS=$'\t' read -r fp fm _fcap _capable; do
            [ -n "$fp" ] && [ -n "$fm" ] || continue
            [ "$(model_cap "$fp" "$fm" 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || continue
            if [ "$pass" = "1" ]; then
                cls="$(model_class_of "$fp" "$fm" 2>/dev/null || echo "")"
                [ "$cls" = "free" ] || continue
            fi
            _conf_seat_has_health_data "$fp" "$fm" || continue
            seat_usable "$fp" "$fm" 2>/dev/null || continue
            if command -v seat_is_poison >/dev/null 2>&1; then
                seat_is_poison "$fp" "$fm" 2>/dev/null && continue
            fi
            printf '%s\t%s\n' "$fp" "$fm"
            return 0
        done < <(enumerate_seats)
    done
    return 1
}

# fleet-ops#4209: the glm-5-2 auditor used to be hardcoded to devin/glm-5-2.
# When the devin seat is quota-benched, dead, or never-probed, the auditor
# preflight refuses it and the termination conference files a mechanical
# gap-audit dissent (cycle-4 conference 2026-09-07T10:49:54Z: devin/glm-5-2
# quota-benched until 2026-09-08T09:01:04Z — a no-show, not an auditor
# judgment). The devin auditor is now resolved to the first live usable wired
# seat at start, mirroring the #3121 senior-seat and #4210 free-GLM
# resolutions: a devin ladder (unwired / unusable slugs skipped), then any
# usable capable seat. Prints provider<TAB>model; returns 1 when no usable
# seat exists.
resolve_devin_conf_seat() {
    local SEAT_LIB_PATH slug p m
    SEAT_LIB_PATH="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/litellm-seat.sh}"
    if [ -f "$SEAT_LIB_PATH" ]; then
        # shellcheck source=/dev/null
        source "$SEAT_LIB_PATH"
        load_seat_caps >/dev/null 2>&1 || true
    else
        return 1
    fi
    # 1) Devin ladder (Nish 2026-09-04 three-role panel). A slug is only
    #    resolvable when wired (model_cap > 0), has health data the auditor
    #    preflight will accept, and is usable right now.
    for slug in devin/swe-2-max devin/swe-2-high; do
        p="${slug%%/*}"
        m="${slug#*/}"
        [ -n "$p" ] && [ -n "$m" ] || continue
        [ "$(model_cap "$p" "$m" 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || continue
        _conf_seat_has_health_data "$p" "$m" || continue
        seat_usable "$p" "$m" 2>/dev/null || continue
        printf '%s\t%s\n' "$p" "$m"
        return 0
    done
    # 2) Any usable capable seat — same degradation shape as pi-audit-run's
    #    resolve_free_role (fleet-ops#3121). A live capable vote is better
    #    than a guaranteed preflight refusal, and it is the only thing that
    #    lets the loop converge while the devin lane is benched. Poison seats
    #    are skipped when the installed routing helper knows them.
    local fp fm
    while IFS=$'\t' read -r fp fm _fcap _capable; do
        [ -n "$fp" ] && [ -n "$fm" ] || continue
        [ "$(model_cap "$fp" "$fm" 2>/dev/null || echo 0)" -gt 0 ] 2>/dev/null || continue
        _conf_seat_has_health_data "$fp" "$fm" || continue
        seat_usable "$fp" "$fm" 2>/dev/null || continue
        if command -v seat_is_poison >/dev/null 2>&1; then
            seat_is_poison "$fp" "$fm" 2>/dev/null && continue
        fi
        printf '%s\t%s\n' "$fp" "$fm"
        return 0
    done < <(enumerate_seats)
    return 1
}

mkdir -p "$JOBS_DIR"

now_iso() {
    if [ -n "${GAP_LOOP_FAKE_NOW:-}" ]; then printf '%s' "$GAP_LOOP_FAKE_NOW"
    else date -u +%Y-%m-%dT%H:%M:%SZ; fi
}
log() { printf '[%s] [fleet-gap-closure-conference] %s\n' "$(now_iso)" "$*" >&2; }
fail_loud() { printf '[%s] [fleet-gap-closure-conference] FATAL: %s\n' "$(now_iso)" "$*" >&2; exit 1; }

command -v jq >/dev/null 2>&1 || fail_loud "jq missing"

if [ "$DISABLE" = "1" ]; then log "disabled"; exit 0; fi

# fleet-ops#3121: build the three-auditor panel. An explicit GAP_LOOP_AUDITORS
# (tests / operator override) wins; otherwise the third judge is the
# first-usable senior seat, replacing the dead straitly ds4-pro auditor.
if [ -n "${GAP_LOOP_AUDITORS:-}" ]; then
    AUDITORS="$GAP_LOOP_AUDITORS"
else
    SENIOR_SEAT="$(resolve_senior_conf_seat)"
    # fleet-ops#4211: find_senior_seat (the live path) emits provider<TAB>model,
    # not slash. Splitting on '/' yielded both provider and model = the whole
    # tabbed string, so preflight refused the invented seat and the senior
    # auditor dissent kept the termination conference from ever finding the
    # real seat. Split on TAB first, then fall back to '/' (the config seats
    # are slash-shaped) so both representations resolve to a real seat.
    if [[ "$SENIOR_SEAT" == *$'\t'* ]]; then
        SENIOR_PROVIDER="${SENIOR_SEAT%%$'\t'*}"
        SENIOR_MODEL="${SENIOR_SEAT#*$'\t'}"
    else
        SENIOR_PROVIDER="${SENIOR_SEAT%%/*}"
        SENIOR_MODEL="${SENIOR_SEAT#*/}"
    fi
    [ -n "$SENIOR_PROVIDER" ] || SENIOR_PROVIDER=cursor
    [ -n "$SENIOR_MODEL" ] || SENIOR_MODEL=cursor-grok-4.6-high
    # fleet-ops#4210: glm-5-3 must land on a LIVE wired free-GLM seat, not the
    # unwired zenmux/z-ai/glm-5.3-free slug (no health ledger -> the auditor
    # preflight refused it every conference). Only when no usable free seat
    # exists anywhere do we keep the ladder slug, so the preflight refusal
    # and the dissent surface the wall honestly.
    SEAT_HEALTH_FILE="${PI_SEAT_HEALTH_FILE:-/home/nish/workspaces/agent-state/lanes/pi-seat-health.json}"
    if FREE_GLM_SEAT="$(resolve_free_glm_conf_seat)"; then
        GLM53_PROVIDER="$(printf '%s' "$FREE_GLM_SEAT" | cut -f1)"
        GLM53_MODEL="$(printf '%s' "$FREE_GLM_SEAT" | cut -f2)"
        [ -n "$GLM53_PROVIDER" ] || GLM53_PROVIDER=zenmux
        [ -n "$GLM53_MODEL" ] || GLM53_MODEL=z-ai/glm-5.3-free
    else
        GLM53_PROVIDER="zenmux"
        GLM53_MODEL="z-ai/glm-5.3-free"
        log "no usable free-GLM seat; glm-5-3 keeps ladder slug $GLM53_PROVIDER/$GLM53_MODEL (preflight will refuse)"
    fi
    # fleet-ops#4209: glm-5-2 must land on a LIVE wired seat, not the
    # hardcoded devin/glm-5-2 (quota-benched at the cycle-4 conference
    # 2026-09-07T10:49:54Z, so the auditor preflight refused it and the
    # termination conference filed a mechanical dissent). Only when no usable
    # seat exists anywhere do we keep the ladder slug, so the preflight
    # refusal and the dissent surface the wall honestly.
    if DEVIN_SEAT="$(resolve_devin_conf_seat)"; then
        GLM52_PROVIDER="$(printf '%s' "$DEVIN_SEAT" | cut -f1)"
        GLM52_MODEL="$(printf '%s' "$DEVIN_SEAT" | cut -f2)"
        [ -n "$GLM52_PROVIDER" ] || GLM52_PROVIDER=devin
        [ -n "$GLM52_MODEL" ] || GLM52_MODEL=glm-5-2
    else
        GLM52_PROVIDER="devin"
        GLM52_MODEL="glm-5-2"
        log "no usable devin seat; glm-5-2 keeps ladder slug $GLM52_PROVIDER/$GLM52_MODEL (preflight will refuse)"
    fi
    AUDITORS="$(jq -n -c --arg dp "$GLM52_PROVIDER" --arg dm "$GLM52_MODEL" \
                          --arg fp "$GLM53_PROVIDER" --arg fm "$GLM53_MODEL" \
                          --arg sp "$SENIOR_PROVIDER" --arg sm "$SENIOR_MODEL" \
'[{"id":"glm-5-2","provider":$dp,"model":$dm},
  {"id":"glm-5-3","provider":$fp,"model":$fm},
  {"id":"senior","provider":$sp,"model":$sm}]')"
    log "panel resolved: glm-5-2=$GLM52_PROVIDER/$GLM52_MODEL glm-5-3=$GLM53_PROVIDER/$GLM53_MODEL senior=$SENIOR_PROVIDER/$SENIOR_MODEL"
fi

CONF_ID="${GAP_LOOP_CONF_ID:-}"
if [ -z "$CONF_ID" ]; then
    CONF_ID="$(jq -r '.dispatched.conf_id // empty' "$STATE_DIR/state.json" 2>/dev/null || true)"
fi
[ -n "$CONF_ID" ] || fail_loud "no conf-id (set GAP_LOOP_CONF_ID or have the loop dispatch one)"
CONF_DIR="$STATE_DIR/conferences/$CONF_ID"
[ -d "$CONF_DIR" ] || fail_loud "conf dir missing: $CONF_DIR"
MODE="$(tr -d '[:space:]' <"$CONF_DIR/mode" 2>/dev/null || true)"
case "$MODE" in
    research|termination) ;;
    *) fail_loud "unknown conference mode: '$MODE' (expected research|termination)";;
esac
log "conference $CONF_ID mode=$MODE starting"

build_context() {
    local ctx="$CONF_DIR/context.json"
    [ -f "$ctx" ] && return 0
    local loop_state open_issues
    loop_state="$(jq -c . "$STATE_DIR/state.json" 2>/dev/null || echo '{}')"
    open_issues='[]'
    if command -v "$GH" >/dev/null 2>&1; then
        open_issues="$("$GH" issue list -R "$REPO" --state open --json number,title,labels -L 100 2>/dev/null || echo '[]')"
    fi
    jq -n -c \
        --argjson loop_state "$loop_state" \
        --argjson open_issues "$open_issues" \
        --arg mode "$MODE" --arg conf_id "$CONF_ID" --arg now "$(now_iso)" --arg repo "$REPO" \
        '{mode:$mode, conf_id:$conf_id, now:$now, repo:$repo, loop_state:$loop_state, open_issues:$open_issues}' \
        >"$ctx"
}

build_packet() {
    local tpl="$1" out="$2" aid="$3" round="$4" round1="$5"
    python3 - "$tpl" "$out" "$aid" "$round" "$round1" "$CONF_DIR/context.json" "$MODE" "$CONF_ID" <<'PY'
import re, sys, json
tpl, out, aid, round_n, round1, ctx_path, mode, conf_id = sys.argv[1:9]
with open(tpl, encoding='utf-8') as f:
    text = f.read()
with open(ctx_path, encoding='utf-8') as f:
    ctx = json.load(f)
values = {
    'AUDITOR': aid,
    'ROUND': round_n,
    'MODE': mode,
    'CONF_ID': conf_id,
    'CONTEXT_JSON': json.dumps(ctx, indent=2),
    'ROUND1_VERDICTS_JSON': round1,
}
text = re.sub(r'\{\{(\w+)\}\}', lambda m: values.get(m.group(1), m.group(0)), text)
with open(out, 'w', encoding='utf-8') as f:
    f.write(text)
PY
}

write_job() {
    local round="$1" aid="$2" provider="$3" model="$4" packet="$5" stdout="$6"
    local token="$CONF_ID-r${round}-$aid"
    local jdir="$JOBS_DIR/$token"
    mkdir -p "$jdir" "$(dirname "$stdout")"
    jq -n -c \
        --arg token "$token" --arg provider "$provider" --arg model "$model" \
        --arg packet "$packet" --arg stdout "$stdout" --arg mode "$MODE" \
        --arg round "$round" --arg auditor "$aid" \
        '{token:$token, provider:$provider, model:$model, packet:$packet, stdout:$stdout, mode:$mode, round:$round, auditor:$auditor}' \
        >"$jdir/job.json"
    printf '%s' "$token"
}

run_round() {
    local round="$1" prompt_tpl="$2" round1="${3:-[]}"
    local round_dir="$CONF_DIR/round$round"
    mkdir -p "$round_dir"
    local n i aid provider model packet stdout token
    local -a units=()
    local -a tokens=()
    n="$(printf '%s' "$AUDITORS" | jq 'length')"
    i=0
    while [ "$i" -lt "$n" ]; do
        aid="$(printf '%s' "$AUDITORS" | jq -r ".[$i].id")"
        provider="$(printf '%s' "$AUDITORS" | jq -r ".[$i].provider")"
        model="$(printf '%s' "$AUDITORS" | jq -r ".[$i].model")"
        packet="$round_dir/$aid/packet.md"
        stdout="$round_dir/$aid/verdict.json"
        mkdir -p "$round_dir/$aid"
        build_packet "$prompt_tpl" "$packet" "$aid" "$round" "$round1"
        token="$(write_job "$round" "$aid" "$provider" "$model" "$packet" "$stdout")"
        tokens+=("$token")
        units+=("fleet-gap-closure-auditor@${token}.service")
        i=$((i + 1))
    done

    if [ "$DRY_RUN" = "1" ]; then
        i=0
        while [ "$i" -lt "$n" ]; do
            PI_AUDIT_DRY_RUN=1 PI_AUDIT_INSTANCE="${tokens[$i]}" \
                GAP_LOOP_STATE_DIR="$STATE_DIR" "$PI_AUDIT_RUN" "${tokens[$i]}" \
                || fail_loud "dry-run fleet-gap-closure-auditor failed for ${tokens[$i]}"
            i=$((i + 1))
        done
    else
        "$SYSTEMCTL" --user start "${units[@]}" || fail_loud "fleet-gap-closure-auditor@ round $round failed"
    fi

    local verdicts='[]'
    i=0
    while [ "$i" -lt "$n" ]; do
        aid="$(printf '%s' "$AUDITORS" | jq -r ".[$i].id")"
        stdout="$round_dir/$aid/verdict.json"
        local v
        if [ -f "$stdout" ] && jq -e . "$stdout" >/dev/null 2>&1; then
            v="$(jq -c --arg auditor "$aid" '. + {auditor:$auditor}' "$stdout")"
        else
            v="$(jq -n -c --arg auditor "$aid" '{auditor:$auditor, vote:"NOT-DONE", reason:"no valid verdict produced (unit failed or output unparseable)"}')"
        fi
        verdicts="$(printf '%s' "$verdicts" | jq -c --argjson v "$v" '. + [$v]')"
        i=$((i + 1))
    done
    printf '%s' "$verdicts" >"$round_dir/verdicts.json"
    log "round $round complete"
    printf '%s' "$verdicts"
}

file_adopted_specs() {
    local r2="$1"
    local n i delta title body
    n="$(printf '%s' "$r2" | jq '[.[].adopted // []] | add | length // 0')"
    i=0
    while [ "$i" -lt "$n" ]; do
        delta="$(printf '%s' "$r2" | jq -c "[.[].adopted // []] | add | .[$i]")"
        title="$(printf '%s' "$delta" | jq -r '.title // ""')"
        body="$(printf '%s' "$delta" | jq -r '.body // ""')"
        if [ -n "$title" ]; then
            if [ "$DRY_RUN" = "1" ]; then
                log "DRY RUN: would file adopted spec: $title"
            else
                "$GH" issue create -R "$REPO" --title "$title" --body "$body" \
                    --label scout-candidate --label research-delta \
                    || fail_loud "could not file adopted spec: $title"
            fi
        fi
        i=$((i + 1))
    done
    local rej="$CONF_DIR/rejected.jsonl"
    : >"$rej"
    printf '%s' "$r2" | jq -c '[.[].rejected // []] | add | .[]?' 2>/dev/null >>"$rej" || true
}

build_context

here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
if [ "$MODE" = "research" ]; then
    prompt_r1="$repo_root/prompts/gap-closure-research.md"
    prompt_r2="$repo_root/prompts/gap-closure-research-round2.md"
else
    prompt_r1="$repo_root/prompts/gap-closure-conference.md"
    prompt_r2="$repo_root/prompts/gap-closure-conference-round2.md"
fi
[ -f "$prompt_r1" ] || prompt_r1="$HOME/.pi/agent/prompts/$(basename "$prompt_r1")"
[ -f "$prompt_r2" ] || prompt_r2="$HOME/.pi/agent/prompts/$(basename "$prompt_r2")"
[ -f "$prompt_r1" ] || fail_loud "round1 prompt missing"
[ -f "$prompt_r2" ] || fail_loud "round2 prompt missing"

r1="$(run_round 1 "$prompt_r1" '[]')"
r2="$(run_round 2 "$prompt_r2" "$r1")"
printf '%s' "$r2" >"$CONF_DIR/round2/verdicts.json"

"$TALLY_BIN" "$CONF_ID" "$MODE" "$r1" "$r2" >"$CONF_DIR/verdict.json" \
    || fail_loud "tally failed for $CONF_ID"
log "tally written: $CONF_DIR/verdict.json"

if [ "$MODE" = "research" ]; then
    file_adopted_specs "$r2"
fi

log "conference $CONF_ID complete"
exit 0
