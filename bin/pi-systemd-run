#!/usr/bin/env bash
# pi-systemd-run — thin systemd-run --user wrapper so a Pi packet outlives
# this session. Not a dispatcher: no retry ladder, no seat rotation, no queue.
#
# Wrong:  nohup pi --print --provider ... < packet.md > packet.out &
# Right:  pi-systemd-run --unit mypacket --stdin packet.md -- \
#           pi --print --provider minimax --model MiniMax-M3
#
# Clone convention (fleet-ops#1213): if the packet clones a repo, use
#   git clone --reference-if-able /home/nish/workspaces/.mirrors/<repo>.git \
#     https://github.com/Nishfleet/<repo>.git <dest>
# Never --dissociate on throwaway worktrees. Never push to a mirror
# (read-only fetch target). A missing or corrupt mirror degrades to a
# plain clone (--reference-if-able). Mirrors are fetched on the existing
# 5-min fleet-metrics-export tick by git-mirror-update.
#
# The launching shell can exit immediately. systemd owns the process.
# Watch with: systemctl --user status <unit>.service
#             journalctl --user -u <unit>.service -f
#
# If <unit> is already active or activating, this is a no-op (exit 0).
# A second start of a running job is how StartLimitBurst gets burned by
# overlapping ticks — see Nishfleet/fleet-ops#26.
#
# Flags:
#   --dry-run              Print the systemd-run argv; do not start anything.
#   --unit NAME            Transient unit name (default: pi-job-<ts>-<pid>).
#   --working-directory D  Default: /home/nish. MUST be the git worktree to
#                          salvage on a non-clean stop (fleet-ops#1204).
#   --stdin FILE           StandardInput=file: (absolute path). Packet on stdin.
#   --deadline MIN         Dispatch deadline in minutes (default 90). The
#                          completion canary re-dispatches entries still open
#                          past this deadline whose unit is dead/missing.
#                          Also sets RuntimeMaxSec=<MIN>min so a Type=simple
#                          unit self-terminates at that budget instead of
#                          holding hop=run open (fleet-ops#3328). Also the
#                          healthchecks.io grace proxy (dead-man deadline).
#   --deliverable PATH     The artifact the run MUST produce (default: none).
#                          When set, the ExecStopPost dead-man (pi-detached-
#                          deadman) marks the run FAILED if the file is
#                          missing at stop time — EVEN when the unit exited 0
#                          (the exact fleet-ops#4266 gap: a systemctl stop of
#                          a healthy unit yields Result=success and OnFailure
#                          never fires). Relative path = under --working-
#                          directory.
#   --provider NAME        Provider of the dispatched seat (recorded in the
#                          dispatch ledger; used for re-dispatch seat rotation).
#                          If omitted, parsed from the COMMAND when it is
#                          `pi --print --provider P --model M`.
#   --model NAME           Model of the dispatched seat (same as --provider).
#   --chain-id ID          Chain id for re-dispatch continuity (default: new).
#                          A re-dispatch passes the orphaned entry's chain_id
#                          so the chain is tracked across hops.
#   --hop N                Chain hop number (default 0). The original dispatch
#                          is hop 0; each re-dispatch increments it.
#   --unmanaged REASON     Dated escape for a .timer unit name that has no
#                          systemd/timer-manifest.json entry: pass a DATED
#                          reason (must start YYYY-MM-DD) so a deliberately
#                          hand-placed timer can be installed ONE way and one
#                          way only. No blanket allowlist (fleet-ops#4472).
#
# Timer-MANIFEST gate (fleet-ops#4472): a --unit that names a user .timer is
# refused unless it has an entry in systemd/timer-manifest.json (exact or
# template match), via bin/timer-manifest-guard. This is the install-time
# rail that stops an unregistered live timer from existing — the ten-repeat
# defect #3198/#3317/#3336/#3338/#4128/#4218/#4247/#4327/#4291/#4400.
#
# Dead-man (fleet-ops#4266): every real launch arms three rails so a
# detached job that ENDS without its deliverable fails loudly instead of
# silently going away:
#   1. --property=OnFailure=unit-escalation@${unit}.service.service — the
#      SAME shape the global drop-in service.d/10-escalate.conf produces via
#      %%n (template instance = full unit name INCLUDING .service). Explicit
#      here because systemd-run rejects %%n itself in --property values, and
#      because a fresh manager may not yet have loaded the drop-in (proven
#      live 2026-09-07: transients came up with empty OnFailure until
#      daemon-reload). Belt alongside the drop-in's braces.
#   2. ExecStartPost keystone-hc-ping detached start — /start ping with the
#      per-run rid on the dedicated HC_URL_DETACHED check (silent skip when
#      the URL is not provisioned yet).
#   3. ExecStopPost <salvage> + <pi-detached-deadman> (two separate
#      --property=ExecStopPost= directives; a `;`-joined value is NOT split
#      by --property= — proven live 2026-09-07 — and would 203/EXEC) — the
#      verdict hook.
#      SERVICE_RESULT != success OR (--deliverable set AND file absent OR
#      empty) = died: /fail ping + fleet_detached_job_died{unit,...} 1
#      textfile gauge + dispatch-ledger verdict row + exit NONZERO so the
#      clean-stop case still lands the unit in `failed` and fires OnFailure
#      (fleet-ops#5456: ExecStopPost failure marks the unit failed on
#      systemd 255 — proven live by probe-80). Healthy stop
#      (Result=success + deliverable present): success ping, series cleared,
#      exit 0.
#
# fleet-ops#5456: every launch also writes a per-unit drop-in
#   $XDG_RUNTIME_DIR/systemd/user/<unit>.service.d/90-no-resume.conf
#   ([Service] Restart=no) BEFORE systemd-run. The global
#   service.d/20-resume.conf resume policy must never auto-restart these
#   units — the resume rail for packet deaths is the dispatcher's hop+1
#   relaunch, and an in-place systemd restart would re-run the same seat
#   instead of rotating. Proven live 2026-09-11: a unit-scoped drop-in
#   overrides both --property and the global service.d drop-in, and
#   $XDG_RUNTIME_DIR/systemd/user is honoured for transient units.
#   The dead-man removes the drop-in dir at stop.
#
# Salvage (fleet-ops#1204): every real dispatch sets ExecStopPost to
# pi-salvage-worktree and TimeoutStopSec=180 so a SIGTERM/SIGKILL/nonzero
# exit banks a dirty worktree onto wip/<unit>-<ts>. --working-directory is
# the worktree contract. PI_SALVAGE_DISABLE=1 omits the hook (tests).
#
# Dispatch ledger (fleet-ops#1009): every real dispatch with --stdin appends
# one JSONL entry to $FLEET_DISPATCH_LEDGER (default
# $AGENT_STATE/dispatch-ledger.jsonl): {id, chain_id, hop, ts, unit,
# packet_path, provider, model, deadline_min, deadline_ts, cmdline, status,
# retries}. The cmdline field is the repo-side record the repair worker
# reads for relaunch (fleet-ops#4266).
# The packet is COPIED into $FLEET_DISPATCH_PACKET_DIR (default
# $AGENT_STATE/dispatch-packets) BEFORE systemd-run so the completion canary
# can re-issue the SAME packet file after the originating session scratchpad
# is gone. Append-only, no locking: a closing line (same id, new status) is
# appended by fleet-completion-canary; the last line per id wins.
#
# Environment overrides (tests):
#   SYSTEMD_RUN, SYSTEMCTL, PI_SALVAGE_BIN, PI_SALVAGE_DISABLE, AGENT_STATE,
#   FLEET_DISPATCH_LEDGER, FLEET_DISPATCH_PACKET_DIR,
#   FLEET_DISPATCH_LEDGER_NO_WRITE (1 = skip the append, for tests that
#   only want the systemd-run shape). Salvage seams: PI_SALVAGE_WORKTREE_ROOT,
#   PI_SALVAGE_UNIT_STARTED_EPOCH (fleet-ops#5800 sibling sweep). Dead-man
#   seams: PI_DEADMAN_BIN, PI_DEADMAN_TEXTFILE, PI_DEADMAN_DRYRUN,
#   KEYSTONE_HC_ENV,
#   PI_RESUME_DROPIN_DISABLE (1 = skip the no-resume drop-in, for tests),
#
# Exit:
#   0  started, already-running no-op, or dry-run
#   2  usage / refused (nohup in command, missing file, bad unit)
#   1  systemd-run failed

set -euo pipefail

SYSTEMD_RUN="${SYSTEMD_RUN:-systemd-run}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"

usage() {
    cat <<'EOF' >&2
usage: pi-systemd-run [--dry-run] [--unit NAME] [--working-directory DIR] [--stdin FILE] [--deadline MIN] [--deliverable PATH] [--provider NAME] [--model NAME] [--chain-id ID] [--hop N] [--unmanaged 'YYYY-MM-DD reason'] -- COMMAND [ARGS...]

Run COMMAND as a user systemd unit so it outlives this session.
    Never use nohup or trailing & — those die with the launching shell.
    A --unit that names a .timer is refused unless it has an entry in
    systemd/timer-manifest.json (fleet-ops#4472).
EOF
    exit 2
}

dry_run=0
unit=""
workdir="${HOME:-/home/nish}"
stdin_file=""
deadline_min="90"
deliverable=""
provider=""
model=""
chain_id=""
hop="0"
unmanaged=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        --unit)
            [[ $# -ge 2 ]] || usage
            unit="$2"
            shift 2
            ;;
        --working-directory)
            [[ $# -ge 2 ]] || usage
            workdir="$2"
            shift 2
            ;;
        --stdin)
            [[ $# -ge 2 ]] || usage
            stdin_file="$2"
            shift 2
            ;;
        --deadline)
            [[ $# -ge 2 ]] || usage
            deadline_min="$2"
            shift 2
            ;;
        --deliverable)
            [[ $# -ge 2 ]] || usage
            deliverable="$2"
            shift 2
            ;;
        --provider)
            [[ $# -ge 2 ]] || usage
            provider="$2"
            shift 2
            ;;
        --model)
            [[ $# -ge 2 ]] || usage
            model="$2"
            shift 2
            ;;
        --chain-id)
            [[ $# -ge 2 ]] || usage
            chain_id="$2"
            shift 2
            ;;
        --hop)
            [[ $# -ge 2 ]] || usage
            hop="$2"
            shift 2
            ;;
        --unmanaged)
            [[ $# -ge 2 ]] || usage
            unmanaged="$2"
            shift 2
            ;;
        --) shift; break ;;
        -h|--help) usage ;;
        *)
            echo "pi-systemd-run: unknown flag: $1" >&2
            usage
            ;;
    esac
done

[[ $# -ge 1 ]] || usage

# deadline_min / hop are ledger fields; refuse junk so the python append
# never crashes after systemd-run has already queued the unit (fleet-ops#1009).
[[ "$deadline_min" =~ ^[1-9][0-9]*$ ]] \
    || { echo "pi-systemd-run: --deadline must be a positive integer (minutes), got: $deadline_min" >&2; exit 2; }
[[ "$hop" =~ ^[0-9]+$ ]] \
    || { echo "pi-systemd-run: --hop must be a non-negative integer, got: $hop" >&2; exit 2; }

# Parse provider/model from the COMMAND when not given explicitly, so the
# dispatch ledger records the seat even when callers use the bare form
# `pi-systemd-run --unit X --stdin p.md -- pi --print --provider P --model M`.
# Only the first --provider/--model pair in the command is taken.
if [[ -z "$provider" || -z "$model" ]]; then
    prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--provider" && -z "$provider" ]]; then
            provider="$arg"
        elif [[ "$prev" == "--model" && -z "$model" ]]; then
            model="$arg"
        fi
        prev="$arg"
    done
fi

# Refuse the failure mode this wrapper exists to replace.
for arg in "$@"; do
    if [[ "$arg" == "nohup" ]]; then
        echo "pi-systemd-run: refuse nohup — this command already outlives the session" >&2
        exit 2
    fi
done
if [[ "${*}" == *" &"* || "${*}" == *"& "* || "${*}" == *" & " ]]; then
    echo "pi-systemd-run: refuse background '&' — systemd owns the process" >&2
    exit 2
fi

if [[ -z "$unit" ]]; then
    unit="pi-job-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
unit="${unit%.service}"
# systemd unit names: alphanumerics, '.', '_', '-', ':', '\'.
unit="${unit//[^A-Za-z0-9:_.\\-]/_}"
[[ -n "$unit" ]] || { echo "pi-systemd-run: empty --unit after sanitise" >&2; exit 2; }

# --- Timer-MANIFEST gate (fleet-ops#4472) ------------------------------------
# A --unit that names a user .timer is the install rail for a schedule. Refuse
# it unless it has an entry in systemd/timer-manifest.json (exact or template
# match). This is the durable, at-creation prevention that the after-the-fact
# live check cannot give: the ten-repeat defect #3198..#4400 was always caught
# AFTER install. The ONLY escape is --unmanaged with a dated (YYYY-MM-DD)
# reason — no blanket allowlist. Runs before any dispatch/ledger side effect
# so an unregistered timer is never even staged.
if [[ "$unit" == *".timer" ]]; then
    guard_src="${BASH_SOURCE[0]}"
    if command -v readlink >/dev/null 2>&1; then
        guard_src="$(readlink -f "$guard_src" 2>/dev/null || echo "$guard_src")"
    fi
    guard_here="$(cd "$(dirname "$guard_src")" && pwd)"
    guard_bin="${PI_TIMER_GUARD_BIN:-$guard_here/timer-manifest-guard}"
    guard_args=(--manifest "$guard_here/../systemd/timer-manifest.json")
    if [[ -n "$unmanaged" ]]; then
        guard_args+=(--unmanaged "$unmanaged")
    fi
    if ! "$guard_bin" "${guard_args[@]}" -- "$unit"; then
        echo "pi-systemd-run: refuse to install unmanaged timer $unit (fleet-ops#4472)" >&2
        exit 2
    fi
fi

[[ -d "$workdir" ]] || { echo "pi-systemd-run: working directory not found: $workdir" >&2; exit 2; }

# fleet-ops#5456: per-unit no-resume drop-in. These transient packet units
# carry their own resume rail (the dispatcher's hop+1 relaunch on the next
# healthy seat); the global service.d/20-resume.conf Restart=on-failure must
# not also restart them in place — that would re-run the SAME seat and race
# the relaunch. A unit-scoped drop-in overrides the global type drop-in
# (proven live on systemd 255). Runtime dir preferred (auto-GC); ~/.config
# fallback when XDG_RUNTIME_DIR is unset. The file is written just before
# systemd-run and removed by the dead-man at stop (PI_DEADMAN_DROPIN_DIR).
noresume_dir=""
if [[ "${PI_RESUME_DROPIN_DISABLE:-0}" != "1" ]]; then
    _drop_root="${XDG_RUNTIME_DIR:-}/systemd/user"
    if [[ -z "$_drop_root" || ! -d "$_drop_root" ]]; then
        _drop_root="${HOME:-/home/nish}/.config/systemd/user"
    fi
    noresume_dir="$_drop_root/${unit}.service.d"
fi

if [[ -n "$stdin_file" ]]; then
    [[ -f "$stdin_file" ]] || { echo "pi-systemd-run: --stdin file not found: $stdin_file" >&2; exit 2; }
    stdin_file="$(readlink -f "$stdin_file")"
fi

if [[ -n "$deliverable" ]]; then
    # Refuse the dead-man's own boolean label as a path (2026-09-10).
    # The DetachedJobDied annotation prints `deliverable={{ $labels.
    # deliverable }}`, a 0/1 label from the fleet_detached_job_died series
    # (0 = the run promised nothing). A repair worker told to relaunch
    # "with the same --deliverable" read that `deliverable=0` as a path and
    # passed `--deliverable 0`, which resolved to $workdir/0 — a path that
    # can never exist — so ExecStopPost declared `died` on EVERY such unit
    # even at exit 0 and summoned an auditor for work that had succeeded
    # (live: ds41-repair-175321 shipped the DeepSeek V4.1 migration, PR
    # #5047 MERGED, report written, then false-tripped on /home/nish/0).
    # A run with no promised artifact simply omits the flag; a boolean is
    # never a path, so fail loudly at dispatch instead of arming a check
    # that can never pass.
    case "$deliverable" in
        0|1|unset|none|n/a)
            echo "pi-systemd-run: --deliverable '$deliverable' is the dead-man's boolean label, not a path (fleet-ops#4266). A run that promises no artifact must OMIT --deliverable; pass the real artifact path otherwise." >&2
            exit 2
            ;;
    esac
    # Absolute path for the ExecStopPost check: the unit's WorkingDirectory
    # is $workdir, so relative = under it. The file usually does NOT exist
    # at launch (the run creates it), so no -f test here.
    [[ "$deliverable" == /* ]] || deliverable="$workdir/$deliverable"
fi

# Already-running no-op: do not count a second start toward StartLimitBurst.
if [[ "$dry_run" != "1" ]]; then
    state="$("$SYSTEMCTL" --user is-active "${unit}.service" 2>/dev/null || true)"
    case "$state" in
        active|activating)
            echo "pi-systemd-run: ${unit}.service is $state (no-op)"
            exit 0
            ;;
    esac
    main="$("$SYSTEMCTL" --user show -p MainPID --value "${unit}.service" 2>/dev/null || echo 0)"
    if [[ "$main" =~ ^[1-9][0-9]*$ ]]; then
        echo "pi-systemd-run: ${unit}.service still has MainPID=$main (no-op)"
        exit 0
    fi
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
salvage_bin="${PI_SALVAGE_BIN:-$here/pi-salvage-worktree}"
deadman_bin="${PI_DEADMAN_BIN:-$here/pi-detached-deadman}"
ping_bin="${PI_DEADMAN_PING_BIN:-$here/keystone-hc-ping}"

# fleet-ops#4266: one run id per dispatch — the healthchecks.io `rid` AND
# the id that ties the ExecStopPost verdict to this launch. Generated here
# (not in the ledger block) so the dead-man is armed for every real launch,
# --stdin or not.
dispatch_id="$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)"

cmd=(
    "$SYSTEMD_RUN" --user
    --unit="$unit"
    --collect
    --no-block
    --working-directory="$workdir"
    --description="Pi packet $unit (session-independent)"
    --setenv=HOME
    --setenv=PATH
    --setenv=XDG_RUNTIME_DIR
)
if [[ -n "${GH_TOKEN:-}" ]]; then
    cmd+=(--setenv=GH_TOKEN)
fi
if [[ "${PI_SALVAGE_DISABLE:-0}" != "1" ]]; then
    # ExecStopPost still runs after SIGKILL of the main PID (proven
    # 2026-08-27: SERVICE_RESULT=signal EXIT_CODE=killed EXIT_STATUS=KILL).
    # TimeoutStopSec covers the stop job so commit+push is not aborted at
    # the 90s user default.
    cmd+=(--setenv=PI_SALVAGE_WORKDIR="$workdir")
    cmd+=(--setenv=PI_SALVAGE_UNIT="$unit")
    # Dispatch time bounds the hook's "worktree created after the unit
    # started" mtime match (fleet-ops#5800) when the unit record is gone.
    cmd+=(--setenv=PI_SALVAGE_LAUNCHED_EPOCH="$(date -u +%s)")
    # Inherit test/runtime overrides so ExecStopPost writes the same ledger
    # and scans the same worktree root (fleet-ops#5800 sibling sweep).
    for v in AGENT_STATE FLEET_DISPATCH_LEDGER PI_SALVAGE_SKIP_SGSCAN \
             PI_SALVAGE_NOW PI_SALVAGE_REMOTE PI_SALVAGE_SCAN \
             PI_SALVAGE_WORKTREE_ROOT PI_SALVAGE_UNIT_STARTED_EPOCH \
             SYSTEMCTL; do
        if [[ -n "${!v:-}" ]]; then
            cmd+=(--setenv="$v")
        fi
    done
fi
# TimeoutStopSec always: the dead-man verdict (ping + textfile + possibly
# STOP-REASON) may push past the 90s user default too.
cmd+=(--property=TimeoutStopSec=180)

# --- dead-man (fleet-ops#4266) ---------------------------------------------
# Every launch arms the rails; keystone-hc-ping skips silently when
# HC_URL_DETACHED is not provisioned, and the deadman no-ops for runs not
# started via pi-systemd-run (no PI_DEADMAN_DISPATCH).
cmd+=(--setenv=PI_DEADMAN_DISPATCH="$dispatch_id")
cmd+=(--setenv=PI_DEADMAN_UNIT="$unit")
cmd+=(--setenv=PI_DEADMAN_CMDLINE="$*")
cmd+=(--setenv=PI_DEADMAN_DEADLINE="$deadline_min")
if [[ -n "$deliverable" ]]; then
    cmd+=(--setenv=PI_DEADMAN_DELIVERABLE="$deliverable")
fi
if [[ -n "$noresume_dir" ]]; then
    cmd+=(--setenv=PI_DEADMAN_DROPIN_DIR="$noresume_dir")
fi
for v in KEYSTONE_HC_ENV PI_DEADMAN_TEXTFILE PI_DEADMAN_DRYRUN \
         PI_DEADMAN_ESCALATION_BIN PI_DEADMAN_WHOSTOPPED_BIN AGENT_STATE \
         FLEET_DISPATCH_LEDGER; do
    if [[ -n "${!v:-}" ]]; then
        cmd+=(--setenv="$v")
    fi
 done
# OnFailure — the SAME shape the global drop-in service.d/10-escalate.conf
# produces via %n (template instance = full unit name INCLUDING the .service
# suffix). Explicit here because systemd-run REJECTS %n in --property
# values, and the escalation must not depend on a manager that has not yet
# loaded the drop-in (proven live 2026-09-07: transients had empty OnFailure
# until daemon-reload). Belt alongside the drop-in's braces.
cmd+=(--property="OnFailure=unit-escalation@${unit}.service.service")
cmd+=(--property="ExecStartPost=${ping_bin} detached start")
if [[ "${PI_SALVAGE_DISABLE:-0}" != "1" ]]; then
    # Repeated --property=ExecStopPost= APPENDS (proven live 2026-09-07): a
    # `;`-joined value is NOT split by --property= and execs as one literal
    # path (203/EXEC). Two directives: salvage the worktree first, then the
    # dead-man verdict. Both always exit 0.
    cmd+=(--property="ExecStopPost=${salvage_bin}")
fi
cmd+=(--property="ExecStopPost=${deadman_bin}")
# CLOCK_RUN / dispatch-plane deadline is a kill, not just a ledger field.
# Type=simple (systemd-run default) honours RuntimeMaxSec; a hung pi worker
# then SIGTERMs at the budget instead of sitting ActiveState=active forever
# (live fleet-ops#3328: alert-repair-FleetMainRed-20260904T161106Z had no
# cap and held hop=run past 70 min). TimeoutStopSec=180 still covers salvage.
cmd+=(--property="RuntimeMaxSec=${deadline_min}min")

# --- Dispatch ledger: copy the packet into agent-state BEFORE building the --
# StandardInput property (fleet-ops#1009). (a) the unit reads the durable
# copy (the session scratchpad can vanish while the job is still running)
# and (b) a failed copy never leaves a running unit with no re-dispatchable
# file. The copy is the packet_path recorded in the ledger; the unit's
# StandardInput points at it so re-dispatch re-issues the SAME file.
# PI_SALVAGE_PACKET still points at the ORIGINAL file so the ExecStopPost
# salvage stamp is visible to the caller (and tests).
packet_path=""
# fleet-ops#5456: keep the dispatch_id generated above — it is the hc.io rid
# AND the id the dead-man verdict row joins on. Resetting it here used to
# give the ledger entry a different id than PI_DEADMAN_DISPATCH, which made
# the verdict row unjoinable.
original_stdin="$stdin_file"
if [[ "$dry_run" != "1" && "${FLEET_DISPATCH_LEDGER_NO_WRITE:-0}" != "1" && -n "$stdin_file" ]]; then
    AS="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
    PKT_DIR="${FLEET_DISPATCH_PACKET_DIR:-$AS/dispatch-packets}"
    mkdir -p "$PKT_DIR"
    pkt_copy="$PKT_DIR/${unit}-$(date -u +%Y%m%dT%H%M%SZ)-${dispatch_id}.md"
    cp -- "$stdin_file" "$pkt_copy"
    packet_path="$(readlink -f "$pkt_copy")"
    stdin_file="$packet_path"
fi

if [[ "${PI_SALVAGE_DISABLE:-0}" != "1" && -n "$original_stdin" ]]; then
    cmd+=(--setenv=PI_SALVAGE_PACKET="$original_stdin")
fi
if [[ -n "$stdin_file" ]]; then
    cmd+=(--property="StandardInput=file:${stdin_file}")
fi
cmd+=(-- "$@")

if [[ "$dry_run" == "1" ]]; then
    printf '%q ' "${cmd[@]}"
    printf '\n'
    exit 0
fi

# Write the no-resume drop-in just before systemd-run so the manager reads
# it at unit load (a fresh transient unit picks up drop-ins without a
# daemon-reload — proven live 2026-09-11). Failure is non-fatal: the unit
# still gets explicit OnFailure and the dead-man verdict; a missing
# no-resume drop-in only means the global resume policy could also restart
# it in place.
if [[ -n "$noresume_dir" ]]; then
    if mkdir -p "$noresume_dir" 2>/dev/null \
        && printf '[Service]\nRestart=no\n' > "$noresume_dir/90-no-resume.conf" 2>/dev/null; then
        :
    else
        echo "pi-systemd-run: WARN could not write $noresume_dir/90-no-resume.conf" >&2
    fi
fi

echo "pi-systemd-run: starting ${unit}.service (survives this session)"
echo "pi-systemd-run: watch: systemctl --user status ${unit}.service"
echo "pi-systemd-run: logs:  journalctl --user -u ${unit}.service -f"
# Do NOT exec: --no-block returns immediately, and the dispatch ledger
# append (fleet-ops#1009) must run after the unit is queued so the entry
# reflects a real dispatch.
set +e
"${cmd[@]}"
start_rc=$?
set -e
if [[ "$start_rc" -ne 0 ]]; then
    echo "pi-systemd-run: systemd-run failed (rc=$start_rc)" >&2
    exit 1
fi

# --- Dispatch ledger append (fleet-ops#1009) --------------------------------
# Append one JSONL entry so fleet-completion-canary can track this dispatch
# as a chain: close it on completion (journal verdict) or re-dispatch the
# SAME packet file when the unit is orphaned past deadline. Append-only,
# no locking: a closing line (same id, new status) is appended by the
# canary; the last line per id wins.
if [[ "${FLEET_DISPATCH_LEDGER_NO_WRITE:-0}" != "1" ]]; then
    AS="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
    LEDGER="${FLEET_DISPATCH_LEDGER:-$AS/dispatch-ledger.jsonl}"
    dispatch_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ -z "${dispatch_id:-}" ]]; then
        dispatch_id="$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)"
    fi
    if [[ -z "$chain_id" ]]; then
        chain_id="$dispatch_id"
    fi
    # deadline_ts = dispatch ts + deadline_min minutes.
    deadline_ts="$(date -u -d "@$(( $(date -u -d "$dispatch_ts" +%s) + deadline_min * 60 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")"
    mkdir -p "$(dirname "$LEDGER")"
    python3 -c '
import json, sys
entry = {
    "id": sys.argv[1],
    "chain_id": sys.argv[2],
    "hop": int(sys.argv[3]),
    "ts": sys.argv[4],
    "unit": sys.argv[5],
    "packet_path": sys.argv[6],
    "provider": sys.argv[7],
    "model": sys.argv[8],
    "deadline_min": int(sys.argv[9]),
    "deadline_ts": sys.argv[10],
    "cmdline": sys.argv[11],
    # fleet-ops#5456: the hop+1 relaunch needs the workdir and deliverable
    # to replay the SAME dispatch contract, not a rebuilt one.
    "workdir": sys.argv[12],
    "deliverable": sys.argv[13],
    "status": "open",
    "retries": int(sys.argv[3]),
}
sys.stdout.write(json.dumps(entry, separators=(",", ":")) + "\n")
' "$dispatch_id" "$chain_id" "$hop" "$dispatch_ts" "$unit" "$packet_path" \
      "$provider" "$model" "$deadline_min" "$deadline_ts" "$*" \
      "$workdir" "$deliverable" >> "$LEDGER"
    echo "pi-systemd-run: ledger entry id=$dispatch_id chain=$chain_id hop=$hop unit=$unit"
fi

exit 0
