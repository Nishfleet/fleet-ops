#!/usr/bin/env bash
# pi-systemd-run — thin systemd-run --user wrapper so a Pi packet outlives
# this session. Not a dispatcher: no retry ladder, no seat rotation, no queue.
#
# Wrong:  nohup pi --print --provider ... < packet.md > packet.out &
# Right:  pi-systemd-run --unit mypacket --stdin packet.md -- \
#           pi --print --provider minimax --model MiniMax-M3
#
# Clone convention (fleet-ops#1213): if the packet clones a repo, use
#   git clone --reference-if-able /home/nish/workspaces/.mirrors/<repo>.git \
#     https://github.com/Nishfleet/<repo>.git <dest>
# Never --dissociate on throwaway worktrees. Never push to a mirror
# (read-only fetch target). A missing or corrupt mirror degrades to a
# plain clone (--reference-if-able). Mirrors are fetched on the existing
# 5-min fleet-metrics-export tick by git-mirror-update.
#
# The launching shell can exit immediately. systemd owns the process.
# Watch with: systemctl --user status <unit>.service
#             journalctl --user -u <unit>.service -f
#
# If <unit> is already active or activating, this is a no-op (exit 0).
# A second start of a running job is how StartLimitBurst gets burned by
# overlapping ticks — see Nishfleet/fleet-ops#26.
#
# Flags:
#   --dry-run              Print the systemd-run argv; do not start anything.
#   --unit NAME            Transient unit name (default: pi-job-<ts>-<pid>).
#   --working-directory D  Default: /home/nish. MUST be the git worktree to
#                          salvage on a non-clean stop (fleet-ops#1204).
#   --stdin FILE           StandardInput=file: (absolute path). Packet on stdin.
#   --deadline MIN         Dispatch deadline in minutes (default 90). The
#                          completion canary re-dispatches entries still open
#                          past this deadline whose unit is dead/missing.
#                          Also sets RuntimeMaxSec=<MIN>min so a Type=simple
#                          unit self-terminates at that budget instead of
#                          holding hop=run open (fleet-ops#3328).
#   --provider NAME        Provider of the dispatched seat (recorded in the
#                          dispatch ledger; used for re-dispatch seat rotation).
#                          If omitted, parsed from the COMMAND when it is
#                          `pi --print --provider P --model M`.
#   --model NAME           Model of the dispatched seat (same as --provider).
#   --chain-id ID          Chain id for re-dispatch continuity (default: new).
#                          A re-dispatch passes the orphaned entry's chain_id
#                          so the chain is tracked across hops.
#   --hop N                Chain hop number (default 0). The original dispatch
#                          is hop 0; each re-dispatch increments it.
#
# Salvage (fleet-ops#1204): every real dispatch sets ExecStopPost to
# pi-salvage-worktree and TimeoutStopSec=180 so a SIGTERM/SIGKILL/nonzero
# exit banks a dirty worktree onto wip/<unit>-<ts>. --working-directory is
# the worktree contract. PI_SALVAGE_DISABLE=1 omits the hook (tests).
#
# Dispatch ledger (fleet-ops#1009): every real dispatch with --stdin appends
# one JSONL entry to $FLEET_DISPATCH_LEDGER (default
# $AGENT_STATE/dispatch-ledger.jsonl): {id, chain_id, hop, ts, unit,
# packet_path, provider, model, deadline_min, deadline_ts, status, retries}.
# The packet is COPIED into $FLEET_DISPATCH_PACKET_DIR (default
# $AGENT_STATE/dispatch-packets) BEFORE systemd-run so the completion canary
# can re-issue the SAME packet file after the originating session scratchpad
# is gone. Append-only, no locking: a closing line (same id, new status) is
# appended by fleet-completion-canary; the last line per id wins.
#
# Environment overrides (tests):
#   SYSTEMD_RUN, SYSTEMCTL, PI_SALVAGE_BIN, PI_SALVAGE_DISABLE, AGENT_STATE,
#   FLEET_DISPATCH_LEDGER, FLEET_DISPATCH_PACKET_DIR,
#   FLEET_DISPATCH_LEDGER_NO_WRITE (1 = skip the append, for tests that
#   only want the systemd-run shape)
#
# Exit:
#   0  started, already-running no-op, or dry-run
#   2  usage / refused (nohup in command, missing file, bad unit)
#   1  systemd-run failed

set -euo pipefail

SYSTEMD_RUN="${SYSTEMD_RUN:-systemd-run}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"

usage() {
    cat <<'EOF' >&2
usage: pi-systemd-run [--dry-run] [--unit NAME] [--working-directory DIR] [--stdin FILE] [--deadline MIN] [--provider NAME] [--model NAME] [--chain-id ID] [--hop N] -- COMMAND [ARGS...]

Run COMMAND as a user systemd unit so it outlives this session.
    Never use nohup or trailing & — those die with the launching shell.
EOF
    exit 2
}

dry_run=0
unit=""
workdir="${HOME:-/home/nish}"
stdin_file=""
deadline_min="90"
provider=""
model=""
chain_id=""
hop="0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        --unit)
            [[ $# -ge 2 ]] || usage
            unit="$2"
            shift 2
            ;;
        --working-directory)
            [[ $# -ge 2 ]] || usage
            workdir="$2"
            shift 2
            ;;
        --stdin)
            [[ $# -ge 2 ]] || usage
            stdin_file="$2"
            shift 2
            ;;
        --deadline)
            [[ $# -ge 2 ]] || usage
            deadline_min="$2"
            shift 2
            ;;
        --provider)
            [[ $# -ge 2 ]] || usage
            provider="$2"
            shift 2
            ;;
        --model)
            [[ $# -ge 2 ]] || usage
            model="$2"
            shift 2
            ;;
        --chain-id)
            [[ $# -ge 2 ]] || usage
            chain_id="$2"
            shift 2
            ;;
        --hop)
            [[ $# -ge 2 ]] || usage
            hop="$2"
            shift 2
            ;;
        --) shift; break ;;
        -h|--help) usage ;;
        *)
            echo "pi-systemd-run: unknown flag: $1" >&2
            usage
            ;;
    esac
done

[[ $# -ge 1 ]] || usage

# deadline_min / hop are ledger fields; refuse junk so the python append
# never crashes after systemd-run has already queued the unit (fleet-ops#1009).
[[ "$deadline_min" =~ ^[1-9][0-9]*$ ]] \
    || { echo "pi-systemd-run: --deadline must be a positive integer (minutes), got: $deadline_min" >&2; exit 2; }
[[ "$hop" =~ ^[0-9]+$ ]] \
    || { echo "pi-systemd-run: --hop must be a non-negative integer, got: $hop" >&2; exit 2; }

# Parse provider/model from the COMMAND when not given explicitly, so the
# dispatch ledger records the seat even when callers use the bare form
# `pi-systemd-run --unit X --stdin p.md -- pi --print --provider P --model M`.
# Only the first --provider/--model pair in the command is taken.
if [[ -z "$provider" || -z "$model" ]]; then
    prev=""
    for arg in "$@"; do
        if [[ "$prev" == "--provider" && -z "$provider" ]]; then
            provider="$arg"
        elif [[ "$prev" == "--model" && -z "$model" ]]; then
            model="$arg"
        fi
        prev="$arg"
    done
fi

# Refuse the failure mode this wrapper exists to replace.
for arg in "$@"; do
    if [[ "$arg" == "nohup" ]]; then
        echo "pi-systemd-run: refuse nohup — this command already outlives the session" >&2
        exit 2
    fi
done
if [[ "${*}" == *" &"* || "${*}" == *"& "* || "${*}" == *" & " ]]; then
    echo "pi-systemd-run: refuse background '&' — systemd owns the process" >&2
    exit 2
fi

if [[ -z "$unit" ]]; then
    unit="pi-job-$(date -u +%Y%m%dT%H%M%SZ)-$$"
fi
unit="${unit%.service}"
# systemd unit names: alphanumerics, '.', '_', '-', ':', '\'.
unit="${unit//[^A-Za-z0-9:_.\\-]/_}"
[[ -n "$unit" ]] || { echo "pi-systemd-run: empty --unit after sanitise" >&2; exit 2; }

[[ -d "$workdir" ]] || { echo "pi-systemd-run: working directory not found: $workdir" >&2; exit 2; }

if [[ -n "$stdin_file" ]]; then
    [[ -f "$stdin_file" ]] || { echo "pi-systemd-run: --stdin file not found: $stdin_file" >&2; exit 2; }
    stdin_file="$(readlink -f "$stdin_file")"
fi

# Already-running no-op: do not count a second start toward StartLimitBurst.
if [[ "$dry_run" != "1" ]]; then
    state="$("$SYSTEMCTL" --user is-active "${unit}.service" 2>/dev/null || true)"
    case "$state" in
        active|activating)
            echo "pi-systemd-run: ${unit}.service is $state (no-op)"
            exit 0
            ;;
    esac
    main="$("$SYSTEMCTL" --user show -p MainPID --value "${unit}.service" 2>/dev/null || echo 0)"
    if [[ "$main" =~ ^[1-9][0-9]*$ ]]; then
        echo "pi-systemd-run: ${unit}.service still has MainPID=$main (no-op)"
        exit 0
    fi
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
salvage_bin="${PI_SALVAGE_BIN:-$here/pi-salvage-worktree}"

cmd=(
    "$SYSTEMD_RUN" --user
    --unit="$unit"
    --collect
    --no-block
    --working-directory="$workdir"
    --description="Pi packet $unit (session-independent)"
    --setenv=HOME
    --setenv=PATH
    --setenv=XDG_RUNTIME_DIR
)
if [[ -n "${GH_TOKEN:-}" ]]; then
    cmd+=(--setenv=GH_TOKEN)
fi
if [[ "${PI_SALVAGE_DISABLE:-0}" != "1" ]]; then
    # ExecStopPost still runs after SIGKILL of the main PID (proven
    # 2026-08-27: SERVICE_RESULT=signal EXIT_CODE=killed EXIT_STATUS=KILL).
    # TimeoutStopSec covers the stop job so commit+push is not aborted at
    # the 90s user default.
    cmd+=(--setenv=PI_SALVAGE_WORKDIR="$workdir")
    cmd+=(--setenv=PI_SALVAGE_UNIT="$unit")
    # Inherit test/runtime overrides so ExecStopPost writes the same ledger.
    for v in AGENT_STATE FLEET_DISPATCH_LEDGER PI_SALVAGE_SKIP_SGSCAN \
             PI_SALVAGE_NOW PI_SALVAGE_REMOTE PI_SALVAGE_SCAN; do
        if [[ -n "${!v:-}" ]]; then
            cmd+=(--setenv="$v")
        fi
    done
    cmd+=(--property="ExecStopPost=${salvage_bin}")
    cmd+=(--property=TimeoutStopSec=180)
fi
# CLOCK_RUN / dispatch-plane deadline is a kill, not just a ledger field.
# Type=simple (systemd-run default) honours RuntimeMaxSec; a hung pi worker
# then SIGTERMs at the budget instead of sitting ActiveState=active forever
# (live fleet-ops#3328: alert-repair-FleetMainRed-20260904T161106Z had no
# cap and held hop=run past 70 min). TimeoutStopSec=180 still covers salvage.
cmd+=(--property="RuntimeMaxSec=${deadline_min}min")

# --- Dispatch ledger: copy the packet into agent-state BEFORE building the --
# StandardInput property (fleet-ops#1009). (a) the unit reads the durable
# copy (the session scratchpad can vanish while the job is still running)
# and (b) a failed copy never leaves a running unit with no re-dispatchable
# file. The copy is the packet_path recorded in the ledger; the unit's
# StandardInput points at it so re-dispatch re-issues the SAME file.
# PI_SALVAGE_PACKET still points at the ORIGINAL file so the ExecStopPost
# salvage stamp is visible to the caller (and tests).
packet_path=""
dispatch_id=""
original_stdin="$stdin_file"
if [[ "$dry_run" != "1" && "${FLEET_DISPATCH_LEDGER_NO_WRITE:-0}" != "1" && -n "$stdin_file" ]]; then
    AS="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
    PKT_DIR="${FLEET_DISPATCH_PACKET_DIR:-$AS/dispatch-packets}"
    mkdir -p "$PKT_DIR"
    dispatch_id="$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)"
    pkt_copy="$PKT_DIR/${unit}-$(date -u +%Y%m%dT%H%M%SZ)-${dispatch_id}.md"
    cp -- "$stdin_file" "$pkt_copy"
    packet_path="$(readlink -f "$pkt_copy")"
    stdin_file="$packet_path"
fi

if [[ "${PI_SALVAGE_DISABLE:-0}" != "1" && -n "$original_stdin" ]]; then
    cmd+=(--setenv=PI_SALVAGE_PACKET="$original_stdin")
fi
if [[ -n "$stdin_file" ]]; then
    cmd+=(--property="StandardInput=file:${stdin_file}")
fi
cmd+=(-- "$@")

if [[ "$dry_run" == "1" ]]; then
    printf '%q ' "${cmd[@]}"
    printf '\n'
    exit 0
fi

echo "pi-systemd-run: starting ${unit}.service (survives this session)"
echo "pi-systemd-run: watch: systemctl --user status ${unit}.service"
echo "pi-systemd-run: logs:  journalctl --user -u ${unit}.service -f"
# Do NOT exec: --no-block returns immediately, and the dispatch ledger
# append (fleet-ops#1009) must run after the unit is queued so the entry
# reflects a real dispatch.
set +e
"${cmd[@]}"
start_rc=$?
set -e
if [[ "$start_rc" -ne 0 ]]; then
    echo "pi-systemd-run: systemd-run failed (rc=$start_rc)" >&2
    exit 1
fi

# --- Dispatch ledger append (fleet-ops#1009) --------------------------------
# Append one JSONL entry so fleet-completion-canary can track this dispatch
# as a chain: close it on completion (journal verdict) or re-dispatch the
# SAME packet file when the unit is orphaned past deadline. Append-only,
# no locking: a closing line (same id, new status) is appended by the
# canary; the last line per id wins.
if [[ "${FLEET_DISPATCH_LEDGER_NO_WRITE:-0}" != "1" ]]; then
    AS="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
    LEDGER="${FLEET_DISPATCH_LEDGER:-$AS/dispatch-ledger.jsonl}"
    dispatch_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ -z "${dispatch_id:-}" ]]; then
        dispatch_id="$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)"
    fi
    if [[ -z "$chain_id" ]]; then
        chain_id="$dispatch_id"
    fi
    # deadline_ts = dispatch ts + deadline_min minutes.
    deadline_ts="$(date -u -d "@$(( $(date -u -d "$dispatch_ts" +%s) + deadline_min * 60 ))" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "")"
    mkdir -p "$(dirname "$LEDGER")"
    python3 -c '
import json, sys
entry = {
    "id": sys.argv[1],
    "chain_id": sys.argv[2],
    "hop": int(sys.argv[3]),
    "ts": sys.argv[4],
    "unit": sys.argv[5],
    "packet_path": sys.argv[6],
    "provider": sys.argv[7],
    "model": sys.argv[8],
    "deadline_min": int(sys.argv[9]),
    "deadline_ts": sys.argv[10],
    "status": "open",
    "retries": int(sys.argv[3]),
}
sys.stdout.write(json.dumps(entry, separators=(",", ":")) + "\n")
' "$dispatch_id" "$chain_id" "$hop" "$dispatch_ts" "$unit" "$packet_path" \
      "$provider" "$model" "$deadline_min" "$deadline_ts" >> "$LEDGER"
    echo "pi-systemd-run: ledger entry id=$dispatch_id chain=$chain_id hop=$hop unit=$unit"
fi

exit 0
