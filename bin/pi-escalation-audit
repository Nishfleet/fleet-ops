#!/usr/bin/env bash
# bin/pi-escalation-audit
#
# Drives the senior-auditor panel for `escalate-senior` issues
# (fleet-ops#234). This is the intake path the escalation bridge (fleet-ops
# #221) consumes: it picks up open `escalate-senior` labeled issues in the
# escalation repo and routes them to the same three-senior blind panel as the
# admission panel (#146), so a regular fleet lane never claims an escalation
# directly (that defeats the panel).
#
# Each tick:
#   1. List open `escalate-senior` issues in the escalation repo.
#   2. For each, ensure the three panel units exist or start any missing one
#      (devin, free-glm-5-3, straitly) via the dedicated
#      `pi-escalation-audit@<repo>--<candidate>--<role>` template.
#   3. If a needed unit is failed (StartLimitBurst exhausted), reset-failed
#      then start it so a recovered seat is not wedged (fleet-ops#616).
#   4. When all three votes are present, call pi-escalation-audit-tally to
#      admit (file an agent-ready fix issue) or dismiss (comment + close).
#   5. If an issue is pending for more than one tick with no active panel
#      unit, write a loud ESCALATION-PANEL-PENDING finding.
#
# Dedup is by construction: gh lists only OPEN escalate-senior issues, the
# panel units exist once per issue (no re-spawn), and a tallied issue is
# closed (drops off the open list). The signature-hash marker the bridge
# writes is the cross-run dedup key; it already stops the bridge from filing
# a duplicate, and closing the wrapper releases the bound.
#
# Invoked by pi-escalation-audit.service on a timer. No hand-rolled polling.
# Votes are state files, not a queue daemon. A failed unit with a missing
# vote is retried every tick until the vote lands or the issue closes;
# ESCALATION-PANEL-PENDING is the alarm if the panel never convenes.
#
# Environment seams:
#   AUDIT_ESCALATION_REPO  escalation repo (default Nishfleet/fleet-ops)
#   AUDIT_STATE_DIR        vote file tree (default ~/.local/state/fleet-audit)
#   AUDIT_TALLY_BIN        default /home/nish/.local/bin/pi-escalation-audit-tally
#   AUDIT_PENDING_AGE_S    default 2400 (40 min)
#   AUDIT_TICK_MAX_START   default 4
#   GH, SYSTEMCTL, AUDIT_GH

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${AUDIT_GH:-${GH:-gh}}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
REPO="${AUDIT_ESCALATION_REPO:-Nishfleet/fleet-ops}"
REPO_SLUG="${REPO#Nishfleet/}"
LOG_DIR="${FLEET_HEARTBEAT_LOG_DIR:-$HOME/.local/state/fleet-heartbeat}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
STATE_DIR="${AUDIT_STATE_DIR:-$HOME/.local/state/fleet-audit}"
TALLY_BIN="${AUDIT_TALLY_BIN:-/home/nish/.local/bin/pi-escalation-audit-tally}"
PENDING_AGE_S="${AUDIT_PENDING_AGE_S:-2400}"
TICK_MAX_START="${AUDIT_TICK_MAX_START:-4}"
started_this_tick=0

mkdir -p "$LOG_DIR" "$STATE_DIR"

ROLES=(devin free-glm-5-3 straitly)

command -v jq >/dev/null 2>&1 || { log "FATAL: jq missing"; exit 2; }
[ -x "$TALLY_BIN" ] || { log "FATAL: tally script missing or not executable: $TALLY_BIN"; exit 2; }

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log() { printf '[%s] [pi-escalation-audit] %s\n' "$(ts)" "$*" >&2; }

loud() {
    local tag="$1"; shift
    printf '[%s] [ESCALATION-%s] %s\n' "$(ts)" "$tag" "$*" >&2
    { printf '\n[%s] [ESCALATION-%s] %s\n' "$(ts)" "$tag" "$*"; } >> "$TRIAGE" 2>/dev/null || true
}

escalations() {
    local out
    out=$("$GH" issue list -R "$REPO" -l escalate-senior --state open --json number --limit 200 2>&1) || {
        log "$REPO: escalate-senior list gh FAILED: $out"
        return 1
    }
    printf '%s\n' "$out" | jq -r '.[] | .number'
}

unit_name() {
    local repo="$1" candidate="$2" role="$3"
    printf 'pi-escalation-audit@%s--%s--%s.service\n' "$repo" "$candidate" "$role"
}

unit_state() {
    local unit="$1"
    "$SYSTEMCTL" --user is-active "$unit" 2>/dev/null || true
}

vote_path() {
    local repo="$1" candidate="$2" role="$3"
    printf '%s/%s/%s/%s.vote\n' "$STATE_DIR" "$repo" "$candidate" "$role"
}

# A vote only counts as PRESENT for the tally when it carries a real PASS or
# FAIL verdict. pi-audit-run writes a SKIP vote (exit 0) on a transient
# seat-health refusal or provider wall, promising "retry next tick" (#146);
# if the orchestrator treated that SKIP as present, the tally would count it
# as neither PASS nor FAIL, the panel would wedge at 1-1 forever with all
# votes "present", the tally path would reset the pending stamp every tick
# (so PANEL-PENDING never fires), and an escalate-senior issue could sit
# unresolved indefinitely -- the #1424 live wedge. Re-run the SKIP'd role so
# the vote is re-collected fresh and a genuinely stuck panel can escalate.
vote_is_complete() {
    local v="$1" verdict
    verdict=$(jq -r '.verdict // ""' "$v" 2>/dev/null || printf '')
    case "$verdict" in
        PASS|FAIL) return 0 ;;
        *) return 1 ;;
    esac
}

pending_stamp() {
    local repo="$1" candidate="$2"
    printf '%s/%s/%s/.pending\n' "$STATE_DIR" "$repo" "$candidate"
}

mark_pending() {
    local repo="$1" candidate="$2" stamp
    stamp=$(pending_stamp "$repo" "$candidate")
    [ -f "$stamp" ] && return
    mkdir -p "$(dirname "$stamp")"
    ts > "$stamp"
}

pending_since_s() {
    local repo="$1" candidate="$2" stamp now then_s
    stamp=$(pending_stamp "$repo" "$candidate")
    [ -f "$stamp" ] || return 1
    now=$(date -u +%s)
    then_s=$(date -u -d "$(cat "$stamp")" +%s 2>/dev/null || echo 0)
    [ "$then_s" -gt 0 ] 2>/dev/null || return 1
    printf '%s\n' $(( now - then_s ))
}

# fleet-ops#146 (storm-tolerant panel): cap how many panel units this tick
# may START --no-block. Units that fail to start this tick are left for the
# next tick; the timer cadence is the backpressure.
start_audit() {
    local repo="$1" candidate="$2" role="$3" unit
    unit=$(unit_name "$repo" "$candidate" "$role")
    if [ "$started_this_tick" -ge "$TICK_MAX_START" ]; then
        log "$repo/#$candidate: $unit deferred (tick cap $started_this_tick/$TICK_MAX_START)"
        return 2
    fi
    log "$repo/#$candidate: starting $unit"
    if ! "$SYSTEMCTL" --user start --no-block "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: start $unit FAILED"
        return 1
    fi
    started_this_tick=$((started_this_tick + 1))
    return 0
}

# fleet-ops#616: StartLimitBurst=2 + StartLimitIntervalSec=1h leaves a
# unit failed until the interval elapses. reset-failed clears the burst so a
# recovered seat can be tried this tick. Bypasses the per-tick cap: a wedged
# unit that already paid its RestartSec cost is exactly one new unit.
recover_failed_audit() {
    local repo="$1" candidate="$2" role="$3" unit
    unit=$(unit_name "$repo" "$candidate" "$role")
    log "$repo/#$candidate: $unit is failed — reset-failed + start (fleet-ops#616)"
    if ! "$SYSTEMCTL" --user reset-failed "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: reset-failed $unit FAILED"
        return 1
    fi
    if ! "$SYSTEMCTL" --user start --no-block "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: start $unit FAILED"
        return 1
    fi
    return 0
}

process_escalation() {
    local repo="$1" candidate="$2"
    local missing=0 active=0 failed=0
    local v role unit state

    for role in "${ROLES[@]}"; do
        v=$(vote_path "$repo" "$candidate" "$role")
        if [ -f "$v" ]; then
            # fleet-ops#1424: a SKIP / incomplete vote (e.g. transient provider
            # failure that pi-audit-run wrote as exit 0) is NOT a completed
            # vote -- it counts as neither PASS nor FAIL and wedges the panel
            # at 1-1 forever if left in place. Drop it and re-run that role so
            # the vote is re-collected; the unit template's seat-health
            # preflight re-screens the seat before the next call.
            if vote_is_complete "$v"; then
                continue
            fi
            log "$repo/#$candidate: discarding incomplete/SKIP vote $v; will re-run $role"
            rm -f "$v"
        fi
        unit=$(unit_name "$repo" "$candidate" "$role")
        state=$(unit_state "$unit")
        case "$state" in
            active|activating)
                active=$((active + 1))
                ;;
            failed)
                if recover_failed_audit "$repo" "$candidate" "$role"; then
                    active=$((active + 1))
                else
                    failed=$((failed + 1))
                fi
                ;;
            *)
                missing=$((missing + 1))
                if start_audit "$repo" "$candidate" "$role"; then
                    active=$((active + 1))
                elif [ $? -eq 2 ]; then
                    :
                else
                    failed=$((failed + 1))
                fi
                ;;
        esac
    done

    if [ "$missing" -eq 0 ] && [ "$active" -eq 0 ] && [ "$failed" -eq 0 ]; then
        log "$repo/#$candidate: all votes present, tallying"
        if AUDIT_GH="$GH" "$TALLY_BIN" "$repo" "$candidate"; then
            rm -f "$(pending_stamp "$repo" "$candidate")"
        else
            log "$repo/#$candidate: $TALLY_BIN FAILED"
        fi
        return
    fi

    mark_pending "$repo" "$candidate"
    local age
    age=$(pending_since_s "$repo" "$candidate" 2>/dev/null || echo "")
    if [ -n "$age" ] && [ "$age" -ge "$PENDING_AGE_S" ]; then
        loud "PANEL-PENDING" "repo=$repo candidate=$candidate age_s=$age active=$active missing=$missing failed=$failed — senior escalation panel has not convened"
    else
        log "$repo/#$candidate: panel pending (active=$active missing=$missing failed=$failed)"
    fi
}

main() {
    local candidate
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        process_escalation "$REPO_SLUG" "$candidate" || true
    done < <(escalations 2>/dev/null || true)
}

main
