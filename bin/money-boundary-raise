#!/usr/bin/env bash
# bin/money-boundary-raise — deterministic money-wall raise (fleet-ops#4477)
#
# One callable that does BOTH halves of a FleetProviderSpendBoundary
# escalation IN ONE RUN and IN ORDER, so the MONEY-BOUNDARY ledger line can
# never be skipped while the bench happens — the 2026-09-07/08 defect this
# closes was a worker hand-writing the bench backups but silently dropping
# the NISH-ESCALATIONS.md append (a prompt step, not code, so it was
# droppable; fleet-ops#4477 acceptance 1).
#
# Sequence:
#   1. Class-gate the write (MONEY-BOUNDARY is the sanctioned Nish-reserved
#      class — same allowlist nish-boundary-notify scans to page Nish).
#   2. Dedupe by provider per UTC day: appending a MONEY-BOUNDARY line for a
#      provider that already has a delivered line TODAY is a no-op (one phone
#      ping per wall per day — phone-chokepoint doctrine, fleet-ops#4477
#      acceptance 2).
#   3. Append the ledger line to NISH-ESCALATIONS.md. A bench MUST NOT run
#      without it: if the append does not land (and was not already present
#      today), the script FAIL-LOUDs and aborts before any bench write.
#   4. Bench the provider's cap>0 seat models (lanes/seats/<p>__<m>.json,
#      source=money_boundary, far-future bench_until) and write the
#      spend-boundary-prebench-<ts>/ backup copy, so the ledger append and
#      the bench are one atomic unit.
#
# The alert rule (config/fleet_rules.yml FleetProviderSpendBoundary) tells
# the repair worker to run THIS ONE script instead of hand-doing the two
# steps, which is what makes the write deterministic.
#
# --check mode powers the guard drill (tests/money-boundary-guard.test.sh):
# it reads money_boundary benches and asserts a matching MONEY-BOUNDARY
# ledger line exists for each provider; a missing line exits 1 LOUD. This is
# the fleet-ops#366 mechanical-fix prevention (acceptance 3). --check never
# writes anything.
#
# usage:
#   money-boundary-raise <provider> [spend_today_usd] [credits_remaining_usd]
#   money-boundary-raise --check [--agent-state <dir>] [--since-hours N]
#
# Env overrides (hermetic testing):
#   MONEY_BOUNDARY_AS          agent-state root (default /home/nish/workspaces/agent-state)
#   MONEY_BOUNDARY_NISH        ledger file (default $AS/NISH-ESCALATIONS.md)
#   MONEY_BOUNDARY_SEAT_DIR    benched-seat dir (default $AS/lanes/seats)
#   MONEY_BOUNDARY_BACKUP_DIR  prebench backup parent (default $AS/alert-repair)
#   MONEY_BOUNDARY_CAPS        seat-caps.json for the bench roster
#                               (default ~/.local/state/pi-packet/seat-caps.json)
#   MONEY_BOUNDARY_BENCH_DAYS  far-future bench horizon (default 365)
#   MONEY_BOUNDARY_DRY_RUN     1 = never write; report what would happen
#
# Exit:
#   0  raised / deduped / --check clean
#   1  FAIL-LOUD (missing ledger line before bench, or --check found a gap)
#   2  usage error

set -euo pipefail

AS="${MONEY_BOUNDARY_AS:-/home/nish/workspaces/agent-state}"
NISH="${MONEY_BOUNDARY_NISH:-$AS/NISH-ESCALATIONS.md}"
SEAT_DIR="${MONEY_BOUNDARY_SEAT_DIR:-$AS/lanes/seats}"
BACKUP_PARENT="${MONEY_BOUNDARY_BACKUP_DIR:-$AS/alert-repair}"
CAPS="${MONEY_BOUNDARY_CAPS:-$HOME/.local/state/pi-packet/seat-caps.json}"
BENCH_DAYS="${MONEY_BOUNDARY_BENCH_DAYS:-365}"
DRY_RUN="${MONEY_BOUNDARY_DRY_RUN:-0}"
CHECK_MODE="${MONEY_BOUNDARY_CHECK_MODE:-0}"
SINCE_HOURS="${MONEY_BOUNDARY_SINCE_HOURS:-24}"

# The same allowlist nish-boundary-notify scans to page Nish. Money is the
# class this raise writes; refuse anything else so the script structurally
# cannot leak a non-boundary line into the phone-chokepoint surface.
CLASSES="${MONEY_BOUNDARY_CLASSES:-MONEY-BOUNDARY|LEGAL-BOUNDARY|PRODUCT-DIRECTION|CUSTOMER-DATA|CREDENTIAL-BOUNDARY|ONE-SHOT-PUBLIC-ACTION}"

log() { printf '[money-boundary-raise] %s\n' "$*" >&2; }

usage() {
    cat <<'EOF' >&2
usage: money-boundary-raise <provider> [spend_today_usd] [credits_remaining_usd]
       money-boundary-raise --check [--agent-state <dir>] [--since-hours N]
EOF
    exit 2
}

# --- arg parsing / mode selection ------------------------------------------
if [ "${1:-}" = "--check" ]; then
    CHECK_MODE=1
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent-state) AS="${2:?}"; shift 2 ;;
            --since-hours) SINCE_HOURS="${2:?}"; shift 2 ;;
            *) usage ;;
        esac
    done
    # Recompute derived defaults when AS was overridden.
    NISH="${MONEY_BOUNDARY_NISH:-$AS/NISH-ESCALATIONS.md}"
    SEAT_DIR="${MONEY_BOUNDARY_SEAT_DIR:-$AS/lanes/seats}"
    BACKUP_PARENT="${MONEY_BOUNDARY_BACKUP_DIR:-$AS/alert-repair}"
else
    [ $# -ge 1 ] || usage
    [ $# -le 3 ] || usage
    PROVIDER="$1"
    SPEND="${2:-N/A}"
    CREDITS="${3:-N/A}"
    # No bench roster for N/A or N/A-only — but still valid if one metric is real.
    case "$PROVIDER" in
        --*|-*) usage ;;
        *) ;;
    esac
fi

command -v date >/dev/null 2>&1 || { echo "money-boundary-raise: date required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "money-boundary-raise: jq required (bench roster + json writes)"
    >&2; [ "$CHECK_MODE" -eq 0 ] && exit 1 || true; }

# class_gate_ok <class> — true only for a sanctioned Nish-reserved class.
class_gate_ok() {
    local cls="$1"
    printf '%s\n' "$CLASSES" | tr '|' '\n' | grep -qxF "$cls"
}

# --- mode: guard / --check ------------------------------------------------
# Read money_boundary benches (seat files written under SEAT_DIR) and assert
# every provider benched source=money_boundary has a matching MONEY-BOUNDARY
# ledger line dated today. Missing -> FAIL-LOUD (exit 1). Read-only.
if [ "$CHECK_MODE" -eq 1 ]; then
    if [ ! -d "$SEAT_DIR" ]; then
        # No bench state exists at all -> vacuously clean (nothing to guard).
        echo "money-boundary-raise --check: no seat dir ($SEAT_DIR), vacuous clean"
        exit 0
    fi
    [ -f "$NISH" ] || {
        echo "FAIL: money-boundary-raise --check: ledger missing ($NISH) while seat dir exists" >&2
        exit 1
    }
    now_epoch="$(date -u +%s)"
    cutoff_epoch=$(( now_epoch - SINCE_HOURS * 3600 ))
    fail=0
    # Scan the live benched-seat ledger first.
    if [ -d "$SEAT_DIR" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            hc="$(jq -r '.health_class // empty' "$f" 2>/dev/null || true)"
            src="$(jq -r '.source // empty' "$f" 2>/dev/null || true)"
            [ "$hc" = "quota_bench" ] || continue
            [ "$src" = "money_boundary" ] || continue
            ob="$(jq -r '.observed_at // ""' "$f" 2>/dev/null || true)"
            # Only freshly benched seats (last SINCE_HOURS) are in scope.
            if [ -n "$ob" ]; then
                ob_epoch="$(date -u -d "$ob" +%s 2>/dev/null || echo 0)"
                [ "$ob_epoch" -ge "$cutoff_epoch" ] || continue
            fi
            p="$(jq -r '.provider // empty' "$f" 2>/dev/null || true)"
            [ -n "$p" ] || p="$(basename "$f" | cut -d_ -f1)"
            # Matching MONEY-BOUNDARY provider=<p> line dated today?
            if ! grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T.* MONEY-BOUNDARY provider='"$p"'([[:space:]]|$)' "$NISH"; then
                echo "FAIL-LOUD: seat $f is benched source=money_boundary for provider=<$p> but NISH-ESCALATIONS.md has no MONEY-BOUNDARY provider=<$p> line" >&2
                fail=1
            fi
        done < <(find "$SEAT_DIR" -type f -name '*.json' 2>/dev/null)
    fi
    # Also scan the prebench backup dirs (they carry copies of the benched writes).
    if [ -d "$BACKUP_PARENT" ]; then
        while IFS= read -r d; do
            [ -n "$d" ] || continue
            case "$d" in
                *spend-boundary-prebench-*) ;;
                *) continue ;;
            esac
            while IFS= read -r f; do
                [ -n "$f" ] || continue
                src="$(jq -r '.source // empty' "$f" 2>/dev/null || true)"
                [ "$src" = "money_boundary" ] || continue
                p="$(jq -r '.provider // empty' "$f" 2>/dev/null || true)"
                [ -n "$p" ] || continue
                if ! grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T.* MONEY-BOUNDARY provider='"$p"'([[:space:]]|$)' "$NISH"; then
                    echo "FAIL-LOUD: prebench $f is money_boundary for provider=<$p> but no MONEY-BOUNDARY provider=<$p> ledger line exists" >&2
                    fail=1
                fi
            done < <(find "$d" -maxdepth 1 -type f -name '*.json' 2>/dev/null)
        done < <(find "$BACKUP_PARENT" -maxdepth 1 -type d -name 'spend-boundary-prebench-*' 2>/dev/null)
    fi
    [ "$fail" -eq 0 ] || { echo "money-boundary-raise --check: FAIL-LOUD (missing MONEY-BOUNDARY ledger lines above)" >&2; exit 1; }
    echo "money-boundary-raise --check: clean (every money_boundary seat has a matching ledger line)"
    exit 0
fi

# --- mode: raise ----------------------------------------------------------
class_gate_ok "MONEY-BOUNDARY" || {
    echo "money-boundary-raise: class MONEY-BOUNDARY is not in the sanctioned set" >&2
    exit 1
}
[ "$DRY_RUN" -eq 1 ] || [ -d "$(dirname "$NISH")" ] || {
    echo "money-boundary-raise: agent-state missing: $(dirname "$NISH")" >&2
    exit 1
}

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
today="$(date -u +%Y-%m-%d)"

# Escape the provider for the regex (provider tokens are [A-Za-z0-9._-]).
# A dot is not special in ERE unless used in bracket; treat provider literally
# by matching the exact token.
line="MONEY-BOUNDARY provider=${PROVIDER} spend_today_usd=${SPEND} credits_remaining_usd=${CREDITS} — provider over the USD 5 boundary; only Nish can approve spend (fleet-ops#3284)"
# The deliverer matches the class as the SECOND whitespace field after a
# leading UTC timestamp, so every ledger line carries the ts prefix.
ledger_line="${ts} ${line}"

# --- dedupe: one phone ping per wall per UTC day ---------------------------
# A provider that already has a MONEY-BOUNDARY provider=<p> line dated today
# gets NO second append (dedupe, not silence — the line is already there and
# nish-boundary-notify's seen-mark prevents a re-page).
if [ -f "$NISH" ] && grep -qE "^${today}T.* MONEY-BOUNDARY provider=${PROVIDER}([[:space:]]|\$)" "$NISH"; then
    echo "money-boundary-raise: dedupe — MONEY-BOUNDARY provider=${PROVIDER} already written today (${today}); no second append"
    append_done=1
else
    append_done=0
fi

# --- ledger append FIRST (before any bench write) -------------------------
if [ "$append_done" -eq 0 ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        echo "money-boundary-raise [dry-run]: would append: $ledger_line"
        append_done=1
    else
        # Fail loud if the ledger write cannot land — a bench WITHOUT the
        # Nish phone-ping would re-create the silent-wall defect.
        if ! printf '%s\n' "$ledger_line" >> "$NISH"; then
            echo "FAIL-LOUD: could not append MONEY-BOUNDARY ledger line to $NISH (bench aborted)" >&2
            exit 1
        fi
        if grep -qE "^${today}T.* MONEY-BOUNDARY provider=${PROVIDER}([[:space:]]|\$)" "$NISH"; then
            echo "money-boundary-raise: appended ledger line $ledger_line"
            append_done=1
        else
            echo "FAIL-LOUD: MONEY-BOUNDARY provider=${PROVIDER} still not in $NISH after append (bench aborted)" >&2
            exit 1
        fi
    fi
fi
[ "$append_done" -eq 1 ] || {
    echo "FAIL-LOUD: ledger line missing/invalid for provider=${PROVIDER}; bench aborted" >&2
    exit 1
}

# --- bench the provider's cap>0 seat models --------------------------------
# Roster: .providers.<p>.models in seat-caps.json; every model with cap>0 is
# written to lanes/seats/<p>__<m>.json with source=money_boundary and a
# far-future bench_until (holds until Nish clears, never the ~6h 429 window).
bench_until="$(date -u -d "+${BENCH_DAYS} days" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || date -u +%Y-%m-%dT%H:%M:%SZ)"
written=0
if [ -f "$CAPS" ] && command -v jq >/dev/null 2>&1; then
    models="$(jq -r --arg p "$PROVIDER" '(.providers[$p] // {}) .models // {} | to_entries[] | select(.value.cap > 0) | .key' "$CAPS" 2>/dev/null || true)"
    backup_dir="$BACKUP_PARENT/spend-boundary-prebench-$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$SEAT_DIR" "$backup_dir" 2>/dev/null || true
    for m in $models; do
        [ -n "$m" ] || continue
        # Sanitise the seat filename (provider/model to [A-Za-z0-9._-]).
        if ! printf '%s' "$PROVIDER" | grep -qE '^[A-Za-z0-9._-]+$' \
           || ! printf '%s' "$m" | grep -qE '^[A-Za-z0-9._/:-]+$'; then
            echo "money-boundary-raise: skipping unsanitisable roster entry provider=$PROVIDER model=$m" >&2
            continue
        fi
        safe_m="$(printf '%s' "$m" | tr '/:' '__')"
        fname="${PROVIDER}__${safe_m}.json"
        seat="$SEAT_DIR/$fname"
        backup="$backup_dir/$fname"
        payload=$(jq -n \
            --arg provider "$PROVIDER" \
            --arg model "$m" \
            --arg observed "$ts" \
            --arg bench "$bench_until" \
            '{provider:$provider, model:$model, http_status:null, retry_after:null,
              health_class:"quota_bench", retryable:true, seat_dead:false,
              poison_ladder:false, failure_mode:"quota_cap", source:"money_boundary",
              consecutive_failure_count:0, observed_at:$observed,
              bench_until:$bench, usable_at:$bench,
              writer:"money-boundary-raise"}')
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "money-boundary-raise [dry-run]: would bench $seat"
            printf '%s\n' "$payload" >/dev/null
        else
            printf '%s\n' "$payload" > "$seat"
            # Backup copy — the deterministic prebench that the ledger append
            # was coupled to, so the two can never drift.
            cp "$seat" "$backup"
        fi
        written=$((written + 1))
        echo "money-boundary-raise: benched $seat (money wall, source=money_boundary, +${BENCH_DAYS}d)"
    done
    # Prebench backup dir exists only if we wrote at least one bench.
    if [ "$written" -eq 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        rmdir "$backup_dir" 2>/dev/null || true
    fi
else
    # No caps roster resolvable: the ledger line is still written (it is the
    # phone-ping that matters), but there are no seats benched this run.
    # --check will not flag this (no money_boundary seat exists to guard).
    echo "money-boundary-raise: no seat-caps roster found ($CAPS); ledger line written, no bench"
fi

echo "money-boundary-raise: raised money wall for provider=${PROVIDER} (ledger written first, $written seat(s) benched)"
exit 0
