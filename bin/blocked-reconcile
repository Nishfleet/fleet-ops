#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there. The guard also skips minting when GH is not the literal gh (a test fake is injected, so no human-gh write is possible).
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# blocked-reconcile — re-examine agent-blocked issues (fleet-ops#29).
#
# Named reason this is a sweep, not an event: the blocking condition
# (dependency issue/PR closed or merged, or Nish answering) changes
# outside this repo. The nishfleet-worker GitHub App has no webhooks
# (credentials/app-manifest.json events=[]), so there is nothing to
# subscribe to. Heartbeat's existing 30-minute timer is the observer.
#
# Two cases, both verified live (fleet-ops#364):
#   work-item  — machine-checkable. Explicit `blocked-on:` lines (or a
#                title/body `blocked by #N` / `owner/repo#N` / GitHub URL).
#                Query each listed issue/PR; CLOSED / MERGED = resolved.
#                Struck-through `~~blocked-on: ...~~` body lines are ignored.
#   nish-decision — resolved when a later comment (or body line) carries
#                `decision-resolved:` and has no live `blocked-on:` line.
#                A worker ask that includes a copy-paste example plus
#                `blocked-on: nish-decision` is not an answer (fleet-ops#563).
#                Until then, leave the label and publish into the heartbeat
#                triage file.
# When every listed blocker is resolved, flip agent-blocked → agent-ready
# and comment the evidence. Unparseable issues (no blocked-on lines) stay
# on the desk-triage route and are never auto-requeued.
#
# Bare `#N` mentions in prose are ignored (e.g. "dropped in #937" is
# history, not a blocker). Workers must write `blocked-on:` lines.
#
# Environment (tests override all of these):
#   BLOCKED_RECONCILE_REPOS        newline-separated owner/name list
#   BLOCKED_RECONCILE_INTAKE_JSON  default repo list (intake-repos.json)
#   BLOCKED_RECONCILE_TRIAGE       heartbeat triage file
#   BLOCKED_RECONCILE_STATE        published JSON snapshot
#   BLOCKED_RECONCILE_LOCKDIR      flock directory
#   BLOCKED_RECONCILE_NOW          ISO-8601 UTC clock
#   BLOCKED_RECONCILE_STICKY_SECS  min age before editing last-checked
#                                  comment (default 21600 = 6h)
#   BLOCKED_RECONCILE_DRY_RUN      if 1, print actions and mutate nothing
#
# Modes:
#   --extract   read one issue JSON on stdin, print {kind,deps} (no network)
#   (default)   sweep enrolled repos
#
# Exit 0 on a clean sweep or overlapping no-op. Non-zero only on
# unexpected failure (missing python/jq, unreadable intake file).

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

EXTRACT_PY='
import json, re, sys

NISH = "nish-decision"
ORCHESTRATOR = "orchestrator"
URL = re.compile(
    r"^https://github\.com/([\w.-]+)/([\w.-]+)/(issues|pull)/(\d+)/?$"
)
OWNED = re.compile(r"^([\w.-]+)/([\w.-]+)#(\d+)$")
HASH = re.compile(r"^#(\d+)$")
BLOCKED_ON = re.compile(r"(?im)^blocked-on:\s*(.+?)\s*$")
# Valid nish-decision reasons: money/pay/price/billing, legal, product
# direction/brand, customer data/deletion. Any other use of
# `blocked-on: nish-decision` is rewritten to `blocked-on: orchestrator`.
NISH_REASON = re.compile(
    r"(?i)\b(money|pay|price|billing|legal|brand|deletion|"
    r"product[\s/-]*direction|customer[\s/-]*data)\b"
)
COMMENT_ID_URL = re.compile(r"#issuecomment-(\d+)$")
BLOCKED_BY = re.compile(
    r"(?i)blocked by\s+"
    r"(https://github\.com/[\w.-]+/[\w.-]+/(?:issues|pull)/\d+"
    r"|[\w.-]+/[\w.-]+#\d+"
    r"|#\d+)"
)
SKIP_COMMENT = re.compile(
    r"(?i)^(claimed by |claim branch released|blocked-checked:)"
)
DECISION_RESOLVED = re.compile(r"(?im)^decision-resolved:\s*")
STRUCK_LINE = re.compile(r"^\s*(?:[-*]\s+)?~~.+~~\s*$")


def live_text(text):
    lines = []
    for line in (text or "").splitlines():
        if STRUCK_LINE.match(line):
            continue
        lines.append(line)
    return "\n".join(lines)


def reject_nish_decisions(text):
    """Rewrite invalid `blocked-on: nish-decision` lines to orchestrator.

    A `blocked-on: nish-decision` line is valid only if the same text
    (title, body, or comment) names an allowed reason: money/pay/price/
    billing, legal, product direction/brand, or customer data/deletion.
    Returns (new_text, count_of_rewritten_lines).
    """
    if not BLOCKED_ON.search(text):
        return text, 0
    if NISH_REASON.search(text):
        return text, 0
    count = 0

    def repl(m):
        nonlocal count
        if m.group(1).strip().lower() == NISH:
            count += 1
            return "blocked-on: orchestrator"
        return m.group(0)

    new_text = BLOCKED_ON.sub(repl, text)
    return new_text, count


def comments_have_decision_resolved(comments):
    for c in comments:
        b = (c.get("body") if isinstance(c, dict) else "") or ""
        if SKIP_COMMENT.match(b.lstrip()):
            continue
        live = live_text(b)
        # Instruction comments still carry a live blocked-on: line and a
        # copy-paste decision-resolved: example. Those are not answers.
        if BLOCKED_ON.search(live):
            continue
        if DECISION_RESOLVED.search(live):
            return True
    return False


def parse_ref(raw, owner, repo):
    raw = (raw or "").strip().rstrip(".,;")
    if raw.lower() == ORCHESTRATOR:
        return {"kind": ORCHESTRATOR}
    if raw.lower() == NISH:
        return {"kind": NISH}
    m = URL.match(raw)
    if m:
        return {
            "owner": m.group(1),
            "repo": m.group(2),
            "number": int(m.group(4)),
            "hint": "pr" if m.group(3) == "pull" else "issue",
        }
    m = OWNED.match(raw)
    if m:
        return {
            "owner": m.group(1),
            "repo": m.group(2),
            "number": int(m.group(3)),
            "hint": "unknown",
        }
    m = HASH.match(raw)
    if m:
        return {
            "owner": owner,
            "repo": repo,
            "number": int(m.group(1)),
            "hint": "unknown",
        }
    return None


def add_dep(deps, seen, parsed, owner, repo, self_n):
    if parsed is None or parsed.get("kind") in (NISH, ORCHESTRATOR):
        return parsed is not None and parsed.get("kind") == NISH
    if (
        parsed["owner"] == owner
        and parsed["repo"] == repo
        and parsed["number"] == self_n
    ):
        return False
    key = (parsed["owner"], parsed["repo"], parsed["number"])
    if key in seen:
        return False
    seen.add(key)
    parsed["ref"] = "%s/%s#%s" % (parsed["owner"], parsed["repo"], parsed["number"])
    deps.append(parsed)
    return False


def blocked_by_nodes(issue, owner, repo):
    raw = issue.get("blockedBy") or []
    if isinstance(raw, dict):
        raw = raw.get("nodes") or []
    out = []
    for node in raw:
        if not isinstance(node, dict):
            continue
        repo_field = node.get("repository")
        if isinstance(repo_field, dict):
            nwo = repo_field.get("nameWithOwner") or ""
            o, r = (nwo.split("/", 1) if "/" in nwo else (owner, repo))
        elif isinstance(repo_field, str) and "/" in repo_field:
            o, r = repo_field.split("/", 1)
        else:
            o, r = owner, repo
        item = {
            "owner": o,
            "repo": r,
            "number": int(node["number"]),
            "hint": "issue",
        }
        if node.get("state"):
            item["state"] = str(node["state"]).lower()
        out.append(item)
    return out


def extract(issue):
    repo_full = issue["repo"]
    owner, repo = repo_full.split("/", 1)
    self_n = int(issue["number"])
    title = issue.get("title") or ""
    body = issue.get("body") or ""
    comments = issue.get("comments") or []

    # Resolve nish from the original text first. If the decision is already
    # resolved (decision-resolved: in a comment/body with no live blocked-on:),
    # do not rewrite the nish lines — the issue will requeue naturally.
    live_body = live_text(body)
    nish_resolved = comments_have_decision_resolved(comments)
    if DECISION_RESOLVED.search(live_body) and not BLOCKED_ON.search(live_body):
        nish_resolved = True

    # Reject invalid `blocked-on: nish-decision` lines and build the list
    # of edits to apply. A line is valid only if the same text names an
    # allowed reason: money/pay/price/billing, legal, product direction/
    # brand, or customer data/deletion. Skip rewriting when nish_resolved is
    # already true so a resolved decision stays resolved.
    rejected = []
    rejected_count = 0

    if nish_resolved:
        new_title = live_text(title)
        new_body = live_body
        new_comments = list(comments)
    else:
        new_title, title_rej = reject_nish_decisions(live_text(title))
        if title_rej:
            rejected.append({"where": "title", "new_text": new_title})
            rejected_count += title_rej

        new_body, body_rej = reject_nish_decisions(live_text(body))
        if body_rej:
            rejected.append({"where": "body", "new_text": new_body})
            rejected_count += body_rej

        new_comments = []
        for i, c in enumerate(comments):
            if not isinstance(c, dict):
                new_comments.append(c)
                continue
            b = c.get("body") or ""
            if SKIP_COMMENT.match(b.lstrip()):
                new_comments.append(c)
                continue
            new_b, b_rej = reject_nish_decisions(live_text(b))
            if b_rej:
                url = c.get("url") or ""
                m = COMMENT_ID_URL.search(url)
                cid = m.group(1) if m else ""
                if not cid and str(c.get("id") or "").isdigit():
                    cid = str(c["id"])
                rejected.append({
                    "where": "comment",
                    "index": i,
                    "id": cid,
                    "new_text": new_b,
                })
                rejected_count += b_rej
                new_c = dict(c)
                new_c["body"] = new_b
                new_comments.append(new_c)
            else:
                new_comments.append(c)

    # Resolve nish-decision from the rewritten text. A line now reading
    # `blocked-on: orchestrator` is still a live blocker, so it still
    # suppresses a decision-resolved marker in the same comment/body.
    live_body = live_text(new_body)
    nish_resolved = comments_have_decision_resolved(new_comments)
    if DECISION_RESOLVED.search(live_body) and not BLOCKED_ON.search(live_body):
        nish_resolved = True

    texts = [live_text(new_title), live_body]
    for c in new_comments:
        if not isinstance(c, dict):
            continue
        b = c.get("body") or ""
        if SKIP_COMMENT.match(b.lstrip()):
            continue
        texts.append(live_text(b))

    deps = []
    seen = set()
    nish = False
    orchestrator = False
    for node in blocked_by_nodes(issue, owner, repo):
        add_dep(deps, seen, node, owner, repo, self_n)
    for text in texts:
        for m in BLOCKED_ON.finditer(text):
            parsed = parse_ref(m.group(1), owner, repo)
            if parsed is None:
                nish = True
                continue
            if parsed.get("kind") == ORCHESTRATOR:
                orchestrator = True
                continue
            if add_dep(deps, seen, parsed, owner, repo, self_n):
                nish = True
        for m in BLOCKED_BY.finditer(text):
            parsed = parse_ref(m.group(1), owner, repo)
            if parsed is None:
                nish = True
                continue
            if parsed.get("kind") == ORCHESTRATOR:
                orchestrator = True
                continue
            if add_dep(deps, seen, parsed, owner, repo, self_n):
                nish = True
    nish_unresolved = bool(nish) and not nish_resolved
    kind = NISH if (nish_unresolved or not deps) else "work-item"
    return {
        "kind": kind,
        "deps": deps,
        "nish": bool(nish),
        "nish_resolved": bool(nish_resolved),
        "orchestrator": bool(orchestrator),
        "rejected_count": rejected_count,
        "rejected_nish_decisions": rejected,
    }


def main():
    raw = sys.stdin.read()
    if not raw.strip():
        print(json.dumps({
            "kind": NISH,
            "deps": [],
            "nish": False,
            "nish_resolved": False,
            "orchestrator": False,
            "rejected_count": 0,
            "rejected_nish_decisions": [],
        }))
        return
    print(json.dumps(extract(json.loads(raw)), separators=(",", ":")))


if __name__ == "__main__":
    main()
'

if [ "${1:-}" = "--extract" ]; then
    python3 -c "$EXTRACT_PY"
    exit 0
fi

INTAKE_JSON="${BLOCKED_RECONCILE_INTAKE_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"
TRIAGE="${BLOCKED_RECONCILE_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
STATE="${BLOCKED_RECONCILE_STATE:-/home/nish/.local/state/fleet-heartbeat/blocked-queue.json}"
LOCKDIR="${BLOCKED_RECONCILE_LOCKDIR:-${XDG_RUNTIME_DIR}/blocked-reconcile}"
STICKY_SECS="${BLOCKED_RECONCILE_STICKY_SECS:-21600}"
DRY="${BLOCKED_RECONCILE_DRY_RUN:-0}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PI_PACKET_STATE="${PI_PACKET_STATE:-$HOME/.local/state/pi-packet}"
ATTEMPTS_DIR="$PI_PACKET_STATE/attempts"

log() {
    printf '[%s] [blocked-reconcile] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

now_iso() {
    if [ -n "${BLOCKED_RECONCILE_NOW:-}" ]; then
        printf '%s' "$BLOCKED_RECONCILE_NOW"
    else
        date -u +%Y-%m-%dT%H:%M:%SZ
    fi
}

now_s() {
    date -u -d "$(now_iso)" +%s
}

mkdir -p "$LOCKDIR" "$(dirname "$STATE")" "$(dirname "$TRIAGE")"
exec 9>"$LOCKDIR/sweep.lock"
if ! flock -n 9; then
    log "sweep already running (no-op)"
    echo "no-op: sweep already running"
    exit 0
fi

command -v jq >/dev/null 2>&1 || { log "FATAL: jq missing"; exit 2; }
command -v python3 >/dev/null 2>&1 || { log "FATAL: python3 missing"; exit 2; }

repos=""
if [ -n "${BLOCKED_RECONCILE_REPOS:-}" ]; then
    repos="$BLOCKED_RECONCILE_REPOS"
else
    [ -f "$INTAKE_JSON" ] || { log "FATAL: intake file missing: $INTAKE_JSON"; exit 2; }
    repos=$(jq -r '.repos[].name | "Nishfleet/" + .' "$INTAKE_JSON")
    case "$repos" in
        *Nishfleet/fleet-ops*) ;;
        *) repos=$(printf '%s\nNishfleet/fleet-ops\n' "$repos") ;;
    esac
fi

NOW_ISO=$(now_iso)
NOW_S=$(now_s)
requeued=0
still=0
skipped=0
rejected_nish=0

# remaining_line is accumulated as JSON objects, one per still-blocked issue.
remaining_file=$(mktemp)
trap 'rm -f "$remaining_file"' EXIT
: >"$remaining_file"

extract_issue() {
    printf '%s' "$1" | python3 -c "$EXTRACT_PY"
}

dep_status() {
    local owner="$1" rname="$2" num="$3"
    local issue_json pr_json is_pr state merged pr_state
    if ! issue_json=$(gh api "repos/${owner}/${rname}/issues/${num}" 2>/dev/null); then
        printf '%s' "missing"
        return 0
    fi
    is_pr=$(printf '%s' "$issue_json" | jq -r 'if .pull_request then "yes" else "no" end')
    if [ "$is_pr" = "yes" ]; then
        if ! pr_json=$(gh api "repos/${owner}/${rname}/pulls/${num}" 2>/dev/null); then
            printf '%s' "missing"
            return 0
        fi
        merged=$(printf '%s' "$pr_json" | jq -r '.merged')
        if [ "$merged" = "true" ]; then
            printf '%s' "merged"
            return 0
        fi
        pr_state=$(printf '%s' "$pr_json" | jq -r '.state')
        if [ "$pr_state" = "closed" ]; then
            printf '%s' "closed-unmerged"
            return 0
        fi
        printf '%s' "$pr_state"
        return 0
    fi
    state=$(printf '%s' "$issue_json" | jq -r '.state')
    printf '%s' "$state"
}

is_cleared() {
    case "$1" in
        closed|merged) return 0 ;;
        *) return 1 ;;
    esac
}

upsert_sticky() {
    local repo="$1" num="$2" body="$3"
    local comments_json cid last_s age
    comments_json=$(gh api "repos/${repo}/issues/${num}/comments" 2>/dev/null || echo '[]')
    cid=$(printf '%s' "$comments_json" | jq -r '[.[] | select(.body | startswith("blocked-checked:"))] | .[0].id // empty')
    if [ -n "$cid" ]; then
        last_s=$(printf '%s' "$comments_json" | jq -r --argjson id "$cid" '.[] | select(.id == $id) | .updated_at // .created_at')
        last_s=$(date -u -d "$last_s" +%s 2>/dev/null || echo 0)
        age=$((NOW_S - last_s))
        if [ "$age" -lt "$STICKY_SECS" ]; then
            log "  $repo#$num: sticky comment fresh (${age}s < ${STICKY_SECS}s) — leave"
            return 0
        fi
        if [ "$DRY" = "1" ]; then
            log "DRY $repo#$num: PATCH comment $cid"
            return 0
        fi
        gh api -X PATCH "repos/${repo}/issues/comments/${cid}" -f body="$body" >/dev/null
        return 0
    fi
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: create sticky comment"
        return 0
    fi
    gh issue comment "$num" -R "$repo" --body "$body" >/dev/null
}

requeue_issue() {
    local repo="$1" num="$2" reason="$3"
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: requeue ($reason)"
        return 0
    fi
    gh issue comment "$num" -R "$repo" --body "$reason" >/dev/null
    gh issue edit "$num" -R "$repo" --remove-label agent-blocked --add-label agent-ready >/dev/null
}

apply_rejected_edits() {
    local repo="$1" num="$2" rejected_json="$3"
    local body_new cid cbody

    body_new=$(printf '%s' "$rejected_json" | jq -r '[.[] | select(.where == "body")] | .[0].new_text // empty')
    if [ -n "$body_new" ]; then
        if [ "$DRY" = "1" ]; then
            log "DRY $repo#$num: rewrite body (blocked-on: nish-decision -> orchestrator)"
        else
            gh issue edit "$num" -R "$repo" --body "$body_new" >/dev/null
        fi
    fi

    while IFS= read -r item; do
        [ -z "$item" ] && continue
        cid=$(printf '%s' "$item" | jq -r '.id')
        cbody=$(printf '%s' "$item" | jq -r '.new_text')
        if [ -n "$cid" ] && [ -n "$cbody" ]; then
            if [ "$DRY" = "1" ]; then
                log "DRY $repo#$num: PATCH comment $cid (blocked-on: nish-decision -> orchestrator)"
            else
                gh api -X PATCH "repos/${repo}/issues/comments/${cid}" -f body="$cbody" >/dev/null
            fi
        fi
    done < <(printf '%s' "$rejected_json" | jq -c '.[] | select(.where == "comment")')
}

ensure_orchestrator_label() {
    local repo="$1" num="$2"
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: add needs-orchestrator label"
        return 0
    fi
    gh issue edit "$num" -R "$repo" --add-label needs-orchestrator >/dev/null
}

rewrite_triage() {
    local snapshot="$1"
    python3 - "$TRIAGE" "$snapshot" <<'PY'
import json, os, re, sys
path, snap_s = sys.argv[1], sys.argv[2]
snap = json.loads(snap_s)
start = "<!-- agent-blocked-queue -->"
end = "<!-- /agent-blocked-queue -->"
lines = [
    f"updated: {snap['updated']}",
    f"count: {snap['count']}",
    f"oldest_age_h: {snap.get('oldest_age_h') if snap.get('oldest_age_h') is not None else 'none'}",
    f"oldest: {snap.get('oldest') or 'none'}",
]
for it in snap.get("items", []):
    extra = ""
    if it.get("remaining"):
        extra = " remaining=" + it["remaining"]
    lines.append(f"- {it['ref']} kind={it['kind']} age={it['age_h']}h{extra}")
block = start + "\n" + "\n".join(lines) + "\n" + end + "\n"
existing = ""
if os.path.exists(path):
    with open(path, "r", encoding="utf-8") as f:
        existing = f.read()
pat = re.compile(re.escape(start) + r".*?" + re.escape(end) + r"\n?", re.S)
if pat.search(existing):
    new = pat.sub(block, existing, count=1)
else:
    if existing and not existing.endswith("\n"):
        existing += "\n"
    new = existing + ("\n" if existing else "") + block
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    f.write(new)
PY
}

# fleet-ops#3310/#3527: per-issue difficulty mirror of pi-intake-tick's logic.
# Defaults are the same as the tick; test overrides via env.
DIFFICULTY_HEAVY_BODY_BYTES="${PI_INTAKE_DIFFICULTY_HEAVY_BODY_BYTES:-6000}"
DIFFICULTY_HEAVY_REQUIRED="${PI_INTAKE_DIFFICULTY_HEAVY_REQUIRED:-2}"

issue_difficulty() {
    local labels_json="$1" title="$2" body="$3" lowered bytes req
    lowered="${title,,}"
    if [[ "$labels_json" == *'"keystone"'* || "$lowered" == keystone:* ]]; then echo "keystone"; return; fi
    if [[ "$labels_json" == *'"heavy"'* ]]; then echo "heavy"; return; fi
    bytes=$(printf '%s' "$body" | wc -c); bytes=${bytes//[^0-9]/}
    req=$(printf '%s\n' "$body" | grep -ciE '^[[:space:]]*-[[:space:]]*required[^:]*:' || true)
    if (( ${bytes:-0} > DIFFICULTY_HEAVY_BODY_BYTES )) || (( ${req:-0} > DIFFICULTY_HEAVY_REQUIRED )); then
        echo "heavy"; return
    fi
    echo "light"
}

# fleet-ops#3310/#3527: latest live blocked-on: <marker> timestamp from the
# issue body or a non-struck comment. Returns empty if none.
latest_live_blocked_on_ts() {
    local view_json_text="$1" marker="$2"
    python3 - "$view_json_text" "$marker" <<'PY'
import json, re, sys
text, marker = sys.argv[1], sys.argv[2]
pat = re.compile(r"(?im)^blocked-on:\s*" + re.escape(marker) + r"\s*$")
struck = re.compile(r"^\s*(?:[-*]\s+)?~~.+~~\s*$")
issue = json.loads(text)
latest = None

def is_live(body):
    return bool(pat.search("\n".join(
        line for line in (body or "").splitlines() if not struck.match(line)
    )))

def consider(ts, body):
    global latest
    if not ts or not is_live(body):
        return
    if latest is None or ts > latest:
        latest = ts

consider(issue.get("createdAt"), issue.get("body"))
for c in issue.get("comments") or []:
    consider(c.get("createdAt"), c.get("body"))
print(latest or "")
PY
}

# fleet-ops#3310/#3527: count previous infra-block auto-releases within 24h.
# The marker is in the release comment body.
count_recent_infra_releases() {
    local view_json_text="$1" now_s="$2"
    local cutoff=$(( now_s - 86400 ))
    local count=0 ts ts_s
    while IFS= read -r ts; do
        [[ -n "$ts" ]] || continue
        ts_s=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
        [[ "$ts_s" =~ ^[0-9]+$ ]] || continue
        if (( ts_s >= cutoff )); then
            count=$((count + 1))
        fi
    done < <(printf '%s' "$view_json_text" | jq -r '[.comments[]? // [] | select(.body | test("blocked-reconcile: infra-block released"; "i")) | .createdAt] | .[]')
    echo "$count"
}

# fleet-ops#3310/#3527: dry-run pick_seat with a temp state dir so no real
# selection is recorded; verify the returned seat is actually healthy and
# capable for the issue's difficulty. Prints "provider/model" and returns 0
# if a healthy capable seat exists, 1 otherwise.
# shellcheck disable=SC2030,SC2031
# The two $(...) subshells below deliberately export PI_PACKET_STATE/HOME into
# a throwaway scope so seat-lib writes land in a temp dir, never the live state.
healthy_capable_seat_for_issue() {
    local difficulty="$1"
    local need_capable=0
    [[ "$difficulty" == "heavy" || "$difficulty" == "keystone" ]] && need_capable=1
    local _state _out _p _m _seat
    _state=$(mktemp -d)
    mkdir -p "$_state/active-seats"
    # Re-use live active-seats so the cap check is realistic; all other writes
    # (prepaid-usage, seat-selection.jsonl, keystone-events) stay in the temp.
    if [[ -d "$PI_PACKET_STATE/active-seats" ]]; then
        cp -R "$PI_PACKET_STATE/active-seats/"* "$_state/active-seats/" 2>/dev/null || true
    fi
    _out=$(
        export PI_PACKET_STATE="$_state"
        export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        export HOME="${HOME:-/home/nish}"
        source "$REPO_ROOT/lib/seat-lib.sh"
        pick_seat "" "" "$need_capable" "" "$difficulty" public 2>/dev/null || true
    )
    rm -rf "$_state"
    [[ -n "$_out" ]] || return 1
    _p="${_out%%$'\t'*}"
    _m="${_out#*$'\t'}"
    [[ -n "$_p" && -n "$_m" ]] || return 1
    _state=$(mktemp -d)
    _seat=$(
        export PI_PACKET_STATE="$_state"
        source "$REPO_ROOT/lib/seat-lib.sh"
        if seat_usable "$_p" "$_m" >/dev/null 2>&1; then
            printf '%s/%s' "$_p" "$_m"
        fi
    )
    rm -rf "$_state"
    [[ -n "$_seat" ]] || return 1
    printf '%s\n' "$_seat"
}

# fleet-ops#3310/#3527: reset the WORK cap and systemic-failure markers so the
# re-queued issue gets a fresh claim budget.
reset_reclaim_and_systemic() {
    local repo="$1" num="$2"
    local inst="${repo#*/}-${num}"
    # shellcheck disable=SC2031
    # ATTEMPTS_DIR is only re-assigned inside the isolated subshell of the
    # picker above (fleet-ops#3310); the global value is unchanged here.
    rm -f "$ATTEMPTS_DIR/pi-issue-${inst}.reclaim-count" \
          "$ATTEMPTS_DIR/pi-issue-${inst}.systemic" 2>/dev/null || true
}

log "sweep starting now=$NOW_ISO"

while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    log "repo $repo"
    if ! list_json=$(gh issue list -R "$repo" -l agent-blocked --state open \
        --json number,title,createdAt,labels --limit 100 2>/dev/null); then
        log "  $repo: gh issue list FAILED — skip"
        continue
    fi

    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        created=$(printf '%s' "$row" | jq -r '.createdAt')
        in_progress=$(printf '%s' "$row" | jq -r '[.labels[].name] | if index("agent-in-progress") then "yes" else "no" end')
        if [ "$in_progress" = "yes" ]; then
            log "  $repo#$num: also agent-in-progress — skip"
            skipped=$((skipped + 1))
            continue
        fi

        if ! view_json=$(gh issue view "$num" -R "$repo" --json title,body,createdAt,comments,labels 2>/dev/null); then
            log "  $repo#$num: gh issue view FAILED — skip"
            skipped=$((skipped + 1))
            continue
        fi

        payload=$(printf '%s' "$view_json" | jq --arg repo "$repo" --argjson n "$num" \
            '{repo:$repo, number:$n, title:.title, body:.body, comments:.comments}')
        owner="${repo%%/*}"
        rname="${repo#*/}"
        if blocked_json=$(gh api graphql -f query='query($o:String!,$n:String!,$num:Int!){repository(owner:$o,name:$n){issue(number:$num){blockedBy(first:20){nodes{number state repository{nameWithOwner}}}}}}' \
            -f o="$owner" -f n="$rname" -F num="$num" 2>/dev/null); then
            payload=$(printf '%s' "$payload" | jq --argjson g "$blocked_json" \
                '. + {blockedBy: (($g.data.repository.issue.blockedBy.nodes) // [])}')
        fi
        extracted=$(extract_issue "$payload")
        kind=$(printf '%s' "$extracted" | jq -r '.kind')
        rejected_count=$(printf '%s' "$extracted" | jq -r '.rejected_count // 0')
        rejected_json=$(printf '%s' "$extracted" | jq -c '.rejected_nish_decisions // []')
        orchestrator=$(printf '%s' "$extracted" | jq -r '.orchestrator // false')

        if [ "$rejected_count" -gt 0 ]; then
            apply_rejected_edits "$repo" "$num" "$rejected_json"
            ensure_orchestrator_label "$repo" "$num"
            rejected_nish=$((rejected_nish + rejected_count))
            log "  $repo#$num: rejected $rejected_count nish-decision line(s); relabelled needs-orchestrator"
        fi

        created_s=$(date -u -d "$created" +%s 2>/dev/null || echo 0)
        age_h=0
        if [ "$created_s" -gt 0 ]; then
            age_h=$(( (NOW_S - created_s) / 3600 ))
        fi

        action="still-blocked"
        remaining=""
        cleared=""
        all_cleared=1
        machine=0
        nish_flag=$(printf '%s' "$extracted" | jq -r '.nish // false')
        nish_resolved=$(printf '%s' "$extracted" | jq -r '.nish_resolved // false')

        while IFS= read -r dep; do
            [ -z "$dep" ] && continue
            machine=1
            d_owner=$(printf '%s' "$dep" | jq -r '.owner')
            d_repo=$(printf '%s' "$dep" | jq -r '.repo')
            d_num=$(printf '%s' "$dep" | jq -r '.number')
            d_ref=$(printf '%s' "$dep" | jq -r '.ref')
            st=$(printf '%s' "$dep" | jq -r '.state // empty')
            if [ -z "$st" ]; then
                st=$(dep_status "$d_owner" "$d_repo" "$d_num")
            fi
            if is_cleared "$st"; then
                if [ -n "$cleared" ]; then
                    cleared="$cleared, ${d_ref} (${st})"
                else
                    cleared="${d_ref} (${st})"
                fi
            else
                all_cleared=0
                if [ -n "$remaining" ]; then
                    remaining="$remaining, ${d_ref} (${st})"
                else
                    remaining="${d_ref} (${st})"
                fi
            fi
        done < <(printf '%s' "$extracted" | jq -c '.deps[]')

        if [ "$nish_flag" = "true" ] || [ "$nish_resolved" = "true" ]; then
            machine=1
            if [ "$nish_resolved" = "true" ]; then
                if [ -n "$cleared" ]; then
                    cleared="$cleared, nish-decision (decision-resolved)"
                else
                    cleared="nish-decision (decision-resolved)"
                fi
            else
                all_cleared=0
                if [ -n "$remaining" ]; then
                    remaining="$remaining, nish-decision"
                else
                    remaining="nish-decision"
                fi
            fi
        fi

        if [ "$orchestrator" = "true" ]; then
            machine=1
            all_cleared=0
            if [ -n "$remaining" ]; then
                remaining="$remaining, orchestrator"
            else
                remaining="orchestrator"
            fi
        fi

        # fleet-ops#3310/#3527: handle blocked-on: infra and blocked-on: senior-review.
        # Infra blocks are auto-released after 2h when a healthy capable seat
        # exists; a second release within 24h escalates to senior-review.
        _infra_ts=$(latest_live_blocked_on_ts "$view_json" "infra")
        _senior_ts=$(latest_live_blocked_on_ts "$view_json" "senior-review")
        _infra_age_s=0
        _infra_age_h=0
        if [ -n "$_infra_ts" ]; then
            _infra_epoch=$(date -u -d "$_infra_ts" +%s 2>/dev/null || echo 0)
            _infra_age_s=$((NOW_S - _infra_epoch))
            _infra_age_h=$((_infra_age_s / 3600))
        fi
        _senior_epoch=0
        _senior_age_s=0
        if [ -n "$_senior_ts" ]; then
            _senior_epoch=$(date -u -d "$_senior_ts" +%s 2>/dev/null || echo 0)
            _senior_age_s=$((NOW_S - _senior_epoch))
        fi
        _infra_block=0
        _senior_block=0
        if [ -n "$_senior_ts" ] && { [ -z "$_infra_ts" ] || [ "$_senior_epoch" -ge "$_infra_epoch" ]; }; then
            _senior_block=1
        elif [ -n "$_infra_ts" ]; then
            _infra_block=1
        fi

        if [ "$_senior_block" -eq 1 ]; then
            kind="senior-review"
            machine=1
            all_cleared=0
            remaining="senior-review"
        elif [ "$_infra_block" -eq 1 ]; then
            kind="infra"
            machine=1
            all_cleared=0
            if [ -n "$_infra_ts" ] && [ "$_infra_age_s" -ge 7200 ]; then
                _recent_releases=$(count_recent_infra_releases "$view_json" "$NOW_S")
                if [ "$_recent_releases" -ge 1 ]; then
                    # Second infra release within 24h: escalate to senior-review.
                    kind="senior-review"
                    remaining="senior-review (escalated from infra after second release within 24h)"
                    _escalate_body="fleet-ops#3310/#3527: this issue was auto-released from an infra block within the last 24h and is now blocked again. A second release is not safe; escalating to senior review.

blocked-on: senior-review"
                    if [ "$DRY" = "1" ]; then
                        log "DRY $repo#$num: escalate infra -> senior-review (second release within 24h)"
                    else
                        gh issue comment "$num" -R "$repo" --body "$_escalate_body" >/dev/null
                    fi
                    log "  $repo#$num: ESCALATED infra -> senior-review (second release within 24h)"
                    sticky="blocked-checked: ${NOW_ISO} still-blocked kind=${kind} age=${age_h}h remaining=${remaining}"
                    upsert_sticky "$repo" "$num" "$sticky"
                    still=$((still + 1))
                    jq -nc --arg ref "${repo}#${num}" --arg kind "$kind" --argjson age "$age_h" \
                        --arg remaining "$remaining" \
                        '{ref:$ref, kind:$kind, age_h:$age, remaining:$remaining}' >>"$remaining_file"
                    continue
                fi

                # Aged infra block: re-queue if a healthy capable seat exists.
                _labels_json=$(printf '%s' "$view_json" | jq -c '.labels // []')
                _title=$(printf '%s' "$view_json" | jq -r '.title // ""')
                _body=$(printf '%s' "$view_json" | jq -r '.body // ""')
                _difficulty=$(issue_difficulty "$_labels_json" "$_title" "$_body")
                _seat=$(healthy_capable_seat_for_issue "$_difficulty" 2>/dev/null || true)
                if [ -n "$_seat" ]; then
                    reset_reclaim_and_systemic "$repo" "$num"
                    _reason="fleet-ops#3310/#3527: infra block aged ${_infra_age_h}h and a healthy capable seat exists (${_seat}). Re-claiming should now use a recovered seat instead of parking. Re-set reclaim-count and .systemic; re-queued as agent-ready.

blocked-reconcile: infra-block released at ${NOW_ISO}"
                    if [ "$DRY" = "1" ]; then
                        log "DRY $repo#$num: requeue infra block (aged ${_infra_age_h}h, seat ${_seat})"
                    else
                        requeue_issue "$repo" "$num" "$_reason"
                    fi
                    log "  $repo#$num: REQUEUED infra block (aged ${_infra_age_h}h, seat ${_seat})"
                    requeued=$((requeued + 1))
                    continue
                else
                    remaining="infra (no healthy capable seat for ${_difficulty})"
                fi
            else
                remaining="infra (too young: ${_infra_age_h}h < 2h)"
            fi
        fi

        if [ "$machine" -eq 0 ]; then
            all_cleared=0
        fi
        if [ "$all_cleared" -eq 1 ]; then
            action="requeue"
        fi

        if [ "$action" = "requeue" ]; then
            reason="blocker cleared: ${cleared}. Re-queued as agent-ready."
            requeue_issue "$repo" "$num" "$reason"
            log "  $repo#$num: REQUEUED ($cleared)"
            requeued=$((requeued + 1))
            continue
        fi

        sticky="blocked-checked: ${NOW_ISO} still-blocked kind=${kind} age=${age_h}h"
        if [ -n "$remaining" ]; then
            sticky="${sticky} remaining=${remaining}"
        fi
        upsert_sticky "$repo" "$num" "$sticky"
        log "  $repo#$num: still-blocked kind=$kind age=${age_h}h ${remaining}"
        still=$((still + 1))
        jq -nc --arg ref "${repo}#${num}" --arg kind "$kind" --argjson age "$age_h" \
            --arg remaining "$remaining" \
            '{ref:$ref, kind:$kind, age_h:$age, remaining:$remaining}' >>"$remaining_file"
    done < <(printf '%s' "$list_json" | jq -c '.[]')
done <<< "$repos"

items_json=$(if [ -s "$remaining_file" ]; then jq -s '.' "$remaining_file"; else echo '[]'; fi)
count=$(printf '%s' "$items_json" | jq 'length')
oldest=$(printf '%s' "$items_json" | jq -r 'if length==0 then empty else max_by(.age_h) | .ref end')
oldest_age=$(printf '%s' "$items_json" | jq -r 'if length==0 then empty else max_by(.age_h) | .age_h end')

snapshot=$(jq -nc --arg updated "$NOW_ISO" --argjson count "$count" \
    --arg oldest "${oldest:-}" --arg oldest_age "${oldest_age:-}" \
    --argjson items "$items_json" --argjson rejected_nish "$rejected_nish" \
    '{
      updated:$updated,
      count:$count,
      oldest: (if $oldest == "" then null else $oldest end),
      oldest_age_h: (if $oldest_age == "" then null else ($oldest_age|tonumber) end),
      items:$items,
      rejected_nish_decisions:$rejected_nish
    }')

if [ "$DRY" != "1" ]; then
    printf '%s\n' "$snapshot" >"$STATE"
    rewrite_triage "$snapshot"
fi

log "sweep done: still=$still requeued=$requeued skipped=$skipped rejected_nish=$rejected_nish count=$count oldest=${oldest:-none} oldest_age_h=${oldest_age:-none}"
printf 'blocked-queue count=%s oldest_age_h=%s oldest=%s requeued=%s rejected_nish=%s\n' \
    "$count" "${oldest_age:-none}" "${oldest:-none}" "$requeued" "$rejected_nish"
exit 0
