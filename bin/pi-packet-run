#!/usr/bin/env bash
# pi-packet-run — seat-rotation wrapper for pi-packet retry units.
#
# This is the ExecStart of a systemd-managed retry unit. systemd handles the
# retry ladder natively (Restart=/RestartSec=/RestartSteps=/StartLimitBurst=),
# so this script does ONLY what systemd cannot:
#
#   1. Pick a DIFFERENT seat on each restart (systemd restarts the same
#      ExecStart, so seat rotation is real added value — see seat-lib.sh).
#   2. No-op detection: if pi exits 0 but produced no real output (< 256 bytes
#      to stdout), exit non-zero so systemd's Restart= treats it as a failure
#      and re-seats. This folds the old pi-packet-noop-detect script into the
#      retry unit itself. WatchdogSec was evaluated and rejected: it only fires
#      when the process is STILL RUNNING but hasn't sent WATCHDOG=1; a no-op
#      exits 0 quickly, so WatchdogSec never fires. Converting a no-op to a
#      non-zero exit is the honest fix.
#
# What this script does NOT do (systemd handles it):
#   - Retry counting (StartLimitBurst=)
#   - Cooldown/backoff (RestartSec=/RestartSteps=)
#   - Hang detection (RuntimeMaxSec=)
#   - Escalation on exhaustion (OnFailure= -> pi-packet-escalate@<pid>.service)
#   - Preventing resurrection of a deliberately-stopped unit (systemd's
#     Restart= does not fire when the stop was a systemd operation)
#
# Args (all required):
#   $1 = packet file path (fed to pi on stdin)
#   $2 = workdir
#   $3 = original failed provider (for first-seat exclusion)
#   $4 = original failed model
#
# Environment:
#   PI_PACKET_RUN_OUT_MIN — minimum stdout bytes for "real work" (default 256).
#   If pi exits 0 but stdout < this, the wrapper exits 1 (no-op).
#
# Exit codes:
#   0 = pi ran and produced real output (success — systemd will not restart)
#   1 = pi failed, OR pi exited 0 but produced no output (no-op)
#        -> systemd Restart=on-failure re-runs this script, which picks a
#           different seat. After StartLimitBurst, OnFailure= escalates.
#
# Never notifies Nish. No email, no chat. Only repairs or fails for escalation.

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HOME="${HOME:-/home/nish}"

# Source shared seat logic.
SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
# shellcheck source=../lib/seat-lib.sh source-path=SCRIPTDIR
source "$SEAT_LIB"

# fleet-ops#3125: packet work is PRODUCT work — pick_seat orders candidates
# by the rolling PR-yield ledger when seat-caps product_order is "yield".
export PI_PICK_ROLE=product

OUT_MIN="${PI_PACKET_RUN_OUT_MIN:-256}"

[[ $# -ge 4 ]] || { echo "pi-packet-run: need 4 args: packet workdir fail_prov fail_model" >&2; exit 1; }
pkt="$1"
wd="$2"
fail_p="$3"
fail_m="$4"

[[ -f "$pkt" ]] || { echo "pi-packet-run: packet not found: $pkt" >&2; exit 1; }
[[ -d "$wd" ]] || wd="$HOME"

pid=$(packet_id_from_path "$pkt")
tried_file="$ATTEMPTS_DIR/$pid.tried-seats"
out_file="${pkt%/*}/${pid}.run.out"
err_file="${pkt%/*}/${pid}.run.err"

# --- pick a different seat than all previously tried ---------------------------
weight=$(task_weight "$pkt")
difficulty="$weight"
if declare -F packet_difficulty >/dev/null 2>&1; then
    difficulty=$(packet_difficulty "$pkt")
fi
need_capable=0
[[ "$difficulty" == "heavy" || "$difficulty" == "keystone" ]] && need_capable=1

# Free-tier privacy line (fleet-ops#520): a private-repo target never routes
# to a free-class lane. Derive the repo from the packet's TARGET line and
# resolve its visibility via config/repo-privacy.json (fail-closed).
pkt_repo=$(packet_repo "$pkt")
pkt_privacy="public"
if [[ -n "$pkt_repo" ]]; then
    pkt_privacy=$(repo_privacy "$pkt_repo")
fi
seat_log "pi-packet-run: $pid target repo=${pkt_repo:-<none>} privacy=$pkt_privacy"
# fleet-ops#3724: the packet repo also feeds pick_seat's product_only gate —
# a seat flagged product_only in seat-caps.json is offered only when this
# repo carries the product flag in config/intake-repos.json.
export PI_PACKET_REPO="${pkt_repo:-}"

seat=$(pick_seat "$fail_p" "$fail_m" "$need_capable" "$tried_file" "$difficulty" "$pkt_privacy" || true)
if [[ -z "$seat" ]]; then
    if [[ "$difficulty" == "keystone" ]]; then
        seat_log "pi-packet-run: KEYSTONE ESCALATION for $pid (tried: $(tr '\n' ' ' < "$tried_file" 2>/dev/null || true)) — exiting 1 so OnFailure summons senior conference"
    else
        seat_log "pi-packet-run: no alternate seat for $pid (tried: $(tr '\n' ' ' < "$tried_file" 2>/dev/null || true)) — exiting 1 so OnFailure escalates"
    fi
    exit 1
fi

np=$(printf '%s' "$seat" | cut -f1)
nm=$(printf '%s' "$seat" | cut -f2)

# Record this seat as tried BEFORE running, so a concurrent restart cannot
# pick the same one. Append "provider/model" per line.
printf '%s/%s\n' "$np" "$nm" >>"$tried_file"

seat_log "pi-packet-run: $pid running on $np/$nm (weight=$difficulty, tried: $(wc -l < "$tried_file") seat(s))"

# --- run pi, capture stdout/stderr --------------------------------------------
# pi reads the packet from stdin. We capture stdout to measure output size
# for no-op detection. stderr goes to the err file for the council packet.
rc=0
"$PI_BIN" --print --provider "$np" --model "$nm" < "$pkt" >"$out_file" 2>"$err_file" || rc=$?

if (( rc != 0 )); then
    seat_log "pi-packet-run: $pid pi exited $rc on $np/$nm — systemd will restart with a new seat"
    exit 1
fi

# --- no-op detection: exit 0 with trivial output -> exit 1 --------------------
out_bytes=0
[[ -f "$out_file" ]] && out_bytes=$(wc -c < "$out_file" 2>/dev/null || echo 0)
out_bytes=${out_bytes//[^0-9]/}; out_bytes=${out_bytes:-0}

if (( out_bytes < OUT_MIN )); then
    seat_log "pi-packet-run: $pid pi exited 0 but stdout=${out_bytes}B (< ${OUT_MIN}B) — no-op, exiting 1 so systemd re-seats"
    exit 1
fi

# Success: this tick is complete. Clear the tried-seats file so the NEXT
# tick (timer-fired or manual) starts with a fresh seat rotation. Without
# this, stale entries from a past restart storm permanently block every
# seat and the unit can never recover — every future tick hits "no
# alternate seat" and exits 1. The tried-seats file is an intra-tick
# rotation mechanism; it must not outlive a successful tick.
rm -f "$tried_file" 2>/dev/null || true
seat_log "pi-packet-run: $pid SUCCESS on $np/$nm (${out_bytes}B output)"
exit 0
