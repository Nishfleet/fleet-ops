#!/usr/bin/env bash
# nish-boundary-notify — delivers the Nish-RESERVED escalation class out of
# NISH-ESCALATIONS.md and into an actual message.
#
# Named reason: the SENIOR-AUDITOR layer summons AGENTS, never Nish. Anything
# an agent may not decide (money, legal, product direction, customer-data
# deletion) lands in NISH-ESCALATIONS.md — which nothing read. On 2026-08-25
# a MONEY-BOUNDARY ("both prepaid seats hit payment walls, NISH DECISION
# NEEDED") sat unread for 11h. This closes that, and ONLY that: routine faults
# still go to auditors and never text him.
#
# It delivers BOTH shapes agents actually append: the canonical one-line form
# (`<ISO-ts> <CLASS> slug — summary`) AND prose sections (`## YYYY-MM-DD — …`
# with a NISH ACTION / NISH DECISION NEEDED bullet). Before fleet-ops#4048 the
# parser only matched the timestamp shape, so prose escalations sat dark while
# the unit exited 0. The prose-scan detector (below) ensures reserved-class
# prose dated after the last delivered entry is never a silent green run.
set -euo pipefail
AS=${UNIT_ESCALATION_AGENT_STATE:-/home/nish/workspaces/agent-state}
FILE="$AS/NISH-ESCALATIONS.md"
SEEN="$AS/lanes/nish-boundary-notify.seen"
CLASSES='MONEY-BOUNDARY|LEGAL-BOUNDARY|PRODUCT-DIRECTION|CUSTOMER-DATA|CREDENTIAL-BOUNDARY|ONE-SHOT-PUBLIC-ACTION'

## ---- Subcommands (fleet-ops#4476 part 3) -----------------------------------
# nish-boundary-notify is normal the path-triggered delivery rail (no args).
# The question path adds three on-demand interfaces:
#   --dry-run   list confirmed question issues only (never a send) -- proves
#               gate-confirmed-only before anything reaches MySQL phone.
#   --digest    one Telegram line per 6h listing ALL unanswered confirmed
#               questions with age (throttled 1 per 6h in a state marker).
#   --help      usage.
MODE="${1:-}"

# --- Delivery: retry hermes (single phone path) -----------------------------
#
# fleet-ops#1458: on 2026-08-28 the Nish-reserved channel delivered 7h late
# during an active Grok-401 incident. The 00:12/00:15 IST runs exited 1 with
# no output — the seats= grep abort (fixed by #1349) killed the send before
# it fired. But even after that fix, the only "retry" was "next tick", and the
# .path unit only fires on PathChanged — so a genuine hermes failure (outbound
# gate, network, binary gone) left the entry undelivered until the file was
# touched again, hours later. This block closes that gap:
#
#   1. Retry hermes send up to 3 times (0s, 5s, 15s backoff).
#   2. Only mark the entry seen after a confirmed delivery.
#   3. If hermes is still down, exit 1 so OnFailure summons an auditor — a
#      truly dead channel is the one thing that must be loud.
#
# fleet-ops#4145: the direct Telegram Bot API fallback that used to sit here
# was retired with the hand-built claude-telegram-bridge.py. Hermes is now the
# single phone path (the other gate is alertmanager severity=page). A hermes
# outage no longer has a bypass; it is loud (exit 1) instead, and the auditor
# OnFailure summons owns the repair. The bridge's bot token is gone, so the
# old fallback would have read a dead env anyway.
#
# Env overrides (for the drill test):
#   BOUNDARY_NOTIFY_HERMES = path to the hermes binary (default: hermes from PATH)
#   BOUNDARY_NOTIFY_BACKOFF = space-separated sleep seconds between hermes retries
HERMES_BIN=${BOUNDARY_NOTIFY_HERMES:-hermes}
BACKOFFS=${BOUNDARY_NOTIFY_BACKOFF:-"5 15"}
GH=${BOUNDARY_NOTIFY_GH:-${GH:-gh}}
INTAKE_JSON="${FLEET_INTAKE_REPOS_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"

# deliver <key> <header-line> <body> <class>
# Tries hermes (with retries). Marks the entry seen on success. Returns
# non-zero only if hermes is exhausted (OnFailure summons an auditor).
# <class> is the Nish-reserved boundary token (MONEY-BOUNDARY, ...) matched
# from the entry line; it is passed to hermes as --class so the outbound
# gate's urgent class-gate honours the bypass (fleet-ops#1534).
deliver() {
  local key="$1" header="$2" body="$3" class="$4"
  local msg="NEEDS YOU — only you can decide this:

$body

Full log: $FILE"
  local attempt=0

  # --- hermes with retries ---------------------------------------------------
  for backoff in 0 $BACKOFFS; do
    if [ "$backoff" -gt 0 ] 2>/dev/null; then
      echo "retry: hermes send attempt $((attempt+1)) after ${backoff}s backoff" >&2
      sleep "$backoff" 2>/dev/null || true
    fi
    attempt=$((attempt+1))
    if "$HERMES_BIN" send -t telegram --urgent --class "$class" "$msg" </dev/null >/dev/null 2>&1; then
      printf '%s\n' "$key" >> "$SEEN"
      echo "delivered (hermes, attempt $attempt): $header"
      return 0
    fi
    echo "hermes send attempt $attempt failed" >&2
  done

  echo "DELIVERY FAILED (hermes exhausted after $attempt attempts): $header" >&2
  return 1
}

# fleet-ops#4474 (part 1: one store): the Nish store is an open `question`
# issue whose body carries `blocked-on: nish-decision` + a `question:`/
# `options:` line. A CONFIRMED question (labelled `nish-reserved` or
# `conference-approved` after the senior conference gate) is the ONLY thing
# that may reach Nish's phone. This replaces the out-of-band NISH-ESCALATIONS.md
# as the source of truth: read confirmed questions across the enrolled repos
# and deliver each via hermes (deduped by $SEEN). NISH-ESCALATIONS.md rows are
# migrated into `question` issues; the .md below becomes an archive.
enrolled_repos() {
    if [ -f "$INTAKE_JSON" ]; then
        jq -r '.repos[]?.name' "$INTAKE_JSON" 2>/dev/null || true
    fi
}

# Emit one line per confirmed question:
#   repo\tnumber\tissue_url\ttitle\tquestion\toptions\tcreatedAt
# These are the ONLY questions that may reach the phone (gate-confirmed,
# labelled nish-reserved or conference-approved).
confirmed_questions() {
    local repo
    while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        local out
        out=$("$GH" issue list -R "Nishfleet/$repo" -l nish-reserved,conference-approved --state open --json number,title,body,createdAt 2>/dev/null) || continue
        printf '%s\n' "$out" | jq -r --arg repo "$repo" '.[] | [
          $repo,
          (.number|tostring),
          ("https://github.com/Nishfleet/" + $repo + "/issues/" + (.number|tostring)),
          .title,
          ((.body // "") | split("\n")[] | select(test("^question:")) | sub("^question:[[:space:]]*"; "")),
          ((.body // "") | split("\n")[] | select(test("^options:")) | sub("^options:[[:space:]]*"; "")),
          (.createdAt // "")
        ] | @tsv'
    done < <(enrolled_repos)
}

# The handle Hermes / a Claude session parses to post `decision-resolved:`
# (fleet-ops#4476 part 3 answer ingestion). One handle per question, unique:
#   Q:<repo>#<issue-number>
q_handle() { printf 'Q:%s#%s' "$1" "$2"; }

# Age of an ISO-8601 GitHub createdAt in whole hours (0 if unparseable).
q_age_h() {
    local iso="$1" ep now age
    now="$(date -u +%s 2>/dev/null || echo 0)"
    ep="$(date -u -d "$iso" +%s 2>/dev/null || echo 0)"
    age=0
    if [ "$ep" -gt 0 ] 2>/dev/null && [ "$now" -gt 0 ] 2>/dev/null; then
        age=$(( (now - ep) / 3600 ))
    fi
    printf '%s' "$age"
}

# fleet-ops#4892: true (0) if issue <repo>#<num> has a comment starting with
# `decision-resolved:` — the canonical "this question is answered" marker
# (the judge's DECISION, or Nish's close-out). A confirmed question that is
# resolved must not be (re-)delivered, even if it is still open + nish-reserved
# (the judge forgot to remove the label — the lifecycle-label-sweep backstop
# removes it next tick). Fail-open: an unreadable view returns 1 (not
# resolved) so a gh blip never silently drops a live question.
question_is_resolved() {
    local repo="$1" num="$2" out
    out=$("$GH" issue view "$num" -R "Nishfleet/$repo" --json comments 2>/dev/null || true)
    [ -n "$out" ] || return 1
    printf '%s' "$out" | jq -e '[.comments[]?.body // empty] | any(startswith("decision-resolved:"))' >/dev/null 2>&1
}

# fleet-ops#4892: mark a Q:<repo>#<num> handle as seen so a legacy
# NISH-ESCALATIONS.md row that references the same handle is not re-delivered.
# The senior auditor includes the Q: handle in NISH ACTION rows (item 2);
# the entry-loop and prose-scan delivery check handle_seen before paging.
mark_handle_seen() {
    local handle="$1"
    [ -n "$handle" ] || return 0
    grep -qxF "$handle" "$SEEN" 2>/dev/null && return 0
    printf '%s\n' "$handle" >> "$SEEN"
}

# fleet-ops#4892: true (0) if $body references a Q:<repo>#<num> handle that is
# already in $SEEN (the question was delivered and has since been resolved).
# Used by the entry-loop and prose-scan delivery to suppress a legacy
# NISH-ESCALATIONS.md row for a handle that is no longer pending Nish.
handle_seen() {
    local body="$1" h
    [ -n "$body" ] || return 1
    while IFS= read -r h; do
        [ -n "$h" ] || continue
        grep -qxF "$h" "$SEEN" 2>/dev/null && return 0
    done < <(printf '%s' "$body" | grep -oE 'Q:[A-Za-z0-9_.-]+#[0-9]+' | sort -u || true)
    return 1
}

deliver_confirmed_questions() {
    local failq=0 key num
    while IFS=$'\t' read -r repo num url title q options created; do
        [ -n "$repo" ] && [ -n "$num" ] && [ -n "$url" ] || continue
        [ -n "$q" ] || continue
        key=$(printf '%s' "$url" | sha256sum | cut -c1-32)
        grep -qxF "$key" "$SEEN" 2>/dev/null && continue
        local handle
        handle=$(q_handle "$repo" "$num")
        # fleet-ops#4892: a confirmed question that already carries a
        # decision-resolved comment is answered — mark its URL hash AND its
        # Q: handle seen and skip delivery, so it never re-pages (and a
        # legacy NISH-ESCALATIONS.md row for the same handle is suppressed).
        if question_is_resolved "$repo" "$num"; then
            printf '%s\n' "$key" >> "$SEEN"
            mark_handle_seen "$handle"
            echo "suppressed (decision-resolved, fleet-ops#4892): $handle $title"
            continue
        fi
        local body
        body="$handle $q"
        [ -n "$options" ] && body="$body\nOptions: $options"
        body="$body\nAge: $(q_age_h "$created")h"
        # The outbound gate's urgent class-gate honours the MONEY-BOUNDARY
        # bypass; a reserved-set question is the same "needs Nish" class.
        if deliver "$key" "$title" "$body" "MONEY-BOUNDARY"; then
            :  # deliver() already marks $SEEN on success
        else
            failq=1
        fi
    done < <(confirmed_questions 2>/dev/null || true)
    return "$failq"
}

# --dry-run: print the confirmed question list WITHOUT sending. Only
# gate-confirmed questions are ever shown (the query filters by the
# confirmed labels), so --dry-run proves "only nish-reserved question issues"
# before anything reaches the phone.
notify_dry_run() {
    local repo num url title q options created
    while IFS=$'\t' read -r repo num url title q options created; do
        [ -n "$repo" ] && [ -n "$num" ] || continue
        [ -n "$q" ] || continue
        printf 'DRY-RUN %s (gate-confirmed, %sh): %s\n' \
            "$(q_handle "$repo" "$num")" "$(q_age_h "$created")" "$q"
    done < <(confirmed_questions 2>/dev/null || true)
}

# --digest: ONE Telegram line per 6h listing all unanswered confirmed
# questions with age. Throttled 1 per 6h via a timestamp marker next to
# $SEEN. A digest row always carries the Q: handle so a reply can answer it.
notify_digest() {
    local marker="$SEEN.digest" rec num repo url title q options created lines=()
    # throttle: no more than one digest line per 6h. Absent marker = never
    # sent -> send once now.
    local last now
    last=$(cat "$marker" 2>/dev/null || echo 0)
    now=$(date -u +%s 2>/dev/null || echo 0)
    if [ -n "$last" ] && [ "$last" -gt 0 ] 2>/dev/null && [ "$now" -gt 0 ] 2>/dev/null; then
        if [ $(( now - last )) -lt $(( 6 * 3600 )) ] 2>/dev/null; then
            echo "digest: throttled (last $(( (now - last) / 3600 ))h ago; 1 per 6h)"
            return 0
        fi
    fi
    while IFS=$'\t' read -r repo num url title q options created; do
        [ -n "$repo" ] && [ -n "$num" ] || continue
        [ -n "$q" ] || continue
        lines+=(" $(q_handle "$repo" "$num") — ${q} [$(q_age_h "$created")h]")
    done < <(confirmed_questions 2>/dev/null || true)
    if [ "${#lines[@]}" -eq 0 ]; then
        printf '%s\n' "$now" > "$marker"   # keep a clean cadence
        echo "digest: no unanswered confirmed questions"
        return 0
    fi
    local msg="Unanswered questions for Nish (6h digest):"
    local l
    for l in "${lines[@]:-}"; do msg="$msg\n$l"; done
    # The body rides as an argument (like the urgent path above): the old pipe fed a
    # hermes whose stdin was </dev/null, so the digest body never reached it.
    "$HERMES_BIN" send -t telegram --class MONEY-BOUNDARY "$(printf '%b' "$msg")" </dev/null >/dev/null 2>&1 && {
        printf '%s\n' "$now" > "$marker"
        echo "digest: delivered ${#lines[@]} unanswered confirmed question(s)"
    } || echo "digest: DELIVERY FAILED"
}

# --help usage.
notify_help() {
    cat <<'EOF'
usage: nish-boundary-notify [--dry-run | --digest | --help]

  (no args)  deliver new confirmed question issues + legacy NISH-ESCALATIONS.md
             entries (the path-triggered rail)
  --dry-run  list gate-confirmed question issues only (never sends)
  --digest   one summary Telegram line per 6h of all unanswered confirmed
             questions with age (throttled 1 per 6h in $SEEN.digest)
  --help      this message
EOF
}

# Dispatch when an explicit subcommand was given.
case "$MODE" in
    --dry-run) notify_dry_run; exit 0 ;;
    --digest)  notify_digest; exit 0 ;;
    --help)    notify_help; exit 0 ;;
    "") : ;;  # the default path-triggered rail
    *)
        echo "nish-boundary-notify: unknown argument: $MODE (see --help)" >&2
        exit 2 ;;
esac

mkdir -p "$(dirname "$SEEN")"; touch "$SEEN"

# Deliver confirmed question issues FIRST (fleet-ops#4474). A hermes failure on
# any one is loud (exit 1) so the auditor owns a dead channel. The .md path
# below stays for legacy rows until migration moves them into issues.
qfail=0
if command -v jq >/dev/null 2>&1; then
    deliver_confirmed_questions || qfail=1
fi

if [ ! -f "$FILE" ]; then
    # No legacy escalation file (migrated / archived). Still loud if a
    # confirmed-question delivery failed above (fleet-ops#4474).
    exit "${qfail:-0}"
fi

# Process substitution (not a pipe) so the while loop runs in THIS shell and
# the fail flag propagates. grep exits 1 on no match; inside <(...) that does
# not abort the parent under set -e — the loop simply reads zero lines and
# exits 0. A spurious path-unit trigger (file touched, no unseen boundary
# entries) must not read as a failed delivery (fleet-ops#1458 class).
fail=0
while IFS= read -r line; do
  key=$(printf '%s' "$line" | sha256sum | cut -c1-32)
  grep -qxF "$key" "$SEEN" && continue
  # Body: the header line plus its indented SUMMARY/DECISION block.
  body=$(awk -v want="$line" '
    $0==want {p=1; print; next}
    p && /^[[:space:]]/ {print; next}
    p {exit}' "$FILE" | head -25)

  # --- fleet-ops#4627: fleet-starvation gate (defense-in-depth) -------------
  # The writer (bin/money-boundary-raise) is authoritative — it suppresses the
  # ledger line when the fleet is not starved. This gate catches hand-written
  # or stale MONEY-BOUNDARY lines that pre-date the fix: if the entry names a
  # provider and the fleet still has a healthy prepaid/free seat, the dry
  # metered provider is a lane fault, not a money decision — suppress the page,
  # record it as revoked. Fail-loud: when the seat state cannot be read the
  # gate is skipped (the probe gate below still runs).
  # A no-match grep must not abort under set -euo pipefail (the fleet-ops#1458
  # class: a `seats= grep` abort silently killed the send). `|| true` keeps a
  # LEGAL-BOUNDARY / PRODUCT-DIRECTION line (no provider=) flowing to delivery.
  mb_prov=$(printf '%s' "$line" | grep -oE 'MONEY-BOUNDARY provider=[A-Za-z0-9._-]+' | sed 's/.*provider=//' || true)
  if [ -n "$mb_prov" ] && [ -f "${BOUNDARY_NOTIFY_CAPS:-$HOME/.local/state/pi-packet/seat-caps.json}" ] \
     && [ -d "${BOUNDARY_NOTIFY_SEAT_LEDGER:-$AS/lanes/seats}" ] \
     && command -v jq >/dev/null 2>&1; then
    caps_file="${BOUNDARY_NOTIFY_CAPS:-$HOME/.local/state/pi-packet/seat-caps.json}"
    seat_ledger="${BOUNDARY_NOTIFY_SEAT_LEDGER:-$AS/lanes/seats}"
    starved=1   # 1 = starved (page), 0 = not starved (suppress)
    while IFS=$'\t' read -r prov class; do
        [ -n "$prov" ] || continue
        case "$class" in
            prepaid-quota|subscription|free) ;;
            *) continue ;;
        esac
        for sf in "$seat_ledger"/"${prov}"__*.json; do
            [ -f "$sf" ] || continue
            case "$(basename "$sf")" in
                *.spawn-bench.json|*.empty-success*) continue ;;
            esac
            if jq -e '.health_class == "healthy" and .seat_dead != true' "$sf" >/dev/null 2>&1; then
                starved=0   # healthy prepaid/free seat exists — not starved
                break
            fi
        done
        [ "$starved" -eq 0 ] && break
    done < <(jq -r '
        .providers | to_entries[] | .key as $k | .value as $v |
        (if ($v|type)=="number" then $v else ($v.cap // 0) end) as $cap |
        select($cap > 0) |
        [ $k, (if ($v|type)=="number" then "free" else ($v.class // "free") end) ] | @tsv
    ' "$caps_file" 2>/dev/null || true)
    if [ "$starved" -eq 0 ]; then
      printf '%s\n' "$key" >> "$SEEN"
      printf '%s REVOKED-BY-STARVATION-GATE %s (fleet not starved — healthy prepaid/free seat exists; dry metered provider is a lane fault, fleet-ops#4627)\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >> "$FILE"
      echo "suppressed (fleet not starved, fleet-ops#4627): $line"
      continue
    fi
  fi

  # --- Probe gate -----------------------------------------------------------
  # A provider quota/rate wall that RESETS is not a money boundary. On
  # 2026-08-25 an auditor read devin 402 + minimax 429 as "payment wall, NISH
  # DECISION NEEDED"; both seats were simply rate-limited and answered fine the
  # next morning. Nish got paged for nothing. So: if this entry names provider
  # seats, re-probe them live. All healthy => suppress the text, record it as
  # revoked. Any seat still down => deliver, the wall is real.
  seats=$(printf '%s' "$body" | grep -oE '\b(devin|minimax|openrouter|cursor|deepseek|opencode-go)/[A-Za-z0-9._-]+' | sort -u || true)
  if [ -n "$seats" ]; then
    all_ok=1
    for seat in $seats; do
      prov=${seat%%/*}; model=${seat#*/}
      if echo 'Reply with exactly: SEAT-OK' | timeout 120 "${PI_BIN:-/home/nish/.local/bin/pi}" \
           --print --provider "$prov" --model "$model" 2>/dev/null | grep -q 'SEAT-OK'; then
        echo "probe: $seat healthy"
      else
        echo "probe: $seat STILL DOWN — wall is real, delivering"; all_ok=0
      fi
    done
    if [ "$all_ok" = 1 ]; then
      printf '%s\n' "$key" >> "$SEEN"
      printf '%s REVOKED-BY-PROBE %s (all seats answered live; not a payment wall)\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$line" >> "$FILE"
      echo "suppressed (false money page): $line"
      continue
    fi
  fi
  # The matched class token is the second whitespace field of the entry line
  # (`<ts> <CLASS> ...`). Pass it to deliver so hermes gets --class <CLASS>
  # and the outbound gate's urgent class-gate honours the bypass.
  class=$(printf '%s' "$line" | awk '{print $2}')
  # fleet-ops#4892: a legacy entry-format row that references a Q:<repo>#<num>
  # handle already marked seen (the question was delivered and has since been
  # resolved) is suppressed so a stale NISH-ESCALATIONS.md row never re-pages.
  if handle_seen "$body"; then
    printf '%s\n' "$key" >> "$SEEN"
    echo "suppressed (handle already resolved, fleet-ops#4892): $line"
    continue
  fi
  deliver "$key" "$line" "$body" "$class" || fail=1
done < <(grep -E "^[0-9-]{10}T[0-9:]{8}Z ($CLASSES) " "$FILE" 2>/dev/null || true)

# --- Prose-scan detector (fleet-ops#4048) ----------------------------
# The entry-line grep above only matches the canonical timestamp shape
# (`<ISO-ts> <CLASS> slug — summary`). Historically agents appended prose
# sections (`## YYYY-MM-DD — title` with a `NISH ACTION` / `NISH DECISION
# NEEDED` bullet) that the grep never matched, so a reserved-class ask sat
# in the file while the unit exited 0 and logged `Finished` with no
# delivered line — the channel dark, the unit healthy-looking. The most
# recent entry-format line can be followed by months of undelivered prose.
#
# This pass must NEVER let a green run silently drop reserved-class text.
# It scans prose sections dated STRICTLY after the newest entry-format line
# (the "last delivered one" — the backfill must not re-page already-resolved
# history, and $SEEN de-dups anything delivered), and delivers each unseen
# marker via the same retry/fallback path as the entry loop. If any cannot
# be delivered it exits 1 so OnFailure summons an auditor.
#
# Boundary: the date of the newest entry-format line in the file, recomputed
# each run. The file is append-only and the format is documented at the top
# of NISH-ESCALATIONS.md, so a genuinely new reserved item is newer than the
# boundary; an EMPTY boundary (no entry-format lines at all — a purely prose
# file) makes every dated section subject to the scan.
last_bd=$(
  grep -oE "^[0-9-]{10}T[0-9:]{8}Z ($CLASSES) " "$FILE" 2>/dev/null \
    | cut -c1-10 | sort -u | tail -1 || true
)
# Reserved-class prose markers: the boundary tokens themselves plus the two
# prose ask shapes auditors write. NISH DECISION NEEDED is matched first (a
# NISH ACTION line often also names MONEY-BOUNDARY); we deliver per section.
prose_mark="NISH ACTION|NISH DECISION NEEDED|$CLASSES"
# awk emits, one record per RELEVANT section, `<header>|<first-marker-line>`.
# `next` after a ## header keeps the header itself from self-matching; only
# lines after a post-boundary header count; `$0 !~ /^[0-9]/` skips
# entry-format lines (already handled above); emitting once per section via
# active=0 keeps NISH ACTION + NISH DECISION NEEDED in one section to one msg.
readarray -t prose < <(
  awk -v bd="$last_bd" -v m="$prose_mark" '
    /^## [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ {
      date = substr($0, 4, 10)
      active = (bd == "" || date > bd) ? 1 : 0
      hdr = $0
      next
    }
    active && $0 !~ /^[0-9]/ && $0 ~ m {
      print hdr "|" $0
      active = 0
    }
  ' "$FILE" | sort -u
)
prose_fail=0
for rec in "${prose[@]:-}"; do
  [ -n "$rec" ] || continue
  hdr="${rec%%|*}"; marker="${rec#*|}"
  key=$(printf '%s' "$rec" | sha256sum | cut -c1-32)
  grep -qxF "$key" "$SEEN" && continue
  # Class for the hermes --class gate: the class token if the section names
  # one, else map the common money words in the ask to MONEY-BOUNDARY so a
  # credit/billing ask gets the urgent class-gate bypass. LEGAL-BOUNDARY is
  # the conservative fallback so hermes still honours it as a reserved class.
  class=$(printf '%s' "$hdr $marker" | grep -oE "$CLASSES" | head -1 || true)
  if [ -z "$class" ]; then
    lower="${hdr} ${marker}"; lower="${lower,,}"
    case "$lower" in
      *money*|*credit*|*pay*|*bill*|*card*|*charge*|*paid*) class="MONEY-BOUNDARY";;
      *) class="LEGAL-BOUNDARY";;
    esac
  fi
  # fleet-ops#4892: a prose section that references a Q:<repo>#<num> handle
  # already marked seen (the question was delivered and has since been
  # resolved) is suppressed so a stale NISH ACTION row never re-pages.
  if handle_seen "$hdr
$marker"; then
    printf '%s\n' "$key" >> "$SEEN"
    echo "suppressed (handle already resolved, fleet-ops#4892): $marker"
    continue
  fi
  deliver "$key" "$marker" "$hdr
$marker" "$class" || prose_fail=1
done

# A failed delivery (entry-format, prose, OR confirmed-question issue) must be
# loud: exit 1 so OnFailure summons an auditor. A spurious trigger with
# nothing to deliver exits 0.
[ "${prose_fail:-0}" = 1 ] && fail=1
[ "${qfail:-0}" = 1 ] && fail=1
exit "$fail"
