#!/usr/bin/env bash
# fleet-restore-drill — periodically PROVE the fleet control plane can be
# rebuilt, mechanically, on a cycle (fleet-ops#388).
#
# fleet-ops#4264 (LiteLLM programme P4) adds plane E: the LiteLLM proxy's
# Postgres is control-plane state (virtual keys, budgets, spend, cooldown
# persistence) that git does NOT track and a /home/nish restic snapshot only
# captures if a dump exists. Plane E takes that dump every run (recurring
# pg_dump is the restoration input "the backup job's pg_dump" names), keeps a
# small rotation, and proves the dump is loadable into a throwaway scratch
# cluster. It lives here instead of the system restic unit because that unit
# runs as root with ProtectHome=read-only and cannot write /home/nish; this
# user drill runs as nish against the user-owned socket and the dump lands
# under the restic-covered agent-state tree.
#
# The deploy-clone is git (recoverable). The control plane also lives in
# non-git state: agent-state/ (claims, triage, seat state, audit reports),
# ~/.local/state/pi-packet/ (seat-caps, packet state), and the user-unit
# install set (~/.config/systemd/user/ symlinks + the repo MANIFEST). Restic
# backs all of it up (system unit restic-r2-backup sources /home/nish, /etc,
# /root, /usr/local — verified; excludes empty). But per the never-run-audit
# lesson (#378), an unproven backup is decorative. This drill is the proof.
#
# It does NOT run restic restore itself: the restic repo credentials live in
# /etc/restic/hostinger-r2.env (root-only; nish has no sudo). Instead it proves
# the rebuild story on four planes every run, LOUD on any doubt:
#
#   A. Backup mechanism is proven (system restic units, readable via
#      `systemctl show` without sudo):
#      - restic-r2-backup.timer is active and fired within STALENESS_HOURS
#        (default 30h — daily timer + margin).
#      - restic-r2-backup.service last Result=success (last backup succeeded).
#      - restic-r2-restore-test.service last Result=success (a snapshot
#        restore was proven end-to-end by the system drill).
#      - restic-r2-verify.service last Result=success (repo integrity proven).
#      A stale or failed backup/restore/verify is LOUD — the rebuild story is
#      unproven, not silently degraded.
#
#   B. The fleet control-plane files that a restore would yield are present
#      and parseable in the live tree (the backup captures exactly these):
#      - seat-caps.json: valid JSON with the keys litellm-seat.sh loads
#        (.ram_gb_per_worker, .providers object, .free_providers_in_order
#        array). A corrupt caps file means a restored fleet picks seats wrong.
#      - claims index (ready-work-claims.log): exists and its last line parses
#        as a claim record. A corrupt claims log means a restored fleet cannot
#        tell which issues are claimed.
#      - MANIFEST-installed set: every non-comment MANIFEST entry's <src>
#        exists in the repo. A missing source means install.sh cannot rebuild
#        the user-unit install set after a restore.
#
#   C. The critical fleet paths live under a configured restic backup source
#      (/home/nish). This is the logical proof that a snapshot restore
#      includes the control plane — the files proven in (B) are under a
#      backed-up root, and the mechanism proven in (A) can return them.
#
#   D. A dated artifact marker exists and is fresh (fleet-ops#2471). Every run
#      whose A/B/C planes pass writes $AGENT_STATE/alert-repair/
#      fleet-restore-drill-marker (mtime = the run's timestamp; the body is
#      an ISO date). The opus-heartbeat thorough gather stats that exact path
#      for its backup_freshness.newest_backup_marker — a green timer with no
#      marker proves nothing (the 2026-08-31 monitor-lie class). The drill
#      itself fails when the marker is absent or older than the timer cadence
#      plus slack (default 8h on the 6h cadence): a run that did not leave a
#      fresh artifact cannot go green. A missing/stale marker does NOT block
#      the marker refresh when A/B/C passed, so a transient absence self-heals
#      on the next 6h cycle; a marker write that keeps failing stays escalated.
#
# Result line goes to the heartbeat triage file (the same surface tier1/tier2
# write LOUD lines to). On any failure: LOUD + exit 1. The global
# service.d/10-escalate.conf drop-in turns that exit 1 into a
# unit-escalation@fleet-restore-drill.service trip, so backup staleness joins
# the escalation matrix mechanically.
#
# Usage: fleet-restore-drill              # run the drill
#        fleet-restore-drill --check     # report whether the drill units +
#                                        # script are installed (no system calls)
#
# Plane E seams (tests + operator):
#   FLEET_LITELLM_PGDATA       litellm cluster data dir (default the fleet-
#                              owned cluster path; absent = plane E skips,
#                              organ not installed — the health canary owns
#                              absent-organ liveness, not this drill)
#   FLEET_LITELLM_PG_BINDIR    postgres server binaries dir (default:
#                              pg_config --bindir, else
#                              /usr/lib/postgresql/16/bin for pg_ctl/initdb)
#   FLEET_LITELLM_DUMP_DIR     dump target (default agent-state/backups)
#   FLEET_LITELLM_DUMP_KEEP    dumps retained (default 14; one per 6h tick)
#   FLEET_LITELLM_SCRATCH_PORT scratch port (default 5433)
#   FLEET_LITELLM_PG_SOCKET    litellm cluster socket dir (default: <pgdata>/run)
#   FLEET_LITELLM_DB_USER/DB_NAME  dump source (default litellm/litellm)
#   FLEET_LITELLM_ISREADY/PSQL/PG_DUMP/INITDB/PG_CTL  per-step binary seams (tests)
#   FLEET_LITELLM_RESTORE_TIMEOUT_S           scratch-restore bound (default 180)
#
# Env overrides (test-only; production reads live paths):
#   SYSTEMCTL, FLEET_OPS_REPO, AGENT_STATE, FLEET_HEARTBEAT_TRIAGE,
#   SEAT_CAPS_JSON, CLAIMS_LOG, RESTIC_BACKUP_TIMER, RESTIC_BACKUP_SERVICE,
#   RESTIC_RESTORE_TEST_SERVICE, RESTIC_VERIFY_SERVICE, STALENESS_HOURS,
#   FLEET_RESTORE_DRILL_SKIP_SYSTEM (1 = skip plane A for offline tests),
#   FLEET_RESTORE_DRILL_MARKER (artifact path), FLEET_RESTORE_DRILL_MARKER_MAX_AGE_S

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
command -v gh >/dev/null 2>&1 || export PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin

SYSTEMCTL="${SYSTEMCTL:-systemctl}"
FLEET_OPS_REPO="${FLEET_OPS_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
AGENT_STATE="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-$AGENT_STATE/FLEET-HEARTBEAT-TRIAGE.md}"
SEAT_CAPS_JSON="${SEAT_CAPS_JSON:-$FLEET_OPS_REPO/config/seat-caps.json}"
CLAIMS_LOG="${CLAIMS_LOG:-$AGENT_STATE/ready-work-claims.log}"
MANIFEST="$FLEET_OPS_REPO/MANIFEST"

RESTIC_BACKUP_TIMER="${RESTIC_BACKUP_TIMER:-restic-r2-backup.timer}"
RESTIC_BACKUP_SERVICE="${RESTIC_BACKUP_SERVICE:-restic-r2-backup.service}"
RESTIC_RESTORE_TEST_SERVICE="${RESTIC_RESTORE_TEST_SERVICE:-restic-r2-restore-test.service}"
RESTIC_VERIFY_SERVICE="${RESTIC_VERIFY_SERVICE:-restic-r2-verify.service}"
STALENESS_HOURS_DEFAULT=30
STALENESS_HOURS="${STALENESS_HOURS:-$STALENESS_HOURS_DEFAULT}"
if ! [[ "$STALENESS_HOURS" =~ ^[0-9]+$ ]]; then
  STALENESS_HOURS="$STALENESS_HOURS_DEFAULT"
fi
readonly STALENESS_HOURS

# Dated artifact marker the heartbeat can stat (fleet-ops#2471). The
# opus-heartbeat thorough gather globs $AGENT_STATE/alert-repair for
# fleet-restore-drill* / backup* to report
# backup_freshness.newest_backup_marker; this path is the contract with it.
# The heartbeat stats mtime, so mtime IS the run timestamp; the body carries
# the same date for humans.
MARKER="${FLEET_RESTORE_DRILL_MARKER:-$AGENT_STATE/alert-repair/fleet-restore-drill-marker}"
readonly MARKER

# Freshness bound for the marker: the 6h timer cadence plus 2h slack
# (RandomizedDelaySec=15min + AccuracySec=30min + jitter margin). A marker
# older than this means a timer run failed to leave an artifact behind.
MARKER_MAX_AGE_S_DEFAULT=28800
MARKER_MAX_AGE_S="${FLEET_RESTORE_DRILL_MARKER_MAX_AGE_S:-$MARKER_MAX_AGE_S_DEFAULT}"
if ! [[ "$MARKER_MAX_AGE_S" =~ ^[0-9]+$ ]]; then
  MARKER_MAX_AGE_S="$MARKER_MAX_AGE_S_DEFAULT"
fi
readonly MARKER_MAX_AGE_S

# Plane E ran and passed this invocation (0 = skipped/failed). write_marker
# cites it in the artifact body so the marker tells the full rebuild story.
PLANE_E_RAN=0

# The restic backup sources (from /usr/local/sbin/restic-r2-backup). The drill
# asserts the critical fleet paths live under one of these — the logical proof
# that a snapshot restore includes the control plane. /home/nish is the only
# source the fleet paths can live under; the others are listed for completeness
# and to make the coverage assertion legible. FLEET_RESTORE_DRILL_BACKUP_ROOTS
# overrides the set (space-separated) for offline tests.
if [[ -n "${FLEET_RESTORE_DRILL_BACKUP_ROOTS:-}" ]]; then
  read -r -a RESTIC_BACKUP_ROOTS <<<"$FLEET_RESTORE_DRILL_BACKUP_ROOTS"
else
  RESTIC_BACKUP_ROOTS=(/home/nish /etc /root /usr/local)
fi
readonly -a RESTIC_BACKUP_ROOTS

log() {
  printf '[%s] [fleet-restore-drill] %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
  local tag="$1"; shift
  local msg="$*"
  log "LOUD [$tag] $msg"
  {
    printf '\n[%s] [%s] %s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
  } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

fail() {
  loud "RESTORE-DRILL-FAIL" "$*"
  exit 1
}

# systemctl_show <unit> <property> — prints the property value, empty on error.
# Works on both system and user scope; the restic units are system scope, and
# `systemctl show` (no --user) is readable by any user without sudo.
systemctl_show() {
  local unit="$1" prop="$2"
  "$SYSTEMCTL" show "$unit" --property="$prop" --value 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# plane A: backup mechanism proven (system restic units)
# ----------------------------------------------------------------------------
plane_a_backup_mechanism() {
  log "A. checking system restic backup/restore/verify units"

  if [[ "${FLEET_RESTORE_DRILL_SKIP_SYSTEM:-0}" == "1" ]]; then
    log "A.  - SKIP (FLEET_RESTORE_DRILL_SKIP_SYSTEM=1)"
    return 0
  fi

  local violations=0

  # A.1 backup timer active + fresh
  local timer_active timer_last
  timer_active="$(systemctl_show "$RESTIC_BACKUP_TIMER" ActiveState)"
  timer_last="$(systemctl_show "$RESTIC_BACKUP_TIMER" LastTriggerUSec)"
  log "A.1 $RESTIC_BACKUP_TIMER ActiveState=$timer_active LastTriggerUSec=$timer_last"
  if [[ "$timer_active" != "active" ]]; then
    loud "RESTORE-DRILL-STALE" "$RESTIC_BACKUP_TIMER is not active (state=$timer_active) — the daily backup is not scheduled"
    violations=$((violations + 1))
  elif [[ -z "$timer_last" ]] || [[ "$timer_last" == "0" ]]; then
    loud "RESTORE-DRILL-STALE" "$RESTIC_BACKUP_TIMER has never fired (LastTriggerUSec empty) — no backup has run"
    violations=$((violations + 1))
  else
    # LastTriggerUSec realtime value is a wall-clock string like
    # "Wed 2026-08-26 04:39:49 IST". Convert to epoch seconds.
    local last_epoch now_epoch age_h
    last_epoch="$(date -d "$timer_last" +%s 2>/dev/null || true)"
    now_epoch="$(date +%s)"
    if [[ -z "$last_epoch" ]]; then
      loud "RESTORE-DRILL-STALE" "$RESTIC_BACKUP_TIMER LastTriggerUSec unparseable: '$timer_last'"
      violations=$((violations + 1))
    else
      age_h=$(( (now_epoch - last_epoch) / 3600 ))
      log "A.1  - last backup ${age_h}h ago (staleness threshold ${STALENESS_HOURS}h)"
      if (( age_h > STALENESS_HOURS )); then
        loud "RESTORE-DRILL-STALE" "$RESTIC_BACKUP_TIMER last fired ${age_h}h ago — older than ${STALENESS_HOURS}h threshold. The backup is stale; the rebuild story is unproven."
        violations=$((violations + 1))
      fi
    fi
  fi

  # A.2 last backup succeeded
  local backup_result
  backup_result="$(systemctl_show "$RESTIC_BACKUP_SERVICE" Result)"
  log "A.2 $RESTIC_BACKUP_SERVICE Result=$backup_result"
  if [[ "$backup_result" != "success" ]]; then
    loud "RESTORE-DRILL-FAIL" "$RESTIC_BACKUP_SERVICE last Result=$backup_result (not success) — the last backup run failed"
    violations=$((violations + 1))
  fi

  # A.3 snapshot restore proven (system drill)
  local restore_result
  restore_result="$(systemctl_show "$RESTIC_RESTORE_TEST_SERVICE" Result)"
  log "A.3 $RESTIC_RESTORE_TEST_SERVICE Result=$restore_result"
  if [[ "$restore_result" != "success" ]]; then
    loud "RESTORE-DRILL-FAIL" "$RESTIC_RESTORE_TEST_SERVICE last Result=$restore_result (not success) — the snapshot restore drill failed; restore is not proven"
    violations=$((violations + 1))
  fi

  # A.4 repo integrity proven
  local verify_result
  verify_result="$(systemctl_show "$RESTIC_VERIFY_SERVICE" Result)"
  log "A.4 $RESTIC_VERIFY_SERVICE Result=$verify_result"
  if [[ "$verify_result" != "success" ]]; then
    loud "RESTORE-DRILL-FAIL" "$RESTIC_VERIFY_SERVICE last Result=$verify_result (not success) — repo integrity verify failed"
    violations=$((violations + 1))
  fi

  (( violations == 0 )) || return 1
  log "A.  - OK: backup fresh, last run success, restore + verify proven"
  return 0
}

# ----------------------------------------------------------------------------
# plane B: fleet control-plane files present + parseable
# ----------------------------------------------------------------------------
plane_b_fleet_files() {
  log "B. checking fleet control-plane files are present + parseable"
  local violations=0

  # B.1 seat-caps.json — valid JSON with the keys litellm-seat.sh loads.
  if [[ ! -f "$SEAT_CAPS_JSON" ]]; then
    loud "RESTORE-DRILL-FAIL" "seat-caps.json missing at $SEAT_CAPS_JSON — seat selection has no caps file"
    violations=$((violations + 1))
  elif ! command -v jq >/dev/null 2>&1; then
    loud "RESTORE-DRILL-FAIL" "jq missing — cannot parse seat-caps.json"
    violations=$((violations + 1))
  else
    if ! jq -e . "$SEAT_CAPS_JSON" >/dev/null 2>&1; then
      loud "RESTORE-DRILL-FAIL" "seat-caps.json unparseable JSON at $SEAT_CAPS_JSON"
      violations=$((violations + 1))
    else
      # Load-bearing keys per lib/litellm-seat.sh: providers (object,
      # non-empty), free_providers_in_order (array). fleet-ops#4263: the
      # per-worker RAM key is gone — MemoryMax + oomd own that.
      local providers free_order
      providers="$(jq -r '.providers | keys | length' "$SEAT_CAPS_JSON" 2>/dev/null || echo 0)"
      free_order="$(jq -r '.free_providers_in_order | type' "$SEAT_CAPS_JSON" 2>/dev/null || echo "")"
      log "B.1  - seat-caps providers=$providers free_providers_in_order=$free_order"
      if ! [[ "$providers" =~ ^[0-9]+$ ]] || (( providers == 0 )); then
        loud "RESTORE-DRILL-FAIL" "seat-caps.json .providers empty or missing — no seats are defined"
        violations=$((violations + 1))
      fi
      if [[ "$free_order" != "array" ]]; then
        loud "RESTORE-DRILL-FAIL" "seat-caps.json .free_providers_in_order is not an array (got '$free_order') — litellm-seat.sh free-order selection breaks"
        violations=$((violations + 1))
      fi
    fi
  fi

  # B.2 claims index — exists and last line parses as a claim record.
  if [[ ! -f "$CLAIMS_LOG" ]]; then
    loud "RESTORE-DRILL-FAIL" "claims index missing at $CLAIMS_LOG — the fleet cannot tell which issues are claimed"
    violations=$((violations + 1))
  else
    local last_line
    last_line="$(tail -n 1 "$CLAIMS_LOG" 2>/dev/null || true)"
    log "B.2  - claims index last line: $last_line"
    if [[ -z "$last_line" ]]; then
      loud "RESTORE-DRILL-FAIL" "claims index at $CLAIMS_LOG is empty — no claim records to restore"
      violations=$((violations + 1))
    elif ! grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z ' <<<"$last_line"; then
      loud "RESTORE-DRILL-FAIL" "claims index last line at $CLAIMS_LOG is not a timestamped claim record: '$last_line'"
      violations=$((violations + 1))
    fi
  fi

  # B.3 MANIFEST-installed set — every non-comment entry's <src> exists.
  # fleet-ops#3277: an `npm-pin:<rel>` src is not a repo file; it resolves
  # against the installed pi examples dir at install time. Skip those.
  if [[ ! -f "$MANIFEST" ]]; then
    loud "RESTORE-DRILL-FAIL" "MANIFEST missing at $MANIFEST — install.sh cannot rebuild the user-unit install set"
    violations=$((violations + 1))
  else
    local missing=0 entry src
    while IFS= read -r entry; do
      [[ -z "$entry" ]] && continue
      [[ "$entry" == \#* ]] && continue
      src="${entry%% *}"
      [[ "$src" == npm-pin:* ]] && continue
      if [[ ! -e "$FLEET_OPS_REPO/$src" ]]; then
        loud "RESTORE-DRILL-FAIL" "MANIFEST entry src '$src' missing in repo — install.sh cannot symlink it after a restore"
        missing=$((missing + 1))
      fi
    done < "$MANIFEST"
    log "B.3  - MANIFEST-installed set: all non-comment srcs present (missing=$missing)"
    (( missing == 0 )) || violations=$((violations + 1))
  fi

  (( violations == 0 )) || return 1
  log "B.  - OK: seat-caps parseable, claims index valid, MANIFEST srcs present"
  return 0
}

# ----------------------------------------------------------------------------
# plane C: fleet paths under a configured restic backup source
# ----------------------------------------------------------------------------
plane_c_backup_coverage() {
  log "C. checking fleet paths live under a restic backup source"
  local violations=0

  # The critical non-git control-plane paths the issue names.
  local critical_paths=(
    "$AGENT_STATE"
    "$HOME/.local/state/pi-packet"
    "$HOME/.config/systemd/user"
    "$FLEET_OPS_REPO"
  )

  local path covered root
  for path in "${critical_paths[@]}"; do
    covered=0
    for root in "${RESTIC_BACKUP_ROOTS[@]}"; do
      if [[ "$path" == "$root" ]] || [[ "$path" == "$root"/* ]]; then
        covered=1
        break
      fi
    done
    if (( covered == 0 )); then
      loud "RESTORE-DRILL-FAIL" "critical fleet path '$path' is NOT under any restic backup source (${RESTIC_BACKUP_ROOTS[*]}) — a snapshot restore would miss it"
      violations=$((violations + 1))
    else
      log "C.  - $path: covered (under a backup source)"
    fi
  done

  (( violations == 0 )) || return 1
  log "C.  - OK: all critical fleet paths under a restic backup source"
  return 0
}

# ----------------------------------------------------------------------------
# plane E: LiteLLM control-plane Postgres — recurring pg_dump + scratch-restore
# proof (fleet-ops#4264). The dump is "the backup job's pg_dump" that the P4
# restore contract names (docs/litellm-postgres-setup.md §5); the scratch
# cluster restore proves the dump actually loads. Organ LIVENESS (proxy/pg/
# redis up) stays the 60s health canary's job — this plane proves the
# REBUILD story: without a fresh, loadable dump the Postgres half of the
# control plane is unrecoverable and the P4 restore contract is a lie.
# ----------------------------------------------------------------------------
plane_e_litellm_pg() {
  log "E. LiteLLM control-plane Postgres: recurring pg_dump + scratch-restore proof"
  local pgdata="${FLEET_LITELLM_PGDATA:-$HOME/.local/share/fleet-litellm-postgres}"
  if [[ ! -f "$pgdata/PG_VERSION" ]]; then
    log "E.  - SKIP: no litellm cluster at $pgdata (organ not installed; the health canary owns absent-organ liveness, not this drill)"
    return 0
  fi

  local bindir
  if [[ -n "${FLEET_LITELLM_PG_BINDIR:-}" ]]; then
    bindir="$FLEET_LITELLM_PG_BINDIR"
  else
    bindir="$(pg_config --bindir 2>/dev/null || true)"
    [[ -n "$bindir" ]] || bindir="/usr/lib/postgresql/16/bin"
  fi
  local isreadybin="${FLEET_LITELLM_ISREADY:-$bindir/pg_isready}"
  local psqlbin="${FLEET_LITELLM_PSQL:-$bindir/psql}"
  local pgdumpbin="${FLEET_LITELLM_PG_DUMP:-$bindir/pg_dump}"
  local initdbbin="${FLEET_LITELLM_INITDB:-$bindir/initdb}"
  local pgctlbin="${FLEET_LITELLM_PG_CTL:-$bindir/pg_ctl}"
  local socket="${FLEET_LITELLM_PG_SOCKET:-$pgdata/run}"
  local dbuser="${FLEET_LITELLM_DB_USER:-litellm}"
  local dbname="${FLEET_LITELLM_DB_NAME:-litellm}"
  local dump_dir="${FLEET_LITELLM_DUMP_DIR:-$AGENT_STATE/backups}"
  local keep="${FLEET_LITELLM_DUMP_KEEP:-14}"
  local port="${FLEET_LITELLM_SCRATCH_PORT:-5433}"
  local restore_timeout="${FLEET_LITELLM_RESTORE_TIMEOUT_S:-180}"

  # E.0 prune scratch leftovers from an aborted run (set -e aborts leave the
  # dir). Only entries older than 1h: a concurrent manual run's scratch is
  # never beneath the timer's feet.
  find "$dump_dir" -maxdepth 1 -name '.scratch-restore.*' -type d -mmin +60 \
    -exec rm -rf {} + 2>/dev/null || true

  # E.1 the live cluster answers (a dump of a dead cluster is not a backup).
  if ! "$isreadybin" -h "$socket" -q; then
    loud "RESTORE-DRILL-FAIL" "litellm cluster not accepting connections on $socket — cannot take the control-plane pg_dump (plane E)"
    return 1
  fi
  log "E.1  - cluster ready on $socket"

  # E.2 the dump: the restore input the P4 drill contract names.
  if ! mkdir -p "$dump_dir"; then
    loud "RESTORE-DRILL-FAIL" "cannot create dump dir $dump_dir"
    return 1
  fi
  local stamp dump
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  dump="$dump_dir/litellm-$stamp.sql.gz"
  log "E.2  - dumping $dbname via $socket -> $dump"
  if ! "$pgdumpbin" -h "$socket" -U "$dbuser" "$dbname" | gzip >"$dump"; then
    loud "RESTORE-DRILL-FAIL" "litellm pg_dump failed — the Postgres rebuild story is unproven (plane E)"
    rm -f "$dump"
    return 1
  fi
  if [[ ! -s "$dump" ]]; then
    loud "RESTORE-DRILL-FAIL" "litellm pg_dump produced an EMPTY dump ($dump) — unproven backup is decorative"
    rm -f "$dump"
    return 1
  fi

  # Rotation: the newest KEEP dumps survive; older ones go. Count only this
  # organ's dumps so a shared backups dir is never mistaken for rotation
  # residue.
  if [[ "$keep" =~ ^[0-9]+$ ]] && (( keep > 0 )); then
    while IFS= read -r old; do
      [[ -n "$old" ]] || continue
      rm -f "$old"
      log "E.2  - rotated out $(basename "$old") (keep $keep)"
    # shellcheck disable=SC2012 — the drill owns the dump filenames
    # (litellm-<stamp>.sql.gz); mtime order is the rotation order.
    done < <(ls -1t "$dump_dir"/litellm-*.sql.gz 2>/dev/null | tail -n +$((keep + 1)))
  fi

  # E.3 scratch-restore: initdb a throwaway cluster on the scratch port, load
  # the dump, count the LiteLLM control-plane tables. The scratch dir lives
  # under dump_dir so an aborted run leaves only that dir behind.
  local scratch
  scratch="$(mktemp -d "$dump_dir/.scratch-restore.XXXXXX")" || {
    loud "RESTORE-DRILL-FAIL" "cannot create scratch-restore dir under $dump_dir"
    return 1
  }
  if ! "$initdbbin" -U "$dbuser" -A trust -E UTF8 -D "$scratch/data" >/dev/null 2>&1; then
    loud "RESTORE-DRILL-FAIL" "scratch initdb failed under $scratch — plane E restore proof skipped, control-plane rebuild unproven"
    rm -rf "$scratch"
    return 1
  fi
  if ! "$pgctlbin" -D "$scratch/data" -o "-p $port -k $scratch/sock -c listen_addresses=''" \
      -l "$scratch/pglog" -w start >/dev/null 2>&1; then
    loud "RESTORE-DRILL-FAIL" "scratch cluster failed to start on port $port — plane E cannot prove the dump loads"
    rm -rf "$scratch"
    return 1
  fi
  local tries=0
  until "$isreadybin" -h "$scratch/sock" -p "$port" -q; do
    tries=$((tries + 1))
    if (( tries > 30 )); then
      loud "RESTORE-DRILL-FAIL" "scratch cluster on port $port never became ready — plane E cannot prove the dump loads"
      "$pgctlbin" -D "$scratch/data" stop -m fast -w >/dev/null 2>&1 || true
      rm -rf "$scratch"
      return 1
    fi
    sleep 1
  done
  if ! gunzip -c "$dump" | timeout "$restore_timeout" "$psqlbin" -h "$scratch/sock" -p "$port" \
      -U "$dbuser" -d postgres -v ON_ERROR_STOP=1 -q; then
    loud "RESTORE-DRILL-FAIL" "scratch-restore of $(basename "$dump") failed or exceeded the ${restore_timeout}s bound — the dump does not prove a restore (plane E)"
    "$pgctlbin" -D "$scratch/data" stop -m fast -w >/dev/null 2>&1 || true
    rm -rf "$scratch"
    return 1
  fi
  local tables
  tables="$("$psqlbin" -h "$scratch/sock" -p "$port" -U "$dbuser" -d postgres -Atc \
    "select count(*) from pg_tables where schemaname='public' and tablename like 'LiteLLM\_%'" 2>/dev/null || echo 0)"
  if ! [[ "$tables" =~ ^[0-9]+$ ]] || (( tables < 1 )); then
    loud "RESTORE-DRILL-FAIL" "scratch-restore loaded 0 LiteLLM_* control-plane tables — the dump restored nothing usable (plane E)"
    "$pgctlbin" -D "$scratch/data" stop -m fast -w >/dev/null 2>&1 || true
    rm -rf "$scratch"
    return 1
  fi
  "$pgctlbin" -D "$scratch/data" stop -m fast -w >/dev/null 2>&1 || true
  rm -rf "$scratch"
  PLANE_E_RAN=1
  log "E.  - OK: dumped $dbname -> $(basename "$dump") + scratch-restore proven ($tables LiteLLM_* tables, bound ${restore_timeout}s)"
  return 0
}

# ----------------------------------------------------------------------------
# plane D: dated artifact marker exists + fresh (fleet-ops#2471)
# ----------------------------------------------------------------------------
plane_d_artifact_freshness() {
  log "D. checking restore-drill artifact marker freshness"
  if [[ ! -f "$MARKER" ]]; then
    loud "RESTORE-DRILL-ARTIFACT-MISSING" "no restore-drill artifact marker at $MARKER — the heartbeat's newest_backup_marker would be null. A green timer with no artifact proves nothing (monitor-lie class)."
    return 1
  fi
  local mtime now age
  mtime="$(stat -c %Y "$MARKER" 2>/dev/null || true)"
  if [[ -z "$mtime" ]]; then
    loud "RESTORE-DRILL-ARTIFACT-MISSING" "cannot stat restore-drill artifact marker at $MARKER"
    return 1
  fi
  now="$(date +%s)"
  age=$(( now - mtime ))
  log "D.  - marker mtime age ${age}s (max ${MARKER_MAX_AGE_S}s)"
  if (( age > MARKER_MAX_AGE_S )); then
    loud "RESTORE-DRILL-ARTIFACT-STALE" "restore-drill artifact marker at $MARKER is ${age}s old — older than the timer run by more than the ${MARKER_MAX_AGE_S}s bound (6h cadence + 2h slack). The drill has not produced a fresh artifact since then; the rebuild story is unproven."
    return 1
  fi
  log "D.  - OK: artifact marker present and fresh (age ${age}s)"
  return 0
}

# Write the dated artifact marker. Only called when planes A/B/C passed.
# Atomic (tmp + mv) so a partially-written file is never stat'd as the
# artifact; the heartbeat stats mtime, so mtime IS the run timestamp and the
# body carries the same date for humans.
write_marker() {
  mkdir -p "$(dirname "$MARKER")" 2>/dev/null || true
  local tmp="$MARKER.tmp.$$"
  local e_note=""
  if (( PLANE_E_RAN == 1 )); then
    e_note=" litellm-pg dump+scratch-restore proven"
  fi
  {
    printf '%s OK control plane rebuildable (backup fresh + success, restore + verify proven, fleet files parseable, paths covered%s)\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$e_note"
  } >"$tmp"
  chmod 644 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$MARKER"
  log "D: artifact marker written to $MARKER"
}

# ----------------------------------------------------------------------------
# --check: report whether the drill units + script are installed (no system
# calls). Mirrors oomd-drill --check.
# ----------------------------------------------------------------------------
check_env() {
  local rc=0
  for u in fleet-restore-drill.service fleet-restore-drill.timer; do
    if "$SYSTEMCTL" --user cat "$u" >/dev/null 2>&1; then
      log "ready: $u installed"
    else
      log "MISSING: $u not installed; run ./install.sh from the fleet-ops repo"
      rc=1
    fi
  done
  if [[ -x "$FLEET_OPS_REPO/bin/fleet-restore-drill" ]]; then
    log "ready: bin/fleet-restore-drill present"
  else
    log "MISSING: bin/fleet-restore-drill"
    rc=1
  fi
  return "$rc"
}

# ----------------------------------------------------------------------------
# main
# ----------------------------------------------------------------------------
run_drill() {
  log "fleet restore drill starting (repo=$FLEET_OPS_REPO staleness=${STALENESS_HOURS}h)"
  local rc=0 rebuild_ok=1
  plane_a_backup_mechanism || rc=1
  plane_b_fleet_files || rc=1
  plane_c_backup_coverage || rc=1
  plane_e_litellm_pg || rc=1
  (( rc == 0 )) || rebuild_ok=0
  plane_d_artifact_freshness || rc=1
  # The marker is refreshed whenever the rebuild planes (A/B/C/E) passed —
  # including a run whose plane D failed for a missing/stale marker. That is
  # the self-heal: a transiently absent/old marker trips one LOUD failure and
  # is rewritten, so the next 6h cycle goes green; a marker write that keeps
  # failing is an aborting script error (set -e) that stays escalated. A run
  # where a rebuild plane failed must NOT refresh the marker.
  if (( rebuild_ok == 1 )); then
    write_marker
  fi
  if (( rc == 0 )); then
    loud "RESTORE-DRILL-OK" "control plane rebuildable: backup fresh + success, restore + verify proven, fleet files parseable, paths covered by restic, artifact marker fresh"
    log "PASS: control plane rebuild story proven"
    exit 0
  fi
  log "FAIL: one or more planes failed (see LOUD lines)"
  exit 1
}

case "${1:-}" in
  --check) check_env;;
  "")      run_drill;;
  *)       log "usage: fleet-restore-drill [--check]"; exit 2;;
esac
