#!/usr/bin/env bash
set -uo pipefail
# shellcheck disable=SC1091
. /home/nish/.local/bin/vps-maintenance-lib
exec > >(tee "$STATE/post-reboot.log") 2>&1

# --------------------------------------------------------------- NO-REBOOT PATH
# fleet-ops#3994: when the maintenance window ran but did NOT reboot (no
# resume-after-boot marker), the service used to exit 0 silently. That let a
# surviving /var/run/reboot-required flag go unnoticed for hours when the
# window failed (e.g. 203/EXEC, fleet-ops#3829) — the deadman resumes agents
# but never checks the reboot flag. Now: if the window is no longer in
# progress (pause flag clear) and reboot-required is still set, surface it
# loudly so it is never missed between the window and the next THOROUGH pass.
STREAK_FILE="$STATE/reboot-required-streak"
if [ ! -f "$STATE/resume-after-boot" ]; then
  if agent-maintenance-status >/dev/null 2>&1; then
    # Pause flag is clear -> window finished (success or failure). Check the
    # reboot flag it was supposed to clear.
    if [ -f /var/run/reboot-required ]; then
      PKGS_R=$(tr '\n' ' ' < /var/run/reboot-required.pkgs 2>/dev/null)
      # fleet-ops#4116: count consecutive windows the flag has survived. The
      # first survival is the routine urgent from #3994; a SECOND consecutive
      # survival means the window is NOT consuming the flag — escalate loud
      # instead of paging the same message every Sunday in the noise.
      streak=$([ -f "$STREAK_FILE" ] && cat "$STREAK_FILE" || echo 0)
      streak=$((streak + 1))
      printf '%s\n' "$streak" > "$STREAK_FILE"
      DECLINE=""
      [ -f "$STATE/reboot-declined-reason" ] && DECLINE=" $(head -1 "$STATE/reboot-declined-reason")"
      if [ "$streak" -ge 2 ]; then
        say "REBOOT-REQUIRED SURVIVED TWO CONSECUTIVE WINDOWS (fleet-ops#4116)"
        note "kernel running: $(uname -r)"
        note "consecutive surviving windows: $streak"
        note "reboot-required.pkgs: ${PKGS_R:-<unknown>}"
        note "window decline reason:${DECLINE:- <none recorded>}"
        note "the Sunday window ran but the flag survived twice — check $STATE/update.log and vps-weekly-update.service; this WILL recur weekly until resolved"
        broadcast "MAINTENANCE: reboot-required survived TWO consecutive windows on $(hostname) — the flag is NOT being consumed. kernel=$(uname -r), pending: ${PKGS_R:-unknown}. Investigate vps-weekly-update.service."
        notify urgent "VPS $(hostname): reboot-required flag survived TWO consecutive maintenance windows (streak=$streak)! kernel=$(uname -r), pending: ${PKGS_R:-unknown}. Decline reason:${DECLINE:- <none recorded>}. The Sunday window is not consuming the flag — investigate vps-weekly-update.service. Log: $STATE/update.log" || true
        exit 1
      fi
      say "REBOOT-REQUIRED SURVIVED THE MAINTENANCE WINDOW (fleet-ops#3994)"
      note "kernel running: $(uname -r)"
      note "reboot-required.pkgs: ${PKGS_R:-<unknown>}"
      note "consecutive surviving windows: $streak of 2 — the NEXT survival escalates loud (fleet-ops#4116)"
      note "the window did not reboot — check $STATE/update.log and the vps-weekly-update.service journal"
      notify urgent "VPS $(hostname): reboot-required flag survived the maintenance window (consecutive=$streak/2). kernel=$(uname -r), pending: ${PKGS_R:-unknown}. The Sunday window did not reboot — check vps-weekly-update.service. If the flag survives one more window this escalates loud." || true
      exit 1
    fi
    # Flag cleared (rebooted or resolved) — reset the consecutive-window streak.
    rm -f "$STREAK_FILE" "$STATE/reboot-declined-reason"
    note "no resume marker, no reboot-required flag — window completed clean (fleet-ops#3994, streak reset)"
  else
    note "maintenance window still in progress (pause flag set) — skipping reboot-required check (fleet-ops#3994)"
  fi
  exit 0
fi

say "POST-REBOOT RESUME"
FAIL=()

# Enabled timers return on their own at boot. Only the active-but-disabled ones need a nudge.
if [ -s "$STATE/paused-timers-not-enabled" ]; then
  mapfile -t T < "$STATE/paused-timers-not-enabled"
  start_units "${T[@]}" || FAIL+=("timers that would not restart: ${START_FAILED[*]}")
fi
if [ -s "$STATE/paused-paths" ]; then
  mapfile -t P < "$STATE/paused-paths"
  start_units "${P[@]}" || FAIL+=("path units that would not restart: ${START_FAILED[*]}")
fi
start_units "${HOLD_SERVICES[@]}" || FAIL+=("hold services that would not restart: ${START_FAILED[*]}")

# --------------------------------------------------------------- TAILSCALE RECOVER
# apt upgrades tailscale; if tailscaled is down post-reboot, RECOVER it (not just announce).
# SSH to this box is Tailscale-only — this is the only path in.
say "TAILSCALE RECOVER"
if ! sudo -n tailscale status >/dev/null 2>&1; then
  note "tailscale DOWN — attempting recover (re-enable + restart tailscaled)"
  sudo -n systemctl enable --now tailscaled.service 2>&1 | tee -a "$STATE/post-reboot.log" || true
  # LEGAL-BRAKE: hardware — wait for tailscaled to come back up after re-enable/restart
  sleep 5
  if ! sudo -n tailscale status >/dev/null 2>&1; then
    # Harder recover: tailscale up --reset (non-interactive, uses auth key if configured)
    note "tailscale still down — attempting 'tailscale up --reset'"
    sudo -n tailscale up --reset 2>&1 | tee -a "$STATE/post-reboot.log" || true
    # LEGAL-BRAKE: hardware — wait for tailscale up --reset to re-establish the network path
    sleep 5
  fi
  if ! sudo -n tailscale status >/dev/null 2>&1; then
    FAIL+=("tailscale DOWN after recover attempts — SSH path at risk")
  else
    note "tailscale RECOVERED via re-enable/restart/up"
  fi
else
  note "tailscale UP — no recover needed"
fi
# --------------------------------------------------------------- END TAILSCALE RECOVER

set_flag clear '' ''
rm -f "$STATE/resume-after-boot" "$STATE/reboot-required-streak" "$STATE/reboot-declined-reason"

# LEGAL-BRAKE: hardware — let boot-time units settle before judging them
sleep 30  # let boot-time units settle before judging them
UF=$(systemctl --user list-units --state=failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')
SF=$(systemctl        list-units --state=failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')
[ -n "$UF" ] && FAIL+=("failed user units: $UF")
[ -n "$SF" ] && FAIL+=("failed system units: $SF")
sudo -n tailscale status >/dev/null 2>&1 || FAIL+=("tailscale DOWN — SSH path at risk")

if [ ${#FAIL[@]} -gt 0 ]; then
  notify urgent "VPS REBOOT RECOVERY FAILED on $(hostname): $(printf '%s; ' "${FAIL[@]}") — log: $STATE/post-reboot.log"
  exit 1
fi
notify routine "VPS rebooted cleanly after weekly update. kernel=$(uname -r), agents resumed, 0 failed units."
