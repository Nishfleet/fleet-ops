#!/usr/bin/env bash
# fleet-escalation-canary — coverage canary for the escalation matrix
# (fleet-ops#152).
#
# Proves the invariant "every failure path lands in the escalation matrix,
# mechanically" on TWO planes, every heartbeat tick:
#
#   VPS plane (blocks 1-5):
#     1. Every loaded user .service, .path, and .timer is covered by the
#        matching type drop-in (service.d / path.d / timer.d —
#        OnFailure contains unit-escalation@<unit>.service) OR appears on
#        the explicit anti-recursion exclusion list. service.d does not
#        apply to path or timer units (fleet-ops#618).
#     2. No fleet execution path exists outside a systemd unit: only the
#        sanctioned bin wrappers invoke `pi --print --provider` directly.
#     3. Terminal delivery (#76/#428): dead-man ping (healthchecks.io on a
#        successful heartbeat tick), failed-unit triage (no hermes page after
#        a failed repair), and seat-health freshness (observed_at < 90min,
#        else trigger pi-transport-check). Wired when lib/heartbeat-watchman.sh
#        defines the three functions AND bin/fleet-heartbeat + tier1 wire them
#        AND the service loads hc.env via EnvironmentFile. A marker file still
#        suppresses the finding; missing wiring = standing loud PENDING.
#     4. Red-CI-on-ownerless-PR coverage (#124). Until #124's guard marker is
#        present, a standing loud PENDING finding.
#     5. system-scope fleet artifacts are documented as kernel/oomd-supervised
#        exclusions (no user-manager OnFailure by design).
#
#   GitHub plane (blocks 6-8) — scope addition 2026-08-26: the invariant is
#   TWO planes, not one. A red check on a repo with no coverage path is a
#   loud canary finding.
#     6. auto-revert / red-on-main coverage: fleet-ops ships auto-revert.yml
#        (self-coverage for main-push red) and the reusable
#        red-on-main-detector.yml (other repos wire it). Missing = VIOLATION.
#     7. #124 redispatch coverage: every intake-enrolled repo that can produce
#        claim PRs must be in fleet-repos.json claim_repos (or on the GitHub-
#        plane exclusion list). A repo whose red claim PRs are not scanned by
#        fleet-heartbeat-red-pr-repair = VIOLATION.
#     8. red-check -> senior-auditor bridge: the path for a red check on a PR
#        whose worker is still live (so #124 does not fire) and not on main
#        (so auto-revert does not fire). Wired when the bridge workflow and
#        detector script are present in the repo; the marker override is still
#        honored so tests and manual suppression keep working.
#     9. Rule-enforcement coverage (fleet-ops#383): every vault standing rule
#        and ledger decision names a live enforcer in
#        config/rule-enforcement.json. Missing or stale queued = VIOLATION;
#        uncovered rules and queued rows owned by an umbrella tracker
#        auto-file a distinct mechanism issue, deduped by signal key, cap per tick.
#        When a previously auto-filed source is now `enforced`, the canary
#        comments `canary-covered:` on the open issue (observe-to-close).
#    10. Backup staleness (fleet-ops#388): restic-r2-backup.timer active and
#        fresh (body of the canary, after the GitHub plane).
#    11. Vault sync-conflict handler (fleet-ops#529): vault-conflict-resolver
#        timer is active, last Result=success, and a fixture *.sync-conflict-*
#        file is planted and must clear. Missing handler = the 2026-08-23 wipe.
#
# Required-check enumeration note: authoritatively listing each repo's
# required_status_checks needs branch-protection read (Administration scope),
# which the worker GH_TOKEN deliberately lacks. So the GitHub plane verifies
# the coverage LAYERS are wired per repo rather than enumerating checks: with
# auto-revert (main-push red) + #124 (orphaned red PRs) + the bridge
# (live-worker red PRs) all wired, no red-check path can escape the matrix.
# That is the structurally complete proof the canary makes.
#
# The canary is run by fleet-heartbeat-tier1 on every tick. It fails loud
# (exit 1) on real violations, exits 0 when the only findings are the
# documented pending holes (#76 delivery, #124 guard, #152 bridge), and logs
# every check to stderr + the heartbeat triage file.
#
# Anti-recursion: the canary runs inside fleet-heartbeat.service, which is
# itself covered by the global unit-escalation drop-in. The canary never
# creates its own unit or OnFailure path, so it cannot feed its own failure
# back into itself.
#
# Environment seams (tests):
#   SYSTEMCTL                         default systemctl
#   GH                                default gh
#   FLEET_OPS_REPO                    path to fleet-ops checkout
#   FLEET_HEARTBEAT_TRIAGE            heartbeat triage file
#   AGENT_STATE                       /home/nish/workspaces/agent-state
#   FLEET_INTAKE_REPOS_JSON           config/intake-repos.json source
#   FLEET_REDPR_REPOS_JSON            fleet-repos.json (claim_repos) source
#   FLEET_ESCALATION_CANARY_DELIVERY  marker file for #76 delivery
#   FLEET_ESCALATION_CANARY_REDCI     marker file for #124 guard
#   FLEET_ESCALATION_CANARY_BRIDGE    marker file for the #152 bridge
#   FLEET_STANDING_RULES              vault global-standing-rules.md
#   FLEET_DECISIONS_LEDGER            vault decisions-ledger.md
#   FLEET_RULE_ENFORCEMENT_JSON       config/rule-enforcement.json
#   FLEET_RULE_ENFORCEMENT_LIB        lib/rule-enforcement.py
#   FLEET_RULE_ENFORCEMENT_FILE_ISSUES  1 (default) auto-file uncovered rules; 0 skips
#   FLEET_RULE_ENFORCEMENT_CLOSE_ISSUES 1 (default) close mechanism issues once the
#                                       canary has reported them covered (observe-
#                                       to-close); 0 skips the close step.
#   FLEET_RULE_ENFORCEMENT_ISSUE_REPO   Nishfleet/fleet-ops
#   FLEET_RULE_ENFORCEMENT_UMBRELLA_ISSUES comma-separated issue numbers that are
#                                       umbrella trackers (e.g. 416). The canary
#                                       auto-files a distinct mechanism issue for
#                                       each queued row owned by an umbrella issue.
#   FLEET_RULE_ENFORCEMENT_NOW          ISO timestamp for queued-age checks (tests)
#   FLEET_ESCALATION_CANARY_SKIP_VAULT_CONFLICT  1 skips block 11 (offline tests)
#   FLEET_VAULT_CONFLICT_TIMER          default vault-conflict-resolver.timer
#   FLEET_VAULT_CONFLICT_SERVICE        default vault-conflict-resolver.service
#   FLEET_VAULT_CONFLICT_RESOLVER       path to lib/vault-conflict-resolver.py
#   FLEET_VAULT_CONFLICT_STALE_HOURS    default 1 (timer fires every 10 min)

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

SYSTEMCTL="${SYSTEMCTL:-systemctl}"
GH="${GH:-gh}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"

# Resolve the repo root from this script's canonical path. When installed as a
# symlink (the normal case) this follows the link to the active checkout.
_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)
FLEET_OPS_REPO="${FLEET_OPS_REPO:-$_canon_repo}"

AGENT_STATE="${AGENT_STATE:-/home/nish/workspaces/agent-state}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-$AGENT_STATE/FLEET-HEARTBEAT-TRIAGE.md}"
DELIVERY_MARKER="${FLEET_ESCALATION_CANARY_DELIVERY:-$AGENT_STATE/.escalation-delivery}"
REDCI_MARKER="${FLEET_ESCALATION_CANARY_REDCI:-$AGENT_STATE/.red-ci-ownerless-guard}"
BRIDGE_MARKER="${FLEET_ESCALATION_CANARY_BRIDGE:-$AGENT_STATE/.red-check-senior-auditor-bridge}"

INTAKE_REPOS_JSON="${FLEET_INTAKE_REPOS_JSON:-$FLEET_OPS_REPO/config/intake-repos.json}"
REDPR_REPOS_JSON="${FLEET_REDPR_REPOS_JSON:-/home/nish/.local/state/fleet-heartbeat/fleet-repos.json}"

STANDING_RULES="${FLEET_STANDING_RULES:-/home/nish/workspaces/tooling/nish-vault/_system/shared-memory/global-standing-rules.md}"
DECISIONS_LEDGER="${FLEET_DECISIONS_LEDGER:-/home/nish/workspaces/tooling/nish-vault/_system/shared-memory/decisions-ledger.md}"
RULE_MATRIX="${FLEET_RULE_ENFORCEMENT_JSON:-$FLEET_OPS_REPO/config/rule-enforcement.json}"
RULE_LIB="${FLEET_RULE_ENFORCEMENT_LIB:-$FLEET_OPS_REPO/lib/rule-enforcement.py}"
if [[ ! -f "$RULE_LIB" && -f "${HOME}/.local/lib/pi-packet/rule-enforcement.py" ]]; then
    RULE_LIB="${HOME}/.local/lib/pi-packet/rule-enforcement.py"
fi
FILE_RULE_ISSUES="${FLEET_RULE_ENFORCEMENT_FILE_ISSUES:-1}"
CLOSE_RULE_ISSUES="${FLEET_RULE_ENFORCEMENT_CLOSE_ISSUES:-1}"
RULE_ISSUE_REPO="${FLEET_RULE_ENFORCEMENT_ISSUE_REPO:-Nishfleet/fleet-ops}"
RULE_NOW="${FLEET_RULE_ENFORCEMENT_NOW:-}"
UMBRELLA_ISSUES_RAW="${FLEET_RULE_ENFORCEMENT_UMBRELLA_ISSUES:-}"
mapfile -t UMBRELLA_ISSUES < <(printf '%s\n' "$UMBRELLA_ISSUES_RAW" | tr ',' '\n' | grep -v '^$' || true)

# Backup-staleness canary (fleet-ops#388). The system restic units are
# readable via `systemctl show` (no sudo); a stale or failed backup is LOUD
# here so it joins the escalation matrix every heartbeat tick. The deeper
# restore drill (bin/fleet-restore-drill) runs on its own 6h timer; this is
# the cheap every-tick freshness signal.
RESTIC_BACKUP_TIMER="${FLEET_RESTIC_BACKUP_TIMER:-restic-r2-backup.timer}"
RESTIC_BACKUP_SERVICE="${FLEET_RESTIC_BACKUP_SERVICE:-restic-r2-backup.service}"
RESTIC_STALENESS_HOURS_DEFAULT=30
RESTIC_STALENESS_HOURS="${FLEET_RESTIC_STALENESS_HOURS:-$RESTIC_STALENESS_HOURS_DEFAULT}"
if ! [[ "$RESTIC_STALENESS_HOURS" =~ ^[0-9]+$ ]]; then
    RESTIC_STALENESS_HOURS="$RESTIC_STALENESS_HOURS_DEFAULT"
fi
readonly RESTIC_STALENESS_HOURS

VAULT_CONFLICT_TIMER="${FLEET_VAULT_CONFLICT_TIMER:-vault-conflict-resolver.timer}"
VAULT_CONFLICT_SERVICE="${FLEET_VAULT_CONFLICT_SERVICE:-vault-conflict-resolver.service}"
VAULT_CONFLICT_STALE_HOURS_DEFAULT=1
VAULT_CONFLICT_STALE_HOURS="${FLEET_VAULT_CONFLICT_STALE_HOURS:-$VAULT_CONFLICT_STALE_HOURS_DEFAULT}"
if ! [[ "$VAULT_CONFLICT_STALE_HOURS" =~ ^[0-9]+$ ]]; then
    VAULT_CONFLICT_STALE_HOURS="$VAULT_CONFLICT_STALE_HOURS_DEFAULT"
fi
readonly VAULT_CONFLICT_STALE_HOURS

log() {
    printf '[%s] [fleet-escalation-canary] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

# Loud lines go to BOTH stderr and the triage file (single page for humans +
# other agents). Format matches fleet-heartbeat-tier1's loud() helper.
loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

# Anti-recursion exclusion list for services. These are part of the escalation
# pipeline itself and must not trigger their own escalation.
#
# resilience-drill-stub*.service: the #455 resurrection plane's throwaway
# test stubs. The drill DELIBERATELY SIGKILLs the stub to prove
# Restart=always brings it back; that intentional kill marks the unit
# Result=signal and fires the global OnFailure=unit-escalation@%n.service
# drop-in. The kill is the drill WORKING, not a real fault — a real
# escalation would be the drill itself failing (exit 1), which still
# escalates normally.
is_escalation_excluded() {
    case "$1" in
        unit-escalation@*)         return 0 ;;
        stop-escalation.*)         return 0 ;;
        ready-work*)               return 0 ;;
        escalation-daily-sweep.*)  return 0 ;;
        resilience-drill-stub*)    return 0 ;;
    esac
    return 1
}

# Sanctioned bin wrappers that are allowed to invoke the pi binary directly.
# New runners must be added here AND wired to a systemd unit template.
SANCTIONED_PI_RUNNERS=(
    agent-cron-run
    fleet-blind-audit
    fleet-console-tile-truth-drill
    fleet-heartbeat-tier2
    fleet-researcher-run
    pi-audit-run
    pi-intake-run
    pi-intake-repair-run
    pi-issue-run
    pi-packet-run
    pi-scout-run
    stop-escalation-dispatch
)

is_sanctioned_pi_runner() {
    local name="$1"
    local r
    for r in "${SANCTIONED_PI_RUNNERS[@]}"; do
        if [[ "$r" == "$name" ]]; then
            return 0
        fi
    done
    return 1
}

# GitHub-plane exclusion list: intake-enrolled repos that are deliberately NOT
# in claim_repos (so #124 does not scan their claim PRs). Each MUST carry a
# reason or the canary treats it as an uncovered violation.
#
# Format: "<repo-slug>|<reason>" — kept inline so the exclusion is legible at
# the point of enforcement, the same discipline as the VPS anti-recursion set.
GITHUB_PLANE_EXCLUDED_REPOS=(
    # (none today — every intake repo that can produce a claim PR must be
    #  covered by #124. Add a line here only with a named reason.)
)

is_github_plane_excluded() {
    local repo="$1"
    local entry
    for entry in "${GITHUB_PLANE_EXCLUDED_REPOS[@]}"; do
        local slug="${entry%%|*}"
        if [[ "$slug" == "$repo" ]]; then
            return 0
        fi
    done
    return 1
}

# The canary scans bin/ for direct pi invocations. It must not scan itself,
# because its own source contains the regex pattern and diagnostic messages.
self_name=$(basename "$0")

# ============================================================================
# main
# ============================================================================
violations=0
pending=0

log "escalation coverage canary starting (repo=$FLEET_OPS_REPO)"

# ---------------------------------------------------------------------------
# 0. repo paths exist
# ---------------------------------------------------------------------------
if [[ ! -d "$FLEET_OPS_REPO/bin" ]]; then
    log "FATAL: bin dir missing in fleet-ops repo: $FLEET_OPS_REPO/bin"
    exit 2
fi

# ---------------------------------------------------------------------------
# 1. loaded user service/path/timer escalation coverage (fleet-ops#618)
# ---------------------------------------------------------------------------
# A service-only type filter is the class that missed fleet-seat-recovery.path
# (unit-start-limit-hit, OnFailure empty). path.d/ and timer.d/ are the
# matching type drop-ins; this block must enumerate all three types.
log "1. checking escalation coverage for loaded user services, paths, and timers"
mapfile -t loaded_units < <(
    "$SYSTEMCTL" --user list-units --type=service,path,timer --no-legend --plain 2>/dev/null \
        | awk '{print $1}' \
        | grep -E '\.(service|path|timer)$' \
        || true
)

for unit in "${loaded_units[@]}"; do
    [[ -n "$unit" ]] || continue

    if is_escalation_excluded "$unit"; then
        log "1.  - $unit: excluded (anti-recursion)"
        continue
    fi

    onf=$("$SYSTEMCTL" --user show "$unit" --property=OnFailure --value 2>/dev/null || true)
    expected="unit-escalation@${unit}.service"

    if [[ -n "$onf" ]] && grep -qF "$expected" <<< "$onf"; then
        log "1.  - $unit: covered ($onf)"
    else
        loud "ESCALATION-CANARY-VIOLATION" "unit=$unit missing escalation drop-in (OnFailure='$onf', expected='$expected')"
        violations=$((violations + 1))
    fi
done

# ---------------------------------------------------------------------------
# 2. no unwrapped pi invocations in bin/
# ---------------------------------------------------------------------------
log "2. checking bin/ for unwrapped pi invocations"
# Match a literal `pi` binary or the $PI / $PI_BIN variables followed by
# `--print`. This deliberately skips comment lines and the canary's own source.
mapfile -t pi_matching < <(
    grep -R -l --exclude="$self_name" \
        -E '^[^#]*(\bpi\b|"\$PI(_BIN)?")[[:space:]]+--print' \
        "$FLEET_OPS_REPO/bin" 2>/dev/null \
        || true
)

for f in "${pi_matching[@]}"; do
    [[ -f "$f" ]] || continue
    name=$(basename "$f")
    if is_sanctioned_pi_runner "$name"; then
        log "2.  - $name: sanctioned pi wrapper"
    else
        loud "ESCALATION-CANARY-VIOLATION" "bin/$name invokes the pi binary directly but is not a sanctioned unit wrapper"
        violations=$((violations + 1))
    fi
done

# ---------------------------------------------------------------------------
# 3. terminal delivery path (#76): dead-man ping + failed-unit pager + seat-health
# ---------------------------------------------------------------------------
# Observes the REAL wiring in the fleet-ops repo, not just a marker. The
# delivery is wired when ALL of these hold:
#   - lib/heartbeat-watchman.sh defines the three delivery functions
#     (heartbeat_ping_deadman, heartbeat_page_units, heartbeat_seat_health_check)
#   - bin/fleet-heartbeat wires the dead-man ping (healthchecks.io on success)
#   - bin/fleet-heartbeat-tier1 wires the failed-unit pager (heartbeat_page_units)
#     + seat-health freshness (heartbeat_seat_health_check)
#   - systemd/fleet-heartbeat.service loads hc.env (HC_URL) via EnvironmentFile
# A marker file still suppresses the finding (escape hatch for environments
# where the wiring lives outside the repo). Missing wiring = loud PENDING,
# matching the bridge block's contract.
log "3. checking terminal delivery path (#76)"
watchman_lib="$FLEET_OPS_REPO/lib/heartbeat-watchman.sh"
heartbeat_bin="$FLEET_OPS_REPO/bin/fleet-heartbeat"
tier1_bin="$FLEET_OPS_REPO/bin/fleet-heartbeat-tier1"
heartbeat_svc="$FLEET_OPS_REPO/systemd/fleet-heartbeat.service"
if [[ -f "$DELIVERY_MARKER" ]]; then
    log "3.  - delivery marker present: $DELIVERY_MARKER"
elif [[ -f "$watchman_lib" ]] \
    && grep -q 'heartbeat_ping_deadman' "$watchman_lib" 2>/dev/null \
    && grep -q 'heartbeat_page_units' "$watchman_lib" 2>/dev/null \
    && grep -q 'heartbeat_seat_health_check' "$watchman_lib" 2>/dev/null \
    && [[ -f "$heartbeat_bin" ]] \
    && grep -q 'heartbeat_ping_deadman' "$heartbeat_bin" 2>/dev/null \
    && [[ -f "$tier1_bin" ]] \
    && grep -q 'heartbeat_page_units' "$tier1_bin" 2>/dev/null \
    && grep -q 'heartbeat_seat_health_check' "$tier1_bin" 2>/dev/null \
    && [[ -f "$heartbeat_svc" ]] \
    && grep -qi 'EnvironmentFile=.*hc\.env' "$heartbeat_svc" 2>/dev/null; then
    log "3.  - delivery wired: watchman lib + heartbeat dead-man + tier1 pager/seat-health + hc.env EnvironmentFile"
else
    loud "ESCALATION-CANARY-PENDING" "terminal delivery not wired (#76) — dead-man ping, failed-unit pager, or seat-health freshness wiring missing in fleet-ops (marker, watchman lib, heartbeat/tier1 wiring, or hc.env EnvironmentFile absent)"
    pending=$((pending + 1))
fi

# ---------------------------------------------------------------------------
# 4. red-CI-on-ownerless-PR coverage (#124 pending)
# ---------------------------------------------------------------------------
log "4. checking red-CI ownerless-PR coverage"
if [[ -f "$REDCI_MARKER" ]]; then
    log "4.  - red-CI ownerless guard present: $REDCI_MARKER"
else
    loud "ESCALATION-CANARY-PENDING" "red-CI-on-ownerless-PR coverage pending (#124) — failing fleet PRs with no live worker are not yet re-dispatched"
    pending=$((pending + 1))
fi

# ---------------------------------------------------------------------------
# 5. system-scope fleet artifacts — documented as kernel/oomd-supervised
# ---------------------------------------------------------------------------
log "5. documenting system-scope exclusions (kernel/oomd-supervised)"
loud "ESCALATION-CANARY-EXCLUDED" "system-scope fleet artifacts are kernel/oomd-supervised, not user-manager OnFailure: user-1000.slice (50-ram-governor), user@1000.service (50-no-distro-oomd-kill)"

# ---------------------------------------------------------------------------
# 6. GitHub plane — auto-revert / red-on-main coverage (main-push red)
# ---------------------------------------------------------------------------
log "6. checking GitHub plane: auto-revert / red-on-main coverage"
auto_revert_wf="$FLEET_OPS_REPO/.github/workflows/auto-revert.yml"
red_main_wf="$FLEET_OPS_REPO/.github/workflows/red-on-main-detector.yml"
if [[ -f "$auto_revert_wf" ]] && grep -q 'workflow_run:' "$auto_revert_wf" 2>/dev/null; then
    log "6.  - auto-revert.yml present and wired to workflow_run (fleet-ops self-coverage for main-push red)"
else
    loud "ESCALATION-CANARY-VIOLATION" "GitHub plane: auto-revert.yml missing or not wired to workflow_run — main-push red on fleet-ops has no automatic revert"
    violations=$((violations + 1))
fi
if [[ -f "$red_main_wf" ]] && grep -q 'workflow_call:' "$red_main_wf" 2>/dev/null; then
    log "6.  - red-on-main-detector.yml present as a reusable workflow (other repos wire it for first-run-red alerts)"
else
    loud "ESCALATION-CANARY-VIOLATION" "GitHub plane: red-on-main-detector.yml missing or not a reusable workflow — other repos cannot wire first-run-red alerts"
    violations=$((violations + 1))
fi

# ---------------------------------------------------------------------------
# 7. GitHub plane — #124 redispatch covers every intake-enrolled repo
# ---------------------------------------------------------------------------
log "7. checking GitHub plane: #124 redispatch covers every intake repo"
if [[ ! -f "$INTAKE_REPOS_JSON" ]]; then
    loud "ESCALATION-CANARY-VIOLATION" "GitHub plane: intake-repos.json missing at $INTAKE_REPOS_JSON — cannot verify #124 coverage of enrolled repos"
    violations=$((violations + 1))
else
    if ! command -v jq >/dev/null 2>&1; then
        loud "ESCALATION-CANARY-VIOLATION" "GitHub plane: jq missing — cannot parse intake-repos.json / fleet-repos.json"
        violations=$((violations + 1))
    else
        # intake-enrolled repo slugs (Nishfleet/<name>).
        mapfile -t intake_repos < <(
            jq -r '.repos[]? | "Nishfleet/\(.name)"' "$INTAKE_REPOS_JSON" 2>/dev/null || true
        )
        # claim_repos that #124 actually scans. If the state file is missing
        # the coverage set is unreadable — report PENDING and SKIP the per-repo
        # check rather than flagging every repo as uncovered (a missing state
        # file is a heartbeat-not-yet-run condition, not a coverage gap).
        if [[ ! -f "$REDPR_REPOS_JSON" ]]; then
            loud "ESCALATION-CANARY-PENDING" "GitHub plane: fleet-repos.json missing at $REDPR_REPOS_JSON — #124 coverage set unreadable (heartbeat has not written it yet)"
            pending=$((pending + 1))
        else
            declare -A claim_set=()
            while IFS= read -r cr; do
                [[ -n "$cr" ]] && claim_set["$cr"]=1
            done < <(jq -r '.claim_repos[]?' "$REDPR_REPOS_JSON" 2>/dev/null || true)

            for repo in "${intake_repos[@]}"; do
                [[ -n "$repo" ]] || continue
                if is_github_plane_excluded "$repo"; then
                    log "7.  - $repo: excluded from #124 (deliberate, see list)"
                    continue
                fi
                if [[ "${claim_set[$repo]:-0}" == "1" ]]; then
                    log "7.  - $repo: covered by #124 redispatch (in claim_repos)"
                else
                    loud "ESCALATION-CANARY-VIOLATION" "GitHub plane: $repo is intake-enrolled (can produce claim PRs) but NOT in fleet-repos.json claim_repos — its orphaned red PRs escape #124 redispatch"
                    violations=$((violations + 1))
                fi
            done
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 8. GitHub plane — red-check -> senior-auditor bridge (live-worker red PRs)
# ---------------------------------------------------------------------------
log "8. checking GitHub plane: red-check -> senior-auditor bridge"
bridge_wf="$FLEET_OPS_REPO/.github/workflows/ci-failure-escalation.yml"
bridge_script="$FLEET_OPS_REPO/.github/scripts/ci-failure-escalation-detector.mjs"
if [[ -f "$BRIDGE_MARKER" ]]; then
    log "8.  - bridge marker present: $BRIDGE_MARKER"
elif [[ -f "$bridge_wf" ]] && [[ -f "$bridge_script" ]]; then
    log "8.  - bridge wired: $bridge_wf + $bridge_script"
else
    loud "ESCALATION-CANARY-PENDING" "red-check -> senior-auditor bridge not wired (#152 scope addition) — a red check on a PR whose worker is still live (so #124 does not fire) and not on main (so auto-revert does not fire) has no automatic path to a senior auditor yet"
    pending=$((pending + 1))
fi

# ---------------------------------------------------------------------------
# 9. Rule-enforcement coverage (fleet-ops#383)
# ---------------------------------------------------------------------------
# Parse vault `## ` headings + ledger dated decisions, join against
# config/rule-enforcement.json. Any rule with no entry, an invalid row, or
# queued(#N) older than queued_stale_days is a LOUD violation. Uncovered
# rules auto-file a mechanism issue (deduped by signal key), cap per tick.
# Enforced rows with an open mechanism issue get a `canary-covered:` comment
# (observe-to-close; fleet-ops#479).
log "9. checking rule-enforcement coverage against vault standing rules + ledger"
if [[ ! -f "$RULE_MATRIX" ]]; then
    loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: matrix missing at $RULE_MATRIX — no standing rule can name its enforcer"
    violations=$((violations + 1))
elif [[ ! -f "$RULE_LIB" ]]; then
    loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: join helper missing at $RULE_LIB"
    violations=$((violations + 1))
elif [[ ! -f "$STANDING_RULES" ]] || [[ ! -f "$DECISIONS_LEDGER" ]]; then
    loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: vault files missing (rules=$STANDING_RULES ledger=$DECISIONS_LEDGER) — coverage cannot be proven"
    violations=$((violations + 1))
elif ! command -v python3 >/dev/null 2>&1; then
    loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: python3 missing — cannot join vault rules against the matrix"
    violations=$((violations + 1))
else
    join_args=(join --rules "$STANDING_RULES" --ledger "$DECISIONS_LEDGER" --matrix "$RULE_MATRIX")
    if [[ -n "$RULE_NOW" ]]; then
        join_args+=(--now "$RULE_NOW")
    fi
    set +e
    rule_report=$(python3 "$RULE_LIB" "${join_args[@]}" 2>/tmp/rule-enforcement-join.err)
    join_rc=$?
    set -e
    if [[ -z "$rule_report" ]] || ! jq -e . >/dev/null 2>&1 <<<"$rule_report"; then
        loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: join helper produced no JSON (rc=$join_rc) $(tr '\n' ' ' </tmp/rule-enforcement-join.err 2>/dev/null)"
        violations=$((violations + 1))
    else
        uncovered_n=$(jq '.uncovered | length' <<<"$rule_report")
        queued_n=$(jq '.queued | length' <<<"$rule_report")
        stale_n=$(jq '.stale_queued | length' <<<"$rule_report")
        malformed_n=$(jq '.malformed | length' <<<"$rule_report")
        extra_n=$(jq '.extra_matrix | length' <<<"$rule_report")
        covered_n=$(jq '.covered' <<<"$rule_report")
        vault_n=$(jq '.vault_rule_count' <<<"$rule_report")

        while IFS= read -r src; do
            [[ -n "$src" ]] || continue
            loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: uncovered rule has no matrix entry: $src"
            violations=$((violations + 1))
        done < <(jq -r '.uncovered[].source' <<<"$rule_report")

        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: queued row older than stale window: $line"
            violations=$((violations + 1))
        done < <(jq -r '.stale_queued[] | "\(.id) issue=#\(.issue) queued_since=\(.queued_since) age_days=\(.age_days)"' <<<"$rule_report")

        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            loud "ESCALATION-CANARY-VIOLATION" "rule-enforcement: malformed matrix row: $line"
            violations=$((violations + 1))
        done < <(jq -r '.malformed[] | "\(.id // "unknown") \(.reason)"' <<<"$rule_report")

        while IFS= read -r src; do
            [[ -n "$src" ]] || continue
            loud "ESCALATION-CANARY-PENDING" "rule-enforcement: matrix entry has no matching vault rule (rename or delete it): $src"
            pending=$((pending + 1))
        done < <(jq -r '.extra_matrix[].source' <<<"$rule_report")

        # Auto-file uncovered/queued-umbrella issues, then observe-to-close
        # enforced rows (fleet-ops#479). Listing runs even when uncovered_n=0
        # so a green join can still comment on leftover mechanism tickets.
        if [[ "$FILE_RULE_ISSUES" == "1" ]]; then
            cap=$(jq '.auto_file_cap_per_tick' <<<"$rule_report")
            filed=0
            skipped_dup=0
            skipped_cap=0
            open_json="[]"
            if command -v "$GH" >/dev/null 2>&1; then
                set +e
                open_json=$("$GH" issue list -R "$RULE_ISSUE_REPO" --state open --limit 200 --json number,body,title 2>/dev/null)
                gh_list_rc=$?
                set -e
                if [[ "$gh_list_rc" -ne 0 ]] || [[ -z "$open_json" ]]; then
                    open_json="[]"
                    log "9.  WARN: could not list open issues for dedupe (gh rc=$gh_list_rc)"
                fi
            else
                log "9.  WARN: gh missing — cannot auto-file or observe-to-close mechanism issues"
            fi

            if [[ "$uncovered_n" -gt 0 ]] || { [[ "$queued_n" -gt 0 ]] && [[ ${#UMBRELLA_ISSUES[@]} -gt 0 ]]; }; then
            declare -A UMBRELLA_MAP=()
            for u in "${UMBRELLA_ISSUES[@]}"; do
                [[ -n "$u" ]] && UMBRELLA_MAP["$u"]=1
            done

            file_item() {
                local item="$1"
                local context="$2"
                local rid issue_n signal title body created create_rc
                rid=$(jq -r '.id' <<<"$item")
                signal="signal: rule-enforcement/${rid}"
                if jq -e --arg s "$signal" '[.[] | select((.body // "") | contains($s))] | length > 0' <<<"$open_json" >/dev/null 2>&1; then
                    skipped_dup=$((skipped_dup + 1))
                    log "9.  - $rid: already has an open mechanism issue (deduped)"
                    return 0
                fi
                if [[ "$filed" -ge "$cap" ]]; then
                    skipped_cap=$((skipped_cap + 1))
                    return 0
                fi
                title=$(python3 "$RULE_LIB" issue-title --json "$item")
                body=$(python3 "$RULE_LIB" issue-body --json "$item")
                if command -v "$GH" >/dev/null 2>&1; then
                    set +e
                    created=$("$ISSUE_FILE" file -R "$RULE_ISSUE_REPO" --title "$title" --body "$body" 2>/tmp/rule-enforcement-create.err)
                    create_rc=$?
                    set -e
                    if [[ "$create_rc" -eq 0 ]]; then
                        filed=$((filed + 1))
                        log "9.  FILED $context/$rid -> $created"
                    else
                        log "9.  WARN: failed to file $context/$rid (rc=$create_rc) $(tr '\n' ' ' </tmp/rule-enforcement-create.err 2>/dev/null)"
                    fi
                fi
            }

            while IFS= read -r item; do
                [[ -n "$item" ]] || continue
                file_item "$item" "uncovered"
            done < <(jq -c '.uncovered[]' <<<"$rule_report")

            while IFS= read -r item; do
                [[ -n "$item" ]] || continue
                issue_n=$(jq -r '.issue' <<<"$item")
                if [[ "${UMBRELLA_MAP[$issue_n]:-0}" == "1" ]]; then
                    file_item "$item" "queued"
                fi
            done < <(jq -c '.queued[]' <<<"$rule_report")

            if [[ "$skipped_cap" -gt 0 ]]; then
                loud "ESCALATION-CANARY-PENDING" "rule-enforcement: auto-file cap reached (filed=$filed cap=$cap remaining=$skipped_cap) — next tick continues"
                pending=$((pending + 1))
            fi
            log "9.  auto-file: filed=$filed deduped=$skipped_dup cap-skipped=$skipped_cap"
            fi

            observed=0
            skipped_obs=0
            if command -v "$GH" >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
                _rep="/tmp/rule-enforcement-report.$$.json"
                _iss="/tmp/rule-enforcement-open.$$.json"
                printf '%s\n' "$rule_report" >"$_rep"
                printf '%s\n' "$open_json" >"$_iss"
                set +e
                targets=$(python3 "$RULE_LIB" observe-targets --report "$_rep" --issues "$_iss")
                obs_rc=$?
                set -e
                rm -f "$_rep" "$_iss"
                if [[ "$obs_rc" -eq 0 ]] && jq -e . >/dev/null 2>&1 <<<"${targets:-}"; then
                    while IFS= read -r target; do
                        [[ -n "$target" ]] || continue
                        obs_num=$(jq -r '.number' <<<"$target")
                        obs_id=$(jq -r '.id' <<<"$target")
                        obs_marker=$(jq -r '.marker' <<<"$target")
                        obs_body=$(jq -r '.body' <<<"$target")
                        [[ -n "$obs_num" && "$obs_num" != "null" ]] || continue
                        set +e
                        view_json=$("$GH" issue view "$obs_num" -R "$RULE_ISSUE_REPO" --json comments 2>/dev/null)
                        view_rc=$?
                        set -e
                        if [[ "$view_rc" -eq 0 ]] && jq -e --arg m "$obs_marker" '[.comments[]?.body // empty | select(contains($m))] | length > 0' <<<"$view_json" >/dev/null 2>&1; then
                            skipped_obs=$((skipped_obs + 1))
                            log "9.  - #$obs_num: already has canary-covered comment (deduped)"
                            continue
                        fi
                        set +e
                        "$GH" issue comment "$obs_num" -R "$RULE_ISSUE_REPO" --body "$obs_body" >/tmp/rule-enforcement-comment.err 2>&1
                        comment_rc=$?
                        set -e
                        if [[ "$comment_rc" -eq 0 ]]; then
                            observed=$((observed + 1))
                            log "9.  OBSERVED-COVERED $obs_id -> #$obs_num"
                        else
                            log "9.  WARN: failed to comment #$obs_num (rc=$comment_rc) $(tr '\n' ' ' </tmp/rule-enforcement-comment.err 2>/dev/null)"
                        fi
                    done < <(jq -c '.[]' <<<"$targets")
                fi
            fi
            log "9.  observe-to-close: commented=$observed already-observed=$skipped_obs"

            # Observe-to-close close step (fleet-ops#362/#521): once a
            # mechanism issue carries the `canary-covered:` marker from a
            # prior tick AND its rule is `enforced`, close it as completed.
            # The marker-from-a-prior-tick requirement makes the close
            # evidence-backed — the canary reported green on a real tick, and
            # this observing tick closes. Without this, a mechanism PR whose
            # body missed `Closes #N` leaves a covered issue stuck open
            # forever (the #521 gap).
            closed=0
            close_skipped=0
            if [[ "$CLOSE_RULE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
                _crep="/tmp/rule-enforcement-report-close.$$.json"
                _ciss="/tmp/rule-enforcement-open-close.$$.json"
                printf '%s\n' "$rule_report" >"$_crep"
                set +e
                # `comments` is a supported gh issue list field; one call
                # carries both body (for the signal match) and comments
                # (for the canary-covered marker).
                close_json=$("$GH" issue list -R "$RULE_ISSUE_REPO" --state open --limit 200 --json number,body,title,comments 2>/dev/null)
                close_list_rc=$?
                set -e
                if [[ "$close_list_rc" -ne 0 ]] || [[ -z "$close_json" ]]; then
                    close_json="[]"
                    log "9.  WARN: could not list open issues for close (gh rc=$close_list_rc)"
                fi
                printf '%s\n' "$close_json" >"$_ciss"
                set +e
                close_targets=$(python3 "$RULE_LIB" close-targets --report "$_crep" --issues "$_ciss")
                close_rc=$?
                set -e
                rm -f "$_crep" "$_ciss"
                if [[ "$close_rc" -eq 0 ]] && jq -e . >/dev/null 2>&1 <<<"${close_targets:-}"; then
                    while IFS= read -r ct; do
                        [[ -n "$ct" ]] || continue
                        ct_num=$(jq -r '.number' <<<"$ct")
                        ct_id=$(jq -r '.id' <<<"$ct")
                        [[ -n "$ct_num" && "$ct_num" != "null" ]] || continue
                        set +e
                        "$GH" issue close "$ct_num" -R "$RULE_ISSUE_REPO" --reason completed >/tmp/rule-enforcement-close.err 2>&1
                        close_issue_rc=$?
                        set -e
                        if [[ "$close_issue_rc" -eq 0 ]]; then
                            closed=$((closed + 1))
                            log "9.  OBSERVE-CLOSED $ct_id -> #$ct_num (canary-covered + enforced)"
                        else
                            close_skipped=$((close_skipped + 1))
                            log "9.  WARN: failed to close #$ct_num (rc=$close_issue_rc) $(tr '\n' ' ' </tmp/rule-enforcement-close.err 2>/dev/null)"
                        fi
                    done < <(jq -c '.[]' <<<"$close_targets")
                fi
            fi
            log "9.  observe-to-close: closed=$closed skipped=$close_skipped"
        fi

        log "9.  - covered=$covered_n / vault=$vault_n uncovered=$uncovered_n queued=$queued_n stale_queued=$stale_n malformed=$malformed_n extra=$extra_n"
    fi
fi

# ---------------------------------------------------------------------------
# 10. Backup staleness — fleet-ops#388
# ---------------------------------------------------------------------------
# The fleet control plane lives in non-git state (agent-state, pi-packet,
# user-unit install set). Restic backs it up (system unit, sources /home/nish),
# but an unproven backup is decorative (#378). A stale or failed backup is
# LOUD here so it joins the escalation matrix every heartbeat tick. The
# deeper restore drill (bin/fleet-restore-drill, 6h timer) proves the full
# rebuild story; this is the cheap every-tick freshness signal.
#
# FLEET_ESCALATION_CANARY_SKIP_BACKUP=1 skips this block (offline tests).
log "10. checking backup staleness (restic-r2-backup)"
if [[ "${FLEET_ESCALATION_CANARY_SKIP_BACKUP:-0}" == "1" ]]; then
    log "10.  - SKIP (FLEET_ESCALATION_CANARY_SKIP_BACKUP=1)"
else
    _timer_active=$("$SYSTEMCTL" show "$RESTIC_BACKUP_TIMER" --property=ActiveState --value 2>/dev/null || true)
    _timer_last=$("$SYSTEMCTL" show "$RESTIC_BACKUP_TIMER" --property=LastTriggerUSec --value 2>/dev/null || true)
    _backup_result=$("$SYSTEMCTL" show "$RESTIC_BACKUP_SERVICE" --property=Result --value 2>/dev/null || true)
    log "10.  - $RESTIC_BACKUP_TIMER ActiveState=$_timer_active LastTriggerUSec=$_timer_last"
    log "10.  - $RESTIC_BACKUP_SERVICE Result=$_backup_result"
    if [[ "$_timer_active" != "active" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "backup staleness: $RESTIC_BACKUP_TIMER is not active (state=$_timer_active) — the daily backup is not scheduled, control plane is not being captured"
        violations=$((violations + 1))
    elif [[ -z "$_timer_last" ]] || [[ "$_timer_last" == "0" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "backup staleness: $RESTIC_BACKUP_TIMER has never fired — no backup has run"
        violations=$((violations + 1))
    else
        _last_epoch="$(date -d "$_timer_last" +%s 2>/dev/null || true)"
        if [[ -z "$_last_epoch" ]]; then
            loud "ESCALATION-CANARY-VIOLATION" "backup staleness: $RESTIC_BACKUP_TIMER LastTriggerUSec unparseable: '$_timer_last'"
            violations=$((violations + 1))
        else
            _age_h=$(( ( $(date +%s) - _last_epoch ) / 3600 ))
            if (( _age_h > RESTIC_STALENESS_HOURS )); then
                loud "ESCALATION-CANARY-VIOLATION" "backup staleness: $RESTIC_BACKUP_TIMER last fired ${_age_h}h ago — older than ${RESTIC_STALENESS_HOURS}h threshold. The control-plane backup is stale."
                violations=$((violations + 1))
            else
                log "10.  - last backup ${_age_h}h ago (within ${RESTIC_STALENESS_HOURS}h threshold)"
            fi
        fi
    fi
    if [[ "$_backup_result" != "success" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "backup staleness: $RESTIC_BACKUP_SERVICE last Result=$_backup_result (not success) — the last backup run failed"
        violations=$((violations + 1))
    fi
fi

# ---------------------------------------------------------------------------
# 11. Vault sync-conflict handler — fleet-ops#529
# ---------------------------------------------------------------------------
# Freeze-on-conflict is self-clearing only while vault-conflict-resolver.timer
# fires. The 2026-08-23 wipe deleted the timer and the freeze sat until a
# human noticed. This block is the cheap every-tick signal: timer active,
# last Result=success, and a fixture *.sync-conflict-* file must clear.
#
# FLEET_ESCALATION_CANARY_SKIP_VAULT_CONFLICT=1 skips this block (offline tests).
log "11. checking vault-conflict-resolver (sr-vault-sync-conflicts)"
if [[ "${FLEET_ESCALATION_CANARY_SKIP_VAULT_CONFLICT:-0}" == "1" ]]; then
    log "11.  - SKIP (FLEET_ESCALATION_CANARY_SKIP_VAULT_CONFLICT=1)"
else
    _vc_active=$("$SYSTEMCTL" --user show "$VAULT_CONFLICT_TIMER" --property=ActiveState --value 2>/dev/null || true)
    _vc_last=$("$SYSTEMCTL" --user show "$VAULT_CONFLICT_TIMER" --property=LastTriggerUSec --value 2>/dev/null || true)
    _vc_result=$("$SYSTEMCTL" --user show "$VAULT_CONFLICT_SERVICE" --property=Result --value 2>/dev/null || true)
    log "11.  - $VAULT_CONFLICT_TIMER ActiveState=$_vc_active LastTriggerUSec=$_vc_last"
    log "11.  - $VAULT_CONFLICT_SERVICE Result=$_vc_result"
    if [[ "$_vc_active" != "active" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: $VAULT_CONFLICT_TIMER is not active (state=$_vc_active) — *.sync-conflict-* files will freeze the vault with no self-clear"
        violations=$((violations + 1))
    elif [[ -z "$_vc_last" ]] || [[ "$_vc_last" == "0" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: $VAULT_CONFLICT_TIMER has never fired — the handler has not run"
        violations=$((violations + 1))
    else
        _vc_epoch="$(date -d "$_vc_last" +%s 2>/dev/null || true)"
        if [[ -z "$_vc_epoch" ]]; then
            loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: $VAULT_CONFLICT_TIMER LastTriggerUSec unparseable: '$_vc_last'"
            violations=$((violations + 1))
        else
            _vc_age_h=$(( ( $(date +%s) - _vc_epoch ) / 3600 ))
            if (( _vc_age_h > VAULT_CONFLICT_STALE_HOURS )); then
                loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: $VAULT_CONFLICT_TIMER last fired ${_vc_age_h}h ago — older than ${VAULT_CONFLICT_STALE_HOURS}h threshold. The Syncthing conflict handler is not firing."
                violations=$((violations + 1))
            else
                log "11.  - last run ${_vc_age_h}h ago (within ${VAULT_CONFLICT_STALE_HOURS}h threshold)"
            fi
        fi
    fi
    if [[ "$_vc_result" != "success" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: $VAULT_CONFLICT_SERVICE last Result=$_vc_result (not success) — the last resolver run failed"
        violations=$((violations + 1))
    fi
    _vc_resolver="${FLEET_VAULT_CONFLICT_RESOLVER:-}"
    if [[ -z "$_vc_resolver" ]]; then
        if [[ -f "$FLEET_OPS_REPO/lib/vault-conflict-resolver.py" ]]; then
            _vc_resolver="$FLEET_OPS_REPO/lib/vault-conflict-resolver.py"
        elif [[ -x "${HOME}/.local/bin/vault-conflict-resolver" ]]; then
            _vc_resolver="${HOME}/.local/bin/vault-conflict-resolver"
        fi
    fi
    if [[ -z "$_vc_resolver" || ! -f "$_vc_resolver" ]]; then
        loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: resolver missing (looked in $FLEET_OPS_REPO/lib/vault-conflict-resolver.py and ${HOME}/.local/bin/vault-conflict-resolver) — the 2026-08-23 wipe class is back"
        violations=$((violations + 1))
    elif ! command -v python3 >/dev/null 2>&1; then
        loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: python3 missing — cannot run the *.sync-conflict-* fixture canary"
        violations=$((violations + 1))
    else
        _vc_fix=$(mktemp -d -t vault-conflict-canary.XXXXXX)
        _vc_base="$_vc_fix/canary.md"
        _vc_copy="$_vc_fix/canary.sync-conflict-20260827-000000-CANARY.md"
        printf 'same-bytes\n' >"$_vc_base"
        printf 'same-bytes\n' >"$_vc_copy"
        if ! env FLEET_VAULT="$_vc_fix" \
            FLEET_VAULT_CONFLICT_LOG="$_vc_fix/resolver.log" \
            FLEET_VAULT_CONFLICT_DISPATCH="/bin/true" \
            python3 "$_vc_resolver" >/dev/null 2>&1; then
            loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: fixture resolver exited non-zero"
            violations=$((violations + 1))
        elif [[ -e "$_vc_copy" ]]; then
            loud "ESCALATION-CANARY-VIOLATION" "vault-conflict: fixture *.sync-conflict-* still present after resolver — handler did not fire"
            violations=$((violations + 1))
        else
            log "11.  - fixture *.sync-conflict-* cleared"
        fi
        rm -rf "$_vc_fix"
    fi
fi

# ---------------------------------------------------------------------------
# done
# ---------------------------------------------------------------------------
if [[ "$violations" -gt 0 ]]; then
    loud "ESCALATION-CANARY-FAIL" "violations=$violations pending=$pending — escalation matrix is not fully covered (two-plane invariant)"
    exit 1
fi

loud "ESCALATION-CANARY-OK" "two-plane invariant holds: VPS services/paths/timers + pi runners covered; GitHub coverage layers wired; pending=$pending"
exit 0
