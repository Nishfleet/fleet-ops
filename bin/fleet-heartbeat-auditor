#!/usr/bin/env bash
# bin/fleet-heartbeat-auditor
#
# Drives the senior-auditor admission panel. Each heartbeat tick:
#   1. List open scout-candidate issues per enrolled repo.
#   2. For each candidate, ensure the three pi-audit@ units exist or start
#      any missing one (devin, free-glm-5-3, senior).
#   3. If a needed unit is failed (StartLimitBurst exhausted), reset-failed
#      then start it so a recovered seat is not wedged for the remaining
#      StartLimitIntervalSec (fleet-ops#616).
#   4. If all three votes are present, call pi-audit-tally to admit/discard.
#   5. If a candidate is pending for more than one tick with no active audit
#      unit, write a loud AUDITOR-PANEL-PENDING finding.
#
# Invoked by fleet-heartbeat-tier1 block 4b. No hand-rolled polling. The
# heartbeat's 30-minute timer is the only schedule; unit execution and
# retry are owned by systemd (Restart=, the global OnFailure ladder).
# Votes are state files, not a queue daemon. A failed unit with a missing
# vote is retried every tick until the vote lands or the candidate closes;
# AUDITOR-PANEL-PENDING is the alarm if the panel never convenes.
#
# Environment seams:
#   FLEET_INTAKE_REPOS_JSON
#   FLEET_HEARTBEAT_LOG_DIR, FLEET_HEARTBEAT_TRIAGE
#   AUDIT_STATE_DIR
#   AUDIT_PENDING_AGE_S       default 2400 (40 min)
#   GH, SYSTEMCTL, AUDIT_GH
#   AUDIT_TALLY_BIN           default /home/nish/.local/bin/pi-audit-tally

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

GH="${AUDIT_GH:-${GH:-gh}}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
INTAKE_JSON="${FLEET_INTAKE_REPOS_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"
LOG_DIR="${FLEET_HEARTBEAT_LOG_DIR:-$HOME/.local/state/fleet-heartbeat}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
STATE_DIR="${AUDIT_STATE_DIR:-$HOME/.local/state/fleet-audit}"
TALLY_BIN="${AUDIT_TALLY_BIN:-/home/nish/.local/bin/pi-audit-tally}"
PENDING_AGE_S="${AUDIT_PENDING_AGE_S:-2400}"
# fleet-ops#3121: owner-authored issues bypass the panel. An issue whose
# author is the repo owner AND whose body passes the agent-ready spec gate
# goes straight to agent-ready (no three-senior panel). One log line per
# bypass so the path is observable.
OWNER_BYPASS_AUTHOR="${AUDIT_OWNER_BYPASS_AUTHOR:-nish3451}"
OWNER_BYPASS_REPOS="${AUDIT_OWNER_BYPASS_REPOS:-}"  # empty = all enrolled repos

mkdir -p "$LOG_DIR" "$STATE_DIR"

ROLES=(devin free-glm-5-3 senior)

# fleet-ops#146 (storm-tolerant panel):
# Cap how many pi-audit@ units this tick may START --no-block. Without
# this, an intake burst (many scout-candidate issues filed at once) fires
# candidates * 3 roles pi-audit@ units in parallel; on a 8-vCPU box that
# drove load to 49 in the 2026-08-27 incident and starved the intake
# loop's agent-ready lane (every agent-ready issue "skipped-capacity").
# Default 4 (half of 8 cores); units that fail to start in this tick are
# left in their current state (failed -> recover_failed_audit; missing ->
# start) and the next tick walks the remainder. The 30-min heartbeat
# cadence is the natural backpressure; this just stops the burst.
# Override for tests / oversized boxes via AUDIT_TICK_MAX_START.
TICK_MAX_START="${AUDIT_TICK_MAX_START:-4}"
started_this_tick=0

ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

log() { printf '[%s] [fleet-heartbeat-auditor] %s\n' "$(ts)" "$*" >&2; }

loud() {
    local tag="$1"; shift
    printf '[%s] [AUDITOR-%s] %s\n' "$(ts)" "$tag" "$*" >&2
    { printf '\n[%s] [AUDITOR-%s] %s\n' "$(ts)" "$tag" "$*"; } >> "$TRIAGE" 2>/dev/null || true
}

# fleet-ops#3121: spec-gate reuse for the owner-authored bypass.
spec_gate_py() {
    if [ -n "${AGENT_READY_SPEC_GATE:-}" ]; then
        printf '%s\n' "$AGENT_READY_SPEC_GATE"
        return 0
    fi
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$here/../lib/agent-ready-spec-gate.py" ]; then
        printf '%s\n' "$here/../lib/agent-ready-spec-gate.py"
        return 0
    fi
    printf '%s\n' "/home/nish/.local/lib/pi-packet/agent-ready-spec-gate.py"
}

issue_passes_spec_gate() {
    local body="$1"
    local py
    py=$(spec_gate_py)
    if [ ! -f "$py" ]; then
        log "SPEC-GATE missing at $py — refuse owner bypass (fail closed)"
        return 1
    fi
    printf '%s' "$body" | python3 "$py" check-body >/dev/null
}

# fleet-ops#3121: owner-authored bypass. Returns 0 and admits the candidate
# (agent-ready, drop scout-candidate) when the issue author is the configured
# owner AND the body passes the spec gate. Returns 1 otherwise (no bypass).
# Logs exactly one line per bypass attempt so the path is observable.
owner_bypass_admit() {
    local repo="$1" candidate="$2"
    local json author body
    json=$("$GH" issue view "$candidate" -R "Nishfleet/$repo" --json author,body 2>/dev/null) || {
        log "$repo/#$candidate: owner bypass — gh view FAILED, no bypass"
        return 1
    }
    author=$(printf '%s' "$json" | jq -r '.author.login // empty')
    body=$(printf '%s' "$json" | jq -r '.body // empty')
    if [ "$author" != "$OWNER_BYPASS_AUTHOR" ]; then
        return 1
    fi
    if ! issue_passes_spec_gate "$body"; then
        log "$repo/#$candidate: owner bypass — author=$author but spec-gate FAILED, panel runs"
        return 1
    fi
    log "$repo/#$candidate: owner bypass — author=$author spec-gate PASS, admitting (no panel)"
    if [ "${AUDIT_DRY_RUN:-0}" = "1" ]; then
        log "DRY-RUN: would add agent-ready + remove scout-candidate for $repo/#$candidate (owner bypass)"
        return 0
    fi
    if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate --add-label agent-ready >/dev/null 2>&1; then
        log "$repo/#$candidate: owner bypass — gh issue edit FAILED"
        return 1
    fi
    rm -f "$(pending_stamp "$repo" "$candidate")" 2>/dev/null || true
    return 0
}

[ -f "$INTAKE_JSON" ] || { log "FATAL: intake-repos.json missing: $INTAKE_JSON"; exit 2; }
command -v jq >/dev/null 2>&1 || { log "FATAL: jq missing"; exit 2; }
[ -x "$TALLY_BIN" ] || { log "FATAL: tally script missing or not executable: $TALLY_BIN"; exit 2; }

repo_list() { jq -r '.repos[]?.name' "$INTAKE_JSON" 2>/dev/null || true; }

scout_candidates() {
    # fleet-ops#2766: fetch labels too so discarded+scout-candidate dual-
    # labeled leftovers (from the pre-#2766 requeue loop) can be skipped
    # and healed without burning the per-tick start cap on dead work.
    local repo="$1"
    local out
    out=$("$GH" issue list -R "Nishfleet/$repo" -l scout-candidate --state open --json number,labels --limit 200 2>&1) || {
        log "$repo: scout-candidate list gh FAILED: $out"
        return 1
    }
    # Emit "number\thas_discarded" so the caller can skip terminal rejects.
    # labels defaults to [] so older fixtures / partial JSON still parse.
    printf '%s\n' "$out" | jq -r '.[] | "\(.number)\t\([(.labels // [])[].name] | index("discarded") != null)"'
}

unit_name() {
    local repo="$1" candidate="$2" role="$3"
    printf 'pi-audit@%s--%s--%s.service\n' "$repo" "$candidate" "$role"
}

unit_state() {
    local unit="$1"
    "$SYSTEMCTL" --user is-active "$unit" 2>/dev/null || true
}

vote_path() {
    local repo="$1" candidate="$2" role="$3"
    printf '%s/%s/%s/%s.vote\n' "$STATE_DIR" "$repo" "$candidate" "$role"
}

pending_stamp() {
    local repo="$1" candidate="$2"
    printf '%s/%s/%s/.pending\n' "$STATE_DIR" "$repo" "$candidate"
}

mark_pending() {
    local repo="$1" candidate="$2" stamp
    stamp=$(pending_stamp "$repo" "$candidate")
    [ -f "$stamp" ] && return
    mkdir -p "$(dirname "$stamp")"
    ts > "$stamp"
}

pending_since_s() {
    local repo="$1" candidate="$2" stamp now then_s
    stamp=$(pending_stamp "$repo" "$candidate")
    [ -f "$stamp" ] || return 1
    now=$(date -u +%s)
    then_s=$(date -u -d "$(cat "$stamp")" +%s 2>/dev/null || echo 0)
    [ "$then_s" -gt 0 ] 2>/dev/null || return 1
    printf '%s\n' $(( now - then_s ))
}

start_audit() {
    local repo="$1" candidate="$2" role="$3" unit
    unit=$(unit_name "$repo" "$candidate" "$role")
    if [ "$started_this_tick" -ge "$TICK_MAX_START" ]; then
        # Quiet skip: the per-tick cap (fleet-ops#146 storm-tolerant panel)
        # is hit. The next tick will try the remaining missing units. This
        # is the per-tick shape; the aggregate ceiling is the pi-audit.slice
        # TasksMax/CPUQuota (10-concurrency.conf) which keeps already-
        # running units from saturating the host even before the cap binds.
        log "$repo/#$candidate: $unit deferred (tick cap $started_this_tick/$TICK_MAX_START)"
        return 2
    fi
    log "$repo/#$candidate: starting $unit"
    if ! "$SYSTEMCTL" --user start --no-block "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: start $unit FAILED"
        return 1
    fi
    started_this_tick=$((started_this_tick + 1))
    return 0
}

# fleet-ops#616: StartLimitBurst=2 + StartLimitIntervalSec=1h leaves the
# unit failed until the interval elapses. reset-failed clears the burst
# so a recovered seat can be tried on this tick instead of sitting dead.
# Bypasses the per-tick start cap on purpose: a wedged unit that
# already paid its 60s RestartSec cost is exactly one new unit, not
# fan-out, and starving it for an hour while fresher units absorb the
# cap is the worse failure mode (fleet-ops#146 storm-tolerant panel).
recover_failed_audit() {
    local repo="$1" candidate="$2" role="$3" unit
    unit=$(unit_name "$repo" "$candidate" "$role")
    log "$repo/#$candidate: $unit is failed — reset-failed + start (fleet-ops#616)"
    if ! "$SYSTEMCTL" --user reset-failed "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: reset-failed $unit FAILED"
        return 1
    fi
    if ! "$SYSTEMCTL" --user start --no-block "$unit" >/dev/null 2>&1; then
        log "$repo/#$candidate: start $unit FAILED"
        return 1
    fi
    return 0
}

process_candidate() {
    local repo="$1" candidate="$2"
    local missing=0 active=0 failed=0
    local v role unit state

    # fleet-ops#3121: owner-authored + spec-gate bypass — skip the panel.
    # Tried before any vote/unit work so an owner issue never pays the
    # StartLimitBurst cost of a panel it does not need.
    if owner_bypass_admit "$repo" "$candidate"; then
        return 0
    fi

    for role in "${ROLES[@]}"; do
        v=$(vote_path "$repo" "$candidate" "$role")
        if [ -f "$v" ]; then
            continue
        fi
        unit=$(unit_name "$repo" "$candidate" "$role")
        state=$(unit_state "$unit")
        case "$state" in
            active|activating)
                active=$((active + 1))
                ;;
            failed)
                # failed units (StartLimitBurst exhausted) do NOT count
                # against the per-tick start cap: the cap exists to keep
                # the host from melting under --no-block fan-out, and a
                # reset-failed + start that already paid its 60s RestartSec
                # cost is exactly one new unit, not a fan-out. Without
                # this carve-out, a wedged unit could be starved for an
                # hour while the cap absorbs starts for fresher units.
                if recover_failed_audit "$repo" "$candidate" "$role"; then
                    active=$((active + 1))
                else
                    failed=$((failed + 1))
                fi
                ;;
            *)
                # rc 2 from start_audit = tick cap hit, deferred to next tick.
                # rc 1 = start genuinely failed (systemctl returned non-zero).
                missing=$((missing + 1))
                if start_audit "$repo" "$candidate" "$role"; then
                    active=$((active + 1))
                elif [ $? -eq 2 ]; then
                    # Defer; still tally this candidate as pending so the
                    # loud AUDITOR-PANEL-PENDING alarm fires if it ages out
                    # past PENDING_AGE_S.
                    :
                else
                    failed=$((failed + 1))
                fi
                ;;
        esac
    done

    if [ "$missing" -eq 0 ] && [ "$active" -eq 0 ] && [ "$failed" -eq 0 ]; then
        # All votes present.
        log "$repo/#$candidate: all votes present, tallying"
        if AUDIT_GH="$GH" "$TALLY_BIN" "$repo" "$candidate"; then
            rm -f "$(pending_stamp "$repo" "$candidate")"
        else
            log "$repo/#$candidate: $TALLY_BIN FAILED"
        fi
        return
    fi

    # Not all votes present. Keep the first pending timestamp and raise a loud
    # finding if the backlog is older than the heartbeat threshold (even if
    # some units are still active — a hung audit is still a backlog).
    mark_pending "$repo" "$candidate"
    local age
    age=$(pending_since_s "$repo" "$candidate" 2>/dev/null || echo "")
    if [ -n "$age" ] && [ "$age" -ge "$PENDING_AGE_S" ]; then
        loud "PANEL-PENDING" "repo=$repo candidate=$candidate age_s=$age active=$active missing=$missing failed=$failed — senior auditor panel has not convened"
    else
        log "$repo/#$candidate: panel pending (active=$active missing=$missing failed=$failed)"
    fi
}

# fleet-ops#2766: a discarded+scout-candidate dual-label leftover is
# terminal — drop scout-candidate so the next tick does not re-list it
# (lifecycle-label-sweep also heals, but the auditor is the hotter path
# and must not spend TICK_MAX_START slots on dead work). Fail-open: a
# gh blip leaves the dual-label for the next tick / the sweep.
heal_discarded_scout() {
    local repo="$1" candidate="$2"
    log "$repo/#$candidate: discarded+scout-candidate dual-label — drop scout-candidate (fleet-ops#2766)"
    if ! "$GH" issue edit "$candidate" -R "Nishfleet/$repo" --remove-label scout-candidate >/dev/null 2>&1; then
        log "$repo/#$candidate: remove-label scout-candidate FAILED — retry next tick"
        return 1
    fi
    rm -f "$(pending_stamp "$repo" "$candidate")" 2>/dev/null || true
    return 0
}

main() {
    local repo
    while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        local candidate has_discarded
        while IFS=$'\t' read -r candidate has_discarded; do
            [ -n "$candidate" ] || continue
            if [ "$has_discarded" = "true" ]; then
                heal_discarded_scout "$repo" "$candidate" || true
                continue
            fi
            process_candidate "$repo" "$candidate" || true
        done < <(scout_candidates "$repo" 2>/dev/null || true)
    done < <(repo_list)
}

main
