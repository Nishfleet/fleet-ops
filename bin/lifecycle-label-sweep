#!/usr/bin/env bash

# Use the nishfleet-worker App token for any GitHub write. Fail closed if
# the App cannot mint and no token was inherited from a parent organ, so a
# dead App never falls through to the human gh identity (fleet-ops#3445).
# Human gh is read-only for organs; GH Actions (tests) has no App creds and
# stubs gh as read-only, so skip minting there.
if [[ -z "${GH_TOKEN:-}" && "${GITHUB_ACTIONS:-}" != "true" && "${GH:-gh}" == "gh" ]]; then
    command -v gh >/dev/null 2>&1 || export PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}
    _wt="${NISHFLEET_WORKER_TOKEN_BIN:-${HOME:-/home/nish}/.local/bin/worker-token}"
    _minted="$("$_wt" --print)" || { echo "fleet-ops#3445: $_wt --print failed - refusing human-gh writes" >&2; exit 1; }
    eval "$_minted"
    unset _wt _minted
fi
# lifecycle-label-sweep — every open issue in an enrolled repo gets a
# lifecycle label within one heartbeat tick (fleet-ops#376).
#
# Intake only lists `-l agent-ready`. An issue filed with no lifecycle
# label is invisible forever — the live instance was #290/#304/#308 sitting
# OPEN with zero labels while the conference-gate re-land died around them.
#
# Named reason this is a sweep, not an event: the nishfleet-worker GitHub
# App has no webhooks (credentials/app-manifest.json events=[]), so an
# unlabeled `gh issue create` has nothing to subscribe to. Heartbeat's
# existing 30-minute timer is the observer; this is not a new schedule.
#
# Lifecycle labels (exactly one required; extra non-lifecycle labels are
# ignored). gap-audit is a topic label, not a lifecycle label: findings
# filed with only gap-audit are invisible to intake until this sweep
# adds agent-ready (fleet-ops#402 leftovers; the auditor now dual-labels
# at create time, this is the observe-to-close path). scout-candidate is
# the admission-queue lifecycle label (fleet-ops#457). discarded is the
# terminal admission-reject label (fleet-ops#146 / #2766): without it in
# this set, pi-audit-tally's remove-scout-candidate + add-discarded left
# the issue "unlabeled" from the sweep's POV, so the next tick re-added
# scout-candidate and the panel re-discarded forever (0509#1140: 4
# discard↔requeue cycles in 90 min; 6142 discards/7d).
#   agent-ready / agent-in-progress / agent-blocked
#   scout-candidate
#   discarded
#   nish-reserved
#   noise-class
#   observe-to-close
#   drill:*   (any label whose name starts with drill:)
#
# Classification of issues that currently have none of those:
#   title starts with "AUTO-REVERT SKIP" or "AUTO-REVERT HALT"
#       → noise-class  (halt notice, not work)
#   title contains "FLAG-for-Nish" (any case)
#       → nish-reserved
#   title starts with "drill:" (any case)
#       → drill:lifecycle
#   title starts with "fix(failed-command):" and ends with
#       "— failed command walked past, never flagged", and the body
#       carries `signal: failed-command-flagged/<slug>`
#       → observe-to-close  (detector observe-to-close, no work left)
#   title starts with "fix(decisions-ledger):" and ends with
#       "— decided question was re-asked", and the body carries
#       `signal: decisions-ledger/<slug>`
#       → observe-to-close  (detector observe-to-close, no work left)
#   umbrella label already present
#       → nish-reserved  (fleet-ops#3295: tracking parent, not claimable)
#   gap-audit topic label already present
#       → agent-ready  (already judged by the blind-audit panel)
#   repo is Nishfleet/fleet-ops (control-plane)
#       → agent-ready  (builder gate: CI + conference + auto-revert)
#   otherwise (product repos)
#       → scout-candidate  (fleet-ops#457: admission, not blank approval)
#
# Class-lock reclassification (fleet-ops#1083): a `fix(failed-command):` or
# `fix(decisions-ledger):` issue whose class-lock PR (the `claim/issue-<N>`
# branch, merged with `Relates to #<N>` not `Closes #<N>`) has already
# merged is reclassified to `observe-to-close` regardless of its current
# lifecycle label. A class-lock PR does NOT close the issue (it uses
# `Relates to #<N>`), and the release paths (tier1 §3, pi-issue-failed-reap,
# undersaturation label-hygiene) flip it back to `agent-ready` after the
# worker hits StartLimitBurst, so intake re-claims it every tick until the
# 24h observe-to-close window expires — wasted worker spawns on work that
# is already done (the live #958 loop). Parking it under observe-to-close
# makes intake blind to it (intake only lists `-l agent-ready`) while the
# detector's own observe-to-close still closes it on session age-out. The
# merged-PR probe is `gh pr list --head claim/issue-<N> --state merged`,
# which survives branch deletion (PRs keep their head ref; verified live on
# the deleted claim/issue-958 branch). Fail-open: a gh blip leaves the
# label untouched and the next tick retries.
#
# Environment (tests override all of these):
#   LIFECYCLE_SWEEP_REPOS       newline-separated owner/name list
#   LIFECYCLE_SWEEP_INTAKE_JSON default repo list (intake-repos.json)
#   LIFECYCLE_SWEEP_LOCKDIR     flock directory
#   LIFECYCLE_SWEEP_DRY_RUN     if 1, print actions and mutate nothing
#   LIFECYCLE_SWEEP_NOW         ISO-8601 UTC clock (comment timestamps)
#   LIFECYCLE_SWEEP_DRILL       if 1, file an unlabeled fixture, sweep,
#                               assert it now carries a lifecycle label,
#                               then close the fixture
#
# Modes:
#   --classify TITLE   print the lifecycle label for TITLE (no network)
#   --drill            set LIFECYCLE_SWEEP_DRILL=1 then sweep
#   (default)          sweep enrolled repos
#
# Exit 0 on a clean sweep, overlapping no-op, or a passing drill.
# Non-zero on unexpected failure or a failing drill.

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="${PATH:-/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"

# --- help ---------------------------------------------------------------
# fleet-ops#2889: --help/-h must print usage and exit 0 without taking the
# flock, listing issues, or mutating labels.
case "${1:-}" in
    --help|-h)
        cat <<'HELP'
lifecycle-label-sweep — every open issue in an enrolled repo gets a
lifecycle label within one heartbeat tick (fleet-ops#376).

Usage: lifecycle-label-sweep [--help|-h]

Modes:
  --classify TITLE   print the lifecycle label for TITLE (no network)
  --drill            set LIFECYCLE_SWEEP_DRILL=1 then sweep
  (default)          sweep enrolled repos

Exit 0 on a clean sweep, overlapping no-op, or a passing drill.
Non-zero on unexpected failure or a failing drill.
HELP
        exit 0
        ;;
esac

classify() {
    local title="$1"
    local repo="${2:-}"
    local body="${3:-}"
    local lower short
    if [[ "$title" == "AUTO-REVERT SKIP"* || "$title" == "AUTO-REVERT HALT"* ]]; then
        printf '%s\n' "noise-class"
        return 0
    fi
    # fleet-ops#1401: failed-command observe-to-close issues are filed by
    # bin/fleet-failed-command-flagged; no implementation work left. Match
    # the exact title template and the body signal marker.
    if [[ "$title" == "fix(failed-command):"* ]] \
        && [[ "$title" == *" — failed command walked past, never flagged" ]]; then
        if [ -z "$body" ] \
            || printf '%s' "$body" | grep -qE 'signal: failed-command-flagged/[a-z0-9-]+'; then
            printf '%s\n' "observe-to-close"
            return 0
        fi
    fi
    # fleet-ops#1083: decisions-ledger observe-to-close issues are filed by
    # bin/fleet-decisions-ledger (fleet-ops#1138); same shape as the
    # failed-command observe-to-close class. Match the title template and
    # the body signal marker.
    if [[ "$title" == "fix(decisions-ledger):"* ]] \
        && [[ "$title" == *" — decided question was re-asked" ]]; then
        if [ -z "$body" ] \
            || printf '%s' "$body" | grep -qE 'signal: decisions-ledger/[a-z0-9-]+'; then
            printf '%s\n' "observe-to-close"
            return 0
        fi
    fi
    lower=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')
    if [[ "$lower" == *"flag-for-nish"* ]]; then
        printf '%s\n' "nish-reserved"
        return 0
    fi
    if [[ "$lower" == drill:* ]]; then
        printf '%s\n' "drill:lifecycle"
        return 0
    fi
    # fleet-ops#457: product-repo unlabeled issues go to admission, not
    # blank agent-ready. Control-plane (fleet-ops) stays on the builder
    # gate (CI + conference + auto-revert) because the product auditor
    # FAILs fleet/CI tooling by design.
    short="${repo##*/}"
    if [[ -n "$short" && "$short" != "fleet-ops" ]]; then
        printf '%s\n' "scout-candidate"
        return 0
    fi
    printf '%s\n' "agent-ready"
}

if [ "${1:-}" = "--classify" ]; then
    shift
    [ $# -ge 1 ] || { echo "lifecycle-label-sweep --classify needs a title" >&2; exit 2; }
    classify "$*"
    exit 0
fi

if [ "${1:-}" = "--drill" ]; then
    LIFECYCLE_SWEEP_DRILL=1
    shift
fi

INTAKE_JSON="${LIFECYCLE_SWEEP_INTAKE_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"
LOCKDIR="${LIFECYCLE_SWEEP_LOCKDIR:-${XDG_RUNTIME_DIR}/lifecycle-label-sweep}"
DRY="${LIFECYCLE_SWEEP_DRY_RUN:-0}"
DRILL="${LIFECYCLE_SWEEP_DRILL:-0}"

log() {
    printf '[%s] [lifecycle-label-sweep] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

now_iso() {
    if [ -n "${LIFECYCLE_SWEEP_NOW:-}" ]; then
        printf '%s' "$LIFECYCLE_SWEEP_NOW"
    else
        date -u +%Y-%m-%dT%H:%M:%SZ
    fi
}

# fleet-ops#5439 (silent-drop sweep 2026-09-11): a notification comment
# must never vanish into `|| true`. Capture the gh rc; on failure log an
# ALERT naming the dropped notice so the failure is durable in the sweep
# log, not silent. The label move itself already succeeded, so a dropped
# notice does not fail the caller — the ALERT is the record.
comment_issue() {
    local repo="$1" num="$2" body="$3" context="$4"
    local rc=0
    gh issue comment "$num" -R "$repo" --body "$body" >/dev/null 2>&1 || rc=$?
    if [ "$rc" -ne 0 ]; then
        log "ALERT $repo#$num: issue comment FAILED (rc=$rc) — $context notice dropped (fleet-ops silent-drop 2026-09-11)"
    fi
    return 0
}

label_color() {
    case "$1" in
        nish-reserved)   printf '%s' "5319E7" ;;
        noise-class)     printf '%s' "CFD3D7" ;;
        observe-to-close) printf '%s' "BFD4F2" ;;
        verification-only) printf '%s' "0E8A16" ;;
        drill:lifecycle) printf '%s' "EDEDED" ;;
        agent-ready)     printf '%s' "0E8A16" ;;
        scout-candidate) printf '%s' "FBCA04" ;;
        discarded)       printf '%s' "B60205" ;;
        *)               printf '%s' "EDEDED" ;;
    esac
}

label_desc() {
    case "$1" in
        nish-reserved)   printf '%s' "Reserved for Nish; agents must not claim" ;;
        noise-class)     printf '%s' "Not work (halt notices, noise); not agent-ready" ;;
        observe-to-close) printf '%s' "Waiting for detector observe-to-close; do not claim (fleet-ops#1401)" ;;
        verification-only) printf '%s' "No PR expected; terminal is a worker VERDICT: PASS comment (fleet-ops#4274)" ;;
        drill:lifecycle) printf '%s' "Lifecycle-label drill fixture (fleet-ops#376)" ;;
        agent-ready)     printf '%s' "Auto: ready for a worker to claim" ;;
        scout-candidate) printf '%s' "Queued for senior admission; not yet agent-ready" ;;
        discarded)       printf '%s' "Senior admission rejected (2-of-3 FAIL); terminal, do not re-queue (fleet-ops#146/#2766)" ;;
        *)               printf '%s' "Lifecycle label (fleet-ops#376)" ;;
    esac
}

is_lifecycle_label() {
    local name="$1"
    case "$name" in
        agent-ready|agent-in-progress|agent-blocked|nish-reserved|noise-class|scout-candidate|discarded|observe-to-close) return 0 ;;
        drill:*) return 0 ;;
    esac
    return 1
}

issue_has_lifecycle() {
    local labels_json="$1"
    local name
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if is_lifecycle_label "$name"; then
            return 0
        fi
    done < <(printf '%s' "$labels_json" | jq -r '.[].name // empty')
    return 1
}

# fleet-ops#1083: a class-lock issue is one auto-filed by
# bin/fleet-failed-command-flagged or bin/fleet-decisions-ledger. Its
# class-lock PR uses `Relates to #<N>` (not `Closes #<N>`) on branch
# claim/issue-<N>, so merging it does NOT close the issue. The detector's
# own observe-to-close closes it later on session age-out. Until then the
# release paths keep flipping it back to agent-ready and intake re-claims
# it. This predicate names the title prefixes that need the merged-PR
# reclassification below.
is_class_lock_title() {
    local title="$1"
    [[ "$title" == "fix(failed-command):"* ]] && return 0
    [[ "$title" == "fix(decisions-ledger):"* ]] && return 0
    return 1
}

# Has the class-lock PR for issue <num> already merged? gh pr list keeps the
# head ref on the PR record after branch deletion, so this works even once
# the release paths have deleted claim/issue-<num>. Returns 0 (merged) / 1
# (not merged or probe failed — fail-open to the existing label).
class_lock_pr_merged() {
    local repo="$1" num="$2"
    local merged_json
    merged_json=$(gh pr list -R "$repo" --head "claim/issue-${num}" \
        --state merged --json number 2>/dev/null) || return 1
    [ -n "$merged_json" ] || return 1
    printf '%s' "$merged_json" | jq -e 'length > 0' >/dev/null 2>&1
}

mkdir -p "$LOCKDIR"
exec 9>"$LOCKDIR/sweep.lock"
if ! flock -n 9; then
    log "sweep already running (no-op)"
    echo "no-op: sweep already running"
    exit 0
fi

command -v jq >/dev/null 2>&1 || { log "FATAL: jq missing"; exit 2; }
command -v gh >/dev/null 2>&1 || { log "FATAL: gh missing"; exit 2; }

repos=""
if [ -n "${LIFECYCLE_SWEEP_REPOS:-}" ]; then
    repos="$LIFECYCLE_SWEEP_REPOS"
else
    [ -f "$INTAKE_JSON" ] || { log "FATAL: intake file missing: $INTAKE_JSON"; exit 2; }
    repos=$(jq -r '.repos[].name | "Nishfleet/" + .' "$INTAKE_JSON")
    case "$repos" in
        *Nishfleet/fleet-ops*) ;;
        *) repos=$(printf '%s\nNishfleet/fleet-ops\n' "$repos") ;;
    esac
fi

NOW_ISO=$(now_iso)
relabeled=0
skipped=0
failed=0
reclassified=0
healed=0
admitted=0
bounced=0
decided_healed=0
drill_repo=""
drill_num=""

# fleet-ops#4022: scout-candidate bounce cooldown. A spec-less scout-candidate
# issue older than 72h gets ONE bounce comment; the comment marker is the
# cooldown signal so the next sweep does not re-bounce it and the unlabeled
# pass does not re-apply scout-candidate to it within the window.
SCOUT_BOUNCE_MARKER="scout-candidate-bounce:"
SCOUT_BOUNCE_COOLDOWN_SECONDS=$((72 * 60 * 60))

ensure_label() {
    local repo="$1" name="$2"
    local color desc
    color=$(label_color "$name")
    desc=$(label_desc "$name")
    if [ "$DRY" = "1" ]; then
        log "DRY $repo: ensure label $name"
        return 0
    fi
    gh label create "$name" -R "$repo" --color "$color" --description "$desc" --force >/dev/null 2>&1 || true
}

spec_gate_py() {
    if [ -n "${AGENT_READY_SPEC_GATE:-}" ]; then
        printf '%s\n' "$AGENT_READY_SPEC_GATE"
        return 0
    fi
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$here/../lib/agent-ready-spec-gate.py" ]; then
        printf '%s\n' "$here/../lib/agent-ready-spec-gate.py"
        return 0
    fi
    printf '%s\n' "/home/nish/.local/lib/pi-packet/agent-ready-spec-gate.py"
}

issue_passes_spec_gate() {
    local body="$1" repo="$2"
    local py
    py=$(spec_gate_py)
    if [ ! -f "$py" ]; then
        log "SPEC-GATE missing at $py — refuse agent-ready (fail closed)"
        return 1
    fi
    printf '%s' "$body" | python3 "$py" check-body --repo "$repo" >/dev/null
}

# fleet-ops#4022: epoch seconds for an ISO-8601 UTC timestamp, or empty on
# parse failure. GNU date (Linux VPS + GitHub runners) parses the Z form.
iso_epoch() {
    local ts="$1"
    [ -n "$ts" ] || { printf ''; return; }
    date -d "$ts" +%s 2>/dev/null || printf ''
}

# True (0) when the issue's createdAt is older than the bounce cooldown
# relative to NOW_ISO. Fail-open false (1) when the age cannot be computed
# — a missing createdAt must not trigger a bounce.
issue_older_than_bounce_age() {
    local created="$1" now="$2"
    local c n
    c=$(iso_epoch "$created")
    n=$(iso_epoch "$now")
    [ -n "$c" ] && [ -n "$n" ] || return 1
    (( n - c >= SCOUT_BOUNCE_COOLDOWN_SECONDS ))
}

# Lazy per-issue comment fetch (fleet-ops#4091). The bulk `gh issue list`
# call used to request `.comments` for every open issue in one GraphQL
# round-trip; on repos with many open issues (fleet-ops ~336) GitHub 504s
# and the whole sweep skips the repo, so scout-candidates never get
# promoted to agent-ready and product supply starves. Comments are only
# needed for the scout-candidate bounce-cooldown check below, so fetch them
# one issue at a time and only when that check actually runs. Fail-open to
# an empty array so a transient gh blip skips the cooldown guard rather
# than aborting the sweep.
fetch_issue_comments() {
    local repo="$1" num="$2"
    gh issue view "$num" -R "$repo" --json comments 2>/dev/null \
        | jq -c '.comments // []' 2>/dev/null || printf '[]'
}

# True (0) when the issue already carries a scout-candidate-bounce: comment
# whose createdAt is within the cooldown window of NOW_ISO. A bounce
# comment with no createdAt is treated as in-cooldown (fail-closed: do not
# re-bounce). comments_json is the `.comments` array — now fetched lazily
# via fetch_issue_comments, not carried on the bulk list row.
bounce_in_cooldown() {
    local comments_json="$1" now="$2"
    local now_epoch
    now_epoch=$(iso_epoch "$now")
    [ -n "$now_epoch" ] || return 1
    local row body created bepoch diff
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        body=$(printf '%s' "$row" | jq -r '.body // ""')
        printf '%s' "$body" | grep -qF "$SCOUT_BOUNCE_MARKER" || continue
        created=$(printf '%s' "$row" | jq -r '.createdAt // ""')
        [ -n "$created" ] || return 0
        bepoch=$(iso_epoch "$created")
        [ -n "$bepoch" ] || return 0
        diff=$(( now_epoch - bepoch ))
        (( diff < SCOUT_BOUNCE_COOLDOWN_SECONDS )) && return 0
    done < <(printf '%s' "$comments_json" | jq -c '.[] // empty' 2>/dev/null)
    return 1
}

# fleet-ops#4892: true (0) if the issue has a comment starting with
# `DECISION (judge` — the judge's verdict that takes an item off Nish's tab.
# The judge only posts a DECISION when the standing rules / decisions ledger
# settle it (i.e. it is NOT actually Nish-reserved); a genuinely Nish-reserved
# ask goes to NISH-DECISIONS instead. So a DECISION comment on a nish-reserved
# issue means the label is stale (the judge forgot to remove it).
has_decision_comment() {
    local comments_json="$1"
    printf '%s' "$comments_json" | jq -e '[.[]?.body // empty] | any(startswith("DECISION (judge"))' >/dev/null 2>&1
}

# fleet-ops#4892: backstop heal — remove the stale nish-reserved label the
# judge forgot to drop. The issue is left open (the judge's DECISION names the
# follow-through work item); the next tick classifies it once nish-reserved is
# gone. Does NOT add a new lifecycle label: a judge-decided tracker (live
# #4838 "stays open until the OOM kills stop") must not become agent-ready.
heal_decided_nish_reserved() {
    local repo="$1" num="$2"
    local body
    body="lifecycle-label: nish-reserved removed by fleet-heartbeat at ${NOW_ISO} (judge DECISION took this off Nish's tab but left nish-reserved; fleet-ops#4892). The next tick classifies this issue."
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: remove-label nish-reserved (decided)"
        return 0
    fi
    if ! gh issue edit "$num" -R "$repo" --remove-label nish-reserved >/dev/null 2>&1; then
        log "  $repo#$num: remove-label nish-reserved FAILED — retry next tick"
        return 1
    fi
    comment_issue "$repo" "$num" "$body" "nish-reserved heal"
    return 0
}

# fleet-ops#4022: admit a scout-candidate issue whose body passes the spec
# gate to agent-ready. Drop scout-candidate so intake lists it.
admit_scout_candidate() {
    local repo="$1" num="$2"
    local body
    body="lifecycle-label: agent-ready by fleet-heartbeat at ${NOW_ISO} (scout-candidate passed spec gate; fleet-ops#4022)"
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: admit scout-candidate → agent-ready"
        return 0
    fi
    ensure_label "$repo" "agent-ready"
    if ! gh issue edit "$num" -R "$repo" --remove-label scout-candidate --add-label agent-ready >/dev/null 2>&1; then
        log "  $repo#$num: admit scout-candidate FAILED — retry next tick"
        return 1
    fi
    comment_issue "$repo" "$num" "$body" "scout-candidate admit"
    return 0
}

# fleet-ops#4022: post ONE bounce comment on a spec-less scout-candidate
# issue older than 72h, naming the missing spec line. The marker in the
# body is the cooldown signal for the next sweep.
bounce_scout_candidate() {
    local repo="$1" num="$2"
    local body
    body="${SCOUT_BOUNCE_MARKER} spec gate failed at ${NOW_ISO} (fleet-ops#4022)
missing: add a \`termination:\`/\`accept:\`/\`required:\`/\`metric:\` line so this issue can be admitted to agent-ready."
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: bounce scout-candidate (spec gate failed, >72h)"
        return 0
    fi
    if ! gh issue comment "$num" -R "$repo" --body "$body" >/dev/null 2>&1; then
        log "  $repo#$num: bounce comment FAILED — retry next tick"
        return 1
    fi
    return 0
}

apply_label() {
    local repo="$1" num="$2" label="$3"
    local body
    body="lifecycle-label: ${label} by fleet-heartbeat at ${NOW_ISO} (unlabeled open issue; fleet-ops#376)"
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: add-label $label"
        return 0
    fi
    ensure_label "$repo" "$label"
    if ! gh issue edit "$num" -R "$repo" --add-label "$label" >/dev/null; then
        log "  $repo#$num: add-label $label FAILED — retry next tick"
        return 1
    fi
    comment_issue "$repo" "$num" "$body" "lifecycle-label $label"
    return 0
}

# fleet-ops#1083: reclassify a class-lock issue whose class-lock PR merged
# to observe-to-close. Unlike apply_label (add-only, for unlabeled issues),
# this removes the intake-visible lifecycle label(s) first so intake stops
# listing the issue, then adds observe-to-close. Non-lifecycle labels
# (gap-audit, escalate-senior, etc.) are left in place.
reclassify_to_observe_close() {
    local repo="$1" num="$2" labels_json="$3"
    local remove_args=() name
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        case "$name" in
            agent-ready|agent-in-progress|agent-blocked)
                remove_args+=(--remove-label "$name")
                ;;
        esac
    done < <(printf '%s' "$labels_json" | jq -r '.[].name // empty')
    local body
    body="lifecycle-label: observe-to-close by fleet-heartbeat at ${NOW_ISO} (class-lock PR merged; fleet-ops#1083). Intake will not claim this; the detector's observe-to-close still closes it on session age-out."
    if [ "$DRY" = "1" ]; then
        log "DRY $repo#$num: reclassify → observe-to-close (drop: ${remove_args[*]:-none})"
        return 0
    fi
    ensure_label "$repo" "observe-to-close"
    if ! gh issue edit "$num" -R "$repo" "${remove_args[@]}" --add-label observe-to-close >/dev/null 2>&1; then
        log "  $repo#$num: reclassify to observe-to-close FAILED — retry next tick"
        return 1
    fi
    comment_issue "$repo" "$num" "$body" "observe-to-close reclassify"
    return 0
}

if [ "$DRILL" = "1" ]; then
    drill_repo=$(printf '%s\n' "$repos" | awk 'NF{print; exit}')
    [ -n "$drill_repo" ] || { log "FATAL: drill needs a repo"; exit 2; }
    if [ "$DRY" = "1" ]; then
        log "DRY drill: would file unlabeled fixture on $drill_repo"
        drill_num="0"
    else
        drill_url=$("$ISSUE_FILE" file -R "$drill_repo" \
            --title "drill: unlabeled-lifecycle fixture" \
            --body "Unlabeled fixture for fleet-ops#376. The sweep must apply a lifecycle label within this tick, then this issue is closed." \
            2>/dev/null) || {
            log "FATAL: drill could not file fixture on $drill_repo"
            exit 2
        }
        drill_num="${drill_url##*/}"
        if [ -z "$drill_num" ] || ! [[ "$drill_num" =~ ^[1-9][0-9]*$ ]]; then
            log "FATAL: drill create returned unusable url '$drill_url'"
            exit 2
        fi
        log "drill filed $drill_repo#$drill_num unlabeled"
    fi
fi

log "sweep starting now=$NOW_ISO"

while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    log "repo $repo"

    # fleet-ops#4274: ensure the verification-only label exists so a
    # verification-only issue can carry it and observe-to-close can scan
    # for it. Idempotent (gh label create --force).
    ensure_label "$repo" "verification-only"

    # fleet-ops#4091: do NOT request `.comments` here. The bulk list call
    # fetches every open issue in one GraphQL round-trip; adding `.comments`
    # makes GitHub 504 on repos with many open issues (fleet-ops ~336),
    # skipping the whole repo and starving product supply. Comments are
    # fetched lazily per-issue via fetch_issue_comments only where the
    # bounce-cooldown check actually needs them.
    if ! list_json=$(gh issue list -R "$repo" --state open \
        --json number,title,labels,body,createdAt --limit 500 2>/dev/null); then
        log "  $repo: gh issue list FAILED — skip"
        continue
    fi

    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        title=$(printf '%s' "$row" | jq -r '.title // ""')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')
        issue_body=$(printf '%s' "$row" | jq -r '.body // ""')

        if issue_has_lifecycle "$labels_json"; then
            skipped=$((skipped + 1))
            continue
        fi

        # fleet-ops#3295: umbrella-labeled issues are tracking parents, not
        # claimable work (label desc: "tracking parent; not claimable").
        # Exclude them from the agent-ready default AND from scout-candidate
        # admission so the sweep does not make them intake-visible. Without
        # this, the sweep defaults every unlabeled open issue to agent-ready
        # (fleet-ops) / scout-candidate (product), intake dispatches a worker
        # on the tracker, the worker finds no implementable work, and dies —
        # a pure dead-seat loop (live #3128: 6 claims in one day). nish-reserved
        # is the lifecycle label for "agents must not claim", matching the
        # umbrella label's semantics. The guard runs before gap-audit because
        # umbrella means "not claimable" regardless of any other topic label.
        if printf '%s' "$labels_json" | jq -e '.[] | select(.name=="umbrella")' >/dev/null 2>&1; then
            label="nish-reserved"
        # gap-audit leftovers already passed the blind-audit panel (#402).
        # That is a gate, so they become agent-ready rather than re-queued
        # for scout admission.
        elif printf '%s' "$labels_json" | jq -e '.[] | select(.name=="gap-audit")' >/dev/null 2>&1; then
            label="agent-ready"
        else
            label=$(classify "$title" "$repo" "$issue_body")
        fi
        # fleet-ops#543: first admission to agent-ready needs a spec.
        # gap-audit leftovers already passed the panel; skip the body check.
        if [ "$label" = "agent-ready" ] \
            && ! printf '%s' "$labels_json" | jq -e '.[] | select(.name=="gap-audit")' >/dev/null 2>&1; then
            if ! issue_passes_spec_gate "$issue_body" "$repo"; then
                log "  $repo#$num: SPEC-GATE-REFUSED agent-ready ($title)"
                if [ "$DRY" != "1" ]; then
                    comment_issue "$repo" "$num" \
                        "spec-gate: refused agent-ready (fleet-ops#543). Body needs termination: / accept: / required: / metric:." \
                        "spec-gate refusal"
                fi
                skipped=$((skipped + 1))
                continue
            fi
        fi
        # fleet-ops#4022: do not re-apply scout-candidate to an issue that
        # was bounced within the cooldown. A bounced issue that lost its
        # scout-candidate label (e.g. panel discard) would otherwise re-enter
        # the queue every tick — the churn loop. The bounce comment is the
        # cooldown signal; leave the issue alone until the window expires.
        if [ "$label" = "scout-candidate" ]; then
            if bounce_in_cooldown "$(fetch_issue_comments "$repo" "$num")" "$NOW_ISO"; then
                log "  $repo#$num: skip scout-candidate re-apply (bounced within cooldown; fleet-ops#4022)"
                skipped=$((skipped + 1))
                continue
            fi
        fi
        log "  $repo#$num: unlabeled → $label ($title)"
        if apply_label "$repo" "$num" "$label"; then
            relabeled=$((relabeled + 1))
        else
            failed=$((failed + 1))
        fi
    done < <(printf '%s' "$list_json" | jq -c '.[]')

    # fleet-ops#4022: scout-candidate admission pass. A scout-candidate issue
    # whose body already PASSES the spec gate is ready work, not a proposal —
    # admit it to agent-ready so intake can claim it. One whose body FAILS the
    # gate and is older than 72h gets ONE bounce comment naming the missing
    # spec line and is left for the scout/worker to specify; the bounce marker
    # is the cooldown so the next sweep does not re-bounce or re-label it.
    # No gate is weakened: admission still routes through agent-ready-spec-gate.
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        title=$(printf '%s' "$row" | jq -r '.title // ""')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')
        issue_body=$(printf '%s' "$row" | jq -r '.body // ""')
        created=$(printf '%s' "$row" | jq -r '.createdAt // ""')
        # only issues currently labeled scout-candidate
        printf '%s' "$labels_json" | jq -e '.[] | select(.name=="scout-candidate")' >/dev/null 2>&1 || continue
        # terminal / hold states keep their own lifecycle; do not admit them
        if printf '%s' "$labels_json" | jq -e '.[] | select(.name=="discarded" or .name=="observe-to-close" or .name=="nish-reserved" or .name=="noise-class")' >/dev/null 2>&1; then
            continue
        fi
        if issue_passes_spec_gate "$issue_body" "$repo"; then
            log "  $repo#$num: scout-candidate passes spec gate → admit agent-ready ($title)"
            if admit_scout_candidate "$repo" "$num"; then
                admitted=$((admitted + 1))
            else
                failed=$((failed + 1))
            fi
        else
            # fleet-ops#4091: fetch comments lazily only for the bounce
            # check, not on the bulk list row (avoids the 504 that starved
            # product supply).
            if issue_older_than_bounce_age "$created" "$NOW_ISO" \
                && ! bounce_in_cooldown "$(fetch_issue_comments "$repo" "$num")" "$NOW_ISO"; then
                log "  $repo#$num: scout-candidate spec gate failed, >72h → bounce ($title)"
                if bounce_scout_candidate "$repo" "$num"; then
                    bounced=$((bounced + 1))
                else
                    failed=$((failed + 1))
                fi
            else
                skipped=$((skipped + 1))
            fi
        fi
    done < <(printf '%s' "$list_json" | jq -c '.[]')

    # fleet-ops#2766: heal dual-labeled discarded+scout-candidate leftovers.
    # Before discarded was a lifecycle label, the sweep re-added
    # scout-candidate on every discarded issue; 29 dual-labeled leftovers
    # on 0509 alone were still burning admission capacity (auditor lists
    # -l scout-candidate). Drop scout-candidate so discarded alone is the
    # terminal state. Idempotent: once healed, discarded alone is skipped
    # by issue_has_lifecycle above and never reaches this pass again.
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        title=$(printf '%s' "$row" | jq -r '.title // ""')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')
        has_discarded=0
        has_scout=0
        while IFS= read -r name; do
            [ -z "$name" ] && continue
            case "$name" in
                discarded) has_discarded=1 ;;
                scout-candidate) has_scout=1 ;;
            esac
        done < <(printf '%s' "$labels_json" | jq -r '.[].name // empty')
        if (( has_discarded == 1 && has_scout == 1 )); then
            log "  $repo#$num: discarded+scout-candidate dual-label → drop scout-candidate ($title)"
            if [ "$DRY" = "1" ]; then
                log "DRY $repo#$num: remove-label scout-candidate (heal discarded)"
                healed=$((healed + 1))
            elif gh issue edit "$num" -R "$repo" --remove-label scout-candidate >/dev/null 2>&1; then
                healed=$((healed + 1))
            else
                log "  $repo#$num: remove-label scout-candidate FAILED — retry next tick"
                failed=$((failed + 1))
            fi
        fi
    done < <(printf '%s' "$list_json" | jq -c '.[]')

    # fleet-ops#1083: class-lock reclassification pass. A class-lock issue
    # (fix(failed-command): / fix(decisions-ledger):) whose class-lock PR
    # has merged is parked under observe-to-close so intake stops
    # re-claiming it. This runs on issues that ALREADY have a lifecycle
    # label (the unlabeled pass above skipped them) — the release paths
    # flip them to agent-ready after StartLimitBurst, so they re-enter the
    # intake queue every tick. Only agent-ready / agent-in-progress /
    # agent-blocked are candidates; an issue already under observe-to-close
    # is left alone (idempotent). The merged-PR probe fail-opens: a gh blip
    # leaves the label untouched and the next tick retries.
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        title=$(printf '%s' "$row" | jq -r '.title // ""')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')
        is_class_lock_title "$title" || continue
        # Only reclassify the intake-visible / hold labels. observe-to-close
        # and nish-reserved/noise-class/scout-candidate/drill:* are not the
        # loop this issue owns.
        case "$(printf '%s' "$labels_json" | jq -r '.[].name // empty' | paste -sd, -)" in
            *agent-ready*|*agent-in-progress*|*agent-blocked*) ;;
            *) continue ;;
        esac
        if class_lock_pr_merged "$repo" "$num"; then
            log "  $repo#$num: class-lock PR merged → observe-to-close ($title)"
            if reclassify_to_observe_close "$repo" "$num" "$labels_json"; then
                reclassified=$((reclassified + 1))
            else
                failed=$((failed + 1))
            fi
        fi
    done < <(printf '%s' "$list_json" | jq -c '.[]')

    # fleet-ops#4892: decided-nish-reserved heal pass. A DECISION comment from
    # the judge takes an item "off Nish's tab" — the judge prompt requires
    # removing nish-reserved in the same run (item 1). When the judge forgets,
    # the issue stays open + nish-reserved and nish-boundary-notify re-pages
    # Nish every run (live #4838: 6 pages in 14h after the judge's DECISION).
    # This pass is the backstop detector: an open nish-reserved issue with a
    # DECISION comment has a stale label — remove nish-reserved so the question
    # stops paging. Comments are fetched lazily (fleet-ops#4091) only for
    # nish-reserved issues. Fail-open: a gh blip leaves the label untouched.
    while IFS= read -r row; do
        [ -z "$row" ] && continue
        num=$(printf '%s' "$row" | jq -r '.number')
        title=$(printf '%s' "$row" | jq -r '.title // ""')
        labels_json=$(printf '%s' "$row" | jq -c '.labels // []')
        printf '%s' "$labels_json" | jq -e '.[] | select(.name=="nish-reserved")' >/dev/null 2>&1 || continue
        if has_decision_comment "$(fetch_issue_comments "$repo" "$num")"; then
            log "  $repo#$num: nish-reserved + DECISION comment → remove stale nish-reserved (fleet-ops#4892) ($title)"
            if heal_decided_nish_reserved "$repo" "$num"; then
                decided_healed=$((decided_healed + 1))
            else
                failed=$((failed + 1))
            fi
        fi
    done < <(printf '%s' "$list_json" | jq -c '.[]')
done <<< "$repos"

log "sweep done: relabeled=$relabeled skipped=$skipped failed=$failed reclassified=$reclassified healed=$healed admitted=$admitted bounced=$bounced decided_healed=$decided_healed"
printf 'lifecycle-label-sweep relabeled=%s skipped=%s failed=%s reclassified=%s healed=%s admitted=%s bounced=%s decided_healed=%s\n' \
    "$relabeled" "$skipped" "$failed" "$reclassified" "$healed" "$admitted" "$bounced" "$decided_healed"

if [ "$DRILL" = "1" ]; then
    if [ "$DRY" = "1" ]; then
        echo "drill ok: dry-run (no fixture filed)"
        exit 0
    fi
    view_json=$(gh issue view "$drill_num" -R "$drill_repo" --json labels,title 2>/dev/null) || {
        log "FATAL: drill could not view $drill_repo#$drill_num"
        exit 1
    }
    drill_labels=$(printf '%s' "$view_json" | jq -c '.labels // []')
    if issue_has_lifecycle "$drill_labels"; then
        log "drill ok: $drill_repo#$drill_num now has a lifecycle label"
        gh issue close "$drill_num" -R "$drill_repo" --reason "not planned" >/dev/null 2>&1 || true
        echo "drill ok: $drill_repo#$drill_num labeled"
        exit 0
    fi
    log "FATAL: drill fixture $drill_repo#$drill_num still unlabeled after the tick"
    gh issue close "$drill_num" -R "$drill_repo" --reason "not planned" >/dev/null 2>&1 || true
    echo "drill FAIL: $drill_repo#$drill_num still unlabeled" >&2
    exit 1
fi

exit 0
