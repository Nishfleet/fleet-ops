#!/usr/bin/env bash
# pi-intake-trigger — reads trigger files and starts corresponding pi-intake@ instances.
# Triggered by pi-intake-trigger.path watching /home/nish/workspaces/agent-state/pi-intake-triggers/
# Each trigger file is named after the repo (e.g., fleet-ops, 0509) and contains the repo name.
# This is the event-driven complement to the 15-min pi-intake@* timers (GitHub has no push
# channel to the VPS, so the timers remain as dead-man backstops).

set -euo pipefail
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

TRIGGER_DIR="${PI_INTAKE_TRIGGER_DIR:-/home/nish/workspaces/agent-state/pi-intake-triggers}"
# fleet-ops#5385: the trigger must honour the declared enrolment set — a deferred
# repo's trigger file must not restart its intake. Same live source of truth the
# reconciler unit converges on (the merge-to-live deploy clone, fleet-ops#149;
# NOT products/fleet-ops, which is a dev checkout and can sit on any branch).
INTAKE_JSON="${PI_INTAKE_TRIGGER_INTAKE_JSON:-/home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/intake-repos.json}"
mkdir -p "$TRIGGER_DIR"

log() { printf '[%s] [pi-intake-trigger] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# Process each trigger file
for trigger_file in "$TRIGGER_DIR"/*; do
    [[ -f "$trigger_file" ]] || continue
    repo=$(basename "$trigger_file")
    [[ -n "$repo" ]] || continue

    # Fail closed: missing/unparseable intake config or a repo absent from
    # .repos[].name means skip — the 15-min timers remain as backstop.
    if ! jq -e --arg r "$repo" '[.repos[]?.name] | index($r)' "$INTAKE_JSON" >/dev/null 2>&1; then
        log "Skipping pi-intake@$repo — not in .repos[].name of $INTAKE_JSON (deferred/excluded or config unreadable)"
        rm -f "$trigger_file"
        continue
    fi

    log "Triggering pi-intake@$repo"
    # --no-block: the intake unit owns its own runtime; a blocking start made
    # this oneshot inherit it and blow its 30s TimeoutStartSec (fleet-ops#4561).
    systemctl --user start --no-block "pi-intake@$repo.service" || log "Failed to start pi-intake@$repo (may already be running)"

    # Remove the trigger file after processing
    rm -f "$trigger_file"
done

exit 0
