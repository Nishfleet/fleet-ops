#!/usr/bin/env bash
# fleet-heartbeat-low-water-mark — tier1 block 9 (fleet-ops#146).
#
# Supply cadence is the constraint, not lanes. Measured 2026-08-26 morning:
# scouts fired 08:00-08:04 IST, workers drained every generated issue by
# 08:46, the ready queue then sat at 0 with idle lanes until the next timer
# pass at 12:02 — feast ~40min, famine ~3h20m. The 4h scout timer refills
# AFTER lanes drain, so a starvation gap is scheduled into every cycle.
#
# This pass treats the ready queue as a producer-consumer buffer with a LOW
# WATER MARK, so replenishment overlaps consumption and lanes never hit empty.
# On each heartbeat tier1 tick, for every enrolled repo (config/intake-
# repos.json — the same source of truth undersaturation + blocked-reconcile
# read):
#
#   if ready < lane_ceiling          (the live RAM-governor lane count —
#                                     seat_max_concurrent(); fewer ready
#                                     items than lanes means starvation is
#                                     already scheduled)
#      AND no scout for that repo is currently running
#      AND the threshold-trigger stamp for that repo is stale (>2h)
#   -> systemctl --user start --no-block pi-scout@<repo>.service
#      and write the stamp.
#
# Bound: at most one threshold-triggered pass per repo per 2h, so a scout
# pass that legitimately finds nothing does not loop on the next 30-min
# tick. The 4h timer stays as the floor for repos that never trip the
# threshold. Event-driven per the compute rule: no new pollers — this rides
# the tier1 tick that already runs.
#
# Quality bar unchanged: scouts still apply their own spec gate (the
# pi-scout@.service ExecCondition rests at >=24h of work at the measured
# drain rate, fleet-ops#540, and the scout prompt applies the spec gate).
# This pass changes WHEN scouts look, never what qualifies as work.
# "Nothing worth generating" remains a valid, logged scout outcome — an
# empty pass must never manufacture make-work to satisfy the threshold.
# We only nudge the scout to LOOK sooner; we do not feed it work to do.
#
# Go-ham (ledger 2026-08-26): remaining hours < 12 at the measured drain
# rate also dispatches, even when ready >= lanes. A fast drain can empty
# a large ready queue in under 12h; lane-count alone would sit idle.
#
# This is a best-effort supply nudge, NOT a fail-loud alarm (that is
# undersaturation's job). A non-zero exit here is a CONFIG error (missing
# intake-repos.json / jq / seat-lib); the tier1 wrapper logs it and writes a
# LOUD triage line but does NOT let it brick the heartbeat — a broken
# refill nudge must not stop PR queuing, orphan reclaim, or the wedge alarm.
#
# Environment seams (tests):
#   SYSTEMCTL                    default systemctl
#   GH                           default gh
#   FLEET_INTAKE_REPOS_JSON      default .../config/intake-repos.json
#   FLEET_HEARTBEAT_LOG_DIR      stamp + log state
#   FLEET_HEARTBEAT_TRIAGE       triage file
#   PI_PACKET_SEAT_LIB           seat-lib.sh path (for seat_max_concurrent)
#   FLEET_LOW_WATER_LANE_CEILING if set, overrides seat_max_concurrent()
#                                (test seam + production escape hatch)
#   FLEET_LOW_WATER_MIN_INTERVAL_S  stamp freshness bound (default 7200 = 2h)
#   FLEET_LOW_WATER_STAMP_DIR    stamp directory (default $LOG_DIR/low-water-mark)
#   FLEET_WORK_SUPPLY_HOURS      override remaining hours (tests + #540 gate)
#   FLEET_WORK_SUPPLY_LIB        work-supply.sh (default installed dest)
#
# Exit: 0 = pass complete (dispatched where appropriate, skipped otherwise).
#       2 = config error (missing intake-repos.json / jq / seat-lib).

set -euo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

SYSTEMCTL="${SYSTEMCTL:-systemctl}"
GH="${GH:-gh}"
INTAKE_JSON="${FLEET_INTAKE_REPOS_JSON:-/home/nish/workspaces/products/fleet-ops/config/intake-repos.json}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
LOG_DIR="${FLEET_HEARTBEAT_LOG_DIR:-/home/nish/.local/state/fleet-heartbeat}"
SEAT_LIB_DEFAULT="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
MIN_INTERVAL_S="${FLEET_LOW_WATER_MIN_INTERVAL_S:-7200}"
STAMP_DIR="${FLEET_LOW_WATER_STAMP_DIR:-$LOG_DIR/low-water-mark}"
WS_LIB="${FLEET_WORK_SUPPLY_LIB:-$HOME/.local/lib/pi-packet/work-supply.sh}"
if [ ! -f "$WS_LIB" ]; then
    _lwm_src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$_lwm_src/../lib/work-supply.sh" ]; then
        WS_LIB="$(cd "$_lwm_src/../lib" && pwd)/work-supply.sh"
    fi
fi
if [ -f "$WS_LIB" ]; then
    # shellcheck source=../lib/work-supply.sh source-path=SCRIPTDIR
    source "$WS_LIB"
fi

mkdir -p "$LOG_DIR" "$STAMP_DIR"

log() {
    printf '[%s] [fleet-heartbeat-low-water-mark] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

# Loud lines go to BOTH stderr and the triage file (single page for humans +
# other agents). Format matches fleet-heartbeat-tier1's loud() helper.
loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

# --- preflight: config + tools ---------------------------------------------
[ -f "$INTAKE_JSON" ] || {
    loud "LOW-WATER-CONFIG" "intake-repos.json missing: $INTAKE_JSON — cannot determine enrolled repos"
    log "FATAL: intake-repos.json missing: $INTAKE_JSON"
    exit 2
}
command -v jq >/dev/null 2>&1 || {
    loud "LOW-WATER-CONFIG" "jq missing — cannot parse $INTAKE_JSON"
    log "FATAL: jq missing"
    exit 2
}

# --- enrolled repos (source of truth: config/intake-repos.json) -------------
enrolled_repos=$(jq -r '.repos[].name | "Nishfleet/" + .' "$INTAKE_JSON")

# --- lane ceiling: the live RAM-governor lane count (seat_max_concurrent) ---
# The natural low-water mark: fewer ready items than lanes means starvation is
# already scheduled. FLEET_LOW_WATER_LANE_CEILING overrides seat-lib entirely
# (test seam + production escape hatch); otherwise source seat-lib once and
# call seat_max_concurrent() = min(sum_of_provider_caps, ram_governor_cap).
_LWM_SEAT_LIB_LOADED=0
lane_ceiling() {
    if [ -n "${FLEET_LOW_WATER_LANE_CEILING:-}" ]; then
        printf '%s\n' "$FLEET_LOW_WATER_LANE_CEILING"
        return 0
    fi
    if [ "$_LWM_SEAT_LIB_LOADED" -eq 0 ]; then
        if [ ! -f "$SEAT_LIB_DEFAULT" ]; then
            loud "LOW-WATER-CONFIG" "seat-lib missing: $SEAT_LIB_DEFAULT — set FLEET_LOW_WATER_LANE_CEILING or install seat-lib"
            log "FATAL: seat-lib missing: $SEAT_LIB_DEFAULT"
            return 1
        fi
        # shellcheck source=/dev/null
        source "$SEAT_LIB_DEFAULT"
        _LWM_SEAT_LIB_LOADED=1
    fi
    seat_max_concurrent
}

# --- ready count for one repo (open agent-ready issues) ---------------------
# On gh failure we return empty (caller skips dispatch on bad data — better to
# miss one refill window than to spam scouts on a transient gh outage).
ready_count() {
    local repo="$1"
    "$GH" issue list -R "$repo" -l agent-ready --state open \
        --json number --limit 200 --jq 'length' 2>/dev/null || true
}

# --- scout liveness for one repo -------------------------------------------
# A scout is live iff pi-scout@<repo>.service is active or activating (a
# Type=oneshot scout is `activating` while pi is running, `active` mid-run).
# is-active prints the state on stdout; we treat active/activating as held.
scout_active() {
    local short="$1" state
    state=$("$SYSTEMCTL" --user is-active "pi-scout@${short}.service" 2>/dev/null || echo inactive)
    case "$state" in
        active|activating) return 0 ;;
        *) return 1 ;;
    esac
}

# --- stamp freshness for one repo ------------------------------------------
# Returns 0 (stale / allow) if the stamp is missing, unparseable, or older
# than MIN_INTERVAL_S; returns 1 (fresh / block) if younger.
stamp_stale() {
    local short="$1" stamp ts now_s last_s age_s
    stamp="$STAMP_DIR/${short}.stamp"
    [ -f "$stamp" ] || return 0
    ts=$(cat "$stamp" 2>/dev/null || echo "")
    [ -n "$ts" ] || return 0
    now_s=$(date -u +%s)
    last_s=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
    [ "$last_s" -gt 0 ] 2>/dev/null || return 0
    age_s=$(( now_s - last_s ))
    [ "$age_s" -ge "$MIN_INTERVAL_S" ]
}

write_stamp() {
    local short="$1"
    date -u +%Y-%m-%dT%H:%M:%SZ > "$STAMP_DIR/${short}.stamp"
}

# ============================================================================
# main
# ============================================================================
log "low-water-mark pass starting (min_interval=${MIN_INTERVAL_S}s)"

lanes=$(lane_ceiling) || exit 2
# lane_ceiling must yield a positive integer; a 0 or non-numeric ceiling would
# make `ready < lanes` always false (no dispatch) or error. Fail loud on either.
case "$lanes" in
    ''|*[!0-9]*)
        loud "LOW-WATER-CONFIG" "lane ceiling not a positive integer: '$lanes' — refusing to dispatch"
        log "FATAL: lane ceiling not a positive integer: '$lanes'"
        exit 2
        ;;
esac
if [ "$lanes" -le 0 ]; then
    loud "LOW-WATER-CONFIG" "lane ceiling is 0 — no lanes, no dispatch"
    log "WARN: lane ceiling is 0; skipping all repos"
    exit 0
fi
log "lane ceiling = $lanes"

dispatched=0
skipped_ready=0
skipped_active=0
skipped_fresh=0
skipped_gh=0

while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    short="${repo##*/}"

    if scout_active "$short"; then
        log "  - $repo: scout pi-scout@${short}.service ACTIVE — skip"
        skipped_active=$((skipped_active+1))
        continue
    fi

    if ! stamp_stale "$short"; then
        log "  - $repo: threshold stamp fresh (<${MIN_INTERVAL_S}s) — skip"
        skipped_fresh=$((skipped_fresh+1))
        continue
    fi

    ready=$(ready_count "$repo")
    if [ -z "$ready" ]; then
        log "  - $repo: gh issue list FAILED — skip (cannot count ready)"
        skipped_gh=$((skipped_gh+1))
        continue
    fi
    # Defensive: ready must be a non-negative integer.
    case "$ready" in
        ''|*[!0-9]*)
            log "  - $repo: ready count not numeric: '$ready' — skip"
            skipped_gh=$((skipped_gh+1))
            continue
            ;;
    esac

    hours=""
    if [ -n "${FLEET_WORK_SUPPLY_HOURS:-}" ]; then
        hours="$FLEET_WORK_SUPPLY_HOURS"
    elif [ -n "${WS_LIB:-}" ] && [ -f "$WS_LIB" ] && type work_supply_hours >/dev/null 2>&1; then
        hours=$(work_supply_hours "$ready" 0)
    fi
    case "$hours" in
        ''|*[!0-9]*) hours="" ;;
    esac

    go_ham=0
    starve=0
    if [ -n "$hours" ] && [ "$hours" -lt "${WORK_SUPPLY_GOHAM_H:-12}" ]; then
        go_ham=1
    fi
    if [ "$ready" -lt "$lanes" ]; then
        starve=1
    fi

    if [ "$go_ham" -eq 0 ] && [ "$starve" -eq 0 ]; then
        log "  - $repo: ready=$ready >= lanes=$lanes hours=${hours:-n/a} — no dispatch"
        skipped_ready=$((skipped_ready+1))
        continue
    fi

    # ready < lanes (starvation) and/or hours < 12 (go-ham), scout idle, stamp stale.
    if "$SYSTEMCTL" --user start --no-block "pi-scout@${short}.service" 2>/dev/null; then
        write_stamp "$short"
        loud "LOW-WATER-REFILL" "repo=$repo ready=$ready lanes=$lanes hours=${hours:-n/a} — started pi-scout@${short}.service (threshold-triggered, stamp written)"
        log "  - $repo: DISPATCHED pi-scout@${short}.service (ready=$ready lanes=$lanes hours=${hours:-n/a} go_ham=$go_ham starve=$starve)"
        dispatched=$((dispatched+1))
    else
        loud "LOW-WATER-REFILL-FAIL" "repo=$repo ready=$ready lanes=$lanes — systemctl start pi-scout@${short}.service FAILED"
        log "  - $repo: start pi-scout@${short}.service FAILED"
        skipped_gh=$((skipped_gh+1))
    fi
done <<< "$enrolled_repos"

log "low-water-mark pass complete: dispatched=$dispatched skipped_ready=$skipped_ready skipped_active=$skipped_active skipped_fresh=$skipped_fresh skipped_gh=$skipped_gh"
exit 0
