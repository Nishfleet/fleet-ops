#!/usr/bin/env bash
# pi-issue-run — seat-rotation wrapper for pi-issue worker units (P4-A + P13-B).
#
# This is the ExecStart of pi-issue@.service. systemd handles the retry
# ladder natively (Restart=/RestartSec=/RestartSteps=/StartLimitBurst=),
# so this script does ONLY what systemd cannot:
#
#   1. Pick a DIFFERENT seat on each restart. systemd restarts the same
#      ExecStart, so seat rotation is real added value — see seat-lib.sh.
#      This is the gap the legacy intake path had (hardcoded
#      --provider devin --model glm-5-2 in the systemd-run ExecStart);
#      wiring this through is what point 4 of the P4-A packet required.
#   2. No-op detection: if pi exits 0 but produced no real output (< 20 B
#      to stdout), exit non-zero so systemd's Restart= treats it as a
#      failure and re-seats. 20 B is enough for a GitHub PR URL or a short
#      status like 'blocked: proposal posted' (26 B).
#   3. Active-seat registration: writes the picked seat to the per-seat
#      state dir so seat-lib.sh's cap accounting reflects the running
#      worker. Cleared on exit via trap.
#   4. P13-B spawn-phase failure marker: if pi dies in < SPAWN_FAIL_MAX_S
#      (default 120s) AND the captured output contains an ETIMEDOUT pattern
#      paired with a spawn/socket/connect/child/handshake neighbour, write
#      a per-seat ledger entry via mark_seat_spawn_fail (seat-lib.sh).
#   6. Defensive mkdir for $ATTEMPTS_DIR: fleet-ops#63 observed the dir
#      vanish between startup and the tried-seats append, stranding workers
#      in crash-loop on a benign filesystem-cleanup race. The startup
#      mkdir is no longer enough; recreate inline before the append so a
#      mid-run wipe cannot permanently strand this worker.
#   5. P14 worker credential split: if $WORKER_APP_CREDS_FILE exists
#      (default ~/.config/fleet-worker/nishfleet-worker.env), mint a fresh
#      installation token via the nishfleet-worker GitHub App and export
#      GH_TOKEN for the child pi process. The App's permissions are
#      Contents/Pull requests/Issues write + Metadata read — workers
#      physically cannot push .github/workflows/** or touch protection.
#      If the creds file is absent OR worker-token mints fails, the script
#      FALLS THROUGH to the existing gh auth — failure of the new path
#      cannot break the old one. This is the deterministic counterpart
#      to the worker-credential-split.sh prerequisite: that script only
#      captures a fine-grained PAT; this PR replaces it with a GitHub App
#      identity that is repeatable and fully mechanical after Nish's first
#      manifest click.
#      The marker is byte-compatible with SeatLedgerEntry (seat-health.ts);
#      pick_seat honours it via the existing usable_at check. This is the
#      deterministic counterpart to seat-health.ts's response-time hooks:
#      no polling, no new timers, no new units — just an extra write on
#      the failure path that the worker was already going to take.
#
# What this script does NOT do (systemd handles it):
#   - Retry counting (StartLimitBurst=)
#   - Cooldown/backoff (RestartSec=/RestartSteps=)
#   - Hang detection (TimeoutStartSec=)
#   - Escalation on exhaustion (OnFailure= -> pi-issue-failed@%i.service)
#   - Preventing resurrection of a deliberately-stopped unit (systemd's
#     Restart= does not fire when the stop was a systemd operation)
#
# Args:
#   $1 = unit instance name (e.g. 0509-915), set by systemd %i
#
# Exit codes:
#   0 = pi ran and produced real output (success — systemd will not restart)
#   1 = pi failed, OR pi exited 0 but produced no output (no-op)
#        -> systemd Restart=on-failure re-runs this script, which picks a
#           different seat. After StartLimitBurst, OnFailure= escalates.
#
# Never notifies Nish. No email, no chat. Only repairs or fails for escalation.

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HOME="${HOME:-/home/nish}"

# Source shared seat logic. SEAT_LIB defaults to the install symlink; tests
# may override via PI_PACKET_SEAT_LIB. The directive points to the canonical
# source file in the repo (the install symlinks this same file), so static
# analysis can resolve the include.
SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
# shellcheck source=../lib/seat-lib.sh source-path=SCRIPTDIR
source "$SEAT_LIB"

OUT_MIN="${PI_PACKET_RUN_OUT_MIN:-20}"

[[ $# -ge 1 ]] || { echo "pi-issue-run: need 1 arg: <unit-instance>" >&2; exit 1; }
inst="$1"
pkt="$STATE_DIR/../pi-issues/${inst}.in"
# Resolve to an absolute path (the line above uses $STATE_DIR/.. — keep it
# explicit so it does not surprise a future refactor).
pkt="/home/nish/.local/state/pi-issues/${inst}.in"
out_file="/home/nish/.local/state/pi-issues/${inst}.out"
err_file="/home/nish/.local/state/pi-issues/${inst}.err"
tried_file="$ATTEMPTS_DIR/pi-issue-${inst}.tried-seats"

mkdir -p "$ATTEMPTS_DIR" "$(dirname "$out_file")"

[[ -f "$pkt" ]] || { echo "pi-issue-run: packet file not found: $pkt" >&2; exit 1; }

# --- pick a seat for THIS attempt ------------------------------------------
weight=$(task_weight "$pkt")
need_capable=0
[[ "$weight" == "heavy" ]] && need_capable=1

# First attempt: no exclusions. Subsequent attempts (after a restart) carry
# the previously-tried seats in $tried_file; pick_seat excludes them all.
seat=$(pick_seat "" "" "$need_capable" "$tried_file" || true)
if [[ -z "$seat" ]]; then
    seat_log "pi-issue-run: $inst no seat available (tried: $(tr '\n' ' ' < "$tried_file" 2>/dev/null)) — exiting 1 so OnFailure escalates"
    exit 1
fi

np=$(printf '%s' "$seat" | cut -f1)
nm=$(printf '%s' "$seat" | cut -f2)

# Defensive recreate: $ATTEMPTS_DIR was created at startup, but something
# (a concurrent worker, a tmpfiles.d rule, an external cleanup) has been
# wiping it from under running workers. fleet-ops#63. The error was
# "pi-issue-run: line 100: .../attempts/pi-issue-fleet-ops-34.tried-seats:
# No such file or directory" — the dir vanished between the startup
# mkdir and the append below. Recreate inline before the write so a
# wipe mid-run doesn't permanently strand the worker in crash-loop.
mkdir -p "$ATTEMPTS_DIR" 2>/dev/null || {
    seat_log "pi-issue-run: $inst FAILED to recreate $ATTEMPTS_DIR (wiped and unrecoverable) — exiting 1"
    exit 1
}

# Record this seat as tried BEFORE running, so a concurrent restart cannot
# pick the same one. Append "provider/model" per line.
printf '%s/%s\n' "$np" "$nm" >>"$tried_file"

# Register the seat so cap accounting reflects this worker. Cleared on exit.
register_active_seat "pi-issue-${inst}" "$np" "$nm"
trap 'clear_active_seat "pi-issue-${inst}"' EXIT INT TERM

seat_log "pi-issue-run: $inst running on $np/$nm (weight=$weight, tried: $(wc -l < "$tried_file") seat(s))"

# --- P14: replace GH_TOKEN with a short-lived installation token ------------
# Fail-closed by design: if the creds file is absent OR worker-token cannot
# mint (network, key, app not installed), we leave the inherited GH_TOKEN
# unset and the child sees the existing gh auth via ~/.config/gh. That is
# exactly the pre-PR behaviour, so this code path can never make the fleet
# worse than today.
WORKER_CREDS_FILE="${WORKER_APP_CREDS_FILE:-$HOME/.config/fleet-worker/nishfleet-worker.env}"
if [[ -f "$WORKER_CREDS_FILE" ]]; then
  WORKER_TOKEN_BIN="${WORKER_TOKEN_BIN:-$HOME/.local/bin/worker-token}"
  if [[ -x "$WORKER_TOKEN_BIN" ]]; then
    if worker_tok_out="$("$WORKER_TOKEN_BIN" --print 2>/tmp/pi-issue-run-worker-token.err)"; then
      # shellcheck disable=SC2162
      eval "$worker_tok_out"
      seat_log "pi-issue-run: $inst GH_TOKEN rotated to nishfleet-worker App token (${#GH_TOKEN}-char, ttl<=1h)"
      worker_tok_out=""
    else
      seat_log "pi-issue-run: $inst worker-token mint failed (exit $?); falling through to existing gh auth"
      seat_log "pi-issue-run: $inst worker-token stderr: $(tr '\n' ' ' </tmp/pi-issue-run-worker-token.err 2>/dev/null)"
    fi
  else
    seat_log "pi-issue-run: $inst $WORKER_TOKEN_BIN not found; falling through to existing gh auth"
  fi
  rm -f /tmp/pi-issue-run-worker-token.err
else
  seat_log "pi-issue-run: $inst no nishfleet-worker creds file at $WORKER_CREDS_FILE; falling through to existing gh auth"
fi

# --- run pi, capture stdout/stderr -----------------------------------------
# pi reads the packet from stdin. We capture stdout to measure output size
# for no-op detection. stderr goes to the err file for the council packet.
# Time the run too — P13-B spawn-visibility needs to distinguish a spawn-
# phase ETIMEDOUT (< 120s) from a long-session transient.
spawn_start_s=$(date -u +%s)
rc=0
"$PI_BIN" --print --provider "$np" --model "$nm" < "$pkt" >"$out_file" 2>"$err_file" || rc=$?
spawn_end_s=$(date -u +%s)
spawn_elapsed_s=$((spawn_end_s - spawn_start_s))

# --- P13-B spawn-fail marker (P13 visibility gap fix) ----------------------
# seat-health.ts writes its ledger ONLY via after_provider_response and
# cli_* — neither fires if pi dies at spawn (e.g. devin / cursor spawnSync
# ETIMEDOUT). Without this fix, pick_seat keeps routing work to a seat
# whose every spawn is timing out. We catch the trigger condition here,
# write the marker into the per-seat ledger, and continue with the normal
# non-zero exit so systemd restart picks a different seat. The marker
# sets usable_at = now + 5 min, so the OUTBOUND retry also skips it.
spawn_fail_triggered=0
if (( rc != 0 )) && (( spawn_elapsed_s < SPAWN_FAIL_MAX_S )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_spawn_etimeout "$out_for_scan" "$err_for_scan"; then
        spawn_fail_triggered=1
        # Make sure seat-log is loud even if the marker write itself fails.
        seat_log "pi-issue-run: $inst SPAWN-TIMEOUT on $np/$nm at ${spawn_elapsed_s}s (rc=$rc) — marking seat unusable for ${SPAWN_FAIL_BACKOFF_S}s"
        if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:rc=$rc"; then
            seat_log "pi-issue-run: $inst seat $np/$nm marked; next systemd Restart will pick a different seat via pick_seat (excluded by usable_at in the future)"
        else
            seat_log "pi-issue-run: $inst WARN: spawn-fail marker write FAILED for $np/$nm — relying on systemd Restart alone to dodge the dead seat"
        fi
    fi
fi

if (( rc != 0 )); then
    seat_log "pi-issue-run: $inst pi exited $rc on $np/$nm (${spawn_elapsed_s}s, spawn_fail=$spawn_fail_triggered) — systemd will restart with a new seat"
    exit 1
fi

# --- no-op detection: exit 0 with trivial output -> exit 1 ------------------
out_bytes=0
[[ -f "$out_file" ]] && out_bytes=$(wc -c < "$out_file" 2>/dev/null || echo 0)
out_bytes=${out_bytes//[^0-9]/}; out_bytes=${out_bytes:-0}

if (( out_bytes < OUT_MIN )); then
    seat_log "pi-issue-run: $inst pi exited 0 but stdout=${out_bytes}B (< ${OUT_MIN}B) — no-op, exiting 1 so systemd re-seats"
    exit 1
fi

seat_log "pi-issue-run: $inst SUCCESS on $np/$nm (${out_bytes}B output)"
exit 0
