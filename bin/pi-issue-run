#!/usr/bin/env bash
# pi-issue-run — seat-rotation wrapper for pi-issue worker units (P4-A + P13-B).
#
# This is the ExecStart of pi-issue@.service. systemd handles the retry
# ladder natively (Restart=/RestartSec=/RestartSteps=/StartLimitBurst=),
# so this script does ONLY what systemd cannot:
#
#   1. Pick a DIFFERENT seat on each restart. systemd restarts the same
#      ExecStart, so seat rotation is real added value — see seat-lib.sh.
#      This is the gap the legacy intake path had (hardcoded
#      --provider devin --model glm-5-2 in the systemd-run ExecStart);
#      wiring this through is what point 4 of the P4-A packet required.
#   2. No-op detection: if pi exits 0 but produced no real output (< 20 B
#      to stdout), bench the seat via mark_seat_spawn_fail (short backoff,
#      same as spawn-fail) and exit non-zero so systemd's Restart= treats
#      it as a failure and re-seats. Without the bench, pick_seat re-selects
#      the same still-healthy seat on an intake re-spawn with an empty
#      tried-seats file (fleet-ops#390 / fleet-ops-378). 20 B is enough
#      for a GitHub PR URL or a short status like 'blocked: proposal posted'
#      (26 B).
#   3. Active-seat registration: writes the picked seat to the per-seat
#      state dir so seat-lib.sh's cap accounting reflects the running
#      worker. Cleared on exit via trap.
#   4. P13-B spawn-phase failure marker: if pi dies in < SPAWN_FAIL_MAX_S
#      (default 120s) AND the captured output contains an ETIMEDOUT pattern
#      paired with a spawn/socket/connect/child/handshake neighbour, write
#      a per-seat ledger entry via mark_seat_spawn_fail (seat-lib.sh).
#   4b. fleet-ops#90 quota/cap wall bench: if pi exits non-zero with a
#      quota/cap error carrying a reset window (ClinePass weekly cap,
#      "retry after", 429 with retry_after), write health_class=quota_bench
#      and bench_until so pick_seat skips the seat until then (or the
#      provider default in seat-caps.json). A walled seat is a lane fault,
#      never charged to the work item.
#   6. Defensive mkdir for $ATTEMPTS_DIR: fleet-ops#63 observed the dir
#      vanish between startup and the tried-seats append, stranding workers
#      in crash-loop on a benign filesystem-cleanup race. The startup
#      mkdir is no longer enough; recreate inline before the append so a
#      mid-run wipe cannot permanently strand this worker.
#   5. P14 worker credential split: if $WORKER_APP_CREDS_FILE exists
#      (default ~/.config/fleet-worker/nishfleet-worker.env), mint a fresh
#      installation token via the nishfleet-worker GitHub App and export
#      it for the child pi process. The App's permissions are
#      Contents/Pull requests/Issues write + Metadata read — workers
#      physically cannot push .github/workflows/** or touch protection.
#      If the creds file is absent, the script falls through to existing
#      gh auth (pre-P14 behaviour; the human token stays on disk until a
#      dedicated retirement PR). If the creds file EXISTS and mint fails,
#      the script SCREAMS (exit 1, DEAD APP IDENTITY) — a dead App must
#      not silently impersonate the human account (fleet-ops#413).
#      The marker is byte-compatible with SeatLedgerEntry (seat-health.ts);
#      pick_seat honours it via the existing usable_at check. This is the
#      deterministic counterpart to seat-health.ts's response-time hooks:
#      no polling, no new timers, no new units — just an extra write on
#      the failure path that the worker was already going to take.
#
# What this script does NOT do (systemd handles it):
#   - Retry counting (StartLimitBurst=)
#   - Cooldown/backoff (RestartSec=/RestartSteps=)
#   - Hang detection (TimeoutStartSec=)
#   - Escalation on exhaustion (OnFailure= -> pi-issue-failed@%i.service)
#   - Preventing resurrection of a deliberately-stopped unit (systemd's
#     Restart= does not fire when the stop was a systemd operation)
#
# Args:
#   $1 = unit instance name (e.g. 0509-915), set by systemd %i
#
# Exit codes:
#   0 = pi ran and produced real output (success — systemd will not restart)
#   1 = pi failed, OR pi exited 0 but produced no output (no-op)
#        -> systemd Restart=on-failure re-runs this script, which picks a
#           different seat. After StartLimitBurst, OnFailure= escalates.
#
# Never notifies Nish. No email, no chat. Only repairs or fails for escalation.

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HOME="${HOME:-/home/nish}"

# Source shared seat logic. SEAT_LIB defaults to the install symlink; tests
# may override via PI_PACKET_SEAT_LIB. The directive points to the canonical
# source file in the repo (the install symlinks this same file), so static
# analysis can resolve the include.
SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
# shellcheck source=../lib/seat-lib.sh source-path=SCRIPTDIR
source "$SEAT_LIB"

OUT_MIN="${PI_PACKET_RUN_OUT_MIN:-20}"

# is_mid_session_death — true when the captured stderr shows the provider
# process was killed mid-session by a signal (SIGTERM=143, SIGKILL=137,
# OOM "Killed") rather than a quota wall or a spawn-phase ETIMEDOUT. The
# vendor CLIs self-terminate without a useful error; the marker line is the
# only signal. cursor-grok-4.6-high exits 143 on heavy ~14-minute packets
# (0509-974: 3/3 attempts 2026-08-26; pi-issue-run then re-reports rc=1 with
# "Cursor exited with code 143" in stderr). Not a quota wall (429) and not
# the spawn path (elapsed > SPAWN_FAIL_MAX_S), so it previously fell through
# UNBENCHED: the only protection against re-picking the killing seat was the
# tried-seats exclusion, and the reaper wipes tried-seats on every reap — so
# the intake re-claim started from an empty list and pick_seat re-selected
# the same killing seat (the summoning trip).
is_mid_session_death() {
    local err="${1:-}"
    [[ -f "$err" ]] || return 1
    grep -qiE 'exited with code 143|code 143|SIGTERM|terminated|Killed' "$err" 2>/dev/null
}

[[ $# -ge 1 ]] || { echo "pi-issue-run: need 1 arg: <unit-instance>" >&2; exit 1; }
inst="$1"
# PI_ISSUES_DIR lets tests redirect the packet/out/err triplet into a
# scratch dir. Default is the live install path; production is unchanged.
PI_ISSUES_DIR="${PI_ISSUES_DIR:-/home/nish/.local/state/pi-issues}"
pkt="$PI_ISSUES_DIR/${inst}.in"
out_file="$PI_ISSUES_DIR/${inst}.out"
err_file="$PI_ISSUES_DIR/${inst}.err"
tried_file="$ATTEMPTS_DIR/pi-issue-${inst}.tried-seats"

mkdir -p "$ATTEMPTS_DIR" "$(dirname "$out_file")"

[[ -f "$pkt" ]] || { echo "pi-issue-run: packet file not found: $pkt" >&2; exit 1; }

# --- pick a seat for THIS attempt ------------------------------------------
weight=$(task_weight "$pkt")
need_capable=0
[[ "$weight" == "heavy" ]] && need_capable=1

# First attempt: no exclusions. Subsequent attempts (after a restart) carry
# the previously-tried seats in $tried_file; pick_seat excludes them all.
seat=$(pick_seat "" "" "$need_capable" "$tried_file" || true)
if [[ -z "$seat" ]]; then
    # The tried file does not exist on the first attempt; the `2>/dev/null`
    # on `tr` does not suppress a failed redirection, so test before reading.
    tried_list=""
    if [[ -f "$tried_file" ]]; then
        tried_list=$(tr '\n' ' ' < "$tried_file" 2>/dev/null || true)
    fi
    seat_log "pi-issue-run: $inst no seat available (tried: ${tried_list}) — exiting 1 so OnFailure escalates"
    # Recreate the attempts dir in case it was wiped between the startup mkdir
    # and this no-seat path (fleet-ops#63), then reset the tried-seats file.
    # Every allowlisted seat has now been tried and failed, so the within-burst
    # rotation list has done its job. The seat-health ledger (usable_at) is the
    # DURABLE avoidance authority — seats still in backoff stay gated there.
    # Clearing tried_file lets the next restart retry seats that have RECOVERED,
    # instead of looping forever on an exhausted list. Without this, a worker
    # that burned through every capable seat once can never pick a seat again:
    # every restart finds the same stale list and exits 1 in <1s (the
    # 2026-08-26 fleet-ops-32 stuck loop — all 4 heavy seats failed, then
    # 8+ restarts exited instantly with "no seat available").
    if ! mkdir -p "$ATTEMPTS_DIR" 2>/dev/null; then
        seat_log "pi-issue-run: $inst FAILED to recreate $ATTEMPTS_DIR (wiped and unrecoverable) — exiting 1"
        exit 1
    fi
    : >"$tried_file"
    exit 1
fi

np=$(printf '%s' "$seat" | cut -f1)
nm=$(printf '%s' "$seat" | cut -f2)

# Defensive recreate: $ATTEMPTS_DIR was created at startup, but something
# (a concurrent worker, a tmpfiles.d rule, an external cleanup) has been
# wiping it from under running workers. fleet-ops#63. The error was
# "pi-issue-run: line 100: .../attempts/pi-issue-fleet-ops-34.tried-seats:
# No such file or directory" — the dir vanished between the startup
# mkdir and the append below. Recreate inline before the write so a
# wipe mid-run doesn't permanently strand the worker in crash-loop.
mkdir -p "$ATTEMPTS_DIR" 2>/dev/null || {
    seat_log "pi-issue-run: $inst FAILED to recreate $ATTEMPTS_DIR (wiped and unrecoverable) — exiting 1"
    exit 1
}

# Record this seat as tried BEFORE running, so a concurrent restart cannot
# pick the same one. Append "provider/model" per line.
printf '%s/%s\n' "$np" "$nm" >>"$tried_file"

# Last-seat marker for the reaper (pi-issue-failed-reap): it needs to know
# which seat the burst ended on so it can decide whether wiping tried-seats
# is safe. If the last failure was a mid-session death on a now-benched
# seat, the reap KEEPS the tried-seats list so the intake re-claim picks a
# different seat (fleet-ops#516). Written on every run; the reap reads it.
printf '%s/%s\n' "$np" "$nm" >"$ATTEMPTS_DIR/pi-issue-${inst}.seat" 2>/dev/null || true

# Register the seat so cap accounting reflects this worker. Cleared on exit.
register_active_seat "pi-issue-${inst}" "$np" "$nm"
trap 'clear_active_seat "pi-issue-${inst}"' EXIT INT TERM

seat_log "pi-issue-run: $inst running on $np/$nm (weight=$weight, tried: $(wc -l < "$tried_file") seat(s))"

# --- P14: mint a short-lived nishfleet-worker installation token ------------
# Creds absent → fall through to existing gh auth (human token stays until
# its own retirement PR). Creds present and mint fails → scream, do not
# impersonate the human account (fleet-ops#413).
WORKER_CREDS_FILE="${WORKER_APP_CREDS_FILE:-$HOME/.config/fleet-worker/nishfleet-worker.env}"
if [[ -f "$WORKER_CREDS_FILE" ]]; then
  WORKER_TOKEN_BIN="${WORKER_TOKEN_BIN:-$HOME/.local/bin/worker-token}"
  if [[ -x "$WORKER_TOKEN_BIN" ]]; then
    if worker_tok_out="$("$WORKER_TOKEN_BIN" --print 2>/tmp/pi-issue-run-worker-token.err)"; then
      # shellcheck disable=SC2162
      eval "$worker_tok_out"
      seat_log "pi-issue-run: $inst rotated to nishfleet-worker App token (${#GH_TOKEN}-char, ttl<=1h)"
      worker_tok_out=""
    else
      mint_rc=$?
      seat_log "pi-issue-run: $inst DEAD APP IDENTITY — worker-token mint failed (exit $mint_rc); refusing inherited gh auth"
      seat_log "pi-issue-run: $inst worker-token stderr: $(tr '\n' ' ' </tmp/pi-issue-run-worker-token.err 2>/dev/null)"
      rm -f /tmp/pi-issue-run-worker-token.err
      exit 1
    fi
  else
    seat_log "pi-issue-run: $inst DEAD APP IDENTITY — $WORKER_TOKEN_BIN not found; refusing inherited gh auth"
    exit 1
  fi
  rm -f /tmp/pi-issue-run-worker-token.err
else
  seat_log "pi-issue-run: $inst no nishfleet-worker creds file at $WORKER_CREDS_FILE; falling through to existing gh auth"
fi

# --- run pi, capture stdout/stderr -----------------------------------------
# pi reads the packet from stdin. We capture stdout to measure output size
# for no-op detection. stderr goes to the err file for the council packet.
# Time the run too — P13-B spawn-visibility needs to distinguish a spawn-
# phase ETIMEDOUT (< 120s) from a long-session transient.
#
# P15 hang watchdog: pi (any provider) intermittently never finalizes in
# --print mode — it does real tool work (verified: 4–11 tool calls in the
# session jsonl) then hangs in ep_poll instead of writing final output and
# exiting. The session log shows the last event is the assistant's text;
# the process never sends/gets a finish. The wrapper previously waited
# forever: the unit sat in `activating` until TimeoutStartSec=45min
# killed it, the seat registration stayed in the registry (liveness probe
# sees `activating` = live), caps stayed exhausted, and pick_seat refused
# to route anything else. Root fix: bound the pi run ourselves with a hard
# timeout SHORTER than the unit's TimeoutStartSec (45 min), so a wedged pi
# becomes a fast, loud, seat-cleaned failure and systemd re-seats on the
# next Restart immediately instead of starving the fleet for 45 minutes.
# timeout(1) sends SIGTERM at the limit and SIGKILL after --kill-after;
# the clear_active_seat trap on EXIT/TERM fires on the SIGTERM path.
#
# Also written to the err file so the seat-health spawn-fail detector can
# distinguish a hang (this marker) from a spawn ETIMEDOUT.
PI_HANG_TIMEOUT_S="${PI_HANG_TIMEOUT_S:-2520}"  # 42 min < unit TimeoutStartSec=45min
spawn_start_s=$(date -u +%s)
rc=0
pi_rc=0
if timeout --kill-after=30s "${PI_HANG_TIMEOUT_S}s" "$PI_BIN" --print --provider "$np" --model "$nm" < "$pkt" >"$out_file" 2>"$err_file"; then
    rc=0
    pi_rc=0
else
    pi_rc=$?
    rc=$pi_rc
    if (( pi_rc == 124 )); then
        # Buffer the tail before appending so we never read+write $err_file
        # in the same pipeline (SC2094).
        session_tail=$(tail -c 400 "$err_file" 2>/dev/null | tr '\n' ' ' | tail -c 300)
        {
            echo "pi-issue-run: PI HANG WATCHDOG — pi on $np/$nm did not finalize within ${PI_HANG_TIMEOUT_S}s ($(date -u +%FT%TZ)); killed. This is the P15 wedge fix — seat cleared, restarting on a new seat."
            echo "pi-issue-run: session tail: $session_tail"
        } >>"$err_file"
        seat_log "pi-issue-run: $inst PI HANG WATCHDOG on $np/$nm after ${PI_HANG_TIMEOUT_S}s — killed and re-seating"
    fi
fi
spawn_end_s=$(date -u +%s)
spawn_elapsed_s=$((spawn_end_s - spawn_start_s))

# --- P13-B spawn-fail marker (P13 visibility gap fix) ----------------------
# seat-health.ts writes its ledger ONLY via after_provider_response and
# cli_* — neither fires if pi dies at spawn (e.g. devin / cursor spawnSync
# ETIMEDOUT). Without this fix, pick_seat keeps routing work to a seat
# whose every spawn is timing out. We catch the trigger condition here,
# write the marker into the per-seat ledger, and continue with the normal
# non-zero exit so systemd restart picks a different seat. The marker
# sets usable_at = now + 5 min, so the OUTBOUND retry also skips it.
spawn_fail_triggered=0
if (( rc != 0 )) && (( spawn_elapsed_s < SPAWN_FAIL_MAX_S )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_spawn_etimeout "$out_for_scan" "$err_for_scan"; then
        spawn_fail_triggered=1
        # Make sure seat-log is loud even if the marker write itself fails.
        seat_log "pi-issue-run: $inst SPAWN-TIMEOUT on $np/$nm at ${spawn_elapsed_s}s (rc=$rc) — marking seat unusable for ${SPAWN_FAIL_BACKOFF_S}s"
        if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:rc=$rc"; then
            seat_log "pi-issue-run: $inst seat $np/$nm marked; next systemd Restart will pick a different seat via pick_seat (excluded by usable_at in the future)"
        else
            seat_log "pi-issue-run: $inst WARN: spawn-fail marker write FAILED for $np/$nm — relying on systemd Restart alone to dodge the dead seat"
        fi
    fi
fi

# --- fleet-ops#90: quota/cap wall bench ------------------------------------
# A hard-capped seat (ClinePass weekly cap, devin 15-min 429) is a walled
# seat, not a transient retry. Without this marker, pick_seat re-offers the
# same seat to the next systemd Restart, burning a StartLimitBurst attempt on
# a guaranteed failure. Detect a quota/cap wall in the captured output and
# bench the seat until its advertised reset window (or the provider default
# from seat-caps.json); seat_usable then skips it until bench_until and
# fail-opens after. Skipped when the spawn-fail path already handled this
# exit (a spawn ETIMEDOUT is not a quota wall). A walled seat is a lane
# fault, never charged to the work item.
if (( rc != 0 )) && (( ! spawn_fail_triggered )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_quota_cap_error "$out_for_scan" "$err_for_scan"; then
        seat_log "pi-issue-run: $inst QUOTA/CAP WALL on $np/$nm (rc=$rc) — benching seat for its reset window"
        if mark_seat_quota_bench "$np" "$nm" "$out_for_scan"$'\n'"$err_for_scan"; then
            seat_log "pi-issue-run: $inst seat $np/$nm benched; next systemd Restart will skip it via pick_seat (excluded by bench_until)"
        else
            seat_log "pi-issue-run: $inst WARN: quota-bench marker NOT written for $np/$nm (no window and no provider default) — relying on reactive ledger + systemd Restart"
        fi
    fi
fi

if (( rc != 0 )); then
    # Mid-session provider deaths that are NOT spawn-time and NOT a quota
    # wall still deserve a short bench. Without it, the tried-seats exclusion
    # is the ONLY thing keeping the next restart off the killing seat — and
    # the reaper (pi-issue-failed-reap) wipes tried-seats on every reap, so
    # the intake re-claim starts from an empty list and pick_seat re-selects
    # the same killing seat (0509-974 cursor-grok-4.6-high 143 x3, 2026-08-26).
    # Bench it exactly like the no-op path: mark_seat_spawn_fail writes a
    # transient_fault ledger with usable_at = now + SPAWN_FAIL_BACKOFF_S, which
    # survives the reap (the ledger is the DURABLE avoidance authority).
    if (( ! spawn_fail_triggered )) && ! is_quota_cap_error "$out_file" "$err_file" && is_mid_session_death "$err_file"; then
        seat_log "pi-issue-run: $inst mid-session provider death (rc=$rc) on $np/$nm after ${spawn_elapsed_s}s — benching seat ${SPAWN_FAIL_BACKOFF_S}s"
        if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:mid-session-death:rc=$rc"; then
            seat_log "pi-issue-run: $inst seat $np/$nm marked; next restart or intake re-claim will skip it via pick_seat"
        else
            seat_log "pi-issue-run: $inst WARN: mid-session bench marker write FAILED for $np/$nm"
        fi
    fi
    seat_log "pi-issue-run: $inst pi exited $rc on $np/$nm (${spawn_elapsed_s}s, spawn_fail=$spawn_fail_triggered) — systemd will restart with a new seat"
    exit 1
fi

# --- no-op detection: exit 0 with trivial output -> exit 1 ------------------
out_bytes=0
[[ -f "$out_file" ]] && out_bytes=$(wc -c < "$out_file" 2>/dev/null || echo 0)
out_bytes=${out_bytes//[^0-9]/}; out_bytes=${out_bytes:-0}

if (( out_bytes < OUT_MIN )); then
    seat_log "pi-issue-run: $inst pi exited 0 but stdout=${out_bytes}B (< ${OUT_MIN}B) — no-op, exiting 1 so systemd re-seats"
    # fleet-ops#390: a no-op is a flake on this packet, not proof the seat
    # is dead. Bench it briefly (SPAWN_FAIL_BACKOFF_S, default 5 min) so
    # pick_seat skips it on the next Restart AND on an intake re-spawn
    # that starts with an empty tried-seats file. Without this, the
    # healthy ledger re-selects the same seat and the unit loops until
    # StartLimitBurst exhausts (fleet-ops-378: 1 byte stdout, unit dead).
    if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:no-op:stdout=${out_bytes}B"; then
        seat_log "pi-issue-run: $inst seat $np/$nm marked; next systemd Restart will pick a different seat via pick_seat (excluded by usable_at in the future)"
    else
        seat_log "pi-issue-run: $inst WARN: spawn-fail marker write FAILED for $np/$nm — relying on systemd Restart alone to dodge the dead seat"
    fi
    exit 1
fi

seat_log "pi-issue-run: $inst SUCCESS on $np/$nm (${out_bytes}B output)"
# Reset the tried-seats file: this run succeeded, so a future re-trigger of
# the same issue (intake re-claim -> pi-issue-start -> systemctl start) starts
# with the full seat pool, not the stale list of seats that failed before the
# one that worked.
: >"$tried_file"
exit 0
