#!/usr/bin/env bash
# pi-issue-run — seat-rotation wrapper for pi-issue worker units (P4-A + P13-B).
#
# This is the ExecStart of pi-issue@.service. systemd handles the retry
# ladder natively (Restart=/RestartSec=/RestartSteps=/StartLimitBurst=),
# so this script does ONLY what systemd cannot:
#
#   1. Pick a DIFFERENT seat on each restart. systemd restarts the same
#      ExecStart, so seat rotation is real added value — see seat-lib.sh.
#      This is the gap the legacy intake path had (hardcoded
#      --provider devin --model glm-5-2 in the systemd-run ExecStart);
#      wiring this through is what point 4 of the P4-A packet required.
#   2. No-op detection: if pi exits 0 but produced no real output (< 20 B
#      to stdout), re-seat in-process via continue (fleet-ops#1378) AND
#      bench the seat via mark_seat_empty_run so pick_seat skips it on the
#      next intake re-spawn and reroutes to a healthy seat (fleet-ops#1298).
#      A provider no-op (pi ran, exited 0, produced < 20 B) is a SEAT
#      FAULT — same class as a verdict-based empty run (tools=0, no final
#      text, fleet-ops#902) — so both are benched via mark_seat_empty_run
#      before re-seating in-process. The bench is a FLAT cooldown
#      (mark_seat_empty_run, EMPTY_RUN_BACKOFF_S = 15 min) — a provider
#      no-op is NOT a wall, so the fleet-ops#1408 count ladder does NOT
#      apply (fleet-ops#2343: the old ladder churned healthy seats); only
#      the fleet-ops#1362 60-failure ceiling park (24h wall) lengthens it.
#      seat-health.ts resets the count on a healthy observation so a
#      recovered seat is re-tried after the flat cooldown. The in-process
#      retry loop avoids burning the item's StartLimitBurst dispatch budget
#      (only exits 1 after EMPTY_RUN_RETRY_MAX consecutive empty runs).
#      History: fleet-ops#1416 treated a provider no-op as a LANE fault
#      (no bench) on the theory that a single 0B stdout was a provider
#      hiccup on a healthy seat. fleet-ops#1298 reversed that: without a
#      bench, an intake re-spawn (fresh claim, empty tried-seats) re-picked
#      the same no-op'ing seat and burned 8 runs/2h on
#      straitly/deepseek-v4-pro. The flat cooldown breaks the loop
#      without walling a recovered seat (fail-open after usable_at) and
#      without over-punishing a healthy provider that no-ops occasionally
#      (fleet-ops#2343).
#      fleet-ops#1873 determination (window 2026-08-29T02:30-04:30Z: 14
#      empty runs vs 3 dispatches, ready_work=119, samples fleet-ops-1360/
#      -628/-1350/-1390 on straitly/deepseek-v4-pro, openrouter/deepseek-
#      v4-flash-0731, commandcode/poolside/laguna-s-2.1-free): same
#      provider-empty-run class as devin-empty-run-known-fault (vault
#      2026-08-27). Packet-render RULED OUT — all four sample issues have
#      well-formed bodies (331-885 B). Context-limit RULED OUT — the fault
#      is intermittent across four distinct seats, not deterministic per
#      seat/issue. The bench (#1416) + in-process re-seat (#1378) mechanism
#      covers this window; pinned by tests/pi-issue-run-noop-bench.test.sh.
#   3. Active-seat registration: writes the picked seat to the per-seat
#      state dir so seat-lib.sh's cap accounting reflects the running
#      worker. Cleared on exit via trap.
#   4. P13-B spawn-phase failure marker: if pi dies in < SPAWN_FAIL_MAX_S
#      (default 120s) AND the captured output contains an ETIMEDOUT pattern
#      paired with a spawn/socket/connect/child/handshake neighbour, write
#      a per-seat ledger entry via mark_seat_spawn_fail (seat-lib.sh).
#   4b. fleet-ops#90 quota/cap wall bench: if pi exits non-zero with a
#      quota/cap error carrying a reset window (ClinePass weekly cap,
#      "retry after", 429 with retry_after), write health_class=quota_bench
#      and bench_until so pick_seat skips the seat until then (or the
#      provider default in seat-caps.json). A walled seat is a lane fault,
#      never charged to the work item.
#   6. Defensive mkdir for $ATTEMPTS_DIR: fleet-ops#63 observed the dir
#      vanish between startup and the tried-seats append, stranding workers
#      in crash-loop on a benign filesystem-cleanup race. The startup
#      mkdir is no longer enough; recreate inline before the append so a
#      mid-run wipe cannot permanently strand this worker.
#   5. P14 worker credential split: the nishfleet-worker GitHub App is the
#      only production credential. If $WORKER_APP_CREDS_FILE exists
#      (default ~/.config/fleet-worker/nishfleet-worker.env), mint a fresh
#      installation token and export it for the child pi process. The App's
#      permissions are Contents/Pull requests/Issues write + Metadata read —
#      workers physically cannot push .github/workflows/** or touch protection.
#      If the creds file is absent, worker-token is missing, or mint fails,
#      the script SCREAMS (exit 1, DEAD APP IDENTITY) — a dead App must
#      not silently fall back to the human gh auth (fleet-ops#413 / #440).
#      The marker is byte-compatible with SeatLedgerEntry (seat-health.ts);
#      pick_seat honours it via the existing usable_at check. This is the
#      deterministic counterpart to seat-health.ts's response-time hooks:
#      no polling, no new timers, no new units — just an extra write on
#      the failure path that the worker was already going to take.
#
# What this script does NOT do (systemd handles it):
#   - Retry counting (StartLimitBurst=)
#   - Cooldown/backoff (RestartSec=/RestartSteps=)
#   - Hang detection (TimeoutStartSec=)
#   - Escalation on exhaustion (OnFailure= -> pi-issue-failed@%i.service)
#   - Preventing resurrection of a deliberately-stopped unit (systemd's
#     Restart= does not fire when the stop was a systemd operation)
#
# Args:
#   $1 = unit instance name (e.g. 0509-915), set by systemd %i
#
# Exit codes:
#   0 = pi ran and produced real output (success — systemd will not restart)
#   1 = pi failed OR empty-run in-process retries exhausted
#        -> systemd Restart=on-failure re-runs this script, which picks a
#           different seat. After StartLimitBurst, OnFailure= escalates.
#
# Never notifies Nish. No email, no chat. Only repairs or fails for escalation.

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HOME="${HOME:-/home/nish}"

# --- self-snapshot (P15-live-replace race) --------------------------------
# This script is ExecStart'ed by pi-issue@.service and is installed as a
# symlink into a git checkout (fleet-ops-deploy-clone). The deploy clone is
# fast-forwarded on every fleet-ops merge, and a git pull atomically replaces
# the file under the symlink. A bash process mid-execution of a replaced file
# splices old+new bytes and dies with a random 'command not found' (proven
# 2026-08-27: pi-issue@fleet-ops-458, exit 127, 'es: command not found').
# Snapshot our own path to a private copy so a mid-run replace cannot corrupt
# this execution; seat-lib is sourced from the same checkout and is covered by
# the same race, so copy it too when it lives in this repo. Tests override via
# PI_PACKET_SEAT_LIB / PI_ISSUE_RUN_SELF — never re-resolve a stale copy.
_SELF="$(readlink -f "${BASH_SOURCE[0]:-}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]:-}")"
if [[ -n "$_SELF" && -f "$_SELF" && -z "${PI_ISSUE_RUN_SELF:-}" ]]; then
    _TMP="${TMPDIR:-/tmp}"
    _SELF_COPY="$_TMP/pi-issue-run.self.$$.sh"
    if cp "$_SELF" "$_SELF_COPY" 2>/dev/null; then
        chmod 700 "$_SELF_COPY" 2>/dev/null || true
        export PI_ISSUE_RUN_SELF="$_SELF_COPY"
        trap 'rm -f "$_SELF_COPY"' EXIT INT TERM
        # Re-exec from the stable snapshot: this running bash is already
        # mid-execution of a possibly-stale inode, so the only safe point
        # to hand over is here at the top of the script.
        if [[ "${PI_ISSUE_RUN_REEXEC:-0}" != 1 ]]; then
            export PI_ISSUE_RUN_REEXEC=1
            exec bash "$_SELF_COPY" "$@"
        fi
    fi
fi

# Source shared seat logic. SEAT_LIB defaults to the install symlink; tests
# may override via PI_PACKET_SEAT_LIB. The directive points to the canonical
# source file in the repo (the install symlinks this same file), so static
# analysis can resolve the include.
SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
# shellcheck source=../lib/seat-lib.sh source-path=SCRIPTDIR
source "$SEAT_LIB"

# fleet-ops#3125: issue work is PRODUCT work — pick_seat orders candidates
# by the rolling PR-yield ledger when seat-caps product_order is "yield".
export PI_PICK_ROLE=product

OUT_MIN="${PI_PACKET_RUN_OUT_MIN:-20}"
# fleet-ops#1378: no-op in-process retry limit. A provider no-op (pi exits 0
# with < OUT_MIN stdout) and a verdict-based empty run (tools=0, no final
# text) are both SEAT FAULTS (fleet-ops#1298 reversed the #1416 lane-fault
# split for the provider no-op). Both are benched via mark_seat_empty_run
# (escalating backoff, fleet-ops#1408) and re-seated in-process up to
# EMPTY_RUN_RETRY_MAX times (default 2) before exiting 1 and letting
# systemd Restart= count it toward StartLimitBurst. This keeps empty runs
# from burning the item's dispatch budget.
EMPTY_RUN_RETRY_MAX="${EMPTY_RUN_RETRY_MAX:-2}"

# fleet-ops#2005: debug-playbook gate. A session with two or more real
# failed attempts and no four-heading vault playbook is blocked from closing.
#   FLEET_DEBUG_PLAYBOOK_GATE=0    disable (tests)
#   FLEET_DEBUG_PLAYBOOK_GATE=1    enforce, fail if gate/helper missing
#   unset / "auto"                 enforce only if helper is on PATH
#   FLEET_DEBUG_PLAYBOOK_BIN       override the gate binary location
#   FLEET_DEBUG_PLAYBOOK_SESSION_DIR override where pi writes the session file
DEBUG_PLAYBOOK_GATE="${FLEET_DEBUG_PLAYBOOK_GATE:-auto}"
DEBUG_PLAYBOOK_BIN="${FLEET_DEBUG_PLAYBOOK_BIN:-}"
DEBUG_PLAYBOOK_SESSION_DIR="${FLEET_DEBUG_PLAYBOOK_SESSION_DIR:-}"

# is_mid_session_death — true when the captured stderr shows the provider
# process was killed mid-session by a signal (SIGTERM=143, SIGKILL=137,
# OOM "Killed") rather than a quota wall or a spawn-phase ETIMEDOUT. The
# vendor CLIs self-terminate without a useful error; the marker line is the
# only signal. cursor-grok-4.6-high exits 143 on heavy ~14-minute packets
# (0509-974: 3/3 attempts 2026-08-26; pi-issue-run then re-reports rc=1 with
# "Cursor exited with code 143" in stderr). Not a quota wall (429) and not
# the spawn path (elapsed > SPAWN_FAIL_MAX_S), so it previously fell through
# UNBENCHED: the only protection against re-picking the killing seat was the
# tried-seats exclusion, and the reaper wipes tried-seats on every reap — so
# the intake re-claim started from an empty list and pick_seat re-selected
# the same killing seat (the summoning trip).
is_mid_session_death() {
    local err="${1:-}"
    [[ -f "$err" ]] || return 1
    grep -qiE 'exited with code 143|code 143|SIGTERM|terminated|Killed' "$err" 2>/dev/null
}

[[ $# -ge 1 ]] || { echo "pi-issue-run: need 1 arg: <unit-instance>" >&2; exit 1; }
inst="$1"
# PI_ISSUES_DIR lets tests redirect the packet/out/err triplet into a
# scratch dir. Default is the live install path; production is unchanged.
PI_ISSUES_DIR="${PI_ISSUES_DIR:-/home/nish/.local/state/pi-issues}"
pkt="$PI_ISSUES_DIR/${inst}.in"
out_file="$PI_ISSUES_DIR/${inst}.out"
err_file="$PI_ISSUES_DIR/${inst}.err"
tried_file="$ATTEMPTS_DIR/pi-issue-${inst}.tried-seats"

mkdir -p "$ATTEMPTS_DIR" "$(dirname "$out_file")"

[[ -f "$pkt" ]] || { echo "pi-issue-run: packet file not found: $pkt" >&2; exit 1; }

# fleet-ops#3277: pi-transport-check asserts EXTLOAD for subagent when a
# worker starts. Capability-detect: a pre-deploy probe has no --subagent
# and would treat the flag as a cli.js path. Scratch-HOME tests skip when
# the handshake file is absent (auto). Production HOME=/home/nish fails
# loud if the dest is missing.
assert_subagent_extload() {
    [[ "${PI_SUBAGENT_EXTLOAD_CHECK:-auto}" == "0" ]] && return 0
    local probe="${PI_TRANSPORT_CHECK:-/home/nish/.local/bin/pi-transport-check}"
    [[ -x "$probe" ]] || return 0
    grep -q -- '--subagent' "$probe" 2>/dev/null || return 0
    local idx="${PI_SUBAGENT_INDEX:-$HOME/.pi/agent/extensions/subagent/index.ts}"
    if [[ "${PI_SUBAGENT_EXTLOAD_CHECK:-auto}" == "auto" && ! -e "$idx" && "${HOME:-}" != "/home/nish" ]]; then
        return 0
    fi
    if ! "$probe" --subagent; then
        echo "pi-issue-run: SUBAGENT-EXTLOAD missing (pi-transport-check --subagent failed)" >&2
        return 1
    fi
    return 0
}
assert_subagent_extload || exit 1

# --- pick a seat for THIS attempt ------------------------------------------
weight=$(task_weight "$pkt")
difficulty="$weight"
if declare -F packet_difficulty >/dev/null 2>&1; then
    difficulty=$(packet_difficulty "$pkt")
fi
need_capable=0
[[ "$difficulty" == "heavy" || "$difficulty" == "keystone" ]] && need_capable=1

# fleet-ops#1383: capture the packet phases manifest so record_seat_selection
# in pick_seat can attribute the frontier-token share (#1211) to capable
# phases vs the commodity work phase. No-arg when the packet has none.
pi_phases=""
if declare -f packet_phases >/dev/null 2>&1; then
    pi_phases=$(packet_phases "$pkt" 2>/dev/null || true)
fi
export PI_PACKET_PHASES="${pi_phases:-none}"

# Free-tier privacy line (fleet-ops#520): a private-repo target never routes
# to a free-class lane. Derive the repo from the packet's TARGET line and
# resolve its visibility via config/repo-privacy.json (fail-closed: an
# unclassified repo is treated as private so it can never silently leak).
pkt_repo=$(packet_repo "$pkt")
pkt_privacy="public"
if [[ -n "$pkt_repo" ]]; then
    pkt_privacy=$(repo_privacy "$pkt_repo")
fi
seat_log "pi-issue-run: $inst target repo=${pkt_repo:-<none>} privacy=$pkt_privacy"

# fleet-ops#1378: empty-run in-process retry loop. The no-op guard below
# wraps the entire seat→run→check cycle in a while loop so empty runs
# re-seat and re-run INSIDE this invocation instead of consuming a systemd
# StartLimitBurst restart slot.
# Set the active-seat cleanup trap once for the whole invocation.
trap 'clear_active_seat "pi-issue-${inst}"' EXIT INT TERM

# fleet-ops#2005: isolate this unit's session files so the debug-playbook gate
# can find the one written by the final successful pi run.
if [[ -n "$DEBUG_PLAYBOOK_SESSION_DIR" ]]; then
    session_dir="$DEBUG_PLAYBOOK_SESSION_DIR"
else
    session_dir="${HOME}/.pi/agent/sessions/pi-issue-${inst}"
fi
mkdir -p "$session_dir"

empty_run_attempt=0

# fleet-ops#2462: reclaim-count initialization. The intake tick's first claim
# of this issue is the first strike; failed re-claims are counted by
# pi-issue-failed-reap (which increments the counter on each failure).
# Write count=1 if no file exists so the counter starts at the first claim,
# not the first failure. A successful run does NOT reset it here — the
# reset happens on PR open (fleet-merged-pr-close / the open-PR shortcut in
# failed-reap sees the PR and skips the reap entirely, so no increment).
_rc_init_file="$ATTEMPTS_DIR/pi-issue-${inst}.reclaim-count"
if [[ ! -f "$_rc_init_file" ]]; then
    printf '1' > "$_rc_init_file" 2>/dev/null || true
    seat_log "pi-issue-run: $inst initialized reclaim-count=1 (first claim)"
fi

while true; do

# First attempt: no exclusions. Subsequent attempts (after a restart) carry
# the previously-tried seats in $tried_file; pick_seat excludes them all.
seat=$(pick_seat "" "" "$need_capable" "$tried_file" "$difficulty" "$pkt_privacy" || true)
if [[ -z "$seat" ]]; then
    # The tried file does not exist on the first attempt; the `2>/dev/null`
    # on `tr` does not suppress a failed redirection, so test before reading.
    tried_list=""
    if [[ -f "$tried_file" ]]; then
        tried_list=$(tr '\n' ' ' < "$tried_file" 2>/dev/null || true)
    fi
    seat_log "pi-issue-run: $inst no seat available (tried: ${tried_list}) — exiting 1 so OnFailure escalates"
    # Recreate the attempts dir in case it was wiped between the startup mkdir
    # and this no-seat path (fleet-ops#63), then reset the tried-seats file.
    # Every allowlisted seat has now been tried and failed, so the within-burst
    # rotation list has done its job. The seat-health ledger (usable_at) is the
    # DURABLE avoidance authority — seats still in backoff stay gated there.
    # Clearing tried_file lets the next restart retry seats that have RECOVERED,
    # instead of looping forever on an exhausted list. Without this, a worker
    # that burned through every capable seat once can never pick a seat again:
    # every restart finds the same stale list and exits 1 in <1s (the
    # 2026-08-26 fleet-ops-32 stuck loop — all 4 heavy seats failed, then
    # 8+ restarts exited instantly with "no seat available").
    if ! mkdir -p "$ATTEMPTS_DIR" 2>/dev/null; then
        seat_log "pi-issue-run: $inst FAILED to recreate $ATTEMPTS_DIR (wiped and unrecoverable) — exiting 1"
        exit 1
    fi
    # fleet-ops#1133: a keystone two-strike must NOT reset tried-seats.
    # Clearing the list would let the next systemd Restart pick a cheap
    # free lane. Keep the strikes so pick_seat stays empty and OnFailure
    # summons the senior auditor.
    if [[ "$difficulty" == "keystone" ]]; then
        seat_log "pi-issue-run: $inst KEYSTONE ESCALATION — keeping tried-seats so OnFailure summons senior conference"
        exit 1
    fi
    : >"$tried_file"
    exit 1
fi

np=$(printf '%s' "$seat" | cut -f1)
nm=$(printf '%s' "$seat" | cut -f2)

# Defensive recreate: $ATTEMPTS_DIR was created at startup, but something
# (a concurrent worker, a tmpfiles.d rule, an external cleanup) has been
# wiping it from under running workers. fleet-ops#63. The error was
# "pi-issue-run: line 100: .../attempts/pi-issue-fleet-ops-34.tried-seats:
# No such file or directory" — the dir vanished between the startup
# mkdir and the append below. Recreate inline before the write so a
# wipe mid-run doesn't permanently strand the worker in crash-loop.
mkdir -p "$ATTEMPTS_DIR" 2>/dev/null || {
    seat_log "pi-issue-run: $inst FAILED to recreate $ATTEMPTS_DIR (wiped and unrecoverable) — exiting 1"
    exit 1
}

# Record this seat as tried BEFORE running, so a concurrent restart cannot
# pick the same one. Append "provider/model" per line.
printf '%s/%s\n' "$np" "$nm" >>"$tried_file"

# Last-seat marker for the reaper (pi-issue-failed-reap): it needs to know
# which seat the burst ended on so it can decide whether wiping tried-seats
# is safe. If the last failure was a mid-session death on a now-benched
# seat, the reap KEEPS the tried-seats list so the intake re-claim picks a
# different seat (fleet-ops#516). Written on every run; the reap reads it.
printf '%s/%s\n' "$np" "$nm" >"$ATTEMPTS_DIR/pi-issue-${inst}.seat" 2>/dev/null || true

# Register the seat so cap accounting reflects this worker. Cleared on exit.
# Clear any prior registration from a previous retry iteration first.
clear_active_seat "pi-issue-${inst}" 2>/dev/null || true
register_active_seat "pi-issue-${inst}" "$np" "$nm"

seat_log "pi-issue-run: $inst running on $np/$nm (weight=$difficulty, tried: $(wc -l < "$tried_file") seat(s))"

# --- P14: mint a short-lived nishfleet-worker installation token ------------
# The App creds file must exist. Creds present and mint fails → scream, do not
# impersonate the human account (fleet-ops#413 / #440).
# Token mint only on the first iteration; empty-run re-seats reuse the token.
WORKER_CREDS_FILE="${WORKER_APP_CREDS_FILE:-$HOME/.config/fleet-worker/nishfleet-worker.env}"
if [[ -f "$WORKER_CREDS_FILE" ]]; then
  WORKER_TOKEN_BIN="${WORKER_TOKEN_BIN:-$HOME/.local/bin/worker-token}"
  if [[ -x "$WORKER_TOKEN_BIN" ]]; then
    if (( empty_run_attempt == 0 )); then
      if worker_tok_out="$("$WORKER_TOKEN_BIN" --print 2>/tmp/pi-issue-run-worker-token.err)"; then
        # shellcheck disable=SC2162
        eval "$worker_tok_out"
        seat_log "pi-issue-run: $inst rotated to nishfleet-worker App token (${#GH_TOKEN}-char, ttl<=1h)"
        worker_tok_out=""
      else
        mint_rc=$?
        seat_log "pi-issue-run: $inst DEAD APP IDENTITY — worker-token mint failed (exit $mint_rc); refusing human-gh-auth fallback"
        seat_log "pi-issue-run: $inst worker-token stderr: $(tr '\n' ' ' </tmp/pi-issue-run-worker-token.err 2>/dev/null)"
        rm -f /tmp/pi-issue-run-worker-token.err
        exit 1
      fi
      rm -f /tmp/pi-issue-run-worker-token.err
    fi
  else
    seat_log "pi-issue-run: $inst DEAD APP IDENTITY — $WORKER_TOKEN_BIN not found; refusing human-gh-auth fallback"
    exit 1
  fi
else
  seat_log "pi-issue-run: $inst DEAD APP IDENTITY — no nishfleet-worker creds file at $WORKER_CREDS_FILE; refusing human-gh-auth fallback"
  exit 1
fi

# --- run pi, capture stdout/stderr -----------------------------------------
# pi reads the packet from stdin. We capture stdout to measure output size
# for no-op detection. stderr goes to the err file for the council packet.
# Time the run too — P13-B spawn-visibility needs to distinguish a spawn-
# phase ETIMEDOUT (< 120s) from a long-session transient.
#
# P15 hang watchdog: pi (any provider) intermittently never finalizes in
# --print mode — it does real tool work (verified: 4–11 tool calls in the
# session jsonl) then hangs in ep_poll instead of writing final output and
# exiting. The session log shows the last event is the assistant's text;
# the process never sends/gets a finish. The wrapper previously waited
# forever: the unit sat in `activating` until TimeoutStartSec=45min
# killed it, the seat registration stayed in the registry (liveness probe
# sees `activating` = live), caps stayed exhausted, and pick_seat refused
# to route anything else. Root fix: bound the pi run ourselves with a hard
# timeout SHORTER than the unit's TimeoutStartSec (45 min), so a wedged pi
# becomes a fast, loud, seat-cleaned failure and systemd re-seats on the
# next Restart immediately instead of starving the fleet for 45 minutes.
# timeout(1) sends SIGTERM at the limit and SIGKILL after --kill-after;
# the clear_active_seat trap on EXIT/TERM fires on the SIGTERM path.
#
# Also written to the err file so the seat-health spawn-fail detector can
# distinguish a hang (this marker) from a spawn ETIMEDOUT.
PI_HANG_TIMEOUT_S="${PI_HANG_TIMEOUT_S:-2520}"  # 42 min < unit TimeoutStartSec=45min
# fleet-ops#2133: minimum elapsed seconds before the long-hang-then-ETIMEDOUT
# and Ready-for-input stall detectors fire. A genuine long hang is >> 5 min;
# lowering it (e.g. PI_HANG_BENCH_MIN_S=1 in tests) does NOT change production
# because the default is 300. Env-overridable like PI_HANG_TIMEOUT_S so the
# detectors are testable without a 5-minute wall-clock wait.
PI_HANG_BENCH_MIN_S="${PI_HANG_BENCH_MIN_S:-300}"
spawn_start_s=$(date -u +%s)
rc=0
pi_rc=0
# fleet-ops#2005: pin this attempt's session file so the debug-playbook gate
# can evaluate the exact session that just closed.
session_id="${inst}-$(date -u +%s%N)"
if timeout --kill-after=30s "${PI_HANG_TIMEOUT_S}s" "$PI_BIN" --session-dir "$session_dir" --session-id "$session_id" --print --provider "$np" --model "$nm" < "$pkt" >"$out_file" 2>"$err_file"; then
    rc=0
    pi_rc=0
else
    pi_rc=$?
    rc=$pi_rc
    if (( pi_rc == 124 )); then
        # Buffer the tail before appending so we never read+write $err_file
        # in the same pipeline (SC2094).
        session_tail=$(tail -c 400 "$err_file" 2>/dev/null | tr '\n' ' ' | tail -c 300)
        {
            echo "pi-issue-run: PI HANG WATCHDOG — pi on $np/$nm did not finalize within ${PI_HANG_TIMEOUT_S}s ($(date -u +%FT%TZ)); killed. This is the P15 wedge fix — seat cleared, restarting on a new seat."
            echo "pi-issue-run: session tail: $session_tail"
        } >>"$err_file"
        seat_log "pi-issue-run: $inst PI HANG WATCHDOG on $np/$nm after ${PI_HANG_TIMEOUT_S}s — killed and re-seating"
    fi
fi
spawn_end_s=$(date -u +%s)
spawn_elapsed_s=$((spawn_end_s - spawn_start_s))

# --- P13-B spawn-fail marker (P13 visibility gap fix) ----------------------
# seat-health.ts writes its ledger ONLY via after_provider_response and
# cli_* — neither fires if pi dies at spawn (e.g. devin / cursor spawnSync
# ETIMEDOUT). Without this fix, pick_seat keeps routing work to a seat
# whose every spawn is timing out. We catch the trigger condition here,
# write the marker into the per-seat ledger, and continue with the normal
# non-zero exit so systemd restart picks a different seat. The marker
# sets usable_at = now + 5 min, so the OUTBOUND retry also skips it.
spawn_fail_triggered=0
if (( rc != 0 )) && (( spawn_elapsed_s < SPAWN_FAIL_MAX_S )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_spawn_etimeout "$out_for_scan" "$err_for_scan"; then
        spawn_fail_triggered=1
        # Make sure seat-log is loud even if the marker write itself fails.
        seat_log "pi-issue-run: $inst SPAWN-TIMEOUT on $np/$nm at ${spawn_elapsed_s}s (rc=$rc) — marking seat unusable for ${SPAWN_FAIL_BACKOFF_S}s"
        if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:rc=$rc"; then
            seat_log "pi-issue-run: $inst seat $np/$nm marked; next systemd Restart will pick a different seat via pick_seat (excluded by usable_at in the future)"
        else
            seat_log "pi-issue-run: $inst WARN: spawn-fail marker write FAILED for $np/$nm — relying on systemd Restart alone to dodge the dead seat"
        fi
    fi
fi

# --- fleet-ops#90: quota/cap wall bench ------------------------------------
# A hard-capped seat (ClinePass weekly cap, devin 15-min 429) is a walled
# seat, not a transient retry. Without this marker, pick_seat re-offers the
# same seat to the next systemd Restart, burning a StartLimitBurst attempt on
# a guaranteed failure. Detect a quota/cap wall in the captured output and
# bench the seat until its advertised reset window (or the provider default
# from seat-caps.json); seat_usable then skips it until bench_until and
# fail-opens after. Skipped when the spawn-fail path already handled this
# exit (a spawn ETIMEDOUT is not a quota wall). A walled seat is a lane
# fault, never charged to the work item.
if (( rc != 0 )) && (( ! spawn_fail_triggered )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_quota_cap_error "$out_for_scan" "$err_for_scan"; then
        seat_log "pi-issue-run: $inst QUOTA/CAP WALL on $np/$nm (rc=$rc) — benching seat for its reset window"
        if mark_seat_quota_bench "$np" "$nm" "$out_for_scan"$'\n'"$err_for_scan"; then
            seat_log "pi-issue-run: $inst seat $np/$nm benched; next systemd Restart will skip it via pick_seat (excluded by bench_until)"
        else
            seat_log "pi-issue-run: $inst WARN: quota-bench marker NOT written for $np/$nm (no window and no provider default) — relying on reactive ledger + systemd Restart"
        fi
    fi
fi

# --- fleet-ops#2133: devin long-hang-then-ETIMEDOUT bench ------------------
# devin/glm-5-2 intermittently hangs for ~30 min then exits with rc=1 and
# "spawnSync ETIMEDOUT" in stderr. This is NOT a spawn-phase failure
# (elapsed >> SPAWN_FAIL_MAX_S), NOT caught by the hang watchdog (exits
# before PI_HANG_TIMEOUT_S), and NOT a mid-session signal death. Without
# this detector, the seat stays pickable and burns every retry. Detect:
# elapsed > 300s (5 min) AND stderr contains the devin spawnSync ETIMEDOUT
# signature. Bench via mark_seat_hang_bench so the seat is skipped.
if (( rc != 0 )) && (( ! spawn_fail_triggered )) && (( spawn_elapsed_s > PI_HANG_BENCH_MIN_S )); then
    err_for_scan=""
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if grep -qiE 'spawnSync.*ETIMEDOUT|ETIMEDOUT.*spawnSync' "$err_file" 2>/dev/null; then
        seat_log "pi-issue-run: $inst DEVIN LONG HANG ETIMEDOUT on $np/$nm after ${spawn_elapsed_s}s (rc=$rc) — benching seat as hang-like failure"
        if mark_seat_hang_bench "$np" "$nm" "$err_for_scan"; then
            seat_log "pi-issue-run: $inst seat $np/$nm benched (hang_bench); next systemd Restart will skip it via pick_seat (excluded by bench_until)"
        else
            seat_log "pi-issue-run: $inst WARN: hang-bench marker NOT written for $np/$nm — relying on tried-seats exclusion"
        fi
    fi
fi

# --- fleet-ops#2133: Ready-for-input stall detector ------------------
# pi (any provider) can stall in a "Ready for input" loop where the
# provider repeatedly prompts but never advances. This emits many
# "Ready for input" lines to stderr without producing final output.
# Detect: elapsed > 300s (5 min) AND >5 occurrences, rc != 124 (hang
# watchdog kills are handled by mid-session-death). Bench via mark_seat_hang_bench.
if (( rc != 0 )) && (( rc != 124 )) && (( ! spawn_fail_triggered )) && (( spawn_elapsed_s > PI_HANG_BENCH_MIN_S )); then
    rfi_count=0
    [[ -f "$err_file" ]] && rfi_count=$(grep -o "Ready for input" "$err_file" 2>/dev/null | wc -l)
    if (( rfi_count > 5 )); then
        seat_log "pi-issue-run: $inst READY-FOR-INPUT STALL on $np/$nm after ${spawn_elapsed_s}s (rfi_count=$rfi_count, rc=$rc) — benching seat"
        if mark_seat_hang_bench "$np" "$nm" "$(cat "$err_file" 2>/dev/null)"; then
            seat_log "pi-issue-run: $inst seat $np/$nm benched (hang_bench rfi); next restart will skip"
        else
            seat_log "pi-issue-run: $inst WARN: hang-bench marker NOT written for $np/$nm"
        fi
    fi
fi

# --- fleet-ops #652 hot-patch: 503 / upstream-overload bench ---------------
# A seat returning 503 "Upstream model provider is temporarily unavailable" is
# NOT a quota wall (is_quota_cap_error does not match) and NOT a spawn-time
# ETIMEDOUT (is_spawn_etimeout does not match). Live failure mode observed in
# fleet-ops#652: commandcode/minimax-m3-free returned 35 of 200+ tool calls as
# 503 in the first 20 minutes of a worker run, destabilising the model for the
# rest of the session. Without this marker, pick_seat re-offers the same seat
# to the next systemd Restart and the next worker hits the same 503 storm.
# Bench the seat until the Retry-After (or the provider's 503_bench_default_s,
# default 600s = 10 min). Distinct health_class="overload_bench" /
# failure_mode="overload_503" so post-mortem tooling can tell overload benches
# from quota/cap benches. Skipped when a previous block already handled this
# exit (spawn-fail / quota-cap). Overload is a lane fault, never charged to
# the work item.
if (( rc != 0 )) && (( ! spawn_fail_triggered )); then
    out_for_scan=""
    err_for_scan=""
    [[ -f "$out_file" ]] && out_for_scan=$(cat "$out_file" 2>/dev/null || true)
    [[ -f "$err_file" ]] && err_for_scan=$(cat "$err_file" 2>/dev/null || true)
    if is_overload_error "$out_for_scan" "$err_for_scan"; then
        seat_log "pi-issue-run: $inst 503/OVERLOAD WALL on $np/$nm (rc=$rc) — benching seat for its backoff window"
        if mark_seat_overload_bench "$np" "$nm" "$out_for_scan"$'\n'"$err_for_scan"; then
            seat_log "pi-issue-run: $inst seat $np/$nm benched (overload_bench); next systemd Restart will skip it via pick_seat (excluded by bench_until)"
        else
            seat_log "pi-issue-run: $inst WARN: overload-bench marker NOT written for $np/$nm (no Retry-After and no provider default) — relying on reactive ledger + systemd Restart"
        fi
    fi
fi

if (( rc != 0 )); then
    # Mid-session provider deaths that are NOT spawn-time and NOT a quota
    # wall still deserve a short bench. Without it, the tried-seats exclusion
    # is the ONLY thing keeping the next restart off the killing seat — and
    # the reaper (pi-issue-failed-reap) wipes tried-seats on every reap, so
    # the intake re-claim starts from an empty list and pick_seat re-selects
    # the same killing seat (0509-974 cursor-grok-4.6-high 143 x3, 2026-08-26).
    # Bench it exactly like the no-op path: mark_seat_spawn_fail writes a
    # transient_fault ledger with usable_at = now + SPAWN_FAIL_BACKOFF_S, which
    # survives the reap (the ledger is the DURABLE avoidance authority).
    if (( ! spawn_fail_triggered )) && ! is_quota_cap_error "$out_file" "$err_file" && is_mid_session_death "$err_file"; then
        seat_log "pi-issue-run: $inst mid-session provider death (rc=$rc) on $np/$nm after ${spawn_elapsed_s}s — benching seat ${SPAWN_FAIL_BACKOFF_S}s"
        if mark_seat_spawn_fail "$np" "$nm" "pi-issue:$inst:mid-session-death:rc=$rc"; then
            seat_log "pi-issue-run: $inst seat $np/$nm marked; next restart or intake re-claim will skip it via pick_seat"
        else
            seat_log "pi-issue-run: $inst WARN: mid-session bench marker write FAILED for $np/$nm"
        fi
    fi
    seat_log "pi-issue-run: $inst pi exited $rc on $np/$nm (${spawn_elapsed_s}s, spawn_fail=$spawn_fail_triggered) — systemd will restart with a new seat"
    exit 1
fi

# --- no-op detection: exit 0 with trivial output -> exit 1 ------------------
out_bytes=0
[[ -f "$out_file" ]] && out_bytes=$(wc -c < "$out_file" 2>/dev/null || echo 0)
out_bytes=${out_bytes//[^0-9]/}; out_bytes=${out_bytes:-0}

# fleet-ops#902: a PACKET-VERDICT tools=0 run with no substantive output is
# an EMPTY RUN, not a success. The verdict line alone (~40B) exceeds OUT_MIN
# (20B), so byte-count cannot catch it — a devin lane that exits 0 with
# tools=0 and no final text was silently counted as success (#902). Detect:
# (1) the output's verdict says tools=0, AND (2) after stripping the
# EXTLOAD-OK handshake lines, the verdict line and blank lines, nothing real
# remains (no final text). A tools=0 run WITH real text is a legitimate
# text-only answer (e.g. "blocked: proposal posted") and stays a success.
is_empty_run() {
    local out="${1:-}"
    [[ -f "$out" ]] || return 1
    grep -qE 'PACKET-VERDICT[[:space:]]+tools=0' "$out" 2>/dev/null || return 1
    local rest
    rest=$(grep -vE '^(EXTLOAD-OK|PACKET-VERDICT)' "$out" 2>/dev/null || true)
    rest=$(grep -vE '^[[:space:]]*$' <<<"$rest" 2>/dev/null || true)
    [[ -z "$rest" ]]
}

if (( out_bytes < OUT_MIN )); then
    # fleet-ops#1298: a provider no-op (pi ran, exited 0, stdout < OUT_MIN)
    # is a SEAT FAULT, same class as the verdict tools=0 empty-run
    # (fleet-ops#902). Bench it via mark_seat_empty_run so pick_seat skips
    # it on the next intake re-spawn (fresh claim, empty tried-seats) and
    # reroutes to a healthy seat. The bench escalates by
    # consecutive_failure_count (fleet-ops#1408) so a repeat offender
    # stays benched longer each cycle, and seat-health.ts resets the count
    # on a healthy observation so a recovered seat is re-tried at the base
    # backoff (fail-open after usable_at). The tried-seats file still
    # records this seat for THIS unit so the next in-process iteration
    # picks a different seat immediately.
    # fleet-ops#1378: re-seat in-process (continue) instead of exit 1 so
    # provider no-ops don't burn the item's StartLimitBurst dispatch budget.
    # History: fleet-ops#1416 made this a lane fault (no bench) on the
    # theory a single 0B stdout was a provider hiccup on a healthy seat;
    # without the bench an intake re-spawn re-picked the same no-op'ing
    # seat and burned 8 runs/2h on straitly/deepseek-v4-pro (#1298).
    # fleet-ops#2343: flat 900s no-op cooldown (mark_seat_empty_run), not
    # the escalating #1408 ladder — a provider no-op is not a wall.
    seat_log "pi-issue-run: $inst pi exited 0 but stdout=${out_bytes}B (< ${OUT_MIN}B) — provider no-op, benching seat (empty_run, flat cooldown) and re-seating in-process"
    if mark_seat_empty_run "$np" "$nm" "pi-issue:$inst:provider-no-op:stdout=${out_bytes}B"; then
        seat_log "pi-issue-run: $inst seat $np/$nm marked (empty_run); will skip on next in-process re-seat and on intake re-spawn"
    else
        seat_log "pi-issue-run: $inst WARN: mark_seat_empty_run marker write FAILED for $np/$nm — relying on tried-seats exclusion for next re-seat"
    fi
    empty_run_attempt=$((empty_run_attempt + 1))
    if (( empty_run_attempt > EMPTY_RUN_RETRY_MAX )); then
        seat_log "pi-issue-run: $inst in-process retries exhausted (${empty_run_attempt} attempts, limit=${EMPTY_RUN_RETRY_MAX}) — exiting 1 so systemd Restart fires"
        exit 1
    fi
    seat_log "pi-issue-run: $inst empty run #${empty_run_attempt}/${EMPTY_RUN_RETRY_MAX} (provider no-op, stdout=${out_bytes}B) — re-seating in-process on a different seat"
    continue
fi
if is_empty_run "$out_file"; then
    noop_reason="empty-run:tools=0 verdict with no final text (stdout=${out_bytes}B)"
    # fleet-ops#902: an empty-run (verdict tools=0, no final text) is a SEAT
    # FAULT; bench it via mark_seat_empty_run (15 min, empty_run mode) before
    # re-seating in-process. fleet-ops#1378: the in-process continue still
    # avoids consuming a systemd StartLimitBurst slot for the first empty run.
    if mark_seat_empty_run "$np" "$nm" "pi-issue:$inst:no-op:${noop_reason}"; then
        seat_log "pi-issue-run: $inst seat $np/$nm marked (empty_run); will skip on next in-process re-seat"
    else
        seat_log "pi-issue-run: $inst WARN: mark_seat_empty_run marker write FAILED for $np/$nm — relying on tried-seats exclusion for next re-seat"
    fi
    empty_run_attempt=$((empty_run_attempt + 1))
    if (( empty_run_attempt > EMPTY_RUN_RETRY_MAX )); then
        seat_log "pi-issue-run: $inst in-process retries exhausted (${empty_run_attempt} attempts, limit=${EMPTY_RUN_RETRY_MAX}) — exiting 1 so systemd Restart fires"
        exit 1
    fi
    seat_log "pi-issue-run: $inst empty run #${empty_run_attempt}/${EMPTY_RUN_RETRY_MAX} (empty-run, ${noop_reason}) — re-seating in-process on a different seat"
    continue
fi

# Success: the no-op check above did not continue, so this seat produced real
# output. break out of the retry loop to the success path (fleet-ops#1378).
break
done  # fleet-ops#1378 empty-run retry while loop

# --- success path (reached via break above) ---
seat_log "pi-issue-run: $inst SUCCESS on $np/$nm (${out_bytes}B output)"

# fleet-ops#2005: session-close gate. A multi-attempt debug without a
# four-heading vault playbook is not allowed to close successfully.
if [[ "$DEBUG_PLAYBOOK_GATE" != "0" ]]; then
    gate_bin="$DEBUG_PLAYBOOK_BIN"
    if [[ -z "$gate_bin" ]]; then
        gate_bin=$(command -v fleet-debug-playbook 2>/dev/null || true)
    fi
    if [[ -n "$gate_bin" ]]; then
        session_file=$(find "$session_dir" -maxdepth 1 -name '*.jsonl' -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
        if [[ -n "$session_file" ]]; then
            set +e
            "$gate_bin" gate "$session_file"
            gate_rc=$?
            set -e
            if [[ "$gate_rc" -ne 0 ]]; then
                seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-BLOCK $session_file (rc=$gate_rc) — a multi-attempt debug closed without a vault playbook note"
                exit 1
            fi
            seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-OK $session_file"
        else
            if [[ "$DEBUG_PLAYBOOK_GATE" == "1" ]]; then
                seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-BROKEN no session file found in $session_dir (gate enforced)"
                exit 1
            fi
            seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-SKIP no session file found in $session_dir (gate=auto)"
        fi
    else
        if [[ "$DEBUG_PLAYBOOK_GATE" == "1" ]]; then
            seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-BROKEN fleet-debug-playbook not found (gate enforced)"
            exit 1
        fi
        seat_log "pi-issue-run: $inst DEBUG-PLAYBOOK-GATE-SKIP fleet-debug-playbook not on PATH (gate=auto)"
    fi
fi

# Reset the tried-seats file: this run succeeded, so a future re-trigger of
# the same issue (intake re-claim -> pi-issue-start -> systemctl start) starts
# with the full seat pool, not the stale list of seats that failed before the
# one that worked.
: >"$tried_file"

# fleet-ops#2462 + #2772: reclaim-count reset on success — PR-gated. A
# run that produced non-empty output but opened NO PR (the model asserted
# success without shipping) is not a resolved issue: resetting the counter
# there let a seat-storm claim loop defeat the MAX_RECLAIMS cap (fleet-ops#2772:
# line=2672 claimed 11x in 12h; two no-PR "success" runs wiped the count
# each time, so the cap never fired). Reset only when the work actually
# shipped: an open PR from this claim branch, or the issue is already
# closed (re-entrancy: an earlier run's PR merged). On API failure, fail
# CLOSED (do not reset) — a stale tall count only escalates a completed
# issue, which is harmless (a closed issue is not re-claimed).
issue_num="${inst##*-}"
_shipped=no
_cl_open_pr=$(gh api "repos/Nishfleet/${pkt_repo}/pulls?state=open&head=${pkt_repo}:claim/issue-${issue_num}&per_page=1" 2>/dev/null || true)
if printf '%s' "$_cl_open_pr" | jq -e 'length > 0' >/dev/null 2>&1; then
    _shipped=yes
else
    _cl_issue_state=$(gh api "repos/Nishfleet/${pkt_repo}/issues/${issue_num}" --jq '.state // "open"' 2>/dev/null || true)
    [[ "$_cl_issue_state" == "closed" ]] && _shipped=yes
fi
if [[ "$_shipped" == "yes" ]]; then
    rm -f "$ATTEMPTS_DIR/pi-issue-${inst}.reclaim-count" 2>/dev/null || true
    rm -f "$ATTEMPTS_DIR/pi-issue-${inst}.systemic" 2>/dev/null || true
    seat_log "pi-issue-run: $inst SUCCESS reset reclaim-count + systemic marker (shipped: PR open or issue closed)"
else
    seat_log "pi-issue-run: $inst SUCCESS but no open PR from claim/issue-${issue_num} and issue ${_cl_issue_state:-unknown} — reclaim-count NOT reset (claim-loop cap stays tall)"
fi

exit 0
