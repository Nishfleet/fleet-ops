#!/usr/bin/env bash
# prove-one-run-check — reject 'armed' without 'ran' (fleet-ops#378).
#
# Standing rule (Nish, 2026-08-18): "Switched on and proven, or it is not
# done." Any PR that adds a new systemd unit, timer, path unit, or GitHub
# workflow must carry proof of one real end-to-end run in the PR body.
#
# Usage:
#   prove-one-run-check --body FILE --name-status FILE
#   git diff --name-status origin/main...HEAD | prove-one-run-check --body FILE --name-status -
#
# Exit 0: no new machinery, or proof present.
# Exit 1: new unit/timer/workflow and no proof (the drill reject).
# Exit 2: usage error.
#
# Proof markers (any one is enough):
#   1. A line matching ^run-proof:\s+\S+
#   2. A Verification: section (heading or inline) carrying a run-cue:
#      journalctl, systemctl, https?://, exit N, rc=N, a fenced code block,
#      ALL PHASES PASSED, a `$ ` prompt line, or `ok: N`.
#
# The GitHub required-check workflow is a follow-up (nishfleet-worker has
# no Workflows permission). This binary is the gate; tests are the drill.

set -euo pipefail

usage() {
    printf 'usage: prove-one-run-check --body FILE --name-status FILE|-\n' >&2
    exit 2
}

body_file=""
name_status_file=""
while [ $# -gt 0 ]; do
    case "$1" in
        --body)
            [ $# -ge 2 ] || usage
            body_file="$2"
            shift 2
            ;;
        --name-status)
            [ $# -ge 2 ] || usage
            name_status_file="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            usage
            ;;
    esac
done

# shellcheck disable=SC2015  # A && B || C IS the guard pattern here, not "if-then-else" — both clauses are checks that should route to usage().
if [ -z "$body_file" ] || [ -z "$name_status_file" ]; then
    usage
fi
[ -f "$body_file" ] || { printf 'prove-one-run-check: body file not found: %s\n' "$body_file" >&2; exit 2; }

# --- new machinery? --------------------------------------------------------
# git diff --name-status: A\tpath, M\tpath, R100\told\tnew, C100\told\tnew.
# Note: shell `*` matches across `/` in case statements, so a single
# `systemd/*.service` arm already covers any depth (systemd/foo.service,
# systemd/sub/foo.service). Two separate arms for depth would shadow
# each other (SC2221/SC2222) — keep one.
is_machinery_path() {
    local path="$1"
    case "$path" in
        *.d/*) return 1 ;;
        systemd/*.service|systemd/*.timer|systemd/*.path|systemd/*.socket) return 0 ;;
        .github/workflows/*.yml|.github/workflows/*.yaml) return 0 ;;
        template/.github/workflows/*.yml|template/.github/workflows/*.yaml) return 0 ;;
        *) return 1 ;;
    esac
}

new_machinery=""
while IFS=$'\t' read -r col1 col2 col3 || [ -n "${col1:-}" ]; do
    [ -n "${col1:-}" ] || continue
    local_status="${col1:0:1}"
    path=""
    case "$local_status" in
        A) path="$col2" ;;
        C|R) path="${col3:-$col2}" ;;
        *) continue ;;
    esac
    [ -n "$path" ] || continue
    if is_machinery_path "$path"; then
        new_machinery="${new_machinery:+$new_machinery }$path"
    fi
done < <(if [ "$name_status_file" = "-" ]; then cat; else cat "$name_status_file"; fi)

if [ -z "$new_machinery" ]; then
    printf 'SKIP: no new unit/timer/workflow in the diff\n'
    exit 0
fi

# --- proof? ----------------------------------------------------------------
body="$(cat "$body_file")"

if printf '%s\n' "$body" | grep -qE '^[[:space:]]*run-proof:[[:space:]]*\S+'; then
    printf 'OK: run-proof: marker present (new machinery: %s)\n' "$new_machinery"
    exit 0
fi

set +e
printf '%s\n' "$body" | awk '
    BEGIN { in_v=0; matched=0 }
    {
        if ($0 ~ /(^|[[:space:]])[Vv]erification:[[:space:]]*/) {
            in_v=1
        }
        if (!in_v) next
        if ($0 ~ /(^|[^[:alnum:]_])journalctl([^[:alnum:]_]|$)/ \
            || $0 ~ /(^|[^[:alnum:]_])systemctl([^[:alnum:]_]|$)/ \
            || $0 ~ /https?:\/\// \
            || $0 ~ /exit[[:space:]]+[0-9]/ || $0 ~ /rc=[0-9]/ \
            || $0 ~ /```/ \
            || $0 ~ /ALL PHASES PASSED/ \
            || $0 ~ /^[[:space:]]*\$ / \
            || $0 ~ /ok: [0-9]/ ) {
            matched=1
        }
    }
    END { exit (matched ? 0 : 1) }
'
awk_rc=$?
set -e

if [ "$awk_rc" -eq 0 ]; then
    printf 'OK: Verification: section carries a run-cue (new machinery: %s)\n' "$new_machinery"
    exit 0
fi

printf 'REJECT: new unit/timer/workflow (%s) with no run-proof. Add a run-proof: line (journal excerpt, run URL, or systemctl/journalctl transcript) or a Verification: section that carries a real run cue. Armed without ran is not done.\n' "$new_machinery" >&2
exit 1
