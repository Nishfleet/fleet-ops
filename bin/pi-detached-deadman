#!/usr/bin/env bash
# pi-detached-deadman — ExecStopPost verdict hook for pi-systemd-run units
# (fleet-ops#4266). A detached job that ENDS is not automatically fine: a
# stop with no Requester logged kills work nobody notices, and a job whose
# deliverable never appeared is a failure even at exit 0. This hook turns
# "the unit ended" into one of three verdicts:
#
#   success  -> dead-man success ping (healthchecks.io), textfile series
#               cleared (the run kept its promise)
#   died     -> /fail ping + Prometheus textfile gauge 1 so DetachedJobDied
#               alert -> repair packet + a dispatch-ledger verdict row +
#               EXIT NONZERO. The nonzero ExecStopPost exit marks the unit
#               `failed` even when the main process exited 0 (proven live on
#               systemd 255, fleet-ops#5456 probe-80) — so the OnFailure ->
#               unit-escalation@%n -> STOP-REASON -> dispatcher rail now
#               carries clean-stop deaths too, and the dispatcher resumes
#               or dispatches the packet.
#   nothing  -> hook was never armed (no PI_DEADMAN_DISPATCH) — legacy or
#               non-pi-systemd-run callers pass through untouched
#
# The verdict read is SYSTEMD's own ExecStopPost environment: SERVICE_RESULT
# (success|exit-code|signal|oom-kill|timeout|watchdog|...), EXIT_CODE,
# EXIT_STATUS. The deliverable is the run's promise: when --deliverable was
# given at launch, the hook checks the file at stop time regardless of the
# exit status — "even at exit 0, a stop becomes a failure".
#
# The "who stopped it" answer runs through the audit trail (ausearch -k
# fleet-unit-stop) when auditd is installed; the line is echo'd to stderr so
# it lands in the unit's journal (and therefore in the STOP-REASON detail
# captured by unit-escalation-write). No auditd = the line says so; the
# auditd install is shipped by install.sh --system + the bare-metal manifest.
#
# Exit contract (fleet-ops#5456): exits 1 when the verdict is `died` so a
# clean-stop-without-deliverable still lands the unit in `failed` and fires
# OnFailure — the missing deliverable is a FAILURE contract, not a log line.
# Exits 0 on success / not-armed / cli-noop / --clear / --help.
#
# Env (set by pi-systemd-run; inherited seams for tests):
#   PI_DEADMAN_DISPATCH       run id (uuid). Empty = not armed -> no-op.
#   PI_DEADMAN_UNIT           unit name (e.g. pi-job-<ts>-<pid>)
#   PI_DEADMAN_CMDLINE        recorded command line (relaunch source)
#   PI_DEADMAN_DEADLINE       --deadline minutes (grace proxy, recorded)
#   PI_DEADMAN_DELIVERABLE    --deliverable absolute path (optional)
#   PI_DEADMAN_DROPIN_DIR     per-unit no-resume drop-in dir to remove at
#                             stop (pi-systemd-run writes it at launch)
#   SERVICE_RESULT, EXIT_CODE, EXIT_STATUS   (systemd ExecStopPost)
#   KEYSTONE_HC_ENV, PI_DEADMAN_URL_BASE     ping seams (keystone-hc-ping)
#   PI_DEADMAN_TEXTFILE       node_exporter textfile (default
#                             /var/lib/prometheus/node-exporter/fleet-detached.prom)
#   PI_DEADMAN_WHOSTOPPED_BIN fleet-who-stopped path (default: sibling)
#   PI_DEADMAN_DRYRUN         1 = print the verdict, write nothing (tests)

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
whostopped_bin="${PI_DEADMAN_WHOSTOPPED_BIN:-$here/fleet-who-stopped}"
# fleet-ops#5456 rebase: #5786's clean-stop escalation hook (below) uses this
# seam; the definition is restored here (main carries it at its own defaults
# block) — without it the #5786 reason never reaches STOP-REASON (unbound
# variable under set -u) and the #5786 test's esc_log stays empty.
#   PI_DEADMAN_ESCALATION_BIN unit-escalation-write path (default: sibling)
escalation_bin="${PI_DEADMAN_ESCALATION_BIN:-$here/unit-escalation-write}"
textfile="${PI_DEADMAN_TEXTFILE:-/var/lib/prometheus/node-exporter/fleet-detached.prom}"

log() { printf '[%s] [pi-detached-deadman] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# --- node_exporter textfile gauge -------------------------------------------
# fleet_detached_job_died{unit,dispatch,cmdline,deliverable,deadline} 1
# Only DEATH series live in the file: value 1 = died without its deliverable
# (alert source); a value-0 write is a clear of a stale series (success path
# or repair-worker acknowledgment). Atomic read-modify-write under flock so
# concurrent launches/stops cannot clobber each other's series.
_textfile_set() {
    local want="$1"
    [[ -n "${PI_DEADMAN_TEXTFILE_SKIP:-}" ]] && return 0
    # Test-pollution guard (fleet-ops#4777): a DEATH write (want=1) must only
    # land for a real pi-systemd-run dispatch, which is always a UUID. A
    # non-UUID dispatch (placeholder like "x", "test", or a bare unit name)
    # is a phantom that can never be relapsed or cleared by a real unit, so it
    # would fire DetachedJobDied forever and pollute every repair packet. The
    # --clear path (dispatch="") and the success-clear path (want=0) are
    # unaffected: they only ever remove series, never create one.
    if [[ "$want" == "1" && -n "${PI_DEADMAN_DISPATCH:-}" ]]; then
        if ! [[ "${PI_DEADMAN_DISPATCH}" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
            log "refusing death write: dispatch=${PI_DEADMAN_DISPATCH} is not UUID-shaped (unit=${PI_DEADMAN_UNIT:-}) — phantom series would fire DetachedJobDied forever"
            return 0
        fi
    fi
    local label_cmdline="${PI_DEADMAN_CMDLINE:-}"
    label_cmdline="${label_cmdline:0:400}"
    PI_DEADMAN_TEXTFILE="$textfile" PI_DEADMAN_UNIT="$unit" \
        PI_DEADMAN_DISPATCH="$dispatch" PI_DEADMAN_DEADLINE="${PI_DEADMAN_DEADLINE:-}" \
        PI_DEADMAN_DELIVERABLE="$deliverable" PI_DEADMAN_METRIC_WANT="$want" \
        PI_DEADMAN_CMDLINE="$label_cmdline" python3 - <<'PY'
import fcntl, os, tempfile
path = os.environ["PI_DEADMAN_TEXTFILE"]
keys = ["unit", "dispatch"]
labels = {
    "unit": os.environ.get("PI_DEADMAN_UNIT", ""),
    "dispatch": os.environ.get("PI_DEADMAN_DISPATCH", ""),
    "cmdline": os.environ.get("PI_DEADMAN_CMDLINE", ""),
    "deliverable": "1" if os.environ.get("PI_DEADMAN_DELIVERABLE") else "0",
    "deadline": os.environ.get("PI_DEADMAN_DEADLINE", ""),
}
want = os.environ.get("PI_DEADMAN_METRIC_WANT", "0")

def esc(v: str) -> str:
    return v.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")

def matches(l: dict) -> bool:
    if want == "0":
        # Clear semantics: drop the WHOLE unit's series regardless of
        # dispatch. --clear <unit> runs with dispatch="" (repair worker
        # only knows the unit name), and a success verdict must clear any
        # stale series for that unit, so matching on unit alone.
        return l.get("unit") == labels.get("unit")
    return all(l.get(k) == labels.get(k) for k in keys)

block = 'fleet_detached_job_died{%s} %s' % (
    ",".join(f'{k}="{esc(labels[k])}"' for k in labels),
    "1" if want == "1" else "0",
)

os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
lock = path + ".lock"
with open(lock, "w") as lk:
    fcntl.flock(lk, fcntl.LOCK_EX)
    lines = []
    try:
        with open(path) as f:
            lines = f.read().splitlines()
    except OSError:
        pass
    kept, changed = [], False
    for ln in lines:
        # This family's HELP/TYPE pair is rewritten on every save, so a copy
        # surviving from the previous content must be dropped. Keeping it made
        # each write add another pair: the live textfile reached 27 HELP lines
        # and node_exporter rejected the whole file ("second HELP line for
        # metric name"), so DetachedJobDied could never fire. Other families'
        # comments are kept untouched (fleet-ops#4266).
        if ln.startswith("# HELP fleet_detached_job_died") or ln.startswith(
            "# TYPE fleet_detached_job_died"
        ):
            continue
        if not ln.startswith("fleet_detached_job_died{"):
            kept.append(ln)
            continue
        try:
            payload = ln[ln.index("{") + 1:ln.rindex("}")]
            l = {}
            for part in payload.split(","):
                k, _, v = part.partition("=")
                l[k.strip()] = v.strip().strip('"').replace('\\"', '"').replace("\\\\", "\\")
        except Exception:
            continue
        if matches(l):
            changed = True
            if want == "1":
                kept.append(block)
            continue
        kept.append(ln)
    if want == "1" and not changed:
        kept.append(block)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".fleet-detached-")
    with os.fdopen(fd, "w") as f:
        f.write("# HELP fleet_detached_job_died 1 when a pi-systemd-run unit ended without its deliverable (fleet-ops#4266).\n")
        f.write("# TYPE fleet_detached_job_died gauge\n")
        for ln in kept:
            f.write(ln + "\n")
    # mkstemp creates 0600, and os.replace keeps that mode: node_exporter runs
    # as User=prometheus, so a 0600 textfile is unreadable to it — it sets
    # node_textfile_scrape_error=1 and the series never reaches Prometheus,
    # which silently disarms DetachedJobDied. Every sibling textfile in the
    # directory is 0644; match them (fleet-ops#4266).
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
PY
}

dispatch="${PI_DEADMAN_DISPATCH:-}"
unit="${PI_DEADMAN_UNIT:-}"
deliverable="${PI_DEADMAN_DELIVERABLE:-}"

# Repair-worker acknowledgment mode: clear the died series for a unit by
# name (the alert fired; the worker relaunched; the dead-man is disarmed so
# DetachedJobDied resolves instead of re-firing every 6h).
if [[ "${1:-}" == "--clear" ]]; then
    clear_unit="${2:-}"
    [[ -n "$clear_unit" ]] || { echo "usage: pi-detached-deadman --clear <unit>" >&2; exit 2; }
    unit="$clear_unit"
    dispatch=""
    if [[ "${PI_DEADMAN_DRYRUN:-0}" == "1" ]]; then
        echo "clear: $clear_unit"
        exit 0
    fi
    _textfile_set 0
    exit 0
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "usage: pi-detached-deadman [--clear <unit>]" >&2
    echo "  ExecStopPost verdict hook. CLI use is --clear only." >&2
    exit 0
fi

[[ -z "$dispatch" ]] && exit 0          # not armed: pass through untouched

# systemd ExecStopPost always sets SERVICE_RESULT. An empty SERVICE_RESULT
# with inherited PI_DEADMAN_* means a live unit's child ran this binary by
# hand (live 2026-09-09: repair workers ran `pi-detached-deadman --help` /
# bare invocation and tripped DetachedJobDied on themselves, cascading more
# repair units). CLI diagnostic is not a death.
if [[ -z "${SERVICE_RESULT:-}" ]]; then
    log "cli-noop: SERVICE_RESULT unset (not ExecStopPost); inherited dispatch=${dispatch} unit=${unit} — not a death"
    exit 0
fi

service_result="${SERVICE_RESULT:-}"

# Verdict: died = the unit's Result was not success, OR the promised
# deliverable is missing at stop time (exit 0 included), OR the run claimed
# LIVE/DEPLOYED/live-on-host without citing a merged origin/main SHA
# (fleet-ops#5786 — the packet-verdict checker owns the claim grammar).
# Missing OR EMPTY: a zero-byte deliverable is a run that wrote nothing
# (fleet-ops#5456).
died=0
verdict=""
if [[ "$service_result" != "success" ]]; then
    died=1
    verdict="died:${service_result}"
fi
if [[ -n "$deliverable" && ! -s "$deliverable" ]]; then
    died=1
    verdict="no-deliverable"
fi

# --- false LIVE-claim gate (fleet-ops#5786) ----------------------------------
# A deliverable — the promised file OR the run's own printed output — may not
# claim LIVE/DEPLOYED/live-on-host unless the same line cites a SHA already
# on origin/main of a known clone. The 2026-09-12 incident was an
# alert-repair worker reporting "Live on this host" for a change still on a
# branch while its PR sat open with auto-merge off. Rejection means the stop
# becomes a death: DetachedJobDied fires and a repair packet lands.
verdict_lib="${PI_DEADMAN_VERDICT_LIB:-$here/../lib/pi-packet-verdict.py}"
# Installed layout puts lib/ files under ~/.local/lib/pi-packet/.
if [[ ! -f "$verdict_lib" ]]; then
    verdict_lib="$here/../lib/pi-packet/pi-packet-verdict.py"
fi
journalctl_bin="${PI_DEADMAN_JOURNALCTL:-journalctl}"
false_live_claim=0
claim_scan="$(mktemp 2>/dev/null || true)"
if [[ -f "$verdict_lib" && -n "$claim_scan" ]]; then
    {
        if [[ -n "$deliverable" && -f "$deliverable" ]]; then
            cat -- "$deliverable" 2>/dev/null || true
        fi
        "$journalctl_bin" --user -u "$unit" -o cat --no-pager 2>/dev/null \
            | tail -n 2000 || true
    } >"$claim_scan"
    if [[ -s "$claim_scan" ]]; then
        repo_args=()
        if [[ -n "${PI_DEADMAN_WORKDIR:-}" ]]; then
            repo_args+=(--repo-dir "$PI_DEADMAN_WORKDIR")
        fi
        if ! python3 "$verdict_lib" --live-claims "$claim_scan" \
                ${repo_args[@]+"${repo_args[@]}"} >/dev/null 2>&1; then
            false_live_claim=1
            died=1
            log "LOUD DEPLOY-CLAIM-FALSE unit=$unit — deliverable/journal claims LIVE/DEPLOYED without a merged origin/main SHA on the same line (fleet-ops#5786)"
        fi
    fi
elif [[ ! -f "$verdict_lib" ]]; then
    log "WARN: packet-verdict checker missing at $verdict_lib — LIVE-claim gate skipped (fleet-ops#5786)"
fi
[[ -n "$claim_scan" ]] && rm -f "$claim_scan"

# --- who stopped it (audit trail, best-effort) ------------------------------
stopper_line=""
if [[ "$died" == "1" && -x "$whostopped_bin" ]]; then
    stopper_line="$("$whostopped_bin" "$unit" 2>/dev/null | tail -n 1 || true)"
fi
[[ -z "$stopper_line" ]] && stopper_line="who-stopped: no audit trail (auditd not installed?) — install.sh --system ships /etc/audit/rules.d/30-fleet-unit-stop.rules"

if [[ "${PI_DEADMAN_DRYRUN:-0}" == "1" ]]; then
    if [[ "$died" == "1" ]]; then
        echo "verdict=died unit=$unit result=$service_result deliverable=$deliverable verdict_kind=$verdict"
        echo "$stopper_line"
    else
        echo "verdict=success unit=$unit result=$service_result"
    fi
    exit 0
fi

if [[ "$died" == "1" ]]; then
    # /fail ping: instant DOWN beats waiting out the grace period.
    "$here/keystone-hc-ping" detached fail || true
    # fleet-ops#5456: closing ledger row for this dispatch. The unit's own
    # ledger entry stays the launch record; this row is the verdict — the
    # dispatcher reads it when deciding hop+1 relaunch vs terminal dispatch.
    # status=failed (not terminal-complete) because the work is unfinished;
    # the dispatcher's relaunch carries the chain forward.
    LEDGER="${FLEET_DISPATCH_LEDGER:-${AGENT_STATE:-/home/nish/workspaces/agent-state}/dispatch-ledger.jsonl}"
    python3 - "$LEDGER" "$dispatch" "$unit" "$verdict" <<'PY' || log "WARN: ledger verdict append failed"
import json, sys
row = {"id": sys.argv[2], "unit": sys.argv[3],
       "ts": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
       "status": "failed", "verdict": sys.argv[4]}
with open(sys.argv[1], "a") as f:
    f.write(json.dumps(row, separators=(",", ":")) + "\n")
PY
    # Clean-stop deaths are invisible to OnFailure (Result=success) — this
    # hook is their only writer. Unit failures are already written by the
    # OnFailure -> unit-escalation@%n rail; reusing the SAME writer with a
    # distinct reason keeps one STOP-REASON per trip and one auditor.
    # (fleet-ops#5786: a deliverable that claims LIVE without a merged
    # origin/main SHA is the unit-false-live-claim reason — same writer.)
    echo "$stopper_line" >&2   # lands in the unit journal -> STOP-REASON detail
    if [[ "$service_result" == "success" ]]; then
        esc_reason="unit-stopped-without-deliverable"
        [[ "$false_live_claim" == "1" ]] && esc_reason="unit-false-live-claim"
        UNIT_ESCALATION_REASON="$esc_reason" \
        UNIT_ESCALATION_SOURCE="pi-detached-deadman" \
            "$escalation_bin" "$unit" >/dev/null 2>&1 || true
    fi
    _textfile_set 1
    log "died: unit=$unit result=$service_result deliverable=${deliverable:-unset} verdict=$verdict — dead-man tripped"
else
    # The run kept its promise: success ping (same run id), and the died
    # series (if any stale one exists) is cleared.
    "$here/keystone-hc-ping" detached success || true
    _textfile_set 0
fi

# Remove the per-unit no-resume drop-in pi-systemd-run wrote at launch —
# the unit is done; the dir is runtime state, not config to keep.
if [[ -n "${PI_DEADMAN_DROPIN_DIR:-}" && -d "${PI_DEADMAN_DROPIN_DIR}" ]]; then
    rm -rf "${PI_DEADMAN_DROPIN_DIR}" 2>/dev/null \
        || log "WARN: could not remove drop-in dir $PI_DEADMAN_DROPIN_DIR"
fi

# fleet-ops#5456: died => nonzero so the unit's final state is `failed`
# (Result records the stop-post failure) and OnFailure fires — that is the
# rail that lands every death in the dispatcher. A clean stop that exits 0
# here would die silently.
[[ "$died" == "1" ]] && exit 1
exit 0