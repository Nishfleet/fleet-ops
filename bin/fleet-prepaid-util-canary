#!/usr/bin/env bash
# fleet-prepaid-util-canary — prepaid-seat max utilization (fleet-ops#531).
#
# Standing rule `sr-prepaid-max-util` (global-standing-rules.md, Nish
# 2026-08-20): prepaid subs run at max utilization. Unused allowance at
# week/month rollover is money burned. Idle sub lanes are a fault. The
# named incident is SuperGrok expiry-waste: a prepaid seat sat unused
# until the window rolled over, then a sibling prepaid (Cursor) burned.
#
# No new scheduler; run by fleet-heartbeat-tier1. Two layers, mirroring
# fleet-free-roster-canary (fleet-ops#518) and entitled-wired-canary
# (fleet-ops#387):
#
#   1. GATE (fail-loud, exit 1) — the class prevention:
#      Ladder completeness: every prepaid-quota (subscription is an alias)
#      provider with cap>0 and a non-empty .models map must appear in
#      prepaid_providers_in_order. A prepaid seat missing from the order
#      is withheld from pick_seat's expiry-first prepaid bucket — that is
#      how a wired sub expires unused. LOUD + auto-file + exit 1.
#
#   2. DETECTOR (observe-to-open, tick stays green, exit 0):
#      Expiry-waste: last HORIZON hours of the ISO week, cap>0 prepaid
#      with 0 picks this week on the local prepaid-usage counter, ready
#      work > 0, and the seat is not quota-benched. Auto-files (deduped,
#      capped). A benched seat (quota wall) is not waste; a quiet week
#      with no ready work is not withholding.
#
#   3. Always emit one PREPAID-UTIL heartbeat line per cap>0 prepaid
#      provider (the seat-utilization line the rule asked for).
#
# Picks come from PI_PACKET_STATE/prepaid-usage/<provider>.json (the
# ISO-week counter pick_seat already writes). That is an estimate, not
# the provider's real meter — the same counter seat-lib uses to pace
# weekly_budget. Live workers are counted from the active-seats registry.
# Ready work is open agent-ready + agent-in-progress across enrolled
# intake repos (same definition as fleet-heartbeat-undersaturation).
#
# Existing options that lost (research-before-build, fleet-ops#517):
#   - subusage / quota-mcp: poll provider quota APIs. New dependency, extra
#     scheduler, no seat-caps / pick_seat / GitHub auto-file wiring.
#   - fleet-heartbeat-undersaturation: whole-fleet idle. SuperGrok unused
#     while Cursor workers ran still looks green.
#   - entitled-wired-canary: inventory vs caps. Wiring is not utilization.
#   - seat-lib _prepaid_paced: skips a seat at 80% weekly_budget. That
#     withholds prepaid near expiry, the opposite of this rule.
#   - fleet-seat-live-validate: SuperGrok credential liveness only. Dead
#     auth is one cause of unused prepaid; this canary watches utilization
#     across every prepaid seat, including wired live ones that still sit
#     idle near week end.
# Adopted: a heartbeat canary in the entitled-wired / free-roster shape.
#
# Exit codes:
#   0  gate clean (detectors may have filed; filing never fails the tick)
#   1  a gate violation, or seat-caps missing/unparseable
#
# Environment seams (tests):
#   SEAT_CAPS_JSON                 cap map
#   FLEET_ENTITLED_SEATS_JSON      inventory (presence guard only)
#   FLEET_INTAKE_REPOS_JSON        enrolled repos for ready-work count
#   FLEET_HEARTBEAT_TRIAGE         triage file
#   PI_PACKET_STATE                prepaid-usage + active-seats root
#   PI_SEAT_HEALTH_LEDGER_DIR      quota_bench ledgers
#   FLEET_PREPAID_UTIL_NOW         ISO-8601 UTC now (default: live clock)
#   FLEET_PREPAID_UTIL_WORK        override ready-work count
#   FLEET_PREPAID_UTIL_HORIZON_H   hours-before-week-end (default 24)
#   FLEET_PREPAID_UTIL_REPO        default Nishfleet/fleet-ops
#   FLEET_PREPAID_UTIL_FILE        1 (default) file issues; 0 skip gh
#   FLEET_PREPAID_UTIL_CAP         per-tick file cap (default 5)
#   GH                             gh binary (tests stub this)
#   FLEET_ISSUE_FILE               filing helper (fleet-ops#1212)

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
command -v gh >/dev/null 2>&1 || export PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin

GH="${GH:-gh}"
ISSUE_FILE="${FLEET_ISSUE_FILE:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/fleet-issue-file}"

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)
FLEET_OPS_REPO="${FLEET_OPS_REPO:-$_canon_repo}"

ENTITLED_JSON="${FLEET_ENTITLED_SEATS_JSON:-$FLEET_OPS_REPO/config/entitled-seats.json}"
if [[ ! -f "$ENTITLED_JSON" ]]; then
    ENTITLED_JSON="${HOME}/.local/state/pi-packet/entitled-seats.json"
fi
SEAT_CAPS_JSON="${SEAT_CAPS_JSON:-$FLEET_OPS_REPO/config/seat-caps.json}"
if [[ ! -f "$SEAT_CAPS_JSON" ]]; then
    SEAT_CAPS_JSON="${HOME}/.local/state/pi-packet/seat-caps.json"
fi
INTAKE_JSON="${FLEET_INTAKE_REPOS_JSON:-$FLEET_OPS_REPO/config/intake-repos.json}"
if [[ ! -f "$INTAKE_JSON" ]]; then
    INTAKE_JSON="${HOME}/.local/state/pi-packet/intake-repos.json"
fi

TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"
REPO="${FLEET_PREPAID_UTIL_REPO:-Nishfleet/fleet-ops}"
FILE_ISSUES="${FLEET_PREPAID_UTIL_FILE:-1}"
FILE_CAP="${FLEET_PREPAID_UTIL_CAP:-5}"
HORIZON_H="${FLEET_PREPAID_UTIL_HORIZON_H:-24}"
NOW="${FLEET_PREPAID_UTIL_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
STATE_DIR="${PI_PACKET_STATE:-$HOME/.local/state/pi-packet}"
LEDGER_DIR="${PI_SEAT_HEALTH_LEDGER_DIR:-/home/nish/workspaces/agent-state/lanes/seats}"
ACTIVE_SEATS_DIR="$STATE_DIR/active-seats"

# --- Cursor $400 'API Usage' pool measured spend reader (fleet-ops#4206) ---
# Cursor's DashboardService.GetCurrentPeriodUsage returns the on-demand
# spend-limit pool (spendLimitUsage) in cents — the $400 'API Usage' budget
# Nish wants spent on cursor-grok-4.6-high senior/keystone work before the
# billing cycle resets. The reader is the meter check that proves
# included_exhausted and feeds fleet_prepaid_spend_usd{provider=cursor} so
# the FleetCursorPrepaidBurnPacingLow rule can pace it. No new unit: this
# runs inside the existing canary tick and writes a node_exporter textfile
# (same pattern as fleet-queue-product-ratio.prom from heartbeat-tier1).
CURSOR_AUTH_JSON="${CURSOR_AUTH_JSON:-$HOME/.config/cursor/auth.json}"
CURSOR_USAGE_ENDPOINT="${CURSOR_USAGE_ENDPOINT:-https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage}"
CURSOR_USAGE_URL="${CURSOR_USAGE_URL:-}"  # test fixture: file:// or path to a JSON response
PREPAID_SPEND_DIR="${FLEET_PREPAID_SPEND_DIR:-$STATE_DIR/prepaid-spend}"
PREPAID_PROM_PATH="${FLEET_PREPAID_PROM_PATH:-/var/lib/prometheus/node-exporter/prepaid-spend.prom}"
ETIMEDOUT_HORIZON_H="${FLEET_PREPAID_ETIMEDOUT_HORIZON_H:-24}"
CURL="${CURL:-curl}"

# --- OpenCode Go subscription usage reader (fleet-ops#5022) ---
# OpenCode Go is a $10/mo prepaid subscription whose limits are 5-hour (20%
# of the monthly allowance), weekly (50%) and monthly (100%) percentages. The
# fleet could not see any of them: prepaid-usage/opencode-go.json carried a
# session count only, usd_today 0, so weekly_budget pacing was a no-op and the
# weekly pool reached 80.1% with 3.3 days left while the cap sat at 10 — a
# human read the console. The subscription's own endpoint
# GET https://opencode.ai/zen/go/v1/usage (same key Pi already sends to
# /zen/go/v1, so no console session token and no new credential) answers
# {"usage":{"rolling":{"percent":N,"resetsAt":ISO},...}}. This reader is the
# meter that closes that blind spot; fleet_seat_quota_* is untouched (that
# family belongs to fleet-metrics-export.py / fleet.prom), so this writes its
# own prepaid-usage.prom next to the cursor spend textfile.
OPENCODE_GO_AUTH_JSON="${OPENCODE_GO_AUTH_JSON:-$HOME/.local/share/opencode/auth.json}"
OPENCODE_GO_ENV_FILE="${OPENCODE_GO_ENV_FILE:-/home/nish/fleet2/etc/opencode-go.env}"
OPENCODE_GO_USAGE_ENDPOINT="${OPENCODE_GO_USAGE_ENDPOINT:-https://opencode.ai/zen/go/v1/usage}"
OPENCODE_GO_USAGE_URL="${OPENCODE_GO_USAGE_URL:-}"  # test fixture: path or URL
PREPAID_USAGE_PROM_PATH="${FLEET_PREPAID_USAGE_PROM_PATH:-/var/lib/prometheus/node-exporter/prepaid-usage.prom}"
# Cap per unit of burn rate. Measured 2026-09-10: 80% of the weekly pool over
# ~4 days is ~0.8%/h while the fleet cap was 10, so one cap unit buys
# 0.8/10 = 0.08%/h and K = 10 / 0.8 = 12.5 cap-units per (%/h). The paced cap
# is floor(remaining_weekly_pct / hours_to_reset * K): how much concurrency
# spends exactly the remaining pool by the reset.
OPENCODE_GO_PACE_K="${OPENCODE_GO_PACE_K:-12.5}"
# 5h window at/above this used-percent counts as walled (issue: >= 95%).
OPENCODE_GO_ROLLING_WALL_PCT="${OPENCODE_GO_ROLLING_WALL_PCT:-95}"

# fleet-ops#4621: shared 24h API-bucket figure so usd_today is the vendor
# number, not the token-derived 0.000000. Source from the repo next to this
# script (readlink -f), not FLEET_OPS_REPO (tests point that at a scratch dir).
# shellcheck disable=SC1091
if [[ -f "$_canon_repo/lib/cursor-api-bucket.sh" ]]; then
    source "$_canon_repo/lib/cursor-api-bucket.sh"
fi

log() {
    printf '[%s] [fleet-prepaid-util-canary] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

norm_class() {
    case "$1" in
        subscription) printf '%s\n' prepaid-quota ;;
        prepaid-quota|metered|free) printf '%s\n' "$1" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

file_finding() {
    local id="$1" kind="$2" title="$3" body="$4"
    local marker="prepaid-util-canary: ${id} ${kind}"
    if [[ "$FILE_ISSUES" != "1" ]]; then
        log "file skipped (FLEET_PREPAID_UTIL_FILE=$FILE_ISSUES) marker=$marker"
        return 0
    fi
    local existing
    existing=$("$GH" issue list -R "$REPO" --state open --limit 50 \
        --json number,body 2>/dev/null \
        | jq -r --arg m "$marker" '.[] | select(.body | contains($m)) | .number' \
        | head -n 1 || true)
    if [[ -n "$existing" ]]; then
        log "dedup: open $REPO#$existing already carries $marker"
        return 0
    fi
    local full
    full="${body}

${marker}
"
    if "$ISSUE_FILE" file -R "$REPO" --title "$title" --body "$full" >/dev/null 2>&1; then
        log "filed: $title"
    else
        log "WARN: fleet-issue-file failed for $marker"
    fi
}

iso_week() {
    date -u -d "$NOW" +%G-W%V
}

# Hours remaining until next Monday 00:00 UTC (ISO week boundary).
hours_left_in_iso_week() {
    local dow hour min sec sod remaining
    dow=$(date -u -d "$NOW" +%u)
    hour=$(date -u -d "$NOW" +%H)
    min=$(date -u -d "$NOW" +%M)
    sec=$(date -u -d "$NOW" +%S)
    sod=$((10#$hour * 3600 + 10#$min * 60 + 10#$sec))
    remaining=$(( (8 - 10#$dow) * 86400 - sod ))
    if (( remaining < 0 )); then
        remaining=0
    fi
    echo $(( remaining / 3600 ))
}

prepaid_picks() {
    local p="$1" f week stored count
    week=$(iso_week)
    f="$STATE_DIR/prepaid-usage/${p}.json"
    [[ -f "$f" ]] || { echo 0; return; }
    stored=$(jq -r '.week // ""' "$f" 2>/dev/null || true)
    [[ "$stored" == "$week" ]] || { echo 0; return; }
    count=$(jq -r '.count // 0' "$f" 2>/dev/null || echo 0)
    [[ "$count" =~ ^[0-9]+$ ]] || count=0
    echo "$count"
}

prepaid_live() {
    local p="$1" n=0 f
    [[ -d "$ACTIVE_SEATS_DIR" ]] || { echo 0; return; }
    shopt -s nullglob
    for f in "$ACTIVE_SEATS_DIR"/*.json; do
        [[ -f "$f" ]] || continue
        if [[ "$(jq -r '.provider // ""' "$f" 2>/dev/null || true)" == "$p" ]]; then
            n=$((n + 1))
        fi
    done
    shopt -u nullglob
    echo "$n"
}

# True if any ledger row for this provider is quota_benched into the future.
provider_benched() {
    local p="$1" f hc bu now_s bu_s
    local ps="${p//[^A-Za-z0-9._-]/_}"
    [[ -d "$LEDGER_DIR" ]] || return 1
    now_s=$(date -u -d "$NOW" +%s 2>/dev/null || echo 0)
    shopt -s nullglob
    for f in "$LEDGER_DIR/${ps}__"*.json; do
        [[ -f "$f" ]] || continue
        hc=$(jq -r '.health_class // ""' "$f" 2>/dev/null || true)
        [[ "$hc" == "quota_bench" ]] || continue
        bu=$(jq -r '.bench_until // ""' "$f" 2>/dev/null || true)
        [[ -n "$bu" ]] || continue
        bu_s=$(date -u -d "$bu" +%s 2>/dev/null || echo 0)
        if [[ "$bu_s" =~ ^[0-9]+$ ]] && (( bu_s > now_s )); then
            shopt -u nullglob
            return 0
        fi
    done
    shopt -u nullglob
    return 1
}

# --- Cursor $400 pool measured spend (fleet-ops#4206, amended #4566) ------
# Reads the on-demand spend-limit pool from Cursor's DashboardService. The
# accessToken is read from ~/.config/cursor/auth.json (where cursor-agent
# stores it) and sent ONLY to api2.cursor.sh over HTTPS — never logged.
# fleet-ops#4566: the live probe showed spendLimitUsage carries NO limits
# (Nish keeps the on-demand overage at 0), so spend_usd/pool_usd parse to 0
# forever. The real expiring $400 is the Ultra INCLUDED API bucket:
# planUsage.apiPercentUsed x planUsage.limit (dashboard "API usage: N% used").
# Parse it and emit api_bucket_* so the number is traceable to Cursor.
# included_exhausted is computed from totalPercentUsed >= 100 — the old
# includedSpend >= limit compare misfired (planUsage.includedSpend equals the
# limit on a bonus-exhausted account while apiPercentUsed is still low).
# Returns a tab-separated row on stdout:
#   spend_usd<TAB>pool_usd<TAB>cycle_end_s<TAB>included_exhausted<TAB>updated_s<TAB>api_used_usd<TAB>api_remaining_usd<TAB>api_limit_usd<TAB>total_pct
# or empty on any failure (no metric emitted; the absent() rule fires).
cursor_measured_spend() {
    local token resp cycle_end_ms spend_limit spend_remaining
    local api_pct api_limit_cents api_used_usd api_remaining_usd api_limit_usd total_pct
    local spend_usd pool_usd cycle_end_s inc_ex
    # Test seam: a fixture file/URL replaces the live API call.
    if [[ -n "$CURSOR_USAGE_URL" ]]; then
        if [[ -f "$CURSOR_USAGE_URL" ]]; then
            resp=$(cat "$CURSOR_USAGE_URL" 2>/dev/null || true)
        else
            resp=$("$CURL" -s -m 15 "$CURSOR_USAGE_URL" 2>/dev/null || true)
        fi
    else
        [[ -f "$CURSOR_AUTH_JSON" ]] || { echo ""; return; }
        token=$(jq -r '.accessToken // empty' "$CURSOR_AUTH_JSON" 2>/dev/null || true)
        [[ -n "$token" ]] || { echo ""; return; }
        resp=$("$CURL" -s -m 15 -X POST \
            -H "Authorization: Bearer $token" \
            -H "Content-Type: application/json" \
            -d '{}' "$CURSOR_USAGE_ENDPOINT" 2>/dev/null || true)
    fi
    [[ -n "$resp" ]] || { echo ""; return; }
    if ! echo "$resp" | jq -e '.spendLimitUsage' >/dev/null 2>&1; then
        echo ""; return
    fi
    cycle_end_ms=$(echo "$resp" | jq -r '.billingCycleEnd // 0' 2>/dev/null || echo 0)
    spend_limit=$(echo "$resp" | jq -r '.spendLimitUsage.individualLimit // .spendLimitUsage.pooledLimit // 0' 2>/dev/null || echo 0)
    spend_remaining=$(echo "$resp" | jq -r '.spendLimitUsage.individualRemaining // .spendLimitUsage.pooledRemaining // 0' 2>/dev/null || echo 0)
    api_pct=$(echo "$resp" | jq -r '.planUsage.apiPercentUsed // 0' 2>/dev/null || echo 0)
    api_limit_cents=$(echo "$resp" | jq -r '.planUsage.limit // 0' 2>/dev/null || echo 0)
    total_pct=$(echo "$resp" | jq -r '.planUsage.totalPercentUsed // 0' 2>/dev/null || echo 0)
    [[ "$cycle_end_ms" =~ ^[0-9]+$ ]] || cycle_end_ms=0
    [[ "$spend_limit" =~ ^[0-9]+$ ]] || spend_limit=0
    [[ "$spend_remaining" =~ ^[0-9]+$ ]] || spend_remaining=0
    [[ "$api_pct" =~ ^[0-9]+(\.[0-9]+)?$ ]] || api_pct=0
    [[ "$api_limit_cents" =~ ^[0-9]+$ ]] || api_limit_cents=0
    [[ "$total_pct" =~ ^[0-9]+(\.[0-9]+)?$ ]] || total_pct=0
    # cents -> USD. spend = pool limit - remaining (the on-demand pool used;
    # both are 0 while the on-demand overage limit stays 0 — fleet-ops#4566).
    pool_usd=$(awk -v l="$spend_limit" 'BEGIN{printf "%.6f", l/100}')
    spend_usd=$(awk -v l="$spend_limit" -v r="$spend_remaining" 'BEGIN{printf "%.6f", (l-r)/100}')
    # Included API bucket: apiPercentUsed x limit (both from planUsage).
    api_limit_usd=$(awk -v l="$api_limit_cents" 'BEGIN{printf "%.6f", l/100}')
    api_used_usd=$(awk -v p="$api_pct" -v l="$api_limit_usd" 'BEGIN{printf "%.6f", p/100*l}')
    api_remaining_usd=$(awk -v u="$api_used_usd" -v l="$api_limit_usd" 'BEGIN{printf "%.6f", (l>u)?l-u:0}')
    cycle_end_s=$(( cycle_end_ms / 1000 ))
    # Included plan exhausted = the whole included+bonus allowance spent out
    # (totalPercentUsed >= 100), not the old includedSpend>=limit misparse.
    if awk -v t="$total_pct" 'BEGIN{exit !(t+0 >= 100)}'; then
        inc_ex=1
    else
        inc_ex=0
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$spend_usd" "$pool_usd" "$cycle_end_s" "$inc_ex" "$(date -u +%s)" \
        "$api_used_usd" "$api_remaining_usd" "$api_limit_usd" "$total_pct"
}

# Write the prepaid-spend state file + node_exporter textfile for cursor.
# State file: $PREPAID_SPEND_DIR/cursor.json (consumed by the judge + this
# canary's heartbeat). Textfile: $PREPAID_PROM_PATH (node_exporter reads ALL
# .prom in the dir; this file owns ONLY fleet_prepaid_* — no shadowing of
# fleet.prom, which does not emit these families).
emit_cursor_prepaid_spend() {
    local row spend_usd pool_usd cycle_end_s inc_ex updated_s api_used_usd api_remaining_usd api_limit_usd total_pct
    row=$(cursor_measured_spend) || row=""
    [[ -n "$row" ]] || { log "cursor spend reader: no data (auth missing or API unreachable) — metric omitted, absent() rule will fire"; return; }
    IFS=$'\t' read -r spend_usd pool_usd cycle_end_s inc_ex updated_s api_used_usd api_remaining_usd api_limit_usd total_pct <<<"$row"
    mkdir -p "$PREPAID_SPEND_DIR" 2>/dev/null || true
    local state="$PREPAID_SPEND_DIR/cursor.json"
    cat >"$state" 2>/dev/null <<JSON || log "WARN: could not write cursor spend state $state"
{
  "provider": "cursor",
  "spend_usd": $spend_usd,
  "pool_usd": $pool_usd,
  "cycle_end_s": $cycle_end_s,
  "included_exhausted": $inc_ex,
  "api_bucket_used_usd": $api_used_usd,
  "api_bucket_remaining_usd": $api_remaining_usd,
  "api_bucket_limit_usd": $api_limit_usd,
  "total_percent_used": $total_pct,
  "updated_s": $updated_s,
  "observed_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "source": "cursor-dashboard-getcurrentperiodusage"
}
JSON
    # node_exporter textfile (atomic write; 0644 so node_exporter uid can read).
    local tmp="${PREPAID_PROM_PATH}.$$"
    {
        printf '# HELP fleet_prepaid_spend_usd On-demand (spend-limit) pool spend in USD for prepaid providers, from the vendor dashboard API (fleet-ops#4206).\n'
        printf '# TYPE fleet_prepaid_spend_usd gauge\n'
        printf 'fleet_prepaid_spend_usd{provider="cursor"} %s\n' "$spend_usd"
        printf '# HELP fleet_prepaid_pool_usd On-demand (spend-limit) pool limit in USD for prepaid providers (fleet-ops#4206).\n'
        printf '# TYPE fleet_prepaid_pool_usd gauge\n'
        printf 'fleet_prepaid_pool_usd{provider="cursor"} %s\n' "$pool_usd"
        printf '# HELP fleet_prepaid_cycle_end_timestamp Unix seconds at which the prepaid billing cycle resets (fleet-ops#4206).\n'
        printf '# TYPE fleet_prepaid_cycle_end_timestamp gauge\n'
        printf 'fleet_prepaid_cycle_end_timestamp{provider="cursor"} %s\n' "$cycle_end_s"
        printf '# HELP fleet_prepaid_spend_updated_timestamp Unix seconds at which the spend reader last succeeded (fleet-ops#4206).\n'
        printf '# TYPE fleet_prepaid_spend_updated_timestamp gauge\n'
        printf 'fleet_prepaid_spend_updated_timestamp{provider="cursor"} %s\n' "$updated_s"
        printf '# HELP fleet_prepaid_included_exhausted 1 when the included plan usage is exhausted (the on-demand pool is open), 0 otherwise (fleet-ops#4206).\n'
        printf '# TYPE fleet_prepaid_included_exhausted gauge\n'
        printf 'fleet_prepaid_included_exhausted{provider="cursor"} %s\n' "$inc_ex"
        printf '# HELP fleet_cursor_api_bucket_used_usd Cursor Ultra INCLUDED API bucket used, apiPercentUsed x limit, from GetCurrentPeriodUsage (fleet-ops#4566).\n'
        printf '# TYPE fleet_cursor_api_bucket_used_usd gauge\n'
        printf 'fleet_cursor_api_bucket_used_usd{provider="cursor"} %s\n' "$api_used_usd"
        printf '# HELP fleet_cursor_api_bucket_remaining_usd Cursor Ultra INCLUDED API bucket remaining before cycle reset (fleet-ops#4566).\n'
        printf '# TYPE fleet_cursor_api_bucket_remaining_usd gauge\n'
        printf 'fleet_cursor_api_bucket_remaining_usd{provider="cursor"} %s\n' "$api_remaining_usd"
    } >"$tmp" 2>/dev/null
    if chmod 0644 "$tmp" 2>/dev/null && mv -f "$tmp" "$PREPAID_PROM_PATH" 2>/dev/null; then
        :
    else
        rm -f "$tmp" 2>/dev/null
        log "WARN: could not write prepaid-spend.prom $PREPAID_PROM_PATH"
    fi
    log "cursor spend reader: spend_usd=$spend_usd pool_usd=$pool_usd cycle_end_s=$cycle_end_s included_exhausted=$inc_ex api_used_usd=$api_used_usd api_remaining_usd=$api_remaining_usd -> $PREPAID_PROM_PATH"
    write_cursor_usd_today
}

# fleet-ops#4621: the judge's landing-watch measure.sh and fable-check both
# read prepaid-usage/cursor.json usd_today. That field was the token-derived
# 0.000000 (cursor-cli records 0 usage tokens). Overwrite it with the trailing
# 24h API-bucket delta (or UNAVAILABLE:<why> — never a fabricated 0). Cycle-to-date
# is stored alongside as cursor_api_cycle_usd; it is NOT usd_today. Count and
# the 429/200 flags are preserved — this is a spend overlay, not a pick.
write_cursor_usd_today() {
    command -v cursor_today_figure >/dev/null 2>&1 || return 0
    local figure cycle f tmp week count flags429 flags200 f9date f2date
    export FLEET_PREPAID_SPEND_DIR="$PREPAID_SPEND_DIR"
    figure=$(cursor_today_figure)
    cycle=$(cursor_api_cycle_usd)
    [[ -n "$figure" ]] || return 0
    mkdir -p "$STATE_DIR/prepaid-usage" 2>/dev/null || true
    f="$STATE_DIR/prepaid-usage/cursor.json"
    tmp="$f.tmp.$$"
    week=$(iso_week)
    count=0
    flags429="false"; flags200="false"; f9date=""; f2date=""
    if [[ -f "$f" ]]; then
        week=$(jq -r '.week // empty' "$f" 2>/dev/null || true)
        [[ -n "$week" ]] || week=$(iso_week)
        count=$(jq -r '.count // 0' "$f" 2>/dev/null || echo 0)
        [[ "$count" =~ ^[0-9]+$ ]] || count=0
        flags429=$(jq -r '.provider_daily_logged_429 // false' "$f" 2>/dev/null || echo false)
        flags200=$(jq -r '.provider_daily_logged_200 // false' "$f" 2>/dev/null || echo false)
        f9date=$(jq -r '.provider_daily_logged_429_date // ""' "$f" 2>/dev/null || true)
        f2date=$(jq -r '.provider_daily_logged_200_date // ""' "$f" 2>/dev/null || true)
    fi
    jq -nc --arg w "$week" --argjson c "$count" --arg ud "$figure" --arg cy "$cycle" \
        --argjson f9 "$([[ "$flags429" == "true" ]] && echo true || echo false)" \
        --argjson f2 "$([[ "$flags200" == "true" ]] && echo true || echo false)" \
        --arg d9 "${f9date:-}" --arg d2 "${f2date:-}" \
        '{week:$w,count:$c,usd_today:$ud,cursor_api_cycle_usd:$cy,
          usd_today_source:"cursor-dashboard-getcurrentperiodusage",
          billing_lane:"ultra-included-api-bucket",
          provider_daily_logged_429:$f9,provider_daily_logged_429_date:$d9,
          provider_daily_logged_200:$f2,provider_daily_logged_200_date:$d2}' >"$tmp" 2>/dev/null || {
        rm -f "$tmp"
        log "WARN: could not write cursor usd_today $f"
        return 0
    }
    mv -f "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 0; }
    log "cursor spend reader: usd_today=$figure cursor_api_cycle_usd=$cycle -> $f"
}

# --- OpenCode Go usage reader + pacing (fleet-ops#5022) --------------------
# Key source, in order: the env file Pi's models.json already reads
# (/home/nish/fleet2/etc/opencode-go.env, `OPENCODE_GO_API_KEY=...`), else the
# opencode CLI auth store (~/.local/share/opencode/auth.json, ."opencode-go").key).
# The value is sent ONLY to opencode.ai over HTTPS and is never logged.
opencode_go_key() {
    local key=""
    if [[ -r "$OPENCODE_GO_ENV_FILE" ]]; then
        key=$(sed -n 's/^OPENCODE_GO_API_KEY=//p' "$OPENCODE_GO_ENV_FILE" 2>/dev/null | head -n1 || true)
    fi
    if [[ -z "$key" && -r "$OPENCODE_GO_AUTH_JSON" ]]; then
        key=$(jq -r '."opencode-go".key // empty' "$OPENCODE_GO_AUTH_JSON" 2>/dev/null || true)
    fi
    printf '%s' "$key"
}

# Echoes one tab-separated row per window (5h, weekly, monthly):
#   window<TAB>used_percent<TAB>reset_epoch
# Empty on any failure (no metric emitted; the absent() rule fires).
opencode_go_measured_usage() {
    local resp key epoch
    if [[ -n "$OPENCODE_GO_USAGE_URL" ]]; then
        if [[ -f "$OPENCODE_GO_USAGE_URL" ]]; then
            resp=$(cat "$OPENCODE_GO_USAGE_URL" 2>/dev/null || true)
        else
            resp=$("$CURL" -s -m 15 "$OPENCODE_GO_USAGE_URL" 2>/dev/null || true)
        fi
    else
        key=$(opencode_go_key)
        [[ -n "$key" ]] || { echo ""; return; }
        resp=$("$CURL" -s -m 15 -H "Authorization: Bearer $key" \
            "$OPENCODE_GO_USAGE_ENDPOINT" 2>/dev/null || true)
    fi
    [[ -n "$resp" ]] || { echo ""; return; }
    if ! jq -e '.usage.rolling.percent // .usage.weekly.percent' >/dev/null 2>&1 <<<"$resp"; then
        echo ""; return
    fi
    while IFS=$'\t' read -r win pct iso; do
        [[ -n "$win" ]] || continue
        [[ "$pct" =~ ^[0-9]+(\.[0-9]+)?$ ]] || pct=0
        epoch=$(date -u -d "$iso" +%s 2>/dev/null || echo 0)
        [[ "$epoch" =~ ^[0-9]+$ ]] || epoch=0
        printf '%s\t%s\t%s\n' "$win" "$pct" "$epoch"
    done < <(jq -r '
        .usage as $u
        | [["5h", ($u.rolling.percent // 0), ($u.rolling.resetsAt // "")],
           ["weekly", ($u.weekly.percent // 0), ($u.weekly.resetsAt // "")],
           ["monthly", ($u.monthly.percent // 0), ($u.monthly.resetsAt // "")]]
        | .[] | @tsv' <<<"$resp" 2>/dev/null || true)
}

# Paced cap: floor(remaining_weekly_pct / hours_to_reset * K), floor 1,
# ceiling the declared cap. Echoes the integer, or empty when the inputs are
# unusable (no weekly reset, reset already passed, declared cap 0).
opencode_go_paced_cap() {
    local remaining_pct="$1" reset_epoch="$2" declared="$3"
    local now_s hours
    [[ "$declared" =~ ^[1-9][0-9]*$ ]] || { echo ""; return; }
    now_s=$(date -u +%s)
    [[ "$reset_epoch" =~ ^[0-9]+$ ]] || { echo ""; return; }
    (( reset_epoch > now_s )) || { echo ""; return; }
    hours=$(awk -v a="$reset_epoch" -v b="$now_s" 'BEGIN{printf "%.4f", (a-b)/3600}')
    awk -v rem="$remaining_pct" -v h="$hours" -v k="$OPENCODE_GO_PACE_K" -v cap="$declared" '
        BEGIN {
            if (h <= 0 || k <= 0) { print ""; exit }
            c = int((rem / h) * k)
            if (c < 1) c = 1
            if (c > cap) c = cap
            print c
        }'
}

# Write the OpenCode Go usage state + node_exporter textfile. State file:
# $STATE_DIR/prepaid-usage/opencode-go.json — the pick counter seat-lib owns
# (week, count) and the 429/200 flags are preserved; this is a usage overlay,
# not a pick. Textfile: its own file (the cursor writer owns prepaid-spend.prom
# outright and truncates it), so a dead reader leaves the metric absent and the
# FleetOpenCodeGoUsageReaderAbsent rule fires instead of silently freezing 0.
emit_opencode_go_prepaid_usage() {
    local rows found=0 win pct reset_epoch
    local weekly_pct="" weekly_reset=0 rolling_pct="" rolling_reset=0 monthly_pct="" monthly_reset=0
    rows=$(opencode_go_measured_usage) || rows=""
    if [[ -z "$rows" ]]; then
        log "opencode-go usage reader: no data (key missing or API unreachable) — metric omitted, absent() rule will fire"
        return 0
    fi
    while IFS=$'\t' read -r win pct reset_epoch; do
        [[ -n "$win" ]] || continue
        found=1
        case "$win" in
            5h) rolling_pct="$pct"; rolling_reset="$reset_epoch" ;;
            weekly) weekly_pct="$pct"; weekly_reset="$reset_epoch" ;;
            monthly) monthly_pct="$pct"; monthly_reset="$reset_epoch" ;;
        esac
    done <<<"$rows"
    (( found == 1 )) || return 0

    local declared paced="" observed_s remaining_pct=0
    declared=$(jq -r '.providers."opencode-go".cap // 0' "$SEAT_CAPS_JSON" 2>/dev/null || echo 0)
    [[ "$declared" =~ ^[0-9]+$ ]] || declared=0
    if [[ -n "$weekly_pct" ]]; then
        remaining_pct=$(awk -v p="$weekly_pct" 'BEGIN{r=100-p; if (r<0) r=0; printf "%.4f", r}')
        paced=$(opencode_go_paced_cap "$remaining_pct" "$weekly_reset" "$declared" || true)
    fi
    observed_s=$(date -u +%s)

    mkdir -p "$PREPAID_SPEND_DIR" 2>/dev/null || true
    local state="$STATE_DIR/prepaid-usage/opencode-go.json"
    mkdir -p "$STATE_DIR/prepaid-usage" 2>/dev/null || true
    local tmp="$state.tmp.$$" existing="{}"
    [[ -f "$state" ]] && existing=$(cat "$state" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    jq -nc --argjson base "$existing" \
        --argjson rp "${rolling_pct:-0}" --argjson rr "${rolling_reset:-0}" \
        --argjson wp "${weekly_pct:-0}" --argjson wr "${weekly_reset:-0}" \
        --argjson mp "${monthly_pct:-0}" --argjson mr "${monthly_reset:-0}" \
        --argjson obs "$observed_s" --arg paced "${paced:-}" --argjson declared "$declared" \
        '$base + {
          usage:{rolling:{percent:$rp,reset_epoch:$rr},weekly:{percent:$wp,reset_epoch:$wr},monthly:{percent:$mp,reset_epoch:$mr}},
          usage_observed_epoch:$obs,usage_paced_cap:(if $paced == "" then null else ($paced|tonumber) end),
          usage_declared_cap:$declared,
          usage_source:"opencode-zen-go-usage-api"}' >"$tmp" 2>/dev/null || {
        rm -f "$tmp"
        log "WARN: could not write opencode-go usage state $state"
        return 0
    }
    mv -f "$tmp" "$state" 2>/dev/null || { rm -f "$tmp"; return 0; }

    local prom_tmp="${PREPAID_USAGE_PROM_PATH}.$$"
    {
        printf '# HELP fleet_prepaid_usage_pct Used percent of a prepaid subscription window, from the vendor usage API (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_usage_pct gauge\n'
        printf 'fleet_prepaid_usage_pct{provider="opencode-go",window="5h"} %s\n' "${rolling_pct:-0}"
        printf 'fleet_prepaid_usage_pct{provider="opencode-go",window="weekly"} %s\n' "${weekly_pct:-0}"
        printf 'fleet_prepaid_usage_pct{provider="opencode-go",window="monthly"} %s\n' "${monthly_pct:-0}"
        printf '# HELP fleet_prepaid_window_reset_seconds Seconds until a prepaid subscription window resets (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_window_reset_seconds gauge\n'
        printf 'fleet_prepaid_window_reset_seconds{provider="opencode-go",window="5h"} %s\n' "$(awk -v r="$rolling_reset" -v n="$observed_s" 'BEGIN{s=r-n; if (s<0) s=0; printf "%.0f", s}')"
        printf 'fleet_prepaid_window_reset_seconds{provider="opencode-go",window="weekly"} %s\n' "$(awk -v r="$weekly_reset" -v n="$observed_s" 'BEGIN{s=r-n; if (s<0) s=0; printf "%.0f", s}')"
        printf 'fleet_prepaid_window_reset_seconds{provider="opencode-go",window="monthly"} %s\n' "$(awk -v r="$monthly_reset" -v n="$observed_s" 'BEGIN{s=r-n; if (s<0) s=0; printf "%.0f", s}')"
        printf '# HELP fleet_prepaid_window_reset_timestamp Unix seconds at which a prepaid subscription window resets (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_window_reset_timestamp gauge\n'
        printf 'fleet_prepaid_window_reset_timestamp{provider="opencode-go",window="5h"} %s\n' "${rolling_reset:-0}"
        printf 'fleet_prepaid_window_reset_timestamp{provider="opencode-go",window="weekly"} %s\n' "${weekly_reset:-0}"
        printf 'fleet_prepaid_window_reset_timestamp{provider="opencode-go",window="monthly"} %s\n' "${monthly_reset:-0}"
        printf '# HELP fleet_prepaid_paced_cap Concurrency the remaining prepaid pool supports to the reset, floor(remaining_pct/hours_to_reset*K) (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_paced_cap gauge\n'
        printf 'fleet_prepaid_paced_cap{provider="opencode-go"} %s\n' "${paced:-0}"
        printf '# HELP fleet_prepaid_declared_cap Declared provider cap in seat-caps.json, the pacing ceiling (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_declared_cap gauge\n'
        printf 'fleet_prepaid_declared_cap{provider="opencode-go"} %s\n' "$declared"
        printf '# HELP fleet_prepaid_usage_observed_timestamp Unix seconds at which the prepaid usage reader last succeeded (fleet-ops#5022).\n'
        printf '# TYPE fleet_prepaid_usage_observed_timestamp gauge\n'
        printf 'fleet_prepaid_usage_observed_timestamp{provider="opencode-go"} %s\n' "$observed_s"
    } >"$prom_tmp" 2>/dev/null
    if chmod 0644 "$prom_tmp" 2>/dev/null && mv -f "$prom_tmp" "$PREPAID_USAGE_PROM_PATH" 2>/dev/null; then
        :
    else
        rm -f "$prom_tmp" 2>/dev/null
        log "WARN: could not write prepaid-usage.prom $PREPAID_USAGE_PROM_PATH"
    fi
    log "opencode-go usage reader: 5h=${rolling_pct:-?}% weekly=${weekly_pct:-?}% monthly=${monthly_pct:-?}% paced_cap=${paced:-?} declared_cap=$declared -> $PREPAID_USAGE_PROM_PATH"
    if [[ -n "${rolling_pct:-}" ]] && awk -v p="$rolling_pct" -v w="$OPENCODE_GO_ROLLING_WALL_PCT" 'BEGIN{exit !(p+0 >= w+0)}'; then
        loud "PREPAID-UTIL-OPENCODE-GO-5H-WALL" \
            "opencode-go 5h window at ${rolling_pct}% (>= ${OPENCODE_GO_ROLLING_WALL_PCT}%), resets in $(( rolling_reset > observed_s ? rolling_reset - observed_s : 0 ))s — a quota wall now benches the seat to that live reset, not the flat quota_bench_default_s"
    fi
}

# --- ETIMEDOUT watch at cap 2 (fleet-ops#4206) ----------------------------
# cursor/cursor-grok-4.6-high was raised 1->2 to spend the $400 pool. The
# safety revert: if a cli_timeout (spawnSync ETIMEDOUT) lands in the cursor
# seat ledger while cap >= 2, auto-file a 'lower cursor cap to 1' finding so
# a worker PRs the cap back down. The seat-health extension already benches
# the faulted seat (cli_timeout is a transient bench); this watch prevents
# the 2nd concurrent slot from inheriting the same blast radius.
cursor_cap_value() {
    jq -r '.providers.cursor.cap // 0' "$SEAT_CAPS_JSON" 2>/dev/null || echo 0
}

cursor_recent_cli_timeout() {
    # Echoes the model name of the most recent cursor cli_timeout within the
    # horizon, or empty. $1 = horizon hours.
    local horizon_h="$1" now_s f fm obs obs_s
    now_s=$(date -u -d "$NOW" +%s 2>/dev/null || echo 0)
    local horizon_s=$(( horizon_h * 3600 ))
    shopt -s nullglob
    for f in "$LEDGER_DIR/cursor__"*.json; do
        [[ -f "$f" ]] || continue
        fm=$(jq -r '.failure_mode // ""' "$f" 2>/dev/null || true)
        [[ "$fm" == "cli_timeout" ]] || continue
        obs=$(jq -r '.observed_at // ""' "$f" 2>/dev/null || true)
        [[ -n "$obs" ]] || continue
        obs_s=$(date -u -d "$obs" +%s 2>/dev/null || echo 0)
        if [[ "$obs_s" =~ ^[0-9]+$ ]] && (( now_s - obs_s <= horizon_s )); then
            shopt -u nullglob
            jq -r '.model // "unknown"' "$f" 2>/dev/null || echo "unknown"
            return 0
        fi
    done
    shopt -u nullglob
    echo ""
}

# Ready work = open agent-ready + agent-in-progress across enrolled intake
# repos (same definition as fleet-heartbeat-undersaturation). Override via
# FLEET_PREPAID_UTIL_WORK for offline tests.
ready_work() {
    if [[ -n "${FLEET_PREPAID_UTIL_WORK:-}" ]]; then
        echo "$FLEET_PREPAID_UTIL_WORK"
        return
    fi
    local total=0 repo ready prog
    if [[ ! -f "$INTAKE_JSON" ]] || ! jq -e . "$INTAKE_JSON" >/dev/null 2>&1; then
        echo 0
        return
    fi
    while IFS= read -r repo; do
        [[ -n "$repo" ]] || continue
        ready=$("$GH" issue list -R "$repo" -l agent-ready \
            --state open --json number --limit 200 --jq 'length' 2>/dev/null || echo 0)
        prog=$("$GH" issue list -R "$repo" -l agent-in-progress \
            --state open --json number --limit 200 --jq 'length' 2>/dev/null || echo 0)
        [[ "$ready" =~ ^[0-9]+$ ]] || ready=0
        [[ "$prog" =~ ^[0-9]+$ ]] || prog=0
        total=$((total + ready + prog))
    done < <(jq -r '.repos[].name | "Nishfleet/" + .' "$INTAKE_JSON" 2>/dev/null || true)
    echo "$total"
}

# ---- load config -----------------------------------------------------------
if [[ ! -f "$ENTITLED_JSON" ]]; then
    loud "PREPAID-UTIL-VIOLATION" "entitled inventory missing: $ENTITLED_JSON"
    exit 1
fi
if [[ ! -f "$SEAT_CAPS_JSON" ]]; then
    loud "PREPAID-UTIL-VIOLATION" "seat-caps missing: $SEAT_CAPS_JSON"
    exit 1
fi
if ! jq -e . "$ENTITLED_JSON" >/dev/null 2>&1; then
    loud "PREPAID-UTIL-VIOLATION" "entitled inventory unparseable: $ENTITLED_JSON"
    exit 1
fi
if ! jq -e . "$SEAT_CAPS_JSON" >/dev/null 2>&1; then
    loud "PREPAID-UTIL-VIOLATION" "seat-caps unparseable: $SEAT_CAPS_JSON"
    exit 1
fi

violations=0

# ---- GATE: prepaid ladder completeness ------------------------------------
# Every prepaid-quota provider with cap>0 and a non-empty .models map must
# be in prepaid_providers_in_order. Mirror of the free-roster
# penny-for-speed gate. pick_seat orders the prepaid bucket by that list
# (expiry-first); a missing row is a withheld sub.
prepaid_order_set=()
while IFS= read -r p; do
    [[ -n "$p" ]] && prepaid_order_set+=("$p")
done < <(jq -r '.prepaid_providers_in_order // [] | .[]' "$SEAT_CAPS_JSON" 2>/dev/null || true)

declare -A in_prepaid_order=()
for p in "${prepaid_order_set[@]}"; do
    in_prepaid_order["$p"]=1
done

while IFS=$'\t' read -r pid pclass pcap mcount; do
    [[ -n "$pid" ]] || continue
    pclass=$(norm_class "$pclass")
    [[ "$pclass" == "prepaid-quota" ]] || continue
    [[ "$pcap" =~ ^[1-9][0-9]*$ ]] || continue
    [[ "$mcount" =~ ^[1-9][0-9]*$ ]] || continue
    if [[ -z "${in_prepaid_order[$pid]:-}" ]]; then
        loud "PREPAID-UTIL-VIOLATION" \
            "prepaid ladder: $pid (cap=$pcap, $mcount model(s)) missing from prepaid_providers_in_order"
        file_finding "$pid" "missing-from-prepaid-order" \
            "prepaid ladder: $pid missing from prepaid_providers_in_order" \
            "config/seat-caps.json lists \`${pid}\` as prepaid-quota, cap=${pcap}, with ${mcount} allowlisted model(s), but it is not in \`prepaid_providers_in_order\`. Standing rule sr-prepaid-max-util (Nish 2026-08-20): prepaid subs run at max utilization; unused allowance at week/month rollover is money burned. pick_seat orders the prepaid bucket by prepaid_providers_in_order (expiry-first). A wired prepaid seat missing from that list is withheld from the ladder — the SuperGrok expiry-waste shape. Add \`${pid}\` to prepaid_providers_in_order."
        violations=$((violations + 1))
    fi
done < <(jq -r '
    .providers | to_entries[] | .key as $k | .value as $v
    | [$k,
       (if ($v|type)=="number" then "free" else ($v.class // "free") end),
       (if ($v|type)=="number" then $v else ($v.cap // 0) end),
       (if ($v|type)=="object" and ($v.models|type)=="object" then ($v.models|length) else 0 end)]
    | @tsv
' "$SEAT_CAPS_JSON" 2>/dev/null || true)

if (( violations > 0 )); then
    log "FAIL: $violations prepaid-util gate violation(s)"
    exit 1
fi

# ---- DETECTOR + heartbeat lines -------------------------------------------
week=$(iso_week)
left_h=$(hours_left_in_iso_week)
work=$(ready_work)
[[ "$work" =~ ^[0-9]+$ ]] || work=0
[[ "$HORIZON_H" =~ ^[0-9]+$ ]] || HORIZON_H=24
[[ "$FILE_CAP" =~ ^[0-9]+$ ]] || FILE_CAP=5

filed=0
while IFS=$'\t' read -r pid pclass pcap mcount; do
    [[ -n "$pid" ]] || continue
    pclass=$(norm_class "$pclass")
    [[ "$pclass" == "prepaid-quota" ]] || continue
    [[ "$pcap" =~ ^[1-9][0-9]*$ ]] || continue

    picks=$(prepaid_picks "$pid")
    live=$(prepaid_live "$pid")
    benched=0
    if provider_benched "$pid"; then
        benched=1
    fi

    loud "PREPAID-UTIL" \
        "provider=$pid cap=$pcap picks=$picks week=$week remaining_h=$left_h live=$live benched=$benched work=$work"

    [[ "$mcount" =~ ^[1-9][0-9]*$ ]] || continue
    (( left_h <= HORIZON_H )) || continue
    (( picks == 0 )) || continue
    (( work > 0 )) || continue
    (( benched == 0 )) || continue

    if (( filed >= FILE_CAP )); then
        log "cap reached ($FILE_CAP): deferring expiry-waste $pid to a later tick"
        continue
    fi
    loud "PREPAID-UTIL-EXPIRY-WASTE" \
        "prepaid $pid has 0 picks this ISO week with ${left_h}h left and ready work=$work — filing"
    file_finding "$pid" "expiry-waste" \
        "prepaid expiry-waste: $pid unused with ${left_h}h left in ISO week $week" \
        "fleet-prepaid-util-canary (fleet-ops#531) detected that prepaid-quota provider \`${pid}\` (cap=${pcap}) has 0 picks this ISO week (${week}) with ${left_h}h remaining, while ready work is ${work}. Standing rule sr-prepaid-max-util (Nish 2026-08-20): unused prepaid allowance at week/month rollover is money burned — this is the SuperGrok expiry-waste shape. The seat is not quota-benched. Route work onto \`${pid}\` before the window rolls over; do not withhold a live prepaid seat behind free lanes in the last ${HORIZON_H}h of the week."
    filed=$((filed + 1))
done < <(jq -r '
    .providers | to_entries[] | .key as $k | .value as $v
    | [$k,
       (if ($v|type)=="number" then "free" else ($v.class // "free") end),
       (if ($v|type)=="number" then $v else ($v.cap // 0) end),
       (if ($v|type)=="object" and ($v.models|type)=="object" then ($v.models|length) else 0 end)]
    | @tsv
' "$SEAT_CAPS_JSON" 2>/dev/null || true)

if (( filed > 0 )); then
    loud "PREPAID-UTIL-FILED" "$filed expiry-waste ticket(s) filed; gates clean; tick stays green"
else
    loud "PREPAID-UTIL-OK" "gates clean; prepaid ladder complete; no expiry-waste this tick"
fi

# ---- Cursor $400 pool measured spend (fleet-ops#4206) --------------------
# Emit fleet_prepaid_spend_usd{provider=cursor} + pool/cycle/included from
# the DashboardService API. Non-fatal: a missing/unreachable reader leaves
# the metric absent (the FleetCursorPrepaidSpendReaderAbsent rule fires).
emit_cursor_prepaid_spend

# ---- OpenCode Go usage + pacing (fleet-ops#5022) -------------------------
# Emit fleet_prepaid_usage_pct{provider="opencode-go",window="5h|weekly|monthly"}
# + reset timestamps + fleet_prepaid_paced_cap from the subscription's own
# usage endpoint, and overlay them into prepaid-usage/opencode-go.json.
# Non-fatal: a dead reader leaves the series absent so
# FleetOpenCodeGoUsageReaderAbsent fires instead of a frozen 0.
emit_opencode_go_prepaid_usage

# ---- ETIMEDOUT watch at cap 2 (fleet-ops#4206) ---------------------------
# If the cursor seat ledger carries a fresh cli_timeout while cap >= 2,
# auto-file a 'lower cursor cap to 1' finding. Non-fatal: the seat-health
# extension already benched the faulted seat; this watch prevents the 2nd
# concurrent slot from inheriting the same blast radius.
cursor_cap=$(cursor_cap_value)
if [[ "$cursor_cap" =~ ^[2-9][0-9]*$ ]]; then
    timeout_model=$(cursor_recent_cli_timeout "$ETIMEDOUT_HORIZON_H")
    if [[ -n "$timeout_model" ]]; then
        loud "PREPAID-UTIL-CURSOR-ETIMEDOUT-AT-CAP-2" \
            "cursor/${timeout_model} cli_timeout within ${ETIMEDOUT_HORIZON_H}h while cap=${cursor_cap} — filing lower-cap-to-1"
        file_finding "cursor" "etimedout-cap-rollback" \
            "cursor cap ${cursor_cap} -> 1: cli_timeout on cursor/${timeout_model} within ${ETIMEDOUT_HORIZON_H}h (fleet-ops#4206)" \
            "fleet-prepaid-util-canary (fleet-ops#4206) detected a fresh cli_timeout (spawnSync ETIMEDOUT) on cursor/${timeout_model} while the cursor provider cap is ${cursor_cap}. The cap was raised 1->2 by fleet-ops#4206 to spend the \$400 'API Usage' on-demand pool; the ETIMEDOUT watch is the safety revert. The seat-health extension already benched the faulted seat (cli_timeout is a transient bench); this finding asks a worker to PR \`config/seat-caps.json\` back to \`.providers.cursor.cap = 1\` and both model caps to 1, with a dated reason citing this cli_timeout, and to run tests/seat-lib-aimd, tests/fleet-token-economy, and tests/seat-caps-citation together (the three suites that pin config values). Do NOT touch other providers."
    fi
fi

exit 0
