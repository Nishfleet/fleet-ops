#!/usr/bin/env bash
# fleet-prepaid-util-canary — retired with P3b (fleet-ops#4263).
# Prepaid pick counters lived in the deleted routing library. LiteLLM
# /spend is the meter now. This wrapper stays so heartbeat-tier1 block 38
# does not page; P4 deletes the redundant canary.
set -euo pipefail
printf '[%s] [fleet-prepaid-util-canary] retired: LiteLLM /spend owns prepaid util (fleet-ops#4263)\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
exit 0
