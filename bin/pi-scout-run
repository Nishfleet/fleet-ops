#!/usr/bin/env bash
# bin/pi-scout-run
# Seat-rotation wrapper for pi-scout and pi-scout-repair units.
#
# Assembles the packet from ~/.pi/agent/prompts/<prompt>.md plus the correct
# TARGET line, calls pick_seat from lib/seat-lib.sh, and runs
# pi --print --provider <provider> --model <model> on the assembled packet.
#
# For the 0509 scout, the packet is research-seeded deterministically by
# lib/packet-assembly.sh (market signal, category research, north-star rule,
# repo reality). The scout fails loud if the market signal is stale or missing.
#
# Args:
#   $1 = repo instance (e.g. fleet-ops)
#   $2 = prompt name (scout or scout-repair)
#
# Environment:
#   PI_PACKET_SEAT_LIB      path to seat-lib.sh
#   PI_PACKET_ASSEMBLY_LIB  path to packet-assembly.sh
#   SCOUT_PROMPT_DIR        prompt directory (default ~/.pi/agent/prompts)
#   PI_BIN                  pi binary (default ~/.local/bin/pi)

set -euo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export HOME="${HOME:-/home/nish}"

SEAT_LIB="${PI_PACKET_SEAT_LIB:-$HOME/.local/lib/pi-packet/seat-lib.sh}"
# shellcheck source=../lib/seat-lib.sh source-path=SCRIPTDIR
source "$SEAT_LIB"

PACKET_ASM_LIB="${PI_PACKET_ASSEMBLY_LIB:-$HOME/.local/lib/pi-packet/packet-assembly.sh}"
# shellcheck source=../lib/packet-assembly.sh source-path=SCRIPTDIR
source "$PACKET_ASM_LIB"

# fleet-ops#4450 item 3: per-run scout label_budget from the drain rate.
# Best-effort source of lib/work-supply.sh: when it is absent the budget
# falls back to the 8 floor (the scout prompt's default), so a missing lib
# never breaks the scout.
# shellcheck disable=SC1091
WS_LIB="${PI_PACKET_WS_LIB:-$HOME/.local/lib/pi-packet/work-supply.sh}"
if [[ -f "$WS_LIB" ]]; then
    # shellcheck disable=SC1091
    source "$WS_LIB"
fi

PI_BIN="${PI_BIN:-$HOME/.local/bin/pi}"
PROMPT_DIR="${SCOUT_PROMPT_DIR:-$HOME/.pi/agent/prompts}"

usage() {
    echo "usage: pi-scout-run <repo> <prompt-name>" >&2
    exit 1
}
[[ $# -ge 2 ]] || usage

repo="$1"
prompt_name="$2"
prompt_file="$PROMPT_DIR/${prompt_name}.md"

[[ -f "$prompt_file" ]] || { echo "pi-scout-run: prompt not found: $prompt_file" >&2; exit 1; }

# Choose a healthy seat. Compute need_capable from the task weight so a
# heavy repair prompt gets a capable seat, while the lighter scout prompt
# can use any healthy seat.
weight=$(task_weight "$prompt_file")
difficulty="$weight"
if declare -F packet_difficulty >/dev/null 2>&1; then
    difficulty=$(packet_difficulty "$prompt_file")
fi
need_capable=0
[[ "$difficulty" == "heavy" || "$difficulty" == "keystone" ]] && need_capable=1

# Free-tier privacy line (fleet-ops#520): a private-repo target never routes
# to a free-class lane. Resolve visibility via config/repo-privacy.json
# (fail-closed: an unclassified repo is treated as private).
scout_privacy=$(repo_privacy "$repo")
seat_log "pi-scout-run: $repo/$prompt_name privacy=$scout_privacy"
# fleet-ops#3724: the packet repo also feeds pick_seat's product_only gate —
# a seat flagged product_only in seat-caps.json is offered only when this
# repo carries the product flag in config/intake-repos.json.
export PI_PACKET_REPO="$repo"

# fleet-ops#4219 P3a: PI_SEAT_SOURCE switch.
if [[ "${PI_SEAT_SOURCE:-seat-lib}" == "litellm" ]]; then
    seat=$(litellm_pick_seat "worker-cheap")
    seat_log "pi-scout-run: $repo/$prompt_name PI_SEAT_SOURCE=litellm group=worker-cheap"
else
    seat=$(pick_seat "" "" "$need_capable" "" "$difficulty" "$scout_privacy" || true)
fi
if [[ -z "$seat" ]]; then
    seat_log "pi-scout-run: $repo/$prompt_name no healthy seat available"
    echo "pi-scout-run: $repo/$prompt_name no healthy seat available" >&2
    exit 1
fi

np=$(printf '%s' "$seat" | cut -f1)
nm=$(printf '%s' "$seat" | cut -f2)

seat_log "pi-scout-run: $repo/$prompt_name running on $np/$nm (weight=$difficulty)"

# fleet-ops#4450 item 3: per-run scout label_budget from the drain rate (product
# repos only: max(8, ceil(drain*4)) capped 40; control-plane stays at 8).
# The concrete number is injected into the packet as a run-specific
# `label_budget = <N>` line that overrides the prompt's default 8, so the
# model obeys the derived budget without any per-repo prompt edit. Passed
# through the SCOUT_LABEL_BUDGET env var for tests to pin/prove.
label_budget=8
if declare -F work_supply_label_budget >/dev/null 2>&1; then
    label_budget=$(work_supply_label_budget "$repo" 2>/dev/null || printf '8\n')
    case "$label_budget" in
        ''|*[!0-9]*) label_budget=8 ;;
    esac
fi
label_budget="${SCOUT_LABEL_BUDGET:-$label_budget}"
export SCOUT_LABEL_BUDGET="$label_budget"
seat_log "pi-scout-run: $repo/$prompt_name label_budget=$label_budget (fleet-ops#4450)"

# Build the packet.
# - 0509 scout: use the shared packet-assembly library (research-seeded).
# - Everything else: prompt + TARGET line (legacy shape).
case "$prompt_name" in
    scout)
        if [[ "$repo" == "0509" ]]; then
            packet=$(mktemp)
            # shellcheck disable=SC2064
            trap "rm -f '$packet'" EXIT INT TERM
            if ! packet_assemble_0509_scout "$prompt_file" "$repo" "$packet"; then
                seat_log "pi-scout-run: $repo/$prompt_name ABORT — market signal stale/missing"
                echo "pi-scout-run: $repo/$prompt_name market signal stale or missing — aborting" >&2
                exit 1
            fi
            seat_log "pi-scout-run: $repo/$prompt_name research-seeded packet assembled"
            printf '\nlabel_budget = %s (fleet-ops#4450: derived from the drain rate; overrides the default above)\n' "$label_budget" >> "$packet"
            "$PI_BIN" --print --provider "$np" --model "$nm" < "$packet"
        else
            {
                cat "$prompt_file"
                echo
                echo "TARGET REPO: Nishfleet/${repo}"
                echo
                printf 'label_budget = %s (fleet-ops#4450: derived from the drain rate; overrides the default above)\n' "$label_budget"
            } | "$PI_BIN" --print --provider "$np" --model "$nm"
        fi
        ;;
    scout-repair)
        {
            cat "$prompt_file"
            echo
            echo "TARGET: scout unit pi-scout@${repo}.service, repo Nishfleet/${repo}"
        } | "$PI_BIN" --print --provider "$np" --model "$nm"
        ;;
    *)
        echo "pi-scout-run: unknown prompt name: $prompt_name" >&2
        exit 1
        ;;
esac
