#!/usr/bin/env bash
# fleet-debug-playbook — session-close lint (fleet-ops#522).
#
# Standing rule: debugging sessions end with a playbook note. A multi-attempt
# debug (two or more real failed toolResults) that never filed the four-
# heading vault note (SIGNATURE / ROOT CAUSE / FIX THAT WORKED / DEAD ENDS)
# is an unfinished repair. This detector scans recent Pi session JSONL and
# auto-files when the playbook shape is missing.
#
# No new scheduler. Run by fleet-heartbeat-tier1 every tick.
# Exit 0: no missing playbooks in the window. Exit 1: at least one
# (LOUD + auto-filed, deduped by signal: debug-playbook/<slug>).
# Exit 1 also if the helper itself is broken (missing python/lib).
#
# Subcommands:
#   (default) / canary   heartbeat canary (fail-loud)
#   gate <session.jsonl> fail-closed single-session check
#
# Environment seams (tests override all of these):
#   FLEET_DEBUG_PLAYBOOK_SESSIONS   default ~/.pi/agent/sessions
#   FLEET_DEBUG_PLAYBOOK_LIB        python helper
#   FLEET_DEBUG_PLAYBOOK_WINDOW_HOURS   default 24
#   FLEET_DEBUG_PLAYBOOK_GRACE_MINUTES  default 20 (skip in-flight sessions)
#   FLEET_DEBUG_PLAYBOOK_NOW        ISO timestamp
#   FLEET_DEBUG_PLAYBOOK_FILE_ISSUES    1 (default) / 0
#   FLEET_DEBUG_PLAYBOOK_ISSUE_REPO     default Nishfleet/fleet-ops
#   FLEET_DEBUG_PLAYBOOK_CAP            default 5 (per tick)
#   FLEET_DEBUG_PLAYBOOK_CUMULATIVE_CAP default 20 (floor; the effective cap
#                                       grows to cover every in-window finding,
#                                       fleet-ops#2726)
#   FLEET_DEBUG_PLAYBOOK_OK_TO_CLOSE    0 (default) / 1 (production heartbeat)
#   FLEET_HEARTBEAT_TRIAGE
#   GH

set -Eeuo pipefail

export HOME="${HOME:-/home/nish}"
export PATH="/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Use the nishfleet-worker App token for any GitHub writes. Fail closed if
# the App cannot mint and no token has been inherited from a parent organ.
if [[ -z "${GH_TOKEN:-}" ]]; then
    eval "$(worker-token --print)"
fi

_canon_script=$(readlink -f "$0")
_canon_repo=$(cd "$(dirname "$_canon_script")/.." && pwd)

GH="${GH:-gh}"
SESSIONS="${FLEET_DEBUG_PLAYBOOK_SESSIONS:-$HOME/.pi/agent/sessions}"
LIB="${FLEET_DEBUG_PLAYBOOK_LIB:-$_canon_repo/lib/debug-playbook.py}"
# Only fall back to the installed copy when the caller did not pin LIB.
if [[ -z "${FLEET_DEBUG_PLAYBOOK_LIB:-}" && ! -f "$LIB" && -f "${HOME}/.local/lib/pi-packet/debug-playbook.py" ]]; then
    LIB="${HOME}/.local/lib/pi-packet/debug-playbook.py"
fi
WINDOW_HOURS="${FLEET_DEBUG_PLAYBOOK_WINDOW_HOURS:-24}"
GRACE_MINUTES="${FLEET_DEBUG_PLAYBOOK_GRACE_MINUTES:-20}"
NOW_ISO="${FLEET_DEBUG_PLAYBOOK_NOW:-}"
FILE_ISSUES="${FLEET_DEBUG_PLAYBOOK_FILE_ISSUES:-1}"
ISSUE_REPO="${FLEET_DEBUG_PLAYBOOK_ISSUE_REPO:-Nishfleet/fleet-ops}"
CAP="${FLEET_DEBUG_PLAYBOOK_CAP:-5}"
CUMULATIVE_CAP="${FLEET_DEBUG_PLAYBOOK_CUMULATIVE_CAP:-20}"
OK_TO_CLOSE="${FLEET_DEBUG_PLAYBOOK_OK_TO_CLOSE:-0}"
TRIAGE="${FLEET_HEARTBEAT_TRIAGE:-/home/nish/workspaces/agent-state/FLEET-HEARTBEAT-TRIAGE.md}"

log() {
    printf '[%s] [fleet-debug-playbook] %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2
}

loud() {
    local tag="$1"; shift
    local msg="$*"
    log "LOUD [$tag] $msg"
    {
        printf '\n[%s] [%s] %s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tag" "$msg"
    } >> "$TRIAGE" 2>/dev/null || log "WARN: could not append to triage $TRIAGE"
}

# --- gate subcommand: fail-closed single-session check ----------------------
if [[ "${1:-}" == "gate" ]]; then
    shift
    if [[ $# -lt 1 ]]; then
        echo "usage: fleet-debug-playbook gate <session.jsonl>" >&2
        exit 2
    fi
    session_path="$1"
    if [[ ! -f "$session_path" ]]; then
        loud "DEBUG-PLAYBOOK-GATE-BROKEN" "session file missing: $session_path"
        exit 2
    fi
    set +e
    finding=$(python3 "$LIB" gate --path "$session_path" 2>/tmp/debug-playbook-gate.err)
    gate_rc=$?
    set -e
    if [[ "$gate_rc" -ne 0 ]] && [[ "$gate_rc" -ne 1 ]]; then
        loud "DEBUG-PLAYBOOK-GATE-BROKEN" "helper crashed (rc=$gate_rc) for $session_path: $(tr '\n' ' ' </tmp/debug-playbook-gate.err 2>/dev/null)"
        exit 2
    fi
    if [[ "$gate_rc" -eq 1 ]]; then
        slug=$(jq -r '.slug' <<<"$finding")
        attempts=$(jq -r '.attempts' <<<"$finding")
        snippet=$(jq -r '.snippet' <<<"$finding")
        loud "DEBUG-PLAYBOOK-GATE-BLOCK" "session=$slug attempts=$attempts snippet=$snippet"
        exit 1
    fi
    log "DEBUG-PLAYBOOK-GATE-OK" "session clean: $session_path"
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    loud "DEBUG-PLAYBOOK-BROKEN" "python3 missing — cannot lint sessions"
    exit 1
fi
if [[ ! -f "$LIB" ]]; then
    loud "DEBUG-PLAYBOOK-BROKEN" "helper missing at $LIB"
    exit 1
fi

scan_args=(scan --root "$SESSIONS" --window-hours "$WINDOW_HOURS" --grace-minutes "$GRACE_MINUTES")
if [[ -n "$NOW_ISO" ]]; then
    scan_args+=(--now "$NOW_ISO")
fi

set +e
report=$(python3 "$LIB" "${scan_args[@]}" 2>/tmp/debug-playbook.err)
scan_rc=$?
set -e

if [[ "$scan_rc" -ne 0 ]] || ! jq -e . >/dev/null 2>&1 <<<"$report"; then
    loud "DEBUG-PLAYBOOK-BROKEN" "helper produced no JSON (rc=$scan_rc) $(tr '\n' ' ' </tmp/debug-playbook.err 2>/dev/null)"
    exit 1
fi

finding_count=$(jq '.findings | length' <<<"$report")
scanned=$(jq -r '.scanned' <<<"$report")
log "scanned=$scanned old=$(jq -r .skipped_old <<<"$report") grace=$(jq -r .skipped_grace <<<"$report") findings=$finding_count"

open_json="[]"
if [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    set +e
    open_json=$("$GH" issue list -R "$ISSUE_REPO" --state open --limit 200 --json number,body 2>/dev/null)
    set -e
    open_json="${open_json:-[]}"
fi

current_slugs=$(jq -r '.findings[].slug' <<<"$report" 2>/dev/null | sort -u)
protected_slugs=$( { printf '%s\n' "$current_slugs"; jq -r '.skipped_grace_slugs[] // empty' <<<"$report" 2>/dev/null; } | sort -u)

# --- observe-to-close (fleet-ops#2005) ------------------------------------
# Close auto-filed debug-playbook issues whose slug is no longer reported as a
# finding and is not currently in the grace period. The detector filed these;
# it closes them when the signal is clean on a real heartbeat tick.
closed=0
if [[ "$OK_TO_CLOSE" == "1" ]] && [[ "$FILE_ISSUES" == "1" ]] && command -v "$GH" >/dev/null 2>&1; then
    while IFS=$'\t' read -r num slug; do
        [[ -n "$num" && -n "$slug" ]] || continue
        if ! grep -qxF "$slug" <<<"$protected_slugs"; then
            ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
            comment="observe-to-close: signal: debug-playbook/${slug} no longer reported as a finding on heartbeat tick at $ts."
            set +e
            "$GH" issue close "$num" -R "$ISSUE_REPO" --comment "$comment" 2>/dev/null
            close_rc=$?
            set -e
            if [[ "$close_rc" -eq 0 ]]; then
                log "observe-to-close: CLOSED issue #$num (slug=$slug no longer in findings)"
                closed=$((closed + 1))
            else
                log "observe-to-close: failed to close issue #$num (rc=$close_rc)"
            fi
        fi
    done < <(printf '%s' "$open_json" | jq -r '
        .[] | .number as $n | (.body // "") as $b |
        select($b | contains("signal: debug-playbook/")) |
        (try ($b | capture("signal: debug-playbook/(?<slug>[^\\s`]+)") | .slug) catch null) as $slug |
        select($slug != null and $slug != "<slug>") |
        "\($n)\t\($slug)"
    ' 2>/dev/null)
fi

if [[ "$finding_count" == "0" ]]; then
    loud "DEBUG-PLAYBOOK-OK" "no missing debug playbooks in window (scanned=$scanned closed=$closed)"
    exit 0
fi

# --- cumulative cap: count open debug-playbook issues -----------------------
open_debug_count=$(printf '%s' "$open_json" | jq -r --arg prefix "signal: debug-playbook/" '
    [ .[] | select((.body // "") | contains($prefix)) ] | length
' 2>/dev/null)
open_debug_count="${open_debug_count:-0}"

filed=0
deferred=0
# fleet-ops#2726 (gap-audit): the cumulative cap is now AGE-BASED. The old
# hard ceiling (CUMULATIVE_CAP open issues total) silently dropped every
# finding past it — LOUD'd once, never filed, and lost when the session
# aged out of the scan window. The visible queue understated the debt and
# the loud-fail line could not size it. Effective cap = max(CUMULATIVE_CAP,
# findings still inside the scan window): every in-window finding is filed
# (paced by the per-tick CAP below), so the queue surfaces the debt and
# observe-to-close drains it as sessions age out. CUMULATIVE_CAP stays as
# the floor when the window is quiet.
eff_cap=$(( CUMULATIVE_CAP > finding_count ? CUMULATIVE_CAP : finding_count ))
while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    slug=$(jq -r '.slug' <<<"$row")
    snippet=$(jq -r '.snippet' <<<"$row")
    path=$(jq -r '.path' <<<"$row")
    attempts=$(jq -r '.attempts // "?"' <<<"$row")
    loud "DEBUG-PLAYBOOK-MISSING" "session=$slug attempts=$attempts path=$path snippet=$snippet"

    [[ "$FILE_ISSUES" == "1" ]] || continue
    if [[ "$filed" -ge "$CAP" ]]; then
        deferred=$((deferred + 1))
        continue
    fi
    # Cumulative cap across ticks: the effective cap grows to cover every
    # in-window finding (fleet-ops#2726), so this only binds at the floor.
    remaining=$((eff_cap - open_debug_count - filed))
    if [[ "$remaining" -le 0 ]]; then
        log "auto-file: cumulative cap reached (open=$open_debug_count dynamic-cap=$eff_cap); not filing $slug"
        continue
    fi
    command -v "$GH" >/dev/null 2>&1 || continue

    signal="signal: debug-playbook/${slug}"
    if printf '%s' "$open_json" | jq -e --arg s "$signal" \
        '[.[] | select((.body // "") | contains($s))] | length > 0' \
        >/dev/null 2>&1; then
        log "auto-file: $slug already open (deduped)"
        continue
    fi

    title="fix(debug-playbook): $slug — multi-attempt debug with no playbook note"
    body="The session-close lint (fleet-ops#522, standing rule: debugging sessions end with a playbook note) found a Pi session with two or more real failed attempts and no four-heading vault playbook (SIGNATURE / ROOT CAUSE / FIX THAT WORKED / DEAD ENDS).

- session: \`$path\`
- attempts: $attempts
- snippet: $snippet
- detector: bin/fleet-debug-playbook (heartbeat tier1)

Do not close until the detector reports this clean on a real heartbeat tick (observe-to-close).

$signal"
    set +e
    created=$("$GH" issue create -R "$ISSUE_REPO" --title "$title" --body "$body" 2>/dev/null)
    create_rc=$?
    set -e
    if [[ "$create_rc" -eq 0 && -n "$created" ]]; then
        log "auto-file: FILED $slug -> $created"
        filed=$((filed + 1))
    else
        log "auto-file: failed to file $slug (rc=$create_rc)"
    fi
done < <(jq -c '.findings[]' <<<"$report")

unfiled=$(( finding_count - open_debug_count - filed ))
[[ "$unfiled" -lt 0 ]] && unfiled=0
loud "DEBUG-PLAYBOOK-FAIL" "missing playbooks=$finding_count (filed=$filed deferred=$deferred debt=$unfiled dynamic-cap=$eff_cap) — a multi-attempt debug never filed the vault note; LOUD + auto-filed, observe-to-close, the queue carries the debt (fleet-ops#2726)"
exit 1
