# fleet-ops#8441: user slice kept at the #5935 caps. The fleet-ci runners
# are system units (svc.sh), not members of this slice. Each runner's cap is
# systemctl set-property MemoryMax=3G on
# actions.runner.Nishfleet.netcup-fleet-ci-{1,2,3}.service.
# Drop-in-removable: delete this file and daemon-reload. The live file is a
# symlink into this repo.
[Slice]
MemoryHigh=7G
MemoryMax=9G
CPUWeight=80
