[Unit]
Description=Fleet resilience drill — eleven planes (fleet-ops#455 + #1463)
# Named reason for this schedule (vault: "a schedule needs a named reason"):
# untested redundancy is false confidence. The original four planes (dead
# heartbeat restart policy, public SSH, stale restore drill, missing
# break-glass runbook) plus the five #1463 failure-class planes (queue_freeze,
# pipeline_red, boundary_delivery, band_floor, event_trigger_spot) are all
# silent without a periodic proof. Daily is faster than a silent week and
# slower than the 30-minute heartbeat. 05:47 is off the :00/:17 cluster.
#
# OnFailure is wired by the global service.d/10-escalate.conf drop-in.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=FLEET_RES_DRILL_PROM_FILE=/var/lib/prometheus/node-exporter/fleet-resilience-drill.prom
WorkingDirectory=/home/nish
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/fleet-resilience-drill'
TimeoutStartSec=3min
Restart=no
