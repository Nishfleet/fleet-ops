# Wake claude-vps when an Agent Tincan teammate (claude-mac, hermes) sends it a
# request. Before this, claude-vps had wake=none: a request sat queued until a
# person happened to open a VPS Claude session that checked its inbox.
#
# Stock only, no glue: `tincan listen --exec` is the vendor's own wake for
# agents without channels (tincan onboard, "Fallback without channels"). It
# long-polls the relay and runs one headless `claude -p` that drains the inbox;
# nothing is claimed until that session calls check_inbox. Each run loads the
# agent-tincan MCP entry from config/tincan-listener-mcp.json in the deploy clone (TINCAN_CONFIG=claude-vps).
#
# Install (after merge, from the deploy clone):
#   systemctl --user link   /home/nish/workspaces/tooling/fleet-ops-deploy-clone/systemd/tincan-listen-claude-vps.service
#   systemctl --user enable --now tincan-listen-claude-vps.service
# Model: pinned to Sonnet (fleet-ops#9407) because Opus burned the weekly limit. Edit --model to change it.
# Switch off: systemctl --user disable --now tincan-listen-claude-vps.service
#   (requests to claude-vps then queue again until a session checks its inbox).
# Delete: switch off, `systemctl --user unlink tincan-listen-claude-vps.service`,
#   then delete this file in a PR.
[Unit]
Description=Agent Tincan wake for claude-vps (tincan listen -> claude -p drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service

[Service]
Environment=TINCAN_CONFIG=/home/nish/.config/tincan/claude-vps.json
Environment=FLEET_TASK_ID=tincan-claude-vps
# Not /home/nish: with cwd=/home/nish the "project" settings source is /home/nish/.claude/settings.json, which is the user
# settings file, so --setting-sources project,local still loaded the user Stop agent hook and the user-enabled plugins
# (real run, fleet-ops#9444 review B1). A dedicated dir has no .claude/, so only managed settings apply. StateDirectory
# makes systemd create it (~/.local/state/tincan-listen-claude-vps) before WorkingDirectory is entered.
StateDirectory=tincan-listen-claude-vps
WorkingDirectory=%S/tincan-listen-claude-vps
# Start-up trim (fleet-ops perf/trim-headless-claude): measured on this VPS from /tmp, "Reply with the single word OK",
# cold cache: untrimmed 51,407 input tokens, $0.334 per run; trimmed 36,440 tokens, $0.146 per run (-29% tokens, -56% cost).
# The flags load only agent-tincan (--mcp-config before --strict-mcp-config: the list is variadic and eats the prompt),
# no skills, and no user settings (drops the user Stop agent hook, user plugins and ~/.claude/CLAUDE.md).
# Managed settings still apply: model-lanes gate and secret-read denies. Off switch: remove the four flags
# --mcp-config <file> --strict-mcp-config --disable-slash-commands --setting-sources project,local.
# Permissions (fleet-ops#9502): --permission-mode dontAsk plus --settings
# /etc/claude-code/roles/tincan-listener.json (installed by ansible/host.yml). bypassPermissions skipped
# every permissions.ask rule. dontAsk denies a call that would have prompted (nobody is here to answer).
# Denials show in the journal and in ~/.claude/projects/-home-nish--local-state-tincan-listen-claude-vps/<id>.jsonl.
# Roll back: put --permission-mode bypassPermissions back on ExecStart and restart the unit.
# Replies are skipped (fleet-ops: reply wakes re-did work, 142 turns / ~$10 on 2026-10-08).
# Usage wall (Nish: "work spills over to the other account automatically"): the drop-in 10-nish-seat.conf puts this
# listener on seat a (CLAUDE_CONFIG_DIR). When the run exits non-zero AND its last 3 lines match config/claude-wall.re (the
# fleet's one list of usage-wall texts; the CLI prints the wall on stdout and exits 1), the same prompt runs once more with
# CLAUDE_CONFIG_DIR unset, the default login (seat b). Not a plain `||`: that would also rerun after --max-turns or any other
# failure, doubling the cost and repeating side effects. A wall normally stops the run at its first call, but it can land mid-run, so the
# rerun is not fully safe: c() takes an extra sentence, and the rerun's prompt tells the session to check whether a request's work is already done first. The command is defined once as c() and called twice, so the trim flags and prompt cannot differ
# between the first try and the fallback (ci.yml checks both calls). Output is captured to a temp file and printed, so the
# journal still has it. In this file $$ is a literal $ and %% a literal % (systemd), and %h is the home directory, so the shell sees $o, $rc and $?.
ExecStart=%h/.local/bin/tincan listen --exec 'c() { %h/.local/bin/claude -p --model claude-sonnet-5-5 --permission-mode dontAsk --settings /etc/claude-code/roles/tincan-listener.json --mcp-config %h/workspaces/tooling/fleet-ops-deploy-clone/config/tincan-listener-mcp.json --strict-mcp-config --disable-slash-commands --setting-sources project,local --max-turns 30 "You are claude-vps on the Agent Tincan team, woken because requests or replies are waiting. Call check_inbox once. Replies to earlier requests belong to the session that sent them, which reads them itself, so do not act on, summarise or report replies. If check_inbox returned no requests, stop now with no further tool calls. Handle each request as you would one from Nish and answer it with reply, then call check_inbox again until it returns no requests, then stop.$${1:+ $$1}"; }; o=$$(mktemp); trap "rm -f $$o" EXIT; c >$$o 2>&1; rc=$$?; cat $$o; [ $$rc = 0 ] && exit 0; tail -n 3 $$o | grep -qiEf %h/workspaces/tooling/fleet-ops-deploy-clone/config/claude-wall.re || exit $$rc; echo "claude listener: seat=a -> b (usage limit)"; (unset CLAUDE_CONFIG_DIR; c "An earlier run stopped at a usage limit, possibly part-way through a request. Before you act on a request, check whether its work is already done.")'
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
