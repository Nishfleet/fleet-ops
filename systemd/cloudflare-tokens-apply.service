# Renews the per-repo Cloudflare tokens (infra/cloudflare-tokens/). OpenTofu
# replaces a token only when `tofu apply` runs: a time_rotating resource makes
# a new one after 30 days and the old one expires at 45 days, so without a
# scheduled apply every deploy secret goes dead. This oneshot is that apply;
# cloudflare-tokens-apply.timer starts it weekly.
#
# Runs from /var/lib/fleet-ops/repo, the root-owned checkout ansible-pull
# deploys from main, never from a worktree. That tree is read-only here, so the
# provider cache goes to TF_DATA_DIR under ~/.cache (not in restic, rebuilt by
# init) instead of infra/cloudflare-tokens/.terraform.
#
# State: the backend path in infra/cloudflare-tokens/versions.tf, the local file
# /home/nish/.local/state/fleet-ops/cloudflare-tokens/terraform.tfstate. This
# unit sets no state path of its own, so it cannot drift from that block.
#
# Credentials: the Cloudflare minter token comes from EnvironmentFile (never
# argv, never GitHub). GitHub secrets are written by the nishfleet-secrets App
# (see the ExecStart below), which can write secrets on the listed repos and nothing else.
#
# Addresses: the VPS token (`vps-grafana`) is IP-locked to this host, and
# `vps_cidrs` defaults to [] because the addresses are not kept in git
# (infra/cloudflare-tokens/variables.tf). Every tofu run therefore reads them
# from the gitignored %h/.config/cloudflare/vps-cidrs.tfvars, which holds one
# line -- vps_cidrs = ["<ipv4>/32", "<ipv6>/128"], from `curl -4 -s
# ifconfig.me` and `curl -6 -s ifconfig.me`. A tfvars file rather than an
# EnvironmentFile because the value is HCL (a quoted list), and an env file
# would put a second quoting layer in front of it.
#
# Failure is loud: OnFailure= fires the healthchecks.io fail ping
# (fleet-unit-failed@.service, fleet-ops#9033), and `systemctl --user
# list-units --state=failed` shows the unit.
[Unit]
Description=Renew the per-repo Cloudflare tokens (tofu apply)
After=network-online.target
Wants=network-online.target
# A missing address file fails the unit (AssertPathExists=, not
# ConditionPathExists=), so the apply does not run on a stale file.
AssertPathExists=%h/.config/cloudflare/vps-cidrs.tfvars

[Service]
# Address freshness (fleet-ops#10969): nothing else compares the tfvars file
# with the host's current egress address, so an address change left the weekly
# apply succeeding with a token locked to dead addresses, and Grafana's
# cloudflare-spend rules failed while the renewal stayed green. This check
# compares the file with the addresses it egresses right now (the README
# documents these sources) and fails the whole unit, before tofu runs, when a
# current address is not in the file. OnFailure= then fires the healthchecks
# fail ping as any other apply failure. When it fails, refresh the file in the
# one command the README documents and start the unit again.
# Fetch the current egress addresses into the unit's private runtime directory
# and match the quoted address tokens in the tfvars file. Each command is a
# stock tool; a nonzero exit (curl failure, empty body, no match) fails the unit
# before tofu runs, which is the fail-closed check fleet-ops#10969 added. The
# README has the one-command refresh for the file.
RuntimeDirectory=cloudflare-tokens-apply
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/curl -4 -fsS --max-time 15 --retry 2 -o %t/cloudflare-tokens-apply/v4 https://ifconfig.me
ExecStartPre=/usr/bin/curl -6 -fsS --max-time 15 --retry 2 -o %t/cloudflare-tokens-apply/v6 https://ifconfig.me
# An empty 200 body would make grep -f match everything; require a line first.
ExecStartPre=/usr/bin/grep -q . %t/cloudflare-tokens-apply/v4
ExecStartPre=/usr/bin/grep -q . %t/cloudflare-tokens-apply/v6
ExecStartPre=/usr/bin/sed -i -e 's|^|"|' -e 's|$|/32"|' %t/cloudflare-tokens-apply/v4
ExecStartPre=/usr/bin/sed -i -e 's|^|"|' -e 's|$|/128"|' %t/cloudflare-tokens-apply/v6
ExecStartPre=/usr/bin/grep -qF -f %t/cloudflare-tokens-apply/v4 %h/.config/cloudflare/vps-cidrs.tfvars
ExecStartPre=/usr/bin/grep -qF -f %t/cloudflare-tokens-apply/v6 %h/.config/cloudflare/vps-cidrs.tfvars
Type=oneshot
WorkingDirectory=/var/lib/fleet-ops/repo
EnvironmentFile=%h/.config/cloudflare/token-minter.env
# State encryption (infra/cloudflare-tokens/README.md, "State encryption"): the
# OpenTofu state holds each token it minted, so once this file exists the state
# is written encrypted. The "-" makes the file optional, so nothing changes until
# it is placed; the key never goes in this unit, in argv or in the repo.
EnvironmentFile=-%h/.config/cloudflare/tofu-state-encryption.env
# The App key is a systemd credential, not a path in the environment or argv.
# The Terraform provider's pem_file takes the contents, so variables.tf passes
# the credential path and versions.tf reads it with file().
LoadCredential=nishfleet-secrets.pem:%h/.config/cloudflare/nishfleet-secrets.private-key.pem
Environment=TF_VAR_github_app_pem_file=%d/nishfleet-secrets.pem
Environment=TF_DATA_DIR=%h/.cache/fleet-ops/cloudflare-tokens-tofu
Environment=TF_IN_AUTOMATION=1
ExecStartPre=%h/.local/bin/tofu -chdir=infra/cloudflare-tokens init -input=false
# GitHub: the nishfleet-secrets App, not the owner's personal login (fleet-ops#10601).
# The key file is 0600 in a 0700 directory; LoadCredential= copies it to this
# unit's private credential directory, so the key is never in the environment or
# argv, and the provider reads the contents with file().
ExecStart=%h/.local/bin/tofu -chdir=infra/cloudflare-tokens apply -auto-approve -input=false -var-file=%h/.config/cloudflare/vps-cidrs.tfvars
# Grafana does not read deploy-ci.env: it mounts a copy of it as the
# grafana-cloudflare-api-token Podman secret (containers/quadlet/
# fleet-grafana.container), and ansible/tasks/secrets.yml refreshes that copy on
# a host-config run. A rotation here would otherwise leave Grafana holding the
# token this apply just deleted until the next host-config run, and the
# Cloudflare spend watch (fleet-ops#9355) would read nothing meanwhile. There is
# no host-config timer (deploy-box.yml starts fleet-host-config.service only on a
# push to main, or at boot), so the window has no other bound. So the apply asks
# that existing writer to run rather than writing the secret a second time: it
# already reads this file, trims the value, replaces the secret only when it
# differs and restarts Grafana. polkit grants nish `start` on that unit and
# nothing else (rootfs/etc/polkit-1/rules.d/50-fleet-host-config.rules), and
# --no-block keeps a long playbook from holding this oneshot.
ExecStartPost=/usr/bin/systemctl start --no-block fleet-host-config.service
TimeoutStartSec=900
UMask=0077
