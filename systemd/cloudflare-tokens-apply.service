# Renews the per-repo Cloudflare tokens (infra/cloudflare-tokens/). OpenTofu
# replaces a token only when `tofu apply` runs: a time_rotating resource makes
# a new one after 30 days and the old one expires at 45 days, so without a
# scheduled apply every deploy secret goes dead. This oneshot is that apply;
# cloudflare-tokens-apply.timer starts it weekly.
#
# Runs from the deploy clone (the stable install tree, AGENTS.md "Machine
# wiring"), never from a worktree. The deploy clone must stay clean, so the
# provider cache goes to TF_DATA_DIR under ~/.cache (not in restic, rebuilt by
# init) instead of infra/cloudflare-tokens/.terraform.
#
# State: the backend path in infra/cloudflare-tokens/versions.tf, the local file
# /home/nish/.local/state/fleet-ops/cloudflare-tokens/terraform.tfstate. This
# unit sets no state path of its own, so it cannot drift from that block.
#
# Credentials: the Cloudflare minter token comes from EnvironmentFile (never
# argv, never GitHub). GitHub secrets are written by the nishfleet-secrets App
# (see the ExecStart below), which can write secrets on the listed repos and nothing else.
#
# Addresses: the VPS token (`vps-grafana`) is IP-locked to this host, and
# `vps_cidrs` defaults to [] because the addresses are not kept in git
# (infra/cloudflare-tokens/variables.tf). Every tofu run therefore reads them
# from the gitignored %h/.config/cloudflare/vps-cidrs.tfvars, which holds one
# line -- vps_cidrs = ["<ipv4>/32", "<ipv6>/128"], from `curl -4 -s
# ifconfig.me` and `curl -6 -s ifconfig.me`. A tfvars file rather than an
# EnvironmentFile because the value is HCL (a quoted list), and an env file
# would put a second quoting layer in front of it.
#
# Failure is loud: OnFailure= fires the healthchecks.io fail ping
# (fleet-unit-failed@.service, fleet-ops#9033), and `systemctl --user
# list-units --state=failed` shows the unit.
[Unit]
Description=Renew the per-repo Cloudflare tokens (tofu apply)
After=network-online.target
Wants=network-online.target
OnFailure=fleet-unit-failed@%N.service

[Service]
Type=oneshot
WorkingDirectory=/home/nish/workspaces/tooling/fleet-ops-deploy-clone
EnvironmentFile=%h/.config/cloudflare/token-minter.env
# State encryption (infra/cloudflare-tokens/README.md, "State encryption"): the
# OpenTofu state holds each token it minted, so once this file exists the state
# is written encrypted. The "-" makes the file optional, so nothing changes until
# it is placed; the key never goes in this unit, in argv or in the repo.
EnvironmentFile=-%h/.config/cloudflare/tofu-state-encryption.env
Environment=TF_DATA_DIR=%h/.cache/fleet-ops/cloudflare-tokens-tofu
Environment=TF_IN_AUTOMATION=1
ExecStartPre=/bin/sh -c 'test -s %h/.config/cloudflare/vps-cidrs.tfvars || { echo "cloudflare-tokens-apply: missing %h/.config/cloudflare/vps-cidrs.tfvars (vps_cidrs; see infra/cloudflare-tokens/README.md, VPS-only tokens). Without it the plan fails closed and no token rotates." >&2; exit 1; }'
ExecStartPre=%h/.local/bin/tofu -chdir=infra/cloudflare-tokens init -input=false
# GitHub: the nishfleet-secrets App, not the owner's personal login (fleet-ops#10601). The key file is 0600 in a
# 0700 directory; its contents go to the provider through the environment of this one process only.
ExecStart=/bin/sh -c 'TF_VAR_github_app_pem=$$(cat %h/.config/cloudflare/nishfleet-secrets.private-key.pem) && export TF_VAR_github_app_pem && exec %h/.local/bin/tofu -chdir=infra/cloudflare-tokens apply -auto-approve -input=false -var-file=%h/.config/cloudflare/vps-cidrs.tfvars'
# Grafana does not read deploy-ci.env: it mounts a copy of it as the
# grafana-cloudflare-api-token Podman secret (containers/quadlet/
# fleet-grafana.container), and ansible/tasks/secrets.yml is the only other
# thing that refreshes that copy, on a host-config run. A rotation here would
# otherwise leave Grafana holding the token this apply just deleted until the
# next host-config run, and the Cloudflare spend watch (fleet-ops#9355) would
# read nothing meanwhile. So the apply republishes it itself: the value goes to
# podman on stdin, never argv, and Grafana restarts only when it changed. There
# is no host-config timer (deploy-box.yml starts fleet-host-config.service only
# on a push to main, or at boot), so the window has no other bound. Two systemd
# details: the format is %%s, because %s is a specifier for the user's shell,
# and printf takes no path, because an external printf would put the value in
# its argv and /proc/<pid>/cmdline is world-readable.
ExecStartPost=/bin/sh -c 'set -e; f=%h/.config/cloudflare/deploy-ci.env; test -s "$$f"; new=$$(/usr/bin/sed -n "s/^CLOUDFLARE_API_TOKEN=//p" "$$f"); test -n "$$new"; if /usr/bin/podman secret inspect grafana-cloudflare-api-token >/dev/null 2>&1; then if test "$$new" = "$$(/usr/bin/podman secret inspect --showsecret --format "{{.SecretData}}" grafana-cloudflare-api-token)"; then /usr/bin/systemctl --user is-active --quiet fleet-grafana.service || exec /usr/bin/systemctl --user restart fleet-grafana.service; exit 0; fi; set -- --replace; fi; printf %%s "$$new" | /usr/bin/podman secret create "$$@" grafana-cloudflare-api-token -; exec /usr/bin/systemctl --user restart fleet-grafana.service'
TimeoutStartSec=900
UMask=0077
