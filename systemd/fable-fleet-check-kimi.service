[Unit]
Description=Hourly fleet judge, third POV on Kimi K3 max via pi --provider cursor --model kimi-k3-max (Nish 2026-09-08 fleet-ops#4455: kimi is judge/orchestrator ONLY, draws the Ultra 'Other Models' $400/month bucket) — same fable-check packet as fable-fleet-check.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
# fleet-ops#6252: scratch cwd under agent-state, never a deploy checkout.
Environment=WORKDIR=/home/nish/workspaces/agent-state/fable-check
Environment=LOG_DIR=/home/nish/workspaces/agent-state/cron-output
WorkingDirectory=-/home/nish/workspaces/agent-state/fable-check
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HERMES_OUTBOUND_CLASSES=MONEY-BOUNDARY|LEGAL-BOUNDARY|PRODUCT-DIRECTION|CUSTOMER-DATA|CREDENTIAL-BOUNDARY|ONE-SHOT-PUBLIC-ACTION|daily-digest|weekly-digest|evening-highlights-digest|fable-check|fleet-landing-watch
# Dedicated Kimi K3 judge POV (fleet-ops#4455). Runs the shared fable-check
# packet on stdin through the existing cursor provider (cursor-cli) pinned to
# kimi-k3-max, then writes a seat-tagged report to LOG_DIR in the same shape
# agent-cron-run emits (# slug / seat= provider/model workdir= / body) so the
# landing-watch measure.sh digest parser counts it. seat= is stamped AFTER the
# prompt body so prompt-cache hits survive across ticks. rc=124 is timeout's
# own hang-watchdog exit (pi wedged) — it still records the report.
ExecStartPre=/usr/bin/mkdir -p /home/nish/workspaces/agent-state/fable-check
ExecStart=/bin/bash -c 'ts=$(date -u +%Y-%m-%dT%H-%M-%SZ); d=/home/nish/workspaces/agent-state/cron-output; o="$d/fable-fleet-check-kimi-$(date -u +%Y-%m-%d).md"; out=$(mktemp); err=$(mktemp); { printf "\n---\nrun_ts=%s seat=cursor/kimi-k3-max provider=cursor model=kimi-k3-max\n" "$ts"; cat /home/nish/workspaces/agent-state/fleet-landing-watch/fable-check.md; } | /home/nish/.local/bin/pi --print --provider cursor --model kimi-k3-max >"$out" 2>"$err" || { echo "fable-fleet-check-kimi: pi exit $? on cursor/kimi-k3-max (124=hang watchdog); report still recorded" >>"$err"; }; { printf "# fable-fleet-check-kimi %s\nseat=cursor/kimi-k3-max workdir=%s\n" "$ts" "$WORKDIR"; cat "$out"; printf "\n"; } >>"$o"; cat "$err" >&2; rm -f "$out" "$err"'
Restart=on-failure
RestartSec=900
# fleet-ops#4906: three judges on 20-min offsets (:00 :20 :40 UTC) with a 19-min
# cap can never overlap. Type=oneshot ignores RuntimeMaxSec (systemd-analyze
# verify says so); TimeoutStartSec is the oneshot cap. MemoryMax keeps a judge
# from competing with workers.
TimeoutStartSec=19min
MemoryMax=2500M
# fleet-ops#4906 handoff: a judge killed at the cap could not run pause-safely; systemd
# appends the marker so the next judge inherits ~/.claude/resume-notes/fleet-judge.md.
# No "%" in this line on purpose: %s/%N are systemd specifiers (drill 2026-09-10 proved it).
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || echo "- $(date -u --iso-8601=seconds) fable-fleet-check-kimi ended $SERVICE_RESULT (exit $EXIT_CODE/$EXIT_STATUS) before finishing its pause-safely handoff: pick up from the last checked item above." >> /home/nish/.claude/resume-notes/fleet-judge.md'
