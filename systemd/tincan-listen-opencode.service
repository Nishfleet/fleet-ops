[Unit]
Description=Agent Tincan wake for opencode (tincan listen -> headless agent drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
# A crash loop must reach `failed` for the hook above to run: the default
# 5 starts in 10 s is never spent at RestartSec=30 (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Environment=TINCAN_CONFIG=%h/.config/tincan/opencode.json
Environment=FLEET_TASK_ID=tincan-opencode
# OpenCode seat keys expired 2026-10-22; route through the fleet LiteLLM proxy instead.
# The key in there is this lane's own virtual key: worker-cheap only, with a daily spend cap and a
# rate limit, revoked with /key/delete. It is named LITELLM_MASTER_KEY because that is the variable the
# lane's opencode config reads, as inish-daily binds its per-run key (fleet-ops#9634); the proxy's admin
# key is not in this unit's environment (fleet-ops#10221).
EnvironmentFile=%h/.config/fleet-ops/seats/tincan-opencode.env
Environment=OPENCODE_CONFIG=%h/.config/tincan/opencode-litellm.jsonc
StateDirectory=tincan-listen-opencode
WorkingDirectory=%S/tincan-listen-opencode
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/opencode run -m litellm/worker-cheap "$$(cat /home/nish/.config/tincan/prompts/opencode.txt)"'
Restart=always
RestartSec=30
[Install]
WantedBy=default.target
