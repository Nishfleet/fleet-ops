[Unit]
Description=Executor MCP hub (executor.sh) - loopback only
After=network-online.target
# A crash loop must reach `failed`, which only the user-manager failed list
# (`systemctl --user list-units --state=failed`) reads: no OnFailure= hook, and
# the node_systemd_unit_state gauge reads system units only. The default 5
# starts in 10 s is never spent at RestartSec=5 (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Environment=PATH=/home/nish/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=EXECUTOR_PORT=4312
Environment=EXECUTOR_DATA_DIR=/home/nish/.executor/v2/cli
Environment=EXECUTOR_KEY_STORAGE=file
Environment=EXECUTOR_NO_UPDATE_CHECK=1
Environment=DO_NOT_TRACK=1
ExecStart=/home/nish/.nvm/versions/node/v24.21.0/bin/executor serve
Restart=on-failure
RestartSec=5
MemoryMax=2G
# The hub grows to the 2G cap in about 21h (OOM kills 2026-10-26 16:16 and 2026-10-27 13:38 IST, fleet-ops#10433). A planned restart at 12h comes first, so the OOMKill alert stays quiet.
RuntimeMaxSec=12h
# Without a swap cap the 2G RAM cap spills into the shared 8G swap (4.19G held 2026-10-15, swap full).
MemorySwapMax=512M
UMask=0077

[Install]
WantedBy=default.target
