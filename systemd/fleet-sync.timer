[Unit]
Description=Fleet deploy-clone sync timer (every 2 min, fleet-ops third cut)
# Same cadence as the fleet-deploy-check.timer it replaces, so merge->live
# latency is unchanged: a merged commit reaches the live box within ~2-3 min,
# inside the 5-minute TOP GEAR budget.
# OnCalendar=*:00/2 fires on even minutes — avoids the heartbeat (:17/:47)
# and intake-reconcile (:00/:30) clusters.

[Timer]
OnCalendar=*:00/2
RandomizedDelaySec=30
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
