[Unit]
Description=Mint the nishfleet-worker App token into a runtime env file
# fleet-ops#8057 (docs/GLUE-ZERO.md organ 12). One sh -c: printf plus gh token generate.
# Worker units read /run/user/%U/fleet-gh-token.env. An empty GH_TOKEN is a hard stop (#8092).

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/bin/sh -c 'printf "GH_TOKEN=%%s\n" "$(gh token generate --app-id 4728578 --key /home/nish/.config/fleet-worker/nishfleet-worker.private-key.pem --installation-id 156789042 --token-only)" > /run/user/%U/fleet-gh-token.env'
