[Unit]
Description=Fleet Console (Pi) — generate live truth and push to KV
# Replaces the deleted fleet1 console pusher. No hand-built orchestration:
# systemd owns restart/backoff. TimeoutStartSec bounds a hung gh/wrangler call
# (RuntimeMaxSec has no effect on Type=oneshot — systemd ignores it there).
# fleet-ops#1460: the .path unit (fleet-console-pi.path) can fire rapidly
# — the metrics exporter writes fleet.prom atomically (replace-by-rename),
# generating multiple inotify events. The default 5/10s burst is blown
# through, wedging the service (same wedge as fleet-seat-recovery #617).
# The push is idempotent; raise the limit so an export cannot wedge the
# fast path. StartLimit* must live in [Unit].
StartLimitIntervalSec=1h
StartLimitBurst=100

[Service]
Type=oneshot
# bash -c wrapper is the P14 systemd-analyze dodge (fleet-resilience-drill):
# the hosted runner does not have ~/.local/libexec. No new timer: this is
# the existing 12-min push cycle; verify.py runs inside push.sh.
ExecStart=/bin/bash -c 'exec /home/nish/.local/libexec/fleet-console-pi/push.sh'
Restart=on-failure
RestartSec=10s
TimeoutStartSec=180s
Environment=CF_ENV=/home/nish/.config/fleet-console/cf.env

[Install]
WantedBy=default.target
