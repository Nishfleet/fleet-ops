[Unit]
Description=Mint the short-lived GitHub App token Grafana's alert webhook sends (fleet-ops#9445)
# Grafana's webhook contact point can send only a static Authorization value
# (Grafana docs, "Configure the webhook notifier"; no OAuth2 refresh, no
# command or file hook) and GitHub has no token for a service that lives longer
# than the App's one-hour installation token (REST docs, "Create an
# installation access token for an app"). The contact points in
# config/grafana/provisioning/alerting/cloudflare-spend-contact.yaml therefore
# read `$__file{/run/secrets/github-token/token}`, which Grafana expands each
# time provisioning loads, and this oneshot (fired every 20 min by
# fleet-grafana-github-token.timer) writes a fresh token there and makes Grafana
# reload it when the loaded token has run down. The reload is Grafana's admin API
# POST /api/admin/provisioning/alerting/reload (Grafana HTTP API docs, "Admin
# API"), the call the deleted fleet-grafana-provisioning.service made.
#
# The token is minted from the nishfleet-worker App key that fleet-grafana
# already mounts, scoped by the request body to issues:write on this one repo
# (the contact points only POST issues). It lives in the user runtime dir
# (tmpfs, mode 0700), never on disk and never in argv: the SDK holds the key
# and the JWT in its own process and writes the token to the runtime file. A
# failed mint keeps the previous token file, pages through OnFailure=, and
# Grafana's own delivery rule (cloudflare-spend-delivery.yaml) pages
# hermes-urgent if a webhook still fails.
#
# Switch off: `systemctl --user disable --now fleet-grafana-github-token.timer`
# and `systemctl --user mask fleet-grafana-github-token.service` (fleet-grafana
# Wants= it, so without the mask it still mints once per Grafana start).
# The contact points then send an empty token and the webhook answers 401; the
# delivery rule pages hermes-urgent and spend and dead-row alerts still reach
# Telegram.

[Service]
Type=oneshot
RuntimeDirectory=fleet-grafana-github-token
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
# GITHUB_API_URL lets a test point this ExecStart at a local stub
# (tests/github_app_stub.py); the host never overrides it.
Environment=GITHUB_API_URL=https://api.github.com
Environment=APP_ID=4728578
Environment=APP_KEY=%h/.config/fleet-worker/nishfleet-worker.private-key.pem
# Grafana expands $__file{} at load and a missing file fails the whole
# alerting provisioning, so the file must exist before anything can fail.
ExecStartPre=/usr/bin/touch -a %t/fleet-grafana-github-token/token
# GitHub's Octokit SDK (@octokit/auth-app, pinned by
# config/github-app-token/package-lock.json) signs the App JWT and mints a
# token limited to this repo and issues:write, so this unit carries no crypto
# of its own (docs: "Generating an installation access token for a GitHub
# App", "use GitHub's Octokit SDKs"). The SDK writes the token to the file and
# keeps the key and the JWT in its own process; no shell sees either.
Environment=MINT=%h/.local/share/github-app-token/mint.mjs
Environment='TOKEN_PERMISSIONS={"issues":"write"}'
Environment=TOKEN_REPOSITORIES=fleet-ops
Environment=GH_TOKEN_FILE=%t/fleet-grafana-github-token/token
Environment=GH_LOADED_FILE=%t/fleet-grafana-github-token/provisioned-token-mint
Environment=GH_RELOAD=1
Environment=GH_ADMIN_PASSWORD_FILE=%h/.config/fleet-ops/grafana-admin-password
Environment=GH_RELOAD_URL=http://127.0.0.1:3001/api/admin/provisioning/alerting/reload
# Grafana drops an in-flight dispatch when a reload applies a new configuration,
# and all three observed one-off notifications failures align with an apply or
# restart (fleet-ops#11426: 13:15:56Z apply and the 21:26Z restart, 2026-10-29;
# fleet-ops#11441: the 14:37:27Z apply from this very mint, 2026-10-31). The
# minter therefore reloads only when the token Grafana loaded (its `$__file{}`
# is frozen at load) is 40 minutes old: one mint interval of slack, so a healthy
# cadence reloads at every second mint instead of every mint. The ledger holds
# the mtime of the token at the last reload; a missing or non-numeric ledger,
# as after a boot, means reload. A reload whose ledger write fails (say, the
# tmpfs is gone mid-run) reloads again at the next mint: an extra reload costs
# one more in-flight dispatch, never a lost delivery. A stopped Grafana is
# skipped (the next start reads the fresh file); a real HTTP failure fails this
# unit and shows in systemctl --failed.
ExecStart=/opt/node-v22.23.3/bin/node ${MINT}
TimeoutStartSec=300
