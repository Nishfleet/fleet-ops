[Unit]
Description=Fleet merge-to-live deploy check timer (every 2 min, fleet-ops#468)

# TOP GEAR: merge->live <= 5 minutes. A 2-minute check cadence gives a
# merged commit a worst-case ~2-3 min to reach the live box, comfortably
# inside the 5-minute budget even with a deploy taking ~1 min. The check
# itself is seconds (fetch + rev compare); deploy only runs on a moved
# origin/main, so this is event-driven, not a busy poller.
# OnCalendar=*:00/2 fires on even minutes. Avoids colliding with the
# heartbeat (:17/:47) and the intake reconcile (:00/:30) cluster.

[Timer]
OnCalendar=*:00/2
RandomizedDelaySec=30
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
