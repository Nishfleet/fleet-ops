[Unit]
Description=Reap stale claim after Pi issue worker %i exhausts its retry policy

[Service]
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/nish
WorkingDirectory=/home/nish
ExecStart=/home/nish/.local/bin/pi-issue-failed-reap %i
# Glue sweep 2026-09-18: clear the worker's per-instance drop-in dir once the
# retry ladder is exhausted. pi-issue@.service clears it on success; this is
# the terminal-failure half, so no orphan *.d dir can survive either exit.
ExecStopPost=-/bin/sh -c 'rm -rf "$$HOME/.config/systemd/user/pi-issue@%i.service.d"'
# This is not a scheduler/dispatcher: it is the OnFailure= cleanup path of
# pi-issue@.service. It only runs after the worker has failed for good.
TimeoutStartSec=120
