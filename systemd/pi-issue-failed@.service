[Unit]
Description=Release the claim after Pi issue worker %i exhausts its retry policy

[Service]
# OnFailure= path of pi-issue@.service. Releasing a claim is two GitHub calls:
# drop the claim branch, flip the label back to agent-ready so the next intake
# tick can re-dispatch. The old bin/pi-issue-failed-reap was 632 lines of
# re-claim accounting, cooldown ledgers and packet archiving around these two
# calls; none of that survives the rule that only issue->PR->deploy is
# load-bearing. A failed release is not fatal — the issue simply stays
# agent-in-progress until the next failure or a human looks.
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/nish
WorkingDirectory=/home/nish
# fleet-ops#7776: a tools=0 (no-tools) verdict is a seat wall, not a packet
# strike — do not release or relabel. The claim branch stays so the same
# unit resumes re-entrantly when the wall lifts. The extension's counter
# prints the verdict as the run's last line, so the LAST PACKET-VERDICT in
# the journal is the real one (model-forged lookalikes land earlier).
ExecStart=/bin/sh -c 'i="$1"; if python3 "$HOME/.local/lib/pi-packet/pi-packet-verdict.py" --no-tools-unit "pi-issue@$i.service"; then echo "no-tools run — claim kept for Nishfleet issue $i (seat wall, fleet-ops#7776)"; exit 0; fi; r=$(echo "$i" | sed "s/-[0-9][0-9]*$//"); n=$(echo "$i" | sed "s/.*-//"); eval "$(worker-token --print)"; export GH_TOKEN; gh api -X DELETE "repos/Nishfleet/$r/git/refs/heads/claim/issue-$n" >/dev/null 2>&1 || true; gh issue edit "$n" -R "Nishfleet/$r" --remove-label agent-in-progress --add-label agent-ready || true; echo "released claim Nishfleet/$r#$n"' sh %i
TimeoutStartSec=120
