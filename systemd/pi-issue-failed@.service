[Unit]
Description=Release the claim after Pi issue worker %i exhausts its retry policy

[Service]
# OnFailure= path of pi-issue@.service. Releasing a claim is two GitHub calls:
# drop the claim branch, flip the label back to agent-ready so the next intake
# tick can re-dispatch. The old bin/pi-issue-failed-reap was 632 lines of
# re-claim accounting, cooldown ledgers and packet archiving around these two
# calls; none of that survives the rule that only issue->PR->deploy is
# load-bearing. A failed release is not fatal — the issue simply stays
# agent-in-progress until the next failure or a human looks.
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/nish
WorkingDirectory=/home/nish
ExecStart=/bin/sh -c 'i="$1"; r=$(echo "$i" | sed "s/-[0-9][0-9]*$//"); n=$(echo "$i" | sed "s/.*-//"); GH_TOKEN=$(gh token generate --app-id 4728578 --key "$HOME/.config/fleet-worker/nishfleet-worker.private-key.pem" --installation-id 156789042 --token-only); export GH_TOKEN; gh api -X DELETE "repos/Nishfleet/$r/git/refs/heads/claim/issue-$n" >/dev/null 2>&1 || true; gh issue edit "$n" -R "Nishfleet/$r" --remove-label agent-in-progress --add-label agent-ready || true; echo "released claim Nishfleet/$r#$n"' sh %i
TimeoutStartSec=120
