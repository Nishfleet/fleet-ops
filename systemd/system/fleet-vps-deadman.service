# VPS dead-man ping to healthchecks.io. Repo source of truth for the live
# healthcheck unit on this box, renamed for what it does (packet
# fleet-ops#8490, parent #8435). Additive only; the cutover child installs it
# and drives it with fleet-vps-deadman.timer.
#
# The check URL / check UUID never lives in this file. systemd expands $HC_URL
# from the EnvironmentFile at start; the cutover child provisions it.
[Unit]
Description=VPS dead-man ping to healthchecks.io

[Service]
Type=oneshot
EnvironmentFile=/etc/fleet/deadman.env
ExecStart=/usr/bin/curl -fsS -m 10 --retry 3 $HC_URL
