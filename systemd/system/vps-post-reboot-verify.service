[Unit]
Description=Post-window verify: resume after reboot, or surface a surviving reboot-required flag (fleet-ops#3994)
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=nish
Group=nish
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/usr/bin/systemctl is-system-running --wait
ExecStart=/home/nish/.local/bin/vps-post-reboot-verify
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target