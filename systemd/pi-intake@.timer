[Unit]
Description=Pi fleet issue intake schedule for Nishfleet/%i

[Timer]
# fleet-ops#1464 slowed this from */15 to */20 to yield to a "primary"
# webhook path (workers/github-push-forward/ + gh-webhook-receiver.service).
# That path never existed: the receiver dispatched ZERO events in its whole
# recorded life, no webhook was ever registered on either repo, and it was
# bound to loopback with no ingress. Its only traffic was a canary built to
# keep its own heartbeat green. Deleted 2026-09-18 (fourth cut); the timer
# is the primary trigger again and gets its 15 minutes back.
# 2026-09-22 (Nish: "ramp tf up"): every 5 min, was 15. Worker runs finish in
# 3-15 min, so at 15 min the lanes drained between ticks and the cap (10) was
# never reached. The 4 GB MemAvailable floor inside the tick is the governor.
OnCalendar=*:00/5
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
