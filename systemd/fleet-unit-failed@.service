# OnFailure= target: healthchecks.io fail ping (fleet-ops#9033).
# man systemd.unit example 3 is this shape (failure-handler@%N.service).
# HC_URL_RECONCILE is the leftover keystone dead-man whose caller was deleted
# with the dispatcher; no live job pings it. Fail ping, not success ping.
# Do not OnFailure= this unit (recursive chain, same man page).
[Unit]
Description=Healthchecks.io fail ping for %i (fleet-ops#9033)

[Service]
Type=oneshot
EnvironmentFile=/home/nish/.config/fleet-ops/keystone-hc.env
ExecStart=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null --data-raw %i ${HC_URL_RECONCILE}/fail
