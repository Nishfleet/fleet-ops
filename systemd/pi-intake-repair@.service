[Unit]
Description=Pi fleet intake repair agent for Nishfleet/%i
StartLimitIntervalSec=21600
StartLimitBurst=2

[Service]
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/nish
# Seat rotation is the LiteLLM worker-cheap group. A pinned --provider
# previously died with HTTP 429 while healthy seats sat unused (fleet-ops#138).
# /bin/sh -c exec keeps systemd-analyze verify from needing a new CI stub
# (same shape as pi-scout@.service / pi-scout-repair@.service).
ExecStart=/bin/sh -c '{ cat "$HOME/.pi/agent/prompts/intake-repair.md"; echo; echo "TARGET REPO: Nishfleet/%i"; } | exec pi --print --session-dir "$HOME/.pi/agent/sessions/pi-intake-repair-%i" --provider litellm --model worker-cheap'
TimeoutStartSec=1800
# fleet-ops#6034: journal-visible elapsed/budget. The rail collapse deleted
# bin/pi-intake-repair-run; PACKET-VERDICT stays the agent's line. Leading
# '-' so this print cannot change pi's exit or systemd's TERM/timeout Result.
# budget=1800 matches TimeoutStartSec above (orchestrator sweep: no 2700s bump).
# $$ is a literal $ for the shell; systemd expands $VAR before sh sees it.
# RuntimeDirectory is removed AFTER ExecStopPost, so the stamp is readable here.
RuntimeDirectory=pi-intake-repair-%i
ExecStartPre=/bin/sh -c 'date +%s > $$RUNTIME_DIRECTORY/start'
ExecStopPost=-/bin/sh -c 'start=$$(cat "$$RUNTIME_DIRECTORY/start" 2>/dev/null || echo ""); now=$$(date +%s); if [ -n "$$start" ]; then elapsed=$$((now-start)); else elapsed="?"; fi; echo "INTAKE-REPAIR-VERDICT repo=%i elapsed=$${elapsed}s budget=1800s result=$$SERVICE_RESULT exit=$${EXIT_STATUS:-} code=$${EXIT_CODE:-}" >&2'
