[Unit]
Description=Pi fleet intake repair agent for Nishfleet/%i
StartLimitIntervalSec=21600
StartLimitBurst=2

[Service]
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/nish
# Seat rotation is pi-intake-repair-run's job (pick_seat). A pinned --provider
# previously died with HTTP 429 while healthy seats sat unused (fleet-ops#138).
# /bin/bash -c exec keeps systemd-analyze verify from needing a new CI stub
# (same shape as pi-scout@.service / pi-scout-repair@.service).
ExecStart=/bin/sh -c '{ cat "$HOME/.pi/agent/prompts/intake-repair.md"; echo; echo "TARGET REPO: Nishfleet/%i"; } | exec pi --print --provider litellm --model worker-cheap'
TimeoutStartSec=1800
