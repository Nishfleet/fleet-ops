[Unit]
Description=Fleet chain-e2e drill — synthetic fault rehearsal of the whole failure chain (fleet-ops#375)
# Runs bin/chain-e2e-drill, which injects one isolated fixture fault and
# asserts hops 1-6 mechanically. Started by the blind-audit / gap-closure
# cadence (no new timer). Inherits global OnFailure=. No [Install] — a
# cadence calls it, it is never self-enabling.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=CHAIN_E2E_STATE_DIR=/home/nish/workspaces/agent-state/chain-e2e
WorkingDirectory=/home/nish
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/chain-e2e-drill'
TimeoutStartSec=90
Restart=no