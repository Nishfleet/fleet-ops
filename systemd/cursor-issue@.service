# cursor-issue@.service — twin of pi-issue@.service (and devin-issue@.service) with Cursor's headless CLI as the engine.
# Nish 2026-09-19 13:05 IST handed the Cursor API key: "crsr_... - cursor". Cursor has no OpenAI-compatible HTTP API
# (api2.cursor.sh, own protocol), so it cannot be a router rung; it IS an agent, so it runs as a worker unit on the same rail. Proven on this host 2026-09-19 13:21 IST:
# `cursor-agent -p --output-format text --model cursor-grok-4.6-high --force --trust` created proof.txt from `uname -r`,
# committed it (5be38f6) and printed DONE from a piped packet; a second run from /home/nish finished in 15s with no inotify growth.
# Model is Nish's Cursor lock (memory cursor-two-model-lock): cursor-grok-4.6-high, never a -fast variant (memory cursor-pools-and-no-fast-models); kimi-k3-max is the judge-only sibling. Same claim/PR/ExecStopPost contract as pi-issue@; the packet is
# AGENTS.md + prompts/worker.md with `$1` substituted (pi does that via its /worker template).
# Key: ~/.config/fleet-ops/seats/cursor.env (CURSOR_API_KEY=..., mode 600), loaded by EnvironmentFile below.
# Install: ln -sf <deploy-clone>/systemd/cursor-issue@.service ~/.config/systemd/user/ && systemctl --user daemon-reload
[Unit]
Description=Cursor fleet issue worker %i (Grok 4.6 High, headless cursor-agent CLI)
# Second cut 2026-09-18: this unit IS the worker. There is no wrapper script.
# ExecStart invokes a Pi PROMPT TEMPLATE and pipes it into `pi --print`.
# Everything the old bin/pi-issue-run (1,542 lines) did is either systemd's job
# or the LiteLLM proxy's job:
#   - retries / backoff / hang-kill  -> Restart=, RestartSec=, TimeoutStartSec=
#   - seat rotation / fallback       -> the LiteLLM proxy groups. The old
#     wrapper resolved to a group too (pi-packet-run called litellm_seat), so
#     naming the group directly removes a layer, not a capability.
#     Workers use `worker-capable`, NOT `worker-cheap`. Measured on this exact
#     prompt 2026-09-18: worker-cheap answered "I'll start by checking the
#     environment" and stopped with tools=0; worker-capable ran 31 tools of
#     real investigation. Intake and scout stay on worker-cheap: measured
#     tools=16 and tools=22, they are mechanical.
#   - verdict parsing                -> replaced by the ExecStopPost artifact
#     check below. See the comment there.
# --session-dir is load-bearing, not tidiness. Pi stores sessions per working
# directory, so every unit running in /home/nish shared one session pool: the
# first workers on the new rail resumed each other's transcripts and exited
# after ~3 minutes and 8 tools without touching the issue.
OnFailure=pi-issue-failed@%i.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
# Per-worker memory caps (cgroup, systemd's own). Measured MemoryPeak n=14:
# median 1.28G, max 4.8G — 3G throttles the tail without killing normal work.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
# fleet-ops#3611: never let a runaway worker thrash swap and OOM unrelated
# units. Exceeding MemoryMax is a local OOM kill, not a host-wide stall.
MemorySwapMax=0
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=CURSOR_UNIT_INSTANCE=%i
EnvironmentFile=/home/nish/.config/fleet-ops/seats/cursor.env
# Commit identity. The worker commits inside a worktree of the deploy clone or
# of products/0509, and BOTH carry a repo-local `user.name = Nish` — so without
# this block a worker's commits land authored by Nish himself. The retired
# bin/pi-issue-run set the identity per-commit; when it was deleted the override
# went with it, and the first worker on the new rail pushed
# claim/issue-7783 @ 88d52047c authored "Nish <nish@users.noreply.github.com>"
# while every claim branch from before the cut is authored nishfleet-worker[bot].
# git's own env vars are the fix: they outrank repo-local config (proven on this
# host 2026-09-18 against a local config of exactly `Nish`), they are set once in
# the unit instead of restated in prose the model can forget, and they cover
# `git commit` however the worker invokes it. This is the commit identity only —
# push auth is the GH_TOKEN minted below, and they are separate mechanisms.
Environment=GIT_AUTHOR_NAME=nishfleet-worker[bot]
Environment=GIT_AUTHOR_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
Environment=GIT_COMMITTER_NAME=nishfleet-worker[bot]
Environment=GIT_COMMITTER_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
WorkingDirectory=/home/nish
# App identity: `gh token` (the Link-/gh-token gh extension, v2.0.10) mints the
# <=1h nishfleet-worker installation token. It replaces bin/worker-token (350
# lines of hand-rolled RS256 JWT + installation discovery + cache) with the
# stock gh extension that does exactly the same three GitHub calls. Proven
# 2026-09-18: app-id 4728578 / installation 156789042 ->
# `gh api /installation/repositories --jq .total_count` = 13.
# An empty mint fails the unit rather than silently falling back to human auth.
#
# `--exclude-tools subagent` is depth-1, enforced by Pi's own CLI flag rather
# than by ~/.pi/agent/extensions/spawn-guard-core.ts (a LOCAL hand-written
# extension, deleted in this sweep). `subagent` is the exact tool name the
# stock subagent extension registers (examples/extensions/subagent/index.ts:473)
# and the only spawn tool a worker has. Stock agent definitions under
# ~/.pi/agent/agents/ already declare `tools: read, grep, find, ls[, bash]`
# with no `subagent`, so children could never re-spawn; this flag closes the
# root. Cost measured before flipping it: zero `keystone` and zero `heavy`
# issues have EVER been opened in Nishfleet/fleet-ops or Nishfleet/0509, so
# worker.md's manager mode — the only caller — never fired once. It is deleted
# with this change.
# Per-run invariants (hard rules, PR body contract, memory budget, D1 rules) live
# in the repo AGENTS.md and are appended to the system prompt, not re-pasted into
# every packet. `--append-system-prompt <file>` is Pi's own flag and takes file
# contents (proven on this host 2026-09-18). It is used instead of relying on Pi's
# AGENTS.md context-file discovery because that walks up from the STARTUP cwd, and
# this unit starts in /home/nish — the repo file would never be reached. Canonical
# path, never cwd-relative: the unit must not depend on which checkout it runs from.
ExecStart=/bin/sh -c 'set -e; GH_TOKEN=$(gh token generate --app-id 4728578 --key "$HOME/.config/fleet-worker/nishfleet-worker.private-key.pem" --installation-id 156789042 --token-only); [ -n "$GH_TOKEN" ] || { echo "app token mint failed — refusing human-gh fallback" >&2; exit 1; }; export GH_TOKEN; { cat "$HOME/workspaces/tooling/fleet-ops-deploy-clone/AGENTS.md"; echo; sed -e "1,/^---$/d" -e "s/[$]1/$1/g" "$HOME/workspaces/tooling/fleet-ops-deploy-clone/prompts/worker.md"; } | exec cursor-agent -p --output-format text --model cursor-grok-4.6-high --force --trust' sh %i
# The worker created its own worktree; the worker's own unit cleans it up.
# No reaper, no salvage organ: work that was never committed and pushed did not
# happen, and the next dispatch starts from origin/main. Leading '-' so cleanup
# can never wedge the stop path.
ExecStopPost=-/bin/sh -c 'w="$HOME/workspaces/agent-worktrees/issue-$1"; for g in "$HOME/workspaces/tooling/fleet-ops-deploy-clone" "$HOME/workspaces/products/0509" "$HOME/workspaces/products/fleet-ops"; do git -C "$g" worktree remove --force "$w" >/dev/null 2>&1 || true; done; rm -rf "$w"' sh %i
# fleet-ops#3695: a finishing worker asks its own repo's intake for a refill,
# so a cohort that drains in 10 min does not leave the rest of the window idle.
ExecStopPost=-/bin/sh -c 'r=$(echo "$1" | sed "s/-[0-9][0-9]*$//"); systemctl --user start --no-block "pi-intake@$r.service"' sh %i
# ARTIFACT CHECK — replaces the packet-verdict extension and PI_PACKET_EXPECTS_TOOLS.
# fleet-ops#7761 caught a worker run that made ZERO tool calls exiting 0, so
# systemd recorded Result=success while the issue went untouched; the fix then
# was an env var arming a hand-written extension to count tool calls. Counting
# tool calls was always a proxy for the thing that actually matters: did the
# run leave the artifact behind? This asks that directly. A worker's first act
# is to push claim/issue-<N>; if neither that branch NOR a PR that was opened
# from it exists, the run produced nothing, so exit 1 turns Result=success into
# Result=exit-code -> `failed`, which is what OnFailure=, Restart=on-failure and
# StartLimitBurst all key off.
# The PR arm is not belt-and-braces, it is required: caught live 2026-09-18 on
# the first full run of this rail. Worker fleet-ops-7783 pushed the branch,
# opened PR #7789, armed auto-merge, and GitHub merged it and DELETED the branch
# at 19:06:12Z — all while the unit was still running. A branch-only check marks
# that worker `failed` for having succeeded completely, which would then release
# its claim and re-dispatch work that is already merged. Ask for the artifact in
# either place it can legitimately be.
# Runs LAST so the worktree cleanup and the intake refill above happen first.
# Only checked on a success exit — a run that already failed is already failed.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || exit 0; i="$1"; r=$(echo "$i" | sed "s/-[0-9][0-9]*$//"); n=$(echo "$i" | sed "s/.*-//"); GH_TOKEN=$(gh token generate --app-id 4728578 --key "$HOME/.config/fleet-worker/nishfleet-worker.private-key.pem" --installation-id 156789042 --token-only 2>/dev/null); export GH_TOKEN; gh api "repos/Nishfleet/$r/branches/claim/issue-$n" >/dev/null 2>&1 && exit 0; [ "$(gh api "repos/Nishfleet/$r/pulls?state=all&head=Nishfleet:claim/issue-$n&per_page=1" --jq length 2>/dev/null)" = 1 ] && exit 0; echo "no claim/issue-$n branch and no PR from it on Nishfleet/$r — the run exited 0 with no artifact" >&2; exit 1' sh %i
TimeoutStopSec=180

# Retry policy — systemd's own, not a counter in bash.
Restart=on-failure
RestartSec=240
RestartSteps=3
RestartMaxDelaySec=30min
# Hang detection: a worker active longer than this is terminated into `failed`.
TimeoutStartSec=45min
