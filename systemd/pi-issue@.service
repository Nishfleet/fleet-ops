[Unit]
Description=Pi fleet issue worker %i
# This unit IS the worker — no wrapper script. ExecStart pipes Pi's /worker
# prompt template into `pi --print`; no Restart= (a failed run re-queues through
# OnFailure and intake, fleet-ops#8421); hang-kill is
# TimeoutStartSec=, and the seat is the PI_SEAT_PROVIDER/PI_SEAT_MODEL pair
# below (2026-09-22: xai-oauth grok-4.7:xhigh — see the SEAT block). Until
# then it was the LiteLLM `worker-capable` group; that group is still what
# intake/scout and every other Pi caller use, and putting this worker back on
# it is a two-value edit (litellm / worker-capable). Notes that still hold for
# the router path: worker-cheap measured tools=0 on this prompt 2026-09-18, and
# the cheap/capable split is prompt-fit navigation, not upstream isolation —
# both groups share the same upstream accounts (fleet-ops#7786).
# --session-dir is load-bearing: Pi keys sessions per working directory, and
# every unit starting in /home/nish shared one session pool — workers resumed
# each other's transcripts and exited without touching the issue.
# Two strikes live in prompts/claim-release.md step 5 as a count of GitHub
# release comments (fleet-ops#8421): a systemd start counter is in-memory,
# counts continuations as retries, and its refusals re-fire OnFailure.
# Permanent failure releases the claim: pi-issue-failed@ runs
# prompts/claim-release.md — fail-closed open-PR check, HOLD on an open PR,
# else agent-in-progress -> agent-ready, never deletes the branch
# (fleet-ops#6292). Cut with the 2026-09-22 wipe, restored by #8053.
OnFailure=pi-issue-failed@%i.service
# The claim gate below authenticates with the shared App token env file —
# Requires+After makes the mint part of this unit's start transaction, same
# as pi-intake@.
Requires=fleet-gh-token.service
After=fleet-gh-token.service

[Service]
# Per-worker memory caps (cgroup, systemd's own). Measured MemoryPeak n=14:
# median 1.28G, max 4.8G — 3G throttles the tail without killing normal work.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
# fleet-ops#3611: never let a runaway worker thrash swap and OOM unrelated
# units. Exceeding MemoryMax is a local OOM kill, not a host-wide stall.
MemorySwapMax=0
# fleet-ops#4902 follow-up (SustainedLoadHigh 2026-09-11): the policy tree
# bounds MEMORY in six layers and CPU in none. Admission is RAM-only
# (ram_governor_cap = MemAvailable / ram_gb_per_worker), so the fleet admits
# until RAM runs out; nothing counts cores. The #4147 brake that the alert
# descriptions and docs/design/hand-built-vs-off-the-shelf.md credit (`oomd +
# CPUWeight/IOWeight`) is a real live CPUWeight=60 on user-1000.slice, but a
# WEIGHT only decides who wins a fight for cores -- it cannot create them.
# Observed 2026-09-11 02:00-02:15: 16 pi-issue@ workers on 8 vCPUs, each
# running vitest forks, measured burn ~94% of a core per worker
# (pi-issue@fleet-ops-5022: 9.36 CPU-s in 10s), so demand was ~2x the cores;
# node_load15 sat at 16-17 against the 12 threshold with CPU 92% busy and
# MemAvailable still a healthy 9-11 GiB. CPUQuota is the missing BOUND: it
# caps one worker's aggregate CPU regardless of how many the RAM term admits.
# Sizing from the declared ceiling in config/seat-caps.json (target_concurrent
# 25): min(25, ram_governor) workers x quota <= nproc=8. 25% x 25 = 6.25 cores
# (holds); 50% x 25 = 12.5 cores (still oversubscribed) so 50% was rejected.
# This is a ceiling, not a serialiser: an idle box hands one worker a full
# core, and only the sum past nproc is throttled.
CPUAccounting=yes
CPUQuota=25%
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Shared App token file, minted by fleet-gh-token.service (Requires= above) —
# the ExecStartPre claim gate's auth. ExecStart still mints its own ≤1h token;
# this file is only the gate's read.
EnvironmentFile=-/run/user/%U/fleet-gh-token.env
Environment=PI_UNIT_INSTANCE=%i
# fleet-ops#7773: shadow-only escalation-target log — the Jev call in
# prompts/worker.md step 4 is flag-gated OFF by default; this turns it on
# for logging only. The block never changes the worker's choice.
Environment=JEV_WORKER_ESCALATION_TARGET=1
# Commit identity. The worktrees carry a repo-local `user.name = Nish`, so
# without this block a worker's commits land authored by Nish himself (proven:
# claim/issue-7783 @ 88d52047c). git's own env vars outrank repo-local config
# and cover `git commit` however invoked. Push auth is the GH_TOKEN minted in
# ExecStart — a separate mechanism.
# SEAT (Nish 2026-09-22, 09:5x IST: "this will expire unused unless we max out
# grok 4.7 xhigh" — SuperGrok weekly showed 75% left, resetting in 18h). Grok
# rides the SuperGrok SUBSCRIPTION through Pi's xai-oauth provider, which
# refreshes its own OAuth token; it is NOT reachable through the LiteLLM
# router, so the only lever on it is the worker's own --provider/--model.
# Proven before this landed: `pi --print --provider xai-oauth --model
# grok-4.7:xhigh` completed a real write-a-file task, and 5 of those run
# CONCURRENTLY all returned rc=0 with no 429 — the lane tolerates the fleet's
# pi-side concurrency. (Pi warns "Model grok-4.7 not found ... using custom
# model id"; the OAuth proxy serves it anyway, per the #8066 reviewer pin.)
#
# The seat is Environment now, not a literal in the Exec line, so the next
# seat swap is a one-value edit. That also ends a recurring collision: the
# no-glue check fails any ADDED Exec line of 400+ chars, which made every edit
# to this 552-char line illegal — it already blocked the Cursor rail's move to
# grok-4.7-high (fleet-ops#8057). The constants below (prompt path, App id,
# key path, installation id) moved out of the Exec line for the same reason,
# and the token guard became `: "$${GH_TOKEN:?mint failed}"`; ExecStart is now
# 391 chars and carries no inline program, which is what the rule actually
# wants. Same behaviour: mint an <=1h App token, refuse to fall back to
# Nish's own gh auth if the mint comes back empty.
Environment=PI_SEAT_PROVIDER=xai-oauth
Environment=PI_SEAT_MODEL=grok-4.7:xhigh
Environment=WORKER_PROMPT=/home/nish/workspaces/tooling/fleet-ops-deploy-clone/AGENTS.md
Environment=GH_APP_ID=4728578
Environment=GH_APP_KEY=/home/nish/.config/fleet-worker/nishfleet-worker.private-key.pem
Environment=GH_APP_INST=156789042
Environment=GIT_AUTHOR_NAME=nishfleet-worker[bot]
Environment=GIT_AUTHOR_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
Environment=GIT_COMMITTER_NAME=nishfleet-worker[bot]
Environment=GIT_COMMITTER_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
WorkingDirectory=/home/nish
# App identity: `gh token generate` (the gh-token extension) mints the <=1h
# nishfleet-worker installation token. An empty mint fails the unit rather
# than silently falling back to human auth.
#
# `--exclude-tools subagent` is the depth-1 guard — Pi's own CLI flag closing
# the only spawn tool a worker has (stock agent definitions under
# ~/.pi/agent/agents/ already declare no `subagent`).
# `--append-system-prompt <file>` appends the repo AGENTS.md (the per-run
# invariants) to the system prompt. Pi's own AGENTS.md discovery is not used:
# it walks up from the STARTUP cwd, and this unit starts in /home/nish — the
# repo file would never be reached. Canonical path, never cwd-relative.
# CLAIM GATE (fleet-ops#7790): a worker must never run on an issue whose
# claim never landed — the 2026-09-19 tick started four units while their
# claim refs were absent (Class A: unclaimed workers open PRs blind). No
# claim/issue-<N> ref on origin -> exit 1 -> failed unit + OnFailure, loud
# in `list-units --state=failed`, instead of a blind 45-minute run. Kept out
# of ExecStart itself: the no-glue check caps added Exec lines at 400 chars.
ExecStartPre=/bin/sh -c 'r=$${1%-*}; n=$${1##*-}; gh api "repos/Nishfleet/$r/git/refs/heads/claim/issue-$n" >/dev/null || { echo "claim-gate: no claim/issue-$n on Nishfleet/$r — refusing unclaimed start (fleet-ops#7790)" >&2; exit 1; }' sh %i
ExecStartPre=/bin/sh -c 'r=$${1%-*}; n=$${1##*-}; [ "$$(gh api repos/Nishfleet/$r/issues/$n --jq .state)" = open ] || { echo "open-gate: Nishfleet/$r#$n is not open — refusing dead work (Nish 2026-09-22)" >&2; exit 1; }' sh %i
ExecStart=/bin/sh -c 'set -e; export GH_TOKEN=$(gh token generate --app-id $GH_APP_ID --key $GH_APP_KEY --installation-id $GH_APP_INST --token-only); : "$${GH_TOKEN:?mint failed}"; echo "/worker $1" | exec pi --print --append-system-prompt $WORKER_PROMPT --session-dir "$HOME/.pi/agent/sessions/pi-issue-$1" --exclude-tools subagent --provider $PI_SEAT_PROVIDER --model $PI_SEAT_MODEL' sh %i
# The worker created its own worktree; the worker's own unit cleans it up.
# No reaper, no salvage organ: work that was never committed and pushed did not
# happen, and the next dispatch starts from origin/main. Leading '-' so cleanup
# can never wedge the stop path.
ExecStopPost=-/bin/sh -c 'w="$HOME/workspaces/agent-worktrees/issue-$1"; for g in "$HOME/workspaces/tooling/fleet-ops-deploy-clone" "$HOME/workspaces/products/0509" "$HOME/workspaces/products/fleet-ops"; do git -C "$g" worktree remove --force "$w" >/dev/null 2>&1 || true; done; rm -rf "$w"' sh %i
# fleet-ops#3695: a finishing worker asks its own repo's intake for a refill,
# so a cohort that drains in 10 min does not leave the rest of the window idle.
ExecStopPost=-/bin/sh -c 'r=$(echo "$1" | sed "s/-[0-9][0-9]*$//"); systemctl --user start --no-block "pi-intake@$r.service"' sh %i
# ARTIFACT CHECK (fleet-ops#7761). Dead-man for a run that exits 0 having
# produced nothing (a zero-tool run left #7761 agent-in-progress with no
# worker). Runs only on a success exit and LAST, after cleanup and the intake
# refill. Artifact = a PR on claim/issue-<N> in any state (a merge can delete
# the branch mid-run, #7783) OR the claim branch ahead of main. A 404 body on
# the compare is a deliberate park (branch never pushed) and passes. Anything
# else, including an unreadable PR list, is unverifiable: exit 1 -> failed ->
# OnFailure=pi-issue-failed@ -> prompts/claim-release.md re-arms the issue.
# Inline because no new scripts are allowed; ci's no-glue step caps the line
# at 400 chars. NOT prefixed with `-`: a tolerated failure here is the bug.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ]||exit 0;r=Nishfleet/$${1%-*};b=claim/issue-$${1##*-};p=$(gh api "repos/$r/pulls?state=all&head=Nishfleet:$b" --jq length)||exit 1;[ "$p" -gt 0 ]&&exit 0;a=$(gh api "repos/$r/compare/main...$b" --jq .ahead_by);case "$a" in [1-9]*) exit 0;; *"Not Found"*) exit 0;; esac;echo "artifact-check $b: $a" >&2;exit 1' sh %i
TimeoutStopSec=180

# Hang detection: a worker active longer than this is terminated into `failed`.
TimeoutStartSec=45min
