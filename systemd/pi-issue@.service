[Unit]
Description=Pi fleet issue worker %i
# Second cut 2026-09-18: this unit IS the worker. There is no wrapper script.
# ExecStart assembles the prompt and pipes it into `pi --print`. Everything the
# old bin/pi-issue-run (1,542 lines) did is either systemd's job or the LiteLLM
# proxy's job:
#   - retries / backoff / hang-kill  -> Restart=, RestartSec=, TimeoutStartSec=
#   - seat rotation / fallback       -> the LiteLLM proxy groups. The old
#     wrapper resolved to a group too (pi-packet-run called litellm_seat), so
#     naming the group directly removes a layer, not a capability.
#     Workers use `worker-capable`, NOT `worker-cheap`. Measured on this exact
#     prompt 2026-09-18: worker-cheap answered "I'll start by checking the
#     environment" and stopped with tools=0; worker-capable ran 31 tools of
#     real investigation. The retired wrapper reached the same place by
#     ordering product picks on measured PR yield (PI_PICK_ROLE=product) —
#     the cheapest seat was never the one that did issue work. Intake and
#     scout stay on worker-cheap: measured tools=16 and tools=22, they are
#     mechanical and the cheap group handles them.
#   - verdict parsing                -> the packet-verdict + stop-judge Pi
#     extensions, already loaded (EXTLOAD-OK on every run).
# --session-dir is load-bearing, not tidiness. Pi stores sessions per working
# directory, so every unit running in /home/nish shared one session pool: the
# first workers on the new rail resumed each other's transcripts ("continuing
# from where the transcript left off") and exited after ~3 minutes and 8 tools
# without touching the issue. A per-instance session dir is what the retired
# wrapper did too — the leftover sessions/pi-issue-0509-3610 dir is its
# fingerprint — and it is a pi flag, not a wrapper.
# The old .in packet file is gone with the wrapper, and with it the entire
# 208/STDIN failure class (fleet-ops#1451) and the ConditionPathExists guard:
# a prompt that is built at ExecStart time can never be missing.
OnFailure=pi-issue-failed@%i.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
# Per-worker memory caps (cgroup, systemd's own). Measured MemoryPeak n=14:
# median 1.28G, max 4.8G — 3G throttles the tail without killing normal work.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
# fleet-ops#3611: never let a runaway worker thrash swap and OOM unrelated
# units. Exceeding MemoryMax is a local OOM kill, not a host-wide stall.
MemorySwapMax=0
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PI_UNIT_INSTANCE=%i
# fleet-ops#7761: a worker run that made ZERO tool calls must not exit 0.
# On 2026-09-18 the LiteLLM worker groups fell through to the `devin --print`
# bridge, which is an agent-in-a-box: it never forwards the tools array and can
# never return a tool_calls response. Every worker from ~16:30Z therefore ended
# PACKET-VERDICT tools=0 class=no-tools with rc=0, so systemd recorded
# Result=success while 100+ agent-ready issues went untouched — and because
# Restart=on-failure, OnFailure=pi-issue-failed@ and StartLimitBurst all key off
# the exit code, the silent 0 disabled this unit's entire retry and alerting
# path. This env var arms the packet-verdict extension to exit 1 on a no-tools
# run, turning a silent no-op back into a `failed` unit that OnFailure catches.
# Opt-in on purpose: an interactive or read-only pi session legitimately ends
# with tools=0, so only work packets set it. Proof 2026-09-18 17:29Z — same
# prompt, same env: senior (devin, cannot tool-call) rc=1, worker-capable
# (synthetic, proven tool_calls) rc=0, and no-tools WITHOUT this var rc=0.
Environment=PI_PACKET_EXPECTS_TOOLS=1
WorkingDirectory=/home/nish
# fleet-ops#7776: probe worker-capable before every (re)start. A walled group
# skips the start — ExecCondition is not a failure, so there is no verdict
# cycle, no restart burn, no OnFailure release — and the claim branch stays
# for re-entrant resume when the wall lifts. Deliberately not ExecStartPre:
# a failed ExecStartPre fails the unit and fires OnFailure=pi-issue-failed@,
# which is exactly the release churn this probe exists to stop.
ExecCondition=/bin/sh -c 'x=/home/nish/.local/lib/pi-packet/seat-probe.sh; [ -x "$x" ] || exit 0; exec "$x" worker-capable'
# %i is <repo>-<issue>. sed splits it without any '%' in the script body, so
# systemd never sees an unknown specifier. worker-token mints the ≤1h
# nishfleet-worker App token (RS256 JWT over the App private key) — the one
# step here that is neither systemd's nor Pi's: a worker must not push as Nish.
# worker-token --print emits the LINE `export GH_TOKEN=<token>` (it never prints
# the bare token), so it is eval'd, not captured. An empty mint fails the unit
# rather than silently falling back to human auth.
ExecStart=/bin/sh -c 'set -e; i="$1"; r=$(echo "$i" | sed "s/-[0-9][0-9]*$//"); n=$(echo "$i" | sed "s/.*-//"); eval "$(worker-token --print)"; [ -n "$GH_TOKEN" ] || { echo "worker-token mint failed — refusing human-gh fallback" >&2; exit 1; }; export GH_TOKEN; { cat "$HOME/.pi/agent/prompts/worker.md"; echo; echo "TARGET: repo Nishfleet/$r issue $n unit pi-issue-$i"; } | exec pi --print --session-dir "$HOME/.pi/agent/sessions/pi-issue-$i" --provider litellm --model worker-capable' sh %i
# The worker created its own worktree; the worker's own unit cleans it up.
# No reaper, no salvage organ: work that was never committed and pushed did not
# happen, and the next dispatch starts from origin/main. Leading '-' so cleanup
# can never wedge the stop path.
ExecStopPost=-/bin/sh -c 'w="$HOME/workspaces/agent-worktrees/issue-$1"; for g in "$HOME/workspaces/tooling/fleet-ops-deploy-clone" "$HOME/workspaces/products/0509" "$HOME/workspaces/products/fleet-ops"; do git -C "$g" worktree remove --force "$w" >/dev/null 2>&1 || true; done; rm -rf "$w"' sh %i
# fleet-ops#3695: a finishing worker asks its own repo's intake for a refill,
# so a cohort that drains in 10 min does not leave the rest of the window idle.
ExecStopPost=-/bin/sh -c 'r=$(echo "$1" | sed "s/-[0-9][0-9]*$//"); systemctl --user start --no-block "pi-intake@$r.service"' sh %i
TimeoutStopSec=180

# Retry policy — systemd's own, not a counter in bash.
Restart=on-failure
RestartSec=240
RestartSteps=3
RestartMaxDelaySec=30min
# Hang detection: a worker active longer than this is terminated into `failed`.
TimeoutStartSec=45min
