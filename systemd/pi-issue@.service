[Unit]
Description=Pi fleet issue worker %i
# P4-A: seat rotation on retry. pi-issue-run picks a DIFFERENT seat on each
# Restart=, so a timeout on devin/swe-1-7 lands the next try on cursor or
# cline instead of repeating the failing call. systemd's own retry policy
# (RestartSec / RestartSteps / StartLimitBurst) drives the timing.
OnFailure=pi-issue-failed@%i.service
StartLimitIntervalSec=1h
StartLimitBurst=3
# fleet-ops#1451: systemd opens StandardInput=file BEFORE ExecStartPre runs,
# so a missing .in packet (archived by the reaper while the claim branch
# survived) makes the unit fail 208/STDIN — which trips OnFailure and
# unit-escalation on every restart-ladder step and every re-dispatch.
# ConditionPathExists is checked BEFORE stdin setup: a missing .in makes the
# start a clean SKIP (no failure, no OnFailure, no escalation). The dispatch
# path (pi-issue-start, fleet-heartbeat-red-pr-repair) regenerates the .in
# before starting, so a skip here means the dispatcher raced a not-yet-
# regenerated packet and the next tick retries cleanly.
ConditionPathExists=/home/nish/.local/state/pi-issues/%i.in

[Service]
# Per-worker memory caps, restored from the pre-2026-08-23 lane-manager
# design (lane-manager.py:108 'RAM is the binding resource - which the
# launch floor (MIN_FREE_RAM_MB) and per-worker MemoryHigh=3G/Max=6G
# already govern'). systemd's own cgroup controls: High throttles and
# reclaims, Max is the hard stop. Measured MemoryPeak n=14: median 1.28G,
# max 4.8G - so 3G throttles the tail without killing normal work.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
# fleet-ops#3611: never let a runaway worker thrash swap and OOM unrelated
# fleet units. MemorySwapMax=0 keeps the worker inside its cgroup: when it
# exceeds MemoryMax it is OOM-killed locally instead of spilling to swap and
# starving the whole host (systemd-oomd killed codex-remote-control,
# fleet-deploy-check and an ephemeral Chromium scope on 2026-09-05).
MemorySwapMax=0
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PI_UNIT_INSTANCE=%i
WorkingDirectory=/home/nish
StandardInput=file:/home/nish/.local/state/pi-issues/%i.in
StandardOutput=file:/home/nish/.local/state/pi-issues/%i.out
StandardError=file:/home/nish/.local/state/pi-issues/%i.err
# ExecStart = seat-rotation wrapper. Mirrors pi-packet-run. %i is the unit
# instance name (e.g. 0509-915); the wrapper reads its packet + tries from
# state and rotates seat via pick_seat on every restart.
ExecStart=/home/nish/.local/bin/pi-issue-run %i

# fleet-ops#1204: bank a dirty issue worktree when this worker dies.
# issue-%i is the intake worktree contract (prompts/worker.md).
Environment=PI_SALVAGE_WORKDIR=/home/nish/workspaces/agent-worktrees/issue-%i
Environment=PI_SALVAGE_UNIT=pi-issue-%i
Environment=PI_SALVAGE_PACKET=/home/nish/.local/state/pi-issues/%i.in
# Leading '-' so a missing binary (pre-deploy, or hosted systemd-analyze
# which cannot stub this path) cannot wedge the worker stop path.
ExecStopPost=-/home/nish/.local/bin/pi-salvage-worktree
# fleet-ops#3695: continuous top-up. The intake timer ticks every 20 min and
# a cohort of workers finishes inside ~10 min, so half of every window sat
# idle next to ready work (2026-09-05T15:56Z: 0 workers, 72 agent-ready). A
# finishing worker asks its own repo's intake for a refill; the tick's flock
# plus its debounce (lib/pi-intake-tick.sh) coalesce a cohort into ONE tick.
# Instance is <repo>-<issue>; the repo is everything before the last '-'
# ($$ and %% are systemd escapes for a literal $ and %). --no-block: never
# wait on intake inside a worker's stop path; '-' so it can never wedge it.
ExecStopPost=-/bin/sh -c 'i=%i; systemctl --user start --no-block "pi-intake@$${i%%-*}.service"'
TimeoutStopSec=180

# Retry policy - systemd's own, not a counter in bash.
Restart=on-failure
RestartSec=240
RestartSteps=3
RestartMaxDelaySec=30min
# Hang detection: a worker active longer than this is terminated into `failed`.
# (TimeoutStartSec, not RuntimeMaxSec: systemd ignores RuntimeMaxSec on Type=oneshot.)
TimeoutStartSec=45min
