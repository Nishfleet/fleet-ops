[Unit]
Description=Duplicate-issue drain backstop — daily (fleet-ops#3270)

[Timer]
# Named reason (vault: "a schedule needs a named reason"): this timer is
# now the ONLY trigger — gh-webhook-receiver, which #3270 made the primary
# one, was deleted on 2026-09-18 having dispatched zero events in its whole
# recorded life. A duplicate issue is waste but not breakage — the canonical
# issue still gets dispatched — so a daily drain is proportionate (the old
# 15-min cadence was overkill for a clustering drain).
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=30min
Persistent=true
AccuracySec=1h

[Install]
WantedBy=timers.target
