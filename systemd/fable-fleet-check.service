[Unit]
Description=Hourly fleet judge at :00 UTC via agent-cron-run senior ladder (Cursor Grok 4.6 high first; Nish 2026-09-07 spend the $400 Cursor API pool) — judge packet landing + product proof, Devin occupancy, Cursor pacing, one Telegram line via hermes.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
# fleet-ops#6252: judge packets are read from agent-state and reports are
# written to cron-output — no repo is needed, so the cwd is the job's scratch
# dir, never a deploy checkout (a run there dirties tracked files and blocks
# merge-to-live). '-' prefix + ExecStartPre mkdir = self-provisioning.
Environment=WORKDIR=/home/nish/workspaces/agent-state/fable-check
Environment=LOG_DIR=/home/nish/workspaces/agent-state/cron-output
Environment=PROMPTS_DIR=/home/nish/workspaces/agent-state/fleet-landing-watch
Environment=PI_BIN=/home/nish/.local/bin/pi
WorkingDirectory=-/home/nish/workspaces/agent-state/fable-check
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HERMES_OUTBOUND_CLASSES=MONEY-BOUNDARY|LEGAL-BOUNDARY|PRODUCT-DIRECTION|CUSTOMER-DATA|CREDENTIAL-BOUNDARY|ONE-SHOT-PUBLIC-ACTION|daily-digest|weekly-digest|evening-highlights-digest|fable-check|fleet-landing-watch
ExecStartPre=/usr/bin/mkdir -p /home/nish/workspaces/agent-state/fable-check
ExecStart=/home/nish/.local/bin/agent-cron-run fable-check
Restart=on-failure
RestartSec=900
# fleet-ops#4906: three judges on 20-min offsets (:00 :20 :40 UTC) with a 19-min
# cap can never overlap. Type=oneshot ignores RuntimeMaxSec (systemd-analyze
# verify says so); TimeoutStartSec is the oneshot cap. MemoryMax keeps a judge
# from competing with workers.
TimeoutStartSec=19min
MemoryMax=2500M
# fleet-ops#4906 handoff: a judge killed at the cap could not run pause-safely; systemd
# appends the marker so the next judge inherits ~/.claude/resume-notes/fleet-judge.md.
# No "%" in this line on purpose: %s/%N are systemd specifiers (drill 2026-09-10 proved it).
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || echo "- $(date -u --iso-8601=seconds) fable-fleet-check ended $SERVICE_RESULT (exit $EXIT_CODE/$EXIT_STATUS) before finishing its pause-safely handoff: pick up from the last checked item above." >> /home/nish/.claude/resume-notes/fleet-judge.md'
