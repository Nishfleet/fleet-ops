# fleet-seat-comeback-release.timer — periodic ACTIVE release of walled seats
# fleet-ops#2421.
#
# Runs every 15 minutes, aligned with seat-caps.json
# walled_comeback.min_probe_interval_s=900. A walled seat whose wall clock
# (bench_until ?? usable_at) has passed is re-probed with a 1-token
# "Reply with exactly: OK" dispatch; a provably-usable seat is UNWALLED
# (healthy observation written to the ledger); a failed probe stays walled
# and the seat-health extension re-anchors the wall. A sweep that finds
# expired walls and releases nothing exits 1 (the stalled loud check).
# A run with nothing to do exits 0 (not a failure).

[Unit]
Description=Active come-back release for walled seats (fleet-ops#2421)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/2421
Requires=fleet-seat-comeback-release.service

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60
OnBootSec=5m

[Install]
WantedBy=timers.target