[Unit]
Description=Reload Grafana alerting and datasource provisioning (fleet-ops#9449 follow-up)
Documentation=https://grafana.com/docs/grafana/latest/developers/http_api/admin/#reload-provisioning-configurations
# 2026-10-23 18:01:57 IST a Grafana restart (fleet-ops#10038) met this unit's
# reload mid-flight: the reload could not reach Grafana for 30 s, so this unit
# failed, and fleet-grafana-github-token.service failed with it, because its
# ExecStartPost runs this very `systemctl start`.
# Restart=on-failure with RestartMode=direct (systemd 254+, 255 on this host):
# the retry restarts without passing through the failed state, so the token
# unit's start waits the retries out instead of failing with them, and
# OnFailure= fires once, when the start limit is spent. A retry whose
# ExecCondition= below exits 1 (Grafana stopped) skips the unit, and the skip
# counts as a success, which is what stops the retry loop once Grafana is gone
# for good.
# No After=fleet-grafana.service, even though the reload needs Grafana up: this
# unit is started from that token unit's ExecStartPost, and fleet-grafana.service
# has After= on the token unit, so an ordering edge back to Grafana would hold a
# Grafana start until its timeout. The retries are the wait: six starts,
# 20 s apart, inside the 300 s window the burst has to fit, which outlasts
# the 30 s Grafana window.
StartLimitIntervalSec=300
StartLimitBurst=6
OnFailure=fleet-unit-failed@%N.service

[Service]
Type=oneshot
Restart=on-failure
RestartMode=direct
RestartSec=20
# A stopped Grafana reads the files at its next start, so there is nothing to
# reload: exit 1 here skips the unit without failing it (man systemd.service,
# ExecCondition=).
ExecCondition=/usr/bin/systemctl --user is-active --quiet fleet-grafana.service
# git merge writes the changed files one after another; let the last one land.
ExecStartPre=/bin/sleep 5
# A provisioning file can name an $__env{} variable or a $__file{} path that
# only a new quadlet Environment= or Secret= line provides, and the running
# container does not have it yet. The deploy is one `git merge --ff-only`, so it
# writes the quadlet and the provisioning file together, and the reload below
# would answer 500 until something restarted fleet-grafana by hand (fleet-ops
# #9795: the 1h GitHub token would expire in that window and every webhook would
# 401). Compare the running container's environment names and secret names with
# the quadlet's Environment= and Secret= names, and restart fleet-grafana when
# one is missing, so the reload always runs against a process that can resolve
# every reference. The running fleet-grafana was started before
# FLEET_GITHUB_ISSUES_URL was added to the quadlet and was still running without
# it five days later. A container that already matches (every ordinary reload,
# including the 20 min token refresh) is left alone, and one whose names cannot
# be read is left alone too, so this never blocks the reload.
ExecStartPre=/bin/bash -c "d=$$(mktemp -d); q=%h/workspaces/tooling/fleet-ops-deploy-clone/containers/quadlet/fleet-grafana.container; { /usr/bin/podman inspect -f '{{range .Config.Env}}{{println .}}{{end}}' fleet-grafana 2>/dev/null | cut -d= -f1; /usr/bin/podman inspect -f '{{range .Config.Secrets}}{{println .Name}}{{end}}' fleet-grafana 2>/dev/null; } | sort -u > $$d/run; if [ ! -s $$d/run ]; then echo '[fleet-grafana-provisioning] could not read the running fleet-grafana environment; skipping the restart check'; rm -rf $$d; exit 0; fi; { sed -n 's/^Environment=\\([A-Za-z_][A-Za-z0-9_]*\\)=.*/\\1/p' \"$$q\"; sed -n 's/^Secret=\\([A-Za-z0-9_.-]*\\),.*/\\1/p' \"$$q\"; } | sort -u > $$d/want; miss=$$(comm -13 $$d/run $$d/want | tr '\\n' ' '); rm -rf $$d; if [ -n \"$$miss\" ]; then echo \"[fleet-grafana-provisioning] the running fleet-grafana is missing the quadlet names: $$miss; restarting fleet-grafana before the reload\"; /usr/bin/systemctl --user daemon-reload; /usr/bin/systemctl --user restart fleet-grafana.service; else echo '[fleet-grafana-provisioning] the running fleet-grafana has every Environment= and Secret= the quadlet sets'; fi"
ExecStart=/bin/bash -c "set -euo pipefail; f=$$1; test -s \"$$f\" || { echo \"grafana admin password file missing or empty: $$f\" >&2; exit 1; }; rc=0; for e in alerting datasources; do /usr/bin/curl -fsS --connect-timeout 5 --max-time 30 --retry 3 --retry-connrefused -X POST --config <(/usr/bin/sed 's/[\"\\\\]/\\\\&/g; s/^/user = \"admin:/; s/$$/\"/' \"$$f\") \"http://127.0.0.1:3001/api/admin/provisioning/$$e/reload\" || rc=1; echo; done; exit $$rc" bash %h/.config/fleet-ops/grafana-admin-password
TimeoutStartSec=120
