[Unit]
Description=Fleet seat-recovery trigger (fire intake on NO-USABLE-SEAT -> usable, fleet-ops#468)
# systemd.path: a StartLimit hit on THIS oneshot is propagated to
# fleet-seat-recovery.path and takes the watcher down (fleet-ops#617).
# The bin always exits 0; ledger writes are the expected trigger rate.
# fleet-ops#5106: the ExecStartPost activation hold below keeps every
# activation occupied for >=25s, so no trigger path can start this unit
# faster than ~2/min and the stock 5-per-10s StartLimit is structurally
# unreachable. The #617/#622-era accommodations (StartLimitIntervalSec=0,
# then 1h/2000) are removed, not raised: if the hold is ever deleted the
# write storm wedges this unit and the .path with it -> OnFailure ->
# senior auditor. That loud wedge is the intended regression tripwire.

# Event-driven: any write to the per-seat health ledger (a seat-health
# extension update) wakes this service. It compares the current "any seat
# usable?" verdict against the last one and fires pi-intake@<repo>.service
# INSTANTLY on the recovery transition — no waiting for the 15-min tick.
# Time-based bench expiry is the heartbeat's slow-path floor; this is the
# fast path for the common case (a health write marks a seat usable).

[Service]
Type=oneshot
ExecStart=/home/nish/.local/bin/fleet-seat-recovery
# fleet-ops#5106: activation hold. After the bin exits, the unit lingers
# in start-post for 25s; PathChanged events landing in the window enqueue
# start jobs that MERGE into the in-flight job instead of spawning new
# activations (proven live 2026-09-11: 16 trigger writes over 8s -> 2
# service starts, path unit stays active/success). The seats ledger is
# written every ~2s, so the hold coalesces the storm to <= ~144
# starts/h (acceptance: <200/h, from a measured 2419/h).
# Latency: the triggering write's own transition is processed immediately
# (the bin runs BEFORE the hold). A transition landing mid-hold merges
# into the in-flight job and is caught by the next activation ~25s + one
# ledger-write interval later — the bin re-reads the whole ledger each
# run — inside the issue's 30s bound. NO-USABLE-SEAT recovery is not
# debounced past this: the bin's own cooldown still gates the intake fire.
# TriggerLimit* on the .path unit is deliberately NOT the mechanism: on
# systemd 255 a hit places the .path unit into "trigger-limit-hit"
# failure and it stops watching until restarted (proven live: second
# write inside the window -> failed, OnFailure fired). That is the #617
# wedge class, not a debounce.
ExecStartPost=/bin/sleep 25
TimeoutStartSec=60

[Install]
WantedBy=default.target
