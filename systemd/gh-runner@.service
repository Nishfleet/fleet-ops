# fleet-ops#5935: ONE owned ephemeral GitHub Actions runner instance (%i in
# 1..3) as a systemd user unit. Enabled+started as gh-runner@{1..3}.
#
# Ephemeral by construction: every activation fetches a fresh single-use JIT
# registration (POST /orgs/Nishfleet/actions/runners/generate-jitconfig),
# runs exactly ONE job, deregisters, exits; Restart=always brings it back.
# That loop IS the fleet — no tokens, autoscaler or ARC. Registration rides
# the box's `gh` keyring auth (the worker App token 403s on org Actions —
# #1253).
#
# systemd $-expansion trap: $(...) works in ExecStartPre but is eaten in
# ExecStart, so ExecStart is argument-free — ExecStartPre writes
# .jit.env, ExecStart sources it and runs plain run.sh. JIT config goes via
# the ACTIONS_RUNNER_INPUT_JITCONFIG env var (config.sh rejects --jitconfig;
# proven 2026-09-12). The Exec* lines are `/bin/bash -c` so CI's
# systemd-analyze checks bash (present) rather than %h paths (absent).
#
# Labels: self-hosted,linux,x64,fleet-ci — heavy jobs select runs-on:
# fleet-ci on merge_group+push only; pull_request stays on ubuntu-latest so
# fork PRs never execute on the box (org fork-PR approval:
# all_external_contributors). Resource panel: fleet-ci.slice; this unit adds
# per-instance MemoryMax=3G.
#
# Install: systemctl --user link <repo>/systemd/gh-runner@.service; enable with
#   systemctl --user enable --now gh-runner@{1..3}

[Unit]
Description=GitHub Actions ephemeral self-hosted runner %i — one job per activation (fleet-ops#5935)
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
Slice=fleet-ci.slice
MemoryMax=3G
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
# Pin: actions/runner v2.337.0, linux-x64.
# sha256 70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613
# (computed from the release tarball 2026-09-12). Download+verify+extract
# once per instance dir; later activations reuse the extraction.
ExecStartPre=/bin/bash -c 'd=%h/.local/share/actions-runner/%i; mkdir -p "$d"; if [ ! -x "$d/run.sh" ]; then cd "$d" && curl -fsSL -o runner.tgz https://github.com/actions/runner/releases/download/v2.337.0/actions-runner-linux-x64-2.337.0.tar.gz && printf "%%s  runner.tgz\n" 70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613 | sha256sum -c - && tar xzf runner.tgz && rm -f runner.tgz; fi'
# Fresh single-use JIT registration EVERY activation (the runner deletes
# .runner after its one job, so the next start must reconfigure).
# runner_group_id=1 pins the org "Default" group (allows_public_repositories
# for the public Nishfleet repos). The runner name is unique per activation
# so a crashed predecessor's ghost registration cannot collide. The API
# response is FLAT (.encoded_jit_config). Fail-loud: an empty/422 token or
# unwritten env file aborts the unit instead of crash-looping into
# unregisterable states; the rm -f keeps a stale .runner from making the next
# config complain "already configured".
ExecStartPre=/bin/bash -c 'd=%h/.local/share/actions-runner/%i; cd "$d" && ./config.sh remove --unattended >/dev/null 2>&1 || true; rm -f .runner .credentials .credentials_rsaparams .jitconfig; tok=$(gh api -X POST orgs/Nishfleet/actions/runners/generate-jitconfig -f name=gh-runner-%i-$(date +%%s) -F runner_group_id=1 -f "labels[]=self-hosted" -f "labels[]=linux" -f "labels[]=x64" -f "labels[]=fleet-ci" --jq .encoded_jit_config) && { [ -n "$tok" ] && printf "ACTIONS_RUNNER_INPUT_JITCONFIG=%%s\n" "$tok" > "$d/.jit.env" && test -s "$d/.jit.env"; } || { echo "gh-runner: JIT registration failed (empty token / 422)" >&2; exit 1; }'
ExecStart=/bin/bash -c 'cd /home/nish/.local/share/actions-runner/%i && set -a && . ./.jit.env && exec ./run.sh'
Restart=always
RestartSec=40
# First activation on a cold instance dir downloads + verifies + extracts
# the 226MB pinned tarball — far past the 90s default start timeout.
TimeoutStartSec=600
TimeoutStopSec=120
# SIGTERM the whole control group on stop: run.sh spawns the +config/runnern
# process tree; a lone kill would orphan the dotnet process and wedge the job.
KillMode=control-group

[Install]
WantedBy=default.target
