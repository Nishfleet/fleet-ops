[Unit]
Description=Weekly baseline-delta strangeness report — Sun 04:10 IST
# Named reason: the Weekly Fleet Review (fleet-ops#1146) sits at 04:30 IST.
# This job is its pre-pass (fleet-ops#1151). Metric strangeness has no
# event to subscribe to, so a Sunday calendar fire after vps-weekly-update
# (Sun 03:30 IST + drain) and 20 minutes before the review is the correct
# trigger. Persistent so a missed Sunday still writes WFR/ before the next
# review.

[Timer]
OnCalendar=Sun *-*-* 04:10:00 Asia/Kolkata
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
