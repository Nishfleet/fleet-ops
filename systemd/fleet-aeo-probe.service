[Unit]
Description=Weekly AEO visibility probe for 0509 (fleet-ops#1236)
# Named reason: measurement-first GEO. Baseline whether ChatGPT / Perplexity
# / Claude cite 0509 on the sneaker money-queries, before any content bet.
# Weekly because the free SaaS category has no $0 recurring custom-prompt
# tracker (docs/aeo-visibility-eval.md). Missing API seats skip; they do
# not burn Claude Max or OpenRouter credits.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/nish/.local/libexec/fleet-aeo-probe.py --config /home/nish/.config/fleet-aeo/probe.json
TimeoutStartSec=20min
