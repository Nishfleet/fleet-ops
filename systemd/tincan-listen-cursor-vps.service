[Unit]
Description=Agent Tincan wake for cursor-vps (tincan listen -> headless agent drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
# A crash loop must reach `failed` for the hook above to run: the default
# 5 starts in 10 s is never spent at RestartSec=30 (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Environment=TINCAN_CONFIG=%h/.config/tincan/cursor-vps.json
Environment=FLEET_TASK_ID=tincan-cursor-vps
EnvironmentFile=%h/.config/fleet-ops/seats/cursor.env
StateDirectory=tincan-listen-cursor-vps
WorkingDirectory=%S/tincan-listen-cursor-vps
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/cursor-agent -p --yolo --trust --model auto "$$(cat /home/nish/.config/tincan/prompts/cursor-vps.txt)"'
Restart=always
RestartSec=30
[Install]
WantedBy=default.target
