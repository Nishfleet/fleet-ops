[Unit]
Description=One ask for OCI Always Free ARM (A1.Flex) capacity
# Named reason: Oracle's free 4-OCPU/24-GB ARM allowance is real but is
# "Out of host capacity" almost every time you ask for it. There is no
# notification API and no waitlist — repeated LaunchInstance calls are the only
# documented route onto the tier. This unit is ONE ask; oracle-arm-fish.timer
# owns the repetition, so no bash poll loop exists anywhere (fleet standing
# rule: no hand-built dispatchers).
#
# The script stands down (exit 0, ARM-FISH-VERDICT state=standdown) while
# ~/.oci/config or ~/.oci/fleet-arm.env is missing, so this unit is safe to
# enable before Nish has finished the Oracle signup.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/nish/.local/bin/oracle-arm-fish
TimeoutStartSec=25min
Nice=10
