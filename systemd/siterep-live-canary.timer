[Unit]
Description=Run the siterep.net live canary hourly

[Timer]
# Hourly (T3 deep tier). Was every 6h (00/6:17); retuned 2026-08-24 per packet
# p51 three-tier monitoring cadence (uptime 2min, deploy-smoke on-deploy, deep hourly).
OnCalendar=*-*-* *:17:00
Persistent=true
Unit=siterep-live-canary.service

[Install]
WantedBy=timers.target
