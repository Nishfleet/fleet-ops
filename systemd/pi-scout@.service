[Unit]
Description=Pi fleet product scout for Nishfleet/%i (generates work supply)

[Service]
# Second cut 2026-09-18: the scout IS this unit. bin/pi-scout-run's packet
# assembly + pick-seat is replaced by piping prompts/scout.md into the
# `worker-cheap` LiteLLM group directly — the same group pick-seat resolved to.
# The cheap and capable groups share the same upstream accounts, so the split
# is prompt-fit navigation, not isolation (fleet-ops#7786).
# The old ExecCondition (fleet-work-supply-canary) and the
# ExecStartPre/ExecStopPost pair (scout-futility-check) were fleet
# self-monitoring wrapped around the scout; over 7 days they failed more often
# than they succeeded (fleet-ops 241 started/184 failed, 0509 199/201), which is
# a gate that costs more work than it saves. Gone with the rest of the glue.
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
# App identity via the stock `gh token` extension (Link-/gh-token), not the
# retired bin/worker-token. Prompt comes from the Pi prompt template
# ~/.pi/agent/prompts/scout.md, invoked as `/scout <repo>`.
# Per-run invariants (hard rules, PR body contract, memory budget, D1 rules) live
# in the repo AGENTS.md and are appended to the system prompt, not re-pasted into
# every packet. `--append-system-prompt <file>` is Pi's own flag and takes file
# contents (proven on this host 2026-09-18). It is used instead of relying on Pi's
# AGENTS.md context-file discovery because that walks up from the STARTUP cwd, and
# this unit starts in /home/nish — the repo file would never be reached. Canonical
# path, never cwd-relative: the unit must not depend on which checkout it runs from.
# fleet-ops#8282: deploy-clone lock. A user unit cannot set up
# a mount namespace (ReadOnlyPaths= is recorded and then ignored; BindPaths=
# fails the unit with status=226/NAMESPACE), so the write protection is
# bubblewrap's: it is the stock tool Ubuntu exempts from
# kernel.apparmor_restrict_unprivileged_userns (/etc/apparmor.d/bwrap grants
# `userns`), so it really does get a mount namespace in a user unit. The host
# root is bound writable, /dev re-bound with device access, the deploy clone
# re-mounted read-only; the token mint, the prompt, the session dir and every
# other path are unchanged.
ExecStart=/usr/bin/bwrap --bind / / \
  --dev-bind /dev /dev \
  --ro-bind /home/nish/workspaces/tooling/fleet-ops-deploy-clone /home/nish/workspaces/tooling/fleet-ops-deploy-clone \
  --die-with-parent -- \
  /bin/sh -c 'set -e; GH_TOKEN=$(gh token generate --app-id 4728578 --key "$HOME/.config/fleet-worker/nishfleet-worker.private-key.pem" --installation-id 156789042 --token-only); export GH_TOKEN; echo "/scout %i" | exec pi --print --append-system-prompt "/home/nish/workspaces/tooling/fleet-ops-deploy-clone/AGENTS.md" --session-dir "$HOME/.pi/agent/sessions/pi-scout-%i" --provider litellm --model worker-cheap'
# ABORT GATE (fleet-ops#7524): an agent-decided abort ends `pi --print` at
# exit 0, so Result=success alone cannot tell a finished run from an aborted
# one — the 2026-09-17 fleet-ops scout aborted on a code-scanning 404 and
# still recorded green. The completed-run signature is the mandatory
# `supply:` summary line: this check greps THIS invocation's journal for it
# and fails the unit when it is absent. Same shape as the old issue-worker
# ExecStopPost artifact check — an artifact verdict, not a tool count.
# ExecStartPost only runs when ExecStart succeeded, so a pi-level failure
# (429 wall, token mint) keeps its real exit code untouched; and because a
# failing ExecStartPost stops the list, the keystone-hc ping drop-in is
# skipped on an abort too.
ExecStartPost=/bin/sh -c 'journalctl --user _SYSTEMD_INVOCATION_ID="$INVOCATION_ID" --no-pager -o cat | grep -qE "supply:[[:space:]]*ready_count=[0-9]+" || { echo "scout-abort-gate: no supply: line this invocation — run did not complete scouting" >&2; exit 1; }'
# 3h: measured scout turns run 13-22 min across 8 turns; 10800 is 1.6x the
# worst measured need and still fits inside the 4h OnCalendar cadence.
TimeoutStartSec=10800
