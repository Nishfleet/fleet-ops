[Unit]
Description=Pi fleet product scout for Nishfleet/%i (generates work supply)
OnFailure=pi-scout-repair@%i.service

[Service]
# Second cut 2026-09-18: the scout IS this unit. bin/pi-scout-run's packet
# assembly + pick-seat is replaced by piping prompts/scout.md into the
# `worker-cheap` LiteLLM group directly — the same group pick-seat resolved to.
# The old ExecCondition (fleet-work-supply-canary) and the
# ExecStartPre/ExecStopPost pair (scout-futility-check) were fleet
# self-monitoring wrapped around the scout; over 7 days they failed more often
# than they succeeded (fleet-ops 241 started/184 failed, 0509 199/201), which is
# a gate that costs more work than it saves. Gone with the rest of the glue.
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
ExecStart=/bin/sh -c 'eval "$(worker-token --print)"; export GH_TOKEN; { cat "$HOME/.pi/agent/prompts/scout.md"; echo; echo "TARGET REPO: Nishfleet/%i"; } | exec pi --print --provider litellm --model worker-cheap'
# 3h: measured scout turns run 13-22 min across 8 turns; 10800 is 1.6x the
# worst measured need and still fits inside the 4h OnCalendar cadence.
TimeoutStartSec=10800
