[Unit]
Description=Pi fleet product scout for Nishfleet/%i (buffer-gated work supply; creates scout-candidates for senior-auditor panel)
OnFailure=pi-scout-repair@%i.service

[Service]
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/nish
# Gate: run only when the drain-rate work buffer is below target.
# Exit 0 from fleet-heartbeat-buffer --gate %i means "scouts may run".
# The 4h timer is the fallback floor; heartbeat tier1 also dispatches this
# unit when the buffer is low.
ExecCondition=/bin/sh -c 'exec /home/nish/.local/bin/fleet-heartbeat-buffer --gate %i'
# Seat rotation is pi-scout-run's job (pick_seat). A pinned --provider
# previously died with HTTP 429 while healthy seats sat unused (fleet-ops#130).
# /bin/bash -c exec keeps systemd-analyze verify from needing a new CI stub
# (same shape as stop-escalation.service / unit-escalation@.service).
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/pi-scout-run %i scout'
TimeoutStartSec=1800
