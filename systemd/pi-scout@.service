[Unit]
Description=Pi fleet product scout for Nishfleet/%i (work supply for autonomous lanes; event-driven intake exists for claiming, but generation needs periodic product inspection)
OnFailure=pi-scout-repair@%i.service

[Service]
Type=oneshot
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/nish
ExecCondition=/bin/sh -c 'n=$$(gh issue list -R Nishfleet/%i -l agent-ready --json number --jq length 2>&1) || { echo "gh failed: $$n" >&2; exit 255; }; [ "$$n" -lt 12 ]'
ExecStart=/bin/sh -c '{ cat /home/nish/.pi/agent/prompts/scout.md; echo; echo "TARGET REPO: Nishfleet/%i"; } | /home/nish/.local/bin/pi --print --provider minimax --model MiniMax-M3'
TimeoutStartSec=1800
