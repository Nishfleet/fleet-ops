[Unit]
Description=Restore-drill the newest D1 backups, monthly (fleet-ops#10594)
# A weekly backup is only a claim until something has loaded it back. The drill
# runs on the first of the month, one day after the week's own dump, so it always
# has a fresh artifact to restore and never races a run in flight. It runs on
# this host because the private key is here and on no runner. See
# fleet-d1-restore-drill.service for what it proves and what it refuses to do.
# Switch off: systemctl --user disable --now fleet-d1-restore-drill.timer, then
# drop step 2j and its enable line from fleet-sync.service and delete both files.

[Timer]
OnCalendar=*-*-01 05:30:00 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
