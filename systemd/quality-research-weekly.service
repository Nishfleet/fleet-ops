[Unit]
Description=Weekly quality>speed>efficiency research sweep (fleet-ops#541)
# Named reason: the 2026-08-25 "continuous research" ledger line is a
# recurring delta sweep. agent-cron-run already owns seat rotation and
# pi --print; this unit is that runner with a weekly slug. Restart=on-failure
# re-seats a transient 429 instead of waiting until next Sunday.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# WORKDIR must differ from $HOME: agent-cron-run's fleet-ops#366/#983
# fail-closed guard FATALs on WORKDIR==$HOME (auditor 2026-09-12 — the
# #4656 import set WORKDIR=$HOME and every weekly fire start-limit'd).
Environment=WORKDIR=/home/nish/workspaces/agent-state
Environment=LOG_DIR=/home/nish/workspaces/agent-state/cron-output
Environment=PROMPTS_DIR=/home/nish/.pi/agent/prompts
Environment=PI_BIN=/home/nish/.local/bin/pi
ExecStart=/home/nish/.local/bin/agent-cron-run quality-research-weekly
Restart=on-failure
RestartSec=900
TimeoutStartSec=45min
