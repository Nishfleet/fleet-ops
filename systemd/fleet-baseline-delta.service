[Unit]
Description=Weekly baseline-delta strangeness report (fleet-ops#1151)
# Named reason (fleet-ops#378): unknown-unknown metric strangeness has no
# event to subscribe to. The Weekly Fleet Review (#1146, Sun 04:30 IST)
# needs a ranked pre-pass of fleet_* and key node_* series before it sits.
# A Sunday calendar fire after vps-weekly-update (03:30 IST) and before
# the review is the only correct trigger. Output is a report, never a page.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
ExecStart=/usr/bin/python3 /home/nish/.local/bin/fleet-baseline-delta
TimeoutStartSec=15min
# Never restart: the next Sunday (Persistent=true) is the retry. systemd's
# failed state plus FleetBaselineDeltaStale is the signal.
Restart=no
