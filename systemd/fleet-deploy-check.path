[Unit]
Description=Fleet merge-to-live deploy check — path watch on origin/main ref (replaces 2-min timer)
# Event-driven: fires when origin/main ref changes (merge lands).
# The 2-min timer is kept as a dead-man backstop (silence stays loud).
# Git updates refs via replace-by-rename; PathChanged catches close-after-write.
# PathExists catches the initial appearance. Both re-arm the check.
# fleet-ops#1460: the .path unit can fire rapidly — git updates refs via
# replace-by-rename, generating multiple inotify events per fetch. The default
# 5/10s burst is blown through, wedging the service (same wedge as
# fleet-seat-recovery #617 and vault-conflict-resolver). The check is idempotent
# (fetch + rev compare, deploy only if moved); raise the limit so a ref update
# cannot wedge the fast path. StartLimit* must live in [Unit] for .path units.
StartLimitIntervalSec=1h
StartLimitBurst=100

[Path]
PathChanged=/home/nish/workspaces/tooling/fleet-ops-deploy-clone/.git/refs/remotes/origin/main
PathExists=/home/nish/workspaces/tooling/fleet-ops-deploy-clone/.git/refs/remotes/origin/main
Unit=fleet-deploy-check.service

[Install]
WantedBy=default.target
