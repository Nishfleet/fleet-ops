[Unit]
Description=Loud Telegram page when a fleet unit fails (OnFailure= target)

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
# MONITOR_UNIT is set by systemd for OnFailure= activations (v250+).
# Hostname is resolved at send time — never hard-code a migration-era host literal.
ExecStart=/bin/sh -c '/home/nish/.local/bin/hermes send -t telegram "FLEET UNIT FAILED: ${MONITOR_UNIT:-unknown unit} on $(hostname -s) — check: systemctl --user status ${MONITOR_UNIT:-}"'
TimeoutStartSec=60
