# systemd-oomd policy for the pi worker slice — the LAST-resort kill layer.
# Per-worker bounds are MemoryMax on the worker units (fleet-ops + 0509: 4G,
# no MemoryHigh — fleet-ops#3930); the MIN_FREE_RAM_MB=2500 launch floor
# prevents work starting. 80% is deliberately far above routine (baseline
# /proc/pressure/memory avg10 = 0.00): a slow worker beats a killed one.
# Kill path proven live 2026-08-26 (fleet-ops#71). The 60s duration is
# global-only — repo-owned at systemd/system/oomd.conf.d/99-fleet.conf —
# because ManagedOOMMemoryPressureDurationSec is not a per-slice key in
# systemd 255. Rest of the stack: user-1000.slice.d/50-ram-governor.conf
# (12 GiB cap) and the neutralized stock user@ 50% rule
# (user@1000.service.d/50-no-distro-oomd-kill.conf) — all under systemd/system/.
# Scope: this slice only — lifelines (sshd, tailscaled, intake timers) stay
# `auto`. ManagedOOMSwap stays `auto` too: swapped idle-on-API pages are
# healthy here and killing on swap would reap useful work.
[Slice]
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
