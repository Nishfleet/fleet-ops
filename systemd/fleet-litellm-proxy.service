[Unit]
Description=Fleet LiteLLM proxy — seat routing organ (fleet-ops#4130 P1)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/4130
# Hard dependency: the venv + config must exist before we start, otherwise
# the proxy exits at import time with a missing-config diagnostic. The
# live install (apt + pip + start) is Nish-gated; this unit ships the
# shape, the deploy is in docs/litellm-postgres-setup.md.
ConditionPathExists=%h/.config/fleet-ops/litellm-proxy.yaml
# Hard dependency on the fleet-owned Postgres + Redis daemons (Nish,
# 2026-09-07 reopen of fleet-ops#4174): the proxy is ordered After= both
# and Requires= both, so systemd starts them first and pulls the proxy
# down if either dies. The proxy's own /health/readiness proves the DB
# connection; the canary pages on any of the three going absent. This is
# the real long-running-daemon shape — the earlier Wants= + oneshot
# readiness-marker shape left Postgres/Redis as Type=oneshot "active
# (exited)" and the proxy started before the DB socket was up.
Requires=fleet-litellm-postgres.service fleet-litellm-redis.service
After=fleet-litellm-postgres.service fleet-litellm-redis.service
# StartLimit* are [Unit]-section keys; in [Service] systemd ignores them
# ("Unknown key name ... in section 'Service'") and the documented storm
# cap silently falls back to the 10s/5 default. 60s/5 makes the P4 drill
# contract real: after 5 rapid failures the proxy stays down for the rest
# of the minute instead of retry-churning at RestartSec=2s.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
Slice=app-litellm.slice
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# The config is operator-owned (lives in ~/.config, not the repo) so keys
# resolved through the existing credential resolvers never enter the repo
# or the unit file. The repo copy at config/litellm-proxy.yaml is the shape
# reference ONLY — it is deliberately not a MANIFEST install target, because
# dropping *.example baseUrls over a live router would cut the organ's seats
# (fleet-ops#4174 reopen). ConditionPathExists above gates on this exact %h
# path: if the operator has not created it, the unit stays condition-skipped
# rather than crash-looping. Keep the two paths in sync.
Environment=LITELLM_PROXY_CONFIG=%h/.config/fleet-ops/litellm-proxy.yaml
# Loopback only — never expose the proxy on a public interface. Pi speaks
# to it over 127.0.0.1:4000.
#
# The start wrapper is REQUIRED, not cosmetic (fleet-ops#4174 reopen):
#   1. LiteLLM 1.98 does not support `api_key: command:...` in the config —
#      it supports `os.environ/<NAME>`. The wrapper sources the existing
#      credential env files and reads the OAuth token out of auth.json into
#      the process environment, so no key value ever enters the repo or a
#      unit file.
#   2. LiteLLM's Prisma layer reads DATABASE_URL from the ENVIRONMENT, not
#      from general_settings.database_url. Without the export the proxy
#      exits 3 at startup with P1012 ("the URL must start with the protocol
#      postgresql://") — that is exactly how the organ died before the
#      wrapper existed.
#   3. It pins the venv binary explicitly instead of relying on PATH.
# Install it per docs/litellm-postgres-setup.md §3; the runbook carries the
# script, so a bare-metal rebuild reproduces the organ from repo + runbook.
# The wrapper is invoked through /usr/bin/env so the unit's first ExecStart
# token is a runner-safe bin: CI's systemd-analyze job (which only checks the
# first token) and p14-unstubbed-unit-verify both pass WITHOUT a Workflows-
# scope ci.yml stub (fleet-ops#4398). /usr/bin/env execs the wrapper via its
# shebang, so the live organ is unchanged.
ExecStart=/usr/bin/env /home/nish/.local/bin/fleet-litellm-proxy-start
# Master key for virtual-key minting (operator-owned, generated once per
# the runbook and stored root-owned/0600 in ~/.config/fleet-ops — the value
# is NEVER in the repo). The live config's general_settings.master_key is
# `os.environ/LITELLM_MASTER_KEY`, so the process env must carry the key;
# load it here from the operator env file. This was hand-placed as a
# real-file drop-in override during the fleet-ops#4181 live install and
# hid from the unit-name-only hunt (fleet-ops#2924 / #1548); folded into
# the base unit so the repo unit is the single source of truth and the
# stray override can be deleted (fleet-ops#4470).
EnvironmentFile=/home/nish/.config/fleet-ops/litellm-master-key.env
# Restart on any failure (import error, bind conflict, upstream crash).
# 2s delay + the [Unit]-section StartLimit* above bound the storm. The
# P4 drill proves workers fail loud <60s when the proxy stays down.
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15
# Hardening: the proxy only needs to bind a loopback socket and read its
# config + credential resolvers. No write needs to escape the venv cache.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/venvs/litellm %h/.config/fleet-ops
PrivateTmp=true

[Install]
WantedBy=default.target
