[Unit]
Description=Rotate pi-packet watch.log every 10 min (fleet-ops#3272)

[Timer]
# Off-peak minute :2 so the 10-min cadence avoids the dense heartbeat/timer
# cluster at :00, :13, :15, :17, :23, :38, :39, :43, :48, :52.
OnCalendar=*:2/10
RandomizedDelaySec=60
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
