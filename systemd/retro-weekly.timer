# Weekly /retro schedule (fleet-ops#9314): Monday 07:00 IST, one week of fleet
# sessions per run.
#
# Persistent=true: a slot the host missed (power cut, a run killed by the
# service's TimeoutStartSec) catches up on the next boot or manager reload
# instead of being dropped, so the weekly retro never silently skips a week.
#
# Enabled by hand once after the proof run (README "Weekly retro"); fleet-sync
# links the pair but does not enable it, so a hand disable stays disabled.
[Timer]
OnCalendar=Mon *-*-* 07:00:00 Asia/Kolkata
Persistent=true

[Install]
WantedBy=timers.target
