# fleet-seat-corpse-retire.timer — daily retirement of corpse seat ledgers
# past the seat-dead threshold (fleet-ops#2469).
#
# Why daily: a seat becomes a corpse only after consecutive_failure_count
# crosses seat_dead_consecutive_threshold (default 25, fleet-ops#2145) or
# observed_at crosses seat_dead_quota_age_s (24h) on a quota_exhausted seat.
# Both thresholds take days to fire, so a daily sweep is more than enough
# resolution — the bin's purpose is to keep the live roster from growing
# corpses, not to alarm in real time. Cadence matches the seat-dead default
# window, not a free-floating every-15-min slot: the existing
# fleet-seat-comeback-release.timer already covers every-15-min wall-clock
# sweep (fleet-ops#2421), and overloading corpse retirement onto that path
# would conflate two semantically distinct operations (active release vs
# terminal retirement).
#
# OnCalendar=04:30 UTC = 10:00 IST: chosen so the daily corpus-retirement
# runs AFTER the heartbeat (:17/:47) and the metrics-export (every 5 min)
# have settled for the day, and BEFORE the Weekly Fleet Review (Sun 04:30
# UTC). The Daily Digest (#1216) picks up the post-run roster from the
# morning tick.

[Unit]
Description=Daily corpse seat ledger retirement (fleet-ops#2469)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/2469
Requires=fleet-seat-corpse-retire.service

[Timer]
OnCalendar=*-*-* 04:30:00 UTC
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
