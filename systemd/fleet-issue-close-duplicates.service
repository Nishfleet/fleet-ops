[Unit]
Description=Duplicate-issue drain — daily (fleet-ops#3270, was heartbeat §21)
# Named reason for this schedule (vault: "a schedule needs a named
# reason"): duplicate issues split worker effort and confuse the queue —
# two workers can be dispatched to the same underlying problem. The drain
# clusters open issues by title+body token overlap; the oldest stays
# canonical and the rest close with a `duplicate-of` comment. Capped per
# run. Fail-closed: FLEET_CLOSE_DUPLICATES_OK=1 is set only here, so
# one-off tests cannot phantom-close real issues (fleet-ops#820).
# Previously ran every 15 min inside fleet-heartbeat-tier1 §21; #3270 moved
# it behind gh-webhook-receiver, which was deleted on 2026-09-18 after
# dispatching zero events ever. The companion timer is now the only trigger.
#
# OnFailure is wired by the global service.d/10-escalate.conf drop-in
# (unit-escalation@fleet-issue-close-duplicates.service).

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=FLEET_CLOSE_DUPLICATES_OK=1
WorkingDirectory=/home/nish
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/fleet-issue-file close-duplicates'
TimeoutStartSec=10min
# Never restart: the daily timer is the retry.
Restart=no
