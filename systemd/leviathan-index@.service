[Unit]
# Re-reads every log line in the %i source paths, then leaves the new or
# changed ones in the FTS5 index. The first run per instance is the slow one
# (minutes); later runs are the same scan, deduped at the store, so the index
# only grows with the logs. Nice and idle I/O keep it out of the way of agent
# work; a run outliving RuntimeMaxSec is killed and pages through
# fleet-unit-failed@. Config and index live in ~/.local/share/leviathan/,
# installed from config/leviathan/ by fleet-sync.service (the config must
# exist before this unit can run, so it is never read from the deploy clone,
# which only has it after the merge that ships this unit).
Description=Refresh the Leviathan session-log search index for %i
OnFailure=fleet-unit-failed@%n.service

[Service]
Type=oneshot
Environment=LEV_BIN=/home/nish/.local/bin/leviathan
Environment=LEV_DIR=/home/nish/.local/share/leviathan
ExecStart=/bin/sh -c 'exec "$LEV_BIN" index -c "$LEV_DIR/%i.toml" --index "$LEV_DIR/%i.db"'
Nice=19
IOSchedulingClass=idle
# Measured 2026-10-06: the pi scan peaks at 1.1G RAM (claude is smaller), so
# the caps sit ~2x over the real peak. MemoryHigh throttles first and a
# throttled run that outlives TimeoutStartSec fails and pages — the intended
# signal when the logs outgrow the caps.
MemoryHigh=2G
MemoryMax=3G
RuntimeMaxSec=600
# systemd 255 ignores RuntimeMaxSec= for Type=oneshot (measured: verify
# prints "has no effect ... Ignoring", and a sleep-30 oneshot with
# RuntimeMaxSec=2 ran the full 30 s). The bound that works for oneshot is
# TimeoutStartSec= (measured: a sleep-30 oneshot with TimeoutStartSec=2 died
# at 2 s, Result=timeout, so OnFailure= pages) — same 600 s deadline.
TimeoutStartSec=600
