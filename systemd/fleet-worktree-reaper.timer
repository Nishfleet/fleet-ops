[Unit]
Description=Orphan agent-worktree reaper — daily GC (fleet-ops#2227 + #2637)

[Timer]
# Named reason (vault: "a schedule needs a named reason"): worktree
# accumulation is a monotonic growth invariant with no event signal — a
# merged claim leaves its worktree behind silently. Daily caught a day's
# worker churn within one waking window, but on 2026-09-11 DiskWillFillIn24h
# fired: worker churn (~30GB/h bursts) outpaced a single daily drain and the
# disk hit 70% with a 24h fill prediction. Every 6h keeps the orphan tail
# bounded between daily peaks. The reaper is fail-safe (4 gates, dry-run
# capable) and cheap (git + one gh pr list per repo), so 4x/day is proportionate.
OnCalendar=*-*-* 03,09,15,21:30:00
RandomizedDelaySec=30min
Persistent=true
AccuracySec=1h

[Install]
WantedBy=timers.target
