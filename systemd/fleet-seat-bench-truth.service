# fleet-seat-bench-truth.service — event-driven bench-truth PONG sweep
# (fleet-ops#5285). Triggered by fleet-seat-bench-truth.path on any write to
# the seats ledger dir; runs the same bin's --false-wall-only mode: every
# non-money future wall longer than 15 min on a cap>0 seat is PONG-probed at
# min(advertised reset, 15 min) and released with source=bench_truth_probe
# on success (a bench lie, counted in fleet_seat_bench_lied_total). The
# Per-seat 15-min probe interval and 60s sweep debounce limit probe work.
# The 30s post-sweep hold coalesces path events before another service start
# (#6665). StartLimitIntervalSec=0 avoids wedging the watcher (#5093).

[Unit]
Description=Bench-truth PONG sweep on seats-ledger writes (fleet-ops#5285)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/5285
# Same convention as fleet-seat-recovery.service (fleet-ops#622): the
# StartLimit must tolerate the write storm; the bin debounces the side
# effects. StartLimit* must live in [Unit], not [Service].
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/fleet-seat-comeback-release --false-wall-only'
# Stay activating even after a debounce skip; path changes cannot start a
# second copy. At most 121 successful starts per closed one-hour window.
ExecStartPost=/bin/sleep 30
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min
