[Unit]
Description=Agent Tincan wake for command-code (tincan listen -> headless command-code drains the inbox)
Wants=network-online.target
After=network-online.target
OnFailure=fleet-unit-failed@%N.service
# A crash loop must reach `failed` for the hook above to run: the default
# 5 starts in 10 s is never spent at RestartSec=30 (fleet-ops#10253).
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Environment=TINCAN_CONFIG=/home/nish/.config/tincan/command-code.json
Environment=FLEET_TASK_ID=tincan-command-code
StateDirectory=tincan-listen-command-code
WorkingDirectory=%S/tincan-listen-command-code
ExecStart=/home/nish/.local/bin/tincan listen --exec '/home/nish/.local/bin/command-code -p "$$(cat /home/nish/.config/tincan/prompts/command-code.txt)" --trust --yolo'
Restart=always
RestartSec=30
[Install]
WantedBy=default.target
