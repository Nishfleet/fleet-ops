[Unit]
Description=Sync the fleet-ops deploy clone and reload systemd (fleet-ops third cut)
# Replaces install.sh + MANIFEST + bin/fleet-ops-deploy + bin/fleet-deploy-check
# + bin/fleet-ops-drift.py (5,948 LOC). Those existed to COPY files from the
# repo to their live paths and then to detect the drift that copying creates.
# Every user-scope live path is already a symlink into this repo
# (`systemctl --user list-unit-files` reports the units as `linked`), so there
# is nothing to copy and nothing that can drift: a `git pull` IS the deploy.
#
# man systemctl: "link PATH...  Link a unit file that is not in the unit file
# search path into the unit file search path. This command expects an absolute
# path to a unit file." A new unit file added to systemd/ is wired once, by
# hand, with `systemctl --user link` + `enable --now` (see README "Install").
# There is no installer to run and no manifest to keep in step.
StartLimitIntervalSec=1h
StartLimitBurst=100

[Service]
Type=oneshot
# 1. Fast-forward the clone, and log what the pull did. A dirty tree or a
#    diverged branch fails LOUD here, which is the correct behaviour: the
#    live source must be clean origin/main, and a failed unit is visible to
#    the failed-unit sweep. The log line is the deploy record
#    lib/fleet-deploy-quality.py reads (merge -> live latency); it replaces
#    the identical line the deleted fleet-deploy-check used to print.
#    `$$` is a literal `$` for the shell: systemd expands $VAR in ExecStart
#    before sh ever sees it, and `%%` is a literal `%` (systemd specifier).
ExecStart=/usr/bin/sh -c 'r=/home/nish/workspaces/tooling/fleet-ops-deploy-clone; b=$$(git -C "$$r" rev-parse HEAD); git -C "$$r" pull --ff-only origin main || { echo "[$$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)] [fleet-sync] DEPLOY-BLOCKED pull --ff-only refused (dirty or diverged clone)"; exit 1; }; a=$$(git -C "$$r" rev-parse HEAD); if [ "$$b" != "$$a" ]; then echo "[$$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)] [fleet-sync] origin/main moved $$b -> $$a — invoking sanctioned deploy"; else echo "[$$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)] [fleet-sync] origin/main unchanged (HEAD=$$a) — nothing to do"; fi'
# 2. Re-read the linked unit files. The symlinks never move; only their
#    contents changed with the pull.
ExecStart=/usr/bin/systemctl --user daemon-reload
# 3. Validate the alert rules before they can reach prometheus. promtool is
#    the built-in checker; a parse error stops the unit here instead of
#    silently leaving prometheus on the old rules.
ExecStart=/usr/bin/promtool check rules /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/fleet_rules.yml
# 4. /etc/prometheus/fleet_rules.yml stays a root-owned COPY, not a symlink:
#    prometheus runs as user `prometheus` and /home/nish is 0750 nish:nish, so
#    it cannot traverse into the repo (proved: `sudo -u prometheus test -r
#    <repo>/config/fleet_rules.yml` fails). Copy only when the bytes changed,
#    then HUP prometheus (ExecReload is kill -HUP; SIGHUP re-reads the whole
#    config, rules and scrape jobs).
ExecStart=/usr/bin/sh -c 'cmp -s /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/fleet_rules.yml /etc/prometheus/fleet_rules.yml || { sudo -n install -D -m 0644 -o root -g root /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/fleet_rules.yml /etc/prometheus/fleet_rules.yml && sudo -n systemctl reload prometheus; }'
# 4b. /etc/prometheus/prometheus.yml is the same class of root-owned copy
#     (fleet-ops#8084). The #7954 alertmanager scrape job reached the repo
#     file and never the live one, so up{job="alertmanager"} stayed absent
#     and FleetNishPageRailDown sat red. SIGHUP re-reads the whole file
#     (scrape jobs included), not rules only. promtool check config runs
#     first so a bad file never replaces the live one.
ExecStart=/usr/bin/sh -c 'src=/home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/prometheus.yml; dst=/etc/prometheus/prometheus.yml; cmp -s "$$src" "$$dst" || { promtool check config "$$src" && sudo -n install -D -m 0644 -o root -g root "$$src" "$$dst" && sudo -n systemctl reload prometheus; }'
# 5. prometheus-am-executor -f path is user-scope, so it can be a symlink
#    into the clone (house pattern). Relink when the live path is a regular
#    file or points elsewhere.
ExecStart=/usr/bin/sh -c 'src=/home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/prometheus-am-executor.yml; dst=/home/nish/.config/prometheus-am-executor/config.yml; mkdir -p /home/nish/.config/prometheus-am-executor; if [ ! -L "$$dst" ] || [ "$$(readlink "$$dst")" != "$$src" ]; then ln -sfn "$$src" "$$dst"; echo "[$$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)] [fleet-sync] linked prometheus-am-executor config -> $$src"; fi'
# 6. The executor reads that file once at start; a pull that changed it must
#    bounce the unit or the new command line never loads (fleet-ops#7414 —
#    the loose-ends: am-executor-claim-reload gap that left the #6347 claim
#    wrap unloaded for days while every spawn logged `pi: not found`). Blob
#    SHA vs a stamp file, so it restarts only on real drift.
ExecStart=/usr/bin/sh -c 'r=/home/nish/workspaces/tooling/fleet-ops-deploy-clone; s=/home/nish/.config/prometheus-am-executor/.sha; h=$$(git -C "$$r" rev-parse HEAD:config/prometheus-am-executor.yml); [ "$$(cat "$$s" 2>/dev/null)" = "$$h" ] || { systemctl --user try-restart prometheus-am-executor.service && echo "$$h" > "$$s"; }'
# 7. user-tmpfiles.d is read by systemd-tmpfiles --user once per clean pass,
#    so it is a plain user-scope config — same symlink-into-clone pattern as
#    step 5 (fleet-ops#4256). ln -sfn is idempotent: relink every sync.
ExecStart=/usr/bin/sh -c 'mkdir -p /home/nish/.config/user-tmpfiles.d && ln -sfn /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/user-tmpfiles.d/agent-worktrees.conf /home/nish/.config/user-tmpfiles.d/agent-worktrees.conf'
# 8. LINK-GUARD (fleet-ops#7743): machine wiring is hand-set symlinks, so a
#    session CAN still point a live path at a throwaway checkout — the
#    2026-09-18 incident linked standing-rules-render into a churning clone
#    and it dangled when the files vanished. After every pull, fail LOUD on
#    any symlink in the live wiring roots (README "Allowlist" set + the
#    vault) that is broken (`-xtype l`: target missing or unreadable) or
#    whose link text names a throwaway root — *worktrees/, agent-state
#    (worktrees live there too), */tmp/. A failed unit is the page.
ExecStart=/usr/bin/sh -c 'b=$$(find /home/nish/.config/systemd/user /home/nish/.local/bin /home/nish/.pi/agent /home/nish/workspaces/tooling/nish-vault -xtype l -o -type l -lname "*worktrees/*" -o -type l -lname "*/agent-state/*" -o -type l -lname "*/tmp/*" 2>/dev/null); [ -z "$$b" ] || { echo "[fleet-sync] LINK-GUARD live symlink -> dead/throwaway target: $$b"; exit 1; }'
# 8. /etc/hosts gains EXACTLY one line, and this is what keeps it there
#    (fleet-ops#8259, docs/CONTAINER-WORKER.md section 4). The litellm
#    provider baseUrl in config/pi-models.json is
#    http://litellm.fleet.local:4000 so ONE models.json serves both host-side
#    Pi (name -> 127.0.0.1) and the container (name -> 10.0.2.2, injected by
#    --add-host on systemd/pi-issue@.container). Append-only and idempotent:
#    grep first, so the constant is never rewritten and every other line in
#    /etc/hosts (localhost, the host's own name) is left untouched.
ExecStart=/usr/bin/sh -c 'grep -qE "^127[.]0[.]0[.]1[[:space:]]+litellm[.]fleet[.]local" /etc/hosts || echo "127.0.0.1 litellm.fleet.local" | sudo -n tee -a /etc/hosts > /dev/null'
TimeoutStartSec=300

[Install]
WantedBy=default.target
