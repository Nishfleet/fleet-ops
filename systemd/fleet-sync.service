[Unit]
Description=Sync the fleet-ops deploy clone and reload systemd (fleet-ops third cut)
# Replaces install.sh + MANIFEST + bin/fleet-ops-deploy + bin/fleet-deploy-check
# + bin/fleet-ops-drift.py (5,948 LOC). Those existed to COPY files from the
# repo to their live paths and then to detect the drift that copying creates.
# Every user-scope live path is already a symlink into this repo
# (`systemctl --user list-unit-files` reports the units as `linked`), so there
# is nothing to copy and nothing that can drift: a `git pull` IS the deploy.
# Root-owned files that cross a privilege boundary are fleet-host-config.service's
# job (Ansible, rootfs/), not this unit's: see steps 3-4.
#
# man systemctl: "link PATH...  Link a unit file that is not in the unit file
# search path into the unit file search path. This command expects an absolute
# path to a unit file." A new unit file added to systemd/ is wired once, by
# hand, with `systemctl --user link` + `enable --now` (see README "Install").
# There is no installer to run and no manifest to keep in step.
StartLimitIntervalSec=1h
StartLimitBurst=100
OnFailure=fleet-unit-failed@%N.service

[Service]
Type=oneshot
# 0. Dirty working tree (fleet-ops#9033): print DEPLOY-BLOCKED and fail
#    before fetch/merge. git merge --ff-only already refuses a dirty tree,
#    but its wording is quiet; this line is the loud journal marker the
#    map and RUNBOOK name, and OnFailure= pages.
ExecStart=/bin/sh -c 'git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone diff --quiet && git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone diff --cached --quiet || { echo DEPLOY-BLOCKED; exit 1; }'
# 0a. A clone whose HEAD is on a branch deploys that branch (its unit and config
#    files are live symlinks into it), so this is a failed deploy, not a quiet one
#    (fleet-ops#9437): on 2026-10-08 a review session left pr-9426 checked out here
#    and, until someone switched main 11 minutes later, the live files came from an
#    unmerged branch; the merge below was what noticed, with the quiet "Not
#    possible to fast-forward". This check runs before the fetch and prints the
#    same DEPLOY-BLOCKED marker step 1e prints. It reads HEAD's symref, not
#    `rev-parse --abbrev-ref`, because a detached HEAD has no branch to name and
#    that command would print the literal HEAD as if it were one.
ExecStart=/bin/sh -c 'cd %h/workspaces/tooling/fleet-ops-deploy-clone || { echo "DEPLOY-BLOCKED: no deploy clone at %h/workspaces/tooling/fleet-ops-deploy-clone, so no unit or config was updated."; exit 1; }; b=$$(git symbolic-ref -q --short HEAD || echo detached); if [ "$$b" = detached ]; then w="a detached HEAD"; else w="branch $$b"; fi; [ "$$b" = main ] || { echo "DEPLOY-BLOCKED: the deploy clone has $$w checked out, so no unit or config was updated."; echo "  fix: git -C %h/workspaces/tooling/fleet-ops-deploy-clone switch main, then review in a worktree, not the deploy clone (fleet-ops#9437)"; exit 1; }'
# 0b. Install the guard that keeps it on main (fleet-ops#9437): the
#    reference-transaction hook rejects any HEAD update that is not a move of
#    refs/heads/main, so an accidental `git checkout` or `git switch --detach` in
#    this clone fails before it happens instead of deploying an unmerged branch.
#    It copies the clone's own config/git-hooks/reference-transaction into
#    .git/hooks, and does not set core.hooksPath: that setting switches off every
#    other hook in .git/hooks, and a copy switches off none. It runs on every sync
#    before the merge, so a hand delete does not stick, the install needs no root,
#    and the hook is always this clone's copy. Off switch: delete this step and
#    `rm <clone>/.git/hooks/reference-transaction`.
ExecStart=/usr/bin/install -m 0755 %h/workspaces/tooling/fleet-ops-deploy-clone/config/git-hooks/reference-transaction %h/workspaces/tooling/fleet-ops-deploy-clone/.git/hooks/reference-transaction
# 1. Fast-forward the clone deterministically (fleet-ops#8893).
#    `git pull --ff-only origin main` delegates to `git merge --ff-only FETCH_HEAD`,
#    and a multi-entry `FETCH_HEAD` (e.g. from a concurrent `git fetch` in the
#    deploy clone, or a multi-valued `branch.main.merge` config) makes merge refuse
#    with `fatal: Cannot fast-forward to multiple branches`, silently stopping the
#    whole deploy. Fetch main into its remote-tracking ref explicitly, then merge
#    that named ref — a single commit can never produce the multi-branch refusal.
ExecStart=/usr/bin/git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone fetch --no-tags origin refs/heads/main:refs/remotes/origin/main
ExecStart=/usr/bin/git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone merge --ff-only refs/remotes/origin/main
#    Probe (fleet-ops#8893): the step above is now deterministic, but a deploy
#    window that ever ends with HEAD not equal to origin/main is a silent stop.
#    `git diff` would compare trees and miss an empty commit, so assert commit
#    identity in both directions: origin/main is an ancestor of HEAD (HEAD is not
#    behind) AND HEAD is an ancestor of origin/main (HEAD is not ahead). Together
#    those are true only when HEAD == origin/main; either false exits non-zero and
#    the unit fails loud, so OnFailure=fleet-unit-failed@ pages instead of the clone
#    quietly lagging.
#    fleet-ops#9967: "fail loud" shipped as a bare git exit code, so the six red
#    deploy-box runs printed only `exit code 1`. The cause — a session had checked a
#    work branch out in the deploy clone, so the clone was a commit ahead of main —
#    lived in the journal alone, and each run took a manual read to explain. One sh
#    line now prints DEPLOY-BLOCKED, the branch and head it found, the commits that
#    are not on main, and the fix.
ExecStart=/bin/sh -c 'cd %h/workspaces/tooling/fleet-ops-deploy-clone || { echo "DEPLOY-BLOCKED: no deploy clone at %h/workspaces/tooling/fleet-ops-deploy-clone, so no unit or config was updated."; exit 1; }; if git merge-base --is-ancestor refs/remotes/origin/main HEAD && git merge-base --is-ancestor HEAD refs/remotes/origin/main; then exit 0; fi; echo "DEPLOY-BLOCKED: the deploy clone is not at origin/main, so no unit or config was updated."; echo "  branch $$(git rev-parse --abbrev-ref HEAD), head $$(git rev-parse --short HEAD), origin/main $$(git rev-parse --short refs/remotes/origin/main)"; git log --oneline -n 20 refs/remotes/origin/main..HEAD | sed "s/^/  not-on-main: /"; echo "  fix: git -C %h/workspaces/tooling/fleet-ops-deploy-clone switch main, then work from a worktree, not the deploy clone"; exit 1'
# 2. Link the OnFailure handler, then re-read unit files. Link first so
#    daemon-reload loads fleet-unit-failed@.service (fleet-ops#9033).
ExecStart=/usr/bin/systemctl --user link /home/nish/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-unit-failed@.service
# 2.1 The retired weekly retro and the stale user copy of the tincan claude
#     listener (fleet-ops#10125) left live links to deleted deploy-clone files.
#     Stop the units first, while the links still resolve, so a Monday slot
#     cannot start a deleted service; then rm the unit links and every enable
#     link. The *.wants glob covers whichever target the [Install] section
#     named, so no dangling link survives in a directory this list did not
#     guess. rm -f is a no-op once they are gone, and without it LINK-GUARD
#     fails on the dangling links. Both rm lines carry the - prefix: a link
#     that cannot be removed is the next run's problem, not a reason to stop
#     this deploy. The root tincan-listen-claude-vps.service is a system unit
#     and is not touched here. Off switch: delete this step.
ExecStart=-/usr/bin/systemctl --user stop retro-weekly.timer retro-weekly.service retro-weekly-api.socket tincan-listen-claude-vps.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/retro-weekly.service %h/.config/systemd/user/retro-weekly.timer %h/.config/systemd/user/retro-weekly-api.service %h/.config/systemd/user/retro-weekly-api.socket %h/.config/systemd/user/*.wants/retro-weekly.timer %h/.config/systemd/user/*.wants/retro-weekly-api.socket %h/.config/systemd/user/tincan-listen-claude-vps.service %h/.config/systemd/user/tincan-listen-claude-vps.service.d/10-nish-seat.conf %h/.config/systemd/user/*.wants/tincan-listen-claude-vps.service
ExecStart=-/bin/rmdir --ignore-fail-on-non-empty %h/.config/systemd/user/tincan-listen-claude-vps.service.d
# 2a. The per-repo PR sweep timer is retired (fleet-ops#10935 step 3): GitHub's own
#     schedule on agent-dispatch.yml is the sweep's trigger. Step 2.1's shape: stop
#     the instances while the manager still holds them, then rm the template links
#     and the enable links, named outright because ExecStart expands no glob. The
#     instance timer links themselves dangle the same way when a host wired them
#     at top level: this box held fleet-pr-sweep@fleet-ops.timer -> the deleted
#     clone file, and LINK-GUARD failed every deploy until this rm named them
#     (fleet-ops#11544). Delete this step once a deploy has run it.
ExecStart=-/usr/bin/systemctl --user stop fleet-pr-sweep@fleet-ops.timer fleet-pr-sweep@0509.timer fleet-pr-sweep@drive.timer fleet-pr-sweep@aiconverter-app.timer fleet-pr-sweep@TinyStudio.io-public.timer fleet-pr-sweep@siterep-public.timer fleet-pr-sweep@rera-report-card.timer fleet-pr-sweep@seo-fix-kit.timer
ExecStart=-/bin/rm -f %h/.config/systemd/user/fleet-pr-sweep@.service %h/.config/systemd/user/fleet-pr-sweep@.timer %h/.config/systemd/user/fleet-pr-sweep@fleet-ops.timer %h/.config/systemd/user/fleet-pr-sweep@0509.timer %h/.config/systemd/user/fleet-pr-sweep@drive.timer %h/.config/systemd/user/fleet-pr-sweep@aiconverter-app.timer %h/.config/systemd/user/fleet-pr-sweep@TinyStudio.io-public.timer %h/.config/systemd/user/fleet-pr-sweep@siterep-public.timer %h/.config/systemd/user/fleet-pr-sweep@rera-report-card.timer %h/.config/systemd/user/fleet-pr-sweep@seo-fix-kit.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@fleet-ops.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@0509.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@drive.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@aiconverter-app.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@TinyStudio.io-public.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@siterep-public.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@rera-report-card.timer %h/.config/systemd/user/timers.target.wants/fleet-pr-sweep@seo-fix-kit.timer
# 2a''. The detached worker's token mint (fleet-ops#9738): link the template so every
#     deploy carries edits to it. Nothing to enable: a worker launch line pulls an
#     instance in with Requires= (AGENTS.md "Session-outliving work"). Off switch:
#     delete this step and `systemctl --user unlink` it by hand.
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-worker-github-token@.service
# 2b. Retired the Grok client-version pin (fleet-ops#9223): pi-grok 0.13 does
#     its own lookup of https://x.ai/cli/stable, so the file and its install
#     line are gone, and this rm drops the copy earlier hosts still carry.
#     Delete this step once every host has synced it.
ExecStart=/bin/rm -f %h/.config/environment.d/60-pi-xai-client-version.conf
# 2c. Retired the Executor hub (fleet-ops#10625): its live unit is a hand link
#     into this clone and its drop-in lives there too, so moving the clone would
#     leave both dangling and LINK-GUARD (step 9) would fail before
#     fleet-host-config could delete them. The leviathan links point into
#     ~/.local/share/leviathan and go with that directory in host.yml's retired
#     list. `-` keeps a host that already ran host config quiet.
#     Delete this step once every host has synced it.
ExecStart=-/bin/rm -f %h/.config/systemd/user/executor.service %h/.config/systemd/user/default.target.wants/executor.service
ExecStart=-/bin/rm -rf %h/.config/systemd/user/executor.service.d
# 2d. The helper and scout subagents (the only lanes model-lanes allows) are
#     COPYs of config/claude-agents/, same class as 6/7/8: they lived only as
#     hand-placed files. Remote Control runs on the Max config dir
#     (~/.claude-max), which reads subagents from its own agents/ dir, so every
#     Remote Control thread got "helper not found". The tmpfiles rule links
#     ~/.claude-max/agents to ~/.claude/agents (step 5) and step 5b checks it.
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/claude-agents/helper.md %h/.claude/agents/helper.md
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/claude-agents/scout.md %h/.claude/agents/scout.md
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/user-tmpfiles.d/claude-max-agents.conf %h/.config/user-tmpfiles.d/claude-max-agents.conf
# 2d'. The worktree age-out (fleet-ops#10945): agent-worktrees.conf has held
#      the 3-day rule for the run worktrees beside the two x lines (the
#      .orch-mirror and the parked orch-damaged-*.git save-dirs) since Nish
#      2026-09-19, but no task installed it, so old worktree dirs never aged
#      out. Install it beside the claude-max one (COPY class, same as
#      2c/2d/2f/6/7); step 5 below (`systemd-tmpfiles --user --create`)
#      installs it on every sync, and the pass that ages anything out is the
#      user systemd-tmpfiles-clean.timer's --clean: tmpfiles.d(5) ages every
#      entry, a file or a whole directory, on its own b/ctime/mtime (age-by
#      bcmBCM), so a worktree whose top level saw no write for 3 days is
#      removed whole there. The timer is on by the user preset
#      /usr/lib/systemd/user-preset/90-systemd.preset line 15 enables it, and
#      its systemd-tmpfiles-clean.service ran on this host 2026-10-30 18:27
#      IST, journal systemd[1664]). Fleet
#      sessions live minutes to about one day under the dispatch walls, so
#      nothing valid is 3 days old. The first pass's reach on this host was
#      scanned before push: 54 entries older than 3 days out of 740, and every
#      git tree among them is delivered, archived to
#      `orch-issue-10183-flock-archive` (its flock rework went another way on
#      main), declared scrap (a deleted remote, broken checkouts), or
#      uncommitted work the standing rule calls not-happened; the PR body
#      names one for each class.
#      Off switch: delete this step first, then the conf line in the clone
#      (`config/user-tmpfiles.d/agent-worktrees.conf`) with it, or a later
#      deploy reinstalls the file; then
#      `rm %h/.config/user-tmpfiles.d/agent-worktrees.conf` by hand.
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/user-tmpfiles.d/agent-worktrees.conf %h/.config/user-tmpfiles.d/agent-worktrees.conf
# 2f. The overdue-issue sweep is retired (fleet-ops#10935 step 3): nothing on the box
#     promotes a due: line to agent-ready any more. Step 2.1's shape: stop the pair
#     while the manager still holds them, then rm the unit links, the enable link and
#     the installed repo-list copy only this unit read. Delete this step once a deploy
#     has run it.
ExecStart=-/usr/bin/systemctl --user stop later-sweep.timer later-sweep.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/later-sweep.service %h/.config/systemd/user/later-sweep.timer %h/.config/systemd/user/timers.target.wants/later-sweep.timer %h/.config/fleet-ops/intake-repos.json
# 2g. The daily provider watch is retired (fleet-ops#10935 step 3): the router keeps
#     only live paid seats, and a dead seat already shows in litellm_deployment_state.
#     Step 2.1's shape: stop the pair, then rm the unit links, the enable link and
#     the host state directory only this unit wrote. Delete this step once a deploy
#     has run it.
ExecStart=-/usr/bin/systemctl --user stop fleet-provider-watch.timer fleet-provider-watch.service
ExecStart=-/bin/rm -rf %h/.config/systemd/user/fleet-provider-watch.service %h/.config/systemd/user/fleet-provider-watch.timer %h/.config/systemd/user/timers.target.wants/fleet-provider-watch.timer %h/.local/state/provider-watch
# 2h. The hourly Cua desk check is retired (fleet-ops#10935 step 3): it only watched
#     another unit, and a failed desk routine is not a user-felt symptom. Step 2.1's
#     shape: stop the pair, then rm the unit links and the enable link. Delete this
#     step once a deploy has run it.
ExecStart=-/usr/bin/systemctl --user stop fleet-cua-desk-check.timer fleet-cua-desk-check.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/fleet-cua-desk-check.service %h/.config/systemd/user/fleet-cua-desk-check.timer %h/.config/systemd/user/timers.target.wants/fleet-cua-desk-check.timer
# 2h'. The gh login check is retired (fleet-ops#10935 step 3): workers use App
#     tokens, and a lost owner login is not a user-felt symptom. It was linked by
#     hand, so this rm is its only cleanup. Delete this step once a deploy has run it.
ExecStart=-/usr/bin/systemctl --user stop fleet-gh-login-check.timer fleet-gh-login-check.path fleet-gh-login-check.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/fleet-gh-login-check.service %h/.config/systemd/user/fleet-gh-login-check.path %h/.config/systemd/user/fleet-gh-login-check.timer %h/.config/systemd/user/timers.target.wants/fleet-gh-login-check.timer %h/.config/systemd/user/default.target.wants/fleet-gh-login-check.path
# 2i. The Beacon Hermes poll watcher is a system unit now (fleet-ops#11089): it parses Telegram
#     text, and a unit the user manager starts gets none of the mount sandbox keys on this box
#     (docs/user-unit-sandboxing.md), so its file moved to rootfs/etc/systemd/system/, where
#     fleet-host-config installs it, and ansible/tasks/services.yml starts it. The user link is
#     stopped and deleted here, before the LINK-GUARD pass (step 9): its file is gone from the
#     clone, so a surviving link dangles and fails the deploy. The stop comes first and both lines
#     carry `-`, so a host that has already dropped it stays quiet. This unit runs before
#     fleet-host-config in deploy-box.yml, so the two never poll at once. The rm names the
#     default.target.wants link outright: systemd expands no glob in ExecStart, so a `*.wants`
#     path would reach rm literally, leave the link, and fail LINK-GUARD on a dangling file.
#     Delete this step once a deploy has run it.
ExecStart=-/usr/bin/systemctl --user stop beacon-hermes-poll.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/beacon-hermes-poll.service %h/.config/systemd/user/default.target.wants/beacon-hermes-poll.service
# 2j. The two Tincan wake listeners run as system units only (rootfs/etc/systemd/
#     system/, the agent lock), and their unlocked user forms are gone from the
#     repo (#10912), so the link lines this step carried would fail every deploy
#     on `link: No such file or directory`. This is step 2.1's shape: stop the
#     units first, while the manager still has the loaded copies, then rm the
#     unit links and the default.target.wants links. The wants links are named
#     outright because systemd expands no glob in ExecStart (step 2i), and both
#     lines carry `-`, so a host that already dropped the user forms stays
#     quiet. The daemon-reload below then drops the loaded copies, and
#     LINK-GUARD (step 9) never sees a dangling link. Off switch: delete this
#     step.
ExecStart=-/usr/bin/systemctl --user stop tincan-listen-pi.service tincan-listen-fleet-worker.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/tincan-listen-pi.service %h/.config/systemd/user/tincan-listen-fleet-worker.service %h/.config/systemd/user/default.target.wants/tincan-listen-pi.service %h/.config/systemd/user/default.target.wants/tincan-listen-fleet-worker.service
# 2k. One file fleet-host-config.service installs as root into /etc/systemd/user
#     (fleet-ops#10140): the Cua desk daemon unit. The gpg-agent OOM drop-in that
#     used to be retired here is #10138's own delivery: ansible/host.yml lists it
#     in `retired` and fleet-host-config.service deletes it as root, so this step
#     would only repeat that. ~/.config/systemd/user shadows /etc/systemd/user,
#     so the hand-placed copy has to go once the installed one exists, or the repo
#     copy stays inert. The `test -e` guard keeps this a no-op until then, and the
#     daemon-reload below makes the user manager read the installed one. The desk
#     default.target.wants link is an absolute link to the hand copy (`systemctl
#     enable` writes the path it resolved), so it is repointed at the installed
#     file before the copy goes: `rm` alone would leave it dangling, and
#     LINK-GUARD (step 9) fails the unit on any dead link. The repoint runs only
#     while the link still names the hand copy, so a hand `disable` (no link)
#     stays off. The leading `-` matters: without it the step fails every deploy
#     until fleet-host-config has run, and a failed step is a page. Off switch:
#     delete this step and remove the hand-placed copy by hand.
ExecStart=-/bin/sh -c 'w=%h/.config/systemd/user/default.target.wants/cua-desk-daemon.service; test -e /etc/systemd/user/cua-desk-daemon.service && { test "$$(readlink $$w)" = %h/.config/systemd/user/cua-desk-daemon.service && ln -sfn /etc/systemd/user/cua-desk-daemon.service $$w; rm -f %h/.config/systemd/user/cua-desk-daemon.service; }'
# 2l. The monthly D1 restore drill (fleet-d1-restore-drill.timer, fleet-ops#10594):
#     link the unit pair the same way 2h links its pair, so every deploy carries
#     edits to it, and enable the timer on every deploy like 2f, because a
#     backup that is never restored is a claim and not a backup (the issue's own
#     words): a drill that is silently off is exactly the failure it ships to
#     fix. The drill restores into a local SQLite file and calls no Cloudflare
#     API, so it needs no Cloudflare token; it reads its private key off this
#     host, which is why it is here and not a GitHub workflow. Off switch:
#     delete this step and the enable line below, then `systemctl --user
#     disable --now fleet-d1-restore-drill.timer`.
ExecStart=/bin/sh -c 'for f in fleet-d1-restore-drill.service fleet-d1-restore-drill.timer; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-d1-restore-drill.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-d1-restore-drill.timer
# 2m. The clone lag check (fleet-clone-lag.timer, fleet-ops#10046): link the unit pair
#     and enable the timer on every deploy, the same way 2h links its pair, because it
#     is the only thing that compares the clone to origin/main on a clock and a check
#     that is silently off is the failure it ships to fix (a merge that started no
#     deploy left the box on stale prompts for 63 min on 2026-10-22). Off switch:
#     delete this step and the enable line below, then `systemctl --user disable --now
#     fleet-clone-lag.timer`.
ExecStart=/bin/sh -c 'for f in fleet-clone-lag.service fleet-clone-lag.timer; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-clone-lag.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-clone-lag.timer
ExecStart=/usr/bin/systemctl --user daemon-reload
# 2l. A quadlet edit never reaches a running container (fleet-ops#10820).
#    The daemon-reload above regenerates fleet-grafana.service from
#    containers/quadlet/fleet-grafana.container, but nothing restarts the
#    container, so a `Secret=` line added to a quadlet lands only at the
#    container's next start. On 2026-10-29 that left the Grafana data source the
#    session-hop rule reads unable to provision, and the rule failed its
#    evaluation with DatasourceError from 07:15Z.
#    The marker holds the quadlet bytes the running container was started
#    from, and `cmp -s` is the guard, the same one the proxy unit uses so an
#    attribute touch cannot restart the router: a sync that changed nothing
#    restarts nothing. The first sync after this step lands finds no marker,
#    so it restarts Grafana once with the mounts the quadlet already carries,
#    which is the live fix. The marker is a copy of the quadlet, so it is
#    written 0600: a quadlet can carry `Environment=` and `Secret=` lines.
#    The order is restart, then record. A `try-restart` that fails leaves no
#    marker, so the next sync tries again, and the failed step is a page
#    (OnFailure=) rather than a silent "already applied".
#    `try-restart` acts only on a running container, so a Grafana stopped on
#    purpose stays stopped, and a stopped or failed Grafana that is later
#    started starts from the current quadlet either way
#    (fleet-litellm-proxy-config.service does the same).
#    This is not the Ansible handler's job: `Restart fleet-grafana` is notified
#    by the grafana_secrets loop when a secret is created or replaced, and a
#    quadlet mount edit is neither.
#    Grafana only. A loop over containers/quadlet/ would also restart the
#    LiteLLM router, its Redis and its Postgres the next time one of those
#    quadlets changes, and the first sync after this step lands would restart
#    every container at once. That blast radius is a wider call than this issue.
#    Off switch: delete this step and ~/.config/fleet-ops/grafana-quadlet.container.
ExecStart=/bin/sh -c 'test -f %h/workspaces/tooling/fleet-ops-deploy-clone/containers/quadlet/fleet-grafana.container && { cmp -s %h/workspaces/tooling/fleet-ops-deploy-clone/containers/quadlet/fleet-grafana.container %h/.config/fleet-ops/grafana-quadlet.container || { /usr/bin/systemctl --user try-restart fleet-grafana.service && /usr/bin/install -C -D -m 0600 %h/workspaces/tooling/fleet-ops-deploy-clone/containers/quadlet/fleet-grafana.container %h/.config/fleet-ops/grafana-quadlet.container; }; }'
ExecStart=/usr/bin/systemctl --user enable --now fleet-d1-restore-drill.timer
ExecStart=/usr/bin/systemctl --user enable --now fleet-clone-lag.timer
# 3-4. Root-owned files (/etc/prometheus/*.yml, agent.slice and every other
#    file under rootfs/) are no longer this unit's job. fleet-host-config.service
#    (rootfs/etc/systemd/system/, Ansible's ansible-pull of ansible/host.yml)
#    installs them as root from its own clone, and deploy-box.yml starts it right
#    after this unit. That removed the two `sudo -n` steps that lived here, so
#    this user unit needs no sudo (thread "fix everything like pro devs",
#    Nish 2026-10-03).
# 5. Apply user-tmpfiles.d on every sync, not just at the next login
#    (fleet-ops#8584). man systemd-tmpfiles: --create creates and links;
#    it leaves the age-only e lines alone.
ExecStart=/usr/bin/systemd-tmpfiles --user --create
# 5b. Plain L never replaces a path that is already there, so a hand-made
#     ~/.claude-max/agents would quietly hide the lanes again. Fail loud instead.
ExecStart=/bin/sh -c 'test "$$(readlink %h/.claude-max/agents)" = %h/.claude/agents || { echo "[fleet-sync] ~/.claude-max/agents is not the link to ~/.claude/agents; remove it and re-run"; exit 1; }'
ExecStart=/usr/bin/git -C %h/workspaces/tooling/claude-mods fetch --no-tags origin refs/heads/main:refs/remotes/origin/main
ExecStart=/usr/bin/git -C %h/workspaces/tooling/claude-mods merge --ff-only refs/remotes/origin/main
# 6. ~/.pi/agent/models.json is a user-scope COPY of config/pi-models.json
#     (fleet-ops#8568: the 09-19 contextWindow 96000 fix lived only in the
#     live file and was silently lost). Copy, not symlink: ~/.pi/agent is an
#     overlay mount in worker containers, where a link into the deploy clone
#     would not resolve. install -C skips the write when the bytes already match.
ExecStart=/usr/bin/install -C -D -m 0644 /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/pi-models.json /home/nish/.pi/agent/models.json
# 7. ~/.config/fleet-ops/litellm-proxy.yaml is a COPY of config/litellm-proxy.yaml,
#     same class as 6 (fleet-ops#8724: rung edits made live only, then lost or
#     never reviewed). The repo is the only way in: a hand edit is overwritten
#     here, and fleet-litellm-proxy-config.path restarts the proxy on a real change.
#     cmp guard (the cmp -s on the ExecStart line below): without it the attribute touch restarted the proxy
#     on every sync. 2026-09-28..10-02: 28 restarts, ~6 from real config edits,
#     each ~60 s with no router (11:16 IST 10-02 came from a prompt-only merge).
ExecStart=/bin/sh -c 'cmp -s /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/litellm-proxy.yaml /home/nish/.config/fleet-ops/litellm-proxy.yaml || /usr/bin/install -C -D -m 0644 /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/litellm-proxy.yaml /home/nish/.config/fleet-ops/litellm-proxy.yaml'
# 9. LINK-GUARD (fleet-ops#7743): machine wiring is hand-set symlinks, so a
#    session CAN still point a live path at a throwaway checkout — the
#    2026-09-18 incident linked standing-rules-render into a churning clone
#    and it dangled when the files vanished. After every pull, fail LOUD on
#    any symlink in the live wiring roots (README "Allowlist" set + the
#    vault) whose link text names a throwaway root — *worktrees/, agent-state
#    (worktrees live there too), */tmp/ — and on any BROKEN link (`-xtype l`:
#    target missing or unreadable) outside the skill mirror below. A failed
#    unit is the page. find prints each bad link and -exec /bin/false {} +
#    makes find exit non-zero when there is at least one.
#    It is two lines, not one, because a broken link means two different
#    things. Under ~/.pi/agent/skills the target is a skill that the synced
#    ~/.claude/skills folder (or the vault) owns, so the other machine
#    deleting it leaves the link dead as a matter of course — nine of them
#    held every push to main red for 23 h across six runs (fleet-ops#9967).
#    That class logs and does not fail, so the deploy converges and a skill
#    that comes back needs no relink. A throwaway target stays fatal in every
#    root, the skill mirror included.
ExecStart=/usr/bin/find %h/.config/systemd/user %h/.local/bin %h/.pi/agent %h/workspaces/tooling/nish-vault -type l ( -lname *worktrees/* -o -lname */agent-state/* -o -lname */tmp/* ) -printf "[fleet-sync] LINK-GUARD live symlink -> throwaway target: %%p -> %%l\n" -exec /bin/false {} +
ExecStart=/usr/bin/find %h/.config/systemd/user %h/.local/bin %h/.pi/agent %h/workspaces/tooling/nish-vault -path %h/.pi/agent/skills -prune -o -xtype l -printf "[fleet-sync] LINK-GUARD live symlink -> dead target: %%p -> %%l\n" -exec /bin/false {} +
ExecStart=/usr/bin/find %h/.pi/agent/skills -xtype l -printf "[fleet-sync] skill link dead (skill gone from its source, link left in place): %%p -> %%l\n"
# 10. STUB-GUARD (fleet-ops#10525): on 2026-10-28 a worker with sudo overwrote ten
#    launch paths with /bin/true so `systemd-analyze verify` would pass; every agent
#    call then exited 0 with no output and nothing paged. Fail LOUD on any listed
#    launch path (symlinks followed) whose bytes equal /bin/true. A failed unit is
#    the page (OnFailure=). It runs on every deploy. Off switch: delete this step.
#    The runners' runsvc.sh too: on 2026-10-31 a hand-off's stub loop overwrote all
#    thirty (fleet-ops#10537 session), and each runner died on its next restart.
ExecStart=/bin/sh -c 'bad=0; for p in %h/.local/bin/claude %h/.local/bin/pi %h/.local/bin/tincan /usr/bin/syncthing %h/.hermes/hermes-agent/.hermes/bin/hermes %h/.local/share/agent-runner/*/runsvc.sh %h/.local/share/fleet-ci-runner/*/runsvc.sh; do if test -e "$$p" && cmp -s "$$p" /bin/true; then echo "[fleet-sync] STUB-GUARD launch path is byte-identical to /bin/true: $$p"; bad=1; fi; done; exit $$bad'
# 11. The deploy result as a metric (fleet-ops#9437). Nothing paged for a failed
#    fleet-sync: its OnFailure= healthchecks.io ping is inert on a host without
#    ~/.config/fleet-ops/keystone-hc.env, and node_exporter's systemd collector
#    reads system units, not this user unit. The textfile collector reads
#    /var/lib/prometheus/node-exporter/fleet-sync.prom, the one file the tmpfiles
#    line rootfs/etc/tmpfiles.d/fleet-sync-metric.conf creates for user nish, and
#    the Prometheus rule FleetSyncFailed pages when it reads 1. ExecStopPost runs
#    on success and on failure, and $SERVICE_RESULT is systemd's own verdict, so a
#    timeout and a signal count as failures too. The write truncates that file in
#    place, which needs write on the file and not on the directory: a temporary
#    file and a rename would need the directory, and this line does not grant it.
#    The leading `-` keeps a write that cannot happen (a host without the tmpfiles
#    line) from becoming a second failure, and FleetSyncMetricMissing pages when
#    the series never appears.
ExecStopPost=-/bin/sh -c 'r=0; [ "$$SERVICE_RESULT" = success ] || r=1; { echo "# TYPE fleet_sync_failed gauge"; echo "fleet_sync_failed $$r"; } > /var/lib/prometheus/node-exporter/fleet-sync.prom'
# 12. Last, so a failure here cannot skip the steps above it (a failed ExecStart
#     stops the chain). The packages key of ~/.pi/agent/settings.json is
#     repo-owned (config/pi-packages.json, fleet-ops#9302): a pin change is a
#     PR, not a hand edit on the host. The five pins are a byte-copy of the
#     live file read on 2026-10-30: the host already runs pi-runner-guard and
#     pi-grok / pi-mcp-adapter at the pins issue #9302's four-entry snapshot
#     predates, so the first merge installs nothing new. Merge, not copy:
#     pi rewrites the file's
#     own bookkeeping keys at runtime (fleet-ops#8568), so jq's object merge
#     takes only .packages from the repo file and leaves every other key as pi
#     wrote it. cmp guard, same as 7: a merge that changes nothing writes
#     nothing; a real pin change writes once. The temp file sits next to the
#     target so the mv replaces the file atomically, and chmod --reference
#     keeps its mode. Every failure (a missing or unparsable file) exits
#     non-zero and fails the unit loud; recovery is `echo '{}' >
#     ~/.pi/agent/settings.json` and a re-run of fleet-sync.
ExecStart=/bin/sh -c 't=%h/.pi/agent/.settings.json.sync; /usr/bin/jq -s ".[0] * .[1]" %h/.pi/agent/settings.json %h/workspaces/tooling/fleet-ops-deploy-clone/config/pi-packages.json > "$$t" && chmod --reference=%h/.pi/agent/settings.json "$$t" && { cmp -s "$$t" %h/.pi/agent/settings.json || mv "$$t" %h/.pi/agent/settings.json; }; r=$$?; rm -f "$$t"; exit $$r'
# /etc/hosts carries a static `127.0.0.1 litellm.fleet.local` line
# (fleet-ops#8259). An earlier fleet-sync step appended it once; it is a
# one-time host setting, not a per-tick deploy action (fleet-ops#8584).
TimeoutStartSec=300

[Install]
WantedBy=default.target
