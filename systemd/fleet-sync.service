[Unit]
Description=Sync the fleet-ops deploy clone and reload systemd (fleet-ops third cut)
# Replaces install.sh + MANIFEST + bin/fleet-ops-deploy + bin/fleet-deploy-check
# + bin/fleet-ops-drift.py (5,948 LOC). Those existed to COPY files from the
# repo to their live paths and then to detect the drift that copying creates.
# Every user-scope live path is already a symlink into this repo
# (`systemctl --user list-unit-files` reports the units as `linked`), so there
# is nothing to copy and nothing that can drift: a `git pull` IS the deploy.
# Root-owned files that cross a privilege boundary are fleet-host-config.service's
# job (Ansible, rootfs/), not this unit's: see steps 3-4.
#
# man systemctl: "link PATH...  Link a unit file that is not in the unit file
# search path into the unit file search path. This command expects an absolute
# path to a unit file." A new unit file added to systemd/ is wired once, by
# hand, with `systemctl --user link` + `enable --now` (see README "Install").
# There is no installer to run and no manifest to keep in step.
StartLimitIntervalSec=1h
StartLimitBurst=100
OnFailure=fleet-unit-failed@%N.service

[Service]
Type=oneshot
# 0. Dirty working tree (fleet-ops#9033): print DEPLOY-BLOCKED and fail
#    before fetch/merge. git merge --ff-only already refuses a dirty tree,
#    but its wording is quiet; this line is the loud journal marker the
#    map and RUNBOOK name, and OnFailure= pages.
ExecStart=/bin/sh -c 'git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone diff --quiet && git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone diff --cached --quiet || { echo DEPLOY-BLOCKED; exit 1; }'
# 1. Fast-forward the clone deterministically (fleet-ops#8893).
#    `git pull --ff-only origin main` delegates to `git merge --ff-only FETCH_HEAD`,
#    and a multi-entry `FETCH_HEAD` (e.g. from a concurrent `git fetch` in the
#    deploy clone, or a multi-valued `branch.main.merge` config) makes merge refuse
#    with `fatal: Cannot fast-forward to multiple branches`, silently stopping the
#    whole deploy. Fetch main into its remote-tracking ref explicitly, then merge
#    that named ref — a single commit can never produce the multi-branch refusal.
ExecStart=/usr/bin/git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone fetch --no-tags origin refs/heads/main:refs/remotes/origin/main
ExecStart=/usr/bin/git -C /home/nish/workspaces/tooling/fleet-ops-deploy-clone merge --ff-only refs/remotes/origin/main
#    Probe (fleet-ops#8893): the step above is now deterministic, but a deploy
#    window that ever ends with HEAD not equal to origin/main is a silent stop.
#    `git diff` would compare trees and miss an empty commit, so assert commit
#    identity in both directions: origin/main is an ancestor of HEAD (HEAD is not
#    behind) AND HEAD is an ancestor of origin/main (HEAD is not ahead). Together
#    those are true only when HEAD == origin/main; either false exits non-zero and
#    the unit fails loud, so OnFailure=fleet-unit-failed@ pages instead of the clone
#    quietly lagging.
#    fleet-ops#9967: "fail loud" shipped as a bare git exit code, so the six red
#    deploy-box runs printed only `exit code 1`. The cause — a session had checked a
#    work branch out in the deploy clone, so the clone was a commit ahead of main —
#    lived in the journal alone, and each run took a manual read to explain. One sh
#    line now prints DEPLOY-BLOCKED, the branch and head it found, the commits that
#    are not on main, and the fix.
ExecStart=/bin/sh -c 'cd %h/workspaces/tooling/fleet-ops-deploy-clone || { echo "DEPLOY-BLOCKED: no deploy clone at %h/workspaces/tooling/fleet-ops-deploy-clone, so no unit or config was updated."; exit 1; }; if git merge-base --is-ancestor refs/remotes/origin/main HEAD && git merge-base --is-ancestor HEAD refs/remotes/origin/main; then exit 0; fi; echo "DEPLOY-BLOCKED: the deploy clone is not at origin/main, so no unit or config was updated."; echo "  branch $$(git rev-parse --abbrev-ref HEAD), head $$(git rev-parse --short HEAD), origin/main $$(git rev-parse --short refs/remotes/origin/main)"; git log --oneline -n 20 refs/remotes/origin/main..HEAD | sed "s/^/  not-on-main: /"; echo "  fix: git -C %h/workspaces/tooling/fleet-ops-deploy-clone switch main, then work from a worktree, not the deploy clone"; exit 1'
# 2. Link the OnFailure handler, then re-read unit files. Link first so
#    daemon-reload loads fleet-unit-failed@.service (fleet-ops#9033).
ExecStart=/usr/bin/systemctl --user link /home/nish/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-unit-failed@.service
# 2.1 The retired weekly retro and the stale user copy of the tincan claude
#     listener (fleet-ops#10125) left live links to deleted deploy-clone files.
#     Stop the units first, while the links still resolve, so a Monday slot
#     cannot start a deleted service; then rm the unit links and every enable
#     link. The *.wants glob covers whichever target the [Install] section
#     named, so no dangling link survives in a directory this list did not
#     guess. rm -f is a no-op once they are gone, and without it LINK-GUARD
#     fails on the dangling links. Both rm lines carry the - prefix: a link
#     that cannot be removed is the next run's problem, not a reason to stop
#     this deploy. The root tincan-listen-claude-vps.service is a system unit
#     and is not touched here. Off switch: delete this step.
ExecStart=-/usr/bin/systemctl --user stop retro-weekly.timer retro-weekly.service retro-weekly-api.socket tincan-listen-claude-vps.service
ExecStart=-/bin/rm -f %h/.config/systemd/user/retro-weekly.service %h/.config/systemd/user/retro-weekly.timer %h/.config/systemd/user/retro-weekly-api.service %h/.config/systemd/user/retro-weekly-api.socket %h/.config/systemd/user/*.wants/retro-weekly.timer %h/.config/systemd/user/*.wants/retro-weekly-api.socket %h/.config/systemd/user/tincan-listen-claude-vps.service %h/.config/systemd/user/tincan-listen-claude-vps.service.d/10-nish-seat.conf %h/.config/systemd/user/*.wants/tincan-listen-claude-vps.service
ExecStart=-/bin/rmdir --ignore-fail-on-non-empty %h/.config/systemd/user/tincan-listen-claude-vps.service.d
# 2a. The hourly PR sweep (fleet-pr-sweep@.timer, #9602): link the template
#     pair here so every deploy carries edits to it, and enable one instance per
#     repo with an agent-dispatch stub after the daemon-reload below. Off switch:
#     delete this step and the enable line, then `systemctl --user disable --now
#     'fleet-pr-sweep@*.timer'`; a hand disable alone is re-enabled next deploy.
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-pr-sweep@.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-pr-sweep@.timer
# 2a''. The detached worker's token mint (fleet-ops#9738): link the template so every
#     deploy carries edits to it. Nothing to enable: a worker launch line pulls an
#     instance in with Requires= (AGENTS.md "Session-outliving work"). Off switch:
#     delete this step and `systemctl --user unlink` it by hand.
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-worker-github-token@.service
# 2b. Retired the Grok client-version pin (fleet-ops#9223): pi-grok 0.13 does
#     its own lookup of https://x.ai/cli/stable, so the file and its install
#     line are gone, and this rm drops the copy earlier hosts still carry.
#     Delete this step once every host has synced it.
ExecStart=/bin/rm -f %h/.config/environment.d/60-pi-xai-client-version.conf
# 2c. Retired the Executor hub (fleet-ops#10625): its live unit is a hand link
#     into this clone and its drop-in lives there too, so moving the clone would
#     leave both dangling and LINK-GUARD (step 9) would fail before
#     fleet-host-config could delete them. The leviathan links point into
#     ~/.local/share/leviathan and go with that directory in host.yml's retired
#     list. `-` keeps a host that already ran host config quiet.
#     Delete this step once every host has synced it.
ExecStart=-/bin/rm -f %h/.config/systemd/user/executor.service %h/.config/systemd/user/default.target.wants/executor.service
ExecStart=-/bin/rm -rf %h/.config/systemd/user/executor.service.d
# 2d. The helper and scout subagents (the only lanes model-lanes allows) are
#     COPYs of config/claude-agents/, same class as 6/7/8: they lived only as
#     hand-placed files. Remote Control runs on the Max config dir
#     (~/.claude-max), which reads subagents from its own agents/ dir, so every
#     Remote Control thread got "helper not found". The tmpfiles rule links
#     ~/.claude-max/agents to ~/.claude/agents (step 5) and step 5b checks it.
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/claude-agents/helper.md %h/.claude/agents/helper.md
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/claude-agents/scout.md %h/.claude/agents/scout.md
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/user-tmpfiles.d/claude-max-agents.conf %h/.config/user-tmpfiles.d/claude-max-agents.conf
# 2f. The overdue-issue sweep (later-sweep.timer, fleet-ops#9758): install the
#     repo list the unit reads, then link the unit pair, so every deploy carries
#     edits to it. The install is a user-scope COPY, same class as 2c/6/7:
#     the timer runs every 15 minutes and must not read its list out of the
#     deploy clone. The timer is enabled on every deploy like 2a, unlike 2g,
#     because a timer that is silently off is the failure this ships to fix
#     (fleet-ops#9376: a one-shot transient `later-*` timer died with the manager
#     restart, and the issue sat unpromoted). Off switch: delete this step and
#     the enable line below, then `systemctl --user disable --now
#     later-sweep.timer`.
ExecStart=/usr/bin/install -C -D -m 0644 %h/workspaces/tooling/fleet-ops-deploy-clone/config/intake-repos.json %h/.config/fleet-ops/intake-repos.json
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/later-sweep.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/later-sweep.timer
# 2g. The daily provider watch: link the unit pair so every deploy carries edits to it,
#     the same way as step 2f. The timer is NOT enabled here: README "Provider watch"
#     enables it once, so a hand disable stays disabled. Off switch: delete this step,
#     then `rm` the two links in ~/.config/systemd/user and `systemctl --user daemon-reload`.
ExecStart=/bin/sh -c 'for f in fleet-provider-watch.service fleet-provider-watch.timer; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-provider-watch.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-provider-watch.timer
# 2h. The hourly Cua desk check (fleet-cua-desk-check.timer): link the unit pair so
#     every deploy carries edits to it, the same way as step 2g, and enable the
#     timer on every deploy like 2f, because a check that is silently off is the
#     failure it ships to fix (2026-10-18: the desk was deleted and three daily
#     walks failed with no page). Off switch: delete this step and the enable line
#     below, then `systemctl --user disable --now fleet-cua-desk-check.timer`.
ExecStart=/bin/sh -c 'for f in fleet-cua-desk-check.service fleet-cua-desk-check.timer; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-cua-desk-check.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-cua-desk-check.timer
# 2i. The Beacon Hermes poll watcher (beacon-hermes-poll.service): link it so every deploy
#     carries edits to it, the same way as step 2h, and enable it on every deploy, because a
#     capture that is silently off is the failure it ships to fix. The restart after enable
#     applies edits to a service that is already running (enable --now does not). The lines are
#     prefixed with `-` so a broken capture watcher cannot stop the deploy steps after it (the
#     pr-sweep timers below); the unit's OnFailure= pages when it fails. Off switch: delete this
#     step and the enable line below, then `systemctl --user disable --now beacon-hermes-poll.service`.
#     The prefix goes AFTER the `=` (`ExecStart=-`): `-ExecStart=` is an unknown key, which systemd
#     skips with a warning and exit 0, so those four lines silently never ran and
#     beacon-hermes-poll.service was never linked (fleet-ops#9967).
ExecStart=-/bin/sh -c 'for f in beacon-hermes-poll.service; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=-/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/beacon-hermes-poll.service
# 2j. The Tincan wake services (fleet-ops#10133) were hand-placed regular files
#     under ~/.config/systemd/user with no repo copy, so a git pull carried no
#     edit to them and the unit-key test could not read them. The two left after
#     the CLI lanes retired (#44 item 9) are linked here the way 2h links its
#     pair: a regular file, or a link to anywhere else, blocks `link`, so it is
#     removed first. The default.target.wants links already point at these
#     paths, so no `enable` runs here and a hand `systemctl --user disable --now`
#     stays off. Off switch: delete this step and the two names in it, then
#     `systemctl --user disable --now` each unit and `systemctl --user unlink` it
#     by hand. The four retired listeners' links are deleted by `retired` in
#     ansible/host.yml. A unit edit applies at that unit's next restart, so no
#     restart line runs here: these listeners are woken by work and a restart
#     drops whatever wake is in flight. The Cua desk daemon is not here: it lives
#     in rootfs/etc/systemd/user/ and step 2k retires its hand-placed copy.
ExecStart=/bin/sh -c 'for f in tincan-listen-fleet-worker.service tincan-listen-pi.service; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/tincan-listen-fleet-worker.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/tincan-listen-pi.service
# 2k. One file fleet-host-config.service installs as root into /etc/systemd/user
#     (fleet-ops#10140): the Cua desk daemon unit. The gpg-agent OOM drop-in that
#     used to be retired here is #10138's own delivery: ansible/host.yml lists it
#     in `retired` and fleet-host-config.service deletes it as root, so this step
#     would only repeat that. ~/.config/systemd/user shadows /etc/systemd/user,
#     so the hand-placed copy has to go once the installed one exists, or the repo
#     copy stays inert. The `test -e` guard keeps this a no-op until then, and the
#     daemon-reload below makes the user manager read the installed one. The desk
#     default.target.wants link is an absolute link to the hand copy (`systemctl
#     enable` writes the path it resolved), so it is repointed at the installed
#     file before the copy goes: `rm` alone would leave it dangling, and
#     LINK-GUARD (step 9) fails the unit on any dead link. The repoint runs only
#     while the link still names the hand copy, so a hand `disable` (no link)
#     stays off. The leading `-` matters: without it the step fails every deploy
#     until fleet-host-config has run, and a failed step is a page. Off switch:
#     delete this step and remove the hand-placed copy by hand.
ExecStart=-/bin/sh -c 'w=%h/.config/systemd/user/default.target.wants/cua-desk-daemon.service; test -e /etc/systemd/user/cua-desk-daemon.service && { test "$$(readlink $$w)" = %h/.config/systemd/user/cua-desk-daemon.service && ln -sfn /etc/systemd/user/cua-desk-daemon.service $$w; rm -f %h/.config/systemd/user/cua-desk-daemon.service; }'
# 2l. The monthly D1 restore drill (fleet-d1-restore-drill.timer, fleet-ops#10594):
#     link the unit pair the same way 2h links its pair, so every deploy carries
#     edits to it, and enable the timer on every deploy like 2f, because a
#     backup that is never restored is a claim and not a backup (the issue's own
#     words): a drill that is silently off is exactly the failure it ships to
#     fix. The drill restores into a local SQLite file and calls no Cloudflare
#     API, so it needs no Cloudflare token; it reads its private key off this
#     host, which is why it is here and not a GitHub workflow. Off switch:
#     delete this step and the enable line below, then `systemctl --user
#     disable --now fleet-d1-restore-drill.timer`.
ExecStart=/bin/sh -c 'for f in fleet-d1-restore-drill.service fleet-d1-restore-drill.timer; do test "$$(readlink %h/.config/systemd/user/$$f)" = %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/$$f || rm -f %h/.config/systemd/user/$$f; done'
ExecStart=/usr/bin/systemctl --user link %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-d1-restore-drill.service %h/workspaces/tooling/fleet-ops-deploy-clone/systemd/fleet-d1-restore-drill.timer
ExecStart=/usr/bin/systemctl --user daemon-reload
ExecStart=/usr/bin/systemctl --user enable --now later-sweep.timer
ExecStart=/usr/bin/systemctl --user enable --now fleet-cua-desk-check.timer
ExecStart=-/usr/bin/systemctl --user enable --now beacon-hermes-poll.service
ExecStart=-/usr/bin/systemctl --user restart beacon-hermes-poll.service
ExecStart=/usr/bin/systemctl --user enable --now fleet-d1-restore-drill.timer
ExecStart=/usr/bin/systemctl --user enable --now fleet-pr-sweep@fleet-ops.timer fleet-pr-sweep@0509.timer fleet-pr-sweep@drive.timer fleet-pr-sweep@aiconverter-app.timer fleet-pr-sweep@TinyStudio.io-public.timer fleet-pr-sweep@siterep-public.timer fleet-pr-sweep@rera-report-card.timer
# 3-4. Root-owned files (/etc/prometheus/*.yml, agent.slice and every other
#    file under rootfs/) are no longer this unit's job. fleet-host-config.service
#    (rootfs/etc/systemd/system/, Ansible's ansible-pull of ansible/host.yml)
#    installs them as root from its own clone, and deploy-box.yml starts it right
#    after this unit. That removed the two `sudo -n` steps that lived here, so
#    this user unit needs no sudo (thread "fix everything like pro devs",
#    Nish 2026-10-03).
# 5. Apply user-tmpfiles.d on every sync, not just at the next login
#    (fleet-ops#8584). man systemd-tmpfiles: --create creates and links;
#    it leaves the age-only e lines alone.
ExecStart=/usr/bin/systemd-tmpfiles --user --create
# 5b. Plain L never replaces a path that is already there, so a hand-made
#     ~/.claude-max/agents would quietly hide the lanes again. Fail loud instead.
ExecStart=/bin/sh -c 'test "$$(readlink %h/.claude-max/agents)" = %h/.claude/agents || { echo "[fleet-sync] ~/.claude-max/agents is not the link to ~/.claude/agents; remove it and re-run"; exit 1; }'
ExecStart=/usr/bin/git -C %h/workspaces/tooling/claude-mods fetch --no-tags origin refs/heads/main:refs/remotes/origin/main
ExecStart=/usr/bin/git -C %h/workspaces/tooling/claude-mods merge --ff-only refs/remotes/origin/main
# 6. ~/.pi/agent/models.json is a user-scope COPY of config/pi-models.json
#     (fleet-ops#8568: the 09-19 contextWindow 96000 fix lived only in the
#     live file and was silently lost). Copy, not symlink: ~/.pi/agent is an
#     overlay mount in worker containers, where a link into the deploy clone
#     would not resolve. install -C skips the write when the bytes already match.
ExecStart=/usr/bin/install -C -D -m 0644 /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/pi-models.json /home/nish/.pi/agent/models.json
# 7. ~/.config/fleet-ops/litellm-proxy.yaml is a COPY of config/litellm-proxy.yaml,
#     same class as 6 (fleet-ops#8724: rung edits made live only, then lost or
#     never reviewed). The repo is the only way in: a hand edit is overwritten
#     here, and fleet-litellm-proxy-config.path restarts the proxy on a real change.
#     cmp guard (the cmp -s on the ExecStart line below): without it the attribute touch restarted the proxy
#     on every sync. 2026-09-28..10-02: 28 restarts, ~6 from real config edits,
#     each ~60 s with no router (11:16 IST 10-02 came from a prompt-only merge).
ExecStart=/bin/sh -c 'cmp -s /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/litellm-proxy.yaml /home/nish/.config/fleet-ops/litellm-proxy.yaml || /usr/bin/install -C -D -m 0644 /home/nish/workspaces/tooling/fleet-ops-deploy-clone/config/litellm-proxy.yaml /home/nish/.config/fleet-ops/litellm-proxy.yaml'
# 9. LINK-GUARD (fleet-ops#7743): machine wiring is hand-set symlinks, so a
#    session CAN still point a live path at a throwaway checkout — the
#    2026-09-18 incident linked standing-rules-render into a churning clone
#    and it dangled when the files vanished. After every pull, fail LOUD on
#    any symlink in the live wiring roots (README "Allowlist" set + the
#    vault) whose link text names a throwaway root — *worktrees/, agent-state
#    (worktrees live there too), */tmp/ — and on any BROKEN link (`-xtype l`:
#    target missing or unreadable) outside the skill mirror below. A failed
#    unit is the page. find prints each bad link and -exec /bin/false {} +
#    makes find exit non-zero when there is at least one.
#    It is two lines, not one, because a broken link means two different
#    things. Under ~/.pi/agent/skills the target is a skill that the synced
#    ~/.claude/skills folder (or the vault) owns, so the other machine
#    deleting it leaves the link dead as a matter of course — nine of them
#    held every push to main red for 23 h across six runs (fleet-ops#9967).
#    That class logs and does not fail, so the deploy converges and a skill
#    that comes back needs no relink. A throwaway target stays fatal in every
#    root, the skill mirror included.
ExecStart=/usr/bin/find %h/.config/systemd/user %h/.local/bin %h/.pi/agent %h/workspaces/tooling/nish-vault -type l ( -lname *worktrees/* -o -lname */agent-state/* -o -lname */tmp/* ) -printf "[fleet-sync] LINK-GUARD live symlink -> throwaway target: %%p -> %%l\n" -exec /bin/false {} +
ExecStart=/usr/bin/find %h/.config/systemd/user %h/.local/bin %h/.pi/agent %h/workspaces/tooling/nish-vault -path %h/.pi/agent/skills -prune -o -xtype l -printf "[fleet-sync] LINK-GUARD live symlink -> dead target: %%p -> %%l\n" -exec /bin/false {} +
ExecStart=/usr/bin/find %h/.pi/agent/skills -xtype l -printf "[fleet-sync] skill link dead (skill gone from its source, link left in place): %%p -> %%l\n"
# 10. STUB-GUARD (fleet-ops#10525): on 2026-10-28 a worker with sudo overwrote ten
#    launch paths with /bin/true so `systemd-analyze verify` would pass; every agent
#    call then exited 0 with no output and nothing paged. Fail LOUD on any listed
#    launch path (symlinks followed) whose bytes equal /bin/true. A failed unit is
#    the page (OnFailure=). It runs on every deploy. Off switch: delete this step.
ExecStart=/bin/sh -c 'bad=0; for p in %h/.local/bin/claude %h/.local/bin/pi %h/.local/bin/tincan /usr/bin/syncthing %h/.hermes/hermes-agent/.hermes/bin/hermes; do if test -e "$$p" && cmp -s "$$p" /bin/true; then echo "[fleet-sync] STUB-GUARD launch path is byte-identical to /bin/true: $$p"; bad=1; fi; done; exit $$bad'
# /etc/hosts carries a static `127.0.0.1 litellm.fleet.local` line
# (fleet-ops#8259). An earlier fleet-sync step appended it once; it is a
# one-time host setting, not a per-tick deploy action (fleet-ops#8584).
TimeoutStartSec=300

[Install]
WantedBy=default.target
