[Unit]
Requires=fleet-gh-token.service
After=fleet-gh-token.service
Description=Pi fleet issue intake tick for Nishfleet/%i
StartLimitIntervalSec=1h
# Worker-exit top-ups (pi-issue@.service ExecStopPost) start this unit up to
# once per finishing worker; 90/h keeps a busy hour from silencing the timer.
StartLimitBurst=90

[Service]
# Worker App token from fleet-gh-token.service (fleet-ops#8057); empty GH_TOKEN is a hard stop since #8092.
EnvironmentFile=-/run/user/%U/fleet-gh-token.env
# Second cut 2026-09-18: the tick IS this unit. prompts/intake.md tells Pi to
# label, order, claim and spawn; the 3,320-line lib/pi-intake-tick.sh that did
# the same thing deterministically is gone, as is the bin/pi-intake-run flock
# (systemd already refuses to run two starts of one unit instance at once) and
# bin/pi-packet-run's seat rotation (the `worker-cheap` LiteLLM group is the
# router, and it is the group pi-packet-run resolved to anyway). The cheap and
# capable groups share the same upstream accounts, so the split is not
# isolation (fleet-ops#7786).
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
# fleet-ops#8049: the trigger-file rm must run BEFORE the ready-check below.
# man systemd.service: ExecCondition= commands run before ExecStartPre=, so a
# skipped tick (ready==0) never reaches an ExecStartPre rm — the file survives,
# the path unit's post-termination recheck re-fires instantly, and the
# trigger/start cycle loops until the StartLimit fails BOTH units (proven live
# 2026-09-22 on a test unit: unit-start-limit-hit on the .path in ~8 s). As the
# FIRST ExecCondition this rm runs on every activation attempt — skipped or
# not — which is the ordering bin/pi-intake-trigger had (it rm'd before the
# tick's own gate ever ran). '-' prefix: a missing file or rm fault must not
# fail the tick.
ExecCondition=-/bin/rm -f /home/nish/workspaces/agent-state/pi-intake-triggers/%i
# One cheap gh call decides whether to spend a seat at all. Exit 255 on a gh
# fault so systemd records a failure instead of skipping quietly.
ExecCondition=/bin/sh -c 'out=$$(gh issue list -R Nishfleet/%i -l agent-ready --json number -L 1 2>&1) || { echo "gh failed: $$out" >&2; exit 255; }; [ "$$out" != "[]" ]'
# The prompt is a Pi prompt template (~/.pi/agent/prompts/intake.md), invoked
# as `/intake <repo>`. Pi expands `/name args` from stdin in --print mode and
# substitutes $1 — verified 2026-09-18 on this host.
# Per-run invariants (hard rules, PR body contract, memory budget, D1 rules) live
# in the repo AGENTS.md and are appended to the system prompt, not re-pasted into
# every packet. `--append-system-prompt <file>` is Pi's own flag and takes file
# contents (proven on this host 2026-09-18). It is used instead of relying on Pi's
# AGENTS.md context-file discovery because that walks up from the STARTUP cwd, and
# this unit starts in /home/nish — the repo file would never be reached. Canonical
# path, never cwd-relative: the unit must not depend on which checkout it runs from.
# fleet-ops#8049's mandated ExecStartPre rm: the ExecCondition copy above
# already clears the file on every real start; this second rm is the
# adjacent-to-ExecStart guard the issue spells out, and is a no-op in practice.
ExecStartPre=-/bin/rm -f /home/nish/workspaces/agent-state/pi-intake-triggers/%i
# fleet-ops#7742: the shell computes capacity; the prompt is handed the
# number. active counts activating oneshots (a --state=active filter sees 0).
# MemAvailable under 4 GiB, a non-numeric reading, or a failed count yields
# slots=0 — fail closed. At-capacity exits 0: it is a decision, not a failure.
ExecStartPre=/bin/sh -c 'systemctl --user list-units "*-issue@*.service" --state=active,activating --no-legend > /run/user/%U/pi-intake-active; echo $?'
ExecStartPre=/bin/sh -c 'a=$(wc -l < /run/user/%U/pi-intake-active); m=$(sed -n "s/^MemAvailable: *//p" /proc/meminfo | cut -d" " -f1); s=0; case "$a:$m" in *[!0-9:]*|:*|*:);; *) [ "$m" -ge 4194304 ] && [ "$a" -lt 20 ] && s=$((20-a));; esac; echo "$s" > /run/user/%U/pi-intake-slots; echo "intake-slots: slots=$s active=$a mem_kb=$m"'
ExecStart=/bin/sh -c 's=$(cat /run/user/%U/pi-intake-slots); case "$s" in [0-9]|[0-9][0-9]);; *) s=0;; esac; printf "/intake %i SLOTS: %s\n" "$s" | exec pi --print --append-system-prompt /home/nish/workspaces/tooling/fleet-ops-deploy-clone/AGENTS.md --session-dir "$HOME/.pi/agent/sessions/pi-intake-%i" --provider litellm --model worker-cheap'
# ARTIFACT CHECK. Intake's entire job is to turn agent-ready issues into
# agent-in-progress claims with a worker spawned behind them. Two counts say
# whether it did: if work was waiting (ready>0) and NOTHING is claimed
# (in-progress==0), the tick ran and moved nothing, so exit 1 records a
# `failed` unit instead of a green no-op. Deliberately narrow: ready==0 is
# nothing to do, and in-progress>0 means claims exist — this check says
# nothing about whether the RIGHT issue was claimed, and it is not meant to.
# ExecCondition already skipped the run entirely when ready==0, so in practice
# this fires only on a tick that had work and dropped it.
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" = success ] || exit 0; ready=$(gh api "repos/Nishfleet/%i/issues?labels=agent-ready&state=open&per_page=100" --jq length 2>/dev/null) || exit 0; claimed=$(gh api "repos/Nishfleet/%i/issues?labels=agent-in-progress&state=open&per_page=100" --jq length 2>/dev/null) || exit 0; [ "$ready" -gt 0 ] && [ "$claimed" -eq 0 ] && { echo "intake tick left $ready agent-ready issues with 0 claimed" >&2; exit 1; }; exit 0'
TimeoutStartSec=1800
Restart=on-failure
RestartSec=20
