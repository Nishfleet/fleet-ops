# fleet-ops#1498: repo copy of the live hand-placed unit (provenance: fleet-ops#1480 audit)
# Adjudicated EXCEPTION-APPROVED — class (b) sanctioned maintenance script;
# distinct from nish-memory-curator (vault memory vs Claude auto-memory).
# install.sh symlinks this over the live file in place.
[Unit]
Description=Compact the Claude auto-memory index when it grows past the truncation limit
Documentation=file:/home/nish/.claude/projects/-home-nish/memory/memory-index-autocompact.md

[Service]
Type=oneshot
ExecStart=/home/nish/.local/bin/memory-index-autocompact
WorkingDirectory=/home/nish
TimeoutStartSec=30min
# Fail loud: no Restart=, no SuccessExitStatus fudging. A non-zero exit must
# leave this unit in `systemctl --user list-units --state=failed`.
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin

# /home/nish/.config/systemd/user/service.d/10-escalate.conf
# Universal failure escalation — global drop-in for ALL user services.
# Sibling type drop-ins: path.d/10-escalate.conf and timer.d/10-escalate.conf
# (fleet-ops#618). service.d/ does not apply to .path or .timer units.
# Layer: never-say-next SENIOR-AUDITOR (visual-quality-waves.md "ESCALATION
# SCOPE EXPANDED", 2026-08-25). Any user service that fails feeds a
# STOP-REASON.json entry into the existing stop-escalation.path pipeline,
# which summons one SENIOR AUDITOR per trip (bounded: 2 per hash, then
# NISH-ESCALATIONS.md). Deliberate fail-loud canaries escalating is INTENDED.
#
# Exclusions (no self-trigger / no feedback loop) are enforced TWO ways:
#   1. unit-escalation@.service.d/no-self-escalate.conf resets OnFailure= to
#      empty for ALL unit-escalation@* instances (template drop-ins win over
#      this generic drop-in in systemd's merge order). Stops the recursion at
#      the OnFailure layer for the escalation template's own instances.
#   2. PRIMARY guard: the unit-escalation-write ExecStart script refuses
#      excluded unit names (unit-escalation@*, stop-escalation.*,
#      ready-work.service, escalation-daily-sweep.*) and exits 0 without
#      writing STOP-REASON. This is the layer that covers CONCRETE excluded
#      units (stop-escalation.service, ready-work.service) — systemd applies
#      this generic service.d drop-in AFTER their unit-specific drop-ins, so
#      a per-unit OnFailure= reset cannot override it; the script guard does.
# %n = full unit name of the failed service -> becomes the template instance.
[Unit]
OnFailure=unit-escalation@%n.service
