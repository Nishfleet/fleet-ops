[Unit]
Description=Fleet mechanical blind audit (oneshot, dispatches a pi reviewer)
# Named reason for this schedule (vault: "a schedule needs a named reason"):
# blind-spot discovery is inherently periodic; its events are unknown
# unknowns, so nothing concrete exists to be event-driven ON. The heartbeat
# also triggers it when the gap-board is drained, but the weekly timer is the
# floor.
#
# One audit at a time: the script takes a non-blocking flock and the heartbeat
# skips a start when the unit is already activating.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
ExecStart=/home/nish/.local/bin/fleet-blind-audit
# The reviewer (pi) can take the full seat timeout; this unit blocks until it
# returns and the findings are filed.
TimeoutStartSec=45min
# Never restart: the heartbeat or the weekly timer is the retry.
Restart=no
