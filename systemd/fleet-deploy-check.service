[Unit]
Description=Fleet merge-to-live deploy check (tight cadence, fleet-ops#468)
# fleet-ops#1460: the .path unit (fleet-deploy-check.path) can fire rapidly
# — git updates refs via replace-by-rename, generating multiple inotify
# events per fetch. The default 5/10s burst is blown through, wedging the
# service (same wedge as fleet-seat-recovery #617). The check is idempotent
# (fetch + rev compare, deploy only if moved); raise the limit so a ref
# update cannot wedge the fast path. StartLimit* must live in [Unit].
StartLimitIntervalSec=1h
StartLimitBurst=100

# Named reason (decisions-ledger 2026-08-27 TOP GEAR): merged-but-not-live
# latency. Every 2 minutes: git fetch + rev compare (seconds). Only when
# origin/main moved does it invoke the sanctioned bin/fleet-ops-deploy —
# the same deploy step the heartbeat block 0 uses, so live converges to a
# merge within ~2 minutes instead of waiting for the 30-min beat.
# No new dispatcher, no polling for work — event-driven on the merge event.

[Service]
Type=oneshot
ExecStart=/home/nish/.local/bin/fleet-deploy-check
# A fetch/rev-compare is cheap; give a deploy plenty of room to finish.
TimeoutStartSec=300

[Install]
WantedBy=default.target
