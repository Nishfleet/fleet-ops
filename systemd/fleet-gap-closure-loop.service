[Unit]
Description=Fleet gap-closure loop (one phase transition per start)
# Named reason: the intensive self-improvement loop (fleet-ops#180) is a
# state machine. Heartbeat tier1 starts this oneshot once per tick; the
# script does one transition and exits. systemd OnFailure= (global
# service.d/10-escalate.conf) is the fail-loud path. No [Install]: the
# heartbeat is the trigger, matching fleet-blind-audit.service.

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/nish
# /bin/bash -c exec so systemd-analyze on a hosted runner (which cannot
# stub a new VPS binary without a workflow edit) still verifies syntax.
ExecStart=/bin/bash -c 'exec /home/nish/.local/bin/fleet-gap-closure-loop'
TimeoutStartSec=5min
Restart=no
