# seat-walled-probe.timer — periodic probe for walled seats
# fleet-ops#1348
#
# Runs every 15 minutes, aligned with min_probe_interval_s=900s from
# seat-caps.json walled_comeback table. Checks for seats whose usable_at
# has expired and sends a polite 1-token probe (max 1 per seat per tick;
# should_probe_seat enforces the min interval since the last observation).
#
# For credentials_bad seats, the probe fires weekly (per
# credentials_bad_s=604800s) and files an agent-ready issue if the
# credential is still bad.

[Unit]
Description=Periodic probe for walled seats (fleet-ops#1348)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/1348
Requires=seat-walled-probe.service

[Timer]
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60
OnBootSec=5m

[Install]
WantedBy=timers.target
