[Unit]
Description=Fleet gap-closure senior-auditor conference (research or termination)
# Started by fleet-gap-closure-loop after it writes conferences/<id>/mode.
# Three pi-audit@ instances per round; systemd start of the set waits.
# Inherits global OnFailure=. No [Install].

[Service]
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=GAP_LOOP_STATE_DIR=/home/nish/workspaces/agent-state/fleet-gap-closure-loop
WorkingDirectory=/home/nish
ExecStart=/home/nish/.local/bin/fleet-gap-closure-conference
TimeoutStartSec=90min
Restart=no
