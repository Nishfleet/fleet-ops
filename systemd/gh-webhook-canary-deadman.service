[Unit]
Description=Github push-channel canary deadman (fleet-ops#1464)
Documentation=https://github.com/Nishfleet/fleet-ops/issues/1464

# fleet-ops#1464 dead-man's switch. Fires every 5 minutes (offset from the
# canary timer to avoid running simultaneously). Reads the
# fleet_gh_webhook_canary_last_green_seconds series from the local
# Prometheus textfile; if the series is missing OR more than 15 minutes
# stale, this unit writes a loud entry to the alert-repair triage file
# (and pings the healthchecks.io fail URL if configured).
#
# Standard dead-man's-switch inversion: alert on missing success, never
# on present failure alone. If the path is fine, this unit is silent.

[Service]
Type=oneshot
Environment=GH_WEBHOOK_CANARY_PROM=/var/lib/prometheus/node-exporter/fleet-gh-webhook-canary.prom
Environment=GH_WEBHOOK_DEADMAN_STALE_AFTER=900
Environment=GH_WEBHOOK_DEADMAN_TRIAGE_FILE=%h/.local/state/pi-packet/alert-repair-triage.md
Environment=GH_WEBHOOK_HEALTHCHECKS_FAIL_URL=
ExecStart=/usr/bin/python3 %h/.local/bin/gh-webhook-canary-deadman.py
TimeoutStartSec=20
