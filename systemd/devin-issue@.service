# devin-issue@.service — pi-issue@.service twin with Devin's headless CLI as
# the engine (Devin has no HTTP API, so it is a worker lane, not a router
# rung). Model: swe-2-max (Nish 2026-09-19: "turn on devin - swe 2.0, no
# glue"; SWE-2 models are $0 on the account). Proven 2026-09-19: piped packet
# -> file + commit + DONE, 3 parallel runs answered.
# Install: ln -sf <deploy-clone>/systemd/devin-issue@.service ~/.config/systemd/user/ && systemctl --user daemon-reload
[Unit]
Description=Devin fleet issue worker %i (SWE-2 Max, headless devin CLI)
# This unit IS the worker — no wrapper script. Same claim/PR/ExecStopPost
# contract as pi-issue@.service; see that unit for the design comments.
StartLimitIntervalSec=1h
StartLimitBurst=3
# Permanent failure releases the claim via pi-issue-failed@ —
# prompts/claim-release.md (fleet-ops#6292); see pi-issue@.service.
OnFailure=pi-issue-failed@%i.service
# Claim gate auth comes from the shared App token env file — Requires+After
# makes the mint part of this unit's start transaction, same as pi-intake@.
Requires=fleet-gh-token.service
After=fleet-gh-token.service

[Service]
# Per-worker memory caps (cgroup, systemd's own). Measured MemoryPeak n=14:
# median 1.28G, max 4.8G — 3G throttles the tail without killing normal work.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=6G
# fleet-ops#3611: never let a runaway worker thrash swap and OOM unrelated
# units. Exceeding MemoryMax is a local OOM kill, not a host-wide stall.
MemorySwapMax=0
# Same missing CPU bound as pi-issue@ (fleet-ops#4902 follow-up): admission is
# RAM-only, so nothing counts cores. Full sizing rationale and the live probe
# are in the pi-issue@.service comment — 25% per worker is a ceiling, not a
# serialiser.
CPUAccounting=yes
CPUQuota=25%
Type=oneshot
Environment=HOME=/home/nish
Environment=PATH=/home/nish/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Shared App token file for the ExecStartPre claim gate (see pi-issue@).
EnvironmentFile=-/run/user/%U/fleet-gh-token.env
Environment=DEVIN_UNIT_INSTANCE=%i
# fleet-ops#7773: shadow-only escalation-target log — see pi-issue@.service.
Environment=JEV_WORKER_ESCALATION_TARGET=1
# Commit identity. The worktrees carry a repo-local `user.name = Nish`, so
# without this block a worker's commits land authored by Nish himself (proven:
# claim/issue-7783 @ 88d52047c). git's own env vars outrank repo-local config
# and cover `git commit` however invoked. Push auth is the GH_TOKEN minted in
# ExecStart — a separate mechanism.
Environment=GIT_AUTHOR_NAME=nishfleet-worker[bot]
Environment=GIT_AUTHOR_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
Environment=GIT_COMMITTER_NAME=nishfleet-worker[bot]
Environment=GIT_COMMITTER_EMAIL=321485391+nishfleet-worker[bot]@users.noreply.github.com
WorkingDirectory=/home/nish
# App identity: `gh token generate` (the gh-token extension) mints the <=1h
# nishfleet-worker installation token. An empty mint fails the unit rather
# than silently falling back to human auth.
# CLAIM GATE (fleet-ops#7790): same gate as pi-issue@ — no claim/issue-<N>
# ref on origin -> exit 1 -> failed unit. An unclaimed worker is a blind
# worker. ExecStartPre because the no-glue check caps added Exec lines.
ExecStartPre=/bin/sh -c 'r=$${1%-*}; n=$${1##*-}; gh api "repos/Nishfleet/$r/git/refs/heads/claim/issue-$n" >/dev/null || { echo "claim-gate: no claim/issue-$n on Nishfleet/$r — refusing unclaimed start (fleet-ops#7790)" >&2; exit 1; }' sh %i
ExecStartPre=/bin/sh -c 'r=$${1%-*}; n=$${1##*-}; [ "$$(gh api repos/Nishfleet/$r/issues/$n --jq .state)" = open ] || { echo "open-gate: Nishfleet/$r#$n is not open — refusing dead work (Nish 2026-09-22)" >&2; exit 1; }' sh %i
ExecStart=/bin/sh -c 'set -e; GH_TOKEN=$(gh token generate --app-id 4728578 --key "$HOME/.config/fleet-worker/nishfleet-worker.private-key.pem" --installation-id 156789042 --token-only); [ -n "$GH_TOKEN" ] || { echo "app token mint failed — refusing human-gh fallback" >&2; exit 1; }; export GH_TOKEN; { cat "$HOME/workspaces/tooling/fleet-ops-deploy-clone/AGENTS.md"; echo; sed -e "1,/^---$/d" -e "s/[$]1/$1/g" "$HOME/workspaces/tooling/fleet-ops-deploy-clone/prompts/worker.md"; } | exec devin --permission-mode dangerous --model swe-2-max -p --prompt-file /dev/stdin' sh %i
# The worker created its own worktree; the worker's own unit cleans it up.
# No reaper, no salvage organ: work that was never committed and pushed did not
# happen, and the next dispatch starts from origin/main. Leading '-' so cleanup
# can never wedge the stop path.
ExecStopPost=-/bin/sh -c 'w="$HOME/workspaces/agent-worktrees/issue-$1"; for g in "$HOME/workspaces/tooling/fleet-ops-deploy-clone" "$HOME/workspaces/products/0509" "$HOME/workspaces/products/fleet-ops"; do git -C "$g" worktree remove --force "$w" >/dev/null 2>&1 || true; done; rm -rf "$w"' sh %i
# fleet-ops#3695: a finishing worker asks its own repo's intake for a refill,
# so a cohort that drains in 10 min does not leave the rest of the window idle.
ExecStopPost=-/bin/sh -c 'r=$(echo "$1" | sed "s/-[0-9][0-9]*$//"); systemctl --user start --no-block "pi-intake@$r.service"' sh %i
# ARTIFACT CHECK (fleet-ops#7744) — a worker that exits 0 having produced
# nothing must not record Result=success (fleet-ops#7761). The old inline
# check was dead on arrival twice over: systemd expands $r/$n to empty before
# sh runs (so the gh calls 404'd), and "branch exists" was vacuous anyway —
# intake pre-pushes claim/issue-<N> at claim time. bin/fleet-claim-release
# --artifact-check is the real gate: artifact = open/merged PR on
# claim/issue-<N> (merged PRs can delete the branch mid-run, fleet-ops#7783)
# or claim commits ahead of the default branch; a missing branch is a
# deliberate park and passes. exit 1 -> Result=exit-code -> `failed`, which
# is what OnFailure=/Restart=/StartLimitBurst key off. Runs LAST so cleanup
# and the intake refill run first; only checked on a success exit.
TimeoutStopSec=180

# Retry policy — systemd's own, not a counter in bash.
Restart=on-failure
RestartSec=240
RestartSteps=3
RestartMaxDelaySec=30min
# Hang detection: a worker active longer than this is terminated into `failed`.
# fleet-ops#8324: devin carried the largest share of the day's start-timeouts.
# The class is the same as router-issue@ (full population analysis there), and
# for devin it is joined from the devin CLI's own log, not guessed: every
# timed-out devin unit's log for 2026-09-22 (matched by workspace path
# `issue-<key>` under ~/.local/share/devin/cli/logs/) spans the full 45min wall
# of real tool activity, e.g. 0509-3927 08:23:56->09:08:46 UTC with 43
# vitest/playwright/npm/tsc command starts, 0509-3884 12:08:26->12:53:24 with
# 17, 0509-3879 with 33 and 0509-3925 with 40. The time goes into the local
# test/build loop, not into a seat cooldown (no 429/quota/walled signature in
# any timed-out unit's own log). systemd's CPU accounting agrees: the lane's
# timed-out units burn a small fraction of a core across the whole wall. SWE-2
# runs a real toolchain loop here, so the wall, not a governor value, is the
# binding constraint. 90min matches the router lane.
TimeoutStartSec=90min
